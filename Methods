          ui.field("r_dn_cell", arrowX, r_listMaxY, 1, showDown and "v" or " ", C_TEXT, showDown and C_ARROW_BG or C_INSET)

          upHB = {
            x1 = clamp(arrowX - 2, 1, ui.w),
            x2 = clamp(arrowX, 1, ui.w),
            y1 = clamp(methodsStartY - 1, 1, ui.h),
            y2 = clamp(methodsStartY + 1, 1, ui.h),
          }
          downHB = {
            x1 = clamp(arrowX - 2, 1, ui.w),
            x2 = clamp(arrowX, 1, ui.w),
            y1 = clamp(r_listMaxY - 1, 1, ui.h),
            y2 = clamp(r_listMaxY + 1, 1, ui.h),
          }
        else
          ui.field("r_up_cell", arrowX, methodsStartY, 1, " ", C_TEXT, C_INSET)
          ui.field("r_dn_cell", arrowX, r_listMaxY, 1, " ", C_TEXT, C_INSET)
        end
      end
    end
  end

  return hitboxes, upHB, downHB, maxOffset, scrollOffset
end

local selectedIdx, selectedName = nil, nil
local methods, lastMethodsSig = nil, ""
local scrollOffset = 0
local maxOffset = 0
local upHB, downHB = nil, nil

local list = getPeripheralList()
local listSig = listFingerprint(list)
local hitboxes
hitboxes, upHB, downHB, maxOffset, scrollOffset = drawScreen(list, selectedIdx, selectedName, methods, scrollOffset)

local refreshSeconds = 0.5
local refreshTimer = os.startTimer(refreshSeconds)

while true do
  local e, a, b, c = os.pullEvent()

  if e == "timer" and a == refreshTimer then
    local newList = getPeripheralList()
    local newSig = listFingerprint(newList)

    local changed = false
    local methodsChanged = false

    if newSig ~= listSig then
      list, listSig = newList, newSig
      changed = true

      if selectedName then
        local newIdx = nil
        for i = 1, #list do
          if list[i].name == selectedName then
            newIdx = i
            break
          end
        end
        if not newIdx then
          selectedIdx, selectedName = nil, nil
          methods, lastMethodsSig = nil, ""
          scrollOffset = 0
          maxOffset = 0
        else
          selectedIdx = newIdx
        end
      end
    end

    if selectedName then
      local newMethods = safeGetMethods(selectedName)
      local msig = methodsFingerprint(newMethods)
      if msig ~= lastMethodsSig then
        methods = newMethods or {}
        lastMethodsSig = msig
        changed = true
        methodsChanged = true
      end
    end

    if methodsChanged then
      scrollOffset = 0
    end

    if changed then
      hitboxes, upHB, downHB, maxOffset, scrollOffset = drawScreen(list, selectedIdx, selectedName, methods, scrollOffset)
    end

    refreshTimer = os.startTimer(refreshSeconds)

  elseif e == "monitor_touch" then
    local monName, x, y = a, b, c
    if monName == MON_NAME then
      if upHB and x >= upHB.x1 and x <= upHB.x2 and y >= upHB.y1 and y <= upHB.y2 then
        if scrollOffset > 0 then
          scrollOffset = scrollOffset - 1
          hitboxes, upHB, downHB, maxOffset, scrollOffset = drawScreen(list, selectedIdx, selectedName, methods, scrollOffset)
        end
      elseif downHB and x >= downHB.x1 and x <= downHB.x2 and y >= downHB.y1 and y <= downHB.y2 then
        if scrollOffset < maxOffset then
          scrollOffset = scrollOffset + 1
          hitboxes, upHB, downHB, maxOffset, scrollOffset = drawScreen(list, selectedIdx, selectedName, methods, scrollOffset)
        end
      else
        local picked = nil
        for i = 1, #hitboxes do
          local hb = hitboxes[i]
          if x >= hb.x1 and x <= hb.x2 and y >= hb.y1 and y <= hb.y2 then
            picked = hb.idx
            break
          end
        end

        if picked and list[picked] then
          selectedIdx = picked
          selectedName = list[picked].name
          methods = safeGetMethods(selectedName) or {}
          lastMethodsSig = methodsFingerprint(methods)
          scrollOffset = 0
          hitboxes, upHB, downHB, maxOffset, scrollOffset = drawScreen(list, selectedIdx, selectedName, methods, scrollOffset)
        end
      end
    end
  end
end

local function readFile(path)
    local file=fs.open(path,"r")
    if not file then return nil end
    local contents=file.readAll()
    file.close()
    return contents
end

local function releaseMarkers()
    local protected={}
    local valid=false
    for _,name in ipairs({"active_release.new","active_release","active_release.bak"}) do
        local version=(readFile(name) or ""):match("^%s*(%d+)%s*$")
        if version then
            protected[version]=true
            if readFile("releases/"..version.."/ready")==version and
                fs.exists("releases/"..version.."/common") then
                valid=true
            end
        end
    end
    return protected,valid
end

local function size(path)
    if fs.isDir(path) then
        local total=0
        for _,name in ipairs(fs.list(path)) do
            total=total+size(fs.combine(path,name))
        end
        return total
    end
    return fs.getSize(path)
end

local function inspect()
    local entries={}
    for _,name in ipairs(fs.list("")) do
        if not fs.getDrive or fs.getDrive(name)=="hdd" then
            entries[#entries+1]={name=name,bytes=size(name)}
        end
    end
    table.sort(entries,function(a,b) return a.bytes>b.bytes end)
    print("Free space: "..tostring(fs.getFreeSpace("")).." bytes")
    for i=1,math.min(#entries,15) do
        print(entries[i].name.."  "..entries[i].bytes.." bytes")
    end
    if fs.exists("releases") and fs.isDir("releases") then
        local protected=releaseMarkers()
        for _,version in ipairs(fs.list("releases")) do
            if version:match("^%d+$") and fs.isDir("releases/"..version) then
                print("Release "..version.."  "..size("releases/"..version).." bytes"..
                    (protected[version] and "  protected" or "  stale"))
            end
        end
    end
end

local function clean()
    local protected,valid=releaseMarkers()
    if not valid then
        print("No verified active release. Nothing deleted.")
        return
    end
    if not fs.exists("releases") or not fs.isDir("releases") then return end
    local recovered=0
    for _,version in ipairs(fs.list("releases")) do
        local path="releases/"..version
        if version:match("^%d+$") and not protected[version] and fs.isDir(path) and
            (not fs.getDrive or fs.getDrive(path)=="hdd") then
            local bytes=size(path)
            fs.delete(path)
            if not fs.exists(path) then
                recovered=recovered+bytes
                print("Removed stale release "..version.." ("..bytes.." bytes)")
            end
        end
    end
    print("Recovered "..recovered.." bytes; active and rollback releases preserved")
end

local args={...}
if args[1]=="clean" then
    clean()
elseif args[1]==nil then
    inspect()
else
    print("Usage: space [clean]")
end

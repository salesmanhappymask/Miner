    local function masterSetup()
        state.phase="MASTER_SETUP"
        state.foremenReady = state.foremenReady or {[1]=true}
        cfg.foremen = cfg.foremen or {[1]=id}
        saveState()
        saveTable("node.cfg",cfg)
        sendState("Setting up Navigators and foremen")

        if not ensureMasterSeedFuel() then
            return false
        end

        if not state.initialFuelLoaded then
            if not masterFuelAndLoadCoal() then
                state.phase="WAITING_SUPPLIES"
                saveState()
                sendState("Need seed fuel plus three Foreman coal stacks")
                return false
            end
            state.initialFuelLoaded=true
            saveState()
        end

        if not state.initialSuppliesLoaded then
            if not masterLoadSupplies() then
                state.phase="WAITING_SUPPLIES"
                saveState()
                sendState("Need 5 drives, 4 floppies, 16 miners, 3 Narcissistic Wireless Turtles, and 4 Advanced Wireless Turtles")
                return false
            end
            state.initialSuppliesLoaded=true
            saveState()
        end

        if not state.bootstrapReady then
            if not masterPlaceBootstrapInstaller() then
                state.phase="WAITING_SUPPLIES"
                saveState()
                sendState("Cannot establish bootstrap station")
                return false
            end
            state.bootstrapReady=true
            saveState()
        end

        state.navigatorLaunchReady=state.navigatorLaunchReady or {}
        cfg.navigators=cfg.navigators or {}

        local navigatorOrder={4,3,2,1}

        for _,n in ipairs(navigatorOrder) do
            if not state.navigatorLaunchReady[n] then
                state.phase="DEPLOYING_NAVIGATOR"
                saveState()
                sendState("Placing Navigator-" .. tostring(n))

                local nid=masterCommissionNavigator(n)
                if not nid then
                    state.phase="WAITING_NAVIGATOR_SETUP"
                    saveState()
                    sendState("Navigator-" .. tostring(n) .. " setup paused")
                    return false
                end

                state.navigatorLaunchReady[n]=true
                cfg.navigators[n]=nid
                saveTable("node.cfg",cfg)
                saveState()
            end
        end

        state.navigatorSetupDone=true
        saveState()

        for n=2,4 do
            if not state.foremenReady[n] then
                local fid=masterCommissionForeman(n)
                if not fid then
                    state.phase="WAITING_SETUP"
                    saveState()
                    sendState("Foreman-" .. tostring(n) .. " setup paused")
                    return false
                end
                state.foremenReady[n]=true
                cfg.foremen[n]=fid
                saveTable("node.cfg",cfg)
                saveState()
            end
        end

        if not state.bootstrapDiskPulled then
            if not goTo(1,-2) then
                state.phase="WAITING_SETUP"
                saveState()
                sendState("Cannot reach bootstrap drive")
                return false
            end
            if not ensureGroundLevel() then
                return false
            end
            faceTracked(DIR_N)
            if not ensureInstallerLevel() then
                state.phase="WAITING_SETUP"
                saveState()
                sendState("Cannot reach bootstrap drive height")
                return false
            end
            local floppySlot = selfTargetSlot("floppy")
            if not floppySlot then
                ensureGroundLevel()
                state.phase="WAITING_SETUP"
                saveState()
                sendState("No room for bootstrap floppy")
                return false
            end
            turtle.select(floppySlot)
            if not turtle.suck(1) then
                ensureGroundLevel()
                state.phase="WAITING_SETUP"
                saveState()
                sendState("Cannot pull bootstrap floppy")
                return false
            end
            ensureGroundLevel()
            state.bootstrapDiskPulled=true
            saveState()
        end

        if not state.ownInstallerLoaded then
            if selfCount("disk_drive") < 1 then
                state.phase="WAITING_SUPPLIES"
                saveState()
                sendState("Foreman-1 Disk Drive missing")
                return false
            end
            if selfCount("wireless_mining_turtle") < 4 then
                state.phase="WAITING_SUPPLIES"
                saveState()
                sendState("Foreman-1 miners missing")
                return false
            end
            if selfCount("floppy") < 1 then
                state.phase="WAITING_SUPPLIES"
                saveState()
                sendState("Foreman-1 floppy missing")
                return false
            end
            state.ownInstallerLoaded=true
            saveState()
        end

        state.phase="CLEARING_SETUP_AREA"
        saveState()
        sendState("Clearing shared setup area")

        if not returnHome() then
            state.phase="WAITING_SETUP"
            saveState()
            sendState("Cannot clear shared setup area")
            return false
        end

        state.phase="WAITING_SETUP"
        saveState()
        sendState("Four foremen online")
        return true
    end


    local function applyManagerForemanPose()
        local snapshot,seq=requestPoseBackup("foreman",5,cfg.session)

        if snapshot and type(snapshot.x)=="number" and type(snapshot.y)=="number" and
            type(snapshot.z)=="number" and type(snapshot.dir)=="number" then
            local incoming=tonumber(seq or snapshot.seq or 0) or 0

            state.x=snapshot.x
            state.y=snapshot.y
            state.z=snapshot.z
            state.dir=snapshot.dir
            state.seq=incoming
            state.motionIntent=nil
            state.verticalIntent=nil
            state.turnIntent=nil
            state.recoveryLocked=false
            state.recoveryReason=nil
            saveState()
        end
    end

    local function recallForeman(mode)
        mode=mode or "NORMAL"
        applyManagerForemanPose()

        if state.recoveryLocked then
            sendState("Recall refused: " .. tostring(state.recoveryReason or "pose uncertain"))
            return false
        end

        active=nil
        queue={}
        saveQueue()

        state.phase="RECALLING"
        saveState()

        recallTravel=true
        local reachedHome=returnHome()
        recallTravel=false

        if not reachedHome then
            state.phase="RECOVERY_LOCK"
            state.recoveryLocked=true
            state.recoveryReason="Foreman recall could not reach home"
            saveState()
            return false
        end

        if not faceTracked(DIR_N) then
            return false
        end

        if state.x~=cfg.homeX or state.y~=0 or state.z~=cfg.homeZ or state.dir~=DIR_N then
            state.phase="RECOVERY_LOCK"
            state.recoveryLocked=true
            state.recoveryReason="Foreman recall home verification failed"
            saveState()
            return false
        end

        state.phase="RECALLED_PAUSED"
        state.recallMode=mode
        saveState()
        checkpointForeman()

        send(cfg.managerId,{
            type="recall_home",
            role="foreman",
            number=number,
            id=id,
            mode=mode,
            x=state.x,
            y=state.y,
            z=state.z,
            dir=state.dir,
            session=cfg.session
        })

        if mode=="SHUTDOWN" then
            for i=1,5 do
                os.setComputerLabel(nil)

                if os.getComputerLabel()==nil then
                    break
                end

                sleep(0.1)
            end

            if os.getComputerLabel()~=nil then
                state.phase="RECOVERY_LOCK"
                state.recoveryLocked=true
                state.recoveryReason="Reached home but could not clear computer label"
                saveState()
                sendState(state.recoveryReason)
                return false
            end

            send(cfg.managerId,{
                type="recall_shutdown_ready",
                role="foreman",
                number=number,
                id=id,
                x=state.x,
                y=state.y,
                z=state.z,
                dir=state.dir,
                session=cfg.session
            })
            os.shutdown()
        end

        return true
    end

    local function pauseForSetupRecall()
        if not flags.recallMode then
            return false
        end

        local mode=flags.recallMode
        flags.recallMode=nil

        if not recallForeman(mode) then
            return false
        end

        if mode=="SHUTDOWN" then
            return true
        end

        while state.phase=="RECALLED_PAUSED" do
            if flags.recallMode then
                local nextMode=flags.recallMode
                flags.recallMode=nil

                if not recallForeman(nextMode) then
                    return false
                end

                if nextMode=="SHUTDOWN" then
                    return true
                end
            elseif flags.resume then
                flags.resume=false
                state.recallMode=nil
                state.phase=state.setupDone and "IDLE" or "WAITING_SETUP"
                saveState()
                sendState("Regional Manager resumed setup")
                break
            else
                sleep(0.2)
            end
        end

        return true
    end

    local function serviceRequest(req)
        active = req
        saveQueue()
        state.phase="SERVICING"
        saveState()
        sendState("Servicing Miner-" .. tostring(req.row))

        while not active.arrived do
            sleep(0.1)
            if now() - (active.lastSeen or 0) > 30 then
                state.phase="WAITING_MINER"
                saveState()
            end
        end

        if not loadOwnFuel() then
            return false
        end

        if not prepareRuntimeService(req.service) then
            return false
        end

        local laneZ=privateLaneZ()

        if state.z~=laneZ then
            if not goTo(state.x,laneZ) then
                return false
            end
        end

        if state.x~=req.row then
            if not goTo(req.row,laneZ) then
                return false
            end
        end

        if state.z~=0 then
            if not goTo(req.row,0) then
                return false
            end
        end

        if state.x~=req.row or state.z~=0 or state.y~=0 then
            state.phase="NAVIGATION_ERROR"
            saveState()
            sendState("Service route ended at wrong coordinate for Miner-" .. tostring(req.row))
            return false
        end

        if not verifyServiceMiner(req) then
            return false
        end

        saveState()

        if req.service == "REFUEL" or req.service == "BOTH" then
            local transferred,moved=dropMinerFuel(MINER_REFUEL_COAL)

            if not transferred then
                state.phase="SERVICE_TRANSFER_ERROR"
                saveState()
                sendState("Miner-" .. tostring(req.row) .. " would not accept refuel coal")
                return false
            end

            send(req.minerId,{
                type="refuel_now",
                requestId=req.requestId,
                coalTransferred=moved
            })

            local _,reply = waitInbox(function(sender,m)
                return sender==req.minerId and type(m)=="table" and m.type=="refuel_complete" and m.requestId==req.requestId
            end,20)

            if not reply then
                state.phase="SERVICE_TIMEOUT"
                saveState()
                sendState("Miner-" .. tostring(req.row) .. " did not confirm refuel")
                return false
            end
        end

        if req.service == "DUMP" or req.service == "BOTH" then
            local emptyConfirmed=false

            while not emptyConfirmed do
                local pulled=turtle.suck()

                if pulled then
                    sleep(0.05)
                else
                    if countRuntimeFreeSlots()<=0 then
                        state.phase="SERVICE_UNLOAD_TRIP"
                        saveState()
                        sendState("Foreman full; unloading before continuing Miner-" .. tostring(req.row))
                        send(cfg.managerId,{
                            type="job_progress",
                            requestId=req.requestId,
                            foremanId=id,
                            row=req.row,
                            phase="UNLOAD_TRIP",
                            session=cfg.session
                        })

                        if not dumpCargo() then
                            send(cfg.managerId,{
                                type="job_blocked",
                                requestId=req.requestId,
                                foremanId=id,
                                row=req.row,
                                reason=state.phase=="DOCK_BLOCKED" and "STORAGE_FULL" or "UNLOAD_FAILED",
                                session=cfg.session
                            })
                            return false
                        end

                        local laneZ=privateLaneZ()

                        if state.z~=laneZ then
                            if not goTo(state.x,laneZ) then
                                return false
                            end
                        end

                        if state.x~=req.row then
                            if not goTo(req.row,laneZ) then
                                return false
                            end
                        end

                        if state.z~=0 then
                            if not goTo(req.row,0) then
                                return false
                            end
                        end

                        if not verifyServiceMiner(req) then
                            return false
                        end
                    else
                        sleep(0.1)

                        if turtle.suck() then
                            sleep(0.05)
                        else
                            emptyConfirmed=true
                        end
                    end
                end
            end
        end

        if req.service == "DUMP" or req.service == "BOTH" then
            state.phase="RETURNING_AFTER_SERVICE"
            saveState()

            if not dumpCargo() then
                return false
            end
        end

        resolved[req.requestId] = now()
        send(cfg.managerId,{
            type="job_complete",
            requestId=req.requestId,
            foremanId=id,
            foremanNumber=number,
            minerId=req.minerId,
            row=req.row,
            service=req.service,
            session=cfg.session
        })
        active=nil
        saveQueue()
        returnHome()
        sendState("Service complete")
        return true
    end

    local function workLoop()
        if state.recoveryLocked then
            state.phase="RECOVERY_LOCK"
            saveState()
            checkpointForeman()
            while true do
                sendState("Movement locked: " .. tostring(state.recoveryReason or "pose uncertain"))
                sleep(5)
            end
        end

        checkpointForeman()

        if flags.recallMode then
            pauseForSetupRecall()
        end

        if state.phase=="DEPLOYING" then
            local laneX=cfg.number
            local deploymentValid=
                state.y==0 and
                state.x>=cfg.homeX and state.x<=laneX and
                state.z>=cfg.homeZ and state.z<=cfg.startZ

            if not deploymentValid then
                state.phase="RECOVERY_LOCK"
                state.recoveryLocked=true
                state.recoveryReason="Interrupted Foreman deployment pose is outside its deployment corridor"
                saveState()
                checkpointForeman()
                while true do
                    sendState(state.recoveryReason)
                    sleep(5)
                end
            end

            if state.z>cfg.homeZ then
                while state.x<laneX do
                    if not moveStep(DIR_E) then
                        state.recoveryLocked=true
                        state.recoveryReason="Could not regain Foreman deployment lane"
                        break
                    end
                end

                if not state.recoveryLocked then
                    while state.z>cfg.homeZ do
                        if not moveStep(DIR_S) then
                            state.recoveryLocked=true
                            state.recoveryReason="Could not resume Foreman southbound deployment"
                            break
                        end
                    end
                end
            end

            if not state.recoveryLocked and state.z==cfg.homeZ then
                while state.x>cfg.homeX do
                    if not moveStep(DIR_W) then
                        state.recoveryLocked=true
                        state.recoveryReason="Could not finish Foreman westbound deployment"
                        break
                    end
                end
            end

            if state.recoveryLocked or
                state.x~=cfg.homeX or state.z~=cfg.homeZ or state.y~=0 then
                state.phase="RECOVERY_LOCK"
                state.recoveryLocked=true
                state.recoveryReason=state.recoveryReason or "Could not resume interrupted Foreman deployment"
                saveState()
                checkpointForeman()
                while true do
                    sendState(state.recoveryReason)
                    sleep(5)
                end
            end

            faceTracked(DIR_N)
            state.phase="WAITING_SETUP"
            state.setupDone=false
            saveState()
            checkpointForeman()

            for i=1,3 do
                send(cfg.controller,{
                    type="foreman_deployed",
                    id=id,
                    number=number
                })
                sleep(0.1)
            end
        end

        if cfg.master and not state.setupDone then
            while not state.masterSetupDone do
                if flags.recallMode then
                    pauseForSetupRecall()
                elseif masterSetup() then
                    state.masterSetupDone=true
                    saveState()
                else
                    if flags.recallMode then
                        pauseForSetupRecall()
                    else
                        state.phase="WAITING_SETUP"
                        saveState()
                        sendState("Master setup paused, retrying")
                        sleep(2)
                    end
                end
            end

            if not state.minerSetupApproved then
                state.phase="WAITING_MINER_APPROVAL"
                saveState()
                sendState("GPS ready check pending; approve miner setup at Regional Manager")

                while not state.minerSetupApproved do
                    if flags.recallMode then
                        pauseForSetupRecall()
                    end

                    send(cfg.managerId,{
                        type="miner_setup_gate_request",
                        session=cfg.session
                    })

                    local _,reply=waitInbox(function(sender,m)
                        return sender==cfg.managerId and type(m)=="table" and
                            m.type=="miner_setup_approved" and m.session==cfg.session
                    end,1)

                    if reply then
                        state.minerSetupApproved=true
                        saveState()
                    end
                end
            end

            state.groupsCommissioned = state.groupsCommissioned or {}

            for n=2,4 do
                if not state.groupsCommissioned[n] then
                    commissionWave[n] = commissionWave[n] or {}
                    send(cfg.foremen[n],{type="commission_start",number=n})
                    commissionWave[n].lastSend = now()
                end
            end

            if not state.groupsCommissioned[1] then
                state.phase="COMMISSIONING"
                saveState()
                sendState("All foremen released for simultaneous commissioning")

                while not commissionAssigned() do
                    state.phase="WAITING_SETUP"
                    saveState()
                    sendState("Foreman-1 commissioning paused, retrying")
                    sleep(2)
                end

                state.groupsCommissioned[1]=true
                saveState()
            end

            while not (state.groupsCommissioned[2] and state.groupsCommissioned[3] and state.groupsCommissioned[4]) do
                state.phase="WAITING_SETUP"
                saveState()
                sendState("Waiting for all foremen to finish commissioning")
                sleep(1)
            end

            state.setupDone=true
            state.phase="IDLE"
            saveState()
            sendState("Commissioning complete; waiting for Regional Manager release")

            send(cfg.managerId,{
                type="commissioning_complete",
                version=VERSION,
                masterForemanId=id,
                session=cfg.session
            })

            returnHome()
        elseif not cfg.master and not state.setupDone then
            while not flags.commissionStart do
                if flags.recallMode then
                    pauseForSetupRecall()
                else
                    sleep(0.1)
                end
            end
            flags.commissionStart=false

            while not state.setupDone do
                if flags.recallMode then
                    pauseForSetupRecall()
                elseif commissionAssigned() then
                    break
                else
                    if flags.recallMode then
                        pauseForSetupRecall()
                    else
                        state.phase="WAITING_SETUP"
                        saveState()
                        sendState("Commissioning paused, retrying")
                        sleep(2)
                    end
                end
            end
        end

        while true do
            if flags.startMining then
                flags.startMining=false
                state.miningStarted=true
                if state.phase~="RECALLED_PAUSED" then
                    state.phase="IDLE"
                end
                saveState()
                sendState("Regional Manager released mining")
            end

            if flags.recallMode then
                local mode=flags.recallMode
                flags.recallMode=nil

                if mode=="NORMAL" or mode=="SHUTDOWN" then
                    recallForeman(mode)
                end
            end

            if state.phase=="RECALLED_PAUSED" then
                if flags.resume then
                    flags.resume=false
                    state.recallMode=nil
                    state.phase="IDLE"
                    saveState()
                    sendState("Regional Manager resumed operations")
                else
                    sleep(0.2)
                end
            else
                loadOwnFuel()
            end

            if state.phase~="RECALLED_PAUSED" and not active and #queue>0 then
                active=table.remove(queue,1)
                saveQueue()
            end

            if state.phase=="RECALLED_PAUSED" then
                sleep(0.2)
            elseif active then
                if not serviceRequest(active) then
                    local failed=active
                    local failurePhase=state.phase
                    local blockedReason=nil

                    if failurePhase=="DOCK_BLOCKED" then
                        blockedReason="STORAGE_FULL"
                    elseif failurePhase=="WAITING_FUEL" then
                        blockedReason="FUEL_UNAVAILABLE"
                    end

                    state.phase=blockedReason and failurePhase or "ERROR"
                    saveState()
                    sendState(blockedReason and ("Service blocked: " .. blockedReason) or "Service error; Regional Manager retains authority")

                    if failed then
                        send(cfg.managerId,{
                            type=blockedReason and "job_blocked" or "job_failed",
                            requestId=failed.requestId,
                            foremanId=id,
                            foremanNumber=number,
                            row=failed.row,
                            reason=blockedReason or failurePhase,
                            session=cfg.session
                        })
                    end

                    active=nil
                    queue={}
                    saveQueue()

                    if not blockedReason then
                        returnHome()
                    end

                    sleep(2)
                end
            else
                if state.x ~= cfg.homeX or state.z ~= cfg.homeZ then
                    returnHome()
                end
                sleep(0.2)
            end
        end
    end

    parallel.waitForAny(networkLoop, workLoop)
end


local function runMaster()
    if not openNetwork() then
        error("Wireless modem not found")
    end

    local cfg=loadTable("node.cfg")
    local newMaster=false
    local id=os.getComputerID()

    if cfg and cfg.version~=VERSION then
        error("Old Master Foreman state detected. Clear node.cfg and foreman state before using v54.")
    end

    if not cfg then
        newMaster=true
        local managerId,session=pairMasterWithRegionalManager()

        cfg={
            version=VERSION,
            role="foreman",
            number=1,
            controller=id,
            rowStart=1,
            rowEnd=4,
            homeX=0,
            homeZ=-2,
            startX=0,
            startZ=0,
            startDir=DIR_N,
            master=true,
            managerId=managerId,
            masterForemanId=id,
            session=session,
            foremen={[1]=id}
        }

        saveTable("node.cfg",cfg)
    else
        local wasMaster=
            cfg.role=="foreman" and
            tonumber(cfg.number)==1 and
            cfg.master==true and
            tonumber(cfg.masterForemanId)==id

        if not wasMaster then
            newMaster=true
        end

        cfg.version=VERSION
        cfg.role="foreman"
        cfg.number=1
        cfg.controller=id
        cfg.rowStart=1
        cfg.rowEnd=4
        cfg.homeX=0
        cfg.homeZ=-2
        cfg.startX=0
        cfg.startZ=0
        cfg.startDir=DIR_N
        cfg.master=true
        cfg.masterForemanId=id
        cfg.foremen=type(cfg.foremen)=="table" and cfg.foremen or {}
        cfg.foremen[1]=id

        saveTable("node.cfg",cfg)

        if cfg.managerId then
            setRegionalManager(cfg.managerId)
        end

        if not cfg.managerId or not cfg.session or not registerNodeWithManager(cfg,3) then
            local managerId,session=pairMasterWithRegionalManager()
            cfg.managerId=managerId
            cfg.masterForemanId=id
            cfg.session=session
            cfg.foremen[1]=id
            saveTable("node.cfg",cfg)
        end
    end

    setRegionalManager(cfg.managerId)

    if not registerNodeWithManager(cfg) then
        error("Master Foreman could not register with Regional Manager")
    end

    os.setComputerLabel("Foreman-1")

    local state=loadTableLight("foreman1.tmp")

    if not state and newMaster then
        saveTableLight("foreman1.tmp",{
            x=0,
            z=0,
            y=0,
            dir=DIR_N,
            phase="MASTER_SETUP",
            setupDone=false,
            masterSetupDone=false,
            session=cfg.session,
            seq=0
        })
    end

    runForeman(cfg)
end


if MASTER_FOREMAN==1 then
    runMaster()
else
    local cfg=loadTable("node.cfg")

    if not cfg or cfg.role~="foreman" then
        error("Foreman role file requires foreman node.cfg")
    end

    if cfg.version~=VERSION then
        error("Old foreman node state detected")
    end

    setRegionalManager(cfg.managerId)
    runForeman(cfg)
end

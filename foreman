                or not state.foremanFuelPackages or not state.foremanFuelPackages[n] or
                selfCount(state.foremanFuelPackages[n].kind)<state.foremanFuelPackages[n].units then
                return nil
            end
        end

        local function probeDeployed(workerId)
            local probeId=tostring(n)..":"..tostring(now())..":"..tostring(math.random(1,999999))
            for attempt=1,3 do
                send(workerId,{type="foreman_setup_probe",number=n,probeId=probeId,
                    session=cfg.session})

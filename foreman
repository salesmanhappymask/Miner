local function runForeman(cfg)
    setRegionalManager(cfg.managerId)
    if not openNetwork() then
        error("Wireless modem not found")
    end
    ensureManagerRegistration(cfg)

    if not getSelfInventory() then
        error("Narcissistic inventory peripheral not found")
    end

    local number = cfg.number
    local id = os.getComputerID()
    local statePath = "foreman" .. tostring(number) .. ".tmp"
    local queuePath = "foreman" .. tostring(number) .. "_queue.tmp"
    local state=loadTableLight(statePath)

    if state then
        state.installerConsolidationStartedAt=nil
        state.installerSupplyRetryAt=nil
        state.lastPackSend=nil
    end

    if not state then
        local monitorState=requestPoseBackup("foreman",5,cfg.session)
        state=monitorState or {
            number=number,
            x=cfg.homeX,
            z=cfg.homeZ,
            y=0,
            dir=DIR_N,
            phase="RECOVERY_LOCK",
            setupDone=false,
            seq=0
        }
        state.recoveryLocked=true
        state.recoveryReason=monitorState and
            "Local foreman state missing; monitor backup retained for manual recovery" or
            "Local foreman state missing and monitor has no backup"
        state.phase="RECOVERY_LOCK"
        saveTableLight(statePath,state)
    end

    local bootHadIntent=state.motionIntent or state.verticalIntent or
        state.turnIntent or state.chunkMoveIntent or state.recoveryProbeIntent

    state.session=cfg.session
    state.y=tonumber(state.y) or 0
    state.seq=tonumber(state.seq) or 0
    state.chunkIndex=tonumber(state.chunkIndex) or 0
    resolveChunkMove(state,function()
        if not saveTableLight(statePath,state) then error("Foreman chunk move recovery write failed") end
    end,cfg.worldOrigin)
    state.dir=tonumber(state.dir) or DIR_N

    local function foremanPoseValid()
        return type(state.x)=="number" and type(state.z)=="number" and
            state.x>=0 and state.x<=18 and state.z>=-2 and state.z<=15 and
            state.y>=0 and state.y<=1 and state.dir>=DIR_N and state.dir<=DIR_W
    end

    local bootManagerState,bootManagerSeq=requestPoseBackup("foreman",5,cfg.session)
    do
        local managerState,managerSeq=bootManagerState,bootManagerSeq
        if managerState and foremanPoseValid() and
            not state.motionIntent and not state.verticalIntent and not state.turnIntent then
            local incoming=tonumber(managerSeq or managerState.seq or 0) or 0
            if incoming>state.seq or
                (incoming==state.seq and
                    (managerState.x~=state.x or managerState.y~=state.y or
                     managerState.z~=state.z or managerState.dir~=state.dir)) then
                state.recoveryLocked=true
                state.recoveryReason="Manager and local foreman positions disagree after reboot"
                state.phase="RECOVERY_LOCK"
                saveTableLight(statePath,state)
            end
        end
    end

    local function foremanRecoveryReasonIsPositional(reason)
        reason=tostring(reason or "")
        return reason=="" or reason:find("interrupted",1,true)~=nil or
            reason:find("Position ambiguous",1,true)~=nil or
            reason:find("Fuel differs",1,true)~=nil or
            reason:find("GPS differs from saved pose",1,true)~=nil or
            reason:find("GPS facing recovery",1,true)~=nil or
            reason:find("possible world rollback",1,true)~=nil or
            reason:find("Manager and local foreman positions disagree",1,true)~=nil
    end

    local function adoptPhysicalForemanPose(managerState,managerSeq)
        if state.recallMode=="PACK" or state.advanceStage then return false end
        local gx,gy,gz=locateWorldPose(2)
        if not gx then return false end
        local lx,ly,lz=worldToLocalPose(gx,gy,gz,state.chunkIndex,cfg.worldOrigin)
        if lx==nil or lx<0 or lx>18 or lz< -2 or lz>15 or ly<0 or ly>1 then
            return false
        end
        local candidate=loadWorldPoseCandidate(statePath,cfg.worldOrigin,gx,gy,gz)
        state.x=lx
        state.y=ly
        state.z=lz
        state.motionIntent=nil
        state.verticalIntent=nil
        state.turnIntent=nil
        state.chunkMoveIntent=nil
        local recoveredDir,reason=recoverFacingByGPS(state,cfg.worldOrigin,function() return saveTableLight(statePath,state) end)
        if not recoveredDir then
            state.recoveryReason=reason or "Could not recover Foreman facing after world rollback"
            return false
        end
        state.dir=recoveredDir
        state.seq=math.max(tonumber(state.seq) or 0,tonumber(managerSeq) or 0)+1
        state.recoveryLocked=nil
        state.recoveryReason=nil
        if state.setupDone then
            state.phase="IDLE"
        elseif candidate and candidate.phase and candidate.phase~="RECOVERY_LOCK" then
            state.phase=candidate.phase
        elseif type(managerState)=="table" and managerState.phase and managerState.phase~="RECOVERY_LOCK" then
            state.phase=managerState.phase
        else
            state.phase="WAITING_SETUP"
        end
        state.fuelWitness=turtle.getFuelLevel()
        saveTableLight(statePath,state)
        if debugLog then
            debugLog("RECOVERY","Adopted physical GPS pose after server rollback Foreman-"..
                tostring(number).." x="..tostring(state.x).." y="..tostring(state.y)..
                " z="..tostring(state.z).." phase="..tostring(state.phase),"WARN")
        end
        return true
    end

    local function recoverForemanState()
        local priorLock=state.recoveryLocked and state.recoveryReason or nil
        local hadPending=state.motionIntent or state.verticalIntent or state.turnIntent or
            state.chunkMoveIntent or state.recoveryProbeIntent
        local managerState,managerSeq=requestPoseBackup("foreman",2,cfg.session)
        if not managerState then
            managerState=bootManagerState
            managerSeq=bootManagerSeq
        end
        if state.chunkMoveIntent then
            resolveChunkMove(state,function()
                saveTableLight(statePath,state)
            end,cfg.worldOrigin)
            if state.chunkMoveIntent and not foremanRecoveryReasonIsPositional(priorLock) then return false end
        end
        if state.recoveryProbeIntent and not state.turnIntent then
            local recoveredDir,reason=recoverFacingByGPS(state,cfg.worldOrigin,function() return saveTableLight(statePath,state) end)
            if not recoveredDir then
                state.recoveryLocked=true
                state.recoveryReason=reason or "Foreman interrupted facing probe could not recover"
                state.phase="RECOVERY_LOCK"
                saveTableLight(statePath,state)
                return false
            end
            state.dir=recoveredDir
        end

        if state.turnIntent then
            local recoveredDir=recoverFacingByGPS(state,cfg.worldOrigin,function() return saveTableLight(statePath,state) end)
            if recoveredDir then
                state.dir=recoveredDir
                state.seq=math.max(tonumber(state.seq) or 0,tonumber(state.turnIntent.seq) or 0)
                state.turnIntent=nil
            elseif adoptPhysicalForemanPose(managerState,managerSeq) then
                return true
            else
                return false
            end
        end

        if state.motionIntent or state.verticalIntent then
            local moveIntent=state.motionIntent or state.verticalIntent
            local moved=movementFromFuel(moveIntent.fuelBefore,turtle.getFuelLevel())
            if moved==nil then
                local gpsIntent=moveIntent
                if state.verticalIntent then
                    gpsIntent={
                        from={x=state.x,y=state.verticalIntent.from,z=state.z},
                        to={x=state.x,y=state.verticalIntent.to,z=state.z}
                    }
                end
                moved=movementFromGPS(gpsIntent,state.chunkIndex,cfg.worldOrigin,2)
            end
            if moved==nil then
                if adoptPhysicalForemanPose(managerState,managerSeq) then return true end
                state.recoveryLocked=true
                state.recoveryReason="Position ambiguous after interrupted foreman movement; waiting for recovery GPS"
                state.phase="RECOVERY_LOCK"
                saveTableLight(statePath,state)
                return false
            end
            local intentSeq=tonumber(moveIntent.seq) or ((tonumber(state.seq) or 0)+1)
            if state.motionIntent then
                local pose=moved and state.motionIntent.to or state.motionIntent.from
                state.x=pose.x
                state.z=pose.z
                state.y=pose.y
                state.dir=pose.dir
                if moved then state.seq=intentSeq end
                state.motionIntent=nil
            else
                state.y=moved and state.verticalIntent.to or state.verticalIntent.from
                if moved then state.seq=intentSeq end
                state.verticalIntent=nil
            end
        end

        if not foremanPoseValid() then
            if adoptPhysicalForemanPose(managerState,managerSeq) then return true end
            state.recoveryLocked=true
            state.recoveryReason="Saved foreman pose is outside the operating area"
            state.phase="RECOVERY_LOCK"
            saveTableLight(statePath,state)
            return false
        end

        if priorLock and not hadPending and foremanRecoveryReasonIsPositional(priorLock) then
            local x,y,z=locateWorldPose(2)
            if not x then return false end
            if not poseMatchesWorld(state,cfg.worldOrigin,x,y,z) then
                if adoptPhysicalForemanPose(managerState,managerSeq) then return true end
                return false
            end
        elseif priorLock and not hadPending and
            not priorLock:find("Fuel differs",1,true) and
            not priorLock:find("GPS is unavailable",1,true) then
            local x,y,z=locateWorldPose(2)
            if not x or not poseMatchesWorld(state,cfg.worldOrigin,x,y,z) then
                state.recoveryLocked=true
                state.recoveryReason=priorLock
                state.phase="RECOVERY_LOCK"
                saveTableLight(statePath,state)
                return false
            end
        end

        local verified,reason,witnessUpdated=verifyBootWitness(state,cfg.worldOrigin,hadPending and true or false)
        if not verified then
            if foremanRecoveryReasonIsPositional(reason) and adoptPhysicalForemanPose(managerState,managerSeq) then
                return true
            end
            state.recoveryLocked=true
            state.recoveryReason=reason
            state.phase="RECOVERY_LOCK"
            saveTableLight(statePath,state)
            return false
        end

        state.recoveryLocked=nil
        state.recoveryReason=nil
        if state.phase=="RECOVERY_LOCK" then state.phase=state.setupDone and "IDLE" or "WAITING_SETUP" end
        state.fuelWitness=turtle.getFuelLevel()
        saveTableLight(statePath,state)
        return true
    end

    if state.recoveryProbeIntent and not state.recoveryLocked then
        state.recoveryLocked=true
        state.recoveryReason="Interrupted transactional facing probe"
        state.phase="RECOVERY_LOCK"
        saveTableLight(statePath,state)
    end

    if state.motionIntent or state.verticalIntent or state.turnIntent or
        state.recoveryProbeIntent or state.recoveryLocked then
        recoverForemanState()
    end

    if bootHadIntent and not state.recoveryLocked and
        not state.motionIntent and not state.verticalIntent and
        not state.turnIntent and not state.chunkMoveIntent and
        not state.recoveryProbeIntent then
        state.fuelWitness=turtle.getFuelLevel()
        saveTableLight(statePath,state)
    end
    if not state.recoveryLocked then
        local verified,reason,witnessUpdated=verifyBootWitness(state,cfg.worldOrigin,bootHadIntent)
        if not verified then
            state.recoveryLocked=true
            state.recoveryReason=reason
            state.phase="RECOVERY_LOCK"
            saveTableLight(statePath,state)
        elseif witnessUpdated then
            saveTableLight(statePath,state)
        end
    end

    local qdata=loadTableLight(queuePath)
    if type(qdata)~="table" then
        qdata={queue={},active=nil,resolved={}}
    end

    local queue=type(qdata.queue)=="table" and qdata.queue or {}
    local active=type(qdata.active)=="table" and qdata.active or nil
    local resolved=type(qdata.resolved)=="table" and qdata.resolved or {}
    local queueBootNow=now()
    if active then active.lastSeen=queueBootNow end
    for i=1,#queue do
        if type(queue[i])=="table" then queue[i].lastSeen=queueBootNow end
    end
    for requestId in pairs(resolved) do
        if type(resolved[requestId])=="table" then
            resolved[requestId].stamp=queueBootNow
            resolved[requestId].lastSend=nil
        else
            resolved[requestId]={stamp=queueBootNow,acknowledged=true}
        end
    end
    local peers = {}
    local intents = {}
    local recallTravel=false
    local inbox = {}
    local commissionWave = {}
    local flags = {
        commissionStart=false,
        startMining=false,
        dockGranted=false,
        recallMode=nil,
        packService=false,
        resume=false,
        advanceCancelled=false,
        chunkCommand=nil,
        installerChainCommand=nil
    }
    local dock = nil
    if number == 1 then
        dock = loadTableLight("dock.tmp") or {holder=nil,queue={}}
    end
    local lastStatus = 0
    local lastPeer = 0

    local function saveState()
        state.fuelWitness=turtle.getFuelLevel()
        if not saveTableLight(statePath,state) then
            error("Foreman state write failed; movement halted")
        end
    end

    local function foremanSnapshot()
        local raw=textutils.serialize(state)
        local snapshot=textutils.unserialize(raw)
        snapshot.motionIntent=nil
        snapshot.verticalIntent=nil
        snapshot.turnIntent=nil
        snapshot.recoveryProbeIntent=nil
        return snapshot
    end

    local function checkpointForeman()
        checkpointPose("foreman",state.seq,foremanSnapshot(),cfg.session)
    end

    local function turnQuarter(right)
        local from=state.dir
        local to=right and ((from+1)%4) or ((from+3)%4)
        local intent={seq=state.seq+1,from=from,to=to}
        state.turnIntent=intent
        saveState()

        local ok
        if right then
            ok=turtle.turnRight()
        else
            ok=turtle.turnLeft()
        end

        if not ok then
            state.turnIntent=nil
            saveState()
            return false
        end

        state.dir=to
        state.seq=intent.seq
        checkpointForeman()
        state.turnIntent=nil
        saveState()
        return true
    end

    local function faceTracked(target)
        if state.recoveryLocked then
            return false
        end

        while state.dir~=target do
            local diff=(target-state.dir)%4
            if diff==3 then
                if not turnQuarter(false) then return false end
            else
                if not turnQuarter(true) then return false end
            end
        end

        return true
    end

    local function saveQueue()
        if not saveTableLight(queuePath,{queue=queue,active=active,resolved=resolved}) then
            error("Foreman service queue write failed; service halted")
        end
    end

    local function saveDock()
        if number == 1 and dock then
            if not saveTableLight("dock.tmp",dock) then
                error("Foreman dock queue write failed; dispatch halted")
            end
        end
    end

    local function sendState(message)
        status("foreman",state.phase,{
            number=number,
            rowStart=cfg.rowStart,
            rowEnd=cfg.rowEnd,
            x=state.x,
            z=state.z,
            y=state.y,
            dir=state.dir,
            seq=state.seq,
            chunkIndex=state.chunkIndex,
            advanceStage=state.advanceStage,
            fuel=turtle.getFuelLevel(),
            queue=#queue + (active and 1 or 0),
            setupDone=state.setupDone and true or false,
            miningStarted=state.miningStarted and true or false,
            installerConsolidationDone=state.installerConsolidationDone and true or false,
            orientationCheckDone=state.orientationCheckDone and true or false,
            recovery=state.recoveryReason,
            message=message or "",
            setupMissing=state.setupBlockReason or false,
            session=cfg.session
        })
        lastStatus = now()
    end

    local function pushInbox(sender,message)
        inbox[#inbox+1] = {sender=sender,message=message}
        if #inbox > 100 then
            table.remove(inbox,1)
        end
    end

    local function popInbox(predicate)
        for i=1,#inbox do
            local entry = inbox[i]
            if predicate(entry.sender,entry.message) then
                table.remove(inbox,i)
                return entry.sender,entry.message
            end
        end
        return nil,nil
    end

    local function waitInbox(predicate, timeout)
        local deadline = now() + timeout
        while now() < deadline do
            local sender,message = popInbox(predicate)
            if sender then
                return sender,message
            end
            sleep(0.1)
        end
        return nil,nil
    end

    local function assignedRow(row)
        return row >= cfg.rowStart and row <= cfg.rowEnd
    end

    local function upsertRequest(message)
        if not assignedRow(message.row or -1) then
            return
        end
        local requestId = message.requestId
        if resolved[requestId] then
            local result=resolved[requestId]
            if not result.minerId and message.managerAssigned then
                result.minerId=message.minerId
                result.row=message.row
                result.service=message.service
                result.acknowledged=false
                saveQueue()
            end
            if result.minerId then
                send(cfg.managerId,{
                    type="job_complete",
                    requestId=requestId,
                    foremanId=id,
                    foremanNumber=number,
                    minerId=result.minerId,
                    row=result.row,
                    service=result.service,
                    session=cfg.session
                })
            end
            return
        end
        if active and active.requestId == requestId then
            active.arrived = active.arrived or message.type == "service_arrived"
            if active.service~=message.service and message.service then active.service="BOTH" end
            active.fuel=message.fuel or active.fuel
            active.lastSeen = now()
            saveQueue()
            return
        end
        for i=1,#queue do
            if queue[i].requestId == requestId then
                queue[i].arrived = queue[i].arrived or message.type == "service_arrived"
                if queue[i].service~=message.service and message.service then queue[i].service="BOTH" end
                queue[i].fuel=message.fuel or queue[i].fuel
                queue[i].lastSeen = now()
                saveQueue()
                return
            end
        end
        queue[#queue+1] = {
            requestId=requestId,
            row=message.row,
            service=message.service,
            fuel=message.fuel,
            minerId=message.minerId,
            arrived=message.type == "service_arrived",
            lastSeen=now()
        }
        saveQueue()
        if not message.managerAssigned then
            send(message.minerId,{
                type="service_ack",
                requestId=requestId,
                row=message.row
            })
        end
        sendState("Queued Miner-" .. tostring(message.row))
    end

    local function dockContains(fid)
        if dock.holder == fid then
            return true
        end
        for i=1,#dock.queue do
            if dock.queue[i] == fid then
                return true
            end
        end
        return false
    end

    local function grantDock()
        if number ~= 1 then
            return
        end
        if not dock.holder and #dock.queue > 0 then
            dock.holder = table.remove(dock.queue,1)
            saveDock()
            if dock.holder == id then
                flags.dockGranted = true
            else
                send(dock.holder,{type="dock_grant"})
            end
        end
    end

    local function peerAt(tx,tz,ty)
        ty=ty==nil and state.y or ty

        for pid,p in pairs(peers) do
            if pid~=id and p.x==tx and p.z==tz and
                tonumber(p.y or 0)==tonumber(ty) and
                now()-(p.lastSeen or 0)<12 then
                return pid,p
            end
        end

        return nil,nil
    end

    local function occupied(tx,tz,ty)
        local pid=peerAt(tx,tz,ty)
        return pid~=nil
    end

    local function lowerIntentWins(tx,tz,ty)
        ty=ty==nil and state.y or ty

        for pid,p in pairs(intents) do
            if pid~=id and p.x==tx and p.z==tz and
                tonumber(p.y or 0)==tonumber(ty) and
                now()-(p.lastSeen or 0)<1 then
                if (p.number or 99)<number then
                    return true
                end
            end
        end

        return false
    end

    local function moveVertical(targetY)
        if flags.recallMode and not recallTravel then
            return false
        end

        if state.recoveryLocked then
            return false
        end

        if targetY~=0 and targetY~=1 then
            state.phase="VERTICAL_ERROR"
            saveState()
            sendState("Invalid relative Y target " .. tostring(targetY))
            return false
        end

        while state.y<targetY do
            state.phase="MOVING_UP"
            local intent={
                seq=state.seq+1,
                from=state.y,
                to=state.y+1,
                fuelBefore=turtle.getFuelLevel()
            }
            state.verticalIntent=intent
            saveState()

            if not turtle.up() then
                state.verticalIntent=nil
                state.phase="VERTICAL_ERROR"
                saveState()
                sendState("Unable to move up to relative Y " .. tostring(targetY))
                return false
            end

            state.y=intent.to
            state.seq=intent.seq
            checkpointForeman()
            state.verticalIntent=nil
            saveState()
        end

        while state.y>targetY do
            state.phase="MOVING_DOWN"
            local intent={
                seq=state.seq+1,
                from=state.y,
                to=state.y-1,
                fuelBefore=turtle.getFuelLevel()
            }
            state.verticalIntent=intent
            saveState()

            if not turtle.down() then
                state.verticalIntent=nil
                state.phase="VERTICAL_ERROR"
                saveState()
                sendState("Unable to move down to relative Y " .. tostring(targetY))
                return false
            end

            state.y=intent.to
            state.seq=intent.seq
            checkpointForeman()
            state.verticalIntent=nil
            saveState()
        end

        return state.y==targetY
    end

    local function ensureGroundLevel()
        if state.y~=0 then
            sendState("Correcting foreman to staging height")
        end
        return moveVertical(0)
    end

    local function ensureInstallerLevel()
        if state.y~=1 then
            sendState("Correcting foreman to installer height")
        end
        return moveVertical(1)
    end

    local function verifyGroundFrontNoDrive()
        if state.y~=0 then
            return false
        end
        return peripheral.getType("front")~="drive"
    end

    local function gpsSample(timeout)
        if not gps or not gps.locate then
            return nil
        end

        local ok,x,y,z=pcall(gps.locate,timeout or 1,false)

        if ok and x and y and z then
            return {x=x,y=y,z=z}
        end

        return nil
    end

    local function expectedNorthPlacement()
        local here=gpsSample(2)
        if not here then
            state.setupBlockReason="Waiting for GPS before placing a turtle"
            saveState()
            sendState(state.setupBlockReason)
            return nil
        end
        local x,y,z=worldPose(state.x,state.y,state.z,state.chunkIndex,cfg.worldOrigin)
        if not x or math.abs(here.x-x)>0.25 or math.abs(here.y-y)>0.25 or
            math.abs(here.z-z)>0.25 then
            state.recoveryLocked=true
            state.recoveryReason="GPS disagrees with foreman world origin before placement"
            state.phase="RECOVERY_LOCK"
            saveState()
            sendState(state.recoveryReason)
            return nil
        end
        return {x=here.x,y=here.y,z=here.z-1}
    end

    local function gpsVerifyDisplacement(anchor,horizontal,vertical)
        if not anchor then
            return true
        end

        local pos=gpsSample(1)

        if not pos then
            return true
        end

        local hd=math.abs(pos.x-anchor.x)+math.abs(pos.z-anchor.z)
        local vd=pos.y-anchor.y

        if hd~=horizontal or vd~=vertical then
            state.recoveryLocked=true
            state.recoveryReason="GPS verification disagreed with Foreman collision detour"
            state.phase="RECOVERY_LOCK"
            saveState()
            sendState(state.recoveryReason)
            return false
        end

        return true
    end

    local function nextCoordinate(dir,x,z)
        x=x or state.x
        z=z or state.z

        if dir==DIR_N then
            z=z+1
        elseif dir==DIR_E then
            x=x+1
        elseif dir==DIR_S then
            z=z-1
        else
            x=x-1
        end

        return x,z
    end

    local function oppositeDir(dir)
        return (dir+2)%4
    end

    local function withinForemanArea(x,z)
        return x>=0 and x<=18 and z>=-2 and z<=0
    end

    local function stepAtCurrentHeight(targetDir)
        if state.recoveryLocked then
            return false
        end

        if not faceTracked(targetDir) then
            return false
        end

        local tx,tz=nextCoordinate(targetDir)

        if not withinForemanArea(tx,tz) then
            return false
        end

        if occupied(tx,tz,state.y) then
            return false
        end

        broadcast({
            type="move_intent",
            foremanId=id,
            number=number,
            x=tx,
            z=tz,
            y=state.y
        })

        intents[id]={
            number=number,
            x=tx,
            z=tz,
            y=state.y,
            lastSeen=now()
        }

        sleep(MOVE_RESERVE_TIME)

        if occupied(tx,tz,state.y) or lowerIntentWins(tx,tz,state.y) then
            intents[id]=nil
            return false
        end

        if turtle.detect() then
            intents[id]=nil
            return false
        end

        local intent={
            seq=state.seq+1,
            fuelBefore=turtle.getFuelLevel(),
            from={x=state.x,z=state.z,y=state.y,dir=state.dir},
            to={x=tx,z=tz,y=state.y,dir=state.dir}
        }

        state.motionIntent=intent
        saveState()

        if not turtle.forward() then
            intents[id]=nil
            state.motionIntent=nil
            saveState()
            return false
        end

        state.x=tx
        state.z=tz
        state.seq=intent.seq
        intents[id]=nil
        checkpointForeman()
        state.motionIntent=nil
        saveState()

        broadcast({
            type="foreman_position",
            foremanId=id,
            number=number,
            x=state.x,
            z=state.z,
            y=state.y,
            phase=state.phase
        })

        return true
    end

    local function restoreFromOverpass(targetDir,moved)
        local back=oppositeDir(targetDir)

        for i=1,moved do
            if not stepAtCurrentHeight(back) then
                state.recoveryLocked=true
                state.recoveryReason="Foreman collision bypass could not retreat safely"
                state.phase="RECOVERY_LOCK"
                saveState()
                sendState(state.recoveryReason)
                return false
            end
        end

        if state.y~=0 and not moveVertical(0) then
            state.recoveryLocked=true
            state.recoveryReason="Foreman collision bypass could not return to ground"
            state.phase="RECOVERY_LOCK"
            saveState()
            sendState(state.recoveryReason)
            return false
        end

        return true
    end

    local function resolvePeerCollision(targetDir,blocker)
        if type(blocker)~="table" then
            return false
        end

        local blockerNumber=tonumber(blocker.number) or 99

        if number<blockerNumber then
            local deadline=now()+3

            while now()<deadline do
                local tx,tz=nextCoordinate(targetDir)

                if not occupied(tx,tz,0) then
                    return true
                end

                sleep(0.1)
            end

            return false
        end

        local firstX,firstZ=nextCoordinate(targetDir)
        local secondX,secondZ=nextCoordinate(targetDir,firstX,firstZ)

        if not withinForemanArea(secondX,secondZ) then
            return false
        end

        if occupied(secondX,secondZ,0) then
            return false
        end

        local anchor=gpsSample(1)
        local moved=0

        state.phase="COLLISION_BYPASS"
        saveState()
        sendState("Yielding to Foreman-" .. tostring(blockerNumber))

        if turtle.detectUp() then
            state.phase="COLLISION_WAIT"
            saveState()
            sendState("Collision bypass blocked above")
            return false
        end

        if not moveVertical(1) then
            return false
        end

        for i=1,2 do
            if not stepAtCurrentHeight(targetDir) then
                restoreFromOverpass(targetDir,moved)
                state.phase="COLLISION_WAIT"
                saveState()
                sendState("Collision bypass route unavailable")
                return false
            end

            moved=moved+1
        end

        local deadline=now()+3

        while occupied(state.x,state.z,0) and now()<deadline do
            sleep(0.1)
        end

        if occupied(state.x,state.z,0) then
            restoreFromOverpass(targetDir,moved)
            state.phase="COLLISION_WAIT"
            saveState()
            sendState("Collision bypass landing occupied")
            return false
        end

        if not moveVertical(0) then
            restoreFromOverpass(targetDir,moved)
            return false
        end

        if not gpsVerifyDisplacement(anchor,2,0) then
            return false
        end

        state.phase="MOVING"
        saveState()
        sendState("Collision bypass complete")
        return true
    end

    local function moveStep(targetDir)
        if flags.recallMode and not recallTravel then
            return false,"RECALL"
        end

        if not ensureGroundLevel() then
            state.phase="VERTICAL_ERROR"
            saveState()
            sendState("Horizontal movement blocked because foreman is not at staging height")
            return false,"VERTICAL"
        end

        if not faceTracked(targetDir) then
            return false,"TURN"
        end

        local tx,tz=nextCoordinate(targetDir)

        if not withinForemanArea(tx,tz) then
            state.recoveryLocked=true
            state.recoveryReason="Foreman movement would leave operating area"
            state.phase="RECOVERY_LOCK"
            saveState()
            sendState(state.recoveryReason)
            return false,"BOUNDS"
        end

        local attempts=0

        while attempts<MOVE_RETRY_LIMIT do
            attempts=attempts+1

            local blockerId,blocker=peerAt(tx,tz,state.y)

            if blockerId then
                if attempts>=3 then
                    state.phase="COLLISION_WAIT"
                    saveState()
                    sendState("Foreman-" .. tostring(blocker.number or "?") .. " occupies next tile")
                    return false,"PEER",blocker
                end
            else
                broadcast({
                    type="move_intent",
                    foremanId=id,
                    number=number,
                    x=tx,
                    z=tz,
                    y=state.y
                })

                intents[id]={
                    number=number,
                    x=tx,
                    z=tz,
                    y=state.y,
                    lastSeen=now()
                }

                sleep(MOVE_RESERVE_TIME)

                if not occupied(tx,tz,state.y) and not lowerIntentWins(tx,tz,state.y) then
                    local intent={
                        seq=state.seq+1,
                        fuelBefore=turtle.getFuelLevel(),
                        from={x=state.x,z=state.z,y=state.y,dir=state.dir},
                        to={x=tx,z=tz,y=state.y,dir=state.dir}
                    }

                    state.motionIntent=intent
                    saveState()

                    if turtle.forward() then
                        state.x=tx
                        state.z=tz
                        state.seq=intent.seq
                        intents[id]=nil
                        checkpointForeman()
                        state.motionIntent=nil
                        saveState()

                        broadcast({
                            type="foreman_position",
                            foremanId=id,
                            number=number,
                            x=state.x,
                            z=state.z,
                            y=state.y,
                            phase=state.phase
                        })

                        return true
                    else
                        state.motionIntent=nil
                        saveState()

                        local physicalPeerId,physicalPeer=peerAt(tx,tz,state.y)

                        if physicalPeerId and attempts>=3 then
                            intents[id]=nil
                            return false,"PEER",physicalPeer
                        end
                    end
                end
            end

            sleep(0.2)
        end

        intents[id]=nil
        state.phase="BLOCKED"
        saveState()
        sendState("Movement blocked at " .. tostring(tx) .. "," .. tostring(tz))
        return false,"BLOCKED"
    end

    local function travelAxis(targetDir,targetTest)
        local collisionRetries=0

        while targetTest() do
            local ok,reason,blocker=moveStep(targetDir)

            if ok then
                collisionRetries=0
            elseif reason=="PEER" then
                collisionRetries=collisionRetries+1

                if collisionRetries>4 then
                    return false
                end

                if not resolvePeerCollision(targetDir,blocker) then
                    sleep(0.25)
                end
            else
                return false
            end
        end

        return true
    end

    local function privateLaneZ()
        return -1
    end

    local function goTo(tx,tz)
        if state.recoveryLocked then
            return false
        end

        if not ensureGroundLevel() then
            return false
        end

        if not travelAxis(DIR_E,function() return state.x<tx end) then
            return false
        end

        if not travelAxis(DIR_W,function() return state.x>tx end) then
            return false
        end

        if not travelAxis(DIR_N,function() return state.z<tz end) then
            return false
        end

        if not travelAxis(DIR_S,function() return state.z>tz end) then
            return false
        end

        return true
    end

    local function enterPrivateLane()
        local laneZ=privateLaneZ()
        local entryX=cfg.rowStart

        if state.x==cfg.homeX and state.z==cfg.homeZ then
            if state.x~=entryX then
                if not goTo(entryX,cfg.homeZ) then return false end
            end
        end

        if state.z~=laneZ then
            if not goTo(state.x,laneZ) then return false end
        end

        return true
    end

    local function frontFuelCount(kind)
        local items=scanInventory("front") or {}
        local total=0
        for _,item in pairs(items) do
            if matchesItem(item,kind) then
                total=total+tonumber(item.qty or item.size or 1)
            end
        end
        return total
    end

    local function chooseFuelPacket(energy,count,allowFront)
        count=count or 1
        for _,kind in ipairs(FUEL_PRIORITY) do
            local units=math.ceil(energy/FUEL_VALUE[kind])
            local available=selfCount(kind)+(allowFront and frontFuelCount(kind) or 0)
            if available>=units*count then return kind,units end
        end
        return nil,nil
    end

    local function loadFuelPacket(energy,count)
        local kind,units=chooseFuelPacket(energy,count,true)
        if not kind then return nil,nil end
        local needed=units*(count or 1)-selfCount(kind)
        if needed>0 and takeNamedIntoSelf(kind,needed)<needed then return nil,nil end
        return kind,units
    end

    local function returnBucketsAtFuel()
        if state.x~=cfg.homeX+1 or state.z~=cfg.homeZ or state.dir~=DIR_S then
            state.setupBlockReason="Empty bucket return requires the Foreman fuel chest"
            saveState()
            sendState(state.setupBlockReason)
            return false
        end
        while selfCount("empty_bucket")>0 do
            local slot=selfFindSlot("empty_bucket")
            if not slot then return false end
            turtle.select(slot)
            if not turtle.drop() then return false end
        end
        return true
    end

    local function useOwnFuel()
        if turtle.getFuelLevel()=="unlimited" or turtle.getFuelLevel()>=FOREMAN_FUEL_TARGET then
            return true
        end
        return selfRefuelTo(FOREMAN_FUEL_TARGET)
    end

    local function refuelAtFrontTo(target,returnBuckets)
        if returnBuckets==nil then returnBuckets=true end
        if turtle.getFuelLevel()=="unlimited" then return true end
        while turtle.getFuelLevel()<target do
            local kind
            for _,candidate in ipairs(FUEL_PRIORITY) do
                if selfCount(candidate)>0 or frontFuelCount(candidate)>0 then
                    kind=candidate
                    break
                end
            end
            if not kind then return false end
            if selfCount(kind)==0 and takeNamedIntoSelf(kind,1)<1 then return false end
            local slot=selfFindSlot(kind)
            if not slot then return false end
            turtle.select(slot)
            if not turtle.refuel(0) or not turtle.refuel(1) then return false end
            if kind=="lava_bucket" and returnBuckets and not returnBucketsAtFuel() then
                return false
            end
        end
        return not returnBuckets or returnBucketsAtFuel()
    end

    local function verifyDockInventory(kind)
        local inv=wrapInventory("front")

        if inv then
            return true
        end

        state.phase="NAVIGATION_ERROR"
        saveState()
        sendState("Expected " .. tostring(kind) .. " chest directly south of the foreman lane")
        return false
    end

    local function goPrivateHome()
        return goTo(cfg.homeX,cfg.homeZ)
    end

    local function returnHome()
        if not goPrivateHome() then
            return false
        end

        if state.x~=cfg.homeX or state.z~=cfg.homeZ or state.y~=0 then
            state.phase="NAVIGATION_ERROR"
            saveState()
            sendState("Foreman home coordinate mismatch")
            return false
        end

        faceTracked(DIR_N)

        if state.dir~=DIR_N then
            state.phase="NAVIGATION_ERROR"
            saveState()
            sendState("Foreman could not establish north at home")
            return false
        end

        state.phase = "IDLE"
        saveState()
        checkpointForeman()
        sendState("Waiting")
        return true
    end

    local function frontPlacementOccupied()
        if turtle.inspect then
            local ok,present=pcall(turtle.inspect)
            if ok then return present==true end
        end
        return turtle.detect()
    end

    local function ensureEnderPair()
        if state.chestsReady then return true end
        if not goPrivateHome() then return false end

        local function placeChest(kind,flag,tx)
            if state[flag] then return true end
            if not goTo(tx,cfg.homeZ) or not faceTracked(DIR_S) then return false end
            local existingType=peripheral.getType("front")
            local okExisting,idExisting=pcall(peripheral.call,"front","getID")
            if existingType or (okExisting and tonumber(idExisting)) then
                state.phase="CHEST_RECOVERY_LOCK"
                state.recoveryLocked=true
                state.recoveryReason="Chest target is occupied by a protected block at " .. tostring(tx)
                saveState()
                sendState(state.recoveryReason)
                return false
            end
            pcall(turtle.dig)
            sleep(0.1)
            existingType=peripheral.getType("front")
            okExisting,idExisting=pcall(peripheral.call,"front","getID")
            if frontPlacementOccupied() or existingType or (okExisting and tonumber(idExisting)) then
                state.phase="CHEST_RECOVERY_LOCK"
                state.recoveryLocked=true
                state.recoveryReason="Chest target could not be normalized at " .. tostring(tx)
                saveState()
                sendState(state.recoveryReason)
                return false
            end
            if not selfSelectKind(kind) or not turtle.place() then
                state.phase="WAITING_ENDER_CHEST"
                saveState()
                sendState("Cannot place " .. kind .. " for Foreman-" .. tostring(number))
                return false
            end
            if not wrapInventory("front") then
                state.phase="CHEST_PLACEMENT_ERROR"
                saveState()
                sendState("Placed " .. kind .. " did not land on the Foreman equipment level")
                return false
            end
            state[flag]=true
            saveState()
            return true
        end

        if not placeChest("ender_dump","dumpChestPlaced",cfg.homeX) then return false end
        if not placeChest("ender_fuel","fuelChestPlaced",cfg.homeX+1) then return false end
        if not goPrivateHome() or not faceTracked(DIR_N) then return false end
        state.chestsReady=true
        saveState()
        checkpointForeman()
        sendState("Ender chest pair ready")
        return true
    end

    local function atSupply()
        if not goPrivateHome() or not faceTracked(DIR_S) then return false end
        return verifyDockInventory("dump ender")
    end

    local function atFuel()
        if not goTo(cfg.homeX+1,cfg.homeZ) or not faceTracked(DIR_S) then return false end
        return verifyDockInventory("fuel ender")
    end

    local function exitDockToLane()
        return goPrivateHome()
    end

    local function leaveDockJunction()
        return goPrivateHome()
    end

    local function exitDockHome()
        if not exitDockToLane() then
            return false
        end
        faceTracked(DIR_N)
        state.phase=active and "SERVICING" or "IDLE"
        saveState()
        sendState("Waiting")
        return true
    end

    local function loadOwnFuel(force)
        if turtle.getFuelLevel() == "unlimited" then
            return true
        end

        if not state.fuelPending and turtle.getFuelLevel()>FOREMAN_FUEL_LOW and
            (not force or turtle.getFuelLevel()>=FOREMAN_FUEL_TARGET) then
            if selfCount("empty_bucket")==0 then return true end
            if not atFuel() or not returnBucketsAtFuel() then return false end
            return exitDockHome()
        end

        state.fuelPending=state.fuelPending or turtle.getFuelLevel()<=FOREMAN_FUEL_LOW or
            (force and turtle.getFuelLevel()<FOREMAN_FUEL_TARGET)
        saveState()

        if useOwnFuel() then
            if selfCount("empty_bucket")>0 then
                if not atFuel() or not returnBucketsAtFuel() then return false end
            end
            state.fuelPending=nil
            saveState()
            return exitDockHome()
        end

        if not atFuel() then
            return false
        end

        local ok = refuelAtFrontTo(FOREMAN_FUEL_TARGET)

        if not ok then
            state.phase="WAITING_FUEL"
            saveState()
            sendState("Unable to reach foreman fuel target")
            return false
        end

        state.fuelPending=nil
        saveState()
        return exitDockHome()
    end

    local function dumpCargo()
        if not atSupply() then return false end

        for slot=1,16 do
            local item=selfItem(slot)
            local reserved=number==1 and state.bootstrapDrivePending and state.bootstrapDriveSlot==slot
            local installerResource=not state.installerConsolidationDone and item and
                (matchesItem(item,"disk_drive") or matchesItem(item,"floppy"))

            local fuelItem=matchesItem(item,"lava_bucket")
            if item and not reserved and not installerResource and
                not matchesItem(item,"empty_bucket") and not fuelItem then
                turtle.select(slot)

                while turtle.getItemCount(slot)>0 do
                    if not turtle.drop() then
                        state.phase="DOCK_BLOCKED"
                        saveState()
                        local yielded=exitDockHome()
                        state.phase="DOCK_BLOCKED"
                        saveState()
                        sendState(yielded and "Dump ender chest full; waiting with cargo at idle" or
                            "Dump ender chest full; could not leave safely")
                        return false
                    end
                end
            end
        end

        if number==1 and state.bootstrapDrivePending and state.bootstrapDriveSlot then
            local slot=state.bootstrapDriveSlot
            local item=selfItem(slot)

            if item and matchesItem(item,"disk_drive") then
                turtle.select(slot)

                if not turtle.drop(1) then
                    state.phase="DOCK_BLOCKED"
                    saveState()
                    sendState("Cannot return bootstrap Disk Drive")
                    return false
                end
            end

            state.bootstrapDrivePending=false
            state.bootstrapDriveSlot=nil
            saveState()
        end

        if selfCount("empty_bucket")>0 or selfCount("lava_bucket")>0 then
            if not atFuel() or not returnBucketsAtFuel() then
                state.phase="WAITING_FUEL"
                saveState()
                sendState("Fuel chest must accept empty buckets")
                return false
            end
            while selfCount("lava_bucket")>0 do
                local slot=selfFindSlot("lava_bucket")
                turtle.select(slot)
                if not turtle.drop() then return false end
            end
        end
        return exitDockHome()
    end



    local function prepareRuntimeService(service,req)
        state.phase="PREPARING_SERVICE"
        saveState()

        if service=="REFUEL" or service=="BOTH" then
            local kind=state.runtimeFuelKind
            local units=tonumber(state.runtimeFuelUnits)
            if not kind or not units or selfCount(kind)<units then
                if not atFuel() then return false end
                local needed=math.max(1,MINER_FUEL_TARGET-(tonumber(req and req.fuel) or 0))
                kind,units=loadFuelPacket(needed)
                if not kind then
                    state.phase="WAITING_FUEL"
                    saveState()
                    sendState("Fuel chest needs lava, blaze rods, charcoal, or coal")
                    return false
                end
                if not returnBucketsAtFuel() then
                    state.phase="WAITING_FUEL"
                    saveState()
                    sendState("Fuel chest cannot accept empty buckets after releasing service fuel")
                    return false
                end
                state.runtimeFuelKind=kind
                state.runtimeFuelUnits=units
                saveState()
                if not exitDockToLane() then return false end
            end
        end
        return true
    end

    local function dropMinerFuel(kind,amount)
        local remaining=amount
        local movedTotal=0
        for slot=1,16 do
            local item=selfItem(slot)
            if item and matchesItem(item,kind) and remaining>0 then
                turtle.select(slot)
                local before=turtle.getItemCount(slot)
                local requested=math.min(remaining,before)
                if requested>0 and turtle.drop(requested) then
                    local after=turtle.getItemCount(slot)
                    local moved=before-after
                    movedTotal=movedTotal+moved
                    remaining=remaining-moved
                end
            end
        end
        return remaining==0,movedTotal
    end

    local function countRuntimeFreeSlots()
        local free=0

        for slot=1,16 do
            if turtle.getItemCount(slot)==0 then
                free=free+1
            end
        end

        return free
    end

    local function networkLoop()
        local timer = os.startTimer(1)
        while true do
            local event = {os.pullEvent()}
            if event[1] == "rednet_message" then
                local sender = event[2]
                local message = event[3]
                local protocol = event[4]
                if protocol == PROTOCOL and type(message) == "table" then
                    if message.type=="foreman_setup_probe" and sender==cfg.controller and
                        message.session==cfg.session and tonumber(message.number)==number then
                        send(sender,{type="foreman_setup_status",number=number,
                            deployed=true,probeId=message.probeId,session=cfg.session,
                            x=state.x,y=state.y,z=state.z})
                    elseif sender==cfg.managerId and message.type=="manager_job" and
                        message.session==cfg.session and message.foremanNumber==number and
                        ((state.phase~="RECALLED_PAUSED" and not state.recallMode and
                          not flags.recallMode) or
                         (flags.packService and state.recallMode=="PACK" and
                          not flags.recallMode)) then
                        upsertRequest({
                            type="service_arrived",
                            requestId=message.requestId,
                            row=message.row,
                            service=message.service,
                            minerId=message.minerId,
                            arrived=true,
                            lastSeen=now(),
                            managerAssigned=true
                        })
                        send(cfg.managerId,{
                            type="job_accepted",
                            requestId=message.requestId,
                            foremanId=id,
                            foremanNumber=number,
                            session=cfg.session
                        })
                    elseif message.type == "foreman_position" and sender==message.foremanId then
                        peers[message.foremanId] = {
                            number=message.number,
                            x=message.x,
                            z=message.z,
                            y=message.y,
                            phase=message.phase,
                            lastSeen=now()
                        }
                    elseif message.type == "move_intent" and sender==message.foremanId then
                        intents[message.foremanId] = {
                            number=message.number,
                            x=message.x,
                            z=message.z,
                            y=message.y,
                            lastSeen=now()
                        }
                    elseif message.type == "dock_request" and number == 1 and
                        sender==message.foremanId and cfg.foremen and
                        cfg.foremen[tonumber(message.number)]==sender then
                        if dock.holder == message.foremanId then
                            send(message.foremanId,{type="dock_grant"})
                        else
                            if not dockContains(message.foremanId) then
                                dock.queue[#dock.queue+1] = message.foremanId
                                saveDock()
                            end
                            grantDock()
                        end
                    elseif message.type == "dock_release" and number == 1 and
                        sender==message.foremanId and cfg.foremen and
                        (cfg.foremen[2]==sender or cfg.foremen[3]==sender or cfg.foremen[4]==sender) then
                        if dock.holder == message.foremanId then
                            dock.holder = nil
                            saveDock()
                            grantDock()
                        end
                        send(message.foremanId,{type="dock_released"})
                    elseif message.type == "dock_grant" and sender==cfg.controller then
                        flags.dockGranted = true
                    elseif message.type=="dock_released" and sender==cfg.controller then
                        state.dockReleasePending=nil
                        saveState()
                    elseif message.type == "commission_start" and message.number == number and sender == cfg.controller then
                        if state.setupDone then
                            send(cfg.controller,{
                                type="commission_done",
                                number=number,
                                id=id
                            })
                        else
                            flags.commissionStart = true
                        end
                    elseif message.type == "start_assigned" and sender == cfg.controller then
                        flags.startMining = true
                    elseif message.type == "miner_runtime_ready" and message.row and assignedRow(message.row) then
                        state.minerIds=state.minerIds or {}
                        if not state.minerIds[message.row] or state.minerIds[message.row]==sender then
                            state.minerIds[message.row]=sender
                            saveState()
                            if state.miningStarted then
                                send(sender,{type="start_mining"})
                            end
                            pushInbox(sender,message)
                        end
                    elseif message.type=="orientation_result" and message.row and assignedRow(message.row) and
                        message.session==cfg.session then
                        pushInbox(sender,message)
                    elseif message.type == "commission_done" and cfg.master and message.number then
                        state.groupsCommissioned = state.groupsCommissioned or {}
                        state.groupsCommissioned[message.number] = true
                        commissionWave[message.number] = nil
                        saveState()
                        pushInbox(sender,message)
                    elseif sender==cfg.controller and message.session==cfg.session and
                        message.type=="installer_chain_prepare" and tonumber(message.number)==number then
                        flags.installerChainCommand={
                            action="receive",
                            expected=tonumber(message.expected),
                            token=message.token
                        }
                    elseif sender==cfg.controller and message.session==cfg.session and
                        message.type=="installer_chain_donate" and tonumber(message.number)==number then
                        flags.installerChainCommand={
                            action="donate",
                            amount=tonumber(message.amount),
                            token=message.token
                        }
                    elseif sender==cfg.managerId and message.session==cfg.session and
                        message.type=="chunk_command" then
                        local target=tonumber(message.chunkIndex)
                        if target and (target==state.chunkIndex+1 or
                            target==state.chunkIndex) then
                            flags.chunkCommand={stage=message.stage,target=target}
                        end
                    elseif sender==cfg.managerId and message.session==cfg.session and message.type == "start_mining" then
                        if not state.packPending and state.recallMode~="PACK" and not flags.packService then
                            flags.startMining = true
                        end
                    elseif sender==cfg.managerId and message.session==cfg.session and message.type == "cancel_advance" then
                        flags.advanceCancelled=true
                        if message.mode=="NORMAL" or message.mode=="SHUTDOWN" then
                            flags.resume=false
                            flags.recallMode=message.mode
                        end
                    elseif sender==cfg.managerId and message.session==cfg.session and message.type=="pack_service_begin" then
                        state.packPending=nil
                        flags.resume=false
                        if state.recallMode=="PACK" and (flags.packService or active or #queue>0 or
                            state.phase=="PACK_SERVICE" or state.phase=="SERVICING" or
                            state.phase=="RETURNING_AFTER_SERVICE" or state.phase=="SERVICE_UNLOAD_TRIP") then
                            flags.packService=true
                            send(cfg.managerId,{type="pack_service_ready",number=number,session=cfg.session})
                        elseif state.setupDone and not state.advanceStage and not active and #queue==0 and
                            state.x==cfg.homeX and state.y==0 and state.z==cfg.homeZ then
                            flags.resume=false
                            flags.recallMode=nil
                            flags.packService=true
                            state.recallMode="PACK"
                            state.phase="PACK_SERVICE"
                            state.packReady=nil
                            state.packAcknowledged=nil
                            saveState()
                            checkpointForeman()
                            send(cfg.managerId,{type="pack_service_ready",number=number,session=cfg.session})
                            sendState("Pack dump service ready")
                        else
                            send(cfg.managerId,{type="pack_service_blocked",number=number,
                                reason="Foreman is not safely parked for Pack dump service",session=cfg.session})
                        end
                    elseif sender==cfg.managerId and message.session==cfg.session and message.type == "recall_command" then
                        flags.packService=false
                        flags.resume=false
                        flags.recallMode = message.mode or "NORMAL"
                        if flags.recallMode=="PACK" then
                            state.packPending=nil
                            state.packToken=tonumber(message.packToken)
                        elseif flags.recallMode=="NORMAL" and message.packPending==true then
                            state.packPending=true
                        else
                            state.packPending=nil
                            state.packToken=nil
                        end
                        if flags.recallMode=="NORMAL" or flags.recallMode=="DUMP" or
                            flags.recallMode=="SHUTDOWN" or flags.recallMode=="PACK" then
                            flags.advanceCancelled=true
                        end
                        saveState()
                    elseif sender==cfg.managerId and message.session==cfg.session and message.type=="pack_clear" and
                        state.phase=="RECALLED_PAUSED" and state.recallMode=="PACK" and
                        tonumber(message.packToken)==tonumber(state.packToken) then
                        for attempt=1,5 do
                            os.setComputerLabel(nil)
                            if os.getComputerLabel()==nil then break end
                            sleep(0.1)
                        end
                        if os.getComputerLabel()==nil then
                            state.packReady=true
                            state.packAcknowledged=nil
                            saveState()
                            send(cfg.managerId,{
                                type="pack_ready",role="foreman",number=number,
                                packToken=state.packToken,labelCleared=true,
                                x=state.x,y=state.y,z=state.z,dir=state.dir,session=cfg.session
                            })
                        end
                    elseif sender==cfg.managerId and message.session==cfg.session and message.type=="pack_ready_ack" and
                        state.packReady and tonumber(message.packToken)==tonumber(state.packToken) then
                        state.packAcknowledged=true
                        saveState()
                    elseif sender==cfg.managerId and message.session==cfg.session and message.type == "resume_swarm" then
                        if not state.packPending and state.recallMode~="PACK" and not flags.packService and
                            (state.phase=="RECALLED_PAUSED" or state.phase=="RECALLING" or state.recallMode or flags.recallMode) then
                            flags.resume=true
                        else
                            flags.resume=false
                        end
                    elseif sender==cfg.managerId and message.session==cfg.session and message.type == "status_query" then
                        sendState("")
                    elseif sender==cfg.managerId and message.session==cfg.session and message.type=="job_complete_ack" then
                        local result=resolved[message.requestId]
                        if result then
                            result.acknowledged=true
                            saveQueue()
                        end
                    else
                        pushInbox(sender,message)
                    end
                end
            elseif event[1] == "timer" and event[2] == timer then
                if number~=1 and state.dockReleasePending then
                    send(cfg.controller,{type="dock_release",foremanId=id})
                end
                if now() - lastStatus >= STATUS_INTERVAL then
                    sendState("")
                end
                if cfg.master then
                    for n=2,4 do
                        if commissionWave[n] and cfg.foremen and cfg.foremen[n] then
                            if not commissionWave[n].lastSend or now() - commissionWave[n].lastSend >= 2 then
                                send(cfg.foremen[n],{type="commission_start",number=n})
                                commissionWave[n].lastSend = now()
                            end
                        end
                    end
                end
                if number == 1 and dock and dock.holder and dock.holder ~= id then
                    local holder = peers[dock.holder]
                    if not holder or now() - (holder.lastSeen or 0) > 15 then
                        dock.holder = nil
                        saveDock()
                        grantDock()
                    end
                end
                local expiredResolved={}
                for requestId,stamp in pairs(resolved) do
                    local result=type(stamp)=="table" and stamp or nil
                    local resolvedAt=result and tonumber(result.stamp)

                    if result and not result.acknowledged and result.minerId then
                        if not result.lastSend or now()-result.lastSend>=2 then
                            send(cfg.managerId,{
                                type="job_complete",
                                requestId=requestId,
                                foremanId=id,
                                foremanNumber=number,
                                minerId=result.minerId,
                                row=result.row,
                                service=result.service,
                                session=cfg.session
                            })
                            result.lastSend=now()
                        end
                    elseif not resolvedAt or now()-resolvedAt>300 then
                        expiredResolved[#expiredResolved+1]=requestId
                    end
                end
                for _,requestId in ipairs(expiredResolved) do
                    resolved[requestId]=nil
                end
                if now() - lastPeer >= PEER_INTERVAL then
                    broadcast({
                        type="foreman_position",
                        foremanId=id,
                        number=number,
                        x=state.x,
                        z=state.z,
                        y=state.y,
                        phase=state.phase
                    })
                    lastPeer = now()
                end
                timer = os.startTimer(1)
            end
        end
    end

    local function frontComputerId()
        local ok,id = pcall(peripheral.call,"front","getID")
        if ok then
            return tonumber(id)
        end
        return nil
    end

    local function waitFrontComputerId(timeout)
        local deadline=now()+(timeout or 1)
        repeat
            local found=frontComputerId()
            if found then return found end
            sleep(0.05)
        until now()>=deadline
        return nil
    end

    local function waitFrontDrive(timeout)
        local deadline=now()+(timeout or 1)
        repeat
            if peripheral.getType("front")=="drive" then return true end
            sleep(0.05)
        until now()>=deadline
        return false
    end

    local function clearFrontPlacementCell(label)
        local computerId=frontComputerId()
        local peripheralType=peripheral.getType("front")
        if computerId or peripheralType then
            return false,tostring(label or "Placement target").." is occupied by a protected block"
        end
        pcall(turtle.dig)
        sleep(0.1)
        computerId=frontComputerId()
        peripheralType=peripheral.getType("front")
        if computerId or peripheralType or frontPlacementOccupied() then
            return false,tostring(label or "Placement target").." could not be cleared to the Foreman equipment level"
        end
        return true
    end

    local function waitFrontDisk(timeout)
        local deadline=now()+(timeout or 1)
        repeat
            if disk.isPresent("front") then return true end
            sleep(0.05)
        until now()>=deadline
        return false
    end

    local function verifyServiceMiner(req)
        if state.x~=req.row or state.z~=-1 or state.y~=0 then
            state.phase="SERVICE_ALIGNMENT_ERROR"
            saveState()
            sendState("Foreman is not at Miner-" .. tostring(req.row) .. " service coordinate")
            return false
        end

        if not faceTracked(DIR_N) then
            return false
        end

        for attempt=1,3 do
            send(req.minerId,{
                type="service_probe",
                requestId=req.requestId,
                row=req.row
            })

            local _,reply=waitInbox(function(sender,m)
                return sender==req.minerId and type(m)=="table" and
                    m.type=="service_probe_ack" and m.requestId==req.requestId
            end,1)

            if reply and tonumber(reply.row)==tonumber(req.row) and
                tonumber(reply.x)==tonumber(req.row) and tonumber(reply.y)==0 and
                tonumber(reply.z)==0 and tonumber(reply.dir)==DIR_S then
                return true
            end
        end

        state.phase="SERVICE_ALIGNMENT_ERROR"
        saveState()
        sendState("Miner-" .. tostring(req.row) .. " did not confirm service position")
        return false
    end


    local function placeDriveAndDiskAt(tx,tz)
        local stagingZ=tz-1

        if state.x~=tx or state.z~=stagingZ then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Wrong staging square before installer placement")
            return false
        end

        if not ensureGroundLevel() then
            return false
        end

        faceTracked(DIR_N)
        saveState()

        if peripheral.getType("front")=="drive" then
            local reserved=state.bootstrapDrivePending and state.bootstrapDriveSlot or nil
            local slot=selfTargetSlotExcluding("disk_drive",reserved)

            if not slot then
                state.phase="PLACEMENT_ERROR"
                saveState()
                sendState("No room to recover misplaced ground Disk Drive")
                return false
            end

            turtle.select(slot)
            if not turtle.dig() then
                state.phase="PLACEMENT_ERROR"
                saveState()
                sendState("Cannot recover misplaced ground Disk Drive")
                return false
            end
            sleep(0.2)
        end

        if frontComputerId() then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Miner square already occupied")
            return false
        end

        if not ensureInstallerLevel() then
            return false
        end

        faceTracked(DIR_N)
        state.phase="PLACING_INSTALLER"
        saveState()

        if peripheral.getType("front")~="drive" then
            local clearOk,clearReason=clearFrontPlacementCell("Installer square at relative Y 1")
            if not clearOk then
                state.phase="PLACEMENT_ERROR"
                saveState()
                sendState(clearReason)
                ensureGroundLevel()
                return false
            end

            local reserved=state.bootstrapDrivePending and state.bootstrapDriveSlot or nil
            local driveSlot=selfFindSlotExcluding("disk_drive",reserved)

            if not driveSlot then
                state.phase="WAITING_INSTALLER"
                saveState()
                sendState("Operational Disk Drive not found")
                ensureGroundLevel()
                return false
            end

            turtle.select(driveSlot)
            if not turtle.place() then
                state.phase="PLACEMENT_ERROR"
                saveState()
                sendState("Cannot place Disk Drive directly in front at relative Y 1")
                ensureGroundLevel()
                return false
            end
            waitFrontDrive(1)
        end

        if state.y~=1 or peripheral.getType("front")~="drive" then
            state.phase="VERTICAL_ERROR"
            saveState()
            sendState("Disk Drive is not directly in front at installer height")
            ensureGroundLevel()
            return false
        end

        if not disk.isPresent("front") then
            if not selfSelectKind("floppy") then
                state.phase="WAITING_INSTALLER"
                saveState()
                sendState("Miner floppy not found")
                ensureGroundLevel()
                return false
            end

            if not turtle.drop(1) then
                state.phase="WAITING_INSTALLER"
                saveState()
                sendState("Cannot insert floppy into Disk Drive directly in front")
                ensureGroundLevel()
                return false
            end
            waitFrontDisk(1)
        end

        if not disk.isPresent("front") then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Floppy verification failed at installer height")
            ensureGroundLevel()
            return false
        end

        if not ensureGroundLevel() then
            return false
        end

        faceTracked(DIR_N)
        saveState()

        if not verifyGroundFrontNoDrive() then
            state.phase="VERTICAL_ERROR"
            saveState()
            sendState("Disk Drive is at ground level; correcting placement")

            local reserved=state.bootstrapDrivePending and state.bootstrapDriveSlot or nil
            local slot=selfTargetSlotExcluding("disk_drive",reserved)
            if not slot then
                return false
            end

            turtle.select(slot)
            if not turtle.dig() then
                sendState("Cannot recover ground-level Disk Drive for correction")
                return false
            end

            if not ensureInstallerLevel() then
                return false
            end

            local driveSlot=selfFindSlotExcluding("disk_drive",reserved)
            if not driveSlot then
                ensureGroundLevel()
                return false
            end

            local clearOk=clearFrontPlacementCell("Corrected installer square at relative Y 1")
            if not clearOk then
                ensureGroundLevel()
                return false
            end

            turtle.select(driveSlot)
            if not turtle.place() then
                ensureGroundLevel()
                return false
            end

            if peripheral.getType("front")~="drive" then
                ensureGroundLevel()
                return false
            end

            if not disk.isPresent("front") then
                if not selfSelectKind("floppy") or not turtle.drop(1) then
                    ensureGroundLevel()
                    return false
                end
            end

            if not ensureGroundLevel() then
                return false
            end

            faceTracked(DIR_N)
            if not verifyGroundFrontNoDrive() then
                state.phase="VERTICAL_ERROR"
                saveState()
                sendState("Disk Drive remained at ground level after correction")
                return false
            end
        end

        state.phase="PLACING_MINER"
        saveState()
        return state.y==0 and state.x==tx and state.z==stagingZ and state.dir==DIR_N
    end

    local function waitInstallerAtPosition(ready,phase,message)
        local warning=nil
        while not ready() do
            if flags.recallMode then return false end
            state.phase=phase
            if not warning or now()-warning>=5 then
                state.setupBlockReason=message
                saveState()
                sendState(message)
                warning=now()
            end
            sleep(0.25)
        end
        return true
    end

    local function recoverInstaller(workerId,tx,tz,useBootstrapDrive)
        local stagingZ=tz-1
        local progress=state.commissionProgress

        if state.x~=tx or state.z~=stagingZ then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Foreman moved away before installer recovery")
            return false
        end

        if not ensureGroundLevel() then
            return false
        end

        faceTracked(DIR_N)

        if frontComputerId()~=workerId then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Assigned miner not directly in front")
            return false
        end

        if not progress or not progress.floppyRecovered then
            if not ensureInstallerLevel() then
                return false
            end

            faceTracked(DIR_N)
            state.phase="RETRIEVING_FLOPPY"
            saveState()

        if not waitInstallerAtPosition(function()
            return peripheral.getType("front")=="drive"
        end,"WAITING_INSTALLER","Miner-"..tostring(state.commissionProgress and
            state.commissionProgress.row or "?").." Disk Drive not visible at installer height") then
            return false
        end

        if disk.isPresent("front") then
            local floppySlot=nil
            if not waitInstallerAtPosition(function()
                floppySlot=selfTargetSlot("floppy")
                return floppySlot~=nil or not disk.isPresent("front")
            end,"WAITING_INSTALLER","Miner-"..tostring(progress and progress.row or "?")..
                " floppy remains in drive; foreman inventory has no receiving slot") then
                return false
            end
            if floppySlot and disk.isPresent("front") and progress and
                not progress.floppyRecoveryPending then
                progress.floppyRecoveryPending={slot=floppySlot,count=selfCount("floppy")}
                saveState()
            end
            local lastWarning=now()
            while disk.isPresent("front") do
                if flags.recallMode then return false end
                if floppySlot then
                    turtle.select(floppySlot)
                    turtle.suck(1)
                end
                if disk.isPresent("front") then sleep(0.25) end
                if now()-lastWarning>=10 then
                    state.phase="WAITING_INSTALLER"
                    state.setupBlockReason="Miner-"..tostring(progress and progress.row or "?")..
                        " floppy still in drive; check its inventory and disk access"
                    saveState()
                    sendState(state.setupBlockReason)
                    lastWarning=now()
                end
            end
        end

        if progress and progress.floppyRecoveryPending and
            selfCount("floppy")<=progress.floppyRecoveryPending.count then
            state.phase="RECOVERY_LOCK"
            state.recoveryLocked=true
            state.recoveryReason="Miner floppy left drive but no foreman inventory receipt"
            saveState()
            sendState(state.recoveryReason)
            return false
        end
        if selfCount("floppy")<1 then
            state.phase="RECOVERY_LOCK"
            state.recoveryLocked=true
            state.recoveryReason="Miner-"..tostring(progress and progress.row or "?")..
                " drive is empty but foreman has no floppy"
            saveState()
            sendState(state.recoveryReason)
            return false
        end
        if progress then
            progress.floppyRecovered=true
            progress.floppyRecoveryPending=nil
            saveState()
        end
        end

        if not ensureGroundLevel() then
            return false
        end

        faceTracked(DIR_N)

        if peripheral.getType("front")=="drive" then
            state.phase="RECOVERY_LOCK"
            state.recoveryLocked=true
            state.recoveryReason="Disk Drive detected at ground level after floppy retrieval"
            saveState()
            sendState(state.recoveryReason)
            return false
        end

        if frontComputerId()~=workerId then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Assigned miner moved before Disk Drive handoff")
            return false
        end

        if progress and not progress.driveRecoveryPending and
            not progress.driveReceived and state.phase=="CONFIRMING_INSTALLER_HANDOFF" and
            selfCount("disk_drive")>0 then
            local receivedSlot=selfFindSlot("disk_drive")
            if receivedSlot then
                progress.driveRecoveryPending={slot=receivedSlot,
                    count=selfCount("disk_drive")-1,
                    slotCount=math.max(0,turtle.getItemCount(receivedSlot)-1)}
                progress.driveReceived=true
                saveState()
            end
        end
        local pending=progress and progress.driveRecoveryPending
        if not pending and progress and not progress.driveReceived then
            local targetSlot=nil
            if not waitInstallerAtPosition(function()
                if useBootstrapDrive then
                    targetSlot=selfEmptySlot()
                else
                    local reserved=state.bootstrapDrivePending and state.bootstrapDriveSlot or nil
                    targetSlot=selfTargetSlotExcluding("disk_drive",reserved)
                end
                return targetSlot~=nil
            end,"WAITING_INSTALLER","Miner-"..tostring(progress.row)..
                " drive still held by miner; foreman has no receiving slot") then
                return false
            end
            pending={slot=targetSlot,count=selfCount("disk_drive"),
                slotCount=turtle.getItemCount(targetSlot)}
            progress.driveRecoveryPending=pending
            saveState()
        end

        if not progress or not progress.driveReceived then
            local targetSlot=pending and pending.slot
            if pending and (selfCount("disk_drive")>(pending.count or 0) or
                (targetSlot and turtle.getItemCount(targetSlot)>(pending.slotCount or 0) and
                 matchesItem(selfItem(targetSlot),"disk_drive"))) then
                progress.driveReceived=true
                saveState()
            else
                if not targetSlot then
                    state.phase="RECOVERY_LOCK"
                    state.recoveryLocked=true
                    state.recoveryReason="Miner installer drive receipt has no saved receiving slot"
                    saveState()
                    sendState(state.recoveryReason)
                    return false
                end
                state.phase="WAITING_FOR_DRIVE"
                state.setupBlockReason="Miner-"..tostring(progress.row)..
                    " floppy recovered; waiting for miner to break Disk Drive"
                saveState()
                sendState(state.setupBlockReason)

                local ready=nil
                local lastRequest=0
                local lastWarning=now()
                while not ready do
                    if flags.recallMode then return false end
                    if now()-lastRequest>=1 then
                        send(workerId,{type="return_installer"})
                        lastRequest=now()
                    end
                    local _,reply=waitInbox(function(sender,m)
                        return sender==workerId and type(m)=="table" and
                            (m.type=="installer_ready" or m.type=="installer_break_failed")
                    end,0.5)
                    if reply then
                        if reply.type=="installer_ready" then
                            ready=reply
                        else
                            state.setupBlockReason="Miner-"..tostring(progress.row)..
                                " cannot break Disk Drive: "..tostring(reply.reason)
                            saveState()
                            sendState(state.setupBlockReason)
                        end
                    elseif now()-lastWarning>=10 then
                        sendState(state.setupBlockReason)
                        lastWarning=now()
                    end
                end

                turtle.select(targetSlot)
                lastWarning=now()
                while not progress.driveReceived do
                    if flags.recallMode then return false end
                    turtle.suck(1)
                    sleep(0.1)
                    if selfCount("disk_drive")>(pending.count or 0) or
                        (turtle.getItemCount(targetSlot)>(pending.slotCount or 0) and
                         matchesItem(selfItem(targetSlot),"disk_drive")) then
                        progress.driveReceived=true
                        saveState()
                    else
                        send(workerId,{type="return_installer"})
                        if now()-lastWarning>=10 then
                            state.phase="WAITING_FOR_DRIVE_TRANSFER"
                            state.setupBlockReason="Miner-"..tostring(progress.row)..
                                " broke Disk Drive but transfer to foreman has not completed"
                            saveState()
                            sendState(state.setupBlockReason)
                            lastWarning=now()
                        end
                        sleep(0.25)
                    end
                end
            end
        end

        if useBootstrapDrive and progress and progress.driveReceived then
            state.bootstrapDrivePending=true
            state.bootstrapDriveSlot=pending and pending.slot or state.bootstrapDriveSlot
            saveState()
        end

        if selfCount("disk_drive")<1 then
            state.phase="RECOVERY_LOCK"
            state.recoveryLocked=true
            state.recoveryReason="Miner Disk Drive receipt was saved but item is missing"
            saveState()
            sendState(state.recoveryReason)
            return false
        end

        state.phase="CONFIRMING_INSTALLER_HANDOFF"
        saveState()

        local returned=nil
        local lastTaken=0
        lastWarning=now()

        while not returned and not (progress and progress.installerTaken) do
            if flags.recallMode then return false end
            if now()-lastTaken>=1 then
                send(workerId,{type="installer_taken"})
                lastTaken=now()
            end

            local _,reply=waitInbox(function(sender,m)
                return sender==workerId and type(m)=="table" and m.type=="installer_returned"
            end,0.5)

            if reply then
                returned=reply
                if progress then
                    progress.installerTaken=true
                    saveState()
                end
            elseif now()-lastWarning>=10 then
                state.setupBlockReason="Miner-"..tostring(progress and progress.row or "?")..
                    " Disk Drive received; waiting for miner acknowledgement"
                saveState()
                sendState(state.setupBlockReason)
                lastWarning=now()
            end
        end

        state.phase="INSTALLER_RECOVERED"
        state.setupBlockReason=nil
        saveState()
        return true
    end

    local function validateCommissionPackage()
        if state.commissionProgress and state.commissionProgress.row and
            not (state.commissionedRows and
                 state.commissionedRows[state.commissionProgress.row]) then
            return true
        end
        local remaining = 0
        state.commissionedRows = state.commissionedRows or {}

        for row=cfg.rowStart,cfg.rowEnd do
            if not state.commissionedRows[row] then
                remaining = remaining + 1
            end
        end

        if remaining == 0 then
            return true
        end

        if selfCount("floppy") < 1 and not
            (number==1 and not state.firstInstallerRecovered) then
            state.phase="WAITING_SUPPLIES"
            saveState()
            sendState("Missing miner floppy")
            return false
        end

        if selfCount("advanced_wireless_mining_turtle") < remaining then
            state.phase="WAITING_SUPPLIES"
            saveState()
            sendState("Missing assigned miners")
            return false
        end

        if state.commissionFuelLoaded and
            selfCount(state.commissionFuelKind or "coal") <
                (state.commissionFuelUnits or WORKER_SETUP_COAL) then
            state.phase="WAITING_SUPPLIES"
            saveState()
            sendState("Not enough miner commissioning fuel packets")
            return false
        end

        local reserved=state.bootstrapDrivePending and state.bootstrapDriveSlot or nil
        local bootstrapMounted=number==1 and not state.firstInstallerRecovered and
            not (state.commissionedRows and state.commissionedRows[1])
        if not bootstrapMounted and selfCountExcluding("disk_drive",reserved) < 1 then
            state.phase="WAITING_SUPPLIES"
            saveState()
            sendState("Missing operational Disk Drive")
            return false
        end

        return true
    end

    local function commissionMiner(row,useBootstrapDrive)
        if not validateCommissionPackage() then
            return false
        end

        local progress=state.commissionProgress
        if progress and progress.row~=row then
            state.phase="RECOVERY_LOCK"
            state.recoveryLocked=true
            state.recoveryReason="Different miner commissioning stage is still pending"
            saveState()
            return false
        end
        if not progress then
            progress={row=row,bootstrap=useBootstrapDrive}
            state.commissionProgress=progress
            saveState()
        end

        local targetX=row
        local targetZ=0
        local stagingZ=-1
        local temporary=false

        if useBootstrapDrive and not progress.workerId then
            targetX=1
            targetZ=0
            stagingZ=-1
            temporary=false

            if state.x~=targetX or state.z~=stagingZ then
                if not goTo(targetX,stagingZ) then
                    return false
                end
            end

            faceTracked(DIR_N)
            saveState()

            if not ensureInstallerLevel() then
                return false
            end

            faceTracked(DIR_N)

            if peripheral.getType("front")~="drive" then
                ensureGroundLevel()
                state.phase="PLACEMENT_ERROR"
                saveState()
                sendState("Bootstrap Disk Drive missing above Miner-01 pad")
                return false
            end

            if not disk.isPresent("front") then
                if not selfSelectKind("floppy") then
                    ensureGroundLevel()
                    state.phase="WAITING_INSTALLER"
                    saveState()
                    sendState("Foreman-1 bootstrap floppy missing")
                    return false
                end

                if not turtle.drop(1) then
                    ensureGroundLevel()
                    state.phase="WAITING_INSTALLER"
                    saveState()
                    sendState("Cannot insert Foreman-1 bootstrap floppy")
                    return false
                end
            end

            if not disk.isPresent("front") then
                ensureGroundLevel()
                state.phase="PLACEMENT_ERROR"
                saveState()
                sendState("Bootstrap floppy verification failed")
                return false
            end

            if not ensureGroundLevel() then
                return false
            end

            faceTracked(DIR_N)
        else
            if state.x~=targetX or state.z~=stagingZ then
                state.phase="PLACEMENT_ERROR"
                saveState()
                sendState("Foreman is not at the expected miner staging position")
                return false
            end

            if not progress.workerId and not useBootstrapDrive and
                not placeDriveAndDiskAt(targetX,targetZ) then
                return false
            end
        end

        if not ensureGroundLevel() then
            return false
        end

        faceTracked(DIR_N)

        if state.x~=targetX or state.z~=stagingZ or state.y~=0 or state.dir~=DIR_N then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Wrong position or facing before miner placement")
            return false
        end

        if frontComputerId() and frontComputerId()~=progress.workerId then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Miner target already occupied")
            return false
        end

        if not progress.workerId then
            local clearOk,clearReason=clearFrontPlacementCell("Miner-"..tostring(row).." target")
            if not clearOk then
                state.phase="PLACEMENT_ERROR"
                saveState()
                sendState(clearReason)
                return false
            end
        end

        if not progress.workerId and not selfSelectKind("advanced_wireless_mining_turtle") then
            state.phase="WAITING_SUPPLIES"
            saveState()
            sendState("Wireless Mining Turtle missing")
            return false
        end

        if not progress.expectedGps then
            progress.expectedGps=expectedNorthPlacement()
            if not progress.expectedGps then return false end
            saveState()
        end

        if not progress.workerId and not turtle.place() then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Cannot place Miner-" .. tostring(row))
            return false
        end

        local workerId=progress.workerId or waitFrontComputerId(1)
        if not workerId then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Cannot identify Miner-" .. tostring(row))
            return false
        end
        progress.workerId=workerId
        saveState()

        pcall(peripheral.call,"front","turnOn")

        local configurePacket={
            type="configure",
            target=workerId,
            role="miner",
            row=row,
            foremanId=id,
            foremanNumber=number,
            expectedGps=progress.expectedGps,
            worldOrigin=cfg.worldOrigin,
            tempDeployment=temporary,
            managerId=cfg.managerId,
            masterForemanId=cfg.masterForemanId,
            session=cfg.session
        }

        local installed=nil
        local lastConfigure=0
        local warning=now()

        while not installed and not progress.installed do
            if flags.recallMode then return false end
            if now()-lastConfigure>=1 then
                send(workerId,configurePacket)
                pcall(peripheral.call,"front","turnOn")
                lastConfigure=now()
            end

            local _,reply=waitInbox(function(sender,m)
                return sender==workerId and type(m)=="table" and m.type=="install_ok" and m.row==row
            end,0.5)

            if reply then
                installed=reply
                progress.installed=true
                saveState()
            elseif now()-warning>=10 then
                state.phase="WAITING_MINER_BOOT"
                saveState()
                sendState("Waiting for Miner-" .. tostring(row) .. " installation")
                warning=now()
            end
        end

        if frontComputerId()~=workerId then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Miner moved before commissioning completed")
            return false
        end

        local setupKind=progress.setupKind or state.commissionFuelKind
        local setupUnits=progress.setupUnits or state.commissionFuelUnits
        if not setupKind or not setupUnits then return false end
        progress.setupKind=setupKind
        progress.setupUnits=setupUnits
        saveState()
        if not progress.fuelHanded then
            if progress.fuelTransferPending then
                if selfCount(setupKind)>=setupUnits then
                    progress.fuelTransferPending=nil
                    saveState()
                elseif frontComputerId()==workerId then
                    progress.fuelHanded=true
                    progress.fuelTransferPending=nil
                    progress.bucketsBefore=selfCount("empty_bucket")
                    saveState()
                else
                    state.phase="WAITING_FUEL"
                    saveState()
                    sendState("Miner-" .. tostring(row) .. " fuel transfer recovery cannot verify the recipient")
                    return false
                end
            end
            if not progress.fuelHanded then
                progress.fuelTransferPending=true
                saveState()
                if not selfDropKind(setupKind,setupUnits) then
                    state.phase="WAITING_FUEL"
                    saveState()
                    sendState("Miner-" .. tostring(row) .. " fuel transfer incomplete; retrying from physical inventory")
                    return false
                end
                progress.fuelHanded=true
                progress.fuelTransferPending=nil
                progress.bucketsBefore=selfCount("empty_bucket")
                saveState()
            end
        end
        if setupKind=="lava_bucket" and
            selfCount("empty_bucket")<(progress.bucketsBefore or 0)+setupUnits and
            not selfTargetSlot("empty_bucket") then
            state.phase="WAITING_BUCKET_RETURN"
            saveState()
            sendState("Foreman has no inventory space for Miner-" .. tostring(row) .. " empty bucket")
            return false
        end
        local bucketsBefore=progress.bucketsBefore or selfCount("empty_bucket")

        local fueled=nil
        local lastFuel=0
        warning=now()

        while not fueled and not progress.fuelDone do
            if flags.recallMode then return false end
            if now()-lastFuel>=1 then
                send(workerId,{type="commission_refuel",fuelKind=setupKind,
                    fuelUnits=setupUnits})
                lastFuel=now()
            end

            local _,reply=waitInbox(function(sender,m)
                return sender==workerId and type(m)=="table" and m.type=="commission_refueled" and m.row==row
            end,0.5)

            if reply then
                fueled=reply
                if reply.fuel~="unlimited" and
                    (tonumber(reply.fuel) or 0)<MINER_FUEL_TARGET then
                    state.phase="WAITING_FUEL"
                    saveState()
                    sendState("Miner-" .. tostring(row) .. " needs full startup fuel")
                    return false
                end
                local recovered=state.commissionBucketsRecovered and
                    state.commissionBucketsRecovered[row] or 0
                if recovered==true then recovered=1 end
                local expected=setupKind=="lava_bucket" and setupUnits or 0
                if expected>recovered and
                    (tonumber(reply.bucketCount) or
                     (reply.bucketPresent and 1 or 0))<expected-recovered and
                    selfCount("empty_bucket")<bucketsBefore+expected-recovered then
                    state.phase="WAITING_BUCKET_RETURN"
                    saveState()
                    sendState("Miner-" .. tostring(row) .. " has not produced its empty bucket")
                    return false
                end
                while recovered<expected do
                    if selfCount("empty_bucket")>=bucketsBefore+recovered+1 then
                        recovered=recovered+1
                    else
                        local slot=selfTargetSlot("empty_bucket")
                        if not slot then
                            state.phase="WAITING_BUCKET_RETURN"
                            saveState()
                            sendState("Foreman has no room for Miner-" .. tostring(row) .. " empty bucket")
                            return false
                        end
                        turtle.select(slot)
                        local before=turtle.getItemCount(slot)
                        if not turtle.suck(1) or turtle.getItemCount(slot)<=before then
                            state.phase="WAITING_BUCKET_RETURN"
                            saveState()
                            sendState("Cannot retrieve empty bucket from Miner-" .. tostring(row))
                            return false
                        end
                        recovered=recovered+1
                    end
                    state.commissionBucketsRecovered=state.commissionBucketsRecovered or {}
                    state.commissionBucketsRecovered[row]=recovered
                    saveState()
                end
                progress.fuelDone=true
                saveState()
            elseif now()-warning>=10 then
                state.phase="WAITING_MINER_FUEL"
                saveState()
                sendState("Waiting for Miner-" .. tostring(row) .. " fuel confirmation")
                warning=now()
            end
        end

        if not progress.installerRecovered then
            if not recoverInstaller(workerId,targetX,targetZ,useBootstrapDrive) then
                return false
            end
            progress.installerRecovered=true
            saveState()
        end

        local deployed=nil
        local lastDeploy=0
        warning=now()

        while not deployed and not progress.deployed do
            if flags.recallMode then return false end
            if now()-lastDeploy>=1 then
                send(workerId,{type="deploy_miner"})
                lastDeploy=now()
            end

            local _,reply=waitInbox(function(sender,m)
                return sender==workerId and type(m)=="table" and m.row==row and
                    (m.type=="miner_deployed" or m.type=="miner_deploy_blocked")
            end,0.5)

            if reply then
                if reply.type=="miner_deployed" then
                    deployed=reply
                    progress.deployed=true
                    saveState()
                else
                    state.phase="MINER_DEPLOY_BLOCKED"
                    saveState()
                    sendState("Miner-" .. tostring(row) .. " deployment blocked: " .. tostring(reply.reason))
                    return false
                end
            elseif now()-warning>=10 then
                state.phase="WAITING_MINER_DEPLOY"
                saveState()
                sendState("Waiting for Miner-" .. tostring(row) .. " standby confirmation")
                warning=now()
            end
        end

        if not progress.runtimeReady then
            warning=now()
            while not progress.runtimeReady do
                if flags.recallMode then return false end
                local _,reply=waitInbox(function(sender,m)
                    return sender==workerId and type(m)=="table" and
                        m.type=="miner_runtime_ready" and tonumber(m.row)==tonumber(row)
                end,0.5)
                if reply then
                    progress.runtimeReady=true
                    saveState()
                elseif now()-warning>=10 then
                    state.phase="WAITING_MINER_RUNTIME"
                    saveState()
                    sendState("Waiting for Miner-" .. tostring(row) .. " post-deployment runtime")
                    warning=now()
                end
            end
        end

        state.minerIds=state.minerIds or {}
        state.minerIds[row]=workerId

        if useBootstrapDrive then
            state.firstInstallerRecovered=true
            state.bootstrapDrivePending=nil
            state.bootstrapDriveSlot=nil
        end

        faceTracked(DIR_N)
        state.phase="MINER_COMMISSIONED"
        saveState()
        return true
    end

    local function returnUnusedFuel()
        if turtle.getFuelLevel()~="unlimited" and
            turtle.getFuelLevel()<=FOREMAN_FUEL_LOW and not useOwnFuel() then
            state.fuelPending=true
            saveState()
            return false
        end
        if not atFuel() then return false end
        for _,kind in ipairs({"lava_bucket"}) do
            while selfCount(kind)>0 do
                local slot=selfFindSlot(kind)
                if not slot then return false end
                turtle.select(slot)
                if not turtle.drop() then
                    state.phase="DOCK_BLOCKED"
                    saveState()
                    sendState("Cannot return unused fuel; dock token retained")
                    return false
                end
            end
        end
        if not returnBucketsAtFuel() then
            state.phase="DOCK_BLOCKED"
            saveState()
            sendState("Cannot return empty buckets; dock token retained")
            return false
        end
        if selfCount("blaze_rod")>0 or selfCount("charcoal")>0 or selfCount("coal")>0 then
            if not atSupply() then return false end
            for _,kind in ipairs({"blaze_rod","charcoal","coal"}) do
                while selfCount(kind)>0 do
                    local slot=selfFindSlot(kind)
                    if not slot then return false end
                    turtle.select(slot)
                    if not turtle.drop() then
                        state.phase="DOCK_BLOCKED"
                        saveState()
                        sendState("Dump ender chest cannot accept unused solid fuel")
                        return false
                    end
                end
            end
        end
        return exitDockHome()
    end

    local function returnSetupResources()
        local reserved=state.bootstrapDrivePending and state.bootstrapDriveSlot or nil

        if turtle.getFuelLevel()~="unlimited" and
            turtle.getFuelLevel()<=FOREMAN_FUEL_LOW then useOwnFuel() end

        if not atFuel() then
            return false
        end

        for _,kind in ipairs({"lava_bucket"}) do
            while selfCount(kind)>0 do
                local slot=selfFindSlot(kind)
                if not slot then return false end
                turtle.select(slot)
                if not turtle.drop() then
                    state.phase="DOCK_BLOCKED"
                    saveState()
                    sendState("Cannot return unused fuel; dock token retained")
                    return false
                end
            end
        end
        if not returnBucketsAtFuel() then
            state.phase="DOCK_BLOCKED"
            saveState()
            sendState("Cannot return empty buckets; dock token retained")
            return false
        end

        if not atSupply() then
            return false
        end

        for _,kind in ipairs({"blaze_rod","charcoal","coal"}) do
            while selfCount(kind)>0 do
                local slot=selfFindSlot(kind)
                if not slot then return false end
                turtle.select(slot)
                if not turtle.drop() then
                    state.phase="DOCK_BLOCKED"
                    saveState()
                    sendState("Dump ender chest cannot accept unused solid fuel")
                    return false
                end
            end
        end

        return exitDockHome()
    end

    local function minerOrientationCommand(row,action,step,expectRight,expectLeft,confirm)
        local minerId=state.minerIds and state.minerIds[row]
        if not minerId then return false,"Miner-"..tostring(row).." is not registered for orientation verification" end
        local token=tostring(cfg.session)..":orient:"..tostring(number)..":"..tostring(state.orientationCheckToken or 0)..":"..tostring(step)
        local packet={
            type="orientation_command",
            action=action,
            token=token,
            row=row,
            expectRight=expectRight,
            expectLeft=expectLeft,
            confirm=confirm,
            session=cfg.session
        }
        local deadline=now()+20
        local lastSend=0
        repeat
            if now()-lastSend>=1 then
                send(minerId,packet)
                lastSend=now()
            end
            local _,reply=waitInbox(function(sender,m)
                return sender==minerId and type(m)=="table" and m.type=="orientation_result" and
                    m.token==token and tonumber(m.row)==tonumber(row)
            end,0.5)
            if reply then
                if reply.ok then return true end
                return false,reply.reason or ("Miner-"..tostring(row).." orientation command failed")
            end
        until now()>=deadline
        return false,"Miner-"..tostring(row).." did not answer orientation command "..tostring(action)
    end

    local function repairAssignedMinerOrientation(reason)
        state.phase="VERIFYING_ORIENTATION"
        state.setupBlockReason=reason or "Peer orientation check requires GPS correction"
        saveState()
        sendState(state.setupBlockReason)
        local step=100
        for row=cfg.rowStart,cfg.rowEnd do
            local ok,repairReason=minerOrientationCommand(row,"gps_repair",step,nil,nil,true)
            step=step+1
            if not ok then
                state.phase="WAITING_ORIENTATION"
                state.setupBlockReason="Miner-"..tostring(row).." GPS orientation correction failed: "..tostring(repairReason)
                saveState()
                sendState(state.setupBlockReason)
                return false
            end
        end
        state.orientationCheckDone=true
        state.orientationCheckStarted=nil
        state.setupBlockReason=nil
        state.phase="COMMISSIONING"
        saveState()
        sendState("All assigned miners corrected north by GPS")
        return true
    end

    local function verifyAssignedMinerOrientation()
        if state.orientationCheckDone then return true end
        state.orientationCheckToken=(tonumber(state.orientationCheckToken) or 0)+1
        state.orientationCheckStarted=true
        state.phase="VERIFYING_ORIENTATION"
        saveState()
        return repairAssignedMinerOrientation("GPS-authoritative orientation verification")
    end

    local function loadCommissionFuel()
        state.commissionedRows = state.commissionedRows or {}

        local remaining = 0
        for row=cfg.rowStart,cfg.rowEnd do
            if not state.commissionedRows[row] then
                remaining = remaining + 1
            end
        end

        if remaining == 0 then
            return true
        end

        if state.commissionFuelLoaded then
            local loadedKind=state.commissionFuelKind
            local loadedUnits=tonumber(state.commissionFuelUnits) or 0
            if loadedKind and loadedUnits>0 and selfCount(loadedKind)>=loadedUnits then
                return true
            end
            state.commissionFuelLoaded=false
            state.commissionFuelKind=nil
            state.commissionFuelUnits=nil
            saveState()
        end

        if not atFuel() then
            state.phase="WAITING_FUEL"
            state.setupBlockReason="Cannot reach or read Foreman-"..tostring(number).." fuel chest"
            saveState()
            sendState(state.setupBlockReason)
            return false
        end

        if turtle.getFuelLevel()~="unlimited" and
            turtle.getFuelLevel()<=FOREMAN_FUEL_LOW and
            not refuelAtFrontTo(FOREMAN_FUEL_TARGET) then
            state.phase="WAITING_FUEL"
            state.setupBlockReason="Foreman-"..tostring(number).." fuel chest needs a usable lava bucket, blaze rod, charcoal, or coal for foreman refueling"
            saveState()
            sendState(state.setupBlockReason)
            return false
        end

        local kind,units
        for attempt=1,5 do
            kind,units=loadFuelPacket(MINER_FUEL_TARGET,1)
            if kind and units and selfCount(kind)>=units then break end
            kind=nil
            units=nil
            if frontFuelCount("lava_bucket")>0 then
                local slot=selfTargetSlot("lava_bucket")
                if slot then
                    turtle.select(slot)
                    local before=turtle.getItemCount(slot)
                    if turtle.suck(1) and turtle.getItemCount(slot)>before and selfCount("lava_bucket")>0 then
                        kind="lava_bucket"
                        units=1
                        break
                    end
                end
            end
            sleep(0.2)
        end
        if not kind or not units or selfCount(kind)<units then
            state.phase="WAITING_FUEL"
            state.setupBlockReason="Foreman-"..tostring(number).." could not acquire the physical startup fuel packet for its next miner"
            saveState()
            sendState(state.setupBlockReason)
            return false
        end
        if not returnBucketsAtFuel() then
            state.phase="WAITING_FUEL"
            state.setupBlockReason="Foreman-"..tostring(number).." fuel chest cannot accept empty buckets after releasing the next fuel packet"
            saveState()
            sendState(state.setupBlockReason)
            return false
        end
        state.commissionFuelKind=kind
        state.commissionFuelUnits=units
        state.commissionFuelLoaded=true
        state.setupBlockReason=nil
        saveState()

        return leaveDockJunction()
    end

    local function commissionAssigned()
        state.phase="COMMISSIONING"
        state.commissionedRows = state.commissionedRows or {}
        saveState()
        if not ensureEnderPair() then return false end
        sendState("Collecting miner startup fuel")

        if not loadCommissionFuel() then
            return false
        end

        sendState("Commissioning assigned miners")

        if not validateCommissionPackage() then
            return false
        end

        local first=cfg.rowStart
        local last=cfg.rowEnd
        local firstPending=nil

        for row=first,last do
            if not state.commissionedRows[row] then
                firstPending=row
                break
            end
        end

        if firstPending then
            local firstIsBootstrap=number==1 and firstPending==1 and not state.firstInstallerRecovered

            if not firstIsBootstrap then
                local laneZ=privateLaneZ()

                if not enterPrivateLane() then
                    return false
                end

                if state.x~=firstPending then
                    if not goTo(firstPending,laneZ) then
                        return false
                    end
                end

                if state.z~=-1 then
                    if not goTo(firstPending,-1) then
                        return false
                    end
                end

                faceTracked(DIR_N)
                saveState()
            end
        end

        for row=first,last do
            if flags.recallMode then
                return false
            end

            if not state.commissionedRows[row] then
                local useBootstrapDrive=number==1 and row==1 and not state.firstInstallerRecovered

                if useBootstrapDrive then
                    if not commissionMiner(row,true) then
                        return false
                    end
                else
                    if state.x~=row or state.z~=-1 then
                        if not goTo(row,-1) then
                            return false
                        end
                        faceTracked(DIR_N)
                        saveState()
                    end

                    if not commissionMiner(row,false) then
                        return false
                    end
                end

                state.commissionedRows[row]=true
                state.commissionFuelLoaded=false
                state.commissionProgress=nil
                saveState()

                if row<last then
                    if not loadCommissionFuel() then return false end
                    local nextRow=row+1

                    local laneZ=privateLaneZ()

                    if not enterPrivateLane() then
                        return false
                    end

                    if state.x~=nextRow then
                        if not goTo(nextRow,laneZ) then
                            return false
                        end
                    end

                    if state.z~=-1 then
                        if not goTo(nextRow,-1) then
                            return false
                        end
                    end

                    faceTracked(DIR_N)
                    saveState()

                    if state.x~=nextRow or state.z~=-1 or state.dir~=DIR_N then
                        state.phase="PLACEMENT_ERROR"
                        saveState()
                        sendState("Could not stage for next miner")
                        return false
                    end
                end
            end
        end

        state.setupBlockReason=nil
        if not verifyAssignedMinerOrientation() then
            return false
        end
        if not returnSetupResources() then
            state.setupBlockReason=state.setupBlockReason or
                "Foreman-"..tostring(number)..
                " resource return blocked after Miner-"..tostring(last)..
                " ("..tostring(state.phase)..")"
            saveState()
            sendState(state.setupBlockReason)
            return false
        end

        if not returnHome() then
            state.setupBlockReason="Foreman-"..tostring(number)..
                " could not reach idle after Miner-"..tostring(last)..
                " ("..tostring(state.phase)..")"
            saveState()
            sendState(state.setupBlockReason)
            return false
        end

        state.setupBlockReason=nil
        state.commissionFuelLoaded=false
        state.setupDone=true
        state.phase="IDLE"
        saveState()
        sendState("Miner setup complete at idle")
        for i=1,3 do
            send(cfg.controller,{
                type="commission_done",
                number=number,
                id=id
            })
            sleep(0.1)
        end
        sendState("Miner setup complete")
        return true
    end

    local function refuelMasterDirect(target)
        if turtle.getFuelLevel()=="unlimited" then return true end
        local selected=turtle.getSelectedSlot()
        while turtle.getFuelLevel()<target do
            local consumed=false
            for slot=1,16 do
                if turtle.getItemCount(slot)>0 then
                    turtle.select(slot)
                    local okProbe,canFuel=pcall(turtle.refuel,0)
                    if okProbe and canFuel then
                        local okUse,used=pcall(turtle.refuel,1)
                        if okUse and used then
                            consumed=true
                            break
                        end
                    end
                end
            end
            if not consumed then
                turtle.select(selected)
                return false
            end
        end
        turtle.select(selected)
        return true
    end

    local function ensureMasterSeedFuel()
        if turtle.getFuelLevel() == "unlimited" or turtle.getFuelLevel() > 0 then
            return true
        end

        while turtle.getFuelLevel()~="unlimited" and turtle.getFuelLevel()<=0 do
            if not refuelMasterDirect(1) then
                state.setupBlockReason="Place a lava bucket, blaze rod, charcoal, or coal in Foreman-1"
                state.phase="WAITING_SEED_FUEL"
                saveState()
                sendState(state.setupBlockReason)
                clearAndPrint({"Foreman-1 seed fuel required", "Lava bucket, blaze rod,", "charcoal, or coal", "Setup resumes automatically."})
                sleep(1)
            end
        end

        state.phase="MASTER_SETUP"
        saveState()
        return true
    end

    local function masterInitialChests()
        if state.chestsReady then return true end
        if not goTo(0,-1) or not faceTracked(DIR_N) then
            state.setupBlockReason="Cannot reach the Black Blue Blue supply chest"
            return false
        end
        if not wrapInventory("front") then
            state.setupBlockReason="Black Blue Blue supply chest is not readable directly north of Master Foreman"
            return false
        end
        if not state.dumpChestPlaced and selfCount("ender_dump")<1 and
            takeNamedIntoSelf("ender_dump",1)<1 then
            state.setupBlockReason="Initial supply chest needs the White White White dump Ender Chest"
            return false
        end
        if not state.fuelChestPlaced and selfCount("ender_fuel")<1 and
            takeNamedIntoSelf("ender_fuel",1)<1 then
            state.setupBlockReason="Initial supply chest needs the White White Blue fuel Ender Chest"
            return false
        end
        if not ensureEnderPair() then
            state.setupBlockReason=state.setupBlockReason or "Master Foreman could not deploy its dump and fuel chests"
            return false
        end
        if not atFuel() or not returnBucketsAtFuel() then
            state.setupBlockReason="Master Foreman could not return bootstrap buckets to its fuel chest"
            return false
        end
        if not goPrivateHome() or not faceTracked(DIR_N) then return false end
        state.setupBlockReason=nil
        saveState()
        return true
    end

    local function masterFuelAndLoadCoal()
        if not atFuel() then
            state.setupBlockReason="Master Foreman fuel chest is unavailable"
            return false
        end
        if turtle.getFuelLevel()~="unlimited" and
            turtle.getFuelLevel()<=FOREMAN_FUEL_LOW and
            not refuelAtFrontTo(FOREMAN_FUEL_TARGET,true) then
            state.setupBlockReason="Fuel chest needs fuel for Master Foreman"
            return false
        end
        local kind,units=loadFuelPacket(800,4)
        if not kind then
            state.setupBlockReason="Fuel chest needs four Navigator fuel packets"
            return false
        end
        if not returnBucketsAtFuel() then
            state.setupBlockReason="Master Foreman could not return empty buckets after releasing Navigator fuel"
            return false
        end
        state.navigatorFuelKind=kind
        state.navigatorFuelUnits=units
        if not goPrivateHome() or not faceTracked(DIR_N) then return false end
        return true
    end

    local function masterLoadSupplies()
        if not goTo(0,-1) then
            state.setupBlockReason="Cannot reach the Black Blue Blue supply chest"
            return false
        end

        faceTracked(DIR_N)

        if not wrapInventory("front") then
            state.setupBlockReason="Black Blue Blue supply chest is not readable directly north of Master Foreman"
            return false
        end

        local needDrives = 1 - selfCount("disk_drive")
        if needDrives > 0 and takeNamedIntoSelf("disk_drive",needDrives) < needDrives then
            state.setupBlockReason="Cannot pull a Disk Drive from the Black Blue Blue supply chest"
            return false
        end

        local needNavigators = 4 - selfCount("advanced_wireless_mining_turtle")
        if needNavigators > 0 and takeNamedIntoSelf("advanced_wireless_mining_turtle",needNavigators) < needNavigators then
            state.setupBlockReason="Cannot pull four Advanced Wireless Mining Turtles from the Black Blue Blue supply chest"
            return false
        end

        local needFloppies = 1 - selfCount("worker_floppy")
        if needFloppies > 0 then
            local moved=takeNamedIntoSelf("worker_floppy",needFloppies)
            if moved<needFloppies and selfCount("floppy")<1 then
                moved=moved+takeNamedIntoSelf("floppy",needFloppies-moved)
            end
            if selfCount("floppy")<1 then
                state.setupBlockReason="Cannot pull a quarry worker floppy from the Black Blue Blue supply chest"
                return false
            end
        end

        local needLoaders = 2 - selfCount("chunk_loader")
        if needLoaders > 0 and takeNamedIntoSelf("chunk_loader",needLoaders) < needLoaders then
            state.setupBlockReason="Cannot pull two Chunk Loaders (item 781) from the Black Blue Blue supply chest"
            return false
        end

        return true
    end

    local function masterLoadForemanPackage(n)
        if not goTo(0,-1) or not faceTracked(DIR_N) then return false end
        local needs={
            {"advanced_wireless_narcissistic_turtle",1},
            {"disk_drive",1},
            {"floppy",1},
            {"advanced_wireless_mining_turtle",4},
            {"ender_dump",1},
            {"ender_fuel",1}
        }
        if n==1 then
            needs[1]={"advanced_wireless_mining_turtle",0}
            needs[2]={"disk_drive",0}
            needs[3]={"floppy",0}
            needs[5]={"ender_dump",0}
            needs[6]={"ender_fuel",0}
        end
        for _,entry in ipairs(needs) do
            local remaining=entry[2]-selfCount(entry[1])
            if remaining>0 and takeNamedIntoSelf(entry[1],remaining)<remaining then
                state.setupBlockReason="Missing " .. entry[1] .. " for Foreman-" .. tostring(n)
                state.phase="WAITING_SUPPLIES"
                saveState()
                sendState(state.setupBlockReason)
                return false
            end
        end
        if n~=1 then
            state.foremanFuelPackages=state.foremanFuelPackages or {}
            if not state.foremanFuelPackages[n] then
                if not atFuel() then
                    state.setupBlockReason="Fuel chest is unavailable for Foreman-" .. tostring(n)
                    state.phase="WAITING_SUPPLIES"
                    saveState()
                    sendState(state.setupBlockReason)
                    return false
                end
                local kind,units=loadFuelPacket(800)
                if not kind then
                    state.setupBlockReason="Fuel chest needs fuel for Foreman-" .. tostring(n)
                    state.phase="WAITING_SUPPLIES"
                    saveState()
                    sendState(state.setupBlockReason)
                    return false
                end
                if not returnBucketsAtFuel() then
                    state.setupBlockReason="Fuel chest cannot accept empty buckets after releasing Foreman-" .. tostring(n) .. " fuel"
                    state.phase="WAITING_SUPPLIES"
                    saveState()
                    sendState(state.setupBlockReason)
                    return false
                end
                state.foremanFuelPackages[n]={kind=kind,units=units}
                saveState()
            end
        end
        state.setupBlockReason=nil
        return true
    end

    local function mountedWorkerInstaller()
        if not disk.isPresent("front") then return false end
        if not fs.exists("disk") or not fs.isDir("disk") then return false end
        if fs.exists("disk/update") then return false end
        if not fs.exists("disk/startup") then return false end
        local f=fs.open("disk/startup","r")
        if not f then return false end
        local data=f.readAll()
        f.close()
        local expected=tostring(data or ""):match("EXPECTED_VERSION%s*=%s*(%d+)")
        return tonumber(expected)==VERSION
    end

    local function workerFloppyCandidate(rejected)
        rejected=rejected or {}
        for pass=1,2 do
            for slot=1,16 do
                if not rejected[slot] and turtle.getItemCount(slot)>0 then
                    local item=selfItem(slot)
                    if item and matchesItem(item,"floppy") then
                        local text=itemText(item)
                        local isWorker=matchesItem(item,"worker_floppy") or
                            string.find(text,"quarry worker",1,true)~=nil
                        local isSetup=matchesItem(item,"setup_floppy") or
                            string.find(text,"setup",1,true)~=nil
                        if (pass==1 and isWorker) or (pass==2 and not isSetup) then
                            return slot
                        end
                    end
                end
            end
        end
        return nil
    end

    local function ensureWorkerInstallerDisk()
        local rejected={}
        if disk.isPresent("front") then
            if mountedWorkerInstaller() then return true end
            local target=nil
            for slot=1,16 do
                if turtle.getItemCount(slot)==0 then target=slot break end
            end
            if not target then
                state.setupBlockReason="Foreman-1 has no free slot to recover a non-worker bootstrap disk"
                saveState()
                sendState(state.setupBlockReason)
                return false
            end
            turtle.select(target)
            if not turtle.suck(1) then
                state.setupBlockReason="Foreman-1 could not recover a non-worker bootstrap disk"
                saveState()
                sendState(state.setupBlockReason)
                return false
            end
            rejected[target]=true
        end

        while true do
            local slot=workerFloppyCandidate(rejected)
            if not slot then
                state.setupBlockReason="Foreman-1 needs a quarry worker disk, not the setup disk"
                saveState()
                sendState(state.setupBlockReason)
                return false
            end
            turtle.select(slot)
            if not turtle.drop(1) then
                state.setupBlockReason="Foreman-1 could not insert a quarry worker disk"
                saveState()
                sendState(state.setupBlockReason)
                return false
            end
            waitFrontDisk(1)
            if mountedWorkerInstaller() then
                return true
            end
            turtle.select(slot)
            if not turtle.suck(1) then
                state.setupBlockReason="Foreman-1 inserted a non-worker disk and could not recover it"
                saveState()
                sendState(state.setupBlockReason)
                return false
            end
            rejected[slot]=true
        end
    end

    local function masterPlaceBootstrapInstaller()
        if selfCount("disk_drive")<1 or selfCount("floppy")<1 then
            return false
        end

        if not goTo(1,-1) then
            return false
        end

        if not ensureGroundLevel() then
            return false
        end

        faceTracked(DIR_N)
        saveState()

        if peripheral.getType("front")=="drive" then
            local slot=selfTargetSlot("disk_drive")
            if not slot then
                return false
            end
            turtle.select(slot)
            if not turtle.dig() then
                state.phase="PLACEMENT_ERROR"
                saveState()
                sendState("Cannot remove misplaced ground bootstrap Disk Drive")
                return false
            end
        elseif frontComputerId() then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Bootstrap pad occupied by a turtle")
            return false
        elseif turtle.detect() then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Bootstrap pad blocked at ground level")
            return false
        end

        if not ensureInstallerLevel() then
            return false
        end

        faceTracked(DIR_N)

        if peripheral.getType("front")~="drive" then
            local clearOk,clearReason=clearFrontPlacementCell("Bootstrap installer square at relative Y 1")
            if not clearOk then
                state.phase="PLACEMENT_ERROR"
                saveState()
                sendState(clearReason)
                ensureGroundLevel()
                return false
            end

            if not selfSelectKind("disk_drive") then
                ensureGroundLevel()
                return false
            end

            if not turtle.place() then
                ensureGroundLevel()
                return false
            end
            waitFrontDrive(1)
        end

        if peripheral.getType("front")~="drive" then
            state.phase="VERTICAL_ERROR"
            saveState()
            sendState("Bootstrap Disk Drive is not directly in front at installer height")
            ensureGroundLevel()
            return false
        end

        if not ensureWorkerInstallerDisk() then
            ensureGroundLevel()
            state.phase="WAITING_SUPPLIES"
            saveState()
            return false
        end

        if not ensureGroundLevel() then
            return false
        end

        faceTracked(DIR_N)

        if peripheral.getType("front")=="drive" then
            state.phase="VERTICAL_ERROR"
            saveState()
            sendState("Bootstrap Disk Drive detected at ground level")
            return false
        end

        saveState()
        return true
    end

    local function masterCommissionNavigator(n)
        local progress=state.navigatorProgress
        if progress and progress.number~=n then
            state.phase="RECOVERY_LOCK"
            state.recoveryLocked=true
            state.recoveryReason="Another navigator handoff is unfinished"
            saveState()
            return nil
        end
        local function waitDeployment(id)
            if not id then return nil end
            local lastProbe=0
            local deadline=now()+12
            while now()<deadline do
                if flags.recallMode then return nil end
                if now()-lastProbe>=1 then
                    send(id,{
                        type="deploy_navigator",
                        target=id,
                        number=n,
                        fuelKind=state.navigatorFuelKind,
                        session=cfg.session
                    })
                    lastProbe=now()
                end
                local _,reply=waitInbox(function(sender,m)
                    return sender==id and type(m)=="table" and
                        m.type=="navigator_deployed" and tonumber(m.number)==n and
                        (not m.session or m.session==cfg.session)
                end,0.5)
                if reply then
                    local site=NAVIGATOR_SITES[n]
                    local valid=site and tonumber(reply.x)==site.x and tonumber(reply.y)==site.y and
                        tonumber(reply.z)==site.z and tonumber(reply.chunkIndex or 0)==tonumber(state.chunkIndex or 0)
                    if n==1 or n==3 then
                        valid=valid and reply.loaderPlaced==true and reply.loaderSite=="WORK"
                    end
                    if not valid then
                        state.phase="WAITING_NAVIGATOR_RECOVERY"
                        saveState()
                        sendState("Navigator-"..tostring(n).." deployment confirmation is invalid")
                        return nil
                    end
                    progress.stage="DEPLOYED"
                    saveState()
                    return id
                end
            end
            state.phase="WAITING_NAVIGATOR_RECOVERY"
            state.setupBlockReason="Navigator-"..tostring(n).." did not confirm stable deployment"
            saveState()
            sendState(state.setupBlockReason)
            return nil
        end
        if progress and progress.stage=="TRAVELING" then
            return waitDeployment(progress.id)
        end
        if not progress then
            if selfCount("advanced_wireless_mining_turtle")<1 or
                selfCount(state.navigatorFuelKind or "lava_bucket")<(state.navigatorFuelUnits or 1) then
                return nil
            end
        end

        if not goTo(1,-1) then
            return nil
        end

        if not ensureGroundLevel() then
            return nil
        end

        faceTracked(DIR_N)
        saveState()

        if state.dir~=DIR_N then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Master Foreman is not north-facing before Navigator placement")
            return nil
        end

        if not progress then
            if frontComputerId() then
                state.phase="PLACEMENT_ERROR"
                saveState()
                sendState("Navigator bootstrap position occupied")
                return nil
            end
            progress={number=n,stage="PLACEMENT_PENDING"}
            state.navigatorProgress=progress
            saveState()
        end

        local newId=frontComputerId()
        if progress.id and newId~=progress.id then
            state.phase="WAITING_NAVIGATOR_RECOVERY"
            saveState()
            sendState("Navigator-"..tostring(n).." left the bootstrap pad before travel was recorded")
            return nil
        end
        if not newId then
            local clearOk,clearReason=clearFrontPlacementCell("Navigator-"..tostring(n).." bootstrap target")
            if progress.stage~="PLACEMENT_PENDING" or not clearOk or
                not selfSelectKind("advanced_wireless_mining_turtle") or not turtle.place() then
                state.phase="WAITING_NAVIGATOR_RECOVERY"
                saveState()
                sendState(clearReason or ("Navigator-"..tostring(n).." placement must be inspected"))
                return nil
            end
            newId=waitFrontComputerId(1)
        end
        if not newId then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Cannot identify Navigator-" .. tostring(n))
            return nil
        end

        progress.id=newId
        if progress.stage=="PLACEMENT_PENDING" then progress.stage="PLACED" end
        saveState()
        pcall(peripheral.call,"front","turnOn")

        local packet={
            type="configure",
            target=newId,
            role="navigator",
            worldOrigin=cfg.worldOrigin,
            number=n,
            managerId=cfg.managerId,
            masterForemanId=cfg.masterForemanId,
            loaderExpected=n==1 or n==3,
            session=cfg.session
        }

        local installed=progress.stage=="INSTALLED" or progress.stage=="FUEL_PENDING" or
            progress.stage=="FUEL_GIVEN"
        local lastConfigure=0

        while not installed do
            if flags.recallMode then return nil end

            if now()-lastConfigure>=1 then
                send(newId,packet)
                pcall(peripheral.call,"front","turnOn")
                lastConfigure=now()
            end

            local _,reply=waitInbox(function(sender,m)
                return sender==newId and type(m)=="table" and
                    m.type=="install_ok" and m.role=="navigator" and tonumber(m.number)==n
            end,0.5)

            if reply then
                installed=reply
                progress.stage="INSTALLED"
                saveState()
            end
        end

        if progress.stage=="FUEL_PENDING" then
            state.phase="WAITING_NAVIGATOR_RECOVERY"
            saveState()
            sendState("Navigator-"..tostring(n).." fuel handoff interrupted; inspect both inventories")
            return nil
        end
        if progress.stage~="FUEL_GIVEN" then
            progress.stage="FUEL_PENDING"
            saveState()
            if not selfDropKind(state.navigatorFuelKind,state.navigatorFuelUnits) then
                state.phase="WAITING_FUEL"
                saveState()
                sendState("Navigator-" .. tostring(n) .. " fuel handoff incomplete; inspect inventories")
                return nil
            end
            progress.bucketsBefore=selfCount("empty_bucket")
            progress.stage="FUEL_GIVEN"
            saveState()
        end

        local bucketsBefore=progress.bucketsBefore or selfCount("empty_bucket")
        local expectedBucket=state.navigatorFuelKind=="lava_bucket" and 1 or 0
        while expectedBucket>0 and not selfTargetSlot("empty_bucket") do
            state.phase="WAITING_BUCKET_RETURN"
            saveState()
            sendState("Foreman-1 has no inventory space for Navigator-" .. tostring(n) .. " empty bucket")
            if flags.recallMode then return nil end
            sleep(2)
        end

        local traveling=nil
        local lastDeploy=0

        while not traveling do
            if flags.recallMode then return nil end

            if now()-lastDeploy>=1 then
                send(newId,{
                    type="deploy_navigator",
                    target=newId,
                    number=n,
                    fuelKind=state.navigatorFuelKind,
                    session=cfg.session
                })
                lastDeploy=now()
            end

            local _,reply=waitInbox(function(sender,m)
                return sender==newId and type(m)=="table" and
                    (m.type=="navigator_fuel_ready" or
                     m.type=="navigator_loader_ready" or
                     m.type=="navigator_loader_received" or
                     m.type=="navigator_traveling") and tonumber(m.number)==n
            end,0.5)

            if reply and reply.type=="navigator_fuel_ready" then
                if expectedBucket==0 or selfCount("empty_bucket")>=bucketsBefore+expectedBucket then
                    send(newId,{type="navigator_fuel_receipt",number=n})
                else
                    state.phase="WAITING_BUCKET_RETURN"
                    saveState()
                    sendState("Navigator-" .. tostring(n) .. " must return its empty bucket")
                end
            elseif reply and reply.type=="navigator_loader_ready" and (n==1 or n==3) then
                if progress.loaderTransferPending and frontComputerId()==newId then
                    progress.loaderTransferPending=nil
                    saveState()
                end
                if not progress.loaderGiven and not progress.loaderTransferPending then
                    if selfCount("chunk_loader")<1 then
                        state.phase="WAITING_SUPPLIES"
                        state.setupBlockReason="Chunk Loader item 781 missing for Navigator-"..tostring(n)
                        saveState()
                        sendState(state.setupBlockReason)
                        return nil
                    end
                    progress.loaderTransferPending=true
                    saveState()
                    if not selfDropKind("chunk_loader",1) then
                        progress.loaderTransferPending=nil
                        state.phase="WAITING_SUPPLIES"
                        state.setupBlockReason="Chunk Loader handoff failed for Navigator-"..tostring(n)
                        saveState()
                        sendState(state.setupBlockReason)
                        return nil
                    end
                    progress.loaderGiven=true
                    progress.loaderTransferPending=nil
                    saveState()
                end
            elseif reply and reply.type=="navigator_loader_received" and (n==1 or n==3) then
                progress.loaderGiven=true
                progress.loaderTransferPending=nil
                progress.loaderConfirmed=true
                saveState()
            elseif reply and reply.type=="navigator_traveling" then
                if n==1 or n==3 then
                    progress.loaderGiven=true
                    progress.loaderTransferPending=nil
                    progress.loaderConfirmed=true
                    saveState()
                end
                traveling=reply
            end
        end

        progress.stage="TRAVELING"
        saveState()
        sendState("Navigator-" .. tostring(n) .. " traveling")
        return waitDeployment(newId)
    end

    local function masterCommissionForeman(n)
        local progress=state.foremanProgress
        if progress and progress.number~=n then
            state.phase="RECOVERY_LOCK"
            state.recoveryLocked=true
            state.recoveryReason="Another foreman handoff is unfinished"
            saveState()
            return nil
        end
        if not progress then
            if selfCount("advanced_wireless_narcissistic_turtle")<1
                or selfCount("disk_drive")<1
                or selfCount("floppy")<1
                or selfCount("advanced_wireless_mining_turtle")<4
                or selfCount("ender_dump")<1
                or selfCount("ender_fuel")<1
                or not state.foremanFuelPackages or not state.foremanFuelPackages[n] or
                selfCount(state.foremanFuelPackages[n].kind)<state.foremanFuelPackages[n].units then
                return nil
            end
        end

        local function probeDeployed(workerId)
            local probeId=tostring(n)..":"..tostring(now())..":"..tostring(math.random(1,999999))
            for attempt=1,3 do
                send(workerId,{type="foreman_setup_probe",number=n,probeId=probeId,
                    session=cfg.session})
                local _,reply=waitInbox(function(sender,m)
                    return sender==workerId and type(m)=="table" and
                        m.type=="foreman_setup_status" and m.probeId==probeId and
                        tonumber(m.number)==n and m.session==cfg.session
                end,1)
                if reply then return reply.deployed==true end
            end
            return false
        end

        if progress and progress.stage=="DEPLOY_SENT" and progress.id and
            probeDeployed(progress.id) then
            return progress.id
        end

        if not goTo(1,-1) or not ensureGroundLevel() then
            return nil
        end
        faceTracked(DIR_N)
        saveState()
        if state.dir~=DIR_N then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Master Foreman is not north-facing before subordinate placement")
            return nil
        end

        if not progress then
            if frontComputerId() then
                state.phase="PLACEMENT_ERROR"
                saveState()
                sendState("Foreman bootstrap position occupied")
                return nil
            end
            progress={number=n,stage="PLACEMENT_PENDING",nextItem=1}
            state.foremanProgress=progress
            saveState()
        end

        local newId=frontComputerId()
        if progress.id and newId~=progress.id then
            state.phase="WAITING_FOREMAN_RECOVERY"
            saveState()
            sendState("Foreman-"..tostring(n).." left bootstrap pad before deployment receipt")
            return nil
        end
        if not progress.expectedGps then
            progress.expectedGps=expectedNorthPlacement()
            if not progress.expectedGps then return nil end
            saveState()
        end
        if not newId then
            local clearOk,clearReason=clearFrontPlacementCell("Foreman-"..tostring(n).." bootstrap target")
            if progress.stage~="PLACEMENT_PENDING" or not clearOk or
                not selfSelectKind("advanced_wireless_narcissistic_turtle") or not turtle.place() then
                state.phase="WAITING_FOREMAN_RECOVERY"
                saveState()
                sendState(clearReason or ("Foreman-"..tostring(n).." placement must be inspected"))
                return nil
            end
            newId=waitFrontComputerId(1)
        end
        if not newId then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Cannot identify Foreman-"..tostring(n))
            return nil
        end
        progress.id=newId
        if progress.stage=="PLACEMENT_PENDING" then progress.stage="PLACED" end
        saveState()
        pcall(peripheral.call,"front","turnOn")

        local packet={
            type="configure",
            target=newId,
            role="foreman",
            expectedGps=progress.expectedGps,
            worldOrigin=cfg.worldOrigin,
            number=n,
            rowStart=(n-1)*4+1,
            rowEnd=n*4,
            managerId=cfg.managerId,
            masterForemanId=cfg.masterForemanId,
            session=cfg.session
        }
        local installed=progress.stage=="INSTALLED" or
            progress.stage=="PACKAGING" or progress.stage=="DEPLOY_SENT"
        local lastConfigure=0
        local installDeadline=now()+20
        while not installed do
            if flags.recallMode then return nil end
            if now()-lastConfigure>=1 then
                send(newId,packet)
                pcall(peripheral.call,"front","turnOn")
                lastConfigure=now()
            end
            local _,reply=waitInbox(function(sender,m)
                return sender==newId and type(m)=="table" and
                    m.type=="install_ok" and tonumber(m.number)==n
            end,0.5)
            if reply then
                installed=true
                progress.stage="INSTALLED"
                saveState()
            elseif now()>=installDeadline then
                state.phase="WAITING_FOREMAN_INSTALL"
                state.setupBlockReason="Foreman-"..tostring(n).." installer did not acknowledge; check its screen and Disk Drive"
                saveState()
                sendState(state.setupBlockReason)
                return nil
            end
        end

        local fuel=state.foremanFuelPackages and state.foremanFuelPackages[n]
        if not fuel then
            state.phase="WAITING_FOREMAN_RECOVERY"
            saveState()
            sendState("Foreman-"..tostring(n).." fuel package record missing")
            return nil
        end
        local items={
            {kind=fuel.kind,count=fuel.units},
            {kind="disk_drive",count=1},
            {kind="floppy",count=1},
            {kind="advanced_wireless_mining_turtle",count=4},
            {kind="ender_dump",count=1},
            {kind="ender_fuel",count=1}
        }
        if progress.stage~="DEPLOY_SENT" and state.foremanMinerFuelPackages and
            state.foremanMinerFuelPackages[n] then
            local minerFuel=state.foremanMinerFuelPackages[n]
            items[#items+1]={kind=minerFuel.kind,count=minerFuel.units}
        elseif progress.stage~="DEPLOY_SENT" and
            (progress.nextItem or 1)>6 then
            state.phase="WAITING_FOREMAN_RECOVERY"
            state.setupBlockReason="Foreman-"..tostring(n).." saved fuel transfer record missing"
            saveState()
            sendState(state.setupBlockReason)
            return nil
        end
        local function probeInventory(kind,index)
            local probeId=tostring(n)..":"..tostring(index)..":"..
                tostring(now())..":"..tostring(math.random(1,999999))
            for attempt=1,3 do
                send(newId,{type="package_probe",target=newId,number=n,
                    transferId=probeId,kind=kind})
                local _,reply=waitInbox(function(sender,m)
                    return sender==newId and type(m)=="table" and
                        m.type=="package_inventory" and m.transferId==probeId and
                        m.kind==kind and tonumber(m.number)==n
                end,1)
                if reply then return tonumber(reply.count) end
            end
            return nil
        end

        if progress.stage~="DEPLOY_SENT" then
            progress.stage="PACKAGING"
            saveState()
            for i=progress.nextItem or 1,#items do
                if flags.recallMode then return nil end
                local item=items[i]
                if progress.transfer and progress.transfer.index~=i then
                    state.phase="WAITING_FOREMAN_RECOVERY"
                    saveState()
                    sendState("Foreman package journal has conflicting item index")
                    return nil
                end
                local received=probeInventory(item.kind,i)
                if not received then
                    state.phase="WAITING_FOREMAN_PACKAGE"
                    saveState()
                    sendState("Cannot inspect Foreman-"..tostring(n).." inventory")
                    return nil
                end
                if not progress.transfer then
                    progress.transfer={index=i,baseline=received}
                    saveState()
                end
                local expected=progress.transfer.baseline+item.count
                if received<progress.transfer.baseline or received>expected then
                    state.phase="WAITING_FOREMAN_RECOVERY"
                    saveState()
                    sendState("Foreman-"..tostring(n).." "..item.kind.." count disagrees with journal")
                    return nil
                end
                local remaining=expected-received
                if remaining>0 then
                    if selfCount(item.kind)<remaining then
                        local missing=remaining-selfCount(item.kind)
                        if not goTo(0,-1) or not faceTracked(DIR_N) or
                            takeNamedIntoSelf(item.kind,missing)<missing or
                            not goTo(1,-1) or not faceTracked(DIR_N) or
                            frontComputerId()~=newId then
                            state.phase="WAITING_FOREMAN_PACKAGE"
                            saveState()
                            sendState("Foreman-"..tostring(n).." needs "..remaining.." "..item.kind)
                            return nil
                        end
                    end
                    if not selfDropKind(item.kind,remaining) then
                        state.phase="WAITING_FOREMAN_PACKAGE"
                        saveState()
                        sendState("Foreman-"..tostring(n).." needs "..remaining.." "..item.kind)
                        return nil
                    end
                    received=probeInventory(item.kind,i)
                end
                if received~=expected then
                    state.phase="WAITING_FOREMAN_PACKAGE"
                    saveState()
                    sendState("Foreman-"..tostring(n).." "..item.kind.." receipt pending")
                    return nil
                end
                progress.nextItem=i+1
                progress.transfer=nil
                saveState()
            end
            progress.stage="DEPLOY_SENT"
            saveState()
        end

        local deployed=nil
        local lastDeploy=0
        local deployDeadline=now()+30
        while not deployed do
            if flags.recallMode then return nil end
            if now()-lastDeploy>=1 then
                send(newId,{type="deploy_foreman",target=newId})
                lastDeploy=now()
            end
            local _,reply=waitInbox(function(sender,m)
                return sender==newId and type(m)=="table" and
                    m.type=="foreman_deployed" and tonumber(m.number)==n
            end,0.5)
            if reply then
                deployed=reply
            elseif frontComputerId()~=newId and probeDeployed(newId) then
                deployed=true
            elseif now()>=deployDeadline then
                state.phase="WAITING_FOREMAN_DEPLOY"
                state.setupBlockReason="Foreman-"..tostring(n).." did not leave the dock; inspect its screen and path"
                saveState()
                sendState(state.setupBlockReason)
                return nil
            end
        end
        return newId
    end

    local function masterSetup()
        state.phase="MASTER_SETUP"
        state.foremenReady = state.foremenReady or {[1]=true}
        cfg.foremen = cfg.foremen or {[1]=id}
        saveState()
        saveTable("node.cfg",cfg)
        sendState("Setting up Navigators and foremen")

        if not ensureMasterSeedFuel() then
            return false
        end

        if not masterInitialChests() then
            state.phase="WAITING_SUPPLIES"
            saveState()
            sendState(state.setupBlockReason or "Need Master Foreman dump and fuel Ender Chests")
            return false
        end

        if not state.initialFuelLoaded then
            if not masterFuelAndLoadCoal() then
                state.phase="WAITING_SUPPLIES"
                saveState()
                sendState(state.setupBlockReason or "Need Navigator startup coal and Master Foreman fuel")
                return false
            end
            state.initialFuelLoaded=true
            state.setupBlockReason=nil
            saveState()
        end

        if not state.initialSuppliesLoaded then
            if not masterLoadSupplies() then
                state.phase="WAITING_SUPPLIES"
                saveState()
                sendState(state.setupBlockReason or "Need bootstrap drive, floppy, four Advanced Wireless Mining Turtles, and two Chunk Loaders")
                return false
            end
            state.initialSuppliesLoaded=true
            state.setupBlockReason=nil
            saveState()
        end

        if not state.bootstrapReady then
            if not masterPlaceBootstrapInstaller() then
                state.phase="WAITING_SUPPLIES"
                saveState()
                sendState("Cannot establish bootstrap station")
                return false
            end
            state.bootstrapReady=true
            saveState()
        end

        state.navigatorLaunchReady=state.navigatorLaunchReady or {}
        cfg.navigators=cfg.navigators or {}

        local navigatorOrder={1,2,3,4}

        for _,n in ipairs(navigatorOrder) do
            if not state.navigatorLaunchReady[n] then
                state.phase="DEPLOYING_NAVIGATOR"
                saveState()
                sendState("Placing Navigator-" .. tostring(n))

                local nid=masterCommissionNavigator(n)
                if not nid then
                    state.phase="WAITING_NAVIGATOR_SETUP"
                    saveState()
                    sendState("Navigator-" .. tostring(n) .. " setup paused")
                    return false
                end

                state.navigatorLaunchReady[n]=true
                cfg.navigators[n]=nid
                saveTable("node.cfg",cfg)
                saveState()
                state.navigatorProgress=nil
                saveState()
            end
        end

        for _,n in ipairs(navigatorOrder) do
            local id=cfg.navigators[n]
            local confirmed=nil
            local lastProbe=0
            local deadline=now()+6
            while id and not confirmed and now()<deadline do
                if flags.recallMode then return false end
                if now()-lastProbe>=1 then
                    send(id,{
                        type="deploy_navigator",
                        target=id,
                        number=n,
                        fuelKind=state.navigatorFuelKind,
                        session=cfg.session
                    })
                    lastProbe=now()
                end
                local _,reply=waitInbox(function(sender,m)
                    return sender==id and type(m)=="table" and
                        m.type=="navigator_deployed" and tonumber(m.number)==n and
                        (not m.session or m.session==cfg.session)
                end,0.5)
                if reply then confirmed=reply end
            end
            if not confirmed then
                state.phase="WAITING_NAVIGATOR_SETUP"
                state.setupBlockReason="Navigator-"..tostring(n).." stopped responding after deployment"
                saveState()
                sendState(state.setupBlockReason)
                return false
            end
        end

        state.navigatorSetupDone=true
        saveState()

        for _,n in ipairs({4,3,2}) do
            if not state.foremenReady[n] then
                if not (state.foremanProgress and state.foremanProgress.number==n) and
                    not masterLoadForemanPackage(n) then return false end
                local fid=masterCommissionForeman(n)
                if not fid then
                    if state.phase=="WAITING_FOREMAN_PACKAGE" or
                        state.phase=="WAITING_FOREMAN_RECOVERY" then
                        state.setupBlockReason="Foreman-"..tostring(n).." "..
                            state.phase.." item "..
                            tostring(state.foremanProgress and state.foremanProgress.nextItem or "?")
                    elseif state.phase~="WAITING_SUPPLIES" and
                        state.phase~="WAITING_FOREMAN_INSTALL" and
                        state.phase~="WAITING_FOREMAN_DEPLOY" then
                        state.phase="WAITING_SETUP"
                        state.setupBlockReason="Foreman-"..tostring(n).." setup paused"
                    end
                    saveState()
                    sendState(state.setupBlockReason)
                    return false
                end
                state.foremenReady[n]=true
                cfg.foremen[n]=fid
                saveTable("node.cfg",cfg)
                saveState()
                state.foremanProgress=nil
                state.setupBlockReason=nil
                saveState()
            end
        end

        if not state.ownInstallerLoaded and not masterLoadForemanPackage(1) then
            return false
        end

        if not state.ownInstallerLoaded then
            if state.firstInstallerRecovered and selfCount("disk_drive") < 1 then
                state.phase="WAITING_SUPPLIES"
                saveState()
                sendState("Foreman-1 Disk Drive missing")
                return false
            end
            if selfCount("advanced_wireless_mining_turtle") < 4 then
                state.phase="WAITING_SUPPLIES"
                saveState()
                sendState("Foreman-1 miners missing")
                return false
            end
            if selfCount("floppy") < 1 and state.firstInstallerRecovered then
                state.phase="WAITING_SUPPLIES"
                saveState()
                sendState("Foreman-1 floppy missing")
                return false
            end
            state.ownInstallerLoaded=true
            saveState()
        end

        state.phase="CLEARING_SETUP_AREA"
        saveState()
        sendState("Clearing shared setup area")

        if not returnHome() then
            state.phase="WAITING_SETUP"
            saveState()
            sendState("Cannot clear shared setup area")
            return false
        end

        state.phase="WAITING_SETUP"
        state.setupBlockReason=nil
        saveState()
        sendState("Four foremen online")
        return true
    end


    local function applyManagerForemanPose()
        local snapshot,seq=requestPoseBackup("foreman",5,cfg.session)
        if state.recoveryLocked or not foremanPoseValid() then return false end
        if snapshot and type(snapshot.x)=="number" and type(snapshot.y)=="number" and
            type(snapshot.z)=="number" and type(snapshot.dir)=="number" then
            local incoming=tonumber(seq or snapshot.seq or 0) or 0
            if incoming>state.seq or
                (incoming==state.seq and
                    (state.x~=snapshot.x or state.y~=snapshot.y or
                     state.z~=snapshot.z or state.dir~=snapshot.dir)) then
                state.recoveryLocked=true
                state.recoveryReason="Cannot verify foreman position against Regional Manager for recall"
                state.phase="RECOVERY_LOCK"
                saveState()
                return false
            end
            if state.seq>incoming then checkpointForeman() end
        end
        return true
    end

    local function recallForeman(mode)
        mode=mode or "NORMAL"
        flags.packService=false
        if not applyManagerForemanPose() then
            sendState("Recall refused: " .. tostring(state.recoveryReason or "pose uncertain"))
            return false
        end

        active=nil
        queue={}
        saveQueue()

        state.phase="RECALLING"
        saveState()

        recallTravel=true
        local reachedHome=returnHome()
        recallTravel=false

        if not reachedHome then
            state.phase="RECOVERY_LOCK"
            state.recoveryLocked=true
            state.recoveryReason="Foreman recall could not reach home"
            saveState()
            return false
        end

        if not faceTracked(DIR_N) then
            return false
        end

        if state.x~=cfg.homeX or state.y~=0 or state.z~=cfg.homeZ or state.dir~=DIR_N then
            state.phase="RECOVERY_LOCK"
            state.recoveryLocked=true
            state.recoveryReason="Foreman recall home verification failed"
            saveState()
            return false
        end

        if state.advanceStage=="STAGED" then
            state.advanceStage=nil
            saveState()
        end

        local dumpHeld=selfCount("ender_dump")>0
        local fuelHeld=selfCount("ender_fuel")>0
        if dumpHeld or fuelHeld then
            state.chestsReady=false
            if dumpHeld then state.dumpChestPlaced=false end
            if fuelHeld then state.fuelChestPlaced=false end
            saveState()
            if not ensureEnderPair() then
                sendState("Chest recall blocked while restoring Ender Chests")
                return false
            end
        end

        state.phase="RECALLED_PAUSED"
        state.recallMode=mode
        if mode=="PACK" then
            state.packReady=nil
            state.packAcknowledged=nil
        end
        saveState()
        checkpointForeman()

        send(cfg.managerId,{
            type="recall_home",
            role="foreman",
            number=number,
            id=id,
            mode=mode,
            packToken=mode=="PACK" and state.packToken or nil,
            x=state.x,
            y=state.y,
            z=state.z,
            dir=state.dir,
            session=cfg.session
        })

        if mode=="SHUTDOWN" then
            for i=1,5 do
                os.setComputerLabel(nil)

                if os.getComputerLabel()==nil then
                    break
                end

                sleep(0.1)
            end

            if os.getComputerLabel()~=nil then
                state.phase="RECOVERY_LOCK"
                state.recoveryLocked=true
                state.recoveryReason="Reached home but could not clear computer label"
                saveState()
                sendState(state.recoveryReason)
                return false
            end

            for shutdownAttempt=1,8 do
                send(cfg.managerId,{
                    type="recall_shutdown_ready",
                    role="foreman",
                    number=number,
                    id=id,
                    x=state.x,
                    y=state.y,
                    z=state.z,
                    dir=state.dir,
                    session=cfg.session
                })
                sleep(0.1)
            end
            os.shutdown()
        end

        return true
    end

    local function pauseForSetupRecall()
        if not flags.recallMode then
            return false
        end

        local mode=flags.recallMode
        flags.recallMode=nil

        if not recallForeman(mode) then
            return false
        end

        if mode=="SHUTDOWN" then
            return true
        end

        while state.phase=="RECALLED_PAUSED" do
            if flags.recallMode then
                local nextMode=flags.recallMode
                flags.recallMode=nil

                if not recallForeman(nextMode) then
                    return false
                end

                if nextMode=="SHUTDOWN" then
                    return true
                end
            elseif flags.resume then
                flags.resume=false
                state.recallMode=nil
                state.phase=state.setupDone and "IDLE" or "WAITING_SETUP"
                saveState()
                sendState("Regional Manager resumed setup")
                break
            else
                sleep(0.2)
            end
        end

        return true
    end

    local function serviceRequest(req)
        if state.fuelTransferPendingId then
            state.phase="SERVICE_TRANSFER_ERROR"
            saveState()
            sendState("Miner fuel handoff needs inventory inspection: " ..
                tostring(state.fuelTransferPendingId))
            return false
        end
        active = req
        saveQueue()
        state.phase="SERVICING"
        saveState()
        sendState("Servicing Miner-" .. tostring(req.row))

        while not active.arrived do
            if flags.recallMode then return false end
            sleep(0.1)
            if now() - (active.lastSeen or 0) > 30 then
                state.phase="WAITING_MINER"
                saveState()
            end
        end

        if not loadOwnFuel(not flags.packService) then
            return false
        end

        if not (state.fuelTransferId==req.requestId and
            (req.service=="REFUEL" or req.service=="BOTH")) and
            not prepareRuntimeService(req.service,req) then
            return false
        end

        local laneZ=privateLaneZ()

        if not enterPrivateLane() then
            return false
        end

        if state.x~=req.row then
            if not goTo(req.row,laneZ) then
                return false
            end
        end

        if state.z~=-1 then
            if not goTo(req.row,-1) then
                return false
            end
        end

        if state.x~=req.row or state.z~=-1 or state.y~=0 then
            state.phase="NAVIGATION_ERROR"
            saveState()
            sendState("Service route ended at wrong coordinate for Miner-" .. tostring(req.row))
            return false
        end

        if not verifyServiceMiner(req) then
            return false
        end

        saveState()

        if req.service == "REFUEL" or req.service == "BOTH" then
            if state.fuelTransferId~=req.requestId and countRuntimeFreeSlots()<1 then
                state.phase="SERVICE_TRANSFER_ERROR"
                saveState()
                sendState("Foreman needs a free slot for the miner's empty bucket")
                return false
            end
            local kind=state.runtimeFuelKind
            local moved=state.fuelTransferredUnits
            if state.fuelTransferId~=req.requestId then
                if state.fuelTransferPendingId==req.requestId then
                    state.phase="SERVICE_TRANSFER_ERROR"
                    saveState()
                    sendState("Miner-" .. tostring(req.row) .. " fuel handoff interrupted; inspect inventories")
                    return false
                end
                state.fuelTransferPendingId=req.requestId
                saveState()
                local transferred
                transferred,moved=dropMinerFuel(kind,state.runtimeFuelUnits)
                if not transferred then
                    state.phase="SERVICE_TRANSFER_ERROR"
                    saveState()
                    sendState("Miner-" .. tostring(req.row) .. " would not accept refuel fuel")
                    return false
                end
                state.fuelTransferId=req.requestId
                state.fuelTransferredUnits=moved
                state.fuelTransferPendingId=nil
                saveState()
            end

            send(req.minerId,{
                type="refuel_now",
                requestId=req.requestId,
                fuelKind=kind,
                fuelTransferred=moved
            })

            local _,reply = waitInbox(function(sender,m)
                return sender==req.minerId and type(m)=="table" and m.type=="refuel_complete" and m.requestId==req.requestId
            end,20)

            if not reply or reply.bucketReturned==false then
                state.phase="SERVICE_TIMEOUT"
                saveState()
                sendState("Miner-" .. tostring(req.row) .. " did not return fuel confirmation or bucket")
                return false
            end
            if reply.refueled==false or
                (reply.fuel~="unlimited" and
                 (tonumber(reply.fuel) or 0)<MINER_FUEL_TARGET) then
                req.fuel=reply.fuel
                state.fuelTransferId=nil
                state.fuelTransferredUnits=nil
                state.runtimeFuelKind=nil
                state.runtimeFuelUnits=nil
                state.phase="WAITING_FUEL"
                saveQueue()
                saveState()
                sendState("Miner-" .. tostring(req.row) .. " needs more fuel to reach target")
                return false
            end
            state.fuelTransferId=nil
            state.fuelTransferredUnits=nil
            state.runtimeFuelKind=nil
            state.runtimeFuelUnits=nil
            saveState()
        end

        if req.service == "DUMP" or req.service == "BOTH" then
            local emptyConfirmed=false

            while not emptyConfirmed do
                local pulled=turtle.suck()

                if pulled then
                    sleep(0.05)
                else
                    if countRuntimeFreeSlots()<=0 then
                        state.phase="SERVICE_UNLOAD_TRIP"
                        saveState()
                        sendState("Foreman full; unloading before continuing Miner-" .. tostring(req.row))
                        send(cfg.managerId,{
                            type="job_progress",
                            requestId=req.requestId,
                            foremanId=id,
                            row=req.row,
                            phase="UNLOAD_TRIP",
                            session=cfg.session
                        })

                        if not dumpCargo() then
                            state.blockedCargo=true
                            saveState()
                            send(cfg.managerId,{
                                type="job_blocked",
                                requestId=req.requestId,
                                foremanId=id,
                                row=req.row,
                                reason=state.phase=="DOCK_BLOCKED" and "STORAGE_FULL" or "UNLOAD_FAILED",
                                session=cfg.session
                            })
                            return false
                        end
                        state.blockedCargo=nil
                        saveState()

                        local laneZ=privateLaneZ()

                        if not enterPrivateLane() then
                            return false
                        end

                        if state.x~=req.row then
                            if not goTo(req.row,laneZ) then
                                return false
                            end
                        end

                        if state.z~=-1 then
                            if not goTo(req.row,-1) then
                                return false
                            end
                        end

                        if not verifyServiceMiner(req) then
                            return false
                        end
                    else
                        sleep(0.1)

                        if turtle.suck() then
                            sleep(0.05)
                        else
                            emptyConfirmed=true
                        end
                    end
                end
            end
        end

        if req.service == "DUMP" or req.service == "BOTH" then
            state.phase="RETURNING_AFTER_SERVICE"
            saveState()

            if not dumpCargo() then
                state.blockedCargo=true
                saveState()
                return false
            end
            state.blockedCargo=nil
            saveState()
        end

        resolved[req.requestId] = {
            stamp=now(),
            minerId=req.minerId,
            row=req.row,
            service=req.service,
            acknowledged=false
        }
        saveQueue()
        send(cfg.managerId,{
            type="job_complete",
            requestId=req.requestId,
            foremanId=id,
            foremanNumber=number,
            minerId=req.minerId,
            row=req.row,
            service=req.service,
            session=cfg.session
        })
        active=nil
        saveQueue()
        returnHome()
        sendState("Service complete")
        return true
    end

    local function installerDropKind(kind,amount)
        local remaining=tonumber(amount) or 0
        for slot=1,16 do
            if remaining<=0 then break end
            local item=selfItem(slot)
            if item and matchesItem(item,kind) then
                turtle.select(slot)
                local before=turtle.getItemCount(slot)
                local requested=math.min(remaining,before)
                if requested>0 then
                    if not turtle.drop(requested) then return false end
                    local moved=before-turtle.getItemCount(slot)
                    if moved<=0 then return false end
                    remaining=remaining-moved
                end
            end
        end
        return remaining<=0
    end

    local function installerFrontCount(kind)
        local items=scanInventory("front")
        if type(items)~="table" then return nil end
        local total=0
        for _,item in pairs(items) do
            if matchesItem(item,kind) then
                total=total+tonumber(item.qty or item.size or 1)
            end
        end
        return total
    end

    local function runInstallerChainCommand(command)
        if type(command)~="table" or state.recallMode or flags.recallMode then return false end
        local token=command.token
        if command.action=="receive" then
            local expected=tonumber(command.expected) or 0
            state.phase="INSTALLER_HANDOFF_RECEIVE"
            saveState()
            if not goTo(cfg.rowEnd,cfg.homeZ) or not faceTracked(DIR_E) then
                send(cfg.controller,{type="installer_handoff_blocked",number=number,
                    reason="receiver could not reach fourth-miner handoff position",token=token,
                    session=cfg.session})
                return false
            end
            send(cfg.controller,{type="installer_handoff_ready",number=number,
                expected=expected,token=token,session=cfg.session})
            local deadline=now()+20
            while now()<deadline and not flags.recallMode do
                if selfCount("disk_drive")>=expected and selfCount("floppy")>=expected then
                    if not returnHome() then return false end
                    send(cfg.controller,{type="installer_handoff_received",number=number,
                        driveCount=selfCount("disk_drive"),diskCount=selfCount("floppy"),
                        token=token,session=cfg.session})
                    return true
                end
                sleep(0.1)
            end
            state.phase="INSTALLER_HANDOFF_BLOCKED"
            saveState()
            send(cfg.controller,{type="installer_handoff_blocked",number=number,
                reason="receiver did not receive expected installer resources",token=token,
                session=cfg.session})
            return false
        elseif command.action=="donate" then
            local amount=tonumber(command.amount) or 0
            if amount<1 then return false end
            state.phase="INSTALLER_HANDOFF_DONATE"
            saveState()
            if not returnHome() or not faceTracked(DIR_W) then
                send(cfg.controller,{type="installer_handoff_blocked",number=number,
                    reason="donor could not reach idle handoff position",token=token,
                    session=cfg.session})
                return false
            end
            if selfCount("disk_drive")<amount or selfCount("floppy")<amount then
                send(cfg.controller,{type="installer_handoff_blocked",number=number,
                    reason="donor is missing installer resources",token=token,
                    session=cfg.session})
                return false
            end
            if not installerDropKind("disk_drive",amount) or not installerDropKind("floppy",amount) then
                state.phase="INSTALLER_HANDOFF_BLOCKED"
                saveState()
                send(cfg.controller,{type="installer_handoff_blocked",number=number,
                    reason="donor could not transfer installer resources",token=token,
                    session=cfg.session})
                return false
            end
            state.installerConsolidationDone=true
            saveState()
            if not returnHome() then return false end
            send(cfg.controller,{type="installer_handoff_donated",number=number,
                amount=amount,token=token,session=cfg.session})
            return true
        end
        return false
    end

    local function waitInstallerMessage(kind,numberExpected,token,timeout)
        local deadline=now()+(timeout or 20)
        while now()<deadline do
            local _,message=waitInbox(function(sender,m)
                return type(m)=="table" and m.type==kind and
                    tonumber(m.number)==tonumber(numberExpected) and
                    m.token==token and m.session==cfg.session
            end,0.5)
            if message then return message end
            if flags.recallMode then return nil end
        end
        return nil
    end

    local function masterInstallerConsolidation()
        if not cfg.master or state.installerConsolidationDone then return true end
        if not state.miningStarted or not state.setupDone then return false end
        if state.recallMode or flags.recallMode then return false end
        if state.installerSupplyRetryAt and now()<state.installerSupplyRetryAt then return false end

        state.installerConsolidationStep=tonumber(state.installerConsolidationStep) or 4
        if not state.installerConsolidationStartedAt then
            state.installerConsolidationStartedAt=now()
            saveState()
        end
        if now()-state.installerConsolidationStartedAt<1 then return false end

        for donor=state.installerConsolidationStep,3,-1 do
            local receiver=donor-1
            local donorId=cfg.foremen and cfg.foremen[donor]
            local receiverId=cfg.foremen and cfg.foremen[receiver]
            if not donorId or not receiverId then
                state.phase="INSTALLER_HANDOFF_BLOCKED"
                state.setupBlockReason="Installer handoff peer IDs are incomplete"
                saveState()
                sendState(state.setupBlockReason)
                return false
            end
            local amount=5-donor
            local expected=amount+1
            local token=tostring(id)..":"..tostring(donor)..":"..tostring(state.seq)..":"..tostring(math.floor(now()*20))
            send(receiverId,{type="installer_chain_prepare",number=receiver,
                expected=expected,token=token,session=cfg.session})
            if not waitInstallerMessage("installer_handoff_ready",receiver,token,12) then
                state.phase="INSTALLER_HANDOFF_BLOCKED"
                state.setupBlockReason="Foreman-"..tostring(receiver).." did not reach installer handoff position"
                saveState()
                sendState(state.setupBlockReason)
                return false
            end
            local alreadyReceived=waitInstallerMessage("installer_handoff_received",receiver,token,0.3)
            if not alreadyReceived then
                send(donorId,{type="installer_chain_donate",number=donor,
                    amount=amount,token=token,session=cfg.session})
                if not waitInstallerMessage("installer_handoff_received",receiver,token,12) then
                    state.phase="INSTALLER_HANDOFF_BLOCKED"
                    state.setupBlockReason="Foreman-"..tostring(receiver).." did not confirm installer resources from Foreman-"..tostring(donor)
                    saveState()
                    sendState(state.setupBlockReason)
                    return false
                end
            end
            state.installerConsolidationStep=donor-1
            saveState()
        end

        if state.installerConsolidationStep==2 then
            local donor=2
            local donorId=cfg.foremen and cfg.foremen[donor]
            if not donorId then return false end
            state.phase="INSTALLER_HANDOFF_RECEIVE"
            saveState()
            if not goTo(cfg.rowEnd,cfg.homeZ) or not faceTracked(DIR_E) then
                state.setupBlockReason="Foreman-1 could not reach its fourth-miner installer handoff position"
                saveState()
                sendState(state.setupBlockReason)
                return false
            end
            local token=tostring(id)..":2:"..tostring(state.seq)..":"..tostring(math.floor(now()*20))
            if selfCount("disk_drive")<4 or selfCount("floppy")<4 then
                send(donorId,{type="installer_chain_donate",number=2,
                    amount=3,token=token,session=cfg.session})
            end
            local deadline=now()+12
            while now()<deadline and (selfCount("disk_drive")<4 or selfCount("floppy")<4) do sleep(0.1) end
            if selfCount("disk_drive")<4 or selfCount("floppy")<4 then
                state.phase="INSTALLER_HANDOFF_BLOCKED"
                state.setupBlockReason="Foreman-1 did not receive all four installer sets"
                saveState()
                sendState(state.setupBlockReason)
                return false
            end
            if not returnHome() then return false end
            state.installerConsolidationStep=1
            saveState()
        end

        if state.installerConsolidationStep==1 then
            state.phase="INSTALLER_RETURN_SUPPLY"
            saveState()
            if not goTo(0,-1) or not faceTracked(DIR_N) or not wrapInventory("front") then
                state.setupBlockReason="Foreman-1 cannot access the Black Blue Blue supply chest for installer return"
                state.installerSupplyRetryAt=now()+5
                saveState()
                sendState(state.setupBlockReason)
                return false
            end
            local driveBefore=installerFrontCount("disk_drive")
            local diskBefore=installerFrontCount("floppy")
            if driveBefore==nil or diskBefore==nil then return false end
            if selfCount("disk_drive")<4 or selfCount("floppy")<4 then
                state.setupBlockReason="Foreman-1 does not hold all four installer sets"
                saveState()
                sendState(state.setupBlockReason)
                return false
            end
            if not installerDropKind("disk_drive",4) or not installerDropKind("floppy",4) then
                state.setupBlockReason="Foreman-1 could not return all installer resources to the supply chest"
                saveState()
                sendState(state.setupBlockReason)
                return false
            end
            local driveAfter=installerFrontCount("disk_drive")
            local diskAfter=installerFrontCount("floppy")
            if driveAfter==nil or diskAfter==nil or driveAfter<driveBefore+4 or diskAfter<diskBefore+4 then
                state.setupBlockReason="Supply chest did not verify all four returned installer sets"
                saveState()
                sendState(state.setupBlockReason)
                return false
            end
            state.installerConsolidationDone=true
            state.installerConsolidationStep=0
            state.installerSupplyRetryAt=nil
            state.setupBlockReason=nil
            saveState()
            if not returnHome() then return false end
            send(cfg.managerId,{type="installer_consolidation_complete",drives=4,disks=4,
                session=cfg.session})
            sendState("Installer disks and drives consolidated in supply chest")
            return true
        end
        return state.installerConsolidationDone and true or false
    end

    local function chunkAck(stage,target)
        send(cfg.managerId,{type="chunk_ack",role="foreman",number=number,
            stage=stage,chunkIndex=target,session=cfg.session,
            x=state.x,y=state.y,z=state.z,dir=state.dir})
    end

    local function runChunkCommand(command)
        local target=command.target
        if command.stage=="STAGE_F" then
            if state.advanceStage=="STAGED" or state.advanceStage=="TRAVEL" or
                state.chunkIndex==target then
                chunkAck("STAGE_F",target)
                return true
            end
            if state.recoveryLocked or active or #queue>0 or state.recallMode or
                state.y~=0 or not state.setupDone or
                selfCount("ender_dump")>0 or selfCount("ender_fuel")>0 or
                countRuntimeFreeSlots()<2 or
                (turtle.getFuelLevel()~="unlimited" and turtle.getFuelLevel()<24) then
                sendState("Cannot clear chest lane for next chunk")
                return false
            end
            if state.x~=cfg.homeX or state.z~=cfg.homeZ or
                not faceTracked(DIR_N) then
                sendState("Foreman must remain at idle for chest handoff")
                return false
            end
            state.advanceStage="STAGED"
            state.phase="ADVANCE_STAGED"
            saveState()
            checkpointForeman()
            chunkAck("STAGE_F",target)
            return true
        end
        if command.stage=="VERIFY_F" then
            if state.advanceStage=="STAGED" and selfCount("ender_dump")>=1 and
                selfCount("ender_fuel")>=1 then
                chunkAck("VERIFY_F",target)
                return true
            end
            sendState("Missing dump or fuel Ender Chest after handoff")
            return false
        end
        if command.stage=="MOVE_F" then
            if state.chunkIndex==target and not state.advanceStage then
                chunkAck("MOVE_F",target)
                return true
            end
            if (target~=state.chunkIndex+1 and target~=state.chunkIndex) or
                (state.advanceStage~="STAGED" and state.advanceStage~="TRAVEL") then
                return false
            end
            if state.chunkIndex<target and
                (selfCount("ender_dump")<1 or selfCount("ender_fuel")<1) then
                sendState("Chest handoff incomplete or wrong Ender Chest frequencies")
                return false
            end
            state.advanceStage="TRAVEL"
            state.phase="ADVANCE_TRAVEL"
            saveState()
            if state.chunkIndex<target then
                flags.advanceCancelled=false
                local ok,reason=travelChunkNorth(state,saveState,faceTracked,cfg.homeZ,target,
                    cfg.worldOrigin,function()
                        return flags.advanceCancelled or flags.recallMode~=nil
                    end)
                if not ok then
                    if flags.advanceCancelled or flags.recallMode then
                        state.advanceStage=nil
                        state.phase="RECALL_PENDING"
                        saveState()
                        sendState("Chunk travel cancelled for Regional Manager recall")
                        return false
                    end
                    sendState(reason)
                    return false
                end
                checkpointForeman()
            end
            if state.chestsReady then
                state.chestsReady=false
                state.dumpChestPlaced=false
                state.fuelChestPlaced=false
                saveState()
            end
            if not ensureEnderPair() then return false end
            state.advanceStage=nil
            state.phase="IDLE"
            saveState()
            checkpointForeman()
            sendState("Next chunk Ender Chest pair ready")
            chunkAck("MOVE_F",target)
            return true
        end
        return false
    end

    local function workLoop()
        local nextIdleFuelAttempt=0
        while state.recoveryLocked do
            if state.phase~="RECOVERY_LOCK" then
                state.phase="RECOVERY_LOCK"
                saveState()
            end
            if recoverForemanState() then break end
            sendState("Movement recovery waiting: " .. tostring(state.recoveryReason or "pose uncertain"))
            sleep(2)
        end

        checkpointForeman()

        if flags.recallMode then
            pauseForSetupRecall()
        end

        if state.phase=="DEPLOYING" then
            local laneX=cfg.homeX
            local deploymentValid=
                state.y==0 and
                state.x>=cfg.startX and state.x<=laneX and
                state.z>=cfg.homeZ and state.z<=cfg.startZ

            if not deploymentValid then
                state.phase="RECOVERY_LOCK"
                state.recoveryLocked=true
                state.recoveryReason="Interrupted Foreman deployment pose is outside its deployment corridor"
                saveState()
                while true do
                    sendState(state.recoveryReason)
                    sleep(5)
                end
            end

            if state.z>cfg.homeZ then
                while state.x<laneX do
                    if not moveStep(DIR_E) then
                        state.recoveryLocked=true
                        state.recoveryReason="Could not regain Foreman deployment lane"
                        break
                    end
                end

                if not state.recoveryLocked then
                    while state.z>cfg.homeZ do
                        if not moveStep(DIR_S) then
                            state.recoveryLocked=true
                            state.recoveryReason="Could not resume Foreman southbound deployment"
                            break
                        end
                    end
                end
            end

            if not state.recoveryLocked and state.z==cfg.homeZ then
                while state.x>cfg.homeX do
                    if not moveStep(DIR_W) then
                        state.recoveryLocked=true
                        state.recoveryReason="Could not finish Foreman westbound deployment"
                        break
                    end
                end
            end

            if state.recoveryLocked or
                state.x~=cfg.homeX or state.z~=cfg.homeZ or state.y~=0 then
                state.phase="RECOVERY_LOCK"
                state.recoveryLocked=true
                state.recoveryReason=state.recoveryReason or "Could not resume interrupted Foreman deployment"
                saveState()
                while true do
                    sendState(state.recoveryReason)
                    sleep(5)
                end
            end

            faceTracked(DIR_N)
            state.phase="WAITING_SETUP"
            state.setupDone=false
            saveState()
            checkpointForeman()

            for i=1,3 do
                send(cfg.controller,{
                    type="foreman_deployed",
                    id=id,
                    number=number
                })
                sleep(0.1)
            end
        end

        if cfg.master and not state.setupDone then
            while not state.masterSetupDone do
                if flags.recallMode then
                    pauseForSetupRecall()
                elseif masterSetup() then
                    state.masterSetupDone=true
                    saveState()
                else
                    if flags.recallMode then
                        pauseForSetupRecall()
                    else
                        if state.phase~="WAITING_SUPPLIES" and state.phase~="WAITING_SEED_FUEL" and
                            state.phase~="WAITING_FOREMAN_PACKAGE" and
                            state.phase~="WAITING_FOREMAN_RECOVERY" and
                            state.phase~="WAITING_NAVIGATOR_RECOVERY" then
                            state.phase="WAITING_SETUP"
                        end
                        saveState()
                        sendState(state.setupBlockReason or "Master setup paused, retrying")
                        sleep(2)
                    end
                end
            end

            state.minerSetupApproved=true
            saveState()

            state.groupsCommissioned = state.groupsCommissioned or {}

            for n=2,4 do
                if not state.groupsCommissioned[n] then
                    commissionWave[n] = commissionWave[n] or {}
                    send(cfg.foremen[n],{type="commission_start",number=n})
                    commissionWave[n].lastSend = now()
                end
            end

            if not state.groupsCommissioned[1] then
                state.phase="COMMISSIONING"
                saveState()
                sendState("All foremen released for simultaneous commissioning")

                while not commissionAssigned() do
                    if flags.recallMode then pauseForSetupRecall() end
                    saveState()
                    sendState(state.setupBlockReason or "Foreman-1 commissioning paused, retrying")
                    sleep(2)
                end

                state.groupsCommissioned[1]=true
                saveState()
            end

            while not (state.groupsCommissioned[2] and state.groupsCommissioned[3] and state.groupsCommissioned[4]) do
                if flags.recallMode then pauseForSetupRecall() end
                state.phase="WAITING_SETUP"
                saveState()
                sendState("Waiting for all foremen to finish commissioning")
                sleep(1)
            end

            state.setupDone=true
            state.phase="IDLE"
            saveState()
            sendState("Commissioning complete; waiting for Regional Manager release")

            send(cfg.managerId,{
                type="commissioning_complete",
                version=VERSION,
                masterForemanId=id,
                session=cfg.session
            })

            returnHome()
        elseif not cfg.master and not state.setupDone then
            flags.commissionStart=false

            while not state.setupDone do
                if flags.recallMode then
                    pauseForSetupRecall()
                elseif commissionAssigned() then
                    break
                else
                    if flags.recallMode then
                        pauseForSetupRecall()
                    else
                        saveState()
                        sendState(state.setupBlockReason or "Commissioning paused, retrying")
                        sleep(2)
                    end
                end
            end
        end

        while true do
            if flags.chunkCommand then
                local command=flags.chunkCommand
                flags.chunkCommand=nil
                runChunkCommand(command)
            end
            if flags.startMining then
                flags.startMining=false
                if not state.orientationCheckDone then
                    if verifyAssignedMinerOrientation() then
                        flags.startMining=true
                    else
                        sendState(state.setupBlockReason or "Miner orientation verification blocked")
                    end
                elseif not state.miningStarted then
                    state.miningStarted=true
                    if state.phase~="RECALLED_PAUSED" then
                        state.phase="IDLE"
                    end
                    saveState()
                    sendState("Regional Manager released mining")
                end
            end

            if flags.recallMode then
                local mode=flags.recallMode
                flags.recallMode=nil

                if mode=="NORMAL" or mode=="SHUTDOWN" or mode=="PACK" then
                    recallForeman(mode)
                end
            end

            if state.phase~="RECALLED_PAUSED" and flags.installerChainCommand and
                not active and #queue==0 and not state.advanceStage then
                local command=flags.installerChainCommand
                flags.installerChainCommand=nil
                runInstallerChainCommand(command)
            end

            if state.phase~="RECALLED_PAUSED" and cfg.master and state.miningStarted and
                not state.installerConsolidationDone and not active and #queue==0 and
                not state.advanceStage and not flags.installerChainCommand then
                masterInstallerConsolidation()
            end

            if state.phase=="RECALLED_PAUSED" then
                if state.packReady and not state.packAcknowledged and now()-(state.lastPackSend or -10)>=2 then
                    send(cfg.managerId,{
                        type="pack_ready",role="foreman",number=number,
                        packToken=state.packToken,labelCleared=true,
                        x=state.x,y=state.y,z=state.z,dir=state.dir,session=cfg.session
                    })
                    state.lastPackSend=now()
                end
                if flags.resume then
                    flags.resume=false
                    state.recallMode=nil
                    state.phase="IDLE"
                    saveState()
                    sendState("Regional Manager resumed operations")
                else
                    sleep(0.2)
                end
            elseif not state.advanceStage and not active and #queue==0 and
                now()>=nextIdleFuelAttempt then
                local low=turtle.getFuelLevel()~="unlimited" and
                    (turtle.getFuelLevel()<=FOREMAN_FUEL_LOW or state.fuelPending)
                local excess=false
                if not low then
                    local inv=getSelfInventory()
                    local items=inv and inventorySnapshot(inv) or {}
                    for _,item in pairs(items) do
                        if matchesItem(item,"empty_bucket") or matchesItem(item,"lava_bucket") or
                            matchesItem(item,"blaze_rod") or matchesItem(item,"charcoal") or
                            matchesItem(item,"coal") then
                            excess=true
                            break
                        end
                    end
                end
                if low or excess then
                    local fueled=low and loadOwnFuel() or returnUnusedFuel()
                    nextIdleFuelAttempt=now()+(fueled and 10 or 30)
                else
                    nextIdleFuelAttempt=now()+30
                end
            end

            if state.phase~="RECALLED_PAUSED" and not state.advanceStage and not active and #queue>0 then
                active=table.remove(queue,1)
                saveQueue()
            end

            if state.phase=="RECALLED_PAUSED" or state.advanceStage then
                sleep(0.2)
            elseif active then
                local ready=true
                if state.blockedCargo then
                    ready=dumpCargo()
                    if ready then
                        state.blockedCargo=nil
                        saveState()
                    end
                end
                if not ready or not serviceRequest(active) then
                    local failed=active
                    if flags.recallMode then
                        active=nil
                        saveQueue()
                    else
                    local failurePhase=state.phase
                    local blockedReason=nil

                    if failurePhase=="DOCK_BLOCKED" then
                        blockedReason="STORAGE_FULL"
                    elseif failurePhase=="WAITING_FUEL" then
                        blockedReason="FUEL_UNAVAILABLE"
                    end

                    state.phase=blockedReason and failurePhase or "ERROR"
                    saveState()
                    sendState(blockedReason and ("Service blocked: " .. blockedReason) or "Service error; Regional Manager retains authority")

                    if failed then
                        send(cfg.managerId,{
                            type=blockedReason and "job_blocked" or "job_failed",
                            requestId=failed.requestId,
                            foremanId=id,
                            foremanNumber=number,
                            row=failed.row,
                            reason=blockedReason or failurePhase,
                            session=cfg.session
                        })
                    end

                    if blockedReason then
                        sleep(5)
                    else
                        active=nil
                    end
                    saveQueue()

                    if not blockedReason then
                        returnHome()
                    end

                    sleep(2)
                    end
                end
            else
                if state.x ~= cfg.homeX or state.z ~= cfg.homeZ then
                    returnHome()
                end
                sleep(0.2)
            end
        end
    end

    local gpsModemSide,gpsModem=findWirelessModemSide()
    if gpsModem then gpsModem.open(gps.CHANNEL_GPS) end

    local function recoveryGpsLoop()
        if not gpsModem then
            while true do sleep(60) end
        end
        while true do
            local event={os.pullEvent("modem_message")}
            if event[2]==gpsModemSide and event[3]==gps.CHANNEL_GPS and event[5]=="PING" then
                local stable=not state.recoveryLocked and not state.motionIntent and
                    not state.verticalIntent and not state.turnIntent and
                    not state.chunkMoveIntent and foremanPoseValid()
                if stable then
                    local x,y,z=worldPose(state.x,state.y,state.z,state.chunkIndex,cfg.worldOrigin)
                    if x then gpsModem.transmit(event[4],gps.CHANNEL_GPS,{x,y,z}) end
                end
            end
        end
    end

    parallel.waitForAny(networkLoop, workLoop, recoveryGpsLoop)
end


local function runMaster()
    if not openNetwork() then
        error("Wireless modem not found")
    end

    local cfg=loadTable("node.cfg")
    local anchor=loadTable("world_anchor")
    local validAnchor=anchor and type(anchor.x)=="number" and
        type(anchor.y)=="number" and type(anchor.z)=="number"

    if not validAnchor and cfg and cfg.worldOrigin and
        type(cfg.worldOrigin.x)=="number" and type(cfg.worldOrigin.y)=="number" and
        type(cfg.worldOrigin.z)=="number" then
        anchor={x=cfg.worldOrigin.x,y=cfg.worldOrigin.y,z=cfg.worldOrigin.z+1}
        saveTable("world_anchor",anchor)
        validAnchor=true
    end

    if not validAnchor and gps and gps.locate then
        local ok,x,y,z=pcall(gps.locate,2,false)
        if ok and type(x)=="number" and type(y)=="number" and type(z)=="number" then
            anchor={x=x,y=y,z=z}
            saveTable("world_anchor",anchor)
            validAnchor=true
        end
    end

    if not validAnchor then
        error("Master world anchor missing; run update once and enter this turtle's coordinates")
    end

    local worldOrigin={x=anchor.x,y=anchor.y,z=anchor.z-1}
    local newMaster=false
    local id=os.getComputerID()

    local cfgVersion=tonumber(cfg and cfg.version)
    if cfg and (not cfgVersion or cfgVersion<55 or cfgVersion>VERSION) then
        error("Unsupported Master Foreman state version. Clear node.cfg and foreman state only if this node cannot be migrated safely.")
    end

    if not cfg then
        newMaster=true
        local managerId,session=pairMasterWithRegionalManager()

        cfg={
            version=VERSION,
            role="foreman",
            number=1,
            controller=id,
            rowStart=1,
            rowEnd=4,
            homeX=1,
            homeZ=-1,
            startX=0,
            startZ=-1,
            startDir=DIR_N,
            worldOrigin=worldOrigin,
            master=true,
            managerId=managerId,
            masterForemanId=id,
            session=session,
            foremen={[1]=id}
        }

        saveTable("node.cfg",cfg)
    else
        local wasMaster=
            cfg.role=="foreman" and
            tonumber(cfg.number)==1 and
            cfg.master==true and
            tonumber(cfg.masterForemanId)==id

        if not wasMaster then
            newMaster=true
        end

        cfg.version=VERSION
        cfg.role="foreman"
        cfg.number=1
        cfg.controller=id
        cfg.rowStart=1
        cfg.rowEnd=4
        cfg.homeX=1
        cfg.homeZ=-1
        cfg.startX=0
        cfg.startZ=-1
        cfg.startDir=DIR_N
        cfg.worldOrigin=worldOrigin
        cfg.master=true
        cfg.masterForemanId=id
        cfg.foremen=type(cfg.foremen)=="table" and cfg.foremen or {}
        cfg.foremen[1]=id

        saveTable("node.cfg",cfg)

        if cfg.managerId then
            setRegionalManager(cfg.managerId)
        end

        if not cfg.managerId or not cfg.session or not registerNodeWithManager(cfg,3) then
            local managerId,session=pairMasterWithRegionalManager()
            cfg.managerId=managerId
            cfg.masterForemanId=id
            cfg.session=session
            cfg.foremen[1]=id
            saveTable("node.cfg",cfg)
        end
    end

    setRegionalManager(cfg.managerId)

    if not registerNodeWithManager(cfg) then
        error("Master Foreman could not register with Regional Manager")
    end

    local state=loadTableLight("foreman1.tmp")
    if not (state and state.recallMode=="PACK" and state.packReady) then
        os.setComputerLabel("Foreman-1")
    end

    if not state and newMaster then
        saveTableLight("foreman1.tmp",{
            x=0,
            z=-1,
            y=0,
            dir=DIR_N,
            phase="MASTER_SETUP",
            setupDone=false,
            masterSetupDone=false,
            session=cfg.session,
            seq=0
        })
    end

    runForeman(cfg)
end


if MASTER_FOREMAN==1 then
    runMaster()
else
    local cfg=loadTable("node.cfg")

    if not cfg or cfg.role~="foreman" then
        error("Foreman role file requires foreman node.cfg")
    end

    local cfgVersion=tonumber(cfg.version)
    if cfgVersion and cfgVersion>=56 and cfgVersion<VERSION then
        cfg.version=VERSION
        saveTable("node.cfg",cfg)
    elseif cfgVersion~=VERSION then
        error("Unsupported foreman node state version")
    end

    setRegionalManager(cfg.managerId)
    runForeman(cfg)
end
local function runForeman(cfg)
    setRegionalManager(cfg.managerId)
    if not openNetwork() then
        error("Wireless modem not found")
    end
    ensureManagerRegistration(cfg)

    if not getSelfInventory() then
        error("Narcissistic inventory peripheral not found")
    end

    local number = cfg.number
    local id = os.getComputerID()
    local statePath = "foreman" .. tostring(number) .. ".tmp"
    local queuePath = "foreman" .. tostring(number) .. "_queue.tmp"
    local state=loadTableLight(statePath)

    if not state then
        local monitorState=requestPoseBackup("foreman",5,cfg.session)
        state=monitorState or {
            number=number,
            x=cfg.homeX,
            z=cfg.homeZ,
            y=0,
            dir=DIR_N,
            phase="RECOVERY_LOCK",
            setupDone=false,
            seq=0
        }
        state.recoveryLocked=true
        state.recoveryReason=monitorState and
            "Local foreman state missing; monitor backup retained for manual recovery" or
            "Local foreman state missing and monitor has no backup"
        state.phase="RECOVERY_LOCK"
        saveTableLight(statePath,state)
    end

    state.session=cfg.session
    state.y=tonumber(state.y) or 0
    state.seq=tonumber(state.seq) or 0
    state.dir=tonumber(state.dir) or DIR_N

    local function foremanPoseValid()
        if number==4 and state.navigatorSetupActive then
            return state.x>=-3 and state.x<=17 and state.z>=-6 and state.z<=15 and
                state.y>=0 and state.y<=15 and state.dir>=DIR_N and state.dir<=DIR_W
        end

        return state.x>=-3 and state.x<=17 and state.z>=-6 and state.z<=2 and
            state.y>=0 and state.y<=1 and state.dir>=DIR_N and state.dir<=DIR_W
    end

    do
        local managerState,managerSeq=requestPoseBackup("foreman",5,cfg.session)
        local managerPoseValid=managerState and
            type(managerState.x)=="number" and type(managerState.y)=="number" and
            type(managerState.z)=="number" and type(managerState.dir)=="number"

        if not foremanPoseValid() and managerPoseValid then
            state=managerState
            state.motionIntent=nil
            state.verticalIntent=nil
            state.turnIntent=nil
            state.session=cfg.session
            state.seq=tonumber(managerSeq or managerState.seq or state.seq) or 0
            saveTableLight(statePath,state)
        elseif foremanPoseValid() and not state.motionIntent and
            not state.verticalIntent and not state.turnIntent then
            checkpointPose("foreman",state.seq,state,cfg.session)
        end
    end

    if state.motionIntent or state.verticalIntent or state.turnIntent then
        local monitorState,monitorSeq=requestPoseBackup("foreman",5,cfg.session)
        local intent=state.motionIntent or state.verticalIntent or state.turnIntent
        local intentSeq=tonumber(intent.seq) or (state.seq+1)

        if monitorState and tonumber(monitorSeq or monitorState.seq or 0)>=intentSeq then
            state=monitorState
            state.motionIntent=nil
            state.verticalIntent=nil
            state.turnIntent=nil
            saveTableLight(statePath,state)
        elseif state.turnIntent then
            state.recoveryLocked=true
            state.recoveryReason="Facing ambiguous after interrupted turn"
            state.phase="RECOVERY_LOCK"
            saveTableLight(statePath,state)
        else
            local moveIntent=state.motionIntent or state.verticalIntent
            local fuelNow=turtle.getFuelLevel()
            local fuelBefore=moveIntent.fuelBefore
            local moved=nil

            if type(fuelNow)=="number" and type(fuelBefore)=="number" then
                moved=fuelNow<fuelBefore
            elseif type(fuelBefore)=="number" and fuelBefore<=0 then
                moved=false
            end

            if moved==nil then
                state.recoveryLocked=true
                state.recoveryReason="Position ambiguous after interrupted foreman movement"
                state.phase="RECOVERY_LOCK"
            elseif state.motionIntent then
                local pose=moved and state.motionIntent.to or state.motionIntent.from
                state.x=pose.x
                state.z=pose.z
                state.y=pose.y
                state.dir=pose.dir
                if moved then state.seq=intentSeq end
                state.motionIntent=nil
            else
                state.y=moved and state.verticalIntent.to or state.verticalIntent.from
                if moved then state.seq=intentSeq end
                state.verticalIntent=nil
            end
            saveTableLight(statePath,state)
        end
    end

    if not foremanPoseValid() then
        state.recoveryLocked=true
        state.recoveryReason="Saved foreman pose is outside the operating area"
        state.phase="RECOVERY_LOCK"
        saveTableLight(statePath,state)
    end

    local qdata=loadTableLight(queuePath)
    if type(qdata)~="table" then
        qdata={queue={},active=nil,resolved={}}
    end

    local queue=type(qdata.queue)=="table" and qdata.queue or {}
    local active=type(qdata.active)=="table" and qdata.active or nil
    local resolved=type(qdata.resolved)=="table" and qdata.resolved or {}
    local peers = {}
    local intents = {}
    local recallTravel=false
    local inbox = {}
    local commissionWave = {}
    local flags = {
        commissionStart=false,
        navigatorSetupStart=false,
        startMining=false,
        dockGranted=false,
        recallMode=nil,
        resume=false
    }
    local dock = nil
    if number == 1 then
        dock = loadTableLight("dock.tmp") or {holder=nil,queue={}}
    end
    local lastStatus = 0
    local lastPeer = 0

    local function saveState()
        saveTableLight(statePath,state)
    end

    local function foremanSnapshot()
        local raw=textutils.serialize(state)
        local snapshot=textutils.unserialize(raw)
        snapshot.motionIntent=nil
        snapshot.verticalIntent=nil
        snapshot.turnIntent=nil
        return snapshot
    end

    local function checkpointForeman()
        checkpointPose("foreman",state.seq,foremanSnapshot(),cfg.session)
    end

    local function turnQuarter(right)
        local from=state.dir
        local to=right and ((from+1)%4) or ((from+3)%4)
        local intent={seq=state.seq+1,from=from,to=to}
        state.turnIntent=intent
        saveState()

        local ok
        if right then
            ok=turtle.turnRight()
        else
            ok=turtle.turnLeft()
        end

        if not ok then
            state.turnIntent=nil
            saveState()
            return false
        end

        state.dir=to
        state.seq=intent.seq
        checkpointForeman()
        state.turnIntent=nil
        saveState()
        return true
    end

    local function faceTracked(target)
        if state.recoveryLocked then
            return false
        end

        while state.dir~=target do
            local diff=(target-state.dir)%4
            if diff==3 then
                if not turnQuarter(false) then return false end
            else
                if not turnQuarter(true) then return false end
            end
        end

        return true
    end

    local function saveQueue()
        saveTableLight(queuePath,{queue=queue,active=active,resolved=resolved})
    end

    local function saveDock()
        if number == 1 and dock then
            saveTableLight("dock.tmp",dock)
        end
    end

    local function sendState(message)
        status("foreman",state.phase,{
            number=number,
            rowStart=cfg.rowStart,
            rowEnd=cfg.rowEnd,
            x=state.x,
            z=state.z,
            y=state.y,
            dir=state.dir,
            seq=state.seq,
            queue=#queue + (active and 1 or 0),
            setupDone=state.setupDone and true or false,
            miningStarted=state.miningStarted and true or false,
            recovery=state.recoveryReason,
            message=message or ""
        })
        lastStatus = now()
    end

    local function pushInbox(sender,message)
        inbox[#inbox+1] = {sender=sender,message=message}
        if #inbox > 100 then
            table.remove(inbox,1)
        end
    end

    local function popInbox(predicate)
        for i=1,#inbox do
            local entry = inbox[i]
            if predicate(entry.sender,entry.message) then
                table.remove(inbox,i)
                return entry.sender,entry.message
            end
        end
        return nil,nil
    end

    local function waitInbox(predicate, timeout)
        local deadline = now() + timeout
        while now() < deadline do
            local sender,message = popInbox(predicate)
            if sender then
                return sender,message
            end
            sleep(0.1)
        end
        return nil,nil
    end

    local function assignedRow(row)
        return row >= cfg.rowStart and row <= cfg.rowEnd
    end

    local function upsertRequest(message)
        if not assignedRow(message.row or -1) then
            return
        end
        local requestId = message.requestId
        if resolved[requestId] then
            if message.minerId then
                send(message.minerId,{
                    type="service_complete",
                    requestId=requestId
                })
            end
            return
        end
        if active and active.requestId == requestId then
            active.arrived = active.arrived or message.type == "service_arrived"
            active.lastSeen = now()
            saveQueue()
            return
        end
        for i=1,#queue do
            if queue[i].requestId == requestId then
                queue[i].arrived = queue[i].arrived or message.type == "service_arrived"
                queue[i].lastSeen = now()
                saveQueue()
                return
            end
        end
        queue[#queue+1] = {
            requestId=requestId,
            row=message.row,
            service=message.service,
            minerId=message.minerId,
            arrived=message.type == "service_arrived",
            lastSeen=now()
        }
        saveQueue()
        if not message.managerAssigned then
            send(message.minerId,{
                type="service_ack",
                requestId=requestId,
                row=message.row
            })
        end
        sendState("Queued Miner-" .. tostring(message.row))
    end

    local function dockContains(fid)
        if dock.holder == fid then
            return true
        end
        for i=1,#dock.queue do
            if dock.queue[i] == fid then
                return true
            end
        end
        return false
    end

    local function grantDock()
        if number ~= 1 then
            return
        end
        if not dock.holder and #dock.queue > 0 then
            dock.holder = table.remove(dock.queue,1)
            saveDock()
            if dock.holder == id then
                flags.dockGranted = true
            else
                send(dock.holder,{type="dock_grant"})
            end
        end
    end

    local function requestDock()
        flags.dockGranted = false
        if number == 1 then
            if dock.holder == id then
                flags.dockGranted = true
            else
                if not dockContains(id) then
                    dock.queue[#dock.queue+1] = id
                    saveDock()
                end
                grantDock()
            end
        else
            broadcast({
                type="dock_request",
                foremanId=id,
                number=number
            })
        end
        local lastRequest = now()
        while not flags.dockGranted do
            if number ~= 1 and now() - lastRequest >= 2 then
                broadcast({
                    type="dock_request",
                    foremanId=id,
                    number=number
                })
                lastRequest = now()
            end
            sleep(0.05)
        end
    end

    local function releaseDock()
        flags.dockGranted = false
        if number == 1 then
            if dock.holder == id then
                dock.holder = nil
                saveDock()
                grantDock()
            end
        else
            send(cfg.controller,{type="dock_release",foremanId=id})
        end
    end

    local function peerAt(tx,tz,ty)
        ty=ty==nil and state.y or ty

        for pid,p in pairs(peers) do
            if pid~=id and p.x==tx and p.z==tz and
                tonumber(p.y or 0)==tonumber(ty) and
                now()-(p.lastSeen or 0)<8 then
                return pid,p
            end
        end

        return nil,nil
    end

    local function occupied(tx,tz,ty)
        local pid=peerAt(tx,tz,ty)
        return pid~=nil
    end

    local function lowerIntentWins(tx,tz,ty)
        ty=ty==nil and state.y or ty

        for pid,p in pairs(intents) do
            if pid~=id and p.x==tx and p.z==tz and
                tonumber(p.y or 0)==tonumber(ty) and
                now()-(p.lastSeen or 0)<1 then
                if (p.number or 99)<number then
                    return true
                end
            end
        end

        return false
    end

    local function moveVertical(targetY)
        if flags.recallMode and not recallTravel then
            return false
        end

        if state.recoveryLocked then
            return false
        end

        if targetY~=0 and targetY~=1 then
            state.phase="VERTICAL_ERROR"
            saveState()
            sendState("Invalid relative Y target " .. tostring(targetY))
            return false
        end

        while state.y<targetY do
            state.phase="MOVING_UP"
            local intent={
                seq=state.seq+1,
                from=state.y,
                to=state.y+1,
                fuelBefore=turtle.getFuelLevel()
            }
            state.verticalIntent=intent
            saveState()

            if not turtle.up() then
                state.verticalIntent=nil
                state.phase="VERTICAL_ERROR"
                saveState()
                sendState("Unable to move up to relative Y " .. tostring(targetY))
                return false
            end

            state.y=intent.to
            state.seq=intent.seq
            checkpointForeman()
            state.verticalIntent=nil
            saveState()
        end

        while state.y>targetY do
            state.phase="MOVING_DOWN"
            local intent={
                seq=state.seq+1,
                from=state.y,
                to=state.y-1,
                fuelBefore=turtle.getFuelLevel()
            }
            state.verticalIntent=intent
            saveState()

            if not turtle.down() then
                state.verticalIntent=nil
                state.phase="VERTICAL_ERROR"
                saveState()
                sendState("Unable to move down to relative Y " .. tostring(targetY))
                return false
            end

            state.y=intent.to
            state.seq=intent.seq
            checkpointForeman()
            state.verticalIntent=nil
            saveState()
        end

        return state.y==targetY
    end

    local function ensureGroundLevel()
        if state.y~=0 then
            sendState("Correcting foreman to staging height")
        end
        return moveVertical(0)
    end

    local function ensureInstallerLevel()
        if state.y~=1 then
            sendState("Correcting foreman to installer height")
        end
        return moveVertical(1)
    end

    local function verifyGroundFrontNoDrive()
        if state.y~=0 then
            return false
        end
        return peripheral.getType("front")~="drive"
    end

    local function gpsSample(timeout)
        if not gps or not gps.locate then
            return nil
        end

        local ok,x,y,z=pcall(gps.locate,timeout or 1,false)

        if ok and x and y and z then
            return {x=x,y=y,z=z}
        end

        return nil
    end

    local function gpsVerifyDisplacement(anchor,horizontal,vertical)
        if not anchor then
            return true
        end

        local pos=gpsSample(1)

        if not pos then
            return true
        end

        local hd=math.abs(pos.x-anchor.x)+math.abs(pos.z-anchor.z)
        local vd=pos.y-anchor.y

        if hd~=horizontal or vd~=vertical then
            state.recoveryLocked=true
            state.recoveryReason="GPS verification disagreed with Foreman collision detour"
            state.phase="RECOVERY_LOCK"
            saveState()
            sendState(state.recoveryReason)
            return false
        end

        return true
    end

    local function nextCoordinate(dir,x,z)
        x=x or state.x
        z=z or state.z

        if dir==DIR_N then
            z=z+1
        elseif dir==DIR_E then
            x=x+1
        elseif dir==DIR_S then
            z=z-1
        else
            x=x-1
        end

        return x,z
    end

    local function oppositeDir(dir)
        return (dir+2)%4
    end

    local function withinForemanArea(x,z)
        return x>=-3 and x<=17 and z>=-6 and z<=2
    end

    local function stepAtCurrentHeight(targetDir)
        if state.recoveryLocked then
            return false
        end

        if not faceTracked(targetDir) then
            return false
        end

        local tx,tz=nextCoordinate(targetDir)

        if not withinForemanArea(tx,tz) then
            return false
        end

        if occupied(tx,tz,state.y) then
            return false
        end

        broadcast({
            type="move_intent",
            foremanId=id,
            number=number,
            x=tx,
            z=tz,
            y=state.y
        })

        intents[id]={
            number=number,
            x=tx,
            z=tz,
            y=state.y,
            lastSeen=now()
        }

        sleep(MOVE_RESERVE_TIME)

        if occupied(tx,tz,state.y) or lowerIntentWins(tx,tz,state.y) then
            intents[id]=nil
            return false
        end

        if turtle.detect() then
            intents[id]=nil
            return false
        end

        local intent={
            seq=state.seq+1,
            fuelBefore=turtle.getFuelLevel(),
            from={x=state.x,z=state.z,y=state.y,dir=state.dir},
            to={x=tx,z=tz,y=state.y,dir=state.dir}
        }

        state.motionIntent=intent
        saveState()

        if not turtle.forward() then
            intents[id]=nil
            state.motionIntent=nil
            saveState()
            return false
        end

        state.x=tx
        state.z=tz
        state.seq=intent.seq
        intents[id]=nil
        checkpointForeman()
        state.motionIntent=nil
        saveState()

        broadcast({
            type="foreman_position",
            foremanId=id,
            number=number,
            x=state.x,
            z=state.z,
            y=state.y,
            phase=state.phase
        })

        return true
    end

    local function restoreFromOverpass(targetDir,moved)
        local back=oppositeDir(targetDir)

        for i=1,moved do
            if not stepAtCurrentHeight(back) then
                state.recoveryLocked=true
                state.recoveryReason="Foreman collision bypass could not retreat safely"
                state.phase="RECOVERY_LOCK"
                saveState()
                sendState(state.recoveryReason)
                return false
            end
        end

        if state.y~=0 and not moveVertical(0) then
            state.recoveryLocked=true
            state.recoveryReason="Foreman collision bypass could not return to ground"
            state.phase="RECOVERY_LOCK"
            saveState()
            sendState(state.recoveryReason)
            return false
        end

        return true
    end

    local function resolvePeerCollision(targetDir,blocker)
        if type(blocker)~="table" then
            return false
        end

        local blockerNumber=tonumber(blocker.number) or 99

        if number<blockerNumber then
            local deadline=now()+3

            while now()<deadline do
                local tx,tz=nextCoordinate(targetDir)

                if not occupied(tx,tz,0) then
                    return true
                end

                sleep(0.1)
            end

            return false
        end

        local firstX,firstZ=nextCoordinate(targetDir)
        local secondX,secondZ=nextCoordinate(targetDir,firstX,firstZ)

        if not withinForemanArea(secondX,secondZ) then
            return false
        end

        if occupied(secondX,secondZ,0) then
            return false
        end

        local anchor=gpsSample(1)
        local moved=0

        state.phase="COLLISION_BYPASS"
        saveState()
        sendState("Yielding to Foreman-" .. tostring(blockerNumber))

        if turtle.detectUp() then
            state.phase="COLLISION_WAIT"
            saveState()
            sendState("Collision bypass blocked above")
            return false
        end

        if not moveVertical(1) then
            return false
        end

        for i=1,2 do
            if not stepAtCurrentHeight(targetDir) then
                restoreFromOverpass(targetDir,moved)
                state.phase="COLLISION_WAIT"
                saveState()
                sendState("Collision bypass route unavailable")
                return false
            end

            moved=moved+1
        end

        local deadline=now()+3

        while occupied(state.x,state.z,0) and now()<deadline do
            sleep(0.1)
        end

        if occupied(state.x,state.z,0) then
            restoreFromOverpass(targetDir,moved)
            state.phase="COLLISION_WAIT"
            saveState()
            sendState("Collision bypass landing occupied")
            return false
        end

        if not moveVertical(0) then
            restoreFromOverpass(targetDir,moved)
            return false
        end

        if not gpsVerifyDisplacement(anchor,2,0) then
            return false
        end

        state.phase="MOVING"
        saveState()
        sendState("Collision bypass complete")
        return true
    end

    local function moveStep(targetDir)
        if flags.recallMode and not recallTravel then
            return false,"RECALL"
        end

        if not ensureGroundLevel() then
            state.phase="VERTICAL_ERROR"
            saveState()
            sendState("Horizontal movement blocked because foreman is not at staging height")
            return false,"VERTICAL"
        end

        if not faceTracked(targetDir) then
            return false,"TURN"
        end

        local tx,tz=nextCoordinate(targetDir)

        if not withinForemanArea(tx,tz) then
            state.recoveryLocked=true
            state.recoveryReason="Foreman movement would leave operating area"
            state.phase="RECOVERY_LOCK"
            saveState()
            sendState(state.recoveryReason)
            return false,"BOUNDS"
        end

        local attempts=0

        while attempts<MOVE_RETRY_LIMIT do
            attempts=attempts+1

            local blockerId,blocker=peerAt(tx,tz,state.y)

            if blockerId then
                if attempts>=3 then
                    state.phase="COLLISION_WAIT"
                    saveState()
                    sendState("Foreman-" .. tostring(blocker.number or "?") .. " occupies next tile")
                    return false,"PEER",blocker
                end
            else
                broadcast({
                    type="move_intent",
                    foremanId=id,
                    number=number,
                    x=tx,
                    z=tz,
                    y=state.y
                })

                intents[id]={
                    number=number,
                    x=tx,
                    z=tz,
                    y=state.y,
                    lastSeen=now()
                }

                sleep(MOVE_RESERVE_TIME)

                if not occupied(tx,tz,state.y) and not lowerIntentWins(tx,tz,state.y) then
                    local intent={
                        seq=state.seq+1,
                        fuelBefore=turtle.getFuelLevel(),
                        from={x=state.x,z=state.z,y=state.y,dir=state.dir},
                        to={x=tx,z=tz,y=state.y,dir=state.dir}
                    }

                    state.motionIntent=intent
                    saveState()

                    if turtle.forward() then
                        state.x=tx
                        state.z=tz
                        state.seq=intent.seq
                        intents[id]=nil
                        checkpointForeman()
                        state.motionIntent=nil
                        saveState()

                        broadcast({
                            type="foreman_position",
                            foremanId=id,
                            number=number,
                            x=state.x,
                            z=state.z,
                            y=state.y,
                            phase=state.phase
                        })

                        return true
                    else
                        state.motionIntent=nil
                        saveState()

                        local physicalPeerId,physicalPeer=peerAt(tx,tz,state.y)

                        if physicalPeerId and attempts>=3 then
                            intents[id]=nil
                            return false,"PEER",physicalPeer
                        end
                    end
                end
            end

            sleep(0.2)
        end

        intents[id]=nil
        state.phase="BLOCKED"
        saveState()
        sendState("Movement blocked at " .. tostring(tx) .. "," .. tostring(tz))
        return false,"BLOCKED"
    end

    local function travelAxis(targetDir,targetTest)
        local collisionRetries=0

        while targetTest() do
            local ok,reason,blocker=moveStep(targetDir)

            if ok then
                collisionRetries=0
            elseif reason=="PEER" then
                collisionRetries=collisionRetries+1

                if collisionRetries>4 then
                    return false
                end

                if not resolvePeerCollision(targetDir,blocker) then
                    sleep(0.25)
                end
            else
                return false
            end
        end

        return true
    end

    local function privateLaneZ()
        return 1-number
    end

    local function goTo(tx,tz)
        if state.recoveryLocked then
            return false
        end

        if not ensureGroundLevel() then
            return false
        end

        if not travelAxis(DIR_E,function() return state.x<tx end) then
            return false
        end

        if not travelAxis(DIR_W,function() return state.x>tx end) then
            return false
        end

        if not travelAxis(DIR_N,function() return state.z<tz end) then
            return false
        end

        if not travelAxis(DIR_S,function() return state.z>tz end) then
            return false
        end

        return true
    end

    local function useOwnFuel()
        if turtle.getFuelLevel() == "unlimited" then
            return true
        end

        local fuel = turtle.getFuelLevel()
        if fuel > FOREMAN_FUEL_LOW then
            return true
        end

        local piecesNeeded = math.ceil((FOREMAN_FUEL_TARGET - fuel) / COAL_FUEL_VALUE)

        if selfCount("coal") < piecesNeeded then
            return false
        end

        local remaining = piecesNeeded

        while remaining > 0 do
            local slot = selfFindSlot("coal")
            if not slot then
                return false
            end

            turtle.select(slot)
            local available = turtle.getItemCount(slot)
            local consume = math.min(remaining, available)

            if consume <= 0 then
                return false
            end

            if not turtle.refuel(consume) then
                return false
            end

            remaining = remaining - consume
        end

        return turtle.getFuelLevel() >= FOREMAN_FUEL_TARGET
    end

    local function refuelAtFrontTo(target)
        if turtle.getFuelLevel() == "unlimited" then
            return true
        end

        local fuel = turtle.getFuelLevel()
        if fuel >= target then
            return true
        end

        local piecesNeeded = math.ceil((target - fuel) / COAL_FUEL_VALUE)
        local onboard = selfCount("coal")
        local toPull = piecesNeeded - onboard

        if toPull > 0 then
            if takeNamedIntoSelf("coal",toPull) < toPull then
                return false
            end
        end

        local remaining = piecesNeeded

        while remaining > 0 do
            local slot = selfFindSlot("coal")
            if not slot then
                return false
            end

            turtle.select(slot)
            local available = turtle.getItemCount(slot)
            local consume = math.min(remaining, available)

            if consume <= 0 then
                return false
            end

            if not turtle.refuel(consume) then
                return false
            end

            remaining = remaining - consume
        end

        return turtle.getFuelLevel() >= target
    end

    local function goDockBypass(targetX)
        if state.x ~= -1 then
            if not goTo(-1,state.z) then
                return false
            end
        end
        if state.z ~= 0 then
            if not goTo(-1,0) then
                return false
            end
        end
        if state.x ~= targetX then
            if not goTo(targetX,0) then
                return false
            end
        end
        return true
    end

    local function verifyDockInventory(kind)
        local inv=wrapInventory("front")

        if inv then
            return true
        end

        state.phase="NAVIGATION_ERROR"
        saveState()
        sendState("Expected " .. tostring(kind) .. " chest directly north at dock coordinate")
        return false
    end

    local function goPrivateHome()
        if state.x <= 0 then
            if state.x ~= -1 then
                if not goTo(-1,state.z) then
                    return false
                end
            end
            if not goTo(-1,cfg.homeZ) then
                return false
            end
            if not goTo(cfg.homeX,cfg.homeZ) then
                return false
            end
        else
            if not goTo(state.x,cfg.homeZ) then
                return false
            end
            if not goTo(cfg.homeX,cfg.homeZ) then
                return false
            end
        end
        return true
    end

    local function returnHome()
        if not goPrivateHome() then
            return false
        end

        if state.x~=cfg.homeX or state.z~=cfg.homeZ or state.y~=0 then
            state.phase="NAVIGATION_ERROR"
            saveState()
            sendState("Foreman home coordinate mismatch")
            return false
        end

        faceTracked(DIR_N)

        if state.dir~=DIR_N then
            state.phase="NAVIGATION_ERROR"
            saveState()
            sendState("Foreman could not establish north at home")
            return false
        end

        state.phase = "IDLE"
        saveState()
        checkpointForeman()
        sendState("Waiting")
        return true
    end

    local function prepareDockTrip()
        if state.x ~= cfg.homeX or state.z ~= cfg.homeZ then
            if not goPrivateHome() then
                state.phase="BLOCKED"
                saveState()
                sendState("Cannot return to private lane before dock trip")
                return false
            end
        end
        return true
    end

    local function atSupply()
        requestDock()

        if not goDockBypass(0) then
            state.phase="DOCK_BLOCKED"
            saveState()
            sendState("Supply dock path blocked; token retained")
            return false
        end

        faceTracked(DIR_N)
        saveState()

        if state.x~=0 or state.z~=0 or state.y~=0 then
            state.phase="NAVIGATION_ERROR"
            saveState()
            sendState("Supply dock coordinate mismatch")
            return false
        end

        if not verifyDockInventory("supply") then
            return false
        end

        return true
    end

    local function atFuel()
        requestDock()

        if not goDockBypass(-2) then
            state.phase="DOCK_BLOCKED"
            saveState()
            sendState("Fuel dock path blocked; token retained")
            return false
        end

        faceTracked(DIR_N)
        saveState()

        if state.x~=-2 or state.z~=0 or state.y~=0 then
            state.phase="NAVIGATION_ERROR"
            saveState()
            sendState("Fuel dock coordinate mismatch")
            return false
        end

        if not verifyDockInventory("fuel") then
            return false
        end

        return true
    end

    local function exitDockToLane()
        if state.x ~= -1 then
            if not goTo(-1,state.z) then
                return false
            end
        end

        if state.z ~= cfg.homeZ then
            if not goTo(-1,cfg.homeZ) then
                return false
            end
        end

        if not goTo(cfg.homeX,cfg.homeZ) then
            return false
        end

        releaseDock()
        return true
    end

    local function leaveDockJunction()
        if state.y~=0 and not moveVertical(0) then
            return false
        end

        if state.x~=-1 or state.z~=0 then
            if not goTo(-1,0) then
                return false
            end
        end

        releaseDock()
        return true
    end

    local function enterSupplyTop()
        if not atSupply() then
            return false
        end

        if not moveVertical(1) then
            return false
        end

        if not faceTracked(DIR_N) then
            return false
        end

        local intent={
            seq=state.seq+1,
            fuelBefore=turtle.getFuelLevel(),
            from={x=state.x,z=state.z,y=state.y,dir=state.dir},
            to={x=state.x,z=state.z+1,y=state.y,dir=state.dir}
        }

        state.motionIntent=intent
        saveState()

        if not turtle.forward() then
            state.motionIntent=nil
            saveState()
            return false
        end

        state.z=state.z+1
        state.seq=intent.seq
        checkpointForeman()
        state.motionIntent=nil
        saveState()

        if not wrapInventory("bottom") then
            state.phase="NAVIGATION_ERROR"
            saveState()
            sendState("Expected supply chest directly below top dump coordinate")
            return false
        end

        return true
    end

    local function leaveSupplyTop()
        if state.y~=1 or state.x~=0 or state.z~=1 then
            return false
        end

        local intent={
            seq=state.seq+1,
            fuelBefore=turtle.getFuelLevel(),
            from={x=state.x,z=state.z,y=state.y,dir=state.dir},
            to={x=state.x,z=state.z-1,y=state.y,dir=state.dir}
        }

        state.motionIntent=intent
        saveState()

        if not turtle.back() then
            state.motionIntent=nil
            saveState()
            return false
        end

        state.z=state.z-1
        state.seq=intent.seq
        checkpointForeman()
        state.motionIntent=nil
        saveState()

        return moveVertical(0)
    end

    local function exitDockHome()
        if not exitDockToLane() then
            return false
        end
        faceTracked(DIR_N)
        state.phase="IDLE"
        saveState()
        sendState("Waiting")
        return true
    end

    local function loadOwnFuel()
        if turtle.getFuelLevel() == "unlimited" then
            return true
        end

        if turtle.getFuelLevel() > FOREMAN_FUEL_LOW then
            return true
        end

        if useOwnFuel() then
            return true
        end

        if not atFuel() then
            return false
        end

        local ok = refuelAtFrontTo(FOREMAN_FUEL_TARGET)

        if not ok then
            state.phase="WAITING_FUEL"
            saveState()
            sendState("Unable to reach foreman fuel target")
            return false
        end

        return exitDockHome()
    end

    local function dumpCargo()
        local useTop=(number%2)==0

        if useTop then
            if not enterSupplyTop() then
                return false
            end
        else
            if not atSupply() then
                return false
            end
        end

        for slot=1,16 do
            local item=selfItem(slot)
            local reserved=number==1 and state.bootstrapDrivePending and state.bootstrapDriveSlot==slot

            if item and not reserved then
                turtle.select(slot)

                while turtle.getItemCount(slot)>0 do
                    local ok

                    if useTop then
                        ok=turtle.dropDown()
                    else
                        ok=turtle.drop()
                    end

                    if not ok then
                        state.phase="DOCK_BLOCKED"
                        saveState()
                        sendState("Supply chest full; dock token retained")
                        return false
                    end
                end
            end
        end

        if number==1 and state.bootstrapDrivePending and state.bootstrapDriveSlot then
            local slot=state.bootstrapDriveSlot
            local item=selfItem(slot)

            if item and matchesItem(item,"disk_drive") then
                turtle.select(slot)

                if not turtle.drop(1) then
                    state.phase="DOCK_BLOCKED"
                    saveState()
                    sendState("Cannot return bootstrap Disk Drive")
                    return false
                end
            end

            state.bootstrapDrivePending=false
            state.bootstrapDriveSlot=nil
            saveState()
        end

        if useTop and not leaveSupplyTop() then
            state.phase="DOCK_BLOCKED"
            saveState()
            sendState("Could not leave top supply dump position")
            return false
        end

        return exitDockHome()
    end



    local function prepareRuntimeService(service)
        state.phase="PREPARING_SERVICE"
        saveState()

        if service=="REFUEL" or service=="BOTH" then
            if selfCount("coal")<MINER_REFUEL_COAL then
                if not atFuel() then
                    return false
                end

                local needed=MINER_REFUEL_COAL-selfCount("coal")
                local got=takeNamedIntoSelf("coal",needed)

                if got<needed then
                    state.phase="WAITING_FUEL"
                    saveState()
                    sendState("Fuel chest cannot provide miner refuel packet")
                    return false
                end

                if not exitDockToLane() then
                    return false
                end
            end
        end

        return true
    end

    local function dropMinerFuel(amount)
        amount=amount or MINER_REFUEL_COAL
        local remaining=amount
        local movedTotal=0

        for slot=1,16 do
            local item=selfItem(slot)

            if item and matchesItem(item,"coal") and remaining>0 then
                turtle.select(slot)

                local before=turtle.getItemCount(slot)
                local requested=math.min(remaining,before)

                if requested>0 and turtle.drop(requested) then
                    sleep(0.05)

                    local after=turtle.getItemCount(slot)
                    local moved=before-after

                    if moved>0 then
                        movedTotal=movedTotal+moved
                        remaining=remaining-moved
                    end
                end
            end
        end

        return movedTotal>0,movedTotal
    end

    local function countRuntimeFreeSlots()
        local free=0

        for slot=1,16 do
            if turtle.getItemCount(slot)==0 then
                free=free+1
            end
        end

        return free
    end

    local function networkLoop()
        local timer = os.startTimer(1)
        while true do
            local event = {os.pullEvent()}
            if event[1] == "rednet_message" then
                local sender = event[2]
                local message = event[3]
                local protocol = event[4]
                if protocol == PROTOCOL and type(message) == "table" then
                    if sender==cfg.managerId and message.type=="manager_job" and
                        message.foremanNumber==number then
                        upsertRequest({
                            type="service_arrived",
                            requestId=message.requestId,
                            row=message.row,
                            service=message.service,
                            minerId=message.minerId,
                            arrived=true,
                            lastSeen=now(),
                            managerAssigned=true
                        })
                        send(cfg.managerId,{
                            type="job_accepted",
                            requestId=message.requestId,
                            foremanId=id,
                            foremanNumber=number,
                            session=cfg.session
                        })
                    elseif message.type == "foreman_position" then
                        peers[message.foremanId] = {
                            number=message.number,
                            x=message.x,
                            z=message.z,
                            y=message.y,
                            phase=message.phase,
                            lastSeen=now()
                        }
                    elseif message.type == "move_intent" then
                        intents[message.foremanId] = {
                            number=message.number,
                            x=message.x,
                            z=message.z,
                            y=message.y,
                            lastSeen=now()
                        }
                    elseif message.type == "dock_request" and number == 1 then
                        if dock.holder == message.foremanId then
                            send(message.foremanId,{type="dock_grant"})
                        else
                            if not dockContains(message.foremanId) then
                                dock.queue[#dock.queue+1] = message.foremanId
                                saveDock()
                            end
                            grantDock()
                        end
                    elseif message.type == "dock_release" and number == 1 then
                        if dock.holder == message.foremanId then
                            dock.holder = nil
                            saveDock()
                            grantDock()
                        end
                    elseif message.type == "dock_grant" then
                        flags.dockGranted = true
                    elseif message.type == "navigator_setup_start" and number==4 and sender==cfg.controller then
                        if state.navigatorSetupDone then
                            send(cfg.controller,{
                                type="navigator_setup_done",
                                number=4,
                                id=id
                            })
                        else
                            flags.navigatorSetupStart=true
                        end
                    elseif message.type == "commission_start" and message.number == number and sender == cfg.controller then
                        if state.setupDone then
                            send(cfg.controller,{
                                type="commission_done",
                                number=number,
                                id=id
                            })
                        else
                            flags.commissionStart = true
                        end
                    elseif message.type == "start_assigned" and sender == cfg.controller then
                        flags.startMining = true
                    elseif message.type == "miner_runtime_ready" and message.row and assignedRow(message.row) then
                        state.minerIds=state.minerIds or {}
                        if not state.minerIds[message.row] or state.minerIds[message.row]==sender then
                            state.minerIds[message.row]=sender
                            saveState()
                            if state.miningStarted then
                                send(sender,{type="start_mining"})
                            end
                        end
                    elseif message.type == "commission_done" and cfg.master and message.number then
                        state.groupsCommissioned = state.groupsCommissioned or {}
                        state.groupsCommissioned[message.number] = true
                        commissionWave[message.number] = nil
                        saveState()
                        pushInbox(sender,message)
                    elseif sender==cfg.managerId and message.type == "start_mining" then
                        flags.startMining = true
                    elseif sender==cfg.managerId and message.type == "recall_command" then
                        flags.recallMode = message.mode or "NORMAL"
                    elseif sender==cfg.managerId and message.type == "resume_swarm" then
                        flags.resume=true
                    elseif sender==cfg.managerId and message.type == "status_query" then
                        sendState("")
                    else
                        pushInbox(sender,message)
                    end
                end
            elseif event[1] == "timer" and event[2] == timer then
                if now() - lastStatus >= STATUS_INTERVAL then
                    sendState("")
                end
                if cfg.master then
                    for n=2,4 do
                        if commissionWave[n] and cfg.foremen and cfg.foremen[n] then
                            if not commissionWave[n].lastSend or now() - commissionWave[n].lastSend >= 2 then
                                send(cfg.foremen[n],{type="commission_start",number=n})
                                commissionWave[n].lastSend = now()
                            end
                        end
                    end
                end
                if number == 1 and dock and dock.holder and dock.holder ~= id then
                    local holder = peers[dock.holder]
                    if not holder or now() - (holder.lastSeen or 0) > 15 then
                        dock.holder = nil
                        saveDock()
                        grantDock()
                    end
                end
                for requestId,stamp in pairs(resolved) do
                    local resolvedAt=tonumber(stamp)

                    if not resolvedAt or now()-resolvedAt>300 then
                        resolved[requestId]=nil
                    end
                end
                if now() - lastPeer >= PEER_INTERVAL then
                    broadcast({
                        type="foreman_position",
                        foremanId=id,
                        number=number,
                        x=state.x,
                        z=state.z,
                        y=state.y,
                        phase=state.phase
                    })
                    lastPeer = now()
                end
                timer = os.startTimer(1)
            end
        end
    end

    local function frontComputerId()
        local ok,id = pcall(peripheral.call,"front","getID")
        if ok then
            return tonumber(id)
        end
        return nil
    end

    local function verifyServiceMiner(req)
        if state.x~=req.row or state.z~=0 or state.y~=0 then
            state.phase="SERVICE_ALIGNMENT_ERROR"
            saveState()
            sendState("Foreman is not at Miner-" .. tostring(req.row) .. " service coordinate")
            return false
        end

        if not faceTracked(DIR_N) then
            return false
        end

        for attempt=1,3 do
            send(req.minerId,{
                type="service_probe",
                requestId=req.requestId,
                row=req.row
            })

            local _,reply=waitInbox(function(sender,m)
                return sender==req.minerId and type(m)=="table" and
                    m.type=="service_probe_ack" and m.requestId==req.requestId
            end,1)

            if reply and tonumber(reply.row)==tonumber(req.row) and
                tonumber(reply.x)==tonumber(req.row) and tonumber(reply.y)==0 and
                tonumber(reply.z)==0 and tonumber(reply.dir)==DIR_S then
                return true
            end
        end

        state.phase="SERVICE_ALIGNMENT_ERROR"
        saveState()
        sendState("Miner-" .. tostring(req.row) .. " did not confirm service position")
        return false
    end


    local function placeDriveAndDiskAt(tx,tz)
        local stagingZ=tz-1

        if state.x~=tx or state.z~=stagingZ then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Wrong staging square before installer placement")
            return false
        end

        if not ensureGroundLevel() then
            return false
        end

        faceTracked(DIR_N)
        saveState()

        if peripheral.getType("front")=="drive" then
            local reserved=state.bootstrapDrivePending and state.bootstrapDriveSlot or nil
            local slot=selfTargetSlotExcluding("disk_drive",reserved)

            if not slot then
                state.phase="PLACEMENT_ERROR"
                saveState()
                sendState("No room to recover misplaced ground Disk Drive")
                return false
            end

            turtle.select(slot)
            if not turtle.dig() then
                state.phase="PLACEMENT_ERROR"
                saveState()
                sendState("Cannot recover misplaced ground Disk Drive")
                return false
            end
            sleep(0.2)
        end

        if frontComputerId() then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Miner square already occupied")
            return false
        end

        if not ensureInstallerLevel() then
            return false
        end

        faceTracked(DIR_N)
        state.phase="PLACING_INSTALLER"
        saveState()

        if peripheral.getType("front")~="drive" then
            if turtle.detect() then
                state.phase="PLACEMENT_ERROR"
                saveState()
                sendState("Installer square blocked at relative Y 1")
                ensureGroundLevel()
                return false
            end

            local reserved=state.bootstrapDrivePending and state.bootstrapDriveSlot or nil
            local driveSlot=selfFindSlotExcluding("disk_drive",reserved)

            if not driveSlot then
                state.phase="WAITING_INSTALLER"
                saveState()
                sendState("Operational Disk Drive not found")
                ensureGroundLevel()
                return false
            end

            turtle.select(driveSlot)
            if not turtle.place() then
                state.phase="PLACEMENT_ERROR"
                saveState()
                sendState("Cannot place Disk Drive directly in front at relative Y 1")
                ensureGroundLevel()
                return false
            end
            sleep(0.2)
        end

        if state.y~=1 or peripheral.getType("front")~="drive" then
            state.phase="VERTICAL_ERROR"
            saveState()
            sendState("Disk Drive is not directly in front at installer height")
            ensureGroundLevel()
            return false
        end

        if not disk.isPresent("front") then
            if not selfSelectKind("floppy") then
                state.phase="WAITING_INSTALLER"
                saveState()
                sendState("Miner floppy not found")
                ensureGroundLevel()
                return false
            end

            if not turtle.drop(1) then
                state.phase="WAITING_INSTALLER"
                saveState()
                sendState("Cannot insert floppy into Disk Drive directly in front")
                ensureGroundLevel()
                return false
            end
            sleep(0.3)
        end

        if not disk.isPresent("front") then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Floppy verification failed at installer height")
            ensureGroundLevel()
            return false
        end

        if not ensureGroundLevel() then
            return false
        end

        faceTracked(DIR_N)
        saveState()

        if not verifyGroundFrontNoDrive() then
            state.phase="VERTICAL_ERROR"
            saveState()
            sendState("Disk Drive is at ground level; correcting placement")

            local reserved=state.bootstrapDrivePending and state.bootstrapDriveSlot or nil
            local slot=selfTargetSlotExcluding("disk_drive",reserved)
            if not slot then
                return false
            end

            turtle.select(slot)
            if not turtle.dig() then
                sendState("Cannot recover ground-level Disk Drive for correction")
                return false
            end

            if not ensureInstallerLevel() then
                return false
            end

            local driveSlot=selfFindSlotExcluding("disk_drive",reserved)
            if not driveSlot then
                ensureGroundLevel()
                return false
            end

            turtle.select(driveSlot)
            if not turtle.place() then
                ensureGroundLevel()
                return false
            end

            if peripheral.getType("front")~="drive" then
                ensureGroundLevel()
                return false
            end

            if not disk.isPresent("front") then
                if not selfSelectKind("floppy") or not turtle.drop(1) then
                    ensureGroundLevel()
                    return false
                end
            end

            if not ensureGroundLevel() then
                return false
            end

            faceTracked(DIR_N)
            if not verifyGroundFrontNoDrive() then
                state.phase="VERTICAL_ERROR"
                saveState()
                sendState("Disk Drive remained at ground level after correction")
                return false
            end
        end

        state.phase="PLACING_MINER"
        saveState()
        return state.y==0 and state.x==tx and state.z==stagingZ and state.dir==DIR_N
    end

    local function recoverInstaller(workerId,tx,tz,useBootstrapDrive)
        local stagingZ=tz-1

        if state.x~=tx or state.z~=stagingZ then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Foreman moved away before installer recovery")
            return false
        end

        if not ensureGroundLevel() then
            return false
        end

        faceTracked(DIR_N)

        if frontComputerId()~=workerId then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Assigned miner not directly in front")
            return false
        end

        if not ensureInstallerLevel() then
            return false
        end

        faceTracked(DIR_N)
        state.phase="RETRIEVING_FLOPPY"
        saveState()

        if peripheral.getType("front")~="drive" then
            state.phase="VERTICAL_ERROR"
            saveState()
            sendState("Disk Drive is not directly in front at installer height")
            ensureGroundLevel()
            return false
        end

        local floppySlot=selfTargetSlot("floppy")
        if not floppySlot then
            state.phase="WAITING_INSTALLER"
            saveState()
            sendState("No inventory room for floppy")
            ensureGroundLevel()
            return false
        end

        turtle.select(floppySlot)
        local floppyDeadline=now()+10

        while not matchesItem(selfItem(floppySlot),"floppy") and now()<floppyDeadline do
            turtle.suck(1)
            if not matchesItem(selfItem(floppySlot),"floppy") then
                sleep(0.25)
            end
        end

        if not matchesItem(selfItem(floppySlot),"floppy") then
            state.phase="WAITING_INSTALLER"
            saveState()
            sendState("Could not retrieve miner floppy")
            ensureGroundLevel()
            return false
        end

        if not ensureGroundLevel() then
            return false
        end

        faceTracked(DIR_N)

        if peripheral.getType("front")=="drive" then
            state.phase="VERTICAL_ERROR"
            saveState()
            sendState("Disk Drive detected at ground level after floppy retrieval")
            return false
        end

        if frontComputerId()~=workerId then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Assigned miner moved before Disk Drive handoff")
            return false
        end

        state.phase="WAITING_FOR_DRIVE"
        saveState()
        sendState("Waiting for miner to break Disk Drive")

        local ready=nil
        local lastRequest=0
        local lastWarning=now()

        while not ready do
            if now()-lastRequest>=1 then
                send(workerId,{type="return_installer"})
                lastRequest=now()
            end

            local _,reply=waitInbox(function(sender,m)
                return sender==workerId and type(m)=="table" and
                    (m.type=="installer_ready" or m.type=="installer_break_failed")
            end,0.5)

            if reply then
                if reply.type=="installer_ready" then
                    ready=reply
                else
                    sendState("Miner installer break retry: " .. tostring(reply.reason))
                end
            elseif now()-lastWarning>=10 then
                sendState("Still waiting for miner to break Disk Drive")
                lastWarning=now()
            end
        end

        local targetSlot=nil
        local slotCountBefore=nil
        local driveCountBefore=nil

        if useBootstrapDrive then
            targetSlot=selfEmptySlot()
            if targetSlot then
                slotCountBefore=turtle.getItemCount(targetSlot)
            end
        else
            local reserved=state.bootstrapDrivePending and state.bootstrapDriveSlot or nil
            targetSlot=selfTargetSlotExcluding("disk_drive",reserved)
            if targetSlot then
                slotCountBefore=turtle.getItemCount(targetSlot)
                driveCountBefore=selfCount("disk_drive")
            end
        end

        if not targetSlot then
            state.phase="WAITING_INSTALLER"
            saveState()
            sendState("No room for returned Disk Drive")
            return false
        end

        turtle.select(targetSlot)
        lastWarning=now()
        local driveReceived=false

        while not driveReceived do
            turtle.suck(1)
            sleep(0.1)

            local slotCountNow=turtle.getItemCount(targetSlot)

            if slotCountNow>slotCountBefore then
                driveReceived=true
            elseif not useBootstrapDrive and driveCountBefore and selfCount("disk_drive")>driveCountBefore then
                driveReceived=true
            else
                send(workerId,{type="return_installer"})

                if now()-lastWarning>=10 then
                    state.phase="WAITING_FOR_DRIVE_TRANSFER"
                    saveState()
                    sendState("Disk Drive broken but transfer to Foreman not yet confirmed")
                    lastWarning=now()
                end

                sleep(0.25)
            end
        end

        if useBootstrapDrive then
            state.bootstrapDrivePending=true
            state.bootstrapDriveSlot=targetSlot
            saveState()
        end

        state.phase="CONFIRMING_INSTALLER_HANDOFF"
        saveState()

        local returned=nil
        local lastTaken=0
        lastWarning=now()

        while not returned do
            if now()-lastTaken>=1 then
                send(workerId,{type="installer_taken"})
                lastTaken=now()
            end

            local _,reply=waitInbox(function(sender,m)
                return sender==workerId and type(m)=="table" and m.type=="installer_returned"
            end,0.5)

            if reply then
                returned=reply
            elseif now()-lastWarning>=10 then
                sendState("Disk Drive received; waiting for miner handoff acknowledgement")
                lastWarning=now()
            end
        end

        state.phase="INSTALLER_RECOVERED"
        saveState()
        return true
    end

    local function validateCommissionPackage()
        local remaining = 0
        state.commissionedRows = state.commissionedRows or {}

        for row=cfg.rowStart,cfg.rowEnd do
            if not state.commissionedRows[row] then
                remaining = remaining + 1
            end
        end

        if remaining == 0 then
            return true
        end

        if selfCount("floppy") < 1 then
            state.phase="WAITING_SUPPLIES"
            saveState()
            sendState("Missing miner floppy")
            return false
        end

        if selfCount("wireless_mining_turtle") < remaining then
            state.phase="WAITING_SUPPLIES"
            saveState()
            sendState("Missing assigned miners")
            return false
        end

        if state.commissionFuelLoaded and selfCount("coal") < WORKER_SETUP_COAL * remaining then
            state.phase="WAITING_SUPPLIES"
            saveState()
            sendState("Not enough miner commissioning fuel")
            return false
        end

        local reserved=state.bootstrapDrivePending and state.bootstrapDriveSlot or nil
        if selfCountExcluding("disk_drive",reserved) < 1 then
            state.phase="WAITING_SUPPLIES"
            saveState()
            sendState("Missing operational Disk Drive")
            return false
        end

        return true
    end

    local function commissionMiner(row,useBootstrapDrive)
        if not validateCommissionPackage() then
            return false
        end

        local targetX=row
        local targetZ=1
        local stagingZ=0
        local temporary=false

        if useBootstrapDrive then
            targetX=1
            targetZ=-1
            stagingZ=-2
            temporary=true

            if state.x~=targetX or state.z~=stagingZ then
                if not goTo(targetX,stagingZ) then
                    return false
                end
            end

            faceTracked(DIR_N)
            saveState()

            if not ensureInstallerLevel() then
                return false
            end

            faceTracked(DIR_N)

            if peripheral.getType("front")~="drive" then
                ensureGroundLevel()
                state.phase="PLACEMENT_ERROR"
                saveState()
                sendState("Bootstrap Disk Drive missing above Miner-01 pad")
                return false
            end

            if not disk.isPresent("front") then
                if not selfSelectKind("floppy") then
                    ensureGroundLevel()
                    state.phase="WAITING_INSTALLER"
                    saveState()
                    sendState("Foreman-1 bootstrap floppy missing")
                    return false
                end

                if not turtle.drop(1) then
                    ensureGroundLevel()
                    state.phase="WAITING_INSTALLER"
                    saveState()
                    sendState("Cannot insert Foreman-1 bootstrap floppy")
                    return false
                end
            end

            if not disk.isPresent("front") then
                ensureGroundLevel()
                state.phase="PLACEMENT_ERROR"
                saveState()
                sendState("Bootstrap floppy verification failed")
                return false
            end

            if not ensureGroundLevel() then
                return false
            end

            faceTracked(DIR_N)
        else
            if state.x~=targetX or state.z~=stagingZ then
                state.phase="PLACEMENT_ERROR"
                saveState()
                sendState("Foreman is not at the expected miner staging position")
                return false
            end

            if not placeDriveAndDiskAt(targetX,targetZ) then
                return false
            end
        end

        if not ensureGroundLevel() then
            return false
        end

        faceTracked(DIR_N)

        if state.x~=targetX or state.z~=stagingZ or state.y~=0 or state.dir~=DIR_N then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Wrong position or facing before miner placement")
            return false
        end

        if frontComputerId() then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Miner target already occupied")
            return false
        end

        if turtle.detect() then
            turtle.dig()
            sleep(0.2)
        end

        if turtle.detect() then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Miner target remains blocked")
            return false
        end

        if not selfSelectKind("wireless_mining_turtle") then
            state.phase="WAITING_SUPPLIES"
            saveState()
            sendState("Wireless Mining Turtle missing")
            return false
        end

        if not turtle.place() then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Cannot place Miner-" .. tostring(row))
            return false
        end

        sleep(0.2)

        local workerId=frontComputerId()
        if not workerId then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Cannot identify Miner-" .. tostring(row))
            return false
        end

        pcall(peripheral.call,"front","turnOn")

        local configurePacket={
            type="configure",
            target=workerId,
            role="miner",
            row=row,
            foremanId=id,
            foremanNumber=number,
            tempDeployment=temporary,
            managerId=cfg.managerId,
            masterForemanId=cfg.masterForemanId,
            session=cfg.session
        }

        local installed=nil
        local lastConfigure=0
        local warning=now()

        while not installed do
            if now()-lastConfigure>=1 then
                send(workerId,configurePacket)
                pcall(peripheral.call,"front","turnOn")
                lastConfigure=now()
            end

            local _,reply=waitInbox(function(sender,m)
                return sender==workerId and type(m)=="table" and m.type=="install_ok" and m.row==row
            end,0.5)

            if reply then
                installed=reply
            elseif now()-warning>=10 then
                state.phase="WAITING_MINER_BOOT"
                saveState()
                sendState("Waiting for Miner-" .. tostring(row) .. " installation")
                warning=now()
            end
        end

        if frontComputerId()~=workerId then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Miner moved before commissioning completed")
            return false
        end

        if not selfDropKind("coal",WORKER_SETUP_COAL) then
            state.phase="WAITING_FUEL"
            saveState()
            sendState("Cannot give Miner-" .. tostring(row) .. " startup coal")
            return false
        end

        local fueled=nil
        local lastFuel=0
        warning=now()

        while not fueled do
            if now()-lastFuel>=1 then
                send(workerId,{type="commission_refuel"})
                lastFuel=now()
            end

            local _,reply=waitInbox(function(sender,m)
                return sender==workerId and type(m)=="table" and m.type=="commission_refueled" and m.row==row
            end,0.5)

            if reply then
                fueled=reply
            elseif now()-warning>=10 then
                state.phase="WAITING_MINER_FUEL"
                saveState()
                sendState("Waiting for Miner-" .. tostring(row) .. " fuel confirmation")
                warning=now()
            end
        end

        if not recoverInstaller(workerId,targetX,targetZ,useBootstrapDrive) then
            return false
        end

        local deployed=nil
        local lastDeploy=0
        warning=now()

        while not deployed do
            if now()-lastDeploy>=1 then
                send(workerId,{type="deploy_miner"})
                lastDeploy=now()
            end

            local _,reply=waitInbox(function(sender,m)
                return sender==workerId and type(m)=="table" and m.row==row and
                    (m.type=="miner_deployed" or m.type=="miner_deploy_blocked")
            end,0.5)

            if reply then
                if reply.type=="miner_deployed" then
                    deployed=reply
                else
                    state.phase="MINER_DEPLOY_BLOCKED"
                    saveState()
                    sendState("Miner-" .. tostring(row) .. " deployment blocked: " .. tostring(reply.reason))
                    return false
                end
            elseif now()-warning>=10 then
                state.phase="WAITING_MINER_DEPLOY"
                saveState()
                sendState("Waiting for Miner-" .. tostring(row) .. " standby confirmation")
                warning=now()
            end
        end

        state.minerIds=state.minerIds or {}
        state.minerIds[row]=workerId

        if useBootstrapDrive then
            state.firstInstallerRecovered=true
        end

        faceTracked(DIR_N)
        state.phase="MINER_COMMISSIONED"
        saveState()
        return true
    end

    local function returnInstaller()
        local reserved=state.bootstrapDrivePending and state.bootstrapDriveSlot or nil

        if selfCountExcluding("disk_drive",reserved)==0 and selfCount("floppy")==0 then
            return true
        end

        if not atSupply() then
            return false
        end

        while selfCountExcluding("disk_drive",reserved)>0 do
            local slot=selfFindSlotExcluding("disk_drive",reserved)
            if not slot then
                break
            end
            turtle.select(slot)
            if not turtle.drop() then
                state.phase="DOCK_BLOCKED"
                saveState()
                sendState("Cannot return operational Disk Drive")
                return false
            end
        end

        while selfCount("floppy")>0 do
            local slot=selfFindSlot("floppy")
            if not slot then
                break
            end
            turtle.select(slot)
            if not turtle.drop() then
                state.phase="DOCK_BLOCKED"
                saveState()
                sendState("Cannot return floppy")
                return false
            end
        end

        return exitDockHome()
    end

    local function returnUnusedFuel()
        useOwnFuel()
        if not atFuel() then
            return false
        end

        while selfCount("coal") > 0 do
            local slot = selfFindSlot("coal")
            if not slot then
                break
            end
            turtle.select(slot)
            if not turtle.drop() then
                state.phase="DOCK_BLOCKED"
                saveState()
                sendState("Cannot return unused fuel; dock token retained")
                return false
            end
        end

        return exitDockHome()
    end

    local function returnSetupResources()
        local reserved=state.bootstrapDrivePending and state.bootstrapDriveSlot or nil

        useOwnFuel()

        if not atFuel() then
            return false
        end

        while selfCount("coal")>0 do
            local slot=selfFindSlot("coal")

            if not slot then
                break
            end

            turtle.select(slot)

            if not turtle.drop() then
                state.phase="DOCK_BLOCKED"
                saveState()
                sendState("Cannot return unused fuel; dock token retained")
                return false
            end
        end

        if not goDockBypass(0) then
            return false
        end

        if not faceTracked(DIR_N) or not verifyDockInventory("supply") then
            return false
        end

        while selfCountExcluding("disk_drive",reserved)>0 do
            local slot=selfFindSlotExcluding("disk_drive",reserved)

            if not slot then
                break
            end

            turtle.select(slot)

            if not turtle.drop() then
                state.phase="DOCK_BLOCKED"
                saveState()
                sendState("Cannot return operational Disk Drive")
                return false
            end
        end

        while selfCount("floppy")>0 do
            local slot=selfFindSlot("floppy")

            if not slot then
                break
            end

            turtle.select(slot)

            if not turtle.drop() then
                state.phase="DOCK_BLOCKED"
                saveState()
                sendState("Cannot return floppy")
                return false
            end
        end

        return exitDockHome()
    end

    local function loadCommissionFuel()
        state.commissionedRows = state.commissionedRows or {}

        local remaining = 0
        for row=cfg.rowStart,cfg.rowEnd do
            if not state.commissionedRows[row] then
                remaining = remaining + 1
            end
        end

        if remaining == 0 then
            return true
        end

        if state.commissionFuelLoaded then
            return true
        end

        if not atFuel() then
            return false
        end

        if not refuelAtFrontTo(FOREMAN_FUEL_TARGET) then
            state.phase="WAITING_FUEL"
            saveState()
            sendState("Fuel chest cannot satisfy foreman fuel target; dock token retained")
            return false
        end

        local needed = WORKER_SETUP_COAL * 4
        local pulled = takeNamedIntoSelf("coal",needed)

        if pulled < needed then
            state.phase="WAITING_FUEL"
            saveState()
            sendState("Need 60 coal for assigned miners")
            return false
        end

        state.commissionFuelLoaded=true
        saveState()

        return leaveDockJunction()
    end

    local function navigatorVertical(targetY)
        if number~=4 or targetY<0 or targetY>15 then
            return false
        end

        while state.y<targetY do
            local intent={
                seq=state.seq+1,
                from=state.y,
                to=state.y+1,
                fuelBefore=turtle.getFuelLevel()
            }
            state.verticalIntent=intent
            saveState()

            if not turtle.up() then
                state.verticalIntent=nil
                saveState()
                return false
            end

            state.y=intent.to
            state.seq=intent.seq
            checkpointForeman()
            state.verticalIntent=nil
            saveState()
        end

        while state.y>targetY do
            local intent={
                seq=state.seq+1,
                from=state.y,
                to=state.y-1,
                fuelBefore=turtle.getFuelLevel()
            }
            state.verticalIntent=intent
            saveState()

            if not turtle.down() then
                state.verticalIntent=nil
                saveState()
                return false
            end

            state.y=intent.to
            state.seq=intent.seq
            checkpointForeman()
            state.verticalIntent=nil
            saveState()
        end

        return state.y==targetY
    end

    local function navigatorForward(targetDir)
        if number~=4 or not faceTracked(targetDir) then
            return false
        end

        local tx=state.x
        local tz=state.z

        if targetDir==DIR_N then
            tz=tz+1
        elseif targetDir==DIR_E then
            tx=tx+1
        elseif targetDir==DIR_S then
            tz=tz-1
        else
            tx=tx-1
        end

        if tx<-1 or tx>16 or tz<-5 or tz>14 or state.y<10 or state.y>15 then
            return false
        end

        local intent={
            seq=state.seq+1,
            fuelBefore=turtle.getFuelLevel(),
            from={x=state.x,z=state.z,y=state.y,dir=state.dir},
            to={x=tx,z=tz,y=state.y,dir=state.dir}
        }

        state.motionIntent=intent
        saveState()

        if not turtle.forward() then
            state.motionIntent=nil
            saveState()
            return false
        end

        state.x=tx
        state.z=tz
        state.seq=intent.seq
        checkpointForeman()
        state.motionIntent=nil
        saveState()
        return true
    end

    local function navigatorGoTo(tx,ty,tz)
        if number~=4 then
            return false
        end

        if state.y<10 then
            if not navigatorVertical(10) then return false end
        end

        while state.x<tx do
            if not navigatorForward(DIR_E) then return false end
        end
        while state.x>tx do
            if not navigatorForward(DIR_W) then return false end
        end
        while state.z<tz do
            if not navigatorForward(DIR_N) then return false end
        end
        while state.z>tz do
            if not navigatorForward(DIR_S) then return false end
        end

        return navigatorVertical(ty)
    end

    local function loadNavigatorSupplies()
        if number~=4 then
            return false
        end

        if selfCount("computer")>=4 and selfCount("wireless_modem")>=4 and
            selfCount("disk_drive")>=4 then
            return true
        end

        if not atSupply() then
            return false
        end

        local needComputers=4-selfCount("computer")
        if needComputers>0 and takeNamedIntoSelf("computer",needComputers)<needComputers then
            state.phase="WAITING_NAVIGATOR_SUPPLIES"
            saveState()
            sendState("Need 4 regular Computers in the supply chest")
            return false
        end

        local needModems=4-selfCount("wireless_modem")
        if needModems>0 and takeNamedIntoSelf("wireless_modem",needModems)<needModems then
            state.phase="WAITING_NAVIGATOR_SUPPLIES"
            saveState()
            sendState("Need 4 Wireless Modems in the supply chest")
            return false
        end

        local needDrives=4-selfCount("disk_drive")
        if needDrives>0 and takeNamedIntoSelf("disk_drive",needDrives)<needDrives then
            state.phase="WAITING_NAVIGATOR_SUPPLIES"
            saveState()
            sendState("Need 4 additional Disk Drives in the supply chest")
            return false
        end

        return exitDockHome()
    end

    local function deployNavigator(navNumber)
        local site=NAVIGATOR_SITES[navNumber]
        if not site then return false end

        local sx=site.x
        local sz=site.z-1

        if not navigatorGoTo(sx,site.y,sz) then
            return false
        end

        if not navigatorVertical(site.y-1) then
            return false
        end

        if peripheral.getType("front")~="drive" then
            if turtle.detect() then
                return false
            end
            if not selfSelectKind("disk_drive") or not turtle.place() then
                return false
            end
            sleep(0.2)
        end

        if not disk.isPresent("front") then
            if not selfSelectKind("floppy") or not turtle.drop(1) then
                return false
            end
            sleep(0.3)
        end

        if not disk.isPresent("front") then
            return false
        end

        if not navigatorVertical(site.y) then
            return false
        end

        if not faceTracked(DIR_N) then
            return false
        end

        if frontComputerId() then
            return false
        end

        if turtle.detect() then
            return false
        end

        if not selfSelectKind("computer") or not turtle.place() then
            return false
        end

        sleep(0.2)

        local navigatorId=frontComputerId()
        if not navigatorId then
            return false
        end

        if not navigatorVertical(site.y+1) then
            return false
        end

        if turtle.detect() then
            return false
        end

        if not selfSelectKind("wireless_modem") or not turtle.place() then
            return false
        end

        sleep(0.2)

        if not navigatorVertical(site.y) then
            return false
        end

        pcall(peripheral.call,"front","turnOn")

        local packet={
            type="configure",
            target=navigatorId,
            role="navigator",
            number=navNumber,
            managerId=cfg.managerId,
            masterForemanId=cfg.masterForemanId,
            session=cfg.session
        }

        local installed=false
        local lastConfigure=0
        local deadline=now()+30

        while not installed and now()<deadline do
            if now()-lastConfigure>=1 then
                send(navigatorId,packet)
                pcall(peripheral.call,"front","turnOn")
                lastConfigure=now()
            end

            local _,reply=waitInbox(function(sender,m)
                return sender==navigatorId and type(m)=="table" and
                    m.type=="install_ok" and m.role=="navigator" and
                    tonumber(m.number)==navNumber
            end,0.5)

            if reply then
                installed=true
            end
        end

        if not installed then
            return false
        end

        return true
    end

    local function setupNavigators()
        if number~=4 then return false end

        state.navigatorSetupActive=true
        state.navigatorsReady=state.navigatorsReady or {}
        state.phase="NAVIGATOR_SETUP"
        saveState()
        sendState("Preparing GPS Navigators")

        if not state.navigatorSuppliesLoaded then
            if not loadNavigatorSupplies() then
                return false
            end
            state.navigatorSuppliesLoaded=true
            saveState()
        end

        local order={1,2,4,3}

        for _,navNumber in ipairs(order) do
            if not state.navigatorsReady[navNumber] then
                state.phase="NAVIGATOR_" .. tostring(navNumber)
                saveState()
                sendState("Deploying Navigator-" .. tostring(navNumber))

                if not deployNavigator(navNumber) then
                    state.phase="NAVIGATOR_SETUP_BLOCKED"
                    saveState()
                    sendState("Navigator-" .. tostring(navNumber) .. " deployment blocked")
                    return false
                end

                state.navigatorsReady[navNumber]=true
                saveState()
            end
        end

        if state.y<10 then
            if not navigatorVertical(10) then return false end
        end

        if not navigatorGoTo(0,10,-5) then
            return false
        end

        if not navigatorVertical(0) then
            return false
        end

        if not faceTracked(DIR_N) then
            return false
        end

        state.navigatorSetupActive=false
        state.navigatorSetupDone=true
        state.navigatorSuppliesLoaded=nil
        state.phase="IDLE"
        saveState()
        checkpointForeman()
        sendState("GPS Navigator deployment complete")

        for i=1,3 do
            send(cfg.controller,{
                type="navigator_setup_done",
                number=4,
                id=id
            })
            send(cfg.managerId,{
                type="navigator_setup_done",
                number=4,
                id=id,
                session=cfg.session
            })
            sleep(0.1)
        end

        return true
    end

    local function commissionAssigned()
        state.phase="COMMISSIONING"
        state.commissionedRows = state.commissionedRows or {}
        saveState()
        sendState("Collecting miner startup fuel")

        if not loadCommissionFuel() then
            return false
        end

        sendState("Commissioning assigned miners")

        if not validateCommissionPackage() then
            return false
        end

        local first=cfg.rowStart
        local last=cfg.rowEnd
        local firstPending=nil

        for row=first,last do
            if not state.commissionedRows[row] then
                firstPending=row
                break
            end
        end

        if firstPending then
            local firstIsBootstrap=number==1 and firstPending==1 and not state.firstInstallerRecovered

            if not firstIsBootstrap then
                local laneZ=privateLaneZ()

                if state.z~=laneZ then
                    if not goTo(state.x,laneZ) then
                        return false
                    end
                end

                if state.x~=firstPending then
                    if not goTo(firstPending,laneZ) then
                        return false
                    end
                end

                if state.z~=0 then
                    if not goTo(firstPending,0) then
                        return false
                    end
                end

                faceTracked(DIR_N)
                saveState()
            end
        end

        for row=first,last do
            if flags.recallMode then
                return false
            end

            if not state.commissionedRows[row] then
                local useBootstrapDrive=number==1 and row==1 and not state.firstInstallerRecovered

                if useBootstrapDrive then
                    if not commissionMiner(row,true) then
                        return false
                    end
                else
                    if state.x~=row or state.z~=0 then
                        if not goTo(row,0) then
                            return false
                        end
                        faceTracked(DIR_N)
                        saveState()
                    end

                    if not commissionMiner(row,false) then
                        return false
                    end
                end

                state.commissionedRows[row]=true
                saveState()

                if row<last then
                    local nextRow=row+1

                    local laneZ=privateLaneZ()

                    if state.z~=laneZ then
                        if not goTo(state.x,laneZ) then
                            return false
                        end
                    end

                    if state.x~=nextRow then
                        if not goTo(nextRow,laneZ) then
                            return false
                        end
                    end

                    if state.z~=0 then
                        if not goTo(nextRow,0) then
                            return false
                        end
                    end

                    faceTracked(DIR_N)
                    saveState()

                    if state.x~=nextRow or state.z~=0 or state.dir~=DIR_N then
                        state.phase="PLACEMENT_ERROR"
                        saveState()
                        sendState("Could not stage for next miner")
                        return false
                    end
                end
            end
        end

        if not returnSetupResources() then
            return false
        end

        state.commissionFuelLoaded=false
        state.setupDone=true
        state.phase="IDLE"
        saveState()
        returnHome()
        for i=1,3 do
            send(cfg.controller,{
                type="commission_done",
                number=number,
                id=id
            })
            sleep(0.1)
        end
        sendState("Miner setup complete")
        return true
    end

    local function ensureMasterSeedFuel()
        if turtle.getFuelLevel() == "unlimited" or turtle.getFuelLevel() > 0 then
            return true
        end

        while turtle.getFuelLevel() ~= "unlimited" and turtle.getFuelLevel() <= 0 do
            local slot = selfFindSlot("coal")
            if slot then
                turtle.select(slot)
                if not turtle.refuel(1) then
                    slot = nil
                end
            end

            if not slot then
                state.phase="WAITING_SEED_FUEL"
                saveState()
                sendState("Place one coal or charcoal anywhere in Foreman-1 inventory")
                clearAndPrint({
                    "Mine v30 Foreman-1",
                    "",
                    "Seed fuel required.",
                    "Place coal or charcoal",
                    "anywhere in inventory.",
                    "Setup resumes automatically."
                })
                sleep(1)
            end
        end

        state.phase="MASTER_SETUP"
        saveState()
        return true
    end

    local function masterFuelAndLoadCoal()
        if not goTo(-2,0) then
            return false
        end

        faceTracked(DIR_N)

        if not refuelAtFrontTo(FOREMAN_FUEL_TARGET) then
            return false
        end

        local needed = 212 - selfCount("coal")
        if needed > 0 then
            if takeNamedIntoSelf("coal",needed) < needed then
                return false
            end
        end

        return true
    end

    local function masterLoadSupplies()
        if not goTo(0,0) then
            return false
        end

        faceTracked(DIR_N)

        local needDrives = 5 - selfCount("disk_drive")
        if needDrives > 0 and takeNamedIntoSelf("disk_drive",needDrives) < needDrives then
            return false
        end

        local needMiners = 16 - selfCount("wireless_mining_turtle")
        if needMiners > 0 and takeNamedIntoSelf("wireless_mining_turtle",needMiners) < needMiners then
            return false
        end

        local needForemen = 3 - selfCount("narcissistic_wireless_turtle")
        if needForemen > 0 and takeNamedIntoSelf("narcissistic_wireless_turtle",needForemen) < needForemen then
            return false
        end

        local needNavigators = 4 - selfCount("advanced_wireless_turtle")
        if needNavigators > 0 and takeNamedIntoSelf("advanced_wireless_turtle",needNavigators) < needNavigators then
            return false
        end

        local needFloppies = 4 - selfCount("floppy")
        if needFloppies > 0 and takeNamedIntoSelf("floppy",needFloppies) < needFloppies then
            return false
        end

        return true
    end

    local function masterPlaceBootstrapInstaller()
        if selfCount("disk_drive")<1 or selfCount("floppy")<1 then
            return false
        end

        if not goTo(1,-2) then
            return false
        end

        if not ensureGroundLevel() then
            return false
        end

        faceTracked(DIR_N)
        saveState()

        if peripheral.getType("front")=="drive" then
            local slot=selfTargetSlot("disk_drive")
            if not slot then
                return false
            end
            turtle.select(slot)
            if not turtle.dig() then
                state.phase="PLACEMENT_ERROR"
                saveState()
                sendState("Cannot remove misplaced ground bootstrap Disk Drive")
                return false
            end
        elseif frontComputerId() then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Bootstrap pad occupied by a turtle")
            return false
        elseif turtle.detect() then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Bootstrap pad blocked at ground level")
            return false
        end

        if not ensureInstallerLevel() then
            return false
        end

        faceTracked(DIR_N)

        if peripheral.getType("front")~="drive" then
            if turtle.detect() then
                state.phase="PLACEMENT_ERROR"
                saveState()
                sendState("Bootstrap installer square blocked at relative Y 1")
                ensureGroundLevel()
                return false
            end

            if not selfSelectKind("disk_drive") then
                ensureGroundLevel()
                return false
            end

            if not turtle.place() then
                ensureGroundLevel()
                return false
            end
            sleep(0.2)
        end

        if peripheral.getType("front")~="drive" then
            state.phase="VERTICAL_ERROR"
            saveState()
            sendState("Bootstrap Disk Drive is not directly in front at installer height")
            ensureGroundLevel()
            return false
        end

        if not disk.isPresent("front") then
            if not selfSelectKind("floppy") then
                ensureGroundLevel()
                return false
            end

            if not turtle.drop(1) then
                ensureGroundLevel()
                return false
            end
            sleep(0.3)
        end

        if not disk.isPresent("front") then
            ensureGroundLevel()
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Bootstrap floppy verification failed")
            return false
        end

        if not ensureGroundLevel() then
            return false
        end

        faceTracked(DIR_N)

        if peripheral.getType("front")=="drive" then
            state.phase="VERTICAL_ERROR"
            saveState()
            sendState("Bootstrap Disk Drive detected at ground level")
            return false
        end

        saveState()
        return true
    end

    local function masterCommissionNavigator(n)
        if selfCount("advanced_wireless_turtle")<1 or selfCount("coal")<5 then
            return nil
        end

        if not goTo(1,-2) then
            return nil
        end

        if not ensureGroundLevel() then
            return nil
        end

        faceTracked(DIR_N)
        saveState()

        if state.dir~=DIR_N then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Master Foreman is not north-facing before Navigator placement")
            return nil
        end

        if frontComputerId() then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Navigator bootstrap position occupied")
            return nil
        end

        if not selfSelectKind("advanced_wireless_turtle") then
            return nil
        end

        if not turtle.place() then
            return nil
        end

        sleep(0.2)

        local newId=frontComputerId()
        if not newId then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Cannot identify Navigator-" .. tostring(n))
            return nil
        end

        pcall(peripheral.call,"front","turnOn")

        local packet={
            type="configure",
            target=newId,
            role="navigator",
            number=n,
            managerId=cfg.managerId,
            masterForemanId=cfg.masterForemanId,
            session=cfg.session
        }

        local installed=nil
        local lastConfigure=0

        while not installed do
            if flags.recallMode then return nil end

            if now()-lastConfigure>=1 then
                send(newId,packet)
                pcall(peripheral.call,"front","turnOn")
                lastConfigure=now()
            end

            local _,reply=waitInbox(function(sender,m)
                return sender==newId and type(m)=="table" and
                    m.type=="install_ok" and m.role=="navigator" and tonumber(m.number)==n
            end,0.5)

            if reply then

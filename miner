local function runMinerCommissioning(cfg)
    setRegionalManager(cfg.managerId)
    if not openNetwork() then
        error("Wireless modem not found")
    end
    ensureManagerRegistration(cfg)

    local initialDir=DIR_N

    local state=loadTableLight("miner.tmp")
    if state then
        state.lastPackSend=nil
        state.lastPackAssetSend=nil
    end
    state=state or {
        row=cfg.row,
        depth=0,
        pos=0,
        dir=initialDir,
        phase="COMMISSIONING",
        request=nil,
        requestSeq=0,
        resumeDepth=0,
        resumePos=0,
        resumeDir=DIR_N,
        complete=false,
        installerHeld=false,
        installerFuelSlot=nil,
        orientationTurns=0,
        orientationTurnIntent=nil,
        orientationCalibrated=false
    }

    local bootHadIntent=state.motionIntent or state.orientationTurnIntent or state.recoveryProbeIntent

    state.row=cfg.row
    state.phase="COMMISSIONING"
    state.seq=tonumber(state.seq) or 0
    state.tempSteps=tonumber(state.tempSteps) or 0

    if state.motionIntent and state.motionIntent.kind=="temp_forward" then
        local monitorState,monitorSeq=requestPoseBackup("miner",5,cfg.session)
        local intentSeq=tonumber(state.motionIntent.seq) or (state.seq+1)

        if monitorState and tonumber(monitorSeq or monitorState.seq or 0)>=intentSeq and monitorState.tempSteps then
            state.tempSteps=monitorState.tempSteps
            state.seq=tonumber(monitorState.seq) or intentSeq
            state.motionIntent=nil
        else
            local fuelNow=turtle.getFuelLevel()
            local fuelBefore=state.motionIntent.fuelBefore
            local moved=movementFromFuel(fuelBefore,fuelNow)
            if moved~=nil then
                if moved then
                    state.tempSteps=state.motionIntent.toStep
                    state.seq=intentSeq
                else
                    state.tempSteps=state.motionIntent.fromStep
                end
                state.motionIntent=nil
            else
                state.recoveryLocked=true
                state.recoveryReason="Temporary Miner-01 position ambiguous after restart"
            end
        end
    end

    if state.recoveryProbeIntent and not state.recoveryLocked then
        local recoveredDir,recoveryReason=recoverFacingByGPS(state,cfg.worldOrigin,function()
            state.fuelWitness=turtle.getFuelLevel()
            return saveTableLight("miner.tmp",state)
        end)
        if recoveredDir~=nil then
            state.dir=recoveredDir
            state.orientationCalibrated=false
            state.orientationAnchor=nil
            state.recoveryReason=nil
        else
            state.recoveryLocked=true
            state.recoveryReason="Interrupted deployment orientation recovery failed: "..tostring(recoveryReason)
            state.phase="RECOVERY_LOCK"
        end
    end

    if bootHadIntent and not state.recoveryLocked and
        not state.motionIntent and not state.orientationTurnIntent and
        not state.recoveryProbeIntent then
        state.fuelWitness=turtle.getFuelLevel()
    end
    if not saveTableLight("miner.tmp",state) then error("Miner commissioning state write failed") end

    if not state.recoveryLocked then
        local verified,reason=verifyBootWitness(state,cfg.worldOrigin,bootHadIntent)
        if not verified then
            state.recoveryLocked=true
            state.recoveryReason=reason
            state.phase="RECOVERY_LOCK"
            saveTableLight("miner.tmp",state)
        end
    end

    local function save()
        state.fuelWitness=turtle.getFuelLevel()
        if not saveTableLight("miner.tmp",state) then
            error("Miner commissioning state write failed; movement halted")
        end
    end

    local function ack(packet)
        for i=1,3 do
            send(cfg.foremanId,packet)
            sleep(0.1)
        end
    end

    local function temporarySlot()
        if state.installerFuelSlot and state.installerFuelSlot>=2 and state.installerFuelSlot<=16 then
            return state.installerFuelSlot
        end

        for slot=16,2,-1 do
            if turtle.getItemCount(slot)==0 then
                return slot
            end
        end

        return nil
    end

    local function establishPlacedMinerNorth()
        if state.orientationCalibrated and not state.orientationTurnIntent and
            state.dir==DIR_N and state.orientationAnchor=="FOREMAN_BACK" then
            return true
        end

        state.orientationCalibrated=false
        state.orientationAnchor=nil
        state.orientationTurnIntent=nil
        state.orientationTurns=0
        state.chunkIndex=tonumber(state.chunkIndex) or 0
        state.x=cfg.row
        state.y=0
        state.z=0
        state.depth=0
        state.pos=0
        save()

        local recoveredDir=nil
        if state.recoveryProbeIntent then
            local pendingReason=nil
            recoveredDir,pendingReason=recoverFacingByGPS(state,cfg.worldOrigin,function()
                return save()
            end)
            if recoveredDir==nil then
                state.recoveryReason="Miner deployment GPS recovery failed: "..tostring(pendingReason)
                save()
                return false
            end
        end

        local expected=cfg.placementGps
        if type(expected)~="table" then
            state.recoveryReason="Miner placement GPS anchor is missing"
            save()
            return false
        end
        local valid,reason=verifyWorldPlacement(expected)
        if not valid then
            state.recoveryReason="Miner placement GPS verification failed: "..tostring(reason)
            save()
            return false
        end

        if recoveredDir==nil then
            local facingReason=nil
            recoveredDir,facingReason=recoverFacingByGPS(state,cfg.worldOrigin,function()
                return save()
            end)
            if recoveredDir==nil then
                state.recoveryReason="Miner deployment GPS orientation failed: "..tostring(facingReason)
                save()
                return false
            end
        end

        state.dir=recoveredDir
        save()

        while state.dir~=DIR_N do
            local intent={from=state.dir,to=(state.dir+1)%4}
            state.orientationTurnIntent=intent
            save()
            if not turtle.turnRight() then
                state.orientationTurnIntent=nil
                state.recoveryReason="Could not rotate Miner-"..tostring(cfg.row).." to north after GPS orientation"
                save()
                return false
            end
            state.dir=intent.to
            state.orientationTurns=(tonumber(state.orientationTurns) or 0)+1
            state.orientationTurnIntent=nil
            save()
        end

        local finalValid,finalReason=verifyWorldPlacement(expected)
        if not finalValid then
            state.recoveryReason="Miner moved away from placement during GPS orientation: "..tostring(finalReason)
            save()
            return false
        end

        state.dir=DIR_N
        state.orientationAnchor="FOREMAN_BACK"
        state.orientationCalibrated=true
        state.recoveryLocked=false
        state.recoveryReason=nil
        save()
        return true
    end

    local function faceCommissioning(target)
        if not state.orientationCalibrated then
            if not establishPlacedMinerNorth() then return false end
        end
        while state.dir~=target do
            local intent={from=state.dir,to=(state.dir+1)%4}
            state.orientationTurnIntent=intent
            save()
            if not turtle.turnRight() then
                state.orientationTurnIntent=nil
                save()
                return false
            end
            state.dir=intent.to
            state.orientationTurnIntent=nil
            save()
        end
        return true
    end

    status("miner","COMMISSIONING",{
        row=cfg.row,
        foreman=cfg.foremanNumber,
        message=state.installerHeld and "Holding Disk Drive" or "Waiting for assigned foreman",
        session=cfg.session
    })

    while true do
        local sender,message=rednet.receive(PROTOCOL,1)

        if sender==cfg.managerId and type(message)=="table" and message.session==cfg.session then
            if message.type=="status_query" then
                status("miner","COMMISSIONING",{
                    row=cfg.row,
                    foreman=cfg.foremanNumber,
                    message=state.installerHeld and "Holding Disk Drive" or "Commissioning",
                    session=cfg.session
                })
            elseif message.type=="maintenance_clear_label" and message.session==cfg.session then
                local before=os.getComputerLabel()
                os.setComputerLabel(nil)
                send(sender,{
                    type="maintenance_label_cleared",
                    row=cfg.row,
                    id=os.getComputerID(),
                    before=before,
                    cleared=os.getComputerLabel()==nil,
                    session=cfg.session
                })
            elseif message.type=="service_complete" and state.request and message.requestId==state.request.id then
                local wasDump=state.request.recallDump and true or false
                state.lastCompletedRequest=state.request.id
                state.request=nil
                save()
                send(cfg.managerId,{type="service_complete_ack",requestId=message.requestId,session=cfg.session})
                if wasDump and state.phase=="RECALLED_PAUSED" then
                    faceCommissioning(DIR_N)
                    send(cfg.managerId,{
                        type="recall_dump_empty",
                        role="miner",
                        row=cfg.row,
                        id=os.getComputerID(),
                        x=state.x or cfg.homeX,
                        y=state.y or cfg.homeY,
                        z=state.z or cfg.homeZ,
                        dir=state.dir or cfg.homeDir,
                        session=cfg.session
                    })
                end
            elseif message.type=="service_complete" and message.requestId==state.lastCompletedRequest then
                send(cfg.managerId,{type="service_complete_ack",requestId=message.requestId,session=cfg.session})
            elseif message.type=="recall_command" then
                local mode=message.mode or "NORMAL"

                if state.phase=="RECALLED_PAUSED" and state.recallMode==mode then
                    send(cfg.managerId,{
                        type="recall_home",
                        role="miner",
                        row=cfg.row,
                        id=os.getComputerID(),
                        mode=mode,
                        labelCleared=false,
                        x=state.x or cfg.homeX,
                        y=state.y or cfg.homeY,
                        z=state.z or cfg.homeZ,
                        dir=state.dir or cfg.homeDir,
                        session=cfg.session
                    })
                    if mode=="DUMP" and state.request then
                        send(cfg.managerId,{
                            type="service_arrived",
                            row=cfg.row,
                            requestId=state.request.id,
                            service="DUMP",
                            minerId=os.getComputerID(),
                            foremanId=cfg.foremanId,
                            foremanNumber=cfg.foremanNumber,
                            fuel=turtle.getFuelLevel(),
                            x=state.x or cfg.homeX,
                            y=state.y or cfg.homeY,
                            z=state.z or cfg.homeZ,
                            dir=state.dir or cfg.homeDir,
                            session=cfg.session
                        })
                    elseif mode=="DUMP" and not state.request then
                        send(cfg.managerId,{
                            type="recall_dump_empty",
                            role="miner",
                            row=cfg.row,
                            id=os.getComputerID(),
                            x=state.x or cfg.homeX,
                            y=state.y or cfg.homeY,
                            z=state.z or cfg.homeZ,
                            dir=state.dir or cfg.homeDir,
                            session=cfg.session
                        })
                    end
                elseif mode=="SHUTDOWN" then
                    faceCommissioning(DIR_N)
                    state.recallMode=mode
                    save()
                    for i=1,5 do
                        os.setComputerLabel(nil)
                        if os.getComputerLabel()==nil then break end
                        sleep(0.1)
                    end
                    send(cfg.managerId,{
                        type="recall_home",
                        role="miner",
                        row=cfg.row,
                        id=os.getComputerID(),
                        mode=mode,
                        labelCleared=os.getComputerLabel()==nil,
                        x=state.x or cfg.homeX,
                        y=state.y or cfg.homeY,
                        z=state.z or cfg.homeZ,
                        dir=state.dir or cfg.homeDir,
                        session=cfg.session
                    })
                    for shutdownAttempt=1,8 do
                        send(cfg.managerId,{
                            type="recall_shutdown_ready",
                            role="miner",
                            row=cfg.row,
                            id=os.getComputerID(),
                            x=state.x or cfg.homeX,
                            y=state.y or cfg.homeY,
                            z=state.z or cfg.homeZ,
                            dir=state.dir or cfg.homeDir,
                            session=cfg.session
                        })
                        sleep(0.1)
                    end
                    os.shutdown()
                elseif mode=="NORMAL" then
                    if not faceCommissioning(DIR_N) then
                        state.phase="RECOVERY_LOCK"
                        save()
                    else
                        state.phase="RECALLED_PAUSED"
                        state.recallMode=mode
                        save()
                        send(cfg.managerId,{
                            type="recall_home",
                            role="miner",
                            row=cfg.row,
                            id=os.getComputerID(),
                            mode=mode,
                            labelCleared=false,
                            x=state.x or cfg.homeX,
                            y=state.y or cfg.homeY,
                            z=state.z or cfg.homeZ,
                            dir=state.dir or cfg.homeDir,
                            session=cfg.session
                        })
                    end
                elseif mode=="DUMP" then
                    if not faceCommissioning(DIR_S) then
                        state.phase="RECOVERY_LOCK"
                        save()
                    else
                        state.phase="RECALLED_PAUSED"
                        state.recallMode=mode
                        if not state.request then
                            state.requestSeq=(state.requestSeq or 0)+1
                            state.request={
                                id=tostring(os.getComputerID()) .. ":commission_dump:" .. tostring(state.requestSeq),
                                kind="DUMP",
                                recallDump=true
                            }
                        end
                        save()
                        send(cfg.managerId,{
                            type="recall_home",
                            role="miner",
                            row=cfg.row,
                            id=os.getComputerID(),
                            mode=mode,
                            labelCleared=false,
                            x=state.x or cfg.homeX,
                            y=state.y or cfg.homeY,
                            z=state.z or cfg.homeZ,
                            dir=state.dir or DIR_S,
                            session=cfg.session
                        })
                        send(cfg.managerId,{
                            type="service_arrived",
                            row=cfg.row,
                            requestId=state.request.id,
                            service="DUMP",
                            minerId=os.getComputerID(),
                            foremanId=cfg.foremanId,
                            foremanNumber=cfg.foremanNumber,
                            fuel=turtle.getFuelLevel(),
                            x=state.x or cfg.homeX,
                            y=state.y or cfg.homeY,
                            z=state.z or cfg.homeZ,
                            dir=state.dir or DIR_S,
                            session=cfg.session
                        })
                    end
                end
            elseif message.type=="resume_swarm" and state.phase=="RECALLED_PAUSED" then
                state.phase="COMMISSIONING"
                state.recallMode=nil
                save()
            end

        elseif sender==cfg.foremanId and type(message)=="table" then
            if message.type=="service_probe" and state.request and message.requestId==state.request.id then
                if faceCommissioning(DIR_S) then
                    send(cfg.foremanId,{
                        type="service_probe_ack",
                        requestId=message.requestId,
                        row=cfg.row,
                        x=state.x or cfg.homeX,
                        y=state.y or cfg.homeY,
                        z=state.z or cfg.homeZ,
                        dir=DIR_S
                    })
                end
            elseif state.phase=="RECALLED_PAUSED" then
                if message.type=="status_query" then
                    status("miner","RECALLED_PAUSED",{
                        row=cfg.row,
                        foreman=cfg.foremanNumber,
                        message="Commissioning paused by Regional Manager",
                        session=cfg.session
                    })
                end
            elseif message.type=="commission_refuel" then
                local burned=state.commissionBucketSlots or {}
                for slot=1,16 do
                    turtle.select(slot)
                    while turtle.getFuelLevel()~="unlimited" and
                        turtle.getFuelLevel()<MINER_FUEL_TARGET and
                        turtle.getItemCount(slot)>0 and turtle.refuel(0) do
                        if not turtle.refuel(1) then break end
                        if message.fuelKind=="lava_bucket" then
                            burned[slot]=true
                            state.commissionBucketSlots=burned
                            save()
                        end
                    end
                end
                local bucketCount=0
                if message.fuelKind=="lava_bucket" then
                    for slot=1,16 do
                        turtle.select(slot)
                        if turtle.getItemCount(slot)>0 and not turtle.refuel(0) then
                            local detail=turtle.getItemDetail and turtle.getItemDetail(slot)
                            if matchesItem(detail,"empty_bucket") or
                                (not detail and burned[slot]) then
                                bucketCount=bucketCount+turtle.getItemCount(slot)
                            end
                        end
                    end
                end
                turtle.select(1)
                ack({
                    type="commission_refueled",
                    bucketPresent=bucketCount>0,
                    bucketCount=bucketCount,
                    id=os.getComputerID(),
                    row=cfg.row,
                    fuel=turtle.getFuelLevel()
                })

            elseif message.type=="return_installer" then
                if not state.installerHeld then
                    turtle.select(1)

                    if turtle.getItemCount(1)>0 then
                        local slot=temporarySlot()

                        if not slot then
                            send(cfg.foremanId,{
                                type="installer_break_failed",
                                id=os.getComputerID(),
                                row=cfg.row,
                                reason="no_empty_slot"
                            })
                        else
                            state.installerFuelSlot=slot
                            turtle.transferTo(slot)
                            save()
                        end
                    end

                    if turtle.getItemCount(1)==0 then
                        turtle.select(1)

                        if turtle.digUp() then
                            state.installerHeld=true
                            save()
                        else
                            send(cfg.foremanId,{
                                type="installer_break_failed",
                                id=os.getComputerID(),
                                row=cfg.row,
                                reason="dig_failed"
                            })
                        end
                    end
                end

                if state.installerHeld then
                    ack({
                        type="installer_ready",
                        id=os.getComputerID(),
                        row=cfg.row
                    })
                end

            elseif message.type=="installer_taken" then
                if state.installerHeld then
                    state.installerHeld=false

                    if state.installerFuelSlot and turtle.getItemCount(state.installerFuelSlot)>0 then
                        turtle.select(state.installerFuelSlot)
                        turtle.transferTo(1)
                    end

                    state.installerFuelSlot=nil
                    turtle.select(1)
                    save()
                end

                ack({
                    type="installer_returned",
                    id=os.getComputerID(),
                    row=cfg.row
                })

            elseif message.type=="deploy_miner" then
                state.phase="ORIENTING_FOR_DEPLOYMENT"
                save()

                local deploymentBlocked=false
                if not faceCommissioning(DIR_N) then
                    local reason=state.recoveryReason or "Miner could not physically face north"
                    ack({
                        type="miner_deploy_blocked",
                        id=os.getComputerID(),
                        row=cfg.row,
                        reason=reason
                    })
                    state.recoveryLocked=false
                    state.orientationCalibrated=false
                    state.orientationAnchor=nil
                    state.orientationTurns=0
                    state.orientationTurnIntent=nil
                    state.phase="COMMISSIONING"
                    state.recoveryReason=reason
                    deploymentBlocked=true
                    save()
                    status("miner","COMMISSIONING",{
                        row=cfg.row,
                        foreman=cfg.foremanNumber,
                        recovery=reason,
                        message="Deployment orientation retry pending",
                        session=cfg.session
                    })
                end

                if not deploymentBlocked then
                    if state.recoveryLocked then
                    status("miner","RECOVERY_LOCK",{
                        row=cfg.row,
                        foreman=cfg.foremanNumber,
                        recovery=state.recoveryReason,
                        message="Deployment halted rather than guessing position",
                        session=cfg.session
                    })
                elseif cfg.tempDeployment then
                    state.phase="MOVING_TO_ORIGIN"
                    save()

                    while state.tempSteps<2 do
                        local intent={
                            kind="temp_forward",
                            seq=state.seq+1,
                            fuelBefore=turtle.getFuelLevel(),
                            fromStep=state.tempSteps,
                            toStep=state.tempSteps+1
                        }
                        state.motionIntent=intent
                        save()

                        if turtle.forward() then
                            state.tempSteps=intent.toStep
                            state.seq=intent.seq
                            state.motionIntent=nil
                            save()
                        else
                            state.motionIntent=nil
                            state.recoveryLocked=true
                            state.recoveryReason="Miner-01 temporary north corridor is blocked"
                            state.phase="RECOVERY_LOCK"
                            save()
                            break
                        end
                    end
                    cfg.tempDeployment=false
                end

                if state.recoveryLocked then
                    ack({
                        type="miner_deploy_blocked",
                        id=os.getComputerID(),
                        row=cfg.row,
                        reason=state.recoveryReason
                    })
                else
                    state.seq=state.seq+1
                    state.x=cfg.row
                    state.y=0
                    state.z=0
                    state.depth=0
                    state.pos=0
                    state.dir=DIR_N
                    state.resumeX=cfg.row
                    state.resumeY=0
                    state.resumeZ=0
                    state.resumeDepth=0
                    state.resumePos=0
                    state.resumeDir=DIR_N
                    state.phase="WAITING"
                    state.installerHeld=false
                    state.installerFuelSlot=nil
                    state.motionIntent=nil
                    state.turnIntent=nil
                    state.orientationTurnIntent=nil
                    state.originEstablished=true
                    state.orientationCalibrated=true
                    state.recoveryLocked=false
                    state.recoveryReason=nil

                    cfg.orientationCalibrated=true
                    cfg.orientationAnchor=state.orientationAnchor
                    cfg.commissioned=true

                    saveTable("node.cfg",cfg)
                    save()

                    checkpointPose("miner",state.seq,{
                        row=cfg.row,
                        session=cfg.session,
                        x=state.x,
                        y=state.y,
                        z=state.z,
                        depth=state.depth,
                        pos=state.pos,
                        dir=state.dir,
                        phase=state.phase,
                        resumeX=state.resumeX,
                        resumeY=state.resumeY,
                        resumeZ=state.resumeZ,
                        resumeDepth=state.resumeDepth,
                        resumePos=state.resumePos,
                        resumeDir=state.resumeDir,
                        complete=false,
                        originEstablished=true,
                        orientationCalibrated=true,
                        seq=state.seq
                    },cfg.session)

                    ack({
                        type="miner_deployed",
                        id=os.getComputerID(),
                        row=cfg.row
                    })

                    status("miner","WAITING",{
                        row=cfg.row,
                        foreman=cfg.foremanNumber,
                        x=state.x,
                        y=state.y,
                        z=state.z,
                        dir=state.dir,
                        message="Ready, north calibrated",
                        session=cfg.session
                    })

                    sleep(0.5)
                    os.reboot()
                    end
                end
            end
        end
    end
end


local function runMiner(cfg)
    setRegionalManager(cfg.managerId)
    if not openNetwork() then
        error("Wireless modem not found")
    end
    ensureManagerRegistration(cfg)

    local path="miner.tmp"
    local state=loadTableLight(path)

    if state then
        state.lastPackSend=nil
        state.lastPackAssetSend=nil
    end

    if not state then
        local monitorState=requestPoseBackup("miner",5,cfg.session)
        local exactMonitorPose=monitorState and
            monitorState.row==cfg.row and
            type(monitorState.x)=="number" and type(monitorState.y)=="number" and
            type(monitorState.z)=="number" and type(monitorState.dir)=="number" and
            monitorState.originEstablished==true

        state=exactMonitorPose and monitorState or {
            row=cfg.row,
            x=cfg.row,
            y=0,
            z=0,
            depth=0,
            pos=0,
            dir=DIR_N,
            phase="RECOVERY_LOCK",
            request=nil,
            requestSeq=0,
            resumeX=cfg.row,
            resumeY=0,
            resumeZ=0,
            resumeDepth=0,
            resumePos=0,
            resumeDir=DIR_N,
            complete=false,
            originEstablished=false,
            seq=0
        }

        state.recoveryLocked=true
        state.recoveryReason=exactMonitorPose and
            "Local miner state missing; exact monitor pose retained for manual recovery" or
            "Local miner state missing and monitor has no exact pose"
        state.phase="RECOVERY_LOCK"
        saveTableLight(path,state)
    end

    local bootHadIntent=state.motionIntent or state.turnIntent or
        state.chunkMoveIntent or state.packStepIntent or state.recoveryProbeIntent

    cfg.homeX=tonumber(cfg.homeX) or cfg.row
    cfg.homeY=tonumber(cfg.homeY) or 0
    cfg.homeZ=tonumber(cfg.homeZ) or 0
    cfg.homeDir=tonumber(cfg.homeDir) or DIR_N
    cfg.shaftMinZ=tonumber(cfg.shaftMinZ) or 0
    cfg.shaftMaxZ=tonumber(cfg.shaftMaxZ) or 15

    local savedSession=state.session
    local savedPoseSchema=tonumber(state.poseSchema) or 1
    local savedDepth=tonumber(state.depth)
    local savedPos=tonumber(state.pos)
    local savedY=tonumber(state.y)
    local savedZ=tonumber(state.z)
    state.row=cfg.row
    state.session=cfg.session
    state.seq=tonumber(state.seq) or 0
    state.x=tonumber(state.x) or cfg.row
    state.y=tonumber(state.y) or -(tonumber(state.depth) or 0)
    state.z=tonumber(state.z) or (tonumber(state.pos) or 0)
    state.dir=tonumber(state.dir) or DIR_N
    state.chunkIndex=tonumber(state.chunkIndex) or 0
    if cfg.orientationAnchor~="FOREMAN_BACK" then
        if cfg.orientationCalibrated==true and state.originEstablished==true and
            state.orientationCalibrated==true and state.dir==DIR_N and
            state.x==cfg.homeX and state.y==cfg.homeY and state.z==cfg.homeZ then
            cfg.orientationAnchor="FOREMAN_BACK"
            state.orientationAnchor="FOREMAN_BACK"
            saveTable("node.cfg",cfg)
            saveTableLight(path,state)
            if debugLog then
                debugLog("RECOVERY","Migrated trusted commissioned miner orientation anchor to FOREMAN_BACK","INFO")
            end
        else
            state.recoveryLocked=true
            state.recoveryReason="Miner orientation was inferred from ground support; recommission before mining"
            state.phase="RECOVERY_LOCK"
            saveTableLight(path,state)
            if debugLog then
                debugLog("RECOVERY","Locked miner because no trusted FOREMAN_BACK orientation anchor was available","ERROR")
            end
        end
    end
    resolveChunkMove(state,function()
        if not saveTableLight(path,state) then error("Miner chunk move recovery write failed") end
    end,cfg.worldOrigin)
    state.depth=-state.y
    state.pos=state.z
    state.resumeX=tonumber(state.resumeX) or cfg.row
    state.resumeY=tonumber(state.resumeY) or -(tonumber(state.resumeDepth) or 0)
    state.resumeZ=tonumber(state.resumeZ) or (tonumber(state.resumePos) or 0)
    state.resumeDir=tonumber(state.resumeDir) or DIR_N
    if savedSession and savedSession~=cfg.session then
        state.recoveryLocked=true
        state.recoveryReason="Miner saved session disagrees with assigned session"
        state.phase="RECOVERY_LOCK"
        saveTableLight(path,state)
    elseif savedPoseSchema<MINER_POSE_SCHEMA and
        ((savedDepth and savedY and savedDepth~=-savedY) or
         (savedPos and savedZ and savedPos~=savedZ)) then
        state.recoveryLocked=true
        state.recoveryReason="Legacy miner pose fields disagree during schema migration"
        state.phase="RECOVERY_LOCK"
        saveTableLight(path,state)
    end
    state.poseSchema=MINER_POSE_SCHEMA
    state.depth=-state.y
    state.pos=state.z
    saveTableLight(path,state)

    if cfg.row==WORKER_COUNT and state.phase=="PACK_DONE" and
        state.recallMode=="PACK" and (state.x>1 or state.packDeposited~=true) then
        state.phase="PACK_COLLECT"
        state.recoveryLocked=false
        state.recoveryReason=nil
        saveTableLight(path,state)
    end

    local function packAssetPoseValid(x,y,z)
        if not (state.packAssetProgress and state.recallMode=="PACK" and isChestCollector(cfg.row)) then
            return false
        end
        local group=math.floor((cfg.row-1)/4)+1
        if group==1 then
            return x>=cfg.row-1 and x<=cfg.row and y==0 and z>=-2 and z<=0
        end
        return x>=cfg.row-1 and x<=cfg.row and y==0 and z>=-2 and z<=0
    end

    local function poseValid()
        if state.advanceStage=="CHEST" then
            local collector=chestCollectorRow(math.floor((cfg.row-1)/4)+1)
            return cfg.row==collector and state.originEstablished==true and
                cfg.orientationCalibrated==true and state.y==0 and
                ((state.x==cfg.row and state.z>=-2 and state.z<=0) or
                 (state.x==cfg.row-1 and state.z==-1))
        end
        if state.advanceStage=="MOVE" then
            return state.originEstablished==true and cfg.orientationCalibrated==true and
                state.y==0 and state.x==cfg.row and state.z>=0 and state.z<=16
        end
        if state.packAssetProgress and state.recallMode=="PACK" and isChestCollector(cfg.row) then
            return state.originEstablished==true and cfg.orientationCalibrated==true and
                packAssetPoseValid(state.x,state.y,state.z) and
                state.dir>=DIR_N and state.dir<=DIR_W
        end
        if cfg.row==WORKER_COUNT and (state.phase=="PACK_COLLECT" or state.phase=="PACK_BLOCKED" or state.phase=="PACK_DONE") then
            local overflow=state.packOverflowTrip==true
            return state.originEstablished==true and cfg.orientationCalibrated==true and
                state.x>=(overflow and 0 or 1) and state.x<=16 and state.y==0 and
                ((not overflow and state.z==0) or (overflow and state.z>=-1 and state.z<=0)) and
                state.dir>=DIR_N and state.dir<=DIR_W
        end
        return state.originEstablished==true and cfg.orientationCalibrated==true and
            state.x==cfg.homeX and state.y<=cfg.homeY and
            state.z>=cfg.shaftMinZ and state.z<=cfg.shaftMaxZ and
            state.dir>=DIR_N and state.dir<=DIR_W
    end

    if state.phase=="PACK_COLLECT" and state.packStepIntent and
        state.packStepIntent.stage=="MOVING" then
        local fuel=turtle.getFuelLevel()
        local moved=movementFromFuel(state.packStepIntent.fuelBefore,fuel)
        if moved==nil then
            local fromX=tonumber(state.packStepIntent.fromX) or state.x
            local toX=tonumber(state.packStepIntent.toX) or (fromX-1)
            moved=movementFromGPS({
                from={x=fromX,y=state.y,z=state.z},
                to={x=toX,y=state.y,z=state.z}
            },state.chunkIndex,cfg.worldOrigin,2)
        end
        if moved~=nil then
            if moved then
                state.x=tonumber(state.packStepIntent.toX) or (state.x-1)
                state.seq=state.seq+1
                state.packStepIntent=nil
            else
                state.packStepIntent.stage="DUG"
            end
        else
            state.recoveryLocked=true
            state.recoveryReason="Cannot resolve interrupted Miner-16 pack move; waiting for recovery GPS"
        end
        saveTableLight(path,state)
    end

    if state.phase=="PACK_ASSETS" and state.packAssetProgress and state.recallMode=="PACK" and
        isChestCollector(cfg.row) and not state.recoveryLocked then
        state.phase="RECALLED_PAUSED"
        saveTableLight(path,state)
    end

    if cfg.row==WORKER_COUNT and state.recoveryLocked and
        (state.recoveryReason=="Turtle inspect unavailable for safe pack collection" or
         string.find(tostring(state.recoveryReason),"^Expected Miner%-") or
         string.find(tostring(state.recoveryReason),"^Cannot verify Miner%-") or
         string.find(tostring(state.recoveryReason),"^Pack collection blocked")) and
        state.x>=1 and state.x<=16 and state.y==0 and state.z==0 and
        state.phase=="PACK_COLLECT" and
        (not state.packStepIntent or state.packStepIntent.stage=="DUG") then
        state.recoveryLocked=false
        state.recoveryReason=nil
        saveTableLight(path,state)
    end

    local function minerSnapshot()
        return {
            row=state.row,
            session=cfg.session,
            x=state.x,
            y=state.y,
            z=state.z,
            depth=state.depth,
            pos=state.pos,
            dir=state.dir,
            phase=state.phase,
            request=state.request,
            requestSeq=state.requestSeq,
            resumeX=state.resumeX,
            resumeY=state.resumeY,
            resumeZ=state.resumeZ,
            resumeDepth=state.resumeDepth,
            resumePos=state.resumePos,
            resumeDir=state.resumeDir,
            complete=state.complete,
            chunkIndex=state.chunkIndex,
            blockedDetail=state.blockedDetail,
            packError=state.packError,
            originEstablished=state.originEstablished==true,
            orientationCalibrated=cfg.orientationCalibrated==true,
            seq=state.seq
        }
    end

    local function snapshotHasExactPose(snapshot)
        return snapshot and snapshot.row==cfg.row and
            type(snapshot.x)=="number" and type(snapshot.y)=="number" and
            type(snapshot.z)=="number" and type(snapshot.dir)=="number" and
            snapshot.originEstablished==true
    end

    local function applySnapshot(snapshot)
        if not snapshotHasExactPose(snapshot) then
            return false
        end

        local previousChunk=tonumber(state.chunkIndex) or 0
        state=snapshot
        state.row=cfg.row
        state.chunkIndex=tonumber(state.chunkIndex) or previousChunk
        state.seq=tonumber(state.seq) or 0
        state.x=tonumber(state.x)
        state.y=tonumber(state.y)
        state.z=tonumber(state.z)
        state.dir=tonumber(state.dir)
        state.depth=-state.y
        state.pos=state.z
        state.resumeX=tonumber(state.resumeX) or cfg.row
        state.resumeY=tonumber(state.resumeY) or -(tonumber(state.resumeDepth) or 0)
        state.resumeZ=tonumber(state.resumeZ) or (tonumber(state.resumePos) or 0)
        state.resumeDir=tonumber(state.resumeDir) or DIR_N
        return true
    end

    local bootManagerState,bootManagerSeq=requestPoseBackup("miner",5,cfg.session)
    do
        local managerState,managerSeq=bootManagerState,bootManagerSeq
        if managerState and snapshotHasExactPose(managerState) and
            not state.motionIntent and not state.turnIntent and not state.packAssetProgress and
            state.phase~="PACK_COLLECT" and state.phase~="PACK_BLOCKED" and
            state.phase~="PACK_DONE" then
            local incoming=tonumber(managerSeq or managerState.seq or 0) or 0
            local authorityCalibrated=managerState.orientationCalibrated==true and
                managerState.originEstablished==true
            local inferredOrientationLock=state.recoveryLocked==true and
                state.recoveryReason=="Miner orientation was inferred from ground support; recommission before mining"

            if inferredOrientationLock and authorityCalibrated and incoming>=state.seq then
                applySnapshot(managerState)
                state.recoveryLocked=false
                state.recoveryReason=nil
                state.orientationCalibrated=true
                state.orientationAnchor="FOREMAN_BACK"
                cfg.orientationCalibrated=true
                cfg.orientationAnchor="FOREMAN_BACK"
                saveTable("node.cfg",cfg)
                saveTableLight(path,state)
                if debugLog then
                    debugLog("RECOVERY","Regional Manager authority restored commissioned miner orientation and cleared inferred recovery lock","WARN")
                end
            elseif incoming>state.seq or
                (incoming==state.seq and
                    (managerState.x~=state.x or managerState.y~=state.y or
                     managerState.z~=state.z or managerState.dir~=state.dir)) then
                state.recoveryLocked=true
                state.recoveryReason="Manager and local miner positions disagree after reboot"
                if state.phase~="RECOVERY_LOCK" then state.recoveryPhase=state.phase end
                state.phase="RECOVERY_LOCK"
                saveTableLight(path,state)
                if debugLog then
                    debugLog("RECOVERY","Manager/local pose disagreement retained recovery lock","ERROR")
                end
            end
        end
    end

    if state.motionIntent or state.turnIntent then
        local monitorState,monitorSeq=bootManagerState,bootManagerSeq
        local intent=state.motionIntent or state.turnIntent
        local intentSeq=tonumber(intent.seq) or (state.seq+1)
        if not monitorState or tonumber(monitorSeq or monitorState.seq or 0)<intentSeq then
            monitorState,monitorSeq=requestPoseBackup("miner",5,cfg.session)
        end

        local expectedMove=state.motionIntent and state.motionIntent.to
        local monitorFits=expectedMove and snapshotHasExactPose(monitorState) and
            monitorState.x==expectedMove.x and monitorState.y==expectedMove.y and
            monitorState.z==expectedMove.z and monitorState.dir==expectedMove.dir

        if monitorFits and
            not state.turnIntent and
            tonumber(monitorSeq or monitorState.seq or 0)==intentSeq and
            movementFromFuel(intent.fuelBefore,turtle.getFuelLevel())==true then
            applySnapshot(monitorState)
            state.motionIntent=nil
            state.turnIntent=nil
            saveTableLight(path,state)
        elseif state.motionIntent then
            local fuelNow=turtle.getFuelLevel()
            local fuelBefore=state.motionIntent.fuelBefore
            local moved=movementFromFuel(fuelBefore,fuelNow)
            if moved==nil then
                moved=movementFromGPS(state.motionIntent,state.chunkIndex,cfg.worldOrigin,2)
            end

            if moved==nil then
                state.recoveryLocked=true
                state.recoveryReason="Position ambiguous after interrupted movement; waiting for recovery GPS"
                if state.phase~="RECOVERY_LOCK" then state.recoveryPhase=state.phase end
                state.phase="RECOVERY_LOCK"
            else
                local pose=moved and state.motionIntent.to or state.motionIntent.from
                state.x=pose.x
                state.y=pose.y
                state.z=pose.z
                state.dir=pose.dir
                state.depth=-state.y
                state.pos=state.z
                if moved then
                    state.seq=intentSeq
                end
                state.motionIntent=nil
            end
            saveTableLight(path,state)
        else
            local recoveredDir,reason=recoverFacingByGPS(state,cfg.worldOrigin,function() return saveTableLight(path,state) end)
            if recoveredDir then
                state.dir=recoveredDir
                state.seq=math.max(state.seq,intentSeq)
                state.turnIntent=nil
                state.recoveryLocked=nil
                state.recoveryReason=nil
            else
                state.recoveryLocked=true
                state.recoveryReason=reason or "Facing ambiguous after interrupted turn"
                if state.phase~="RECOVERY_LOCK" then state.recoveryPhase=state.phase end
                state.phase="RECOVERY_LOCK"
            end
            saveTableLight(path,state)
        end
    end

    if state.recoveryLocked and
        state.recoveryReason=="Movement would leave assigned miner shaft" and
        state.advanceStage=="CHEST" and
        cfg.row==math.floor((cfg.row-1)/4)*4+2 and
        state.x==cfg.row and state.y==0 and state.z==-1 and
        not state.motionIntent then
        state.recoveryLocked=false
        state.recoveryReason=nil
        state.phase="ADVANCE_CHEST"
        saveTableLight(path,state)
    end

    if state.recoveryLocked and
        state.recoveryReason=="Movement would leave assigned miner shaft" and
        state.packAssetProgress and state.recallMode=="PACK" and
        isChestCollector(cfg.row) and cfg.row~=WORKER_COUNT and
        packAssetPoseValid(state.x,state.y,state.z) and not state.motionIntent then
        state.recoveryLocked=false
        state.recoveryReason=nil
        state.phase="RECALLED_PAUSED"
        saveTableLight(path,state)
    end

    if state.recoveryProbeIntent and not state.recoveryLocked then
        state.recoveryLocked=true
        state.recoveryReason="Interrupted transactional facing probe"
        state.phase="RECOVERY_LOCK"
        saveTableLight(path,state)
    end

    if not poseValid() and not state.recoveryLocked then
        state.recoveryLocked=true
        state.recoveryReason="Saved miner pose is outside its legal shaft"
        if state.phase~="RECOVERY_LOCK" then state.recoveryPhase=state.phase end
        state.phase="RECOVERY_LOCK"
        saveTableLight(path,state)
    end

    if bootHadIntent and not state.recoveryLocked and
        not state.motionIntent and not state.turnIntent and
        not state.chunkMoveIntent and not state.packStepIntent then
        state.fuelWitness=turtle.getFuelLevel()
        saveTableLight(path,state)
    end
    if not state.recoveryLocked then
        local verified,reason=verifyBootWitness(state,cfg.worldOrigin,bootHadIntent)
        if not verified then
            state.recoveryLocked=true
            state.recoveryReason=reason
            if state.phase~="RECOVERY_LOCK" then state.recoveryPhase=state.phase end
            state.phase="RECOVERY_LOCK"
            saveTableLight(path,state)
        end
    end

    local flags = {
        start=false,
        recallMode=nil,
        resume=false,
        advanceCancelled=false,
        serviceProbe=nil,
        refuelNow=false,
        serviceComplete=false,
        packCollect=false,
        packAssets=false,
        newForeman=nil,
        advanceCommand=nil,
        orientationCommand=nil
    }
    local lastStatus = 0
    local lastRequest = 0
    local prepareForForemanService

    local function save()
        state.poseSchema=MINER_POSE_SCHEMA
        state.depth=-state.y
        state.pos=state.z
        state.fuelWitness=turtle.getFuelLevel()
        if not saveTableLight(path,state) then
            error("Miner state write failed; movement halted")
        end
        return true
    end

    local function freeInventorySlots()
        local count=0
        for slot=1,16 do
            if turtle.getItemCount(slot)==0 then count=count+1 end
        end
        return count
    end

    local function checkpoint()
        checkpointPose("miner",state.seq,minerSnapshot(),cfg.session)
    end

    local function sendState(message)
        status("miner",state.phase,{
            row=state.row,
            foreman=cfg.foremanNumber,
            x=state.x,
            y=state.y,
            z=state.z,
            dir=state.dir,
            seq=state.seq,
            depth=state.depth,
            pos=state.pos,
            fuel=turtle.getFuelLevel(),
            request=state.request and state.request.kind or nil,
            chunkIndex=state.chunkIndex,
            advanceStage=state.advanceStage,
            packMissing=state.packMissing,
            packError=state.packError,
            blockedDetail=state.blockedDetail,
            complete=state.complete and true or false,
            orientationVerified=state.preMiningOrientationVerified and true or false,
            recovery=state.recoveryReason,
            message=message or "",
            session=cfg.session
        })
        lastStatus = now()
    end

    local function requestPacket(arrived)
        if not state.request then
            return
        end

        send(cfg.managerId,{
            type = arrived and "service_arrived" or "service_request",
            row = state.row,
            requestId = state.request.id,
            service = state.request.kind,
            minerId = os.getComputerID(),
            foremanId = cfg.foremanId,
            foremanNumber = cfg.foremanNumber,
            fuel = turtle.getFuelLevel(),
            x = state.x,
            y = state.y,
            z = state.z,
            dir = state.dir,
            session = cfg.session
        })
        lastRequest = now()
    end

    local function networkLoop()
        local timer = os.startTimer(1)
        while true do
            local event = {os.pullEvent()}
            if event[1] == "rednet_message" then
                local sender = event[2]
                local message = event[3]
                local protocol = event[4]
                if protocol == PROTOCOL and type(message) == "table" then
                    if sender == cfg.foremanId then
                        if message.type=="deploy_miner" and cfg.commissioned then
                            for i=1,3 do
                                send(cfg.foremanId,{
                                    type="miner_deployed",
                                    id=os.getComputerID(),
                                    row=cfg.row
                                })
                                sleep(0.1)
                            end
                        elseif message.type == "service_probe" and state.request and
                            message.requestId == state.request.id and state.phase=="WAITING_SERVICE" then
                            flags.serviceProbe=message.requestId
                        elseif message.type == "refuel_now" and state.request and message.requestId == state.request.id then
                            flags.refuelNow = true
                            state.runtimeFuelKind=message.fuelKind
                            save()
                        elseif message.type=="orientation_command" and message.session==cfg.session then
                            if state.orientationLastToken==message.token and type(state.orientationLastResult)=="table" then
                                send(cfg.foremanId,state.orientationLastResult)
                            else
                                flags.orientationCommand=message
                            end
                        end
                    elseif message.type=="maintenance_clear_label" and
                        message.session==cfg.session then
                        local before=os.getComputerLabel()
                        os.setComputerLabel(nil)
                        send(sender,{
                            type="maintenance_label_cleared",
                            row=state.row,
                            id=os.getComputerID(),
                            before=before,
                            cleared=os.getComputerLabel()==nil,
                            session=cfg.session
                        })
                    elseif sender == cfg.managerId and message.session==cfg.session then
                        if message.type=="cancel_advance" then
                            flags.advanceCancelled=true
                            if message.mode=="NORMAL" or message.mode=="SHUTDOWN" then
                                flags.start=false
                                flags.resume=false
                                flags.recallMode=message.mode
                            end
                        elseif message.type=="chunk_command" and not state.recallMode then
                            local target=tonumber(message.chunkIndex)
                            if target==state.chunkIndex+1 and message.stage=="COLLECT_M" and
                                state.chestCollected then
                                send(cfg.managerId,{type="chunk_ack",role="miner",
                                    row=cfg.row,stage="COLLECT_M",chunkIndex=target,
                                    session=cfg.session})
                            elseif target==state.chunkIndex and message.stage=="MOVE_M" and
                                state.advanceStage=="WAIT" and
                                not (cfg.row==1 and tonumber(state.supplyChestTarget)==target) then
                                send(cfg.managerId,{type="chunk_ack",role="miner",
                                    row=cfg.row,stage="MOVE_M",chunkIndex=target,
                                    session=cfg.session})
                            elseif target==state.chunkIndex and message.stage=="MOVE_M" and
                                state.advanceStage=="MOVE" then
                                flags.advanceCommand={stage="MOVE_M",target=target}
                            elseif target and target==state.chunkIndex+1 and
                                (message.stage=="COLLECT_M" or message.stage=="MOVE_M") then
                                flags.advanceCommand={stage=message.stage,target=target}
                            end
                        elseif message.type=="chunk_release" and
                            tonumber(message.chunkIndex)==state.chunkIndex and
                            state.advanceStage=="WAIT" then
                            state.advanceStage=nil
                            state.chestCollected=nil
                            state.chestProgress=nil
                            state.dumpSlot=nil
                            state.fuelSlot=nil
                            state.complete=false
                            state.phase="WAITING"
                            save()
                            os.reboot()
                        elseif message.type == "start_mining" then
                            if not state.packPending and state.recallMode~="PACK" and
                                not state.packDumpRequested and
                                not (state.request and state.request.packDump) and
                                not state.advanceStage and not state.recallMode and
                                state.phase~="RECALLED_PAUSED" and
                                state.phase~="RECALLING" and not flags.recallMode then
                                flags.start=true
                            end
                        elseif message.type=="resume_swarm" then
                            if not state.packPending and state.recallMode~="PACK" and
                                not state.packDumpRequested and
                                not (state.request and state.request.packDump) then
                                if not state.advanceStage then flags.start=true end
                                if state.phase=="RECALLED_PAUSED" or state.phase=="RECALLING" or state.recallMode or state.recallResume or flags.recallMode then
                                    flags.resume=true
                                end
                            else
                                flags.start=false
                                flags.resume=false
                            end
            elseif message.type == "service_complete" and state.request and message.requestId == state.request.id then
                            flags.serviceComplete = true
                        elseif message.type=="service_complete" and
                            message.requestId==state.lastCompletedRequest then
                            send(cfg.managerId,{
                                type="service_complete_ack",
                                requestId=message.requestId,
                                session=cfg.session
                            })
                        elseif message.type == "recall_command" then
                            local incomingMode=message.mode or "NORMAL"
                            if incomingMode=="PACK" then
                                local incomingToken=tonumber(message.packToken)
                                state.packPending=nil
                                state.recallResume=nil
                                state.packDumpComplete=nil
                                state.packDumpRequested=nil
                                flags.start=false
                                flags.resume=false
                                if incomingToken then
                                    state.packToken=incomingToken
                                end
                                save()
                            elseif incomingMode=="NORMAL" and message.packPending==true then
                                state.packPending=true
                                state.packDumpComplete=nil
                                state.packDumpRequested=nil
                                flags.start=false
                                flags.resume=false
                                save()
                            else
                                state.packPending=nil
                                state.packToken=nil
                                state.packDumpRequested=nil
                                state.packDumpComplete=nil
                                save()
                            end
                            if incomingMode=="NORMAL" or incomingMode=="DUMP" or
                                incomingMode=="SHUTDOWN" or incomingMode=="PACK" then
                                flags.advanceCancelled=true
                            end
                            if state.recallMode==incomingMode and (state.phase=="RECALLED_PAUSED" or state.phase=="WAITING_SERVICE" or state.phase=="RECALLING") then
                                if state.phase=="WAITING_SERVICE" and state.request then
                                    requestPacket(true)
                                elseif state.phase=="RECALLED_PAUSED" then
                                    send(cfg.managerId,{
                                        type="recall_home",
                                        role="miner",
                                        row=state.row,
                                        id=os.getComputerID(),
                                        mode=incomingMode,
                                        packToken=incomingMode=="PACK" and state.packToken or nil,
                                        x=state.x,
                                        y=state.y,
                                        z=state.z,
                                        dir=state.dir,
                                        freeSlots=freeInventorySlots(),
                                        session=cfg.session
                                    })
                                    if incomingMode=="DUMP" and not state.request then
                                        send(cfg.managerId,{
                                            type="recall_dump_empty",
                                            role="miner",
                                            row=state.row,
                                            id=os.getComputerID(),
                                            x=state.x,
                                            y=state.y,
                                            z=state.z,
                                            dir=state.dir,
                                            session=cfg.session
                                        })
                                    end
                                end
                            else
                                flags.start=false
                                flags.resume=false
                                flags.recallMode=incomingMode
                            end
                        elseif message.type=="pack_clear" and state.phase=="RECALLED_PAUSED" and
                            state.recallMode=="PACK" and cfg.row~=WORKER_COUNT and
                            tonumber(message.packToken)==tonumber(state.packToken) then
                            for attempt=1,5 do
                                os.setComputerLabel(nil)
                                if os.getComputerLabel()==nil then break end
                                sleep(0.1)
                            end
                            if os.getComputerLabel()==nil then
                                state.packReady=true
                                state.packAcknowledged=nil
                                save()
                                send(cfg.managerId,{
                                    type="pack_ready",role="miner",row=cfg.row,
                                    packToken=state.packToken,labelCleared=true,
                                    x=state.x,y=state.y,z=state.z,dir=state.dir,session=cfg.session
                                })
                            end
                        elseif message.type=="pack_ready_ack" and state.packReady and
                            tonumber(message.packToken)==tonumber(state.packToken) then
                            state.packAcknowledged=true
                            save()
                        elseif message.type=="pack_assets_collect" and isChestCollector(cfg.row) and
                            cfg.row~=WORKER_COUNT and state.recallMode=="PACK" and
                            tonumber(message.packToken)==tonumber(state.packToken) then
                            flags.packAssets=true
                        elseif message.type=="pack_assets_ack" and state.packAssetsReady and
                            tonumber(message.packToken)==tonumber(state.packToken) then
                            state.packAssetsAcknowledged=true
                            save()
                        elseif message.type=="pack_collect" and cfg.row==WORKER_COUNT and
                            state.recallMode=="PACK" and tonumber(message.packToken)==tonumber(state.packToken) then
                            if type(message.cargoCounts)=="table" then
                                state.packCargoCounts=message.cargoCounts
                                save()
                            end
                            flags.packCollect=true
                        elseif message.type == "hold_position" then
                            state.phase="RECOVERY_LOCK"
                            state.recoveryLocked=true
                            state.recoveryReason=message.reason or "Regional Manager hold"
                            save()
                        elseif message.type == "status_query" then
                            sendState("")
                        end
                    end
                end
            elseif event[1] == "timer" and event[2] == timer then
                if state.request and now() - lastRequest >= REQUEST_REPEAT then
                    requestPacket(state.phase == "WAITING_SERVICE")
                end
                if now() - lastStatus >= STATUS_INTERVAL then
                    sendState("")
                end
                timer = os.startTimer(1)
            end
        end
    end

    local gpsVerifiedThisBoot=false
    local gpsRecallAttempted=false
    local gpsFirstAttempt=true
    local lastGpsWait=0

    local function verifySurfaceGps()
        if gpsVerifiedThisBoot or state.y~=cfg.homeY then return true end
        if state.recallMode and gpsRecallAttempted then return true end
        if gpsFirstAttempt then
            gpsFirstAttempt=false
            sleep((cfg.row-1)*0.15)
        end
        while not state.recoveryLocked do
            local ok,gx,gy,gz=pcall(gps.locate,state.recallMode and 0.5 or 2,false)
            if ok and type(gx)=="number" and type(gy)=="number" and type(gz)=="number" then
                local expectedX,expectedY,expectedZ=worldPose(state.x,state.y,
                    state.z,state.chunkIndex,cfg.worldOrigin)
                if not expectedX or math.abs(gx-expectedX)>0.25 or
                    math.abs(gy-expectedY)>0.25 or math.abs(gz-expectedZ)>0.25 then
                    state.recoveryLocked=true
                    state.recoveryReason="GPS position differs from saved miner pose after reboot"
                    state.phase="RECOVERY_LOCK"
                    save()
                    sendState(state.recoveryReason .. " GPS " .. tostring(gx) .. "," ..
                        tostring(gy) .. "," .. tostring(gz))
                    return false
                end
                gpsVerifiedThisBoot=true
                return true
            end
            if state.recallMode then
                gpsRecallAttempted=true
                return true
            end
            if now()-lastGpsWait>=5 then
                sendState("Waiting for four GPS hosts to verify position after reboot")
                lastGpsWait=now()
            end
            sleep(1+(cfg.row%4)*0.2)
        end
        return false
    end

    local orientationMovementActive=false

    local function minerTranslationMode(toX,toY,toZ)
        if state.advanceStage=="CHEST" and toX==cfg.row and toY==0 and
            toZ>=-2 and toZ<=0 then return "CHEST" end
        if state.packAssetProgress and state.recallMode=="PACK" and
            isChestCollector(cfg.row) and cfg.row~=WORKER_COUNT and
            packAssetPoseValid(state.x,state.y,state.z) and packAssetPoseValid(toX,toY,toZ) then
            return "PACK_ASSET"
        end
        if cfg.row==WORKER_COUNT and state.recallMode=="PACK" and
            state.phase=="PACK_COLLECT" and state.packOverflowTrip==true and
            state.y==0 and toY==0 and state.x>=0 and state.x<=WORKER_COUNT and
            state.z>=-1 and state.z<=0 and toX>=0 and toX<=WORKER_COUNT and
            toZ>=-1 and toZ<=0 then return "PACK_OVERFLOW" end
        if orientationMovementActive and toX>=0 and toX<=WORKER_COUNT+1 and
            toY>=cfg.homeY and toY<=cfg.homeY+1 and toZ>=-1 and toZ<=16 then
            return "ORIENTATION"
        end
        if cfg.row==1 and state.advanceStage=="MOVE" and
            tonumber(state.supplyChestTarget)==tonumber(state.chunkIndex) and
            state.y==0 and toY==0 and toZ==0 and toX>=0 and toX<=1 then
            return "SUPPLY"
        end
        if toX==cfg.row and toY<=0 and toZ>=0 and toZ<=15 then return "SHAFT" end
        return nil
    end

    local function beginTranslation(kind,toX,toY,toZ)
        if state.y==cfg.homeY and not orientationMovementActive and not verifySurfaceGps() then return nil end
        local movementMode=minerTranslationMode(toX,toY,toZ)
        if not movementMode then
            state.recoveryLocked=true
            state.recoveryReason="Movement would leave assigned miner shaft"
            state.phase="RECOVERY_LOCK"
            save()
            sendState(state.recoveryReason)
            return nil
        end

        local intent={
            kind=kind,
            mode=movementMode,
            seq=state.seq+1,
            fuelBefore=turtle.getFuelLevel(),
            from={x=state.x,y=state.y,z=state.z,dir=state.dir},
            to={x=toX,y=toY,z=toZ,dir=state.dir}
        }
        state.motionIntent=intent
        if not save() then
            state.motionIntent=nil
            state.recoveryLocked=true
            state.recoveryReason="Could not persist miner movement intent"
            state.phase="RECOVERY_LOCK"
            sendState(state.recoveryReason)
            return nil
        end
        return intent
    end

    local function finishTranslation(intent,critical)
        state.x=intent.to.x
        state.y=intent.to.y
        state.z=intent.to.z
        state.dir=intent.to.dir
        state.seq=intent.seq
        state.depth=-state.y
        state.pos=state.z

        if critical or state.seq%10==0 then
            checkpoint()
        end

        state.motionIntent=nil
        save()
    end

    local function cancelTranslation()
        state.motionIntent=nil
        save()
    end

    local function attemptForward()
        local nx=state.x
        local nz=state.z

        if state.dir==DIR_N then
            nz=nz+1
        elseif state.dir==DIR_E then
            nx=nx+1
        elseif state.dir==DIR_S then
            nz=nz-1
        else
            nx=nx-1
        end

        local intent=beginTranslation("forward",nx,state.y,nz)
        if not intent then return false,"movement intent rejected" end
        local moved,moveError=turtle.forward()
        if not moved then
            cancelTranslation()
            return false,moveError
        end

        finishTranslation(intent,false)
        return true,nil
    end

    local function attemptUp()
        local intent=beginTranslation("up",state.x,state.y+1,state.z)
        if not intent then return false end
        if not turtle.up() then
            cancelTranslation()
            return false
        end
        finishTranslation(intent,true)
        return true
    end

    local function attemptDown()
        local intent=beginTranslation("down",state.x,state.y-1,state.z)
        if not intent then return false end
        if not turtle.down() then
            cancelTranslation()
            return false
        end
        finishTranslation(intent,true)
        return true
    end

    local function turnStep(right)
        local from=state.dir
        local to=right and ((from+1)%4) or ((from+3)%4)
        local intent={
            seq=state.seq+1,
            from=from,
            to=to
        }
        state.turnIntent=intent
        if not save() then
            state.turnIntent=nil
            state.recoveryLocked=true
            state.recoveryReason="Could not persist miner turn intent"
            state.phase="RECOVERY_LOCK"
            sendState(state.recoveryReason)
            return false
        end

        local ok
        if right then
            ok=turtle.turnRight()
        else
            ok=turtle.turnLeft()
        end

        if not ok then
            state.turnIntent=nil
            save()
            return false
        end

        state.dir=to
        state.seq=intent.seq
        checkpoint()
        state.turnIntent=nil
        save()
        return true
    end

    local function face(target)
        while state.dir~=target do
            local diff=(target-state.dir)%4
            if diff==3 then
                if not turnStep(false) then return false end
            else
                if not turnStep(true) then return false end
            end
        end
        return true
    end

    local function orientationFrontComputerId()
        local ok,id=pcall(peripheral.call,"front","getID")
        if ok then return tonumber(id) end
        return nil
    end

    local function orientationAdoptGpsPose()
        local gx,gy,gz=locateWorldPose(2)
        if not gx then return false,"GPS unavailable during orientation correction" end
        local lx,ly,lz=worldToLocalPose(gx,gy,gz,state.chunkIndex,cfg.worldOrigin)
        if lx==nil then return false,"GPS orientation correction could not map the miner position" end
        state.x=lx
        state.y=ly
        state.z=lz
        state.depth=-ly
        state.pos=lz
        state.motionIntent=nil
        state.turnIntent=nil
        save()
        return true
    end

    local function orientationClearFront()
        local kind=peripheral.getType("front")
        local okId,id=pcall(peripheral.call,"front","getID")
        if kind or (okId and tonumber(id)) then
            return false,"Orientation correction path is occupied by a protected block"
        end
        pcall(turtle.dig)
        pcall(turtle.attack)
        sleep(0.05)
        kind=peripheral.getType("front")
        okId,id=pcall(peripheral.call,"front","getID")
        if kind or (okId and tonumber(id)) or turtle.detect() then
            return false,"Orientation correction could not clear its horizontal path"
        end
        return true
    end

    local function orientationMoveHorizontal(tx,tz)
        while state.x<tx do
            if not face(DIR_E) then return false,"Could not face east during orientation correction" end
            local ok,reason=orientationClearFront()
            if not ok then return false,reason end
            if not attemptForward() then return false,"Could not move east during orientation correction" end
        end
        while state.x>tx do
            if not face(DIR_W) then return false,"Could not face west during orientation correction" end
            local ok,reason=orientationClearFront()
            if not ok then return false,reason end
            if not attemptForward() then return false,"Could not move west during orientation correction" end
        end
        while state.z<tz do
            if not face(DIR_N) then return false,"Could not face north during orientation correction" end
            local ok,reason=orientationClearFront()
            if not ok then return false,reason end
            if not attemptForward() then return false,"Could not move north during orientation correction" end
        end
        while state.z>tz do
            if not face(DIR_S) then return false,"Could not face south during orientation correction" end
            local ok,reason=orientationClearFront()
            if not ok then return false,reason end
            if not attemptForward() then return false,"Could not move south during orientation correction" end
        end
        return true
    end

    local function orientationGpsRepair()
        local ok,reason=orientationAdoptGpsPose()
        if not ok then return false,reason end
        while state.y<cfg.homeY+1 do
            local kind=peripheral.getType("top")
            if kind then return false,"GPS orientation correction is blocked above by "..tostring(kind) end
            pcall(turtle.digUp)
            if turtle.detectUp() then return false,"GPS orientation correction could not clear above the miner" end
            if not attemptUp() then return false,"GPS orientation correction could not move above the miner line" end
        end
        if state.y~=cfg.homeY+1 then
            return false,"GPS orientation correction reached an unexpected height"
        end
        local recoveredDir,facingReason=recoverFacingByGPS(state,cfg.worldOrigin,function() return save() end)
        if not recoveredDir then
            return false,"GPS orientation correction could not establish facing: "..tostring(facingReason)
        end
        state.dir=recoveredDir
        save()
        ok,reason=orientationMoveHorizontal(cfg.homeX,cfg.homeZ)
        if not ok then return false,reason end
        if not face(DIR_N) then return false,"GPS orientation correction could not establish north" end
        while state.y>cfg.homeY do
            local kind=peripheral.getType("bottom")
            if kind then return false,"GPS orientation correction is blocked below by "..tostring(kind) end
            pcall(turtle.digDown)
            if turtle.detectDown() then return false,"GPS orientation correction could not clear the home column" end
            if not attemptDown() then return false,"GPS orientation correction could not return to miner height" end
        end
        if state.x~=cfg.homeX or state.y~=cfg.homeY or state.z~=cfg.homeZ then
            return false,"GPS orientation correction did not return to the miner idle square"
        end
        if not face(DIR_N) then return false,"GPS orientation correction could not finish north-facing" end
        state.dir=DIR_N
        state.orientationCalibrated=true
        state.orientationAnchor="FOREMAN_BACK"
        state.preMiningOrientationVerified=true
        state.recoveryLocked=nil
        state.recoveryReason=nil
        cfg.orientationCalibrated=true
        cfg.orientationAnchor="FOREMAN_BACK"
        saveTable("node.cfg",cfg)
        save()
        checkpoint()
        return true
    end

    local function orientationPeerCheck(expectRight,expectLeft,confirm)
        if not turnStep(true) then return false,"Could not turn right for peer orientation check" end
        local right=orientationFrontComputerId()~=nil
        if not turnStep(false) then return false,"Could not restore after right peer check" end
        if not turnStep(false) then return false,"Could not turn left for peer orientation check" end
        local left=orientationFrontComputerId()~=nil
        if not turnStep(true) then return false,"Could not restore after left peer check" end
        if right~=(expectRight and true or false) or left~=(expectLeft and true or false) then
            return false,"Peer geometry did not identify north"
        end
        if confirm then
            local ok,reason=orientationAdoptGpsPose()
            if not ok then return false,reason end
            state.dir=DIR_N
            state.orientationCalibrated=true
            state.orientationAnchor="FOREMAN_BACK"
            state.preMiningOrientationVerified=true
            cfg.orientationCalibrated=true
            cfg.orientationAnchor="FOREMAN_BACK"
            saveTable("node.cfg",cfg)
            save()
            checkpoint()
        end
        return true
    end

    local function orientationReturnHome()
        local ok,reason=orientationAdoptGpsPose()
        if not ok then return false,reason end
        if state.y~=cfg.homeY then return false,"Peer orientation check left the miner at an unexpected height" end
        ok,reason=orientationMoveHorizontal(cfg.homeX,cfg.homeZ)
        if not ok then return false,reason end
        if not face(DIR_N) then return false,"Could not finish peer orientation check north-facing" end
        return true
    end

    local function processOrientationCommand()
        local command=flags.orientationCommand
        if not command then return false end
        flags.orientationCommand=nil
        local result={
            type="orientation_result",
            row=cfg.row,
            token=command.token,
            action=command.action,
            ok=false,
            session=cfg.session
        }
        if state.recallMode or state.advanceStage or state.complete or
            (state.phase~="WAITING" and state.phase~="RECOVERY_LOCK") then
            result.reason="Miner is not safely parked for pre-mining orientation correction"
        else
            orientationMovementActive=true
            if command.action=="forward" then
                if attemptForward() then result.ok=true else result.reason="Miner could not make peer-check forward move" end
            elseif command.action=="check" then
                local ok,reason=orientationPeerCheck(command.expectRight,command.expectLeft,command.confirm~=false)
                result.ok=ok and true or false
                result.reason=reason
            elseif command.action=="home" then
                local ok,reason=orientationReturnHome()
                result.ok=ok and true or false
                result.reason=reason
            elseif command.action=="gps_repair" then
                local ok,reason=orientationGpsRepair()
                result.ok=ok and true or false
                result.reason=reason
            else
                result.reason="Unknown orientation command"
            end
            orientationMovementActive=false
        end
        state.orientationLastToken=command.token
        state.orientationLastResult=result
        save()
        send(cfg.foremanId,result)
        return true
    end

    local function advanceAck(stage,target)
        send(cfg.managerId,{type="chunk_ack",role="miner",row=cfg.row,
            stage=stage,chunkIndex=target,session=cfg.session})
    end

    local function runChestCollection(target)
        local collector=chestCollectorRow(math.floor((cfg.row-1)/4)+1)
        if cfg.row~=collector or state.recallMode or state.recoveryLocked then return false end
        if not state.advanceStage and (freeInventorySlots()<2 or
            (turtle.getFuelLevel()~="unlimited" and turtle.getFuelLevel()<24)) then
            sendState("Need two free slots and 24 fuel for chest collection")
            return false
        end
        state.advanceStage="CHEST"
        state.phase="ADVANCE_CHEST"
        state.chestProgress=tonumber(state.chestProgress) or 0
        if state.chestProgress<1 and state.x==cfg.row and state.z==-1 then
            state.chestProgress=1
        end
        if state.chestProgress==2 and state.x==cfg.row and state.z==-2 then
            state.chestProgress=3
        end
        if state.chestProgress==4 and state.x==cfg.row and state.z==-1 then
            state.chestProgress=5
        end
        if state.chestProgress==6 and state.x==cfg.row and state.z==0 then
            state.chestProgress=7
        end
        save()
        local function changed(before)
            for slot=1,16 do
                if turtle.getItemCount(slot)>(before[slot] or 0) then return slot end
            end
            return nil
        end
        local function digChest(which)
            local key=which=="dump" and "dumpSlot" or "fuelSlot"
            if state[key] then return true end
            if not state.chestIntent then
                local before={}
                for slot=1,16 do before[slot]=turtle.getItemCount(slot) end
                state.chestIntent={kind=which,before=before}
                save()
            end
            local slot=changed(state.chestIntent.before)
            if not slot and turtle.detect() then
                if not turtle.dig() then return false end
                slot=changed(state.chestIntent.before)
            end
            if not slot then
                for attempt=1,3 do
                    turtle.suck()
                    slot=changed(state.chestIntent.before)
                    if slot then break end
                    sleep(0.2)
                end
            end
            if not slot then return false end
            state[key]=slot
            state.chestIntent=nil
            save()
            return true
        end
        if state.chestProgress<1 then
            if not face(DIR_S) or not attemptForward() then return false end
            state.chestProgress=1;save()
        end
        if state.chestProgress<2 then
            if not face(DIR_S) or not digChest("fuel") then return false end
            state.chestProgress=2;save()
        end
        if state.chestProgress<3 then
            if not face(DIR_S) or not attemptForward() then return false end
            state.chestProgress=3;save()
        end
        if state.chestProgress<4 then
            if not face(DIR_W) or not digChest("dump") then return false end
            state.chestProgress=4;save()
        end
        if state.chestProgress<5 then
            if not face(DIR_N) or not attemptForward() then return false end
            state.chestProgress=5;save()
        end
        if state.chestProgress<6 then
            if not face(DIR_W) then return false end
            local slots={state.dumpSlot,state.fuelSlot}
            for _,slot in ipairs(slots) do
                if turtle.getItemCount(slot)>0 then
                    turtle.select(slot)
                    if not turtle.drop(1) then return false end
                end
            end
            state.chestProgress=6;save()
        end
        if state.chestProgress<7 then
            if not face(DIR_N) or not attemptForward() then return false end
            state.chestProgress=7;save()
        end
        state.chestCollected=true
        state.advanceStage="WAIT_CHEST"
        state.phase="COMPLETE"
        save()
        sendState("Ender chest pair delivered to Foreman-"..tostring(cfg.foremanNumber))
        advanceAck("COLLECT_M",target)
        return true
    end

    local function clearChunkAdvanceLane(moveError)
        local ok,peripheralType=pcall(peripheral.getType,"front")
        if ok and peripheralType then
            return false,"Next chunk travel lane occupied by peripheral "..tostring(peripheralType)
        end
        if turtle.detect() then
            local dug,digError=turtle.dig()
            if dug then return true end
            return false,"Could not clear next chunk block: "..tostring(digError or moveError or "dig failed")
        end
        turtle.attack()
        return true,moveError
    end

    local function runChunkMove(target)
        if state.recoveryLocked or state.recallMode or not state.complete or
            state.x~=cfg.row or state.y~=0 or state.z<0 or state.z>16 then return false end

        local function frontSupplyInventory()
            local inv=wrapInventory("front")
            if not inv then return nil end
            local ok,size=pcall(inv.getInventorySize)
            size=ok and tonumber(size) or nil
            if not size or size<=16 then return nil end
            return inv
        end

        local function changedSlot(before)
            return inventoryPositiveDelta(before)
        end

        if cfg.row==1 and state.chunkIndex<target then
            if state.supplyChestTarget and tonumber(state.supplyChestTarget)~=target then
                sendState("Supply chest move target does not match the requested chunk")
                return false
            end
            state.supplyChestTarget=target
            if not state.supplyChestCarried then
                if not face(DIR_W) then
                    sendState("Miner-1 could not face the supply chest")
                    return false
                end
                local intent=state.supplyChestIntent
                if not intent then
                    if not frontSupplyInventory() then
                        sendState("Black Blue Blue supply chest is not left of Miner-1 before chunk travel")
                        return false
                    end
                    if freeInventorySlots()<1 then
                        sendState("Miner-1 needs one free slot to move the Black Blue Blue supply chest")
                        return false
                    end
                    local before=turtleInventorySnapshot()
                    intent={before=before,target=target}
                    state.supplyChestIntent=intent
                    save()
                end

                local slot,delta=changedSlot(intent.before or {})
                if not slot or delta<1 then
                    if not frontSupplyInventory() then
                        sendState("Black Blue Blue supply chest disappeared before Miner-1 could collect it")
                        return false
                    end
                    local preferred=nil
                    for i=1,16 do
                        if turtle.getItemCount(i)==0 then preferred=i break end
                    end
                    if not preferred then
                        sendState("Miner-1 has no free slot for the Black Blue Blue supply chest")
                        return false
                    end
                    turtle.select(preferred)
                    local dug,digError=turtle.dig()
                    if not dug then
                        sendState("Miner-1 could not collect the Black Blue Blue supply chest: "..tostring(digError or "dig failed"))
                        return false
                    end
                    slot,delta=changedSlot(intent.before or {})
                    if not slot or delta<1 then
                        turtle.select(preferred)
                        turtle.suck()
                        slot,delta=changedSlot(intent.before or {})
                    end
                end
                if not slot or delta<1 then
                    sendState("Miner-1 broke the Black Blue Blue supply chest but did not recover its item")
                    return false
                end
                state.supplyChestSlot=slot
                state.supplyChestCarried=true
                state.supplyChestIntent=nil
                save()
            end
            if not face(DIR_N) then
                sendState("Miner-1 could not face north after collecting the supply chest")
                return false
            end
        end

        state.advanceStage="MOVE"
        state.phase="ADVANCE_MOVE"
        save()
        flags.advanceCancelled=false
        local ok,reason=travelChunkNorth(state,save,face,0,target,cfg.worldOrigin,function()
            return flags.advanceCancelled or flags.recallMode~=nil
        end,clearChunkAdvanceLane)
        if not ok then
            if flags.advanceCancelled or flags.recallMode then
                state.advanceStage=nil
                state.phase="RECALL_PENDING"
                save()
                sendState("Chunk travel cancelled for Regional Manager recall")
                return false
            end
            sendState(reason)
            return false
        end

        if cfg.row==1 and tonumber(state.supplyChestTarget)==target then
            if state.x~=1 or state.z~=0 then
                if state.x~=0 or state.z~=0 then
                    sendState("Miner-1 supply-chest placement recovery found an unexpected position")
                    return false
                end
            end
            if state.x==1 then
                if not face(DIR_W) then
                    sendState("Miner-1 could not face the new supply-chest position")
                    return false
                end
            end
            local placed=state.x==1 and frontSupplyInventory()~=nil
            if not placed then
                local slot=tonumber(state.supplyChestSlot)
                if state.x==1 then
                    pcall(turtle.dig)
                    sleep(0.1)
                    local occupied=turtle.detect()
                    if turtle.inspect then
                        local inspectOk,inspectPresent=pcall(turtle.inspect)
                        if inspectOk then occupied=inspectPresent==true end
                    end
                    if occupied then
                        sendState("Miner-1 could not clear the intended supply-chest square")
                        return false
                    end
                    local moved,moveError=attemptForward()
                    if not moved then
                        sendState("Miner-1 could not enter the intended supply-chest square: "..tostring(moveError or "move failed"))
                        return false
                    end
                    state.supplyChestPlacementStage="AT_TARGET"
                    save()
                elseif not face(DIR_W) then
                    sendState("Miner-1 could not face west while recovering supply-chest placement")
                    return false
                end

                local misplacedSupply=frontSupplyInventory()~=nil
                local before={}
                for i=1,16 do before[i]=turtle.getItemCount(i) end
                pcall(turtle.dig)
                local recoveredSlot,recoveredDelta=changedSlot(before)
                if misplacedSupply and recoveredSlot and recoveredDelta and recoveredDelta>0 then
                    state.supplyChestSlot=recoveredSlot
                    state.supplyChestCarried=true
                    slot=recoveredSlot
                end
                pcall(turtle.digUp)
                pcall(turtle.digDown)
                sleep(0.1)

                local frontOccupied=turtle.detect()
                if turtle.inspect then
                    local inspectOk,inspectPresent=pcall(turtle.inspect)
                    if inspectOk then frontOccupied=inspectPresent==true end
                end
                local upOccupied=turtle.detectUp()
                if turtle.inspectUp then
                    local inspectOk,inspectPresent=pcall(turtle.inspectUp)
                    if inspectOk then upOccupied=inspectPresent==true end
                end
                local downOccupied=turtle.detectDown()
                if turtle.inspectDown then
                    local inspectOk,inspectPresent=pcall(turtle.inspectDown)
                    if inspectOk then downOccupied=inspectPresent==true end
                end
                if frontOccupied or upOccupied or downOccupied then
                    sendState("Miner-1 could not fully clear the supply-chest placement pocket")
                    return false
                end

                if not face(DIR_E) then
                    sendState("Miner-1 could not turn back toward its chunk position")
                    return false
                end
                local movedBack,moveBackError=attemptForward()
                if not movedBack then
                    sendState("Miner-1 could not return from the supply-chest placement pocket: "..tostring(moveBackError or "move failed"))
                    return false
                end
                if not face(DIR_W) then
                    sendState("Miner-1 could not face the prepared supply-chest square")
                    return false
                end
                state.supplyChestPlacementStage="READY_PLACE"
                save()

                slot=tonumber(state.supplyChestSlot)
                if not state.supplyChestCarried or not slot or turtle.getItemCount(slot)<1 then
                    sendState("Miner-1 no longer has the Black Blue Blue supply chest after preparing its new position")
                    return false
                end
                turtle.select(slot)
                if not turtle.place() then
                    sendState("Miner-1 could not place the Black Blue Blue supply chest at the new chunk")
                    return false
                end
                placed=frontSupplyInventory()~=nil
            end
            if not placed then
                sendState("Miner-1 could not verify the Black Blue Blue supply chest at the new chunk")
                return false
            end
            state.supplyChestCarried=nil
            state.supplyChestSlot=nil
            state.supplyChestIntent=nil
            state.supplyChestTarget=nil
            state.supplyChestPlacementStage=nil
            save()
            if not face(DIR_N) then
                sendState("Miner-1 could not restore its north-facing chunk position")
                return false
            end
        end

        state.advanceStage="WAIT"
        state.phase="ADVANCE_WAIT"
        state.resumeZ=0
        save()
        checkpoint()
        advanceAck("MOVE_M",target)
        sendState(cfg.row==1 and "Supply chest moved; waiting for next chunk release" or
            "Waiting for next chunk release")
        return true
    end

    local function runPendingAdvance()
        local command=flags.advanceCommand
        if not command then return end
        flags.advanceCommand=nil
        if command.stage=="COLLECT_M" and not state.chestCollected then
            if not runChestCollection(command.target) then
                sendState("Chest collection blocked; check lane and inventory")
            end
        elseif command.stage=="MOVE_M" then
            local supplyPending=cfg.row==1 and tonumber(state.supplyChestTarget)==tonumber(command.target)
            if state.chunkIndex>=command.target and state.advanceStage=="WAIT" and not supplyPending then
                advanceAck("MOVE_M",command.target)
            elseif not runChunkMove(command.target) then
                if not flags.recallMode and not flags.advanceCancelled then
                    sendState("Chunk travel blocked")
                end
            end
        end
    end

    local function waitBlocked(reason,detail)
        state.phase="BLOCKED_MINING"
        state.blockedReason=reason
        state.blockedDetail=detail
        state.blockedRetryCount=(tonumber(state.blockedRetryCount) or 0)+1
        save()
        checkpoint()
        local lastReport=0
        local retryDelay=math.min(10*state.blockedRetryCount,60)
        local retryAt=now()+retryDelay

        while true do
            if flags.recallMode then
                return false
            end

            if flags.resume or now()>=retryAt then
                local automatic=not flags.resume
                flags.resume=false
                state.blockedReason=nil
                state.blockedDetail=nil
                state.phase="MINING"
                save()
                sendState(automatic and "Automatically retrying blocked mining action" or
                    "Retrying blocked mining action")
                return true
            end

            if now()-lastReport>=5 then
                local suffix=""
                if type(detail)=="table" then
                    suffix=" | detect="..tostring(detail.detected)..
                        " dig="..tostring(detail.digSuccess)..
                        " attack="..tostring(detail.attackSuccess)..
                        " move="..tostring(detail.forwardError or "blocked")
                end
                sendState("BLOCKED_MINING: " .. tostring(reason) .. suffix..
                    " | retry="..tostring(math.max(0,math.ceil(retryAt-now()))).."s")
                lastReport=now()
            end

            sleep(0.1)
        end
    end

    local function digForward()
        local attempts=0
        local lastForwardError=nil
        local lastDetected=nil
        local lastDigSuccess=nil
        local lastDigError=nil
        local lastAttackSuccess=nil
        local lastAttackError=nil

        while true do
            local nextZ=state.dir==DIR_N and state.z+1 or
                (state.dir==DIR_S and state.z-1 or nil)
            if state.x~=cfg.row or state.y>0 or not nextZ or
                nextZ<cfg.shaftMinZ or nextZ>cfg.shaftMaxZ then
                state.recoveryLocked=true
                state.recoveryReason="Miner refused to dig outside its assigned shaft"
                state.phase="RECOVERY_LOCK"
                save()
                sendState(state.recoveryReason)
                return false
            end
            if state.complete or state.phase=="COMPLETE" then
                return false
            end
            local moved,moveError=attemptForward()
            if moved then
                if state.blockedRetryCount or state.blockedReason or state.blockedDetail then
                    state.blockedRetryCount=nil
                    state.blockedReason=nil
                    state.blockedDetail=nil
                    save()
                end
                return true
            end
            lastForwardError=moveError
            if state.recoveryLocked or flags.recallMode then
                return false
            end

            attempts=attempts+1

            local ok,peripheralType=pcall(peripheral.getType,"front")
            if ok and peripheralType then
                state.recoveryLocked=true
                state.recoveryReason="Miner refused to dig a peripheral in its shaft"
                state.phase="RECOVERY_LOCK"
                state.blockedDetail={
                    attempts=attempts,
                    forwardError=lastForwardError,
                    peripheralType=peripheralType,
                    x=state.x,y=state.y,z=state.z,dir=state.dir,
                    fuel=turtle.getFuelLevel(),
                    freeSlots=freeInventorySlots()
                }
                save()
                sendState(state.recoveryReason)
                return false
            end

            lastDetected=turtle.detect()
            lastDigSuccess=nil
            lastDigError=nil
            lastAttackSuccess=nil
            lastAttackError=nil
            if lastDetected then
                lastDigSuccess,lastDigError=turtle.dig()
            else
                lastAttackSuccess,lastAttackError=turtle.attack()
            end

            if attempts>=MOVE_RETRY_LIMIT then
                local reason="Forward blocked at " .. tostring(state.x) .. "," .. tostring(state.y) .. "," .. tostring(state.z)
                local detail={
                    attempts=attempts,
                    forwardError=lastForwardError,
                    detected=lastDetected,
                    digSuccess=lastDigSuccess,
                    digError=lastDigError,
                    attackSuccess=lastAttackSuccess,
                    attackError=lastAttackError,
                    x=state.x,y=state.y,z=state.z,dir=state.dir,
                    depth=-state.y,
                    fuel=turtle.getFuelLevel(),
                    freeSlots=freeInventorySlots()
                }

                if not waitBlocked(reason,detail) then
                    return false
                end

                attempts=0
                lastForwardError=nil
                lastDetected=nil
                lastDigSuccess=nil
                lastDigError=nil
                lastAttackSuccess=nil
                lastAttackError=nil
            end

            sleep(0.15)
        end
    end

    local function moveUp()
        if state.y>=0 then
            return false
        end

        local attempts=0

        while not attemptUp() do
            if state.recoveryLocked or flags.recallMode then
                return false
            end

            attempts=attempts+1

            if turtle.detectUp() then
                turtle.digUp()
            else
                turtle.attackUp()
            end

            if attempts>=MOVE_RETRY_LIMIT then
                local reason="Upward movement blocked at " .. tostring(state.x) .. "," .. tostring(state.y) .. "," .. tostring(state.z)

                if not waitBlocked(reason) then
                    return false
                end

                attempts=0
            end

            sleep(0.15)
        end

        return true
    end

    local function moveDownExisting()
        local attempts=0

        while not attemptDown() do
            if state.recoveryLocked or flags.recallMode then
                return false
            end

            attempts=attempts+1

            if turtle.detectDown() then
                turtle.digDown()
            else
                turtle.attackDown()
            end

            if attempts>=MOVE_RETRY_LIMIT then
                local reason="Downward movement blocked at " .. tostring(state.x) .. "," .. tostring(state.y) .. "," .. tostring(state.z)

                if not waitBlocked(reason) then
                    return false
                end

                attempts=0
            end

            sleep(0.15)
        end

        return true
    end

    local function descendMine()
        if state.complete or state.phase=="COMPLETE" then return false end
        for i=1,5 do
            if state.recoveryLocked or flags.recallMode then
                return false
            end

            if turtle.detectDown() then
                turtle.digDown()
            else
                turtle.attackDown()
            end

            if attemptDown() then
                return true
            end

            sleep(0.15)
        end

        return false
    end

    local function clearMiningColumn()
        if state.complete or state.phase=="COMPLETE" then return end
        if state.y< -1 and turtle.detectUp() then
            turtle.digUp()
        end

        if turtle.detectDown() then
            turtle.digDown()
        end
    end

    local function descendMiningBand()
        local moved=0

        for i=1,3 do
            if descendMine() then
                moved=moved+1
            else
                break
            end
        end

        return moved
    end

    local function inventoryFull()
        for slot = 2,16 do
            if turtle.getItemCount(slot) == 0 then
                return false
            end
        end
        return true
    end

    local function distanceHome()
        return (-state.y) + state.z
    end

    local function neededService()
        if state.recallMode=="PACK" or state.phase=="PACK_COLLECT" or
            state.phase=="PACK_BLOCKED" or state.phase=="PACK_DONE" then
            return nil
        end
        local dump = inventoryFull()
        local fuel = turtle.getFuelLevel()
        local refuel = false
        if fuel ~= "unlimited" then
            refuel = fuel <= math.max(distanceHome() + MINER_SERVICE_RESERVE,MINER_FUEL_LOW)
        end
        if dump and refuel then
            return "BOTH"
        elseif dump then
            return "DUMP"
        elseif refuel then
            return "REFUEL"
        end
        return nil
    end

    local function goHome(recordResume)
        if state.recoveryLocked or not poseValid() then
            state.phase="RECOVERY_LOCK"
            state.recoveryReason=state.recoveryReason or "Unsafe miner pose; refusing automatic return"
            save()
            sendState(state.recoveryReason)
            return false
        end

        if recordResume then
            state.resumeX=state.x
            state.resumeY=state.y
            state.resumeZ=state.z
            state.resumeDepth=-state.y
            state.resumePos=state.z
            state.resumeDir=state.dir
            save()
        end

        while state.y<0 do
            if not moveUp() then
                return false
            end
        end

        if state.y~=cfg.homeY then
            state.recoveryLocked=true
            state.recoveryReason="Miner attempted to return above immutable surface bound"
            state.phase="RECOVERY_LOCK"
            save()
            sendState(state.recoveryReason)
            return false
        end

        if not verifySurfaceGps() then return false end

        if not face(DIR_S) then
            return false
        end

        while state.z>cfg.homeZ do
            if not digForward() then
                return false
            end
        end

        if state.z~=cfg.homeZ or state.x~=cfg.homeX or state.y~=cfg.homeY then
            state.recoveryLocked=true
            state.recoveryReason="Miner return ended outside immutable home bounds"
            state.phase="RECOVERY_LOCK"
            save()
            sendState(state.recoveryReason)
            return false
        end

        if not face(cfg.homeDir) then
            return false
        end

        checkpoint()
        return true
    end

    local function returnToMine()
        if state.recoveryLocked then
            return false
        end
        if state.packPending or state.recallMode=="PACK" or state.packDumpRequested or
            (state.request and state.request.packDump) then
            flags.start=false
            flags.resume=false
            sendState("Return to mine blocked while Pack It Up is pending")
            return false
        end

        if not face(DIR_N) then
            return false
        end

        while state.z<state.resumeZ do
            if not digForward() then
                return false
            end
        end

        while state.y>state.resumeY do
            if not moveDownExisting() then
                return false
            end
        end

        if state.x~=state.resumeX or state.y~=state.resumeY or state.z~=state.resumeZ then
            state.recoveryLocked=true
            state.recoveryReason="Miner could not reconstruct saved work position"
            state.phase="RECOVERY_LOCK"
            save()
            sendState(state.recoveryReason)
            return false
        end

        if not face(state.resumeDir) then
            return false
        end

        state.phase="MINING"
        state.request=nil
        save()
        checkpoint()
        sendState("Resumed")
        return true
    end

    prepareForForemanService=function()
        if state.x~=cfg.homeX or state.y~=cfg.homeY or state.z~=cfg.homeZ then
            return false
        end
        if not face(DIR_S) then return false end
        return true
    end

    local function refuelSelf(kind)
        local selected=turtle.getSelectedSlot()
        local burned={}
        if turtle.getFuelLevel()~="unlimited" then
            for _,priority in ipairs(FUEL_PRIORITY) do
                for slot=1,16 do
                    local detail=turtle.getItemDetail and turtle.getItemDetail(slot)
                    if matchesItem(detail,priority) or
                        (not detail and kind==priority and turtle.getItemCount(slot)>0) then
                        turtle.select(slot)
                        while turtle.getFuelLevel()<MINER_FUEL_TARGET and
                            turtle.getItemCount(slot)>0 and turtle.refuel(0) do
                            if not turtle.refuel(1) then break end
                            burned[slot]=true
                        end
                    end
                end
            end
        end
        local returned=true
        for slot=1,16 do
            if turtle.getItemCount(slot)>0 then
                turtle.select(slot)
                local detail=turtle.getItemDetail and turtle.getItemDetail(slot)
                local empty=matchesItem(detail,"empty_bucket") or
                    (kind=="lava_bucket" and burned[slot] and not turtle.refuel(0))
                local unusedLava=matchesItem(detail,"lava_bucket") or
                    (kind=="lava_bucket" and turtle.refuel(0) and
                     not detail and not burned[slot])
                if empty or unusedLava then
                    if not turtle.drop() then returned=false end
                end
            end
        end
        turtle.select(selected)
        return turtle.getFuelLevel()=="unlimited" or
            turtle.getFuelLevel()>=MINER_FUEL_TARGET,returned
    end

    local function service(kind,finalService,resumeExisting)
        if not resumeExisting then
            state.requestSeq=(state.requestSeq or 0)+1
            state.request={
                id=tostring(os.getComputerID()) .. ":" .. tostring(state.requestSeq),
                kind=kind,
                finalService=finalService and true or false
            }
            state.phase="RETURNING_SERVICE"
            save()
            requestPacket(false)
            sendState("Service requested")

            if not goHome(true) then
                return false
            end
        else
            if not state.request then
                state.recoveryLocked=true
                state.recoveryReason="Service phase exists without a persisted request"
                state.phase="RECOVERY_LOCK"
                save()
                return false
            end

            kind=state.request.kind or kind
            finalService=state.request.finalService and true or false

            if state.phase=="RETURNING_SERVICE" then
                if not goHome(false) then
                    return false
                end
            elseif state.phase~="WAITING_SERVICE" then
                state.recoveryLocked=true
                state.recoveryReason="Unexpected persisted service phase"
                state.phase="RECOVERY_LOCK"
                save()
                return false
            end
        end

        if not face(DIR_S) then
            return false
        end

        flags.serviceProbe=nil
        flags.refuelNow=false
        flags.serviceComplete=false

        state.phase="WAITING_SERVICE"
        save()
        checkpoint()
        requestPacket(true)
        sendState("Waiting south-facing for Foreman-" .. tostring(cfg.foremanNumber))

        while not flags.serviceComplete do
            if flags.recallMode then
                return false
            end

            if flags.serviceProbe then
                local requestId=flags.serviceProbe
                flags.serviceProbe=nil

                if prepareForForemanService() then
                    send(cfg.foremanId,{
                        type="service_probe_ack",
                        requestId=requestId,
                        row=state.row,
                        x=state.x,
                        y=state.y,
                        z=state.z,
                        dir=state.dir
                    })
                else
                    send(cfg.foremanId,{
                        type="service_not_adjacent",
                        requestId=requestId,
                        row=state.row
                    })
                end
            end

            if flags.refuelNow then
                flags.refuelNow=false
                local refueled,bucketReturned=refuelSelf(state.runtimeFuelKind)
                send(cfg.foremanId,{
                    type="refuel_complete",
                    refueled=refueled,
                    bucketReturned=bucketReturned,
                    row=state.row,
                    requestId=state.request.id,
                    fuel=turtle.getFuelLevel()
                })
            end
            sleep(0.1)
        end

        flags.serviceComplete=false
        local wasFinal=state.request.finalService and true or false
        local wasRecallDump=state.request.recallDump and true or false
        local wasPackDump=state.request.packDump and true or false
        state.lastCompletedRequest=state.request.id
        state.request=nil
        save()
        send(cfg.managerId,{
            type="service_complete_ack",
            requestId=state.lastCompletedRequest,
            session=cfg.session
        })

        if wasRecallDump then
            state.phase="RECALLED_PAUSED"
            state.recallMode=wasPackDump and "PACK" or "DUMP"
            state.packDumpRequested=nil
            if wasPackDump then state.packDumpComplete=true end
            face(DIR_N)
            save()
            checkpoint()
            send(cfg.managerId,{
                type="recall_dump_empty",
                role="miner",
                row=state.row,
                id=os.getComputerID(),
                mode=state.recallMode,
                x=state.x,
                y=state.y,
                z=state.z,
                dir=state.dir,
                session=cfg.session
            })
            sendState(wasPackDump and "Pack dump complete; paused at home" or "Dump recall complete; paused at home")
            return true
        end

        if wasFinal then
            state.phase="COMPLETE"
            face(DIR_N)
            save()
            checkpoint()
            sendState("Final dump complete")
            return true
        end

        state.phase="RETURNING_MINE"
        save()
        return returnToMine()
    end

    local function minerRecoveryReasonIsPositional(reason)
        reason=tostring(reason or "")
        return reason=="" or
            reason:find("interrupted",1,true)~=nil or
            reason:find("Position ambiguous",1,true)~=nil or
            reason:find("Facing ambiguous",1,true)~=nil or
            reason:find("Fuel differs",1,true)~=nil or
            reason:find("GPS position differs",1,true)~=nil or
            reason:find("GPS differs from saved pose",1,true)~=nil or
            reason:find("GPS facing recovery",1,true)~=nil or
            reason:find("possible world rollback",1,true)~=nil or
            reason:find("Cannot resolve interrupted Miner-16 pack move",1,true)~=nil or
            reason:find("Cannot verify miner position against Regional Manager for recall",1,true)~=nil or
            reason:find("Manager and local miner positions disagree after reboot",1,true)~=nil
    end

    local function validRecoveryPhase(phase)
        return phase=="MINING" or phase=="RETURNING_SERVICE" or
            phase=="WAITING_SERVICE" or phase=="RETURNING_MINE" or
            phase=="WAITING" or phase=="COMPLETE" or
            phase=="RECALLED_PAUSED"
    end

    local function recoverPhaseFromAuthority(authority)
        local phase=state.recoveryPhase
        if not validRecoveryPhase(phase) and type(authority)=="table" then
            phase=authority.phase
        end
        if not state.request and type(authority)=="table" and type(authority.request)=="table" then
            state.request=authority.request
        end
        if type(authority)=="table" then
            if type(authority.resumeX)=="number" then state.resumeX=authority.resumeX end
            if type(authority.resumeY)=="number" then state.resumeY=authority.resumeY end
            if type(authority.resumeZ)=="number" then state.resumeZ=authority.resumeZ end
            if type(authority.resumeDir)=="number" then state.resumeDir=authority.resumeDir end
        end
        if state.request then
            if state.x==cfg.homeX and state.y==cfg.homeY and state.z==cfg.homeZ then
                return "WAITING_SERVICE"
            end
            return "RETURNING_SERVICE"
        end
        if phase=="RETURNING_MINE" then return phase end
        if phase=="MINING" then return phase end
        if phase=="RECALLED_PAUSED" and state.recallMode then return phase end
        if state.complete then return "COMPLETE" end
        if state.y<cfg.homeY or state.z>cfg.homeZ then return "MINING" end
        return "WAITING"
    end

    local function adoptPhysicalMinerPose(authority,authoritySeq)
        if state.recallMode=="PACK" or state.packAssetProgress or state.advanceStage or
            state.chunkMoveIntent or state.packStepIntent or
            state.phase=="PACK_COLLECT" or state.phase=="PACK_BLOCKED" or
            state.phase=="PACK_DONE" then return false end
        local gx,gy,gz=locateWorldPose(2)
        if not gx then return false end
        local lx,ly,lz=worldToLocalPose(gx,gy,gz,state.chunkIndex,cfg.worldOrigin)
        if lx==nil or lx~=cfg.homeX or ly>cfg.homeY or
            lz<cfg.shaftMinZ or lz>cfg.shaftMaxZ then
            return false
        end

        local candidate=loadWorldPoseCandidate(path,cfg.worldOrigin,gx,gy,gz)
        if candidate and candidate.row==cfg.row and candidate.phase~="RECOVERY_LOCK" then
            if not state.request and type(candidate.request)=="table" then state.request=candidate.request end
            if type(candidate.resumeX)=="number" then state.resumeX=candidate.resumeX end
            if type(candidate.resumeY)=="number" then state.resumeY=candidate.resumeY end
            if type(candidate.resumeZ)=="number" then state.resumeZ=candidate.resumeZ end
            if type(candidate.resumeDir)=="number" then state.resumeDir=candidate.resumeDir end
            if validRecoveryPhase(candidate.phase) then state.recoveryPhase=candidate.phase end
        end
        local semanticKnown=state.request~=nil or validRecoveryPhase(state.recoveryPhase) or
            (type(authority)=="table" and validRecoveryPhase(authority.phase))
        if not semanticKnown then return false end

        state.x=lx
        state.y=ly
        state.z=lz
        state.depth=-ly
        state.pos=lz
        state.motionIntent=nil
        state.turnIntent=nil
        state.chunkMoveIntent=nil
        state.packStepIntent=nil

        local recoveredDir,dirReason=recoverFacingByGPS(state,cfg.worldOrigin,function() save(); return true end)
        if not recoveredDir then
            local phase=recoverPhaseFromAuthority(authority)
            if phase=="MINING" and lz==cfg.shaftMinZ then
                recoveredDir=DIR_N
            elseif phase=="MINING" and lz==cfg.shaftMaxZ then
                recoveredDir=DIR_S
            else
                state.recoveryReason=dirReason or "Could not recover miner facing after world rollback"
                return false
            end
        end
        state.dir=recoveredDir
        state.phase=recoverPhaseFromAuthority(authority)
        state.recoveryPhase=nil
        state.recoveryLocked=nil
        state.recoveryReason=nil
        state.seq=math.max(tonumber(state.seq) or 0,tonumber(authoritySeq) or 0)+1
        state.fuelWitness=turtle.getFuelLevel()
        save()
        checkpoint()
        if debugLog then
            debugLog("RECOVERY","Adopted physical GPS pose after server rollback row="..
                tostring(cfg.row).." x="..tostring(state.x).." y="..tostring(state.y)..
                " z="..tostring(state.z).." phase="..tostring(state.phase),"WARN")
        end
        return true
    end

    local function attemptMinerRecovery()
        local priorReason=state.recoveryLocked and state.recoveryReason or nil
        local hadPending=state.motionIntent or state.turnIntent or state.chunkMoveIntent or
            state.recoveryProbeIntent or
            (state.packStepIntent and state.packStepIntent.stage=="MOVING")
        local authority,authoritySeq=requestPoseBackup("miner",2,cfg.session)
        if not authority then
            authority=bootManagerState
            authoritySeq=bootManagerSeq
        end

        if state.chunkMoveIntent then
            resolveChunkMove(state,function() save() end,cfg.worldOrigin)
            if state.chunkMoveIntent and not minerRecoveryReasonIsPositional(priorReason) then return false end
        end

        local unresolvedMove=false
        if state.motionIntent then
            local intent=state.motionIntent
            local moved=movementFromFuel(intent.fuelBefore,turtle.getFuelLevel())
            if moved==nil then moved=movementFromGPS(intent,state.chunkIndex,cfg.worldOrigin,2) end
            if moved==nil or type(intent.from)~="table" or type(intent.to)~="table" then
                unresolvedMove=true
            else
                local pose=moved and intent.to or intent.from
                state.x=pose.x
                state.y=pose.y
                state.z=pose.z
                state.dir=pose.dir
                state.depth=-state.y
                state.pos=state.z
                if moved and tonumber(intent.seq) then state.seq=math.max(state.seq,tonumber(intent.seq)) end
                state.motionIntent=nil
            end
        end

        local unresolvedTurn=false
        if state.recoveryProbeIntent and not state.turnIntent and not unresolvedMove then
            local recoveredDir=recoverFacingByGPS(state,cfg.worldOrigin,function() save(); return true end)
            if recoveredDir==nil then
                unresolvedTurn=true
            else
                state.dir=recoveredDir
            end
        end
        if state.turnIntent and not unresolvedMove then
            local recoveredDir=recoverFacingByGPS(state,cfg.worldOrigin,function() save(); return true end)
            if recoveredDir==nil then
                unresolvedTurn=true
            else
                state.dir=recoveredDir
                if tonumber(state.turnIntent.seq) then state.seq=math.max(state.seq,tonumber(state.turnIntent.seq)) end
                state.turnIntent=nil
            end
        end

        if state.packStepIntent and state.packStepIntent.stage=="MOVING" and not unresolvedMove then
            local moved=movementFromFuel(state.packStepIntent.fuelBefore,turtle.getFuelLevel())
            local fromX=tonumber(state.packStepIntent.fromX) or state.x
            local toX=tonumber(state.packStepIntent.toX) or (fromX-1)
            if moved==nil then
                moved=movementFromGPS({
                    from={x=fromX,y=state.y,z=state.z},
                    to={x=toX,y=state.y,z=state.z}
                },state.chunkIndex,cfg.worldOrigin,2)
            end
            if moved==nil then return false end
            if moved then
                state.x=toX
                state.seq=state.seq+1
                state.packStepIntent=nil
            else
                state.packStepIntent.stage="DUG"
            end
        end

        if unresolvedMove or unresolvedTurn or state.chunkMoveIntent or
            (state.recoveryLocked and minerRecoveryReasonIsPositional(priorReason)) then
            if adoptPhysicalMinerPose(authority,authoritySeq) then return true end
            return false
        end

        if state.motionIntent or state.turnIntent or state.chunkMoveIntent then return false end
        if not poseValid() then
            if adoptPhysicalMinerPose(authority,authoritySeq) then return true end
            return false
        end

        if state.recoveryLocked then
            if not hadPending and not minerRecoveryReasonIsPositional(priorReason) then return false end
            local x,y,z=locateWorldPose(2)
            if not x then return false end
            if not poseMatchesWorld(state,cfg.worldOrigin,x,y,z) then
                if adoptPhysicalMinerPose(authority,authoritySeq) then return true end
                return false
            end
        end

        state.recoveryLocked=nil
        state.recoveryReason=nil
        state.recoveryPhase=nil
        if state.phase=="RECOVERY_LOCK" then state.phase=recoverPhaseFromAuthority(authority) end
        state.fuelWitness=turtle.getFuelLevel()
        save()
        checkpoint()
        return true
    end

    local function applyManagerRecoveryPose()
        local snapshot,seq=requestPoseBackup("miner",5,cfg.session)
        if not snapshot or not snapshotHasExactPose(snapshot) then
            return poseValid() and not state.recoveryLocked
        end

        local incoming=tonumber(seq or snapshot.seq or 0) or 0
        if not poseValid() or state.recoveryLocked or incoming>state.seq or
            (incoming==state.seq and
                (state.x~=snapshot.x or state.y~=snapshot.y or
                 state.z~=snapshot.z or state.dir~=snapshot.dir)) then
            state.recoveryLocked=true
            state.recoveryReason="Cannot verify miner position against Regional Manager for recall"
            state.phase="RECOVERY_LOCK"
            save()
            return false
        end
        if state.seq>incoming then checkpoint() end
        return true
    end

    local function stagePackDumpAtHome()
        if state.recallMode~="PACK" or not state.packDumpRequested then return false end
        if state.x~=cfg.homeX or state.y~=cfg.homeY or state.z~=cfg.homeZ then return false end
        if not state.request then
            state.requestSeq=(state.requestSeq or 0)+1
            state.request={
                id=tostring(os.getComputerID()) .. ":pack:" .. tostring(state.requestSeq),
                kind="DUMP",
                finalService=false,
                recallDump=true,
                packDump=true
            }
        else
            state.request.recallDump=true
            state.request.packDump=true
            state.request.finalService=false
            if state.request.kind=="REFUEL" then state.request.kind="BOTH" end
        end
        state.packDumpRequested=nil
        state.phase="WAITING_SERVICE"
        save()
        requestPacket(true)
        sendState("Pack dump waiting for Foreman-"..tostring(cfg.foremanNumber))
        return true
    end

    local function recall(mode)
        mode=mode or flags.recallMode or "NORMAL"
        flags.recallMode=nil
        flags.start=false
        flags.resume=false

        if mode=="PACK" then
            state.recallResume=nil
            state.packPending=nil
            flags.start=false
            flags.resume=false
            save()
        elseif not state.recallResume then
            state.recallResume={
                x=state.x,
                y=state.y,
                z=state.z,
                dir=state.dir,
                phase=state.phase,
                complete=state.complete and true or false
            }
            save()
        end

        if not applyManagerRecoveryPose() then
            return false
        end

        if state.recoveryLocked then
            state.phase="RECOVERY_LOCK"
            save()
            sendState("Recall refused: " .. tostring(state.recoveryReason or "position uncertain"))
            return false
        end

        state.phase="RECALLING"
        state.recallMode=mode
        state.blockedReason=nil
        state.blockedDetail=nil
        if mode=="PACK" then
            state.packReady=nil
            state.packAcknowledged=nil
            state.packError=nil
            state.packMissing=nil
            state.packStepIntent=nil
            state.packDeposited=nil
            state.packDepositedCount=nil
            state.packSupplyCount=nil
            state.packOverflowTrip=nil
            state.packOverflowReturnX=nil
            state.packOverflowStage=nil
            state.packOverflowBeforeSupply=nil
            state.packOverflowBeforeCargo=nil
            state.packAssetsReady=nil
            state.packAssetsAcknowledged=nil
            state.packAssetProgress=nil
            state.packAssetIntent=nil
            state.packAssetError=nil
            state.packAssetFuel=nil
            state.packAssetDump=nil
            state.packAssetForeman=nil
            state.packAssetNavigator=nil
            state.packAssetNavigatorInventoryDrained=nil
            state.packAssetNavigatorInventoryDrainedCount=nil
            state.packAssetFuelRetained=nil
            state.packAssetFuelSlot=nil
            state.packAssetFuelRestored=nil
            state.packAssetFuelRestoreIntent=nil
        end
        save()
        sendState("Regional Manager recall: " .. tostring(mode))

        if not goHome(false) then
            state.phase="RECOVERY_LOCK"
            state.recoveryLocked=true
            state.recoveryReason=state.recoveryReason or "Recall could not prove home position"
            save()
            sendState(state.recoveryReason)
            return false
        end

        if not face(DIR_N) then
            return false
        end

        if state.x~=cfg.homeX or state.y~=cfg.homeY or
            state.z~=cfg.homeZ or state.dir~=cfg.homeDir then
            state.phase="RECOVERY_LOCK"
            state.recoveryLocked=true
            state.recoveryReason="Recall home verification failed"
            save()
            sendState(state.recoveryReason)
            return false
        end

        state.phase="RECALLED_PAUSED"
        save()
        checkpoint()

        send(cfg.managerId,{
            type="recall_home",
            role="miner",
            row=state.row,
            id=os.getComputerID(),
            mode=mode,
            packToken=mode=="PACK" and state.packToken or nil,
            labelCleared=false,
            x=state.x,
            y=state.y,
            z=state.z,
            dir=state.dir,
            freeSlots=freeInventorySlots(),
            session=cfg.session
        })

        if mode=="DUMP" then
            if not state.request then
                state.requestSeq=(state.requestSeq or 0)+1
                state.request={
                    id=tostring(os.getComputerID()) .. ":recall:" .. tostring(state.requestSeq),
                    kind="DUMP",
                    finalService=false,
                    recallDump=true
                }
                save()
            else
                state.request.recallDump=true
                if state.request.kind=="REFUEL" then
                    state.request.kind="BOTH"
                end
                save()
            end
            requestPacket(true)
            state.phase="WAITING_SERVICE"
            save()
        elseif mode=="PACK" and state.packDumpRequested then
            if not stagePackDumpAtHome() then
                state.phase="RECOVERY_LOCK"
                state.recoveryLocked=true
                state.recoveryReason="Pack dump could not be staged at miner home"
                save()
                sendState(state.recoveryReason)
                return false
            end
        elseif mode=="SHUTDOWN" then
            for i=1,5 do
                os.setComputerLabel(nil)
                if os.getComputerLabel()==nil then
                    break
                end
                sleep(0.1)
            end

            if os.getComputerLabel()~=nil then
                state.phase="RECOVERY_LOCK"
                state.recoveryLocked=true
                state.recoveryReason="Reached home but could not clear computer label"
                save()
                sendState(state.recoveryReason)
                return false
            end

            for shutdownAttempt=1,8 do
                send(cfg.managerId,{
                    type="recall_shutdown_ready",
                    role="miner",
                    row=state.row,
                    id=os.getComputerID(),
                    x=state.x,
                    y=state.y,
                    z=state.z,
                    dir=state.dir,
                    session=cfg.session
                })
                sleep(0.1)
            end
            os.shutdown()
        end

        return true
    end

    local function resumeFromRecall()
        if state.packPending or state.recallMode=="PACK" or state.packDumpRequested or
            (state.request and state.request.packDump) then
            flags.start=false
            flags.resume=false
            save()
            sendState("Resume ignored while Pack It Up is pending")
            return true
        end
        if not state.recallResume then
            state.phase="WAITING"
            state.recallMode=nil
            flags.start=true
            save()
            return true
        end

        local resume=state.recallResume

        if resume.complete then
            state.complete=true
            state.phase="COMPLETE"
            state.recallResume=nil
            state.recallMode=nil
            save()
            return true
        end

        if resume.phase=="WAITING_SERVICE" or resume.phase=="RETURNING_SERVICE" then
            state.phase="WAITING_SERVICE"
            state.recallResume=nil
            state.recallMode=nil
            face(DIR_S)
            save()
            checkpoint()
            if state.request then
                requestPacket(true)
            end
            return true
        end

        if resume.phase=="WAITING" then
            state.phase="WAITING"
            state.recallResume=nil
            state.recallMode=nil
            flags.start=true
            face(DIR_N)
            save()
            checkpoint()
            return true
        end

        state.resumeX=resume.x
        state.resumeY=resume.y
        state.resumeZ=resume.z
        state.resumeDir=resume.dir
        state.resumeDepth=-resume.y
        state.resumePos=resume.z
        state.phase="RETURNING_MINE"
        state.recallMode=nil
        save()

        if not returnToMine() then
            return false
        end

        state.phase="MINING"
        state.recallResume=nil
        state.recallMode=nil
        save()
        checkpoint()
        return true
    end

    local collectPackedMiners
    local collectPackAssets

    local function waitRecalledPause()
        while state.phase=="RECALLED_PAUSED" do
            if state.packDumpRequested and state.recallMode=="PACK" then
                if not stagePackDumpAtHome() then return false end
                return true
            elseif flags.packAssets and isChestCollector(cfg.row) and cfg.row~=WORKER_COUNT and
                state.recallMode=="PACK" then
                flags.packAssets=false
                if not collectPackAssets() then return false end
            elseif flags.packCollect and cfg.row==WORKER_COUNT and state.recallMode=="PACK" then
                flags.packCollect=false
                if not collectPackedMiners() then
                    return state.phase=="PACK_BLOCKED"
                end
                return true
            elseif state.packAssetsReady and not state.packAssetsAcknowledged and
                now()-(state.lastPackAssetSend or -10)>=2 then
                local cargoCount=0
                for slot=1,16 do cargoCount=cargoCount+turtle.getItemCount(slot) end
                send(cfg.managerId,{
                    type="pack_assets_ready",role="miner",row=cfg.row,
                    packToken=state.packToken,foremanCollected=state.packAssetForeman==true,
                    navigatorCollected=state.packAssetNavigator==true,
                    dumpCollected=state.packAssetDump==true,fuelCollected=state.packAssetFuel==true,
                    fuelRetained=state.packAssetFuelRetained==true,cargoCount=cargoCount,
                    x=state.x,y=state.y,z=state.z,dir=state.dir,session=cfg.session
                })
                state.lastPackAssetSend=now()
            elseif state.packReady and not state.packAcknowledged and now()-(state.lastPackSend or -10)>=2 then
                send(cfg.managerId,{
                    type="pack_ready",role="miner",row=cfg.row,
                    packToken=state.packToken,labelCleared=true,
                    x=state.x,y=state.y,z=state.z,dir=state.dir,session=cfg.session
                })
                state.lastPackSend=now()
            elseif flags.recallMode then
                local nextMode=flags.recallMode
                flags.recallMode=nil
                if nextMode~=state.recallMode then
                    if not recall(nextMode) then return false end
                end
            elseif flags.resume then
                flags.resume=false
                if not resumeFromRecall() then return false end
            else
                sleep(0.1)
            end
        end
        return not state.recoveryLocked
    end

    collectPackAssets=function()
        if state.recallMode~="PACK" or not isChestCollector(cfg.row) or cfg.row==WORKER_COUNT then
            return false
        end

        local group=math.floor((cfg.row-1)/4)+1
        local function inventoryTotal()
            local total=0
            for slot=1,16 do total=total+turtle.getItemCount(slot) end
            return total
        end
        local function blocked(reason)
            state.phase="RECALLED_PAUSED"
            state.packAssetError=tostring(reason or "Pack asset collection blocked")
            save()
            send(cfg.managerId,{type="pack_assets_blocked",row=cfg.row,
                reason=state.packAssetError,packToken=state.packToken,session=cfg.session})
            sendState(state.packAssetError)
            return false
        end
        local function moveTo(tx,tz)
            while state.x<tx do if not face(DIR_E) or not attemptForward() then return false end end
            while state.x>tx do if not face(DIR_W) or not attemptForward() then return false end end
            while state.z<tz do if not face(DIR_N) or not attemptForward() then return false end end
            while state.z>tz do if not face(DIR_S) or not attemptForward() then return false end end
            return true
        end
        local function collectAsset(flagName,label,direction)
            if state[flagName] then return true end
            local intent=state.packAssetIntent
            if not intent or intent.flag~=flagName then
                local beforeSlots={}
                for slot=1,16 do beforeSlots[slot]=turtle.getItemCount(slot) end
                intent={flag=flagName,beforeTotal=inventoryTotal(),beforeSlots=beforeSlots,direction=direction}
                state.packAssetIntent=intent
                save()
            end
            local before=tonumber(intent.beforeTotal) or inventoryTotal()
            local detect=direction=="up" and turtle.detectUp or turtle.detect
            local dig=direction=="up" and turtle.digUp or turtle.dig
            local suck=direction=="up" and turtle.suckUp or turtle.suck
            if detect() then
                local empty=nil
                for slot=1,16 do
                    if turtle.getItemCount(slot)==0 then empty=slot break end
                end
                if not empty then return blocked("No empty slot is available to collect "..label) end
                turtle.select(empty)
                local ok,reason=dig()
                if not ok then return blocked("Could not collect "..label..": "..tostring(reason or "dig failed")) end
            end
            for attempt=1,64 do
                local moved=false
                for slot=1,16 do
                    turtle.select(slot)
                    if suck() then moved=true break end
                end
                if not moved then break end
            end
            if inventoryTotal()<=before then
                return blocked(label.." was not recovered into Miner-"..tostring(cfg.row).." inventory")
            end
            local beforeSlots=type(intent.beforeSlots)=="table" and intent.beforeSlots or {}
            for slot=1,16 do
                if turtle.getItemCount(slot)>(tonumber(beforeSlots[slot]) or 0) then
                    state[flagName.."Slot"]=slot
                    break
                end
            end
            state[flagName]=true
            state.packAssetIntent=nil
            save()
            return true
        end
        local function drainAssetInventory(flagName,label,direction,minimum)
            if state[flagName] then return true end
            local suck=direction=="up" and turtle.suckUp or turtle.suck
            local before=inventoryTotal()
            local pulls=0
            while pulls<64 do
                local moved=false
                for slot=1,16 do
                    turtle.select(slot)
                    if suck() then
                        moved=true
                        pulls=pulls+1
                        break
                    end
                end
                if not moved then break end
            end
            local recovered=inventoryTotal()-before
            if recovered<(tonumber(minimum) or 0) then
                return blocked(label.." did not transfer its required carried item before collection")
            end
            state[flagName]=true
            state[flagName.."Count"]=recovered
            save()
            return true
        end

        local function restoreAsset(flagName,label,direction)
            local restoredKey=flagName.."Restored"
            local intentKey=flagName.."RestoreIntent"
            if state[restoredKey] then return true end
            local slot=tonumber(state[flagName.."Slot"])
            if not slot or turtle.getItemCount(slot)<=0 then
                return blocked("Cannot identify "..label.." in Miner-"..tostring(cfg.row).." inventory for restoration")
            end
            local detect=direction=="up" and turtle.detectUp or turtle.detect
            local inspect=direction=="up" and turtle.inspectUp or turtle.inspect
            local place=direction=="up" and turtle.placeUp or turtle.place
            local function occupied()
                if inspect then
                    local ok,present=pcall(inspect)
                    if ok then return present==true end
                end
                return detect()
            end
            local intent=state[intentKey]
            if not intent then
                intent={slot=slot,beforeCount=turtle.getItemCount(slot)}
                state[intentKey]=intent
                save()
            end
            local beforeCount=tonumber(intent.beforeCount) or turtle.getItemCount(slot)
            local currentCount=turtle.getItemCount(slot)
            if currentCount<beforeCount then
                local verified
                if direction=="front" then
                    verified=wrapInventory("front")~=nil
                else
                    verified=occupied()
                end
                if not verified then
                    return blocked(label.." left Miner-"..tostring(cfg.row).." inventory but is not at the expected restore position")
                end
                state[restoredKey]=true
                state[intentKey]=nil
                save()
                return true
            end
            if direction=="front" then
                local protectedType=peripheral.getType("front")
                if protectedType then return blocked(label.." restore position contains a protected peripheral") end
                pcall(turtle.dig)
            else
                local protectedType=peripheral.getType("top")
                if protectedType then return blocked(label.." restore position contains a protected peripheral") end
                pcall(turtle.digUp)
            end
            sleep(0.1)
            if occupied() then return blocked(label.." restore position could not be normalized") end
            turtle.select(slot)
            local ok,reason=place()
            if not ok then return blocked("Could not restore "..label..": "..tostring(reason or "place failed")) end
            if turtle.getItemCount(slot)>=beforeCount then
                return blocked(label.." did not leave Miner-"..tostring(cfg.row).." inventory during restoration")
            end
            local verified
            if direction=="front" then
                verified=wrapInventory("front")~=nil
            else
                verified=occupied()
            end
            if not verified then
                return blocked(label.." was placed but is not at the expected restore position")
            end
            state[restoredKey]=true
            state[intentKey]=nil
            save()
            return true
        end

        if state.packAssetsReady then
            state.phase="RECALLED_PAUSED"
            save()
            return true
        end
        if not state.packAssetProgress then
            local needed=5
            if freeInventorySlots()<needed then
                return blocked("Miner-"..tostring(cfg.row).." needs "..tostring(needed).." free slots for pack hardware")
            end
            if state.x~=cfg.row or state.y~=0 or state.z~=0 then
                return blocked("Miner-"..tostring(cfg.row).." is not at its home row for pack hardware collection")
            end
            state.packAssetProgress=true
            state.packAssetError=nil
            state.phase="PACK_ASSETS"
            save()
        else
            state.phase="PACK_ASSETS"
            save()
        end

        if group==1 then
            if not moveTo(cfg.row,-1) or not face(DIR_S) then
                return blocked("Miner-2 could not reach Foreman-1's fuel Ender Chest")
            end
            if not collectAsset("packAssetFuel","Foreman-1 fuel Ender Chest","front") then return false end
            if not moveTo(cfg.row,-2) or not face(DIR_W) then
                return blocked("Miner-2 could not reach Foreman-1's dump Ender Chest")
            end
            if not collectAsset("packAssetDump","Foreman-1 dump Ender Chest","front") then return false end
            if not moveTo(cfg.row,-1) or not face(DIR_W) then
                return blocked("Miner-2 could not reach Foreman-1")
            end
            if not collectAsset("packAssetForeman","Foreman-1","front") then return false end
            if not moveTo(cfg.row-1,-1) then
                return blocked("Miner-2 could not enter the Foreman-1 square")
            end
            if not drainAssetInventory("packAssetNavigatorInventoryDrained","GPS Navigator-1 inventory","up",1) then return false end
            if not collectAsset("packAssetNavigator","GPS Navigator-1","up") then return false end
            if not moveTo(cfg.row,-1) or not face(DIR_S) then
                return blocked("Miner-2 could not return beside Foreman-1's fuel chest position")
            end
            if not restoreAsset("packAssetFuel","Foreman-1 fuel Ender Chest","front") then return false end
            state.packAssetFuelRetained=true
            save()
            if not moveTo(cfg.row,0) then
                return blocked("Miner-2 could not return home after pack hardware collection")
            end
        else
            if not moveTo(cfg.row,-1) or not face(DIR_S) then
                return blocked("Miner-"..tostring(cfg.row).." could not reach its fuel Ender Chest")
            end
            if not collectAsset("packAssetFuel","Foreman-"..tostring(group).." fuel Ender Chest","front") then return false end
            if not moveTo(cfg.row,-2) or not face(DIR_W) then
                return blocked("Miner-"..tostring(cfg.row).." could not reach its dump Ender Chest")
            end
            if not collectAsset("packAssetDump","Foreman-"..tostring(group).." dump Ender Chest","front") then return false end
            if not moveTo(cfg.row,-1) or not face(DIR_W) then
                return blocked("Miner-"..tostring(cfg.row).." could not reach Foreman-"..tostring(group))
            end
            if not collectAsset("packAssetForeman","Foreman-"..tostring(group),"front") then return false end
            if not moveTo(cfg.row-1,-1) then
                return blocked("Miner-"..tostring(cfg.row).." could not enter Foreman-"..tostring(group).." square")
            end
            if not drainAssetInventory("packAssetNavigatorInventoryDrained","GPS Navigator-"..tostring(group).." inventory","up",group==3 and 1 or 0) then return false end
            if not collectAsset("packAssetNavigator","GPS Navigator-"..tostring(group),"up") then return false end
            if not moveTo(cfg.row,-1) or not moveTo(cfg.row,0) then
                return blocked("Miner-"..tostring(cfg.row).." could not return home after pack hardware collection")
            end
        end

        if not face(DIR_N) then return blocked("Miner-"..tostring(cfg.row).." could not face north after pack hardware collection") end
        state.packAssetsReady=true
        state.packAssetsAcknowledged=nil
        state.packAssetProgress=nil
        state.packAssetIntent=nil
        state.packAssetError=nil
        state.phase="RECALLED_PAUSED"
        save()
        send(cfg.managerId,{
            type="pack_assets_ready",role="miner",row=cfg.row,
            packToken=state.packToken,foremanCollected=state.packAssetForeman==true,
            navigatorCollected=state.packAssetNavigator==true,
            dumpCollected=state.packAssetDump==true,fuelCollected=state.packAssetFuel==true,
            fuelRetained=state.packAssetFuelRetained==true,cargoCount=inventoryTotal(),
            x=state.x,y=state.y,z=state.z,dir=state.dir,session=cfg.session
        })
        sendState("Pack hardware secured for Foreman-"..tostring(group))
        return true
    end

    collectPackedMiners=function()
        if cfg.row~=WORKER_COUNT or state.recallMode~="PACK" or state.y~=0 then
            return false
        end

        local function inventoryTotal()
            local total=0
            for slot=1,16 do total=total+turtle.getItemCount(slot) end
            return total
        end

        local function sideInventoryTotal(side)
            local items=scanInventory(side)
            if type(items)~="table" then return nil end
            local total=0
            for _,item in pairs(items) do
                total=total+tonumber(item.qty or item.size or 1)
            end
            return total
        end

        local function reportMissing(row)
            state.packMissing=state.packMissing or {}
            for _,missing in ipairs(state.packMissing) do
                if missing==row then return end
            end
            state.packMissing[#state.packMissing+1]=row
            save()
            send(cfg.managerId,{type="pack_missing",row=WORKER_COUNT,
                missing=row,packToken=state.packToken,session=cfg.session})
            sendState("Miner-"..tostring(row).." item not collected")
        end

        local function packBlock(reason)
            state.phase="PACK_BLOCKED"
            state.packError=tostring(reason or "Pack collection blocked")
            state.recoveryLocked=false
            state.recoveryReason=nil
            save()
            send(cfg.managerId,{
                type="pack_blocked",row=WORKER_COUNT,x=state.x,
                reason=state.packError,packToken=state.packToken,session=cfg.session
            })
            sendState(state.packError)
            return false
        end

        local function mergeSlot(source)
            if turtle.getItemCount(source)<=0 then return true end
            local selected=turtle.getSelectedSlot and turtle.getSelectedSlot() or 1
            for target=1,16 do
                if target~=source and turtle.getItemCount(target)>0 then
                    turtle.select(source)
                    turtle.transferTo(target)
                    if turtle.getItemCount(source)==0 then break end
                end
            end
            turtle.select(selected)
            return turtle.getItemCount(source)==0
        end

        local function compactInventory()
            local selected=turtle.getSelectedSlot and turtle.getSelectedSlot() or 1
            for source=16,1,-1 do
                if turtle.getItemCount(source)>0 then
                    for target=1,16 do
                        if target~=source and turtle.getItemCount(target)>0 then
                            turtle.select(source)
                            turtle.transferTo(target)
                            if turtle.getItemCount(source)==0 then break end
                        end
                    end
                end
            end
            turtle.select(selected)
            return freeInventorySlots()
        end

        local function selectEmptySlot(doCompact)
            if doCompact~=false then compactInventory() end
            for slot=1,16 do
                if turtle.getItemCount(slot)==0 then
                    turtle.select(slot)
                    return slot
                end
            end
            return nil
        end

        local function suckAndMergeFront()
            for slot=1,16 do
                if turtle.getItemCount(slot)>0 then
                    turtle.select(slot)
                    if turtle.suck() then
                        mergeSlot(slot)
                        return true
                    end
                end
            end
            local slot=selectEmptySlot(false)
            if slot and turtle.suck() then
                mergeSlot(slot)
                return true
            end
            return false
        end

        local function moveGroundTo(tx,tz)
            while state.z>tz do
                if not face(DIR_S) then return false,"turn south failed" end
                local ok,reason=attemptForward()
                if not ok then return false,reason end
            end
            while state.z<tz do
                if not face(DIR_N) then return false,"turn north failed" end
                local ok,reason=attemptForward()
                if not ok then return false,reason end
            end
            while state.x>tx do
                if not face(DIR_W) then return false,"turn west failed" end
                local ok,reason=attemptForward()
                if not ok then return false,reason end
            end
            while state.x<tx do
                if not face(DIR_E) then return false,"turn east failed" end
                local ok,reason=attemptForward()
                if not ok then return false,reason end
            end
            return true,nil
        end

        local function dropAllIntoFront()
            for slot=1,16 do
                if turtle.getItemCount(slot)>0 then
                    turtle.select(slot)
                    if not turtle.drop() then return false,slot end
                end
            end
            return inventoryTotal()==0,nil
        end

        local function continueOverflowTrip()
            local returnX=tonumber(state.packOverflowReturnX)
            if not returnX or returnX<2 or returnX>WORKER_COUNT then
                return packBlock("Miner-16 overflow return position is invalid")
            end
            local stage=state.packOverflowStage or "TO_SUPPLY"
            if stage=="TO_SUPPLY" then
                local ok,reason=moveGroundTo(state.x,-1)
                if not ok then return packBlock("Miner-16 could not enter the pack overflow lane: "..tostring(reason)) end
                ok,reason=moveGroundTo(0,-1)
                if not ok then return packBlock("Miner-16 could not reach the Black Blue Blue supply chest overflow position: "..tostring(reason)) end
                if not face(DIR_N) then return packBlock("Miner-16 could not face the supply chest from the overflow lane") end
                if not wrapInventory("front") then return packBlock("Black Blue Blue supply chest is missing during pack overflow") end
                local beforeSupply=sideInventoryTotal("front")
                if beforeSupply==nil then return packBlock("Black Blue Blue supply chest could not be counted during pack overflow") end
                state.packOverflowBeforeSupply=beforeSupply
                state.packOverflowBeforeCargo=inventoryTotal()
                state.packOverflowStage="DEPOSIT"
                save()
                stage="DEPOSIT"
            end
            if stage=="DEPOSIT" then
                if not face(DIR_N) or not wrapInventory("front") then
                    return packBlock("Black Blue Blue supply chest is unavailable during pack overflow deposit")
                end
                local cargo=tonumber(state.packOverflowBeforeCargo) or inventoryTotal()
                local beforeSupply=tonumber(state.packOverflowBeforeSupply)
                if not beforeSupply then return packBlock("Pack overflow supply baseline is missing") end
                local ok,slot=dropAllIntoFront()
                if not ok then return packBlock("Miner-16 could not deposit overflow inventory slot "..tostring(slot)) end
                local afterSupply=sideInventoryTotal("front")
                if afterSupply==nil or afterSupply<beforeSupply+cargo then
                    return packBlock("Supply chest did not receive the complete Miner-16 overflow deposit")
                end
                state.packDepositedCount=(tonumber(state.packDepositedCount) or 0)+cargo
                state.packSupplyCount=afterSupply
                state.packOverflowStage="RETURN"
                save()
                stage="RETURN"
            end
            if stage=="RETURN" then
                local ok,reason=moveGroundTo(returnX,-1)
                if not ok then return packBlock("Miner-16 could not return through the pack overflow lane: "..tostring(reason)) end
                ok,reason=moveGroundTo(returnX,0)
                if not ok then return packBlock("Miner-16 could not return to the pack collection lane: "..tostring(reason)) end
                if not face(DIR_W) then return packBlock("Miner-16 could not restore west-facing pack alignment") end
                state.packOverflowTrip=nil
                state.packOverflowReturnX=nil
                state.packOverflowStage=nil
                state.packOverflowBeforeSupply=nil
                state.packOverflowBeforeCargo=nil
                state.packError=nil
                save()
                return true
            end
            return true
        end

        local function startOverflowTrip()
            compactInventory()
            if inventoryTotal()==0 then return true end
            state.packOverflowTrip=true
            state.packOverflowReturnX=state.x
            state.packOverflowStage="TO_SUPPLY"
            state.packOverflowBeforeSupply=nil
            state.packOverflowBeforeCargo=nil
            save()
            return continueOverflowTrip()
        end

        if state.packOverflowTrip then
            if not continueOverflowTrip() then return false end
        end

        compactInventory()

        if state.x<1 or state.x>WORKER_COUNT or state.z~=0 then
            return packBlock("Miner-16 is outside the pack collection lane")
        end

        if state.x==WORKER_COUNT and not state.packStepIntent then
            if (tonumber(state.packDepositedCount) or 0)==0 and inventoryTotal()>0 then
                return packBlock("Miner-16 must complete the pre-pack dump before collecting the swarm")
            end
            if state.dir==DIR_N then
                if not turnStep(false) then
                    return packBlock("Miner-16 could not turn left for pack collection")
                end
            elseif state.dir~=DIR_W then
                return packBlock("Miner-16 is not facing north at the start of pack collection")
            end
        elseif state.dir~=DIR_W and state.x>1 then
            return packBlock("Miner-16 lost west-facing pack alignment")
        end

        state.phase="PACK_COLLECT"
        state.packError=nil
        save()

        while state.x>1 do
            local targetRow=state.x-1
            local cargoMinimum=0
            if isChestCollector(targetRow) then
                if targetRow==chestCollectorRow(1) then
                    cargoMinimum=4
                elseif targetRow==chestCollectorRow(3) then
                    cargoMinimum=5
                else
                    cargoMinimum=4
                end
            end
            local reportedCargo=state.packCargoCounts and tonumber(state.packCargoCounts[targetRow]) or nil
            local cargoExpected=math.max(cargoMinimum,reportedCargo or 0)
            local expected=cargoExpected+1
            if not state.packStepIntent and freeInventorySlots()<expected then
                compactInventory()
                if freeInventorySlots()<expected and not startOverflowTrip() then return false end
            end
            if not state.packStepIntent then
                if freeInventorySlots()<expected then
                    return packBlock("Miner-16 still lacks inventory space after overflow deposit")
                end
                if not turtle.detect() then
                    return packBlock("Expected parked Miner-"..tostring(targetRow).." in the pack lane")
                end
                state.packStepIntent={
                    stage=cargoExpected>0 and "DRAINING" or "DIGGING",
                    targetRow=targetRow,
                    beforeTotal=inventoryTotal(),
                    cargoExpected=cargoExpected,
                    expected=expected
                }
                save()
            end

            if state.packStepIntent.targetRow and state.packStepIntent.targetRow~=targetRow then
                return packBlock("Pack step target no longer matches Miner-16 position")
            end

            if state.packStepIntent.stage=="DRAINING" then
                local before=tonumber(state.packStepIntent.beforeTotal) or inventoryTotal()
                local requiredCargo=tonumber(state.packStepIntent.cargoExpected) or cargoExpected
                if not turtle.detect() then
                    return packBlock("Hardware collector Miner-"..tostring(targetRow)..
                        " disappeared before its inventory was drained")
                end
                local recoveredCargo=inventoryTotal()-before
                local pulls=0
                while pulls<64 do
                    if not suckAndMergeFront() then break end
                    pulls=pulls+1
                    recoveredCargo=inventoryTotal()-before
                end
                compactInventory()
                recoveredCargo=inventoryTotal()-before
                if recoveredCargo<requiredCargo then
                    reportMissing(targetRow)
                    return packBlock("Miner-16 drained "..tostring(recoveredCargo).."/"..
                        tostring(requiredCargo).." required hardware items from Miner-"..
                        tostring(targetRow).." before collection")
                end
                local remaining=sideInventoryTotal("front")
                if remaining and remaining>0 then
                    return packBlock("Miner-"..tostring(targetRow).." still holds "..
                        tostring(remaining).." item(s) after pack drain")
                end
                state.packStepIntent.actualCargo=recoveredCargo
                state.packStepIntent.stage="DIGGING"
                state.packStepIntent.beforeDigTotal=inventoryTotal()
                save()
            end

            if state.packStepIntent.stage=="DIGGING" then
                local before=tonumber(state.packStepIntent.beforeDigTotal)
                if not before then
                    before=inventoryTotal()
                    state.packStepIntent.beforeDigTotal=before
                    save()
                end
                if turtle.detect() then
                    local captureSlot=selectEmptySlot(false)
                    if not captureSlot then
                        compactInventory()
                        captureSlot=selectEmptySlot(false)
                        if not captureSlot then
                            return packBlock("Miner-16 has no slot for Miner-"..tostring(targetRow))
                        end
                    end
                    local dug,digError=turtle.dig()
                    if not dug then
                        return packBlock("Could not break parked Miner-"..tostring(targetRow)..
                            ": "..tostring(digError or "dig failed"))
                    end
                    mergeSlot(captureSlot)
                end
                local recovered=inventoryTotal()-before
                if recovered<1 then
                    for attempt=1,4 do
                        local captureSlot=selectEmptySlot(false)
                        if not captureSlot then
                            compactInventory()
                            captureSlot=selectEmptySlot(false)
                        end
                        if not captureSlot then break end
                        if turtle.suck() then
                            mergeSlot(captureSlot)
                            recovered=inventoryTotal()-before
                            if recovered>=1 then break end
                        end
                        sleep(0.05)
                    end
                end
                recovered=inventoryTotal()-before
                if recovered<1 then
                    reportMissing(targetRow)
                    return packBlock("Miner-16 did not recover the Miner-"..tostring(targetRow)..
                        " turtle after draining its inventory")
                end
                state.packStepIntent.stage="DUG"
                state.packStepIntent.beforeTotal=nil
                state.packStepIntent.beforeDigTotal=nil
                save()
            end

            state.packStepIntent.stage="MOVING"
            state.packStepIntent.fromX=state.x
            state.packStepIntent.toX=state.x-1
            state.packStepIntent.fuelBefore=turtle.getFuelLevel()
            save()

            local moved=false
            local lastMoveError=nil
            local deadline=now()+10
            while now()<deadline do
                local ok,moveError=turtle.forward()
                if ok then
                    moved=true
                    break
                end
                lastMoveError=moveError
                turtle.attack()
                sleep(0.25)
            end
            if not moved then
                state.packStepIntent.stage="DUG"
                save()
                return packBlock("Pack lane blocked before Miner-"..tostring(targetRow)..
                    ": "..tostring(lastMoveError or "forward failed"))
            end

            state.x=state.x-1
            state.seq=state.seq+1
            state.packStepIntent=nil
            state.packError=nil
            save()
            checkpoint()
            send(cfg.managerId,{type="pack_progress",row=WORKER_COUNT,x=state.x,
                collected=WORKER_COUNT-state.x,missing=state.packMissing,
                packToken=state.packToken,session=cfg.session})
            if state.x>1 then
                sendState("Packed " .. tostring(WORKER_COUNT-state.x) .. "/"..
                    tostring(WORKER_COUNT-1).."; next Miner-" .. tostring(state.x-1))
            else
                sendState("Packed " .. tostring(WORKER_COUNT-1) .. "/"..
                    tostring(WORKER_COUNT-1).."; parked at Miner-1")
            end
        end

        if not state.packDeposited then
            if not face(DIR_N) then return packBlock("Miner-16 could not face north at the supply station") end
            if not face(DIR_W) then return packBlock("Miner-16 could not face the Black Blue Blue supply chest") end
            if not wrapInventory("front") then
                return packBlock("Black Blue Blue supply chest is not left of Miner-1's position")
            end
            local supplyBefore=sideInventoryTotal("front")
            local depositing=inventoryTotal()
            if supplyBefore==nil then return packBlock("Black Blue Blue supply chest could not be counted before final deposit") end
            if depositing<1 then return packBlock("Miner-16 has no final packed items to deposit") end
            local ok,slot=dropAllIntoFront()
            if not ok then return packBlock("Miner-16 could not deposit final inventory slot "..tostring(slot).." into the supply chest") end
            local supplyAfter=sideInventoryTotal("front")
            if supplyAfter==nil or supplyAfter<supplyBefore+depositing then
                return packBlock("Supply chest item count did not increase by the full final Miner-16 deposit")
            end
            state.packDepositedCount=(tonumber(state.packDepositedCount) or 0)+depositing
            state.packSupplyCount=supplyAfter
            if state.packDepositedCount<30 then
                return packBlock("Miner-16 verified only "..tostring(state.packDepositedCount).."/30 required pack items in the supply chest")
            end
            state.packDeposited=true
            save()
        end

        if not face(DIR_N) then return packBlock("Miner-16 could not face north after depositing the packed swarm") end
        for attempt=1,5 do
            os.setComputerLabel(nil)
            if os.getComputerLabel()==nil then break end
            sleep(0.1)
        end
        if os.getComputerLabel()~=nil then
            return packBlock("Miner-16 could not clear its label after pack collection")
        end

        state.phase="PACK_DONE"
        state.packError=nil
        save()
        for i=1,5 do
            send(cfg.managerId,{type="pack_done",row=WORKER_COUNT,x=state.x,
                collected=WORKER_COUNT-1,missing=state.packMissing,deposited=true,
                depositedCount=state.packDepositedCount,supplyCount=state.packSupplyCount,
                packToken=state.packToken,session=cfg.session})
            sleep(0.1)
        end
        sendState("Pack complete; swarm deposited in supply chest")
        sleep(0.2)
        os.shutdown()
        return true
    end

    local function handleRecallRequest()
        if not flags.recallMode then
            return true
        end
        if state.advanceStage=="CHEST" then
            if state.x==cfg.row-1 and state.z==-1 then
                if not face(DIR_E) or not attemptForward() then return false end
            end
            if state.x~=cfg.row or state.y~=0 or state.z<-2 or state.z>0 then
                sendState("Chest recall requires a clear collector return lane")
                return false
            end
            while state.z<0 do
                if not face(DIR_N) or not attemptForward() then
                    sendState("Chest recall return lane blocked")
                    return false
                end
            end
            state.advanceStage=nil
            state.chestProgress=0
            state.chestCollected=nil
            if state.fuelSlot and turtle.getItemCount(state.fuelSlot)==0 then
                state.fuelSlot=nil
            end
            if state.dumpSlot and turtle.getItemCount(state.dumpSlot)==0 then
                state.dumpSlot=nil
            end
            state.phase="COMPLETE"
            save()
            checkpoint()
        elseif state.advanceStage=="WAIT_CHEST" then
            state.advanceStage=nil
            state.chestProgress=0
            state.chestCollected=nil
            state.fuelSlot=nil
            state.dumpSlot=nil
            state.phase="COMPLETE"
            save()
        end
        local mode=flags.recallMode
        if not recall(mode) then
            return false
        end
        if state.phase=="WAITING_SERVICE" and state.request and state.request.recallDump then
            if not service(state.request.kind or "DUMP",false,true) then
                if flags.recallMode then
                    return handleRecallRequest()
                end
                return false
            end
        end
        return waitRecalledPause()
    end

    send(cfg.managerId,{
        type="node_online",
        role="miner",
        row=state.row,
        minerId=os.getComputerID(),
        foremanId=cfg.foremanId,
        session=cfg.session,
        x=state.x,
        y=state.y,
        z=state.z,
        dir=state.dir,
        phase=state.phase,
        seq=state.seq
    })
    for i=1,5 do
        send(cfg.foremanId,{
            type="miner_runtime_ready",
            row=state.row,
            minerId=os.getComputerID()
        })
        sleep(0.1)
    end

    local function workLoop()
        while state.recoveryLocked do
            if flags.orientationCommand then
                processOrientationCommand()
                if not state.recoveryLocked then break end
            end
            if state.phase~="RECOVERY_LOCK" then
                state.recoveryPhase=state.phase
                state.phase="RECOVERY_LOCK"
                save()
            end
            if attemptMinerRecovery() then break end
            sendState("Movement recovery waiting: " .. tostring(state.recoveryReason or "pose uncertain"))
            sleep(2)
        end

        checkpoint()

        if state.phase=="PACK_DONE" then
            for i=1,5 do
                send(cfg.managerId,{type="pack_done",row=WORKER_COUNT,x=state.x,
                    collected=WORKER_COUNT-1,missing=state.packMissing,
                    deposited=state.packDeposited==true,
                    depositedCount=state.packDepositedCount,supplyCount=state.packSupplyCount,
                    packToken=state.packToken,session=cfg.session})
                sleep(0.1)
            end
            sendState("Pack complete; swarm deposited in supply chest")
            sleep(0.2)
            os.shutdown()
            return
        end

        if state.phase=="PACK_COLLECT" then
            collectPackedMiners()
        end

        while state.phase=="PACK_BLOCKED" do
            if flags.packCollect then
                flags.packCollect=false
                state.packError=nil
                save()
                collectPackedMiners()
            else
                sendState(state.packError or "Pack collection blocked")
                sleep(1)
            end
        end

        if state.phase=="PACK_DONE" then
            return
        end

        if cfg.row==WORKER_COUNT and state.recallMode=="PACK" and
            (state.phase=="PACK_COLLECT" or state.phase=="PACK_BLOCKED") then
            return
        end

        if state.phase=="RECALLED_PAUSED" then
            if not waitRecalledPause() then return end
            if state.phase=="PACK_COLLECT" then
                collectPackedMiners()
            end
            while state.phase=="PACK_BLOCKED" do
                if flags.packCollect then
                    flags.packCollect=false
                    state.packError=nil
                    save()
                    collectPackedMiners()
                else
                    sendState(state.packError or "Pack collection blocked")
                    sleep(1)
                end
            end
            if state.phase=="PACK_DONE" then return end
        end

        if state.complete and not state.advanceStage and not state.request and
            state.phase~="RECALLED_PAUSED" then
            state.phase="COMPLETE"
            save()
        end

        while state.phase=="WAITING" and not flags.start do
            if flags.orientationCommand then
                processOrientationCommand()
            elseif flags.recallMode then
                if not handleRecallRequest() then return end
            elseif flags.resume then
                flags.resume=false
                if not resumeFromRecall() then return end
            end
            sleep(0.1)
        end

        if state.phase=="COMPLETE" or state.advanceStage then
            while true do
                if not flags.recallMode and not state.advanceStage and
                    turtle.getFuelLevel()~="unlimited" and
                    turtle.getFuelLevel()<MINER_FUEL_TARGET then
                    if not service("REFUEL",true) then return end
                    state.complete=true
                    state.phase="COMPLETE"
                    save()
                end
                if flags.recallMode and
                    (not state.advanceStage or state.advanceStage=="CHEST" or
                     state.advanceStage=="WAIT_CHEST") then
                    if not handleRecallRequest() and state.recoveryLocked then return end
                elseif flags.resume then
                    flags.resume=false
                    if not resumeFromRecall() then return end
                else
                    runPendingAdvance()
                end
                sleep(0.2)
            end
        end

        local resumedFinalService=false
        if state.phase=="WAITING_SERVICE" or state.phase=="RETURNING_SERVICE" then
            local kind=state.request and state.request.kind or "DUMP"
            local ok=service(kind,state.request and state.request.finalService,true)
            resumedFinalService=ok and state.phase=="COMPLETE"
            if not ok and flags.recallMode then
                if not handleRecallRequest() then return end
            end
            if state.phase=="RECALLED_PAUSED" then
                if not waitRecalledPause() then return end
            end
        elseif state.phase=="RETURNING_MINE" then
            if not returnToMine() then return end
        elseif state.phase=="MINING" then
        else
            state.phase="WAITING"
            save()

            while not flags.start do
                if flags.orientationCommand then
                    processOrientationCommand()
                elseif flags.recallMode then
                    if not handleRecallRequest() then return end
                elseif flags.resume then
                    flags.resume=false
                    if not resumeFromRecall() then return end
                end
                sleep(0.1)
            end

            state.phase="MINING"
            save()
        end

        if resumedFinalService then return end

        local function finishMining()
            sendState("Bedrock reached")

            local finalKind=turtle.getFuelLevel()~="unlimited" and
                turtle.getFuelLevel()<=MINER_FUEL_LOW and "BOTH" or "DUMP"
            local serviceOk=service(finalKind,true)
            if not serviceOk and flags.recallMode then
                if not handleRecallRequest() then return false end
                if state.phase=="WAITING_SERVICE" or state.phase=="RETURNING_SERVICE" then
                    serviceOk=service(finalKind,true,true)
                end
            end

            if not serviceOk then
                return false
            end

            state.complete=true
            state.phase="COMPLETE"
            save()
            sendState("Chunk complete at home")

            send(cfg.managerId,{
                type="miner_complete",
                row=state.row,
                minerId=os.getComputerID(),
                foremanId=cfg.foremanId,
                foremanNumber=cfg.foremanNumber,
                session=cfg.session
            })

            while true do
                if not flags.recallMode and not state.advanceStage and
                    turtle.getFuelLevel()~="unlimited" and
                    turtle.getFuelLevel()<MINER_FUEL_TARGET then
                    if not service("REFUEL",true) then return false end
                    state.complete=true
                    state.phase="COMPLETE"
                    save()
                end
                if flags.recallMode and
                    (not state.advanceStage or state.advanceStage=="CHEST" or
                     state.advanceStage=="WAIT_CHEST") then
                    if not handleRecallRequest() and state.recoveryLocked then return false end
                else
                    runPendingAdvance()
                end
                sleep(0.2)
            end
        end

        if state.phase=="MINING" and state.y==0 and not state.complete then
            if not descendMine() then
                if not finishMining() then return end
            end
        end

        while true do
            if state.complete or state.phase=="COMPLETE" then return end
            if flags.recallMode then
                if not handleRecallRequest() then return end
            end

            if state.phase=="RECALLED_PAUSED" then
                if not waitRecalledPause() then return end
            end

            if state.dir~=DIR_N and state.dir~=DIR_S then
                state.phase="RECOVERY_LOCK"
                state.recoveryLocked=true
                state.recoveryReason="Miner entered mining loop facing an invalid horizontal direction"
                save()
                sendState(state.recoveryReason)
                return
            end

            local kind=neededService()
            if kind then
                local ok=service(kind)
                if not ok and flags.recallMode then
                    if not handleRecallRequest() then return end
                end
                if state.phase=="RECALLED_PAUSED" then
                    if not waitRecalledPause() then return end
                end
            end

            if state.dir==DIR_N then
                while state.pos<15 do
                    if flags.recallMode then
                        if not handleRecallRequest() then return end
                    end

                    local needed=neededService()
                    if needed then
                        local ok=service(needed)
                        if not ok and flags.recallMode then
                            if not handleRecallRequest() then return end
                        end
                        if state.phase=="RECALLED_PAUSED" then
                            if not waitRecalledPause() then return end
                        end
                    end

                    clearMiningColumn()

                    if flags.recallMode then
                        if not handleRecallRequest() then return end
                    end

                    if not digForward() and flags.recallMode then
                        if not handleRecallRequest() then return end
                    end
                    sleep(0)
                end

                clearMiningColumn()
                sleep(0)

                if descendMiningBand()==0 then
                    if not finishMining() then return end
                end

                if not face(DIR_S) then
                    state.phase="RECOVERY_LOCK"
                    state.recoveryLocked=true
                    state.recoveryReason="Could not turn south for next mining pass"
                    save()
                    sendState(state.recoveryReason)
                    return
                end
            else
                while state.pos>0 do
                    if flags.recallMode then
                        if not handleRecallRequest() then return end
                    end

                    local needed=neededService()
                    if needed then
                        local ok=service(needed)
                        if not ok and flags.recallMode then
                            if not handleRecallRequest() then return end
                        end
                        if state.phase=="RECALLED_PAUSED" then
                            if not waitRecalledPause() then return end
                        end
                    end

                    clearMiningColumn()

                    if flags.recallMode then
                        if not handleRecallRequest() then return end
                    end

                    if not digForward() and flags.recallMode then
                        if not handleRecallRequest() then return end
                    end
                    sleep(0)
                end

                clearMiningColumn()
                sleep(0)

                if descendMiningBand()==0 then
                    if not finishMining() then return end
                end

                if not face(DIR_N) then
                    state.phase="RECOVERY_LOCK"
                    state.recoveryLocked=true
                    state.recoveryReason="Could not turn north for next mining pass"
                    save()
                    sendState(state.recoveryReason)
                    return
                end
            end
        end
    end

    local function heartbeatLoop()
        while true do
            sleep(5)
            pcall(openNetwork)
            pcall(sendState,"Heartbeat")
        end
    end

    local function runWorkLoop()
        while true do
            workLoop()
            sendState("Miner work loop restarting from saved state")
            sleep(2)
        end
    end
    parallel.waitForAny(networkLoop, heartbeatLoop, runWorkLoop)
end


local cfg=loadTable("node.cfg")
if not cfg or cfg.role~="miner" then
    error("Miner role file requires miner node.cfg")
end

setRegionalManager(cfg.managerId)

local cfgVersion=tonumber(cfg.version)
if cfgVersion and cfgVersion>=56 and cfgVersion<VERSION then
    cfg.version=VERSION
    saveTable("node.cfg",cfg)
elseif cfgVersion~=VERSION then
    error("Unsupported miner node state version")
end

if cfg.commissioned then
    runMiner(cfg)
else
    runMinerCommissioning(cfg)
end
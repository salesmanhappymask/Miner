dofile("common")
local cfg=loadTable("node.cfg")
if not cfg then
    print("node.cfg missing or unreadable")
    return
end
local role=cfg.role
local path
if role=="miner" then
    path="miner.tmp"
elseif role=="foreman" then
    path="foreman" .. tostring(cfg.number) .. ".tmp"
elseif role=="navigator" then
    path="navigator" .. tostring(cfg.number) .. ".tmp"
else
    print("Unknown role: " .. tostring(role))
    return
end
print("ID " .. tostring(os.getComputerID()) .. " " .. tostring(role) .. " v" .. tostring(cfg.version))
print("Session " .. tostring(cfg.session))
for _,name in ipairs({path,path .. ".new",path .. ".bak"}) do
    local snapshot=decodeTable(name)
    if snapshot then
        print(name .. " gen=" .. tostring(snapshot.__saveGeneration or 0) ..
            " seq=" .. tostring(snapshot.seq or 0))
        print("  pose=" .. tostring(snapshot.x) .. "," .. tostring(snapshot.y) ..
            "," .. tostring(snapshot.z) .. " dir=" .. tostring(snapshot.dir))
        print("  phase=" .. tostring(snapshot.phase) ..
            " locked=" .. tostring(snapshot.recoveryLocked))
        print("  reason=" .. tostring(snapshot.recoveryReason))
        print("  savedFuel=" .. tostring(snapshot.fuelWitness) ..
            " currentFuel=" .. tostring(turtle.getFuelLevel()))
        print("  intent=" .. tostring(snapshot.motionIntent and snapshot.motionIntent.kind or
            snapshot.verticalIntent and "vertical" or
            snapshot.turnIntent and "turn" or "none"))
    else
        print(name .. " absent/unreadable")
    end
end
print("fuel=" .. tostring(turtle.getFuelLevel()))
openNetwork()
local x,y,z=gps.locate(2,false)
if x then
    print("GPS=" .. tostring(x) .. "," .. tostring(y) .. "," .. tostring(z))
    local snapshot=loadTableLight(path)
    if snapshot and cfg.worldOrigin then
        local ex,ey,ez=worldPose(snapshot.x,snapshot.y,snapshot.z,
            snapshot.chunkIndex,cfg.worldOrigin)
        print("Saved world=" .. tostring(ex) .. "," .. tostring(ey) ..
            "," .. tostring(ez))
    end
else
    print("GPS unavailable")
end

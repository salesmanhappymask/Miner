function pairMasterWithRegionalManager()
    if not openNetwork() then
        error("Wireless modem not found")
    end

    local myId=os.getComputerID()
    local lastSeek=-10
    local lastLookup=-10
    local lookupId=nil

    local function showPairing(status)
        term.setBackgroundColor(colors.black)
        term.setTextColor(colors.white)
        term.clear()
        term.setCursorPos(1,1)
        print("Master Foreman " .. tostring(myId))
        print("Pairing with Regional Manager")
        print("")
        print(status)
    end

    showPairing("Searching...")

    while true do
        if now()-lastLookup>=2 then
            local ok,result=pcall(rednet.lookup,PROTOCOL,"regional_manager")
            if ok then
                lookupId=tonumber(result)
            end
            lastLookup=now()
        end

        if now()-lastSeek>=2 then
            local packet={
                type="master_pair_seek",
                version=VERSION,
                masterForemanId=myId
            }
            if lookupId and lookupId~=myId then
                send(lookupId,packet)
                showPairing("Manager found: " .. tostring(lookupId) .. " / requesting pair")
            else
                broadcast(packet)
                showPairing("Searching... broadcasting pair request")
            end
            lastSeek=now()
        end

        local sender,message=rednet.receive(PROTOCOL,0.5)

        if sender and type(message)=="table" and
            message.type=="manager_pair_offer" and message.version==VERSION and
            (not message.masterForemanId or tonumber(message.masterForemanId)==myId) then
            showPairing("Offer from Manager " .. tostring(sender))
            send(sender,{
                type="master_pair_accept",
                version=VERSION,
                masterForemanId=myId,
                managerId=sender,
                nonce=message.nonce
            })

            local deadline=now()+5
            while now()<deadline do
                local s,m=rednet.receive(PROTOCOL,0.5)
                if s==sender and type(m)=="table" and
                    m.type=="manager_pair_confirm" and
                    m.version==VERSION and tonumber(m.masterForemanId)==myId and
                    m.nonce==message.nonce and m.session then
                    showPairing("Paired with Manager " .. tostring(sender))
                    send(sender,{
                        type="master_pair_complete",
                        version=VERSION,
                        masterForemanId=myId,
                        managerId=sender,
                        session=m.session,
                        nonce=m.nonce
                    })
                    setRegionalManager(sender)
                    return sender,m.session
                end
            end
            showPairing("Offer timed out / retrying")
        end
    end
end

function registerNodeWithManager(cfg,timeout)
    local managerId=tonumber(cfg and cfg.managerId)
    if not managerId then
        return false
    end

    setRegionalManager(managerId)

    local packet={
        type="node_register",
        version=VERSION,
        session=cfg.session,
        id=os.getComputerID(),
        role=cfg.role,
        managerId=managerId,
        masterForemanId=cfg.masterForemanId,
        number=cfg.number,
        row=cfg.row,
        rowStart=cfg.rowStart,
        rowEnd=cfg.rowEnd,
        foremanId=cfg.foremanId,
        foremanNumber=cfg.foremanNumber,
        x=cfg.x,
        y=cfg.y,
        z=cfg.z,
        worldOrigin=cfg.worldOrigin
    }

    local deadline=now()+(tonumber(timeout) or 15)
    local lastSend=-10

    while now()<deadline do
        if now()-lastSend>=1 then
            send(managerId,packet)
            lastSend=now()
        end

        local sender,message=rednet.receive(PROTOCOL,0.5)

        if sender==managerId and type(message)=="table" and
            message.type=="node_registered" and message.version==VERSION and
            message.session==cfg.session and message.id==os.getComputerID() then
            if tonumber(message.managerId)~=managerId or
                tonumber(message.masterForemanId)~=tonumber(cfg.masterForemanId) then
                return false
            end

            if cfg.role=="miner" then
                if tonumber(message.row)~=tonumber(cfg.row) or
                    tonumber(message.foremanId)~=tonumber(cfg.foremanId) then
                    return false
                end
            elseif cfg.role=="foreman" then
                if tonumber(message.number)~=tonumber(cfg.number) then
                    return false
                end
            elseif cfg.role=="navigator" then
                if tonumber(message.number)~=tonumber(cfg.number) then
                    return false
                end
            end

            return true
        end
    end

    return false
end

function ensureManagerRegistration(cfg)
    while not registerNodeWithManager(cfg) do
        term.setBackgroundColor(colors.black)
        term.setTextColor(colors.white)
        term.clear()
        term.setCursorPos(1,1)
        print("Waiting for Regional Manager...")
        sleep(2)
    end
    return true
end

function resolveChunkMove(state,save,origin)
    local intent=state.chunkMoveIntent
    if not intent then return true end
    local moved=nil
    local gpsDisagreed=false
    local gpsAvailable=false
    if gps and gps.locate and type(state.x)=="number" and
        type(state.y)=="number" then
        local ok,x,y,z=pcall(gps.locate,1,false)
        local tx,ty,tz=worldPose(state.x,state.y,intent.toZ,
            state.chunkIndex,origin)
        local fx,fy,fz=worldPose(state.x,state.y,intent.fromZ,
            state.chunkIndex,origin)
        if ok and x and y and z and tx then
            gpsAvailable=true
            if math.abs(x-tx)<0.25 and math.abs(y-ty)<0.25 then
                if math.abs(z-tz)<0.25 then moved=true
                elseif math.abs(z-fz)<0.25 then moved=false
                else gpsDisagreed=true end
            else
                gpsDisagreed=true
            end
        end
    end
    if moved==nil and not gpsDisagreed then
        local fuel=turtle.getFuelLevel()
        moved=movementFromFuel(intent.fuelBefore,fuel)
    end
    if moved==nil then
        state.recoveryLocked=true
        state.recoveryReason=gpsDisagreed and
            "GPS disagrees with interrupted chunk move" or
            (origin and not gpsAvailable and "GPS unavailable for interrupted chunk move" or
            "Chunk move interrupted with uncertain position")
        save()
        return false
    end
    state.z=moved and intent.toZ or intent.fromZ
    state.pos=state.z
    if moved then state.seq=(tonumber(state.seq) or 0)+1 end
    state.chunkMoveIntent=nil
    save()
    return true
end

function movementFromFuel(before,after)
    if type(before)~="number" or type(after)~="number" then return nil end
    if after==before-1 then return true end
    if after==before then return false end
    return nil
end

function locateWorldPose(timeout)
    if not gps or not gps.locate then return nil end
    local ok,x,y,z=pcall(gps.locate,timeout or 2,false)
    if not ok or type(x)~="number" or type(y)~="number" or type(z)~="number" then
        return nil
    end
    return x,y,z
end

function poseMatchesWorld(state,origin,x,y,z)
    if not origin or type(state)~="table" then return nil end
    if type(state.x)~="number" or type(state.y)~="number" or type(state.z)~="number" then return nil end
    local ex,ey,ez=worldPose(state.x,state.y,state.z,state.chunkIndex,origin)
    if not ex then return nil end
    return math.abs(x-ex)<0.25 and math.abs(y-ey)<0.25 and math.abs(z-ez)<0.25
end

function worldToLocalPose(worldX,worldY,worldZ,chunkIndex,origin)
    if type(origin)~="table" or type(worldX)~="number" or
        type(worldY)~="number" or type(worldZ)~="number" then return nil end
    if type(origin.x)~="number" or type(origin.y)~="number" or
        type(origin.z)~="number" then return nil end
    local function snap(value)
        local rounded
        if value>=0 then rounded=math.floor(value+0.5)
        else rounded=math.ceil(value-0.5) end
        if math.abs(value-rounded)>0.25 then return nil end
        return rounded
    end
    local x=snap(worldX-origin.x)
    local y=snap(worldY-origin.y)
    local z=snap(origin.z-worldZ-16*(tonumber(chunkIndex) or 0))
    if x==nil or y==nil or z==nil then return nil end
    return x,y,z
end

function loadWorldPoseCandidate(path,origin,worldX,worldY,worldZ)
    local files={path,path .. ".new",path .. ".bak"}
    local chosen=nil
    local generation=-1
    for i=1,#files do
        local value=decodeTable(files[i])
        if value and poseMatchesWorld(value,origin,worldX,worldY,worldZ) then
            local count=tonumber(value.__saveGeneration) or 0
            if count>generation then
                chosen=value
                generation=count
            end
        end
    end
    return chosen
end

function movementFromGPS(intent,chunkIndex,origin,timeout)
    if type(intent)~="table" or type(intent.from)~="table" or
        type(intent.to)~="table" or not origin then return nil end
    local x,y,z=locateWorldPose(timeout or 2)
    if not x then return nil end
    local fx,fy,fz=worldPose(intent.from.x,intent.from.y,intent.from.z,chunkIndex,origin)
    local tx,ty,tz=worldPose(intent.to.x,intent.to.y,intent.to.z,chunkIndex,origin)
    if not fx or not tx then return nil end
    if math.abs(x-tx)<0.25 and math.abs(y-ty)<0.25 and math.abs(z-tz)<0.25 then return true end
    if math.abs(x-fx)<0.25 and math.abs(y-fy)<0.25 and math.abs(z-fz)<0.25 then return false end
    return nil
end

function directionFromWorldDelta(dx,dz)
    if math.abs(dx)<0.25 and math.abs(dz+1)<0.25 then return DIR_N end
    if math.abs(dx-1)<0.25 and math.abs(dz)<0.25 then return DIR_E end
    if math.abs(dx)<0.25 and math.abs(dz-1)<0.25 then return DIR_S end
    if math.abs(dx+1)<0.25 and math.abs(dz)<0.25 then return DIR_W end
    return nil
end

function recoverFacingByGPS(state,origin,saveFn)
    if not turtle or not origin or type(state)~="table" then return nil,"GPS facing recovery unavailable" end
    if type(saveFn)~="function" then return nil,"GPS facing recovery requires transactional persistence" end
    local ex,ey,ez=worldPose(state.x,state.y,state.z,state.chunkIndex,origin)
    if not ex then return nil,"GPS facing recovery has no world anchor" end

    local function near(a,b)
        return type(a)=="number" and type(b)=="number" and math.abs(a-b)<0.25
    end

    local function persistIntent(intent)
        state.recoveryProbeIntent=intent
        local ok,result=pcall(saveFn)
        return ok and result~=false
    end

    local function clearIntent()
        state.recoveryProbeIntent=nil
        local ok,result=pcall(saveFn)
        return ok and result~=false
    end

    local function atPoint(point)
        local x,y,z=locateWorldPose(2)
        return x and near(x,point.x) and near(y,point.y) and near(z,point.z),x,y,z
    end

    local function finishReturn(command,base,facing)
        if not persistIntent({kind="return",command=command,base=base,facing=facing}) then
            return nil,"GPS facing recovery could not persist return intent"
        end
        local moved=command=="back" and turtle.back() or turtle.forward()
        if not moved then return nil,"GPS facing recovery could not return from probe" end
        local verified=atPoint(base)
        if not verified then return nil,"GPS facing recovery could not verify probe return" end
        if not clearIntent() then return nil,"GPS facing recovery could not clear return intent" end
        return facing
    end

    local x,y,z=locateWorldPose(2)
    if not x then return nil,"GPS unavailable for facing recovery" end

    local searchAttempt=1
    local pending=state.recoveryProbeIntent
    if type(pending)=="table" and type(pending.base)=="table" then
        local base=pending.base
        local atBase=near(x,base.x) and near(y,base.y) and near(z,base.z)
        if pending.kind=="return" then
            if atBase then
                local facing=tonumber(pending.facing)
                if not clearIntent() then return nil,"GPS facing recovery could not clear completed return intent" end
                return facing
            end
            local command=pending.command
            if command~="back" and command~="forward" then
                return nil,"GPS facing recovery return intent is invalid"
            end
            local moved=command=="back" and turtle.back() or turtle.forward()
            if not moved then return nil,"GPS facing recovery could not resume interrupted return" end
            local verified=atPoint(base)
            if not verified then return nil,"GPS facing recovery resumed return but did not reach base" end
            local facing=tonumber(pending.facing)
            if not clearIntent() then return nil,"GPS facing recovery could not clear completed return intent" end
            return facing
        elseif pending.kind=="forward" or pending.kind=="back" then
            if not atBase then
                local movedDir=directionFromWorldDelta(x-base.x,z-base.z)
                if not movedDir or not near(y,base.y) then
                    return nil,"GPS facing recovery found an unexpected interrupted probe position"
                end
                local facing=pending.kind=="forward" and movedDir or ((movedDir+2)%4)
                return finishReturn(pending.kind=="forward" and "back" or "forward",base,facing)
            end
            searchAttempt=tonumber(pending.searchAttempt) or 1
            if not clearIntent() then return nil,"GPS facing recovery could not clear incomplete probe intent" end
        elseif pending.kind=="rotate" then
            if not atBase then return nil,"GPS facing recovery rotated from an unexpected position" end
            searchAttempt=tonumber(pending.searchAttempt) or 1
            if not clearIntent() then return nil,"GPS facing recovery could not clear rotation intent" end
        else
            return nil,"GPS facing recovery found an unknown transaction intent"
        end
    end

    x,y,z=locateWorldPose(2)
    if not x then return nil,"GPS unavailable for facing recovery" end
    if not near(x,ex) or not near(y,ey) or not near(z,ez) then
        return nil,"GPS facing recovery requires the saved pose before probing"
    end
    local base={x=x,y=y,z=z}

    while searchAttempt<=8 do
        if not persistIntent({kind="forward",base=base,searchAttempt=searchAttempt,fuelBefore=turtle.getFuelLevel()}) then
            return nil,"GPS facing recovery could not persist probe intent"
        end
        local command="forward"
        local moved=turtle.forward()
        if not moved then
            if not persistIntent({kind="back",base=base,searchAttempt=searchAttempt,fuelBefore=turtle.getFuelLevel()}) then
                return nil,"GPS facing recovery could not persist alternate probe intent"
            end
            command="back"
            moved=turtle.back()
        end

        if moved then
            local ax,ay,az=locateWorldPose(2)
            if not ax then return nil,"GPS unavailable after facing recovery probe" end
            local movedDir=directionFromWorldDelta(ax-base.x,az-base.z)
            if not movedDir or not near(ay,base.y) then
                return nil,"Facing recovery probe produced an invalid displacement"
            end
            local facing=command=="forward" and movedDir or ((movedDir+2)%4)
            return finishReturn(command=="forward" and "back" or "forward",base,facing)
        end

        if not clearIntent() then return nil,"GPS facing recovery could not clear blocked probe intent" end
        if searchAttempt>=8 then break end
        local nextAttempt=searchAttempt+1
        if not persistIntent({kind="rotate",base=base,searchAttempt=nextAttempt}) then
            return nil,"GPS facing recovery could not persist rotation intent"
        end
        if not turtle.turnRight() then
            clearIntent()
            return nil,"GPS facing recovery could not rotate toward an open probe lane"
        end
        searchAttempt=nextAttempt
        if not clearIntent() then return nil,"GPS facing recovery could not commit rotation intent" end
    end

    return nil,"GPS facing recovery could not find an open horizontal probe lane"
end

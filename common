local function debugSendBuffer(force)
    if debugRole=="regional_manager" then return true end
    if not debugRawSend or #debugRemoteBuffer==0 then return false end
    local id=tonumber(regionalManagerID)
    if not id or id==os.getComputerID() then return false end
    if not force and #debugRemoteBuffer<DEBUG_REMOTE_BATCH then return false end
    local packet={type="debug_log_batch",version=VERSION,node=os.getComputerID(),role=debugRole,lines=debugRemoteBuffer}
    local ok,result=pcall(debugRawSend,id,packet,DEBUG_PROTOCOL)
    if ok and result~=false then
        debugRemoteBuffer={}
        return true
    end
    return false
end

function debugLog(category,message,severity)
    if not debugInitialized then return end
    severity=severity or "INFO"
    if category=="TURTLE" and severity=="INFO" then return end
    local line=debugLine(category,message,severity)
    debugAppend(fs.combine(DEBUG_LOG_DIR,"current.log"),line,DEBUG_LOG_MAX)
    if severity=="WARN" or severity=="ERROR" or category=="RECOVERY" or category=="CRASH" then
        debugAppend(fs.combine(DEBUG_LOG_DIR,"errors.log"),line,DEBUG_ERROR_LOG_MAX)
    end
    if debugRole~="regional_manager" then
        debugRemoteBuffer[#debugRemoteBuffer+1]=line
        if #debugRemoteBuffer>48 then table.remove(debugRemoteBuffer,1) end
        debugSendBuffer(severity=="ERROR")
    end
end

function debugFlush()
    return debugSendBuffer(true)
end

function debugStateSummary(path,value)
    if type(value)~="table" then return tostring(path) end
    local keys={"role","number","row","state","phase","stage","x","y","z","facing","recoveryLocked","recoveryReason","task","mode"}
    local out={"path="..tostring(path)}
    for _,key in ipairs(keys) do
        if value[key]~=nil then out[#out+1]=key.."="..debugScalar(value[key]) end
    end
    return table.concat(out," ")
end

function debugIngest(sender,message)
    if debugRole~="regional_manager" or type(message)~="table" or message.version~=VERSION or type(message.lines)~="table" then return end
    for _,line in ipairs(message.lines) do
        local remote="[remote="..tostring(sender).."] "..tostring(line)
        debugAppend(fs.combine(DEBUG_LOG_DIR,"current.log"),remote,DEBUG_LOG_MAX)
        if string.find(remote,"[ERROR]",1,true) or string.find(remote,"[CRASH]",1,true) or
            string.find(remote,"[RECOVERY]",1,true) then
            debugAppend(fs.combine(DEBUG_LOG_DIR,"errors.log"),remote,DEBUG_ERROR_LOG_MAX)
        end
    end
end

local function debugInit()
    local marker=fs.combine(DEBUG_LOG_DIR,"version")
    local old=debugRead(marker)
    if old~=tostring(VERSION) then
        if fs.exists(DEBUG_LOG_DIR) then fs.delete(DEBUG_LOG_DIR) end
        fs.makeDir(DEBUG_LOG_DIR)
        debugWrite(marker,tostring(VERSION),"w")
    else
        debugEnsureDir()
    end
    debugInitialized=true
    debugLog("BOOT","VERSION_TEST_START label="..tostring(os.getComputerLabel() or "").." protocol="..PROTOCOL,"INFO")
end


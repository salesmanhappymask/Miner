function detectPlacement()
    if not turtle then
        return true,"SUPPORTED",DIR_N
    end

    local supported=turtle.detectDown() and true or false
    return supported,supported and "SUPPORTED" or "AIR",supported and DIR_N or DIR_S
end

function now()
    return os.clock()
end

function readFile(path)
    local f = fs.open(path, "r")
    if not f then
        return nil
    end
    local data = f.readAll()
    f.close()
    return data
end

function writeFile(path, data)
    local f = fs.open(path, "w")
    if not f then
        return false
    end
    f.write(data)
    f.close()
    return true
end

function decodeTable(path)
    if not fs.exists(path) then
        return nil
    end
    local raw=readFile(path)
    if not raw then
        return nil
    end
    local ok,value=pcall(textutils.unserialize,raw)
    if not ok or type(value)~="table" then
        return nil
    end
    return value
end

function saveTable(path,value)
    local temp=path .. ".new"
    local backup=path .. ".bak"

    if not writeFile(temp,textutils.serialize(value)) then
        return false
    end

    if fs.exists(backup) then
        fs.delete(backup)
    end

    if fs.exists(path) then
        fs.move(path,backup)
    end

    local ok,moved=pcall(fs.move,temp,path)
    if not ok or moved==false then
        if not fs.exists(path) and fs.exists(backup) then
            pcall(fs.move,backup,path)
        end
        return false
    end

    return true
end

function loadTable(path)
    local value=decodeTable(path)
    if value then
        return value
    end
    return decodeTable(path .. ".new") or decodeTable(path .. ".bak")
end

function saveTableLight(path,value)
    local temp=path .. ".new"
    local backup=path .. ".bak"
    local generation=(tonumber(value.__saveGeneration) or 0)+1
    local previous=value.__saveGeneration
    value.__saveGeneration=generation

    if not writeFile(temp,textutils.serialize(value)) then
        value.__saveGeneration=previous
        return false
    end

    if not decodeTable(temp) then
        value.__saveGeneration=previous
        return false
    end

    if fs.exists(path) then
        if fs.exists(backup) then
            local cleared=pcall(fs.delete,backup)
            if not cleared then
                value.__saveGeneration=previous
                return false
            end
        end
        local rotated=pcall(fs.move,path,backup)
        if not rotated then
            value.__saveGeneration=previous
            return false
        end
    end

    local ok,moved=pcall(fs.move,temp,path)
    if not ok or moved==false then
        value.__saveGeneration=previous
        return false
    end

    return true
end

function loadTableLight(path)
    local files={path,path .. ".new",path .. ".bak"}
    local chosen=nil
    local generation=-1
    for i=1,#files do
        local value=decodeTable(files[i])
        if value then
            local count=tonumber(value.__saveGeneration) or 0
            if count>generation then
                chosen=value
                generation=count
            end
        end
    end
    return chosen
end

function openNetwork()
    local opened = false
    for i = 1, #SIDES do
        local side = SIDES[i]
        if peripheral.getType(side) == "modem" then
            rednet.open(side)
            opened = true
        end
    end
    return opened
end

function send(id, packet)
    if id and id ~= os.getComputerID() then
        rednet.send(id, packet, PROTOCOL)
    end
end

function broadcast(packet)
    rednet.broadcast(packet, PROTOCOL)
end

function lower(value)
    return string.lower(tostring(value or ""))
end

function itemText(item)
    if type(item) ~= "table" then
        return ""
    end
    return lower(item.id) .. " " .. lower(item.name) .. " " ..
        lower(item.raw_name) .. " " .. lower(item.rawName) .. " " ..
        lower(item.display_name) .. " " .. lower(item.displayName)
end

function enderChestFrequency(item)
    if type(item)~="table" then return nil end
    local text=itemText(item)
    if not string.find(text,"ender",1,true) or not string.find(text,"chest",1,true) then
        return nil
    end
    local damage=tonumber(item.dmg or item.damage or item.itemDamage or
        item.damageValue or item.metadata or item.meta)
    if not damage or damage<0 or math.floor(damage/4096)~=0 then return nil end
    return damage%4096
end

function matchesItem(item, kind)
    local text = itemText(item)
    local name=lower(item and (item.display_name or item.displayName or item.name))
    local damage=tonumber(item and (item.dmg or item.damage or item.itemDamage or
        item.damageValue or item.metadata or item.meta))
    if kind == "ender_dump" then
        return enderChestFrequency(item)==0
    elseif kind == "ender_fuel" then
        return enderChestFrequency(item)==11
    elseif kind == "lava_bucket" then
        return string.find(text,"lava",1,true)~=nil and string.find(text,"bucket",1,true)~=nil
    elseif kind == "empty_bucket" then
        return string.find(text,"bucket",1,true)~=nil and
            string.find(text,"lava",1,true)==nil and
            string.find(text,"water",1,true)==nil and
            string.find(text,"milk",1,true)==nil
    elseif kind == "blaze_rod" then
        return string.find(text,"blaze",1,true)~=nil and
            string.find(text,"rod",1,true)~=nil
    elseif kind == "charcoal" then
        return string.find(text,"coal",1,true)~=nil and
            (damage==1 or string.find(name,"charcoal",1,true)~=nil)
    elseif kind == "coal" then
        return string.find(text,"coal",1,true)~=nil and damage~=1 and
            string.find(name,"charcoal",1,true)==nil
    elseif kind == "disk_drive" then
        return string.find(text, "disk drive", 1, true) ~= nil or string.find(text, "diskdrive", 1, true) ~= nil
    elseif kind == "floppy" then
        return string.find(text, "floppy", 1, true) ~= nil or (string.find(text, "disk", 1, true) ~= nil and string.find(text, "drive", 1, true) == nil)
    elseif kind == "wireless_mining_turtle" then
        return string.find(text, "turtle", 1, true) ~= nil and string.find(text, "wireless", 1, true) ~= nil and string.find(text, "mining", 1, true) ~= nil
    elseif kind == "narcissistic_wireless_turtle" then
        return string.find(text, "narcissistic wireless turtle", 1, true) ~= nil
    elseif kind == "advanced_wireless_turtle" then
        return string.find(text, "advanced wireless turtle", 1, true) ~= nil
    elseif kind == "computer" then
        return string.find(text, "computer", 1, true) ~= nil and
            string.find(text, "turtle", 1, true) == nil and
            string.find(text, "pocket", 1, true) == nil
    elseif kind == "wireless_modem" then
        return string.find(text, "wireless modem", 1, true) ~= nil or
            (string.find(text, "modem", 1, true) ~= nil and string.find(text, "wireless", 1, true) ~= nil)
    end
    return false
end

function wrapInventory(side)
    local p = peripheral.wrap(side)
    if not p or not p.getInventorySize or not p.getStackInSlot then
        return nil
    end
    return p
end

function inventorySnapshot(inv)
    if not inv then
        return nil
    end

    if inv.getAllStacks then
        local ok,all=pcall(inv.getAllStacks)
        if ok and type(all)=="table" then
            local items={}
            for slot,item in pairs(all) do
                local n=tonumber(slot)
                if n and item then
                    if type(item)=="table" and type(item.basic)=="function" then
                        local expanded,basic=pcall(item.basic)
                        if expanded and type(basic)=="table" then item=basic end
                    end
                    if type(item)~="table" or
                        (not item.id and not item.name and not item.display_name) then
                        local expanded,full=pcall(inv.getStackInSlot,n)
                        if expanded and type(full)=="table" then item=full end
                    end
                    items[n]=item
                end
            end
            return items
        end
    end

    local size=inv.getInventorySize()
    local items={}

    for slot=1,size do
        local ok,item=pcall(inv.getStackInSlot,slot)
        if ok and item then
            items[slot]=item
        end
    end

    return items
end

function scanInventory(side)
    local inv=wrapInventory(side)

    if not inv then
        return nil,"No OpenPeripheral inventory on " .. side
    end

    return inventorySnapshot(inv),inv
end

function findInventorySlot(side, kind)
    local items, inv = scanInventory(side)
    if not items then
        return nil, inv
    end
    for slot, item in pairs(items) do
        if matchesItem(item, kind) then
            return slot, inv, item
        end
    end
    return nil, inv
end

function takeNamedFromFront(kind, count, targetSlot)
    local movedTotal = 0

    while movedTotal < count do
        local sourceSlot, inv = findInventorySlot("front", kind)
        if not sourceSlot then
            break
        end

        if sourceSlot ~= 1 then
            if not inv.swapStacks then
                break
            end
            local ok = pcall(inv.swapStacks, sourceSlot, 1)
            if not ok then
                break
            end
        end

        local okFirst,first=pcall(inv.getStackInSlot,1)
        if not okFirst or not matchesItem(first,kind) then
            break
        end

        turtle.select(targetSlot)

        local maxSize = tonumber(first.max_size or first.maxSize or 64)
        local current = turtle.getItemCount(targetSlot)
        local free = maxSize - current
        if free <= 0 then
            break
        end

        local request = math.min(count - movedTotal, free, 64)
        local before = current

        if request <= 0 then
            break
        end

        turtle.suck(request)

        local moved = turtle.getItemCount(targetSlot) - before
        if moved <= 0 then
            break
        end

        movedTotal = movedTotal + moved
    end

    return movedTotal
end

function getSelfInventory()
    local sides = {"left","right"}
    for i=1,#sides do
        local side = sides[i]
        if peripheral.getType(side) ~= "modem" then
            local inv = wrapInventory(side)
            if inv then
                return inv, side
            end
        end
    end
    return nil, nil
end

function selfItem(slot)
    local inv = getSelfInventory()
    if not inv then
        return nil
    end
    local ok, item = pcall(inv.getStackInSlot, slot)
    if ok then
        return item
    end
    return nil
end

function selfFindSlot(kind)
    local inv=getSelfInventory()
    if not inv then
        return nil
    end

    local items=inventorySnapshot(inv) or {}

    for slot,item in pairs(items) do
        if item and matchesItem(item,kind) then
            return slot,item
        end
    end

    return nil
end

function selfFindSlotExcluding(kind,excluded)
    local inv=getSelfInventory()
    if not inv then
        return nil
    end

    local items=inventorySnapshot(inv) or {}

    for slot,item in pairs(items) do
        if slot~=excluded and item and matchesItem(item,kind) then
            return slot,item
        end
    end

    return nil
end

function selfCountExcluding(kind,excluded)
    local inv=getSelfInventory()
    if not inv then
        return 0
    end

    local total=0
    local items=inventorySnapshot(inv) or {}

    for slot,item in pairs(items) do
        if slot~=excluded and item and matchesItem(item,kind) then
            total=total+tonumber(item.qty or item.size or 1)
        end
    end

    return total
end

function selfCount(kind)
    local inv=getSelfInventory()
    if not inv then
        return 0
    end

    local total=0
    local items=inventorySnapshot(inv) or {}

    for _,item in pairs(items) do
        if item and matchesItem(item,kind) then
            total=total+tonumber(item.qty or item.size or 1)
        end
    end

    return total
end

function selfTargetSlot(kind)
    local inv=getSelfInventory()
    if not inv then
        return nil
    end

    local items=inventorySnapshot(inv) or {}
    local size=inv.getInventorySize()
    local empty=nil

    for slot=1,size do
        local item=items[slot]

        if item then
            if matchesItem(item,kind) then
                local qty=tonumber(item.qty or item.size or 1)
                local maxSize=tonumber(item.max_size or item.maxSize or 64)

                if qty<maxSize then
                    return slot
                end
            end
        elseif not empty then
            empty=slot
        end
    end

    return empty
end

function selfTargetSlotExcluding(kind,excluded)
    local inv=getSelfInventory()
    if not inv then
        return nil
    end

    local items=inventorySnapshot(inv) or {}
    local size=inv.getInventorySize()
    local empty=nil

    for slot=1,size do
        if slot~=excluded then
            local item=items[slot]

            if item then
                if matchesItem(item,kind) then
                    local qty=tonumber(item.qty or item.size or 1)
                    local maxSize=tonumber(item.max_size or item.maxSize or 64)

                    if qty<maxSize then
                        return slot
                    end
                end
            elseif not empty then
                empty=slot
            end
        end
    end

    return empty
end

function selfEmptySlot()
    local inv=getSelfInventory()
    if not inv then
        return nil
    end

    local items=inventorySnapshot(inv) or {}
    local size=inv.getInventorySize()

    for slot=1,size do
        if not items[slot] then
            return slot
        end
    end

    return nil
end

function takeNamedIntoSelf(kind, count)
    local moved = 0
    while moved < count do
        local slot = selfTargetSlot(kind)
        if not slot then
            break
        end
        local before = turtle.getItemCount(slot)
        local got = takeNamedFromFront(kind, count - moved, slot)
        if got <= 0 then
            break
        end
        moved = moved + got
        if turtle.getItemCount(slot) == before then
            break
        end
    end
    return moved
end

function selfSelectKind(kind)
    local slot = selfFindSlot(kind)
    if not slot then
        return nil
    end
    turtle.select(slot)
    return slot
end

function selfDropKind(kind,count)
    local remaining=count

    while remaining>0 do
        local slot=selfFindSlot(kind)
        if not slot then
            return false
        end

        turtle.select(slot)
        local amount=math.min(remaining,turtle.getItemCount(slot))

        if amount<=0 or not turtle.drop(amount) then
            return false
        end

        remaining=remaining-amount
    end

    return true
end

function selfRefuelTo(target)
    if turtle.getFuelLevel() == "unlimited" then
        return true
    end
    while turtle.getFuelLevel() < target do
        local slot
        for _,kind in ipairs(FUEL_PRIORITY) do
            slot=selfFindSlot(kind)
            if slot then break end
        end
        if not slot then
            return false
        end
        turtle.select(slot)
        if not turtle.refuel(0) or not turtle.refuel(1) then
            return false
        end
    end
    return true
end

function status(role, state, extra)
    local managerId=getRegionalManager()
    if not managerId then
        return
    end

    local p = {
        type = "status",
        role = role,
        state = state,
        id = os.getComputerID(),
        label = os.getComputerLabel() or "",
        version = VERSION
    }
    if extra then
        for k, v in pairs(extra) do
            p[k] = v
        end
    end
    send(managerId, p)
end

function checkpointPose(role,seq,snapshot,session)
    local managerId=getRegionalManager()
    if not managerId then
        return
    end

    send(managerId,{
        type="pose_checkpoint",
        role=role,
        id=os.getComputerID(),
        version=VERSION,
        session=session,
        seq=seq or 0,
        snapshot=snapshot
    })
end

function requestPoseBackup(role,timeout,session)
    local managerId=getRegionalManager()
    if not managerId or os.getComputerID()==managerId then
        return nil
    end

    local id=os.getComputerID()
    local deadline=now()+(timeout or 5)
    local lastSend=-10

    while now()<deadline do
        if now()-lastSend>=2 then
            send(managerId,{
                type="recovery_request",
                role=role,
                id=id,
                version=VERSION,
                session=session
            })
            lastSend=now()
        end

        local sender,message=rednet.receive(PROTOCOL,0.2)
        if sender==managerId and type(message)=="table" and
            message.type=="recovery_state" and message.id==id and
            message.role==role and message.version==VERSION and message.session==session then
            return message.snapshot,message.seq
        end
    end

    return nil
end


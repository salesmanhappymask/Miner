function requestPoseBackup(role,timeout,session)
    local managerId=getRegionalManager()
    if not managerId or os.getComputerID()==managerId then
        return nil
    end

    local id=os.getComputerID()
    local deadline=now()+(timeout or 5)
    local lastSend=-10

    while now()<deadline do
        if now()-lastSend>=2 then
            send(managerId,{
                type="recovery_request",
                role=role,
                id=id,
                version=VERSION,
                session=session
            })
            lastSend=now()
        end

        local sender,message=rednet.receive(PROTOCOL,0.2)
        if sender==managerId and type(message)=="table" and
            message.type=="recovery_state" and message.id==id and
            message.role==role and message.version==VERSION and message.session==session then
            return message.snapshot,message.seq
        end
    end

    return nil
end


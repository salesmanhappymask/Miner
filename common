function readFile(path)
    local f = fs.open(path, "r")
    if not f then
        return nil
    end
    local data = f.readAll()
    f.close()
    return data
end

function writeFile(path, data)
    local f = fs.open(path, "w")
    if not f then
        return false
    end
    f.write(data)
    f.close()
    return true
end

function decodeTable(path)
    if not fs.exists(path) then
        return nil
    end
    local raw=readFile(path)
    if not raw then
        return nil
    end
    local ok,value=pcall(textutils.unserialize,raw)
    if not ok or type(value)~="table" then
        return nil
    end
    return value
end

function saveTable(path,value)
    local temp=path .. ".new"
    local backup=path .. ".bak"

    if not writeFile(temp,textutils.serialize(value)) then
        return false
    end

    if fs.exists(backup) then
        fs.delete(backup)
    end

    if fs.exists(path) then
        fs.move(path,backup)
    end

    local ok,moved=pcall(fs.move,temp,path)
    if not ok or moved==false then
        if not fs.exists(path) and fs.exists(backup) then
            pcall(fs.move,backup,path)
        end
        return false
    end

    if debugLog then debugLog("STATE",debugStateSummary(path,value),"INFO") end
    return true
end

function loadTable(path)
    local value=decodeTable(path)
    if value then
        return value
    end
    return decodeTable(path .. ".new") or decodeTable(path .. ".bak")
end

function saveTableLight(path,value)
    local temp=path .. ".new"
    local backup=path .. ".bak"
    local generation=(tonumber(value.__saveGeneration) or 0)+1
    local previous=value.__saveGeneration
    value.__saveGeneration=generation

    if not writeFile(temp,textutils.serialize(value)) then
        value.__saveGeneration=previous
        return false
    end

    if not decodeTable(temp) then
        value.__saveGeneration=previous
        return false
    end

    if fs.exists(path) then
        if fs.exists(backup) then
            local cleared=pcall(fs.delete,backup)
            if not cleared then
                value.__saveGeneration=previous
                return false
            end
        end
        local rotated=pcall(fs.move,path,backup)
        if not rotated then
            value.__saveGeneration=previous
            return false
        end
    end

    local ok,moved=pcall(fs.move,temp,path)
    if not ok or moved==false then
        value.__saveGeneration=previous
        return false
    end

    if debugLog then debugLog("STATE",debugStateSummary(path,value),"INFO") end
    return true
end

function loadTableLight(path)
    local files={path,path .. ".new",path .. ".bak"}
    local chosen=nil
    local generation=-1
    for i=1,#files do
        local value=decodeTable(files[i])
        if value then
            local count=tonumber(value.__saveGeneration) or 0
            if count>generation then
                chosen=value
                generation=count
            end
        end
    end
    return chosen
end

function openNetwork()
    local opened=false
    for i=1,#SIDES do
        local side=SIDES[i]
        if peripheral.getType(side)=="modem" then
            local already=false
            local okOpen,isOpen=pcall(rednet.isOpen,side)
            if okOpen and isOpen then already=true end
            if already or pcall(rednet.open,side) then opened=true end
        end
    end
    return opened
end

local function safeNetworkSend(id,packet,protocol,broadcastMode)
    local fn=broadcastMode and rednet.broadcast or rednet.send
    local ok,result
    if broadcastMode then
        ok,result=pcall(fn,packet,protocol)
    else
        ok,result=pcall(fn,id,packet,protocol)
    end
    if ok and result~=false then return true end
    if not openNetwork() then return false end
    if broadcastMode then
        ok,result=pcall(fn,packet,protocol)
    else
        ok,result=pcall(fn,id,packet,protocol)
    end
    return ok and result~=false
end

function send(id,packet)
    if id and id~=os.getComputerID() then
        return safeNetworkSend(id,packet,PROTOCOL,false)
    end
    return true
end

function broadcast(packet)
    return safeNetworkSend(nil,packet,PROTOCOL,true)
end


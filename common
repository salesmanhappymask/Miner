    return debugWrite(path,line .. "\n","a")
end

local function debugScalar(value)
    local t=type(value)
    if t=="nil" then return "nil" end
    if t=="string" then
        local v=value:gsub("[\r\n\t]"," ")
        if #v>240 then v=v:sub(1,240).."..." end
        return v
    end
    if t=="number" or t=="boolean" then return tostring(value) end
    if t=="table" then
        local ok,out=pcall(textutils.serialize,value)
        if ok and out then
            out=out:gsub("[\r\n\t]"," ")
            if #out>400 then out=out:sub(1,400).."..." end
            return out
        end
    end
    return tostring(value)
end

local function debugArgs(...)
    local values={...}
    local out={}
    for i=1,#values do out[#out+1]=debugScalar(values[i]) end
    return table.concat(out,",")
end


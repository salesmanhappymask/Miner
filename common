end

function verifyWorldPlacement(expected)
    if type(expected)~="table" or type(expected.x)~="number" or
        type(expected.y)~="number" or type(expected.z)~="number" then
        return false,"Missing expected world coordinates"
    end
    if not gps or not gps.locate then return false,"GPS unavailable" end
    for attempt=1,8 do
        local ok,x,y,z=pcall(gps.locate,2,false)
        if ok and type(x)=="number" and type(y)=="number" and type(z)=="number" then
            if math.abs(x-expected.x)<0.25 and math.abs(y-expected.y)<0.25 and
                math.abs(z-expected.z)<0.25 then
                return true
            end
            return false,"GPS placement mismatch: "..tostring(x)..","..
                tostring(y)..","..tostring(z)
        end
        sleep(0.5)
    end
    return false,"GPS unavailable during placement"
end

function worldPose(localX,localY,localZ,chunkIndex,origin)
    if type(origin)~="table" then return nil end
    if type(origin.x)~="number" or type(origin.y)~="number" or
        type(origin.z)~="number" then return nil end
    return origin.x+localX,origin.y+localY,
        origin.z-localZ-16*(tonumber(chunkIndex) or 0)
end


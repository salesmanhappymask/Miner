        return true
    end
    local ex,ey,ez=worldPose(state.x,state.y,state.z,state.chunkIndex,origin)
    if ex and (math.abs(x-ex)>0.25 or math.abs(y-ey)>0.25 or
        math.abs(z-ez)>0.25) then
        return false,"GPS differs from saved pose after reboot; possible world rollback"
    end
    if fuelMismatch then
        state.fuelWitness=fuel
        return true,nil,true
    end
    return true
end

function travelChunkNorth(state,save,face,baseZ,targetIndex,origin,abortCheck,clearForward)
    local function cancelled()
        return type(abortCheck)=="function" and abortCheck() and true or false
    end
    if cancelled() then return false,"Chunk move cancelled" end
    if state.recoveryLocked then return false,"Position recovery lock" end
    local current=tonumber(state.chunkIndex) or 0
    if current>=targetIndex then return true end
    if targetIndex~=current+1 then return false,"Chunk epoch out of sequence" end
    if state.y~=nil and state.y<0 then return false,"Turtle still underground" end
    if cancelled() then return false,"Chunk move cancelled" end
    if not face(DIR_N) then return false,"Could not face north" end
    local destination=baseZ+16
    if state.z<baseZ or state.z>destination then
        return false,"Chunk move position outside expected corridor"
    end
    local function verifyWorld()
        if cancelled() then return false,"Chunk move cancelled" end
        if not origin then return true end
        local ex,ey,ez=worldPose(state.x,state.y,state.z,state.chunkIndex,origin)
        local ok,gx,gy,gz=pcall(gps.locate,2,false)
        if not ok or not gx or not gy or not gz then
            return false,"Waiting for GPS during chunk move"
        end
        if math.abs(gx-ex)>0.25 or math.abs(gy-ey)>0.25 or
            math.abs(gz-ez)>0.25 then
            state.recoveryLocked=true
            state.recoveryReason="GPS disagrees with chunk travel pose"
            save()
            return false,state.recoveryReason
        end
        return true
    end
    local verified,reason=verifyWorld()
    if not verified then return false,reason end
    while state.z<destination do
        if cancelled() then return false,"Chunk move cancelled" end
        if turtle.getFuelLevel()~="unlimited" and turtle.getFuelLevel()<destination-state.z then
            return false,"Not enough fuel for chunk move"
        end
        local previous=state.z
        local attempts=0
        local moved=false
        local lastReason=nil
        while not moved do
            if cancelled() then return false,"Chunk move cancelled" end
            if turtle.detect() then
                if type(clearForward)~="function" then
                    return false,"Next chunk travel lane blocked"
                end
                local cleared,clearReason=clearForward()
                if not cleared then
                    return false,clearReason or "Next chunk travel lane blocked"
                end
                lastReason=clearReason
            end
            state.chunkMoveIntent={fromZ=previous,toZ=previous+1,
                fuelBefore=turtle.getFuelLevel()}
            save()
            local ok,moveReason=turtle.forward()
            if ok then
                moved=true
            else
                state.chunkMoveIntent=nil
                save()
                attempts=attempts+1
                lastReason=moveReason or lastReason
                if type(clearForward)~="function" then
                    return false,"Next chunk travel lane blocked"
                end
                local retry,clearReason=clearForward(moveReason)
                if not retry then
                    return false,clearReason or moveReason or "Next chunk travel lane blocked"
                end
                lastReason=clearReason or lastReason
                if attempts>=20 then
                    return false,lastReason or "Next chunk travel lane blocked"
                end
                sleep(0.1)
            end
        end
        state.z=previous+1
        state.seq=(tonumber(state.seq) or 0)+1
        state.chunkMoveIntent=nil
        save()
        sleep(0)
        if cancelled() then return false,"Chunk move cancelled" end
    end
    verified,reason=verifyWorld()
    if not verified then return false,reason end
    state.z=baseZ
    state.chunkIndex=targetIndex
    state.seq=(tonumber(state.seq) or 0)+1
    save()
    return true
end
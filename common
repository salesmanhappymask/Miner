function inventoryPositiveDelta(before)
    local bestSlot=nil
    local bestDelta=0
    for slot=1,16 do
        local current=turtle and turtle.getItemCount(slot) or 0
        local delta=current-(tonumber(before and before[slot]) or 0)
        if delta>bestDelta then
            bestDelta=delta
            bestSlot=slot
        end
    end
    return bestSlot,bestDelta
end

function itemText(item)
    if type(item) ~= "table" then
        return ""
    end
    return lower(item.id) .. " " .. lower(item.name) .. " " ..
        lower(item.raw_name) .. " " .. lower(item.rawName) .. " " ..
        lower(item.display_name) .. " " .. lower(item.displayName)
end

function enderChestFrequency(item)
    if type(item)~="table" then return nil end
    local text=itemText(item)
    if not string.find(text,"ender",1,true) or not string.find(text,"chest",1,true) then
        return nil
    end
    local damage=tonumber(item.dmg or item.damage or item.itemDamage or
        item.damageValue or item.metadata or item.meta)
    if not damage or damage<0 or math.floor(damage/4096)~=0 then return nil end
    return damage%4096
end

function matchesItem(item, kind)
    local text = itemText(item)
    local name=lower(item and (item.display_name or item.displayName or item.name))
    local damage=tonumber(item and (item.dmg or item.damage or item.itemDamage or
        item.damageValue or item.metadata or item.meta))
    if kind == "ender_dump" then
        return enderChestFrequency(item)==0
    elseif kind == "ender_fuel" then
        return enderChestFrequency(item)==11
    elseif kind == "ender_supply" then
        return enderChestFrequency(item)==4027
    elseif kind == "lava_bucket" then
        return string.find(text,"lava",1,true)~=nil and string.find(text,"bucket",1,true)~=nil
    elseif kind == "empty_bucket" then
        return string.find(text,"bucket",1,true)~=nil and
            string.find(text,"lava",1,true)==nil and
            string.find(text,"water",1,true)==nil and
            string.find(text,"milk",1,true)==nil
    elseif kind == "blaze_rod" then
        return string.find(text,"blaze",1,true)~=nil and
            string.find(text,"rod",1,true)~=nil
    elseif kind == "charcoal" then
        return string.find(text,"coal",1,true)~=nil and
            (damage==1 or string.find(name,"charcoal",1,true)~=nil)
    elseif kind == "coal" then
        return string.find(text,"coal",1,true)~=nil and damage~=1 and
            string.find(name,"charcoal",1,true)==nil
    elseif kind == "disk_drive" then
        return string.find(text, "disk drive", 1, true) ~= nil or string.find(text, "diskdrive", 1, true) ~= nil
    elseif kind == "floppy" then
        return string.find(text, "floppy", 1, true) ~= nil or (string.find(text, "disk", 1, true) ~= nil and string.find(text, "drive", 1, true) == nil)
    elseif kind == "worker_floppy" then
        local floppy=string.find(text,"floppy",1,true)~=nil or
            (string.find(text,"disk",1,true)~=nil and string.find(text,"drive",1,true)==nil)
        return floppy and string.find(text,"quarry worker",1,true)~=nil
    elseif kind == "setup_floppy" then
        local floppy=string.find(text,"floppy",1,true)~=nil or
            (string.find(text,"disk",1,true)~=nil and string.find(text,"drive",1,true)==nil)
        return floppy and string.find(text,"setup",1,true)~=nil
    elseif kind == "chunk_loader" then
        return tonumber(item and item.id)==781 or
            string.find(text,"chunk loader",1,true)~=nil or
            string.find(text,"chunkloader",1,true)~=nil
    elseif kind == "advanced_wireless_mining_turtle" then
        return string.find(text, "turtle", 1, true) ~= nil and
            string.find(text, "advanced", 1, true) ~= nil and
            string.find(text, "wireless", 1, true) ~= nil and
            string.find(text, "mining", 1, true) ~= nil
    elseif kind == "foreman_turtle" or kind == "advanced_wireless_narcissistic_turtle" then
        local turtleItem=string.find(text,"turtle",1,true)~=nil
        local wireless=string.find(text,"wireless",1,true)~=nil
        local mining=string.find(text,"mining",1,true)~=nil
        local advanced=string.find(text,"advanced",1,true)~=nil
        local narcissistic=string.find(text,"narcissistic",1,true)~=nil
        return turtleItem and wireless and not mining and (advanced or narcissistic)
    elseif kind == "wireless_mining_turtle" then
        return string.find(text, "turtle", 1, true) ~= nil and string.find(text, "wireless", 1, true) ~= nil and string.find(text, "mining", 1, true) ~= nil
    elseif kind == "narcissistic_wireless_turtle" then
        return string.find(text, "narcissistic wireless turtle", 1, true) ~= nil
    elseif kind == "advanced_wireless_turtle" then
        return string.find(text, "advanced wireless turtle", 1, true) ~= nil
    elseif kind == "turtle" then
        return string.find(text, "turtle", 1, true) ~= nil
    elseif kind == "computer" then
        return string.find(text, "computer", 1, true) ~= nil and
            string.find(text, "turtle", 1, true) == nil and
            string.find(text, "pocket", 1, true) == nil
    elseif kind == "wireless_modem" then
        return string.find(text, "wireless modem", 1, true) ~= nil or
            (string.find(text, "modem", 1, true) ~= nil and string.find(text, "wireless", 1, true) ~= nil)
    end
    return false
end


local STATE_FILES={"regional_manager.tmp","regional_manager.tmp.new","regional_manager.tmp.bak"}

local function readTable(path)
    if not fs.exists(path) then return nil end
    local h=fs.open(path,"r")
    if not h then return nil end
    local raw=h.readAll()
    h.close()
    if not raw or raw=="" then return nil end
    return textutils.unserialize(raw)
end

local function loadManagerState()
    for _,path in ipairs(STATE_FILES) do
        local data=readTable(path)
        if type(data)=="table" and data.managerId==os.getComputerID() then
            return data,path
        end
    end
    return nil,nil
end

local function openWireless()
    for _,side in ipairs({"left","right","top","bottom","front","back"}) do
        if peripheral.getType(side)=="modem" then
            local ok,wireless=pcall(peripheral.call,side,"isWireless")
            if ok and wireless then
                if not rednet.isOpen(side) then
                    rednet.open(side)
                end
                return side
            end
        end
    end
    return nil
end

local data,path=loadManagerState()

if not data then
    error("Run this program on the Regional Manager computer. No usable regional_manager state was found.")
end

if not openWireless() then
    error("No wireless modem found")
end

local version=tonumber(data.version) or 48
local protocol="miner_swarm_v"..tostring(version)
local session=data.session

local miners={}
for row=1,16 do
    local m=data.miners and data.miners[row]
    if m and m.id then
        miners[row]=tonumber(m.id)
    end
end

print("Loaded "..tostring(path))
print("Protocol: "..protocol)
print("Sending miner label-clear maintenance request")
print("This computer ID: "..tostring(os.getComputerID()))

local cleared={}
local deadline=os.clock()+20
local lastSend=0

while os.clock()<deadline do
    if os.clock()-lastSend>=1 then
        for row,id in pairs(miners) do
            if not cleared[row] then
                rednet.send(id,{
                    type="maintenance_clear_label",
                    session=session
                },protocol)

                rednet.send(id,{
                    type="recall_command",
                    mode="SHUTDOWN",
                    session=session
                },protocol)
            end
        end
        lastSend=os.clock()
    end

    local sender,message,recvProtocol=rednet.receive(protocol,0.25)

    if sender and type(message)=="table" then
        if message.type=="maintenance_label_cleared" and message.row then
            local row=tonumber(message.row)
            cleared[row]=true
            print("Miner-"..tostring(row).." label clear: "..tostring(message.cleared))
        elseif message.type=="recall_shutdown_ready" and message.role=="miner" and message.row then
            local row=tonumber(message.row)
            cleared[row]=true
            print("Miner-"..tostring(row).." shutdown recall acknowledged")
        end
    end
end

local count=0
for row=1,16 do
    if cleared[row] then count=count+1 end
end

print("")
print("Acknowledged: "..count.."/16 miners")

if count<16 then
    print("Unacknowledged miners may be powered off, crashed, unloaded, or running an older startup without the maintenance listener.")
end

local RAW="https://raw.githubusercontent.com/salesmanhappymask/Miner/main/"

local function fetch(name)
    local response=http.get(RAW .. name)
    if not response then return nil end
    local data=response.readAll()
    response.close()
    return data
end

local function writeFile(path,data)
    local f=fs.open(path,"w")
    if not f then return false end
    f.write(data)
    f.close()
    return true
end

if peripheral.getType("top")~="drive" then
    error("Disk Drive must be directly above turtle")
end

local startup=fetch("startup")
local common=fetch("common")
local bootstrap=fetch("bootstrap")

if not startup or not common or not bootstrap then
    error("Could not download modular installer files")
end

local prepared=0

for slot=1,16 do
    if turtle.getItemCount(slot)>0 then
        turtle.select(slot)

        if turtle.dropUp(1) then
            sleep(0.2)

            if disk.isPresent("top") then
                local files=fs.list("disk")

                for i=1,#files do
                    fs.delete(fs.combine("disk",files[i]))
                end

                if not writeFile("disk/startup",startup) then
                    error("Could not write disk/startup")
                end

                if not writeFile("disk/common",common) then
                    error("Could not write disk/common")
                end

                if not writeFile("disk/bootstrap",bootstrap) then
                    error("Could not write disk/bootstrap")
                end

                disk.setLabel("top","miner")
                prepared=prepared+1
            end

            turtle.suckUp(1)
        end
    end
end

print("Prepared " .. tostring(prepared) .. " modular miner disks.")

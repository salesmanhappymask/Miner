local function readFile(path)
    local f=fs.open(path,"r")
    if not f then return nil end
    local data=f.readAll()
    f.close()
    return data
end

local function writeFile(path,data)
    local f=fs.open(path,"w")
    if not f then return false end
    f.write(data)
    f.close()
    return true
end

local source=readFile("startup")
if not source then
    error("Local startup program not found")
end

if peripheral.getType("top")~="drive" then
    error("Disk Drive must be directly above turtle")
end

local prepared=0

for slot=1,16 do
    if turtle.getItemCount(slot)>0 then
        turtle.select(slot)

        if turtle.dropUp(1) then
            sleep(0.2)

            if disk.isPresent("top") then
                local files=fs.list("disk")
                for i=1,#files do
                    fs.delete(fs.combine("disk",files[i]))
                end

                if not writeFile("disk/startup",source) then
                    error("Could not write disk/startup")
                end

                if readFile("disk/startup")~=source then
                    error("Disk startup verification failed")
                end

                disk.setLabel("top","miner")
                prepared=prepared+1
            end

            turtle.suckUp(1)
        end
    end
end

print("Prepared " .. tostring(prepared) .. " miner disks.")

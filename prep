local RAW="https://raw.githubusercontent.com/salesmanhappymask/Miner/main/"

local function fetch(name)
    local response=http.get(RAW .. name)
    if not response then return nil end
    local data=response.readAll()
    response.close()
    return data
end

local function writeFile(path,data)
    local f=fs.open(path,"w")
    if not f then return false end
    f.write(data)
    f.close()
    return true
end

local driveSide
if peripheral.getType("top")=="drive" then
    driveSide="top"
elseif peripheral.getType("bottom")=="drive" then
    driveSide="bottom"
else
    error("Disk Drive must be directly above or below turtle")
end

local startup=fetch("startup")
local common=fetch("common")
local bootstrap=fetch("bootstrap")
local foremanInstaller=fetch("install_foreman1")
local managerInstaller=fetch("rm_install")

if not startup or not common or not bootstrap or not foremanInstaller or not managerInstaller then
    error("Could not download modular installer files")
end

local prepared=0

for slot=1,16 do
    if turtle.getItemCount(slot)>0 then
        turtle.select(slot)

        local deposited=driveSide=="top" and turtle.dropUp(1) or turtle.dropDown(1)
        if deposited then
            sleep(0.2)

            if disk.isPresent(driveSide) then
                local files=fs.list("disk")

                for i=1,#files do
                    fs.delete(fs.combine("disk",files[i]))
                end

                if not writeFile("disk/startup",startup) then
                    error("Could not write disk/startup")
                end

                if not writeFile("disk/common",common) then
                    error("Could not write disk/common")
                end

                if not writeFile("disk/bootstrap",bootstrap) then
                    error("Could not write disk/bootstrap")
                end

                if not writeFile("disk/install_foreman1",foremanInstaller) then
                    error("Could not write disk/install_foreman1")
                end

                if not writeFile("disk/rm_install",managerInstaller) then
                    error("Could not write disk/rm_install")
                end

                disk.setLabel(driveSide,"miner")
                prepared=prepared+1
            end

            if driveSide=="top" then turtle.suckUp(1) else turtle.suckDown(1) end
        end
    end
end

print("Prepared " .. tostring(prepared) .. " modular miner disks.")

    local function deployNavigator(navNumber)
        local site=NAVIGATOR_SITES[navNumber]
        if not site then return false end

        local sx=site.x
        local sz=site.z-1

        if not navigatorGoTo(sx,site.y,sz) then
            return false
        end

        if not navigatorVertical(site.y-1) then
            return false
        end

        if peripheral.getType("front")~="drive" then
            if turtle.detect() then
                return false
            end
            if not selfSelectKind("disk_drive") or not turtle.place() then
                return false
            end
            sleep(0.2)
        end

        if not disk.isPresent("front") then
            if not selfSelectKind("floppy") or not turtle.drop(1) then
                return false
            end
            sleep(0.3)
        end

        if not disk.isPresent("front") then
            return false
        end

        if not navigatorVertical(site.y) then
            return false
        end

        if not faceTracked(DIR_N) then
            return false
        end

        if frontComputerId() then
            return false
        end

        if turtle.detect() then
            return false
        end

        if not selfSelectKind("computer") or not turtle.place() then
            return false
        end

        sleep(0.2)

        local navigatorId=frontComputerId()
        if not navigatorId then
            return false
        end

        if not navigatorVertical(site.y+1) then
            return false
        end

        if turtle.detect() then
            return false
        end

        if not selfSelectKind("wireless_modem") or not turtle.place() then
            return false
        end

        sleep(0.2)

        if not navigatorVertical(site.y) then
            return false
        end

        pcall(peripheral.call,"front","turnOn")

        local packet={
            type="configure",
            target=navigatorId,
            role="navigator",
            number=navNumber,
            managerId=cfg.managerId,
            masterForemanId=cfg.masterForemanId,
            session=cfg.session
        }

        local installed=false
        local lastConfigure=0
        local deadline=now()+30

        while not installed and now()<deadline do
            if now()-lastConfigure>=1 then
                send(navigatorId,packet)
                pcall(peripheral.call,"front","turnOn")
                lastConfigure=now()
            end

            local _,reply=waitInbox(function(sender,m)
                return sender==navigatorId and type(m)=="table" and
                    m.type=="install_ok" and m.role=="navigator" and
                    tonumber(m.number)==navNumber
            end,0.5)

            if reply then
                installed=true
            end
        end

        if not installed then
            return false
        end

        return true
    end

    local function setupNavigators()
        if number~=4 then return false end

        state.navigatorSetupActive=true
        state.navigatorsReady=state.navigatorsReady or {}
        state.phase="NAVIGATOR_SETUP"
        saveState()
        sendState("Preparing GPS Navigators")

        if not state.navigatorSuppliesLoaded then
            if not loadNavigatorSupplies() then
                return false
            end
            state.navigatorSuppliesLoaded=true
            saveState()
        end

        local order={1,2,4,3}

        for _,navNumber in ipairs(order) do
            if not state.navigatorsReady[navNumber] then
                state.phase="NAVIGATOR_" .. tostring(navNumber)
                saveState()
                sendState("Deploying Navigator-" .. tostring(navNumber))

                if not deployNavigator(navNumber) then
                    state.phase="NAVIGATOR_SETUP_BLOCKED"
                    saveState()
                    sendState("Navigator-" .. tostring(navNumber) .. " deployment blocked")
                    return false
                end

                state.navigatorsReady[navNumber]=true
                saveState()
            end
        end

        if state.y<10 then
            if not navigatorVertical(10) then return false end
        end

        if not navigatorGoTo(0,10,-5) then
            return false
        end

        if not navigatorVertical(0) then
            return false
        end

        if not faceTracked(DIR_N) then
            return false
        end

        state.navigatorSetupActive=false
        state.navigatorSetupDone=true
        state.navigatorSuppliesLoaded=nil
        state.phase="IDLE"
        saveState()
        checkpointForeman()
        sendState("GPS Navigator deployment complete")

        for i=1,3 do
            send(cfg.controller,{
                type="navigator_setup_done",
                number=4,
                id=id
            })
            send(cfg.managerId,{
                type="navigator_setup_done",
                number=4,
                id=id,
                session=cfg.session
            })
            sleep(0.1)
        end

        return true
    end

    local function commissionAssigned()
        state.phase="COMMISSIONING"
        state.commissionedRows = state.commissionedRows or {}
        saveState()
        sendState("Collecting miner startup fuel")

        if not loadCommissionFuel() then
            return false
        end

        sendState("Commissioning assigned miners")

        if not validateCommissionPackage() then
            return false
        end

        local first=cfg.rowStart
        local last=cfg.rowEnd
        local firstPending=nil

        for row=first,last do
            if not state.commissionedRows[row] then
                firstPending=row
                break
            end
        end

        if firstPending then
            local firstIsBootstrap=number==1 and firstPending==1 and not state.firstInstallerRecovered

            if not firstIsBootstrap then
                if not goTo(firstPending,0) then
                    return false
                end
                faceTracked(DIR_N)
                saveState()
            end
        end

        for row=first,last do
            if flags.recallMode then
                return false
            end

            if not state.commissionedRows[row] then
                local useBootstrapDrive=number==1 and row==1 and not state.firstInstallerRecovered

                if useBootstrapDrive then
                    if not commissionMiner(row,true) then
                        return false
                    end
                else
                    if state.x~=row or state.z~=0 then
                        if not goTo(row,0) then
                            return false
                        end
                        faceTracked(DIR_N)
                        saveState()
                    end

                    if not commissionMiner(row,false) then
                        return false
                    end
                end

                state.commissionedRows[row]=true
                saveState()

                if row<last then
                    local nextRow=row+1

                    if useBootstrapDrive then
                        if not goTo(nextRow,0) then
                            return false
                        end
                    else
                        if state.x~=row or state.z~=0 then
                            state.phase="PLACEMENT_ERROR"
                            saveState()
                            sendState("Foreman left staging line after commissioning")
                            return false
                        end

                        if not moveStep(DIR_E) then
                            return false
                        end
                    end

                    faceTracked(DIR_N)
                    saveState()

                    if state.x~=nextRow or state.z~=0 or state.dir~=DIR_N then
                        state.phase="PLACEMENT_ERROR"
                        saveState()
                        sendState("Could not stage for next miner")
                        return false
                    end
                end
            end
        end

        returnUnusedFuel()
        returnInstaller()
        state.commissionFuelLoaded=false
        state.setupDone=true
        state.phase="IDLE"
        saveState()
        returnHome()
        for i=1,3 do
            send(cfg.controller,{
                type="commission_done",
                number=number,
                id=id
            })
            sleep(0.1)
        end
        sendState("Miner setup complete")
        return true
    end

    local function ensureMasterSeedFuel()
        if turtle.getFuelLevel() == "unlimited" or turtle.getFuelLevel() > 0 then
            return true
        end

        while turtle.getFuelLevel() ~= "unlimited" and turtle.getFuelLevel() <= 0 do
            local slot = selfFindSlot("coal")
            if slot then
                turtle.select(slot)
                if not turtle.refuel(1) then
                    slot = nil
                end
            end

            if not slot then
                state.phase="WAITING_SEED_FUEL"
                saveState()
                sendState("Place one coal or charcoal anywhere in Foreman-1 inventory")
                clearAndPrint({
                    "Mine v30 Foreman-1",
                    "",
                    "Seed fuel required.",
                    "Place coal or charcoal",
                    "anywhere in inventory.",
                    "Setup resumes automatically."
                })
                sleep(1)
            end
        end

        state.phase="MASTER_SETUP"
        saveState()
        return true
    end

    local function masterFuelAndLoadCoal()
        if not goTo(-2,0) then
            return false
        end

        faceTracked(DIR_N)

        if not refuelAtFrontTo(FOREMAN_FUEL_TARGET) then
            return false
        end

        local needed = 212 - selfCount("coal")
        if needed > 0 then
            if takeNamedIntoSelf("coal",needed) < needed then
                return false
            end
        end

        return true
    end

    local function masterLoadSupplies()
        if not goTo(0,0) then
            return false
        end

        faceTracked(DIR_N)

        local needDrives = 5 - selfCount("disk_drive")
        if needDrives > 0 and takeNamedIntoSelf("disk_drive",needDrives) < needDrives then
            return false
        end

        local needMiners = 16 - selfCount("wireless_mining_turtle")
        if needMiners > 0 and takeNamedIntoSelf("wireless_mining_turtle",needMiners) < needMiners then
            return false
        end

        local needForemen = 3 - selfCount("narcissistic_wireless_turtle")
        if needForemen > 0 and takeNamedIntoSelf("narcissistic_wireless_turtle",needForemen) < needForemen then
            return false
        end

        local needNavigators = 4 - selfCount("advanced_wireless_turtle")
        if needNavigators > 0 and takeNamedIntoSelf("advanced_wireless_turtle",needNavigators) < needNavigators then
            return false
        end

        local needFloppies = 4 - selfCount("floppy")
        if needFloppies > 0 and takeNamedIntoSelf("floppy",needFloppies) < needFloppies then
            return false
        end

        return true
    end

    local function masterPlaceBootstrapInstaller()
        if selfCount("disk_drive")<1 or selfCount("floppy")<1 then
            return false
        end

        if not goTo(1,-2) then
            return false
        end

        if not ensureGroundLevel() then
            return false
        end

        faceTracked(DIR_N)
        saveState()

        if peripheral.getType("front")=="drive" then
            local slot=selfTargetSlot("disk_drive")
            if not slot then
                return false
            end
            turtle.select(slot)
            if not turtle.dig() then
                state.phase="PLACEMENT_ERROR"
                saveState()
                sendState("Cannot remove misplaced ground bootstrap Disk Drive")
                return false
            end
        elseif frontComputerId() then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Bootstrap pad occupied by a turtle")
            return false
        elseif turtle.detect() then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Bootstrap pad blocked at ground level")
            return false
        end

        if not ensureInstallerLevel() then
            return false
        end

        faceTracked(DIR_N)

        if peripheral.getType("front")~="drive" then
            if turtle.detect() then
                state.phase="PLACEMENT_ERROR"
                saveState()
                sendState("Bootstrap installer square blocked at relative Y 1")
                ensureGroundLevel()
                return false
            end

            if not selfSelectKind("disk_drive") then
                ensureGroundLevel()
                return false
            end

            if not turtle.place() then
                ensureGroundLevel()
                return false
            end
            sleep(0.2)
        end

        if peripheral.getType("front")~="drive" then
            state.phase="VERTICAL_ERROR"
            saveState()
            sendState("Bootstrap Disk Drive is not directly in front at installer height")
            ensureGroundLevel()
            return false
        end

        if not disk.isPresent("front") then
            if not selfSelectKind("floppy") then
                ensureGroundLevel()
                return false
            end

            if not turtle.drop(1) then
                ensureGroundLevel()
                return false
            end
            sleep(0.3)
        end

        if not disk.isPresent("front") then
            ensureGroundLevel()
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Bootstrap floppy verification failed")
            return false
        end

        if not ensureGroundLevel() then
            return false
        end

        faceTracked(DIR_N)

        if peripheral.getType("front")=="drive" then
            state.phase="VERTICAL_ERROR"
            saveState()
            sendState("Bootstrap Disk Drive detected at ground level")
            return false
        end

        saveState()
        return true
    end


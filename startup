local REGIONAL_MANAGER = 0
local MASTER_FOREMAN = 0

_G.REGIONAL_MANAGER=REGIONAL_MANAGER
_G.MASTER_FOREMAN=MASTER_FOREMAN

local RAW="https://raw.githubusercontent.com/salesmanhappymask/Miner/main/"

local function readFile(path)
    local f=fs.open(path,"r")
    if not f then return nil end
    local data=f.readAll()
    f.close()
    return data
end

local function writeFile(path,data)
    local f=fs.open(path,"w")
    if not f then return false end
    f.write(data)
    f.close()
    return true
end

local function fetch(name)
    local response=http.get(RAW .. name)
    if not response then return nil end
    local data=response.readAll()
    response.close()
    return data
end

local function loadCfg()
    for _,path in ipairs({"node.cfg","node.cfg.new","node.cfg.bak"}) do
        local raw=readFile(path)
        if raw then
            local ok,value=pcall(textutils.unserialize,raw)
            if ok and type(value)=="table" then return value end
        end
    end
    if fs.exists("node.cfg") or fs.exists("node.cfg.new") or fs.exists("node.cfg.bak") then
        error("node.cfg unreadable; bootstrap refused to avoid replacing this node")
    end
    return nil
end

local function runningFromDisk()
    local p=shell.getRunningProgram() or ""
    return p:sub(1,5)=="disk/" or p:sub(1,6)=="/disk/"
end

local function managerAutoUpdate()
    if REGIONAL_MANAGER~=1 or runningFromDisk() then return end
    local localVersion=tonumber((readFile("version") or ""):match("^%s*(%d+)%s*$")) or 0
    local remote=fetch("version")
    if not remote then
        print("Automatic update check unavailable; starting installed release.")
        sleep(1)
        return
    end
    local remoteVersion=tonumber(tostring(remote):match("^%s*(%d+)%s*$"))
    if not remoteVersion then
        print("Automatic update check returned an invalid version; starting installed release.")
        sleep(1)
        return
    end
    if remoteVersion>localVersion then
        print("Release "..tostring(remoteVersion).." available. Updating automatically...")
        if not shell.run("update","manager","--auto-reboot","--preserve-state") then
            error("Automatic Regional Manager update failed")
        end
        error("Automatic update returned without rebooting")
    end
end

local function ensureLocal(name)
    if fs.exists(name) then
        return true
    end

    local data=fetch(name)
    if not data then
        return false
    end

    if not writeFile(name .. ".new",data) then
        return false
    end

    if fs.exists(name) then fs.delete(name) end
    fs.move(name .. ".new",name)
    return true
end

local function releaseBase(role)
    local found=false
    for _,marker in ipairs({"active_release.new","active_release","active_release.bak"}) do
        if fs.exists(marker) then
            found=true
            local version=(readFile(marker) or ""):match("^%s*(%d+)%s*$")
            if version then
                local base="releases/" .. version .. "/"
                local ready=readFile(base .. "ready")
                local common=readFile(base .. "common")
                if ready==version and common and
                    common:match("^%s*VERSION%s*=%s*(%d+)")==version and
                    fs.exists(base .. role) then
                    return base
                end
            end
        end
    end
    if found then error("No complete active release; inspect releases and activation markers") end
    return nil
end

local function runFile(path,role,autoRecover)
    local ok,err
    if autoRecover and parallel and parallel.waitForAny then
        local finished=false
        parallel.waitForAny(function()
            ok,err=pcall(dofile,path)
            finished=true
        end,function()
            sleep(15)
            if not finished and fs.exists(".runtime_crash_count") then
                fs.delete(".runtime_crash_count")
            end
            while not finished do
                sleep(60)
            end
        end)
    else
        ok,err=pcall(dofile,path)
    end

    if ok and autoRecover then
        ok=false
        err=tostring(role) .. " runtime exited unexpectedly"
    elseif ok then
        return
    end

    if tostring(err)=="Terminated" then
        if debugLog then pcall(debugLog,"STOP","Manual termination","INFO") end
        if debugFlush then pcall(debugFlush) end
        return
    end

    if debugLog then pcall(debugLog,"CRASH",tostring(err),"ERROR") end
    if debugFlush then pcall(debugFlush) end
    local f=fs.open(role .. "_error.log","w")
    if f then
        f.write(tostring(err))
        f.close()
    end

    term.setBackgroundColor(colors.black)
    term.setTextColor(colors.white)
    term.clear()
    term.setCursorPos(1,1)
    print(role .. " runtime stopped:")
    print(tostring(err))
    print("")
    print("Error saved to " .. role .. "_error.log")

    if autoRecover then
        local count=tonumber(readFile(".runtime_crash_count") or "0") or 0
        count=count+1
        writeFile(".runtime_crash_count",tostring(count))
        if count<=3 then
            print("Automatic reboot " .. tostring(count) .. "/3 in 3 seconds")
            sleep(3)
            os.reboot()
        end
        print("Automatic reboot stopped after 3 consecutive crashes")
    end

    while true do
        sleep(60)
    end
end

managerAutoUpdate()

local base=""
local cfg=loadCfg()
local roleFile
local roleName

if REGIONAL_MANAGER==1 and MASTER_FOREMAN==1 then
    error("REGIONAL_MANAGER and MASTER_FOREMAN cannot both be enabled")
elseif REGIONAL_MANAGER==1 then
    roleFile="manager"
    roleName="regional_manager"
elseif MASTER_FOREMAN==1 then
    roleFile="foreman"
    roleName="master_foreman"
elseif cfg then
    roleFile=cfg.role
    roleName=tostring(cfg.role)
else
    roleFile="bootstrap"
    roleName="bootstrap"
end

if runningFromDisk() and not cfg then
    base="/disk/"

    if not fs.exists(base .. "common") or not fs.exists(base .. "bootstrap") then
        error("Installer disk is missing common/bootstrap")
    end
else
    base=releaseBase(roleFile) or ""
    if base=="" then
        if not ensureLocal("common") then
            error("Cannot install common")
        end

        if not ensureLocal(roleFile) then
            error("Cannot install role file " .. tostring(roleFile))
        end
    end
end

_G.SWARM_ROLE_NAME=roleName
runFile(base .. "common","common",false)
runFile(base .. roleFile,roleName,true)
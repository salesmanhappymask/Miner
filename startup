local function pairMasterWithRegionalManager()
    if not openNetwork() then
        error("Wireless modem not found")
    end

    local myId=os.getComputerID()
    local lastBroadcast=0

    while true do
        if now()-lastBroadcast>=2 then
            broadcast({
                type="master_pair_seek",
                version=VERSION,
                masterForemanId=myId
            })
            lastBroadcast=now()
        end

        local sender,message=rednet.receive(PROTOCOL,0.5)

        if sender and type(message)=="table" and
            message.type=="manager_pair_offer" and message.version==VERSION then
            send(sender,{
                type="master_pair_accept",
                version=VERSION,
                masterForemanId=myId,
                managerId=sender,
                nonce=message.nonce
            })

            local deadline=now()+5
            while now()<deadline do
                local s,m=rednet.receive(PROTOCOL,0.5)
                if s==sender and type(m)=="table" and
                    m.type=="manager_pair_confirm" and
                    m.version==VERSION and m.masterForemanId==myId and
                    m.nonce==message.nonce and m.session then
                    send(sender,{
                        type="master_pair_complete",
                        version=VERSION,
                        masterForemanId=myId,
                        managerId=sender,
                        session=m.session,
                        nonce=m.nonce
                    })
                    setRegionalManager(sender)
                    return sender,m.session
                end
            end
        end
    end
end

local function registerNodeWithManager(cfg)
    local managerId=tonumber(cfg and cfg.managerId)
    if not managerId then
        return false
    end

    setRegionalManager(managerId)

    local packet={
        type="node_register",
        version=VERSION,
        session=cfg.session,
        id=os.getComputerID(),
        role=cfg.role,
        managerId=managerId,
        masterForemanId=cfg.masterForemanId,
        number=cfg.number,
        row=cfg.row,
        rowStart=cfg.rowStart,
        rowEnd=cfg.rowEnd,
        foremanId=cfg.foremanId,
        foremanNumber=cfg.foremanNumber,
        x=cfg.x,
        y=cfg.y,
        z=cfg.z
    }

    local deadline=now()+15
    local lastSend=-10

    while now()<deadline do
        if now()-lastSend>=1 then
            send(managerId,packet)
            lastSend=now()
        end

        local sender,message=rednet.receive(PROTOCOL,0.5)

        if sender==managerId and type(message)=="table" and
            message.type=="node_registered" and message.version==VERSION and
            message.session==cfg.session and message.id==os.getComputerID() then
            if tonumber(message.managerId)~=managerId or
                tonumber(message.masterForemanId)~=tonumber(cfg.masterForemanId) then
                return false
            end

            if cfg.role=="miner" then
                if tonumber(message.row)~=tonumber(cfg.row) or
                    tonumber(message.foremanId)~=tonumber(cfg.foremanId) then
                    return false
                end
            elseif cfg.role=="foreman" then
                if tonumber(message.number)~=tonumber(cfg.number) then
                    return false
                end
            elseif cfg.role=="navigator" then
                if tonumber(message.number)~=tonumber(cfg.number) then
                    return false
                end
            end

            return true
        end
    end

    return false
end

local function ensureManagerRegistration(cfg)
    while not registerNodeWithManager(cfg) do
        term.setBackgroundColor(colors.black)
        term.setTextColor(colors.white)
        term.clear()
        term.setCursorPos(1,1)
        print("Waiting for Regional Manager...")
        sleep(2)
    end
    return true
end

local function runMinerCommissioning(cfg)
    setRegionalManager(cfg.managerId)
    if not openNetwork() then
        error("Wireless modem not found")
    end
    ensureManagerRegistration(cfg)

    local initialDir=cfg.placementSupported and DIR_N or DIR_S

    local state=loadTable("miner.tmp") or {
        row=cfg.row,
        depth=0,
        pos=0,
        dir=initialDir,
        phase="COMMISSIONING",
        request=nil,
        requestSeq=0,
        resumeDepth=0,
        resumePos=0,
        resumeDir=DIR_N,
        complete=false,
        installerHeld=false,
        installerFuelSlot=nil,
        orientationTurns=0,
        orientationTurnIntent=nil,
        orientationCalibrated=false
    }

    state.row=cfg.row
    state.phase="COMMISSIONING"
    state.seq=tonumber(state.seq) or 0
    state.tempSteps=tonumber(state.tempSteps) or 0

    if state.motionIntent and state.motionIntent.kind=="temp_forward" then
        local monitorState,monitorSeq=requestPoseBackup("miner",5,cfg.session)
        local intentSeq=tonumber(state.motionIntent.seq) or (state.seq+1)

        if monitorState and tonumber(monitorSeq or monitorState.seq or 0)>=intentSeq and monitorState.tempSteps then
            state.tempSteps=monitorState.tempSteps
            state.seq=tonumber(monitorState.seq) or intentSeq
            state.motionIntent=nil
        else
            local fuelNow=turtle.getFuelLevel()
            local fuelBefore=state.motionIntent.fuelBefore
            if type(fuelNow)=="number" and type(fuelBefore)=="number" then
                if fuelNow<fuelBefore then
                    state.tempSteps=state.motionIntent.toStep
                    state.seq=intentSeq
                else
                    state.tempSteps=state.motionIntent.fromStep
                end
                state.motionIntent=nil
            else
                state.recoveryLocked=true
                state.recoveryReason="Temporary Miner-01 position ambiguous after restart"
            end
        end
    end

    saveTable("miner.tmp",state)

    local function save()
        saveTable("miner.tmp",state)
    end

    local function ack(packet)
        for i=1,3 do
            send(cfg.foremanId,packet)
            sleep(0.1)
        end
    end

    local function temporarySlot()
        if state.installerFuelSlot and state.installerFuelSlot>=2 and state.installerFuelSlot<=16 then
            return state.installerFuelSlot
        end

        for slot=16,2,-1 do
            if turtle.getItemCount(slot)==0 then
                return slot
            end
        end

        return nil
    end

    local function establishPlacedMinerNorth()
        if state.orientationCalibrated then
            return state.dir==DIR_N
        end

        if cfg.placementMode=="SUPPORTED" then
            state.dir=DIR_N
            state.orientationTurns=0
            state.orientationTurnIntent=nil
            state.orientationCalibrated=true
            save()
            return true
        end

        if cfg.placementMode~="AIR" then
            state.recoveryLocked=true
            state.recoveryReason="Unknown miner placement mode"
            state.phase="RECOVERY_LOCK"
            save()
            return false
        end

        state.dir=tonumber(state.dir) or DIR_S
        state.orientationTurns=tonumber(state.orientationTurns) or 0

        if state.orientationTurnIntent then
            state.recoveryLocked=true
            state.recoveryReason="Server restart interrupted air-placement orientation correction"
            state.phase="RECOVERY_LOCK"
            save()
            return false
        end

        while state.orientationTurns<2 do
            local intent={
                from=state.dir,
                to=(state.dir+1)%4,
                turnNumber=state.orientationTurns+1
            }

            state.orientationTurnIntent=intent
            save()

            if not turtle.turnRight() then
                state.orientationTurnIntent=nil
                state.recoveryLocked=true
                state.recoveryReason="Could not turn air-placed miner toward north"
                state.phase="RECOVERY_LOCK"
                save()
                return false
            end

            state.dir=intent.to
            state.orientationTurns=intent.turnNumber
            state.orientationTurnIntent=nil
            save()
        end

        if state.dir~=DIR_N then
            state.recoveryLocked=true
            state.recoveryReason="Air-placement orientation correction did not end north"
            state.phase="RECOVERY_LOCK"
            save()
            return false
        end

        state.orientationCalibrated=true
        save()
        return true
    end

    status("miner","COMMISSIONING",{
        row=cfg.row,
        foreman=cfg.foremanNumber,
        message=state.installerHeld and "Holding Disk Drive" or "Waiting for assigned foreman"
    })

    while true do
        local sender,message=rednet.receive(PROTOCOL,1)

        if sender==cfg.managerId and type(message)=="table" then
            if message.type=="status_query" then
                status("miner","COMMISSIONING",{
                    row=cfg.row,
                    foreman=cfg.foremanNumber,
                    message=state.installerHeld and "Holding Disk Drive" or "Commissioning"
                })
            end

        elseif sender==cfg.foremanId and type(message)=="table" then
            if message.type=="commission_refuel" then
                turtle.select(1)
                local count=turtle.getItemCount(1)

                if count>0 and turtle.getFuelLevel()~="unlimited" then
                    turtle.refuel(count)
                end

                ack({
                    type="commission_refueled",
                    id=os.getComputerID(),
                    row=cfg.row,
                    fuel=turtle.getFuelLevel()
                })

            elseif message.type=="return_installer" then
                if not state.installerHeld then
                    turtle.select(1)

                    if turtle.getItemCount(1)>0 then
                        local slot=temporarySlot()

                        if not slot then
                            send(cfg.foremanId,{
                                type="installer_break_failed",
                                id=os.getComputerID(),
                                row=cfg.row,
                                reason="no_empty_slot"
                            })
                        else
                            state.installerFuelSlot=slot
                            turtle.transferTo(slot)
                            save()
                        end
                    end

                    if turtle.getItemCount(1)==0 then
                        turtle.select(1)

                        if turtle.digUp() then
                            state.installerHeld=true
                            save()
                        else
                            send(cfg.foremanId,{
                                type="installer_break_failed",
                                id=os.getComputerID(),
                                row=cfg.row,
                                reason="dig_failed"
                            })
                        end
                    end
                end

                if state.installerHeld then
                    ack({
                        type="installer_ready",
                        id=os.getComputerID(),
                        row=cfg.row
                    })
                end

            elseif message.type=="installer_taken" then
                if state.installerHeld then
                    state.installerHeld=false

                    if state.installerFuelSlot and turtle.getItemCount(state.installerFuelSlot)>0 then
                        turtle.select(state.installerFuelSlot)
                        turtle.transferTo(1)
                    end

                    state.installerFuelSlot=nil
                    turtle.select(1)
                    save()
                end

                ack({
                    type="installer_returned",
                    id=os.getComputerID(),
                    row=cfg.row
                })

            elseif message.type=="deploy_miner" then
                state.phase="ORIENTING_FOR_DEPLOYMENT"
                save()

                if not state.orientationCalibrated then
                    if not establishPlacedMinerNorth() then
                        ack({
                            type="miner_deploy_blocked",
                            id=os.getComputerID(),
                            row=cfg.row,
                            reason=state.recoveryReason
                        })
                    end
                end

                if state.recoveryLocked then
                    status("miner","RECOVERY_LOCK",{
                        row=cfg.row,
                        foreman=cfg.foremanNumber,
                        recovery=state.recoveryReason,
                        message="Deployment halted rather than guessing position"
                    })
                elseif cfg.tempDeployment then
                    state.phase="MOVING_TO_ORIGIN"
                    save()

                    while state.tempSteps<2 do
                        local intent={
                            kind="temp_forward",
                            seq=state.seq+1,
                            fuelBefore=turtle.getFuelLevel(),
                            fromStep=state.tempSteps,
                            toStep=state.tempSteps+1
                        }
                        state.motionIntent=intent
                        save()

                        if turtle.forward() then
                            state.tempSteps=intent.toStep
                            state.seq=intent.seq
                            state.motionIntent=nil
                            save()
                        else
                            state.motionIntent=nil
                            state.recoveryLocked=true
                            state.recoveryReason="Miner-01 temporary north corridor is blocked"
                            state.phase="RECOVERY_LOCK"
                            save()
                            break
                        end
                    end
                    cfg.tempDeployment=false
                end

                if state.recoveryLocked then
                    ack({
                        type="miner_deploy_blocked",
                        id=os.getComputerID(),
                        row=cfg.row,
                        reason=state.recoveryReason
                    })
                else
                    state.seq=state.seq+1
                    state.x=cfg.row
                    state.y=0
                    state.z=0
                    state.depth=0
                    state.pos=0
                    state.dir=DIR_N
                    state.resumeX=cfg.row
                    state.resumeY=0
                    state.resumeZ=0
                    state.resumeDepth=0
                    state.resumePos=0
                    state.resumeDir=DIR_N
                    state.phase="WAITING"
                    state.installerHeld=false
                    state.installerFuelSlot=nil
                    state.motionIntent=nil
                    state.turnIntent=nil
                    state.orientationTurnIntent=nil
                    state.originEstablished=true
                    state.orientationCalibrated=true

                    cfg.orientationCalibrated=true
                    cfg.commissioned=true

                    saveTable("node.cfg",cfg)
                    save()

                    checkpointPose("miner",state.seq,{
                        row=cfg.row,
                        session=cfg.session,
                        x=state.x,
                        y=state.y,
                        z=state.z,
                        depth=state.depth,
                        pos=state.pos,
                        dir=state.dir,
                        phase=state.phase,
                        resumeX=state.resumeX,
                        resumeY=state.resumeY,
                        resumeZ=state.resumeZ,
                        resumeDepth=state.resumeDepth,
                        resumePos=state.resumePos,
                        resumeDir=state.resumeDir,
                        complete=false,
                        originEstablished=true,
                        orientationCalibrated=true,
                        seq=state.seq
                    },cfg.session)

                    ack({
                        type="miner_deployed",
                        id=os.getComputerID(),
                        row=cfg.row
                    })

                    status("miner","WAITING",{
                        row=cfg.row,
                        foreman=cfg.foremanNumber,
                        x=state.x,
                        y=state.y,
                        z=state.z,
                        dir=state.dir,
                        message="Ready, north calibrated"
                    })

                    sleep(0.5)
                    os.reboot()
                end
            end
        end
    end
end

local function bootstrap()
    if not openNetwork() then
        error("Wireless modem not found")
    end

    local myID=os.getComputerID()
    local configured=nil

    while not configured do
        local sender,message=rednet.receive(PROTOCOL,2)

        if sender and type(message)=="table" and message.type=="configure" and message.target==myID then
            configured=message
            configured.controller=sender
        end
    end

    local placementSupported,detectedPlacementMode,detectedStartDir=detectPlacement()

    local source = readFile("/disk/startup") or readFile("disk/startup")
    if not source then
        error("Cannot read /disk/startup")
    end

    if not writeFile("startup.new", source) then
        error("Cannot write startup.new")
    end
    if readFile("startup.new") ~= source then
        error("Installed startup failed verification")
    end
    if fs.exists("startup") then
        fs.delete("startup")
    end
    fs.move("startup.new","startup")
    if readFile("startup") ~= source then
        error("Final startup verification failed")
    end

    if configured.role == "foreman" then
        local cfg = {
            version = VERSION,
            role = "foreman",
            number = configured.number,
            controller = configured.controller,
            rowStart = configured.rowStart,
            rowEnd = configured.rowEnd,
            homeX = 0,
            homeZ = -(configured.number + 1),
            startX = 1,
            startZ = -1,
            placementMode = detectedPlacementMode,
            placementSupported = placementSupported,
            startDir = detectedStartDir,
            master = false,
            managerId = configured.managerId,
            masterForemanId = configured.masterForemanId,
            session = configured.session
        }
        saveTable("node.cfg", cfg)
        setRegionalManager(cfg.managerId)
        if not registerNodeWithManager(cfg) then
            error("Regional Manager registration failed")
        end
        os.setComputerLabel("Foreman-" .. tostring(cfg.number))
        for i=1,3 do
            send(configured.controller, {
                type = "install_ok",
                id = myID,
                role = "foreman",
                number = cfg.number,
                placementSupported = cfg.placementSupported,
                placementMode = cfg.placementMode,
                detectedStartDir = cfg.startDir
            })
            sleep(0.1)
        end

        local deployed = false
        while not deployed do
            local sender, message = rednet.receive(PROTOCOL, 5)
            if sender == configured.controller and type(message) == "table" then
                if message.type == "deploy_foreman" and message.target == myID then
                    local statePath="foreman" .. tostring(cfg.number) .. ".tmp"
                    local state={
                        x=cfg.startX,
                        z=cfg.startZ,
                        y=0,
                        dir=cfg.startDir,
                        phase="DEPLOYING",
                        number=cfg.number,
                        setupDone=false,
                        orientationCalibrated=false,
                        session=cfg.session,
                        seq=0
                    }

                    saveTable(statePath,state)
                    checkpointPose("foreman",state.seq,state,cfg.session)
                    selfRefuelTo(FOREMAN_FUEL_TARGET)

                    local function saveDeploy()
                        saveTable(statePath,state)
                    end

                    local function checkpointDeploy()
                        local snapshot=textutils.unserialize(textutils.serialize(state))
                        snapshot.motionIntent=nil
                        snapshot.turnIntent=nil
                        checkpointPose("foreman",state.seq,snapshot,cfg.session)
                    end

                    local function deployTurn(right)
                        local from=state.dir
                        local to=right and ((from+1)%4) or ((from+3)%4)
                        local intent={seq=state.seq+1,from=from,to=to}
                        state.turnIntent=intent
                        saveDeploy()

                        local ok
                        if right then ok=turtle.turnRight() else ok=turtle.turnLeft() end
                        if not ok then
                            state.turnIntent=nil
                            saveDeploy()
                            return false
                        end

                        state.dir=to
                        state.seq=intent.seq
                        checkpointDeploy()
                        state.turnIntent=nil
                        saveDeploy()
                        return true
                    end

                    local function deployFace(target)
                        while state.dir~=target do
                            local diff=(target-state.dir)%4
                            if diff==3 then
                                if not deployTurn(false) then return false end
                            else
                                if not deployTurn(true) then return false end
                            end
                        end
                        return true
                    end

                    local function deployForward(directionName)
                        local attempts=0
                        while true do
                            local tx=state.x
                            local tz=state.z
                            if state.dir==DIR_N then tz=tz+1
                            elseif state.dir==DIR_E then tx=tx+1
                            elseif state.dir==DIR_S then tz=tz-1
                            else tx=tx-1 end

                            local intent={
                                seq=state.seq+1,
                                fuelBefore=turtle.getFuelLevel(),
                                from={x=state.x,z=state.z,y=0,dir=state.dir},
                                to={x=tx,z=tz,y=0,dir=state.dir}
                            }
                            state.motionIntent=intent
                            saveDeploy()

                            if turtle.forward() then
                                state.x=tx
                                state.z=tz
                                state.seq=intent.seq
                                checkpointDeploy()
                                state.motionIntent=nil
                                saveDeploy()
                                return true
                            end

                            state.motionIntent=nil
                            saveDeploy()
                            attempts=attempts+1
                            if attempts==1 or attempts%10==0 then
                                send(configured.controller,{
                                    type="foreman_deploy_blocked",
                                    id=myID,
                                    number=cfg.number,
                                    direction=directionName,
                                    attempts=attempts
                                })
                            end
                            sleep(0.5)
                        end
                    end

                    if not state.orientationCalibrated then
                        if cfg.placementMode=="SUPPORTED" then
                            state.dir=DIR_N
                        elseif cfg.placementMode=="AIR" then
                            state.dir=DIR_S

                            if not deployTurn(true) then
                                error("Cannot perform air-placement orientation correction")
                            end
                            if not deployTurn(true) then
                                error("Cannot perform air-placement orientation correction")
                            end

                            if state.dir~=DIR_N then
                                state.phase="RECOVERY_LOCK"
                                saveDeploy()
                                error("Air-placement orientation correction did not end north")
                            end
                        else
                            state.phase="RECOVERY_LOCK"
                            saveDeploy()
                            error("Unknown detected Foreman placement mode")
                        end

                        state.orientationCalibrated=true
                        checkpointDeploy()
                        saveDeploy()
                    end

                    local laneX=cfg.number

                    if not deployFace(DIR_E) then
                        error("Cannot face east for Foreman deployment")
                    end
                    while state.x<laneX do
                        if not deployForward("east") then
                            error("Cannot move east on Foreman deployment lane")
                        end
                    end

                    if not deployFace(DIR_S) then
                        error("Cannot face south for Foreman deployment")
                    end
                    while state.z>cfg.homeZ do
                        if not deployForward("south") then
                            error("Cannot move south to Foreman home row")
                        end
                    end

                    if not deployFace(DIR_W) then
                        error("Cannot face west for Foreman deployment")
                    end
                    while state.x>cfg.homeX do
                        if not deployForward("west") then
                            error("Cannot move west into Foreman home")
                        end
                    end

                    if not deployFace(DIR_N) then
                        error("Cannot face north at Foreman home")
                    end

                    if state.x~=cfg.homeX or state.z~=cfg.homeZ or state.y~=0 or state.dir~=DIR_N then
                        state.phase="RECOVERY_LOCK"
                        saveDeploy()
                        error("Foreman deployment ended at incorrect home coordinate")
                    end

                    state.phase="WAITING_SETUP"
                    state.setupDone=false
                    checkpointDeploy()
                    saveDeploy()

                    for i=1,3 do
                        send(configured.controller,{
                            type="foreman_deployed",
                            id=myID,
                            number=cfg.number
                        })
                        sleep(0.1)
                    end
                    deployed=true
                end
            end
        end
        os.reboot()
    elseif configured.role == "navigator" then
        local site=NAVIGATOR_SITES[tonumber(configured.number)]

        if not site then
            error("Invalid Navigator number")
        end

        local cfg={
            version=VERSION,
            role="navigator",
            number=tonumber(configured.number),
            controller=configured.controller,
            x=site.x,
            y=site.y,
            z=site.z,
            startX=1,
            startY=0,
            startZ=-1,
            placementSupported=placementSupported,
            placementMode=detectedPlacementMode,
            startDir=detectedStartDir,
            deployed=false,
            managerId=configured.managerId,
            masterForemanId=configured.masterForemanId,
            session=configured.session
        }

        saveTable("node.cfg",cfg)
        setRegionalManager(cfg.managerId)
        os.setComputerLabel("Navigator-" .. tostring(cfg.number))

        for i=1,3 do
            send(configured.controller,{
                type="install_ok",
                id=myID,
                role="navigator",
                number=cfg.number
            })
            sleep(0.1)
        end

        sleep(0.5)
        os.reboot()

    elseif configured.role == "miner" then
        local cfg={
            version=VERSION,
            role="miner",
            row=configured.row,
            homeX=configured.row,
            homeY=0,
            homeZ=0,
            homeDir=DIR_N,
            shaftMinZ=0,
            shaftMaxZ=15,
            foremanId=configured.foremanId,
            foremanNumber=configured.foremanNumber,
            tempDeployment=configured.tempDeployment and true or false,
            placementMode=detectedPlacementMode,
            placementSupported=placementSupported,
            managerId=configured.managerId,
            masterForemanId=configured.masterForemanId,
            session=configured.session,
            commissioned=false
        }

        saveTable("node.cfg",cfg)
        os.setComputerLabel(string.format("Miner-%02d",cfg.row))

        saveTable("miner.tmp",{
            row=cfg.row,
            depth=0,
            pos=0,
            dir=cfg.placementSupported and DIR_N or DIR_S,
            phase="COMMISSIONING",
            request=nil,
            requestSeq=0,
            resumeDepth=0,
            resumePos=0,
            resumeDir=DIR_N,
            complete=false,
            installerHeld=false,
            installerFuelSlot=nil,
            orientationTurns=0,
            orientationTurnIntent=nil,
            orientationCalibrated=false,
            originEstablished=false,
            seq=0
        })

        for i=1,3 do
            send(configured.controller,{
                type="install_ok",
                id=myID,
                role="miner",
                row=cfg.row,
                placementSupported=cfg.placementSupported,
                placementMode=cfg.placementMode,
                detectedStartDir=cfg.placementSupported and DIR_N or DIR_S
            })
            sleep(0.1)
        end

        runMinerCommissioning(cfg)
    else
        error("Unknown configured role")
    end
end

local function runMiner(cfg)
    setRegionalManager(cfg.managerId)
    if not openNetwork() then
        error("Wireless modem not found")
    end
    ensureManagerRegistration(cfg)

    local path="miner.tmp"
    local state=loadTable(path)

    if not state then
        local monitorState=requestPoseBackup("miner",5,cfg.session)
        local exactMonitorPose=monitorState and
            monitorState.row==cfg.row and
            type(monitorState.x)=="number" and type(monitorState.y)=="number" and
            type(monitorState.z)=="number" and type(monitorState.dir)=="number" and
            monitorState.originEstablished==true

        state=exactMonitorPose and monitorState or {
            row=cfg.row,
            x=cfg.row,
            y=0,
            z=0,
            depth=0,
            pos=0,
            dir=DIR_N,
            phase="RECOVERY_LOCK",
            request=nil,
            requestSeq=0,
            resumeX=cfg.row,
            resumeY=0,
            resumeZ=0,
            resumeDepth=0,
            resumePos=0,
            resumeDir=DIR_N,
            complete=false,
            originEstablished=false,
            seq=0
        }

        state.recoveryLocked=true
        state.recoveryReason=exactMonitorPose and
            "Local miner state missing; exact monitor pose retained for manual recovery" or
            "Local miner state missing and monitor has no exact pose"
        state.phase="RECOVERY_LOCK"
        saveTable(path,state)
    end

    cfg.homeX=tonumber(cfg.homeX) or cfg.row
    cfg.homeY=tonumber(cfg.homeY) or 0
    cfg.homeZ=tonumber(cfg.homeZ) or 0
    cfg.homeDir=tonumber(cfg.homeDir) or DIR_N
    cfg.shaftMinZ=tonumber(cfg.shaftMinZ) or 0
    cfg.shaftMaxZ=tonumber(cfg.shaftMaxZ) or 15

    state.row=cfg.row
    state.session=cfg.session
    state.seq=tonumber(state.seq) or 0
    state.x=tonumber(state.x) or cfg.row
    state.y=tonumber(state.y) or -(tonumber(state.depth) or 0)
    state.z=tonumber(state.z) or (tonumber(state.pos) or 0)
    state.dir=tonumber(state.dir) or DIR_N
    state.depth=-state.y
    state.pos=state.z
    state.resumeX=tonumber(state.resumeX) or cfg.row
    state.resumeY=tonumber(state.resumeY) or -(tonumber(state.resumeDepth) or 0)
    state.resumeZ=tonumber(state.resumeZ) or (tonumber(state.resumePos) or 0)
    state.resumeDir=tonumber(state.resumeDir) or DIR_N

    local function poseValid()
        return state.originEstablished==true and cfg.orientationCalibrated==true and
            state.x==cfg.homeX and state.y<=cfg.homeY and
            state.z>=cfg.shaftMinZ and state.z<=cfg.shaftMaxZ and
            state.dir>=DIR_N and state.dir<=DIR_W
    end

    local function minerSnapshot()
        return {
            row=state.row,
            session=cfg.session,
            x=state.x,
            y=state.y,
            z=state.z,
            depth=state.depth,
            pos=state.pos,
            dir=state.dir,
            phase=state.phase,
            request=state.request,
            requestSeq=state.requestSeq,
            resumeX=state.resumeX,
            resumeY=state.resumeY,
            resumeZ=state.resumeZ,
            resumeDepth=state.resumeDepth,
            resumePos=state.resumePos,
            resumeDir=state.resumeDir,
            complete=state.complete,
            originEstablished=state.originEstablished==true,
            orientationCalibrated=cfg.orientationCalibrated==true,
            seq=state.seq
        }
    end

    local function snapshotHasExactPose(snapshot)
        return snapshot and snapshot.row==cfg.row and
            type(snapshot.x)=="number" and type(snapshot.y)=="number" and
            type(snapshot.z)=="number" and type(snapshot.dir)=="number" and
            snapshot.originEstablished==true
    end

    local function applySnapshot(snapshot)
        if not snapshotHasExactPose(snapshot) then
            return false
        end

        state=snapshot
        state.row=cfg.row
        state.seq=tonumber(state.seq) or 0
        state.x=tonumber(state.x)
        state.y=tonumber(state.y)
        state.z=tonumber(state.z)
        state.dir=tonumber(state.dir)
        state.depth=-state.y
        state.pos=state.z
        state.resumeX=tonumber(state.resumeX) or cfg.row
        state.resumeY=tonumber(state.resumeY) or -(tonumber(state.resumeDepth) or 0)
        state.resumeZ=tonumber(state.resumeZ) or (tonumber(state.resumePos) or 0)
        state.resumeDir=tonumber(state.resumeDir) or DIR_N
        return true
    end

    do
        local managerState=requestPoseBackup("miner",5,cfg.session)

        if not poseValid() and managerState and snapshotHasExactPose(managerState) then
            applySnapshot(managerState)
            state.motionIntent=nil
            state.turnIntent=nil
            saveTable(path,state)
        elseif poseValid() and not state.motionIntent and not state.turnIntent then
            checkpointPose("miner",state.seq,minerSnapshot(),cfg.session)
        end
    end

    if state.motionIntent or state.turnIntent then
        local monitorState,monitorSeq=requestPoseBackup("miner",5,cfg.session)
        local intent=state.motionIntent or state.turnIntent
        local intentSeq=tonumber(intent.seq) or (state.seq+1)

        if monitorState and snapshotHasExactPose(monitorState) and
            tonumber(monitorSeq or monitorState.seq or 0)>=intentSeq then
            applySnapshot(monitorState)
            state.motionIntent=nil
            state.turnIntent=nil
            saveTable(path,state)
        elseif state.motionIntent then
            local fuelNow=turtle.getFuelLevel()
            local fuelBefore=state.motionIntent.fuelBefore
            local moved=nil

            if type(fuelNow)=="number" and type(fuelBefore)=="number" then
                moved=fuelNow<fuelBefore
            elseif type(fuelBefore)=="number" and fuelBefore<=0 then
                moved=false
            end

            if moved==nil then
                state.recoveryLocked=true
                state.recoveryReason="Position ambiguous after interrupted movement"
                state.phase="RECOVERY_LOCK"
            else
                local pose=moved and state.motionIntent.to or state.motionIntent.from
                state.x=pose.x
                state.y=pose.y
                state.z=pose.z
                state.dir=pose.dir
                state.depth=-state.y
                state.pos=state.z
                if moved then
                    state.seq=intentSeq
                end
                state.motionIntent=nil
            end
            saveTable(path,state)
        else
            state.recoveryLocked=true
            state.recoveryReason="Facing ambiguous after interrupted turn"
            state.phase="RECOVERY_LOCK"
            saveTable(path,state)
        end
    end

    if not poseValid() then
        state.recoveryLocked=true
        state.recoveryReason="Saved miner pose is outside its legal shaft"
        state.phase="RECOVERY_LOCK"
        saveTable(path,state)
    end

    local flags = {
        start=false,
        recallMode=nil,
        resume=false,
        serviceProbe=nil,
        dumpPrepare=nil,
        refuelNow=false,
        serviceComplete=false,
        newForeman=nil
    }
    local lastStatus = 0
    local lastRequest = 0
    local prepareForForemanService

    local function save()
        state.depth=-state.y
        state.pos=state.z
        saveTable(path,state)
    end

    local function checkpoint()
        checkpointPose("miner",state.seq,minerSnapshot(),cfg.session)
    end

    local function sendState(message)
        status("miner",state.phase,{
            row=state.row,
            foreman=cfg.foremanNumber,
            x=state.x,
            y=state.y,
            z=state.z,
            dir=state.dir,
            seq=state.seq,
            depth=state.depth,
            pos=state.pos,
            fuel=turtle.getFuelLevel(),
            request=state.request and state.request.kind or nil,
            recovery=state.recoveryReason,
            message=message or ""
        })
        lastStatus = now()
    end

    local function requestPacket(arrived)
        if not state.request then
            return
        end

        send(cfg.managerId,{
            type = arrived and "service_arrived" or "service_request",
            row = state.row,
            requestId = state.request.id,
            service = state.request.kind,
            minerId = os.getComputerID(),
            foremanId = cfg.foremanId,
            foremanNumber = cfg.foremanNumber,
            fuel = turtle.getFuelLevel(),
            x = state.x,
            y = state.y,
            z = state.z,
            dir = state.dir,
            session = cfg.session
        })
        lastRequest = now()
    end

    local function networkLoop()
        local timer = os.startTimer(1)
        while true do
            local event = {os.pullEvent()}
            if event[1] == "rednet_message" then
                local sender = event[2]
                local message = event[3]
                local protocol = event[4]
                if protocol == PROTOCOL and type(message) == "table" then
                    if sender == cfg.foremanId then
                        if message.type=="deploy_miner" and cfg.commissioned then
                            for i=1,3 do
                                send(cfg.foremanId,{
                                    type="miner_deployed",
                                    id=os.getComputerID(),
                                    row=cfg.row
                                })
                                sleep(0.1)
                            end
                        elseif message.type == "service_probe" and state.request and
                            message.requestId == state.request.id and state.phase=="WAITING_SERVICE" then
                            flags.serviceProbe=message.requestId
                        elseif message.type == "dump_prepare" and state.request and
                            message.requestId == state.request.id and state.phase=="WAITING_SERVICE" then
                            flags.dumpPrepare=message.requestId
                        elseif message.type == "refuel_now" and state.request and message.requestId == state.request.id then
                            flags.refuelNow = true
                        end
                    elseif sender == cfg.managerId then
                        if message.type == "start_mining" or message.type=="resume_swarm" then
                            flags.start = true
                            flags.resume = message.type=="resume_swarm"
                        elseif message.type == "service_complete" and state.request and message.requestId == state.request.id then
                            flags.serviceComplete = true
                        elseif message.type == "recall_command" then
                            flags.recallMode = message.mode or "NORMAL"
                        elseif message.type == "hold_position" then
                            state.phase="RECOVERY_LOCK"
                            state.recoveryLocked=true
                            state.recoveryReason=message.reason or "Regional Manager hold"
                            save()
                        elseif message.type == "status_query" then
                            sendState("")
                        end
                    end
                end
            elseif event[1] == "timer" and event[2] == timer then
                if state.request and now() - lastRequest >= REQUEST_REPEAT then
                    requestPacket(state.phase == "WAITING_SERVICE")
                end
                if now() - lastStatus >= STATUS_INTERVAL then
                    sendState("")
                end
                timer = os.startTimer(1)
            end
        end
    end

    local function beginTranslation(kind,toX,toY,toZ)
        if toX~=cfg.row or toY>0 or toZ<0 or toZ>15 then
            state.recoveryLocked=true
            state.recoveryReason="Movement would leave assigned miner shaft"
            state.phase="RECOVERY_LOCK"
            save()
            sendState(state.recoveryReason)
            return nil
        end

        local intent={
            kind=kind,
            seq=state.seq+1,
            fuelBefore=turtle.getFuelLevel(),
            from={x=state.x,y=state.y,z=state.z,dir=state.dir},
            to={x=toX,y=toY,z=toZ,dir=state.dir}
        }
        state.motionIntent=intent
        save()
        return intent
    end

    local function finishTranslation(intent,critical)
        state.x=intent.to.x
        state.y=intent.to.y
        state.z=intent.to.z
        state.dir=intent.to.dir
        state.seq=intent.seq
        state.depth=-state.y
        state.pos=state.z

        if critical or state.seq%10==0 then
            checkpoint()
        end

        state.motionIntent=nil
        save()
    end

    local function cancelTranslation()
        state.motionIntent=nil
        save()
    end

    local function attemptForward()
        local nx=state.x
        local nz=state.z

        if state.dir==DIR_N then
            nz=nz+1
        elseif state.dir==DIR_E then
            nx=nx+1
        elseif state.dir==DIR_S then
            nz=nz-1
        else
            nx=nx-1
        end

        local intent=beginTranslation("forward",nx,state.y,nz)
        if not intent then return false end
        if not turtle.forward() then
            cancelTranslation()
            return false
        end

        finishTranslation(intent,false)
        return true
    end

    local function attemptUp()
        local intent=beginTranslation("up",state.x,state.y+1,state.z)
        if not intent then return false end
        if not turtle.up() then
            cancelTranslation()
            return false
        end
        finishTranslation(intent,true)
        return true
    end

    local function attemptDown()
        local intent=beginTranslation("down",state.x,state.y-1,state.z)
        if not intent then return false end
        if not turtle.down() then
            cancelTranslation()
            return false
        end
        finishTranslation(intent,true)
        return true
    end

    local function turnStep(right)
        local from=state.dir
        local to=right and ((from+1)%4) or ((from+3)%4)
        local intent={
            seq=state.seq+1,
            from=from,
            to=to
        }
        state.turnIntent=intent
        save()

        local ok
        if right then
            ok=turtle.turnRight()
        else
            ok=turtle.turnLeft()
        end

        if not ok then
            state.turnIntent=nil
            save()
            return false
        end

        state.dir=to
        state.seq=intent.seq
        checkpoint()
        state.turnIntent=nil
        save()
        return true
    end

    local function face(target)
        while state.dir~=target do
            local diff=(target-state.dir)%4
            if diff==3 then
                if not turnStep(false) then return false end
            else
                if not turnStep(true) then return false end
            end
        end
        return true
    end

    local function digForward()
        while not attemptForward() do
            if state.recoveryLocked or flags.recallMode then
                return false
            end
            turtle.dig()
            turtle.attack()
            sleep(0.15)
        end
        return true
    end

    local function moveUp()
        if state.y>=0 then
            return false
        end
        while not attemptUp() do
            if state.recoveryLocked or flags.recallMode then
                return false
            end
            turtle.digUp()
            turtle.attackUp()
            sleep(0.15)
        end
        return true
    end

    local function moveDownExisting()
        while not attemptDown() do
            if state.recoveryLocked or flags.recallMode then
                return false
            end
            turtle.digDown()
            turtle.attackDown()
            sleep(0.15)
        end
        return true
    end

    local function descendMine()
        for i=1,5 do
            if state.recoveryLocked or flags.recallMode then
                return false
            end
            turtle.digDown()
            if attemptDown() then
                return true
            end
            turtle.attackDown()
            sleep(0.15)
        end
        return false
    end

    local function inventoryFull()
        for slot = 2,16 do
            if turtle.getItemCount(slot) == 0 then
                return false
            end
        end
        return true
    end

    local function distanceHome()
        return (-state.y) + state.z
    end

    local function neededService()
        local dump = inventoryFull()
        local fuel = turtle.getFuelLevel()
        local refuel = false
        if fuel ~= "unlimited" then
            refuel = fuel <= distanceHome() + MINER_SERVICE_RESERVE
        end
        if dump and refuel then
            return "BOTH"
        elseif dump then
            return "DUMP"
        elseif refuel then
            return "REFUEL"
        end
        return nil
    end

    local function goHome(recordResume)
        if state.recoveryLocked or not poseValid() then
            state.phase="RECOVERY_LOCK"
            state.recoveryReason=state.recoveryReason or "Unsafe miner pose; refusing automatic return"
            save()
            sendState(state.recoveryReason)
            return false
        end

        if recordResume then
            state.resumeX=state.x
            state.resumeY=state.y
            state.resumeZ=state.z
            state.resumeDepth=-state.y
            state.resumePos=state.z
            state.resumeDir=state.dir
            save()
        end

        while state.y<0 do
            if not moveUp() then
                return false
            end
        end

        if state.y~=cfg.homeY then
            state.recoveryLocked=true
            state.recoveryReason="Miner attempted to return above immutable surface bound"
            state.phase="RECOVERY_LOCK"
            save()
            sendState(state.recoveryReason)
            return false
        end

        if not face(DIR_S) then
            return false
        end

        while state.z>cfg.homeZ do
            if not digForward() then
                return false
            end
        end

        if state.z~=cfg.homeZ or state.x~=cfg.homeX or state.y~=cfg.homeY then
            state.recoveryLocked=true
            state.recoveryReason="Miner return ended outside immutable home bounds"
            state.phase="RECOVERY_LOCK"
            save()
            sendState(state.recoveryReason)
            return false
        end

        if not face(cfg.homeDir) then
            return false
        end

        checkpoint()
        return true
    end

    local function returnToMine()
        if state.recoveryLocked then
            return false
        end

        if not face(DIR_N) then
            return false
        end

        while state.z<state.resumeZ do
            if not digForward() then
                return false
            end
        end

        while state.y>state.resumeY do
            if not moveDownExisting() then
                return false
            end
        end

        if state.x~=state.resumeX or state.y~=state.resumeY or state.z~=state.resumeZ then
            state.recoveryLocked=true
            state.recoveryReason="Miner could not reconstruct saved work position"
            state.phase="RECOVERY_LOCK"
            save()
            sendState(state.recoveryReason)
            return false
        end

        if not face(state.resumeDir) then
            return false
        end

        state.phase="MINING"
        state.request=nil
        save()
        checkpoint()
        sendState("Resumed")
        return true
    end

    prepareForForemanService=function()
        if state.x~=cfg.homeX or state.y~=cfg.homeY or state.z~=cfg.homeZ then
            return false
        end
        return face(DIR_S)
    end

    local function nextDumpSlot()
        for slot=2,16 do
            if turtle.getItemCount(slot)>0 then
                return slot,turtle.getItemCount(slot)
            end
        end
        return nil,0
    end

    local function refuelSelf()
        turtle.select(1)
        while turtle.getItemCount(1) > 1 and turtle.getFuelLevel() ~= "unlimited" and turtle.getFuelLevel() < MINER_FUEL_TARGET do
            if not turtle.refuel(1) then
                break
            end
        end
    end

    local function service(kind,finalService,resumeExisting)
        if not resumeExisting then
            state.requestSeq=(state.requestSeq or 0)+1
            state.request={
                id=tostring(os.getComputerID()) .. ":" .. tostring(state.requestSeq),
                kind=kind,
                finalService=finalService and true or false
            }
            state.phase="RETURNING_SERVICE"
            save()
            requestPacket(false)
            sendState("Service requested")

            if not goHome(true) then
                return false
            end
        else
            if not state.request then
                state.recoveryLocked=true
                state.recoveryReason="Service phase exists without a persisted request"
                state.phase="RECOVERY_LOCK"
                save()
                return false
            end

            kind=state.request.kind or kind
            finalService=state.request.finalService and true or false

            if state.phase=="RETURNING_SERVICE" then
                if not goHome(false) then
                    return false
                end
            elseif state.phase~="WAITING_SERVICE" then
                state.recoveryLocked=true
                state.recoveryReason="Unexpected persisted service phase"
                state.phase="RECOVERY_LOCK"
                save()
                return false
            end
        end

        if not face(DIR_S) then
            return false
        end

        state.phase="WAITING_SERVICE"
        save()
        checkpoint()
        requestPacket(true)
        sendState("Waiting south-facing for Foreman-" .. tostring(cfg.foremanNumber))

        flags.serviceProbe=nil
        flags.dumpPrepare=nil
        flags.refuelNow=false
        flags.serviceComplete=false

        while not flags.serviceComplete do
            if flags.recallMode then
                return false
            end

            if flags.serviceProbe then
                local requestId=flags.serviceProbe
                flags.serviceProbe=nil

                if prepareForForemanService() then
                    send(cfg.foremanId,{
                        type="service_probe_ack",
                        requestId=requestId,
                        row=state.row,
                        x=state.x,
                        y=state.y,
                        z=state.z,
                        dir=state.dir
                    })
                else
                    send(cfg.foremanId,{
                        type="service_not_adjacent",
                        requestId=requestId,
                        row=state.row
                    })
                end
            end

            if flags.dumpPrepare then
                local requestId=flags.dumpPrepare
                flags.dumpPrepare=nil

                if not prepareForForemanService() then
                    send(cfg.foremanId,{
                        type="service_not_adjacent",
                        row=state.row,
                        requestId=requestId
                    })
                else
                    local slot,count=nextDumpSlot()
                    if slot then
                        turtle.select(slot)
                        send(cfg.foremanId,{
                            type="dump_slot_ready",
                            row=state.row,
                            requestId=requestId,
                            slot=slot,
                            count=count,
                            empty=false
                        })
                    else
                        turtle.select(1)
                        send(cfg.foremanId,{
                            type="dump_slot_ready",
                            row=state.row,
                            requestId=requestId,
                            empty=true
                        })
                    end
                end
            end

            if flags.refuelNow then
                flags.refuelNow=false
                refuelSelf()
                send(cfg.foremanId,{
                    type="refuel_complete",
                    row=state.row,
                    requestId=state.request.id,
                    fuel=turtle.getFuelLevel()
                })
            end
            sleep(0.1)
        end

        flags.serviceComplete=false
        local wasFinal=state.request.finalService and true or false
        local wasRecallDump=state.request.recallDump and true or false
        state.request=nil

        if wasRecallDump then
            state.phase="RECALLED_PAUSED"
            state.recallMode="DUMP"
            face(DIR_N)
            save()
            checkpoint()
            send(cfg.managerId,{
                type="recall_dump_empty",
                role="miner",
                row=state.row,
                id=os.getComputerID(),
                x=state.x,
                y=state.y,
                z=state.z,
                dir=state.dir,
                session=cfg.session
            })
            sendState("Dump recall complete; paused at home")
            return true
        end

        if wasFinal then
            state.phase="COMPLETE"
            face(DIR_N)
            save()
            checkpoint()
            sendState("Final dump complete")
            return true
        end

        state.phase="RETURNING_MINE"
        save()
        return returnToMine()
    end

    local function applyManagerRecoveryPose()
        local snapshot,seq=requestPoseBackup("miner",5,cfg.session)

        if not snapshot or snapshot.row~=cfg.row or
            type(snapshot.x)~="number" or type(snapshot.y)~="number" or
            type(snapshot.z)~="number" or type(snapshot.dir)~="number" then
            return true
        end

        local incoming=tonumber(seq or snapshot.seq or 0) or 0
        local localSeq=tonumber(state.seq) or 0
        local localValid=poseValid()
        local managerValid=
            snapshot.originEstablished==true and
            snapshot.x==cfg.homeX and snapshot.y<=cfg.homeY and
            snapshot.z>=cfg.shaftMinZ and snapshot.z<=cfg.shaftMaxZ and
            snapshot.dir>=DIR_N and snapshot.dir<=DIR_W

        if not managerValid then
            return localValid
        end

        if localValid and localSeq==incoming then
            if state.x~=snapshot.x or state.y~=snapshot.y or
                state.z~=snapshot.z or state.dir~=snapshot.dir then
                state.recoveryLocked=true
                state.recoveryReason="Local and Regional Manager poses disagree at the same sequence"
                state.phase="RECOVERY_LOCK"
                save()
                return false
            end
            return true
        end

        if localValid and localSeq>incoming then
            checkpoint()
            return true
        end

        if incoming>localSeq or not localValid then
            state.x=snapshot.x
            state.y=snapshot.y
            state.z=snapshot.z
            state.dir=snapshot.dir
            state.depth=-state.y
            state.pos=state.z
            state.seq=incoming
            state.motionIntent=nil
            state.turnIntent=nil
            state.recoveryLocked=false
            state.recoveryReason=nil
            save()
            return true
        end

        return localValid
    end

    local function recall(mode)
        mode=mode or flags.recallMode or "NORMAL"
        flags.recallMode=nil

        if not state.recallResume then
            state.recallResume={
                x=state.x,
                y=state.y,
                z=state.z,
                dir=state.dir,
                phase=state.phase,
                complete=state.complete and true or false
            }
            save()
        end

        if not applyManagerRecoveryPose() then
            return false
        end

        if state.recoveryLocked then
            state.phase="RECOVERY_LOCK"
            save()
            sendState("Recall refused: " .. tostring(state.recoveryReason or "position uncertain"))
            return false
        end

        state.phase="RECALLING"
        state.recallMode=mode
        save()
        sendState("Regional Manager recall: " .. tostring(mode))

        if not goHome(false) then
            state.phase="RECOVERY_LOCK"
            state.recoveryLocked=true
            state.recoveryReason=state.recoveryReason or "Recall could not prove home position"
            save()
            sendState(state.recoveryReason)
            return false
        end

        if not face(DIR_N) then
            return false
        end

        if state.x~=cfg.homeX or state.y~=cfg.homeY or
            state.z~=cfg.homeZ or state.dir~=cfg.homeDir then
            state.phase="RECOVERY_LOCK"
            state.recoveryLocked=true
            state.recoveryReason="Recall home verification failed"
            save()
            sendState(state.recoveryReason)
            return false
        end

        state.phase="RECALLED_PAUSED"
        save()
        checkpoint()

        send(cfg.managerId,{
            type="recall_home",
            role="miner",
            row=state.row,
            id=os.getComputerID(),
            mode=mode,
            labelCleared=false,
            x=state.x,
            y=state.y,
            z=state.z,
            dir=state.dir,
            session=cfg.session
        })

        if mode=="DUMP" then
            if not state.request then
                state.requestSeq=(state.requestSeq or 0)+1
                state.request={
                    id=tostring(os.getComputerID()) .. ":recall:" .. tostring(state.requestSeq),
                    kind="DUMP",
                    finalService=false,
                    recallDump=true
                }
                save()
            end
            requestPacket(true)
            state.phase="WAITING_SERVICE"
            save()
        elseif mode=="SHUTDOWN" then
            for i=1,5 do
                os.setComputerLabel(nil)
                if os.getComputerLabel()==nil then
                    break
                end
                sleep(0.1)
            end

            if os.getComputerLabel()~=nil then
                state.phase="RECOVERY_LOCK"
                state.recoveryLocked=true
                state.recoveryReason="Reached home but could not clear computer label"
                save()
                sendState(state.recoveryReason)
                return false
            end

            send(cfg.managerId,{
                type="recall_shutdown_ready",
                role="miner",
                row=state.row,
                id=os.getComputerID(),
                x=state.x,
                y=state.y,
                z=state.z,
                dir=state.dir,
                session=cfg.session
            })
            os.shutdown()
        end

        return true
    end

    local function resumeFromRecall()
        if not state.recallResume then
            state.phase="WAITING"
            flags.start=true
            save()
            return true
        end

        local resume=state.recallResume

        if resume.complete then
            state.complete=true
            state.phase="COMPLETE"
            state.recallResume=nil
            save()
            return true
        end

        if resume.phase=="WAITING_SERVICE" or resume.phase=="RETURNING_SERVICE" then
            state.phase="WAITING_SERVICE"
            state.recallResume=nil
            state.recallMode=nil
            face(DIR_S)
            save()
            checkpoint()
            if state.request then
                requestPacket(true)
            end
            return true
        end

        if resume.phase=="WAITING" then
            state.phase="WAITING"
            state.recallResume=nil
            state.recallMode=nil
            face(DIR_N)
            save()
            checkpoint()
            return true
        end

        state.resumeX=resume.x
        state.resumeY=resume.y
        state.resumeZ=resume.z
        state.resumeDir=resume.dir
        state.resumeDepth=-resume.y
        state.resumePos=resume.z
        state.phase="RETURNING_MINE"
        save()

        if not returnToMine() then
            return false
        end

        state.phase="MINING"
        state.recallResume=nil
        state.recallMode=nil
        save()
        checkpoint()
        return true
    end

    send(cfg.managerId,{
        type="node_online",
        role="miner",
        row=state.row,
        minerId=os.getComputerID(),
        foremanId=cfg.foremanId,
        session=cfg.session,
        x=state.x,
        y=state.y,
        z=state.z,
        dir=state.dir,
        phase=state.phase,
        seq=state.seq
    })
    send(cfg.foremanId,{
        type="miner_runtime_ready",
        row=state.row,
        minerId=os.getComputerID()
    })

    local function pauseForSetupRecall()
        if not flags.recallMode then
            return false
        end

        local mode=flags.recallMode
        flags.recallMode=nil
        recallForeman(mode)

        if mode=="SHUTDOWN" then
            return true
        end

        while state.phase=="RECALLED_PAUSED" do
            if flags.recallMode then
                local nextMode=flags.recallMode
                flags.recallMode=nil
                recallForeman(nextMode)
            elseif flags.resume then
                flags.resume=false
                state.recallMode=nil
                state.phase="WAITING_SETUP"
                saveState()
                sendState("Regional Manager resumed setup")
                break
            else
                sleep(0.2)
            end
        end

        return true
    end

    local function workLoop()
        if state.recoveryLocked then
            state.phase="RECOVERY_LOCK"
            save()
            checkpoint()
            while true do
                sendState("Movement locked: " .. tostring(state.recoveryReason or "pose uncertain"))
                sleep(5)
            end
        end

        checkpoint()

        if state.phase=="RECALLED_PAUSED" then
            while state.phase=="RECALLED_PAUSED" do
                if flags.resume then
                    flags.resume=false
                    resumeFromRecall()
                elseif flags.recallMode=="SHUTDOWN" then
                    recall("SHUTDOWN")
                end
                sleep(0.1)
            end
        end

        if state.complete then
            state.phase = "COMPLETE"
            save()
        end

        while state.phase == "WAITING" and not flags.start do
            if flags.recallMode then
                recall(flags.recallMode)
            elseif flags.resume then
                flags.resume=false
                resumeFromRecall()
            end
            sleep(0.1)
        end

        if state.phase == "COMPLETE" then
            while true do
                if flags.recallMode then
                    recall(flags.recallMode)
                elseif flags.resume then
                    flags.resume=false
                    resumeFromRecall()
                end
                sleep(0.2)
            end
        end

        if state.phase == "WAITING_SERVICE" or state.phase == "RETURNING_SERVICE" then
            local kind=state.request and state.request.kind or "DUMP"
            service(kind,state.request and state.request.finalService,true)
        elseif state.phase == "RETURNING_MINE" then
            returnToMine()
        elseif state.phase == "MINING" then
        else
            state.phase="WAITING"
            save()

            while not flags.start do
                if flags.recallMode then
                    recall()
                end
                sleep(0.1)
            end

            state.phase="MINING"
            save()
        end

        while true do
            if flags.recallMode then
                recall(flags.recallMode)
            end

            local kind = neededService()
            if kind then
                if not service(kind) then
                    recall()
                end
            end

            if state.dir == DIR_N then
                while state.pos < 15 do
                    if flags.recallMode then
                        recall()
                    end
                    local s = neededService()
                    if s then
                        service(s)
                    end
                    if not digForward() then
                        recall()
                    end
                end
                if not descendMine() then
                    sendState("Bedrock reached")
                    if not service("DUMP", true) then
                        recall()
                    end
                    state.complete = true
                    state.phase = "COMPLETE"
                    save()
                    send(cfg.managerId,{
                        type="miner_complete",
                        row=state.row,
                        minerId=os.getComputerID(),
                        foremanId=cfg.foremanId,
                        foremanNumber=cfg.foremanNumber,
                        session=cfg.session
                    })
                    while true do
                        if flags.recallMode then
                            recall()
                        end
                        sleep(0.2)
                    end
                end
                face(DIR_S)
            else
                while state.pos > 0 do
                    if flags.recallMode then
                        recall()
                    end
                    local s = neededService()
                    if s then
                        service(s)
                    end
                    if not digForward() then
                        recall()
                    end
                end
                if not descendMine() then
                    sendState("Bedrock reached")
                    if not service("DUMP", true) then
                        recall()
                    end
                    state.complete = true
                    state.phase = "COMPLETE"
                    save()
                    send(cfg.managerId,{
                        type="miner_complete",
                        row=state.row,
                        minerId=os.getComputerID(),
                        foremanId=cfg.foremanId,
                        foremanNumber=cfg.foremanNumber,
                        session=cfg.session
                    })
                    while true do
                        if flags.recallMode then
                            recall()
                        end
                        sleep(0.2)
                    end
                end
                face(DIR_N)
            end
        end
    end

    parallel.waitForAny(networkLoop, workLoop)
end

local function runForeman(cfg)
    setRegionalManager(cfg.managerId)
    if not openNetwork() then
        error("Wireless modem not found")
    end
    ensureManagerRegistration(cfg)

    if not getSelfInventory() then
        error("Narcissistic inventory peripheral not found")
    end

    local number = cfg.number
    local id = os.getComputerID()
    local statePath = "foreman" .. tostring(number) .. ".tmp"
    local queuePath = "foreman" .. tostring(number) .. "_queue.tmp"
    local state=loadTable(statePath)

    if not state then
        local monitorState=requestPoseBackup("foreman",5,cfg.session)
        state=monitorState or {
            number=number,
            x=cfg.homeX,
            z=cfg.homeZ,
            y=0,
            dir=DIR_N,
            phase="RECOVERY_LOCK",
            setupDone=false,
            seq=0
        }
        state.recoveryLocked=true
        state.recoveryReason=monitorState and
            "Local foreman state missing; monitor backup retained for manual recovery" or
            "Local foreman state missing and monitor has no backup"
        state.phase="RECOVERY_LOCK"
        saveTable(statePath,state)
    end

    state.session=cfg.session
    state.y=tonumber(state.y) or 0
    state.seq=tonumber(state.seq) or 0
    state.dir=tonumber(state.dir) or DIR_N

    local function foremanPoseValid()
        if number==4 and state.navigatorSetupActive then
            return state.x>=-3 and state.x<=17 and state.z>=-6 and state.z<=15 and
                state.y>=0 and state.y<=15 and state.dir>=DIR_N and state.dir<=DIR_W
        end

        return state.x>=-3 and state.x<=17 and state.z>=-6 and state.z<=2 and
            state.y>=0 and state.y<=1 and state.dir>=DIR_N and state.dir<=DIR_W
    end

    do
        local managerState,managerSeq=requestPoseBackup("foreman",5,cfg.session)
        local managerPoseValid=managerState and
            type(managerState.x)=="number" and type(managerState.y)=="number" and
            type(managerState.z)=="number" and type(managerState.dir)=="number"

        if not foremanPoseValid() and managerPoseValid then
            state=managerState
            state.motionIntent=nil
            state.verticalIntent=nil
            state.turnIntent=nil
            state.session=cfg.session
            state.seq=tonumber(managerSeq or managerState.seq or state.seq) or 0
            saveTable(statePath,state)
        elseif foremanPoseValid() and not state.motionIntent and
            not state.verticalIntent and not state.turnIntent then
            checkpointPose("foreman",state.seq,state,cfg.session)
        end
    end

    if state.motionIntent or state.verticalIntent or state.turnIntent then
        local monitorState,monitorSeq=requestPoseBackup("foreman",5,cfg.session)
        local intent=state.motionIntent or state.verticalIntent or state.turnIntent
        local intentSeq=tonumber(intent.seq) or (state.seq+1)

        if monitorState and tonumber(monitorSeq or monitorState.seq or 0)>=intentSeq then
            state=monitorState
            state.motionIntent=nil
            state.verticalIntent=nil
            state.turnIntent=nil
            saveTable(statePath,state)
        elseif state.turnIntent then
            state.recoveryLocked=true
            state.recoveryReason="Facing ambiguous after interrupted turn"
            state.phase="RECOVERY_LOCK"
            saveTable(statePath,state)
        else
            local moveIntent=state.motionIntent or state.verticalIntent
            local fuelNow=turtle.getFuelLevel()
            local fuelBefore=moveIntent.fuelBefore
            local moved=nil

            if type(fuelNow)=="number" and type(fuelBefore)=="number" then
                moved=fuelNow<fuelBefore
            elseif type(fuelBefore)=="number" and fuelBefore<=0 then
                moved=false
            end

            if moved==nil then
                state.recoveryLocked=true
                state.recoveryReason="Position ambiguous after interrupted foreman movement"
                state.phase="RECOVERY_LOCK"
            elseif state.motionIntent then
                local pose=moved and state.motionIntent.to or state.motionIntent.from
                state.x=pose.x
                state.z=pose.z
                state.y=pose.y
                state.dir=pose.dir
                if moved then state.seq=intentSeq end
                state.motionIntent=nil
            else
                state.y=moved and state.verticalIntent.to or state.verticalIntent.from
                if moved then state.seq=intentSeq end
                state.verticalIntent=nil
            end
            saveTable(statePath,state)
        end
    end

    if not foremanPoseValid() then
        state.recoveryLocked=true
        state.recoveryReason="Saved foreman pose is outside the operating area"
        state.phase="RECOVERY_LOCK"
        saveTable(statePath,state)
    end

    local qdata = loadTable(queuePath) or {queue={},active=nil,resolved={}}
    local queue = qdata.queue or {}
    local active = qdata.active
    local resolved = qdata.resolved or {}
    local peers = {}
    local intents = {}
    local inbox = {}
    local commissionWave = {}
    local flags = {
        commissionStart=false,
        navigatorSetupStart=false,
        startMining=false,
        dockGranted=false,
        recallMode=nil,
        resume=false
    }
    local dock = nil
    if number == 1 then
        dock = loadTable("dock.tmp") or {holder=nil,queue={}}
    end
    local lastStatus = 0
    local lastPeer = 0

    local function saveState()
        saveTable(statePath,state)
    end

    local function foremanSnapshot()
        local raw=textutils.serialize(state)
        local snapshot=textutils.unserialize(raw)
        snapshot.motionIntent=nil
        snapshot.verticalIntent=nil
        snapshot.turnIntent=nil
        return snapshot
    end

    local function checkpointForeman()
        checkpointPose("foreman",state.seq,foremanSnapshot(),cfg.session)
    end

    local function turnQuarter(right)
        local from=state.dir
        local to=right and ((from+1)%4) or ((from+3)%4)
        local intent={seq=state.seq+1,from=from,to=to}
        state.turnIntent=intent
        saveState()

        local ok
        if right then
            ok=turtle.turnRight()
        else
            ok=turtle.turnLeft()
        end

        if not ok then
            state.turnIntent=nil
            saveState()
            return false
        end

        state.dir=to
        state.seq=intent.seq
        checkpointForeman()
        state.turnIntent=nil
        saveState()
        return true
    end

    local function faceTracked(target)
        if state.recoveryLocked then
            return false
        end

        while state.dir~=target do
            local diff=(target-state.dir)%4
            if diff==3 then
                if not turnQuarter(false) then return false end
            else
                if not turnQuarter(true) then return false end
            end
        end

        return true
    end

    local function saveQueue()
        saveTable(queuePath,{queue=queue,active=active,resolved=resolved})
    end

    local function saveDock()
        if number == 1 and dock then
            saveTable("dock.tmp",dock)
        end
    end

    local function sendState(message)
        status("foreman",state.phase,{
            number=number,
            rowStart=cfg.rowStart,
            rowEnd=cfg.rowEnd,
            x=state.x,
            z=state.z,
            y=state.y,
            dir=state.dir,
            seq=state.seq,
            queue=#queue + (active and 1 or 0),
            setupDone=state.setupDone and true or false,
            miningStarted=state.miningStarted and true or false,
            recovery=state.recoveryReason,
            message=message or ""
        })
        lastStatus = now()
    end

    local function pushInbox(sender,message)
        inbox[#inbox+1] = {sender=sender,message=message}
        if #inbox > 100 then
            table.remove(inbox,1)
        end
    end

    local function popInbox(predicate)
        for i=1,#inbox do
            local entry = inbox[i]
            if predicate(entry.sender,entry.message) then
                table.remove(inbox,i)
                return entry.sender,entry.message
            end
        end
        return nil,nil
    end

    local function waitInbox(predicate, timeout)
        local deadline = now() + timeout
        while now() < deadline do
            local sender,message = popInbox(predicate)
            if sender then
                return sender,message
            end
            sleep(0.1)
        end
        return nil,nil
    end

    local function assignedRow(row)
        return row >= cfg.rowStart and row <= cfg.rowEnd
    end

    local function upsertRequest(message)
        if not assignedRow(message.row or -1) then
            return
        end
        local requestId = message.requestId
        if resolved[requestId] then
            if message.minerId then
                send(message.minerId,{
                    type="service_complete",
                    requestId=requestId
                })
            end
            return
        end
        if active and active.requestId == requestId then
            active.arrived = active.arrived or message.type == "service_arrived"
            active.lastSeen = now()
            saveQueue()
            return
        end
        for i=1,#queue do
            if queue[i].requestId == requestId then
                queue[i].arrived = queue[i].arrived or message.type == "service_arrived"
                queue[i].lastSeen = now()
                saveQueue()
                return
            end
        end
        queue[#queue+1] = {
            requestId=requestId,
            row=message.row,
            service=message.service,
            minerId=message.minerId,
            arrived=message.type == "service_arrived",
            lastSeen=now()
        }
        saveQueue()
        if not message.managerAssigned then
            send(message.minerId,{
                type="service_ack",
                requestId=requestId,
                row=message.row
            })
        end
        sendState("Queued Miner-" .. tostring(message.row))
    end

    local function dockContains(fid)
        if dock.holder == fid then
            return true
        end
        for i=1,#dock.queue do
            if dock.queue[i] == fid then
                return true
            end
        end
        return false
    end

    local function grantDock()
        if number ~= 1 then
            return
        end
        if not dock.holder and #dock.queue > 0 then
            dock.holder = table.remove(dock.queue,1)
            saveDock()
            if dock.holder == id then
                flags.dockGranted = true
            else
                send(dock.holder,{type="dock_grant"})
            end
        end
    end

    local function requestDock()
        flags.dockGranted = false
        if number == 1 then
            if dock.holder == id then
                flags.dockGranted = true
            else
                if not dockContains(id) then
                    dock.queue[#dock.queue+1] = id
                    saveDock()
                end
                grantDock()
            end
        else
            broadcast({
                type="dock_request",
                foremanId=id,
                number=number
            })
        end
        local lastRequest = now()
        while not flags.dockGranted do
            if number ~= 1 and now() - lastRequest >= 2 then
                broadcast({
                    type="dock_request",
                    foremanId=id,
                    number=number
                })
                lastRequest = now()
            end
            sleep(0.05)
        end
    end

    local function releaseDock()
        flags.dockGranted = false
        if number == 1 then
            if dock.holder == id then
                dock.holder = nil
                saveDock()
                grantDock()
            end
        else
            send(cfg.controller,{type="dock_release",foremanId=id})
        end
    end

    local function occupied(tx,tz)
        for pid,p in pairs(peers) do
            if pid ~= id and p.x == tx and p.z == tz and now() - (p.lastSeen or 0) < 8 then
                return true
            end
        end
        return false
    end

    local function lowerIntentWins(tx,tz)
        for pid,p in pairs(intents) do
            if pid ~= id and p.x == tx and p.z == tz and now() - (p.lastSeen or 0) < 1 then
                if (p.number or 99) < number then
                    return true
                end
            end
        end
        return false
    end

    local function moveVertical(targetY)
        if flags.recallMode then
            return false
        end

        if state.recoveryLocked then
            return false
        end

        if targetY~=0 and targetY~=1 then
            state.phase="VERTICAL_ERROR"
            saveState()
            sendState("Invalid relative Y target " .. tostring(targetY))
            return false
        end

        while state.y<targetY do
            state.phase="MOVING_UP"
            local intent={
                seq=state.seq+1,
                from=state.y,
                to=state.y+1,
                fuelBefore=turtle.getFuelLevel()
            }
            state.verticalIntent=intent
            saveState()

            if not turtle.up() then
                state.verticalIntent=nil
                state.phase="VERTICAL_ERROR"
                saveState()
                sendState("Unable to move up to relative Y " .. tostring(targetY))
                return false
            end

            state.y=intent.to
            state.seq=intent.seq
            checkpointForeman()
            state.verticalIntent=nil
            saveState()
        end

        while state.y>targetY do
            state.phase="MOVING_DOWN"
            local intent={
                seq=state.seq+1,
                from=state.y,
                to=state.y-1,
                fuelBefore=turtle.getFuelLevel()
            }
            state.verticalIntent=intent
            saveState()

            if not turtle.down() then
                state.verticalIntent=nil
                state.phase="VERTICAL_ERROR"
                saveState()
                sendState("Unable to move down to relative Y " .. tostring(targetY))
                return false
            end

            state.y=intent.to
            state.seq=intent.seq
            checkpointForeman()
            state.verticalIntent=nil
            saveState()
        end

        return state.y==targetY
    end

    local function ensureGroundLevel()
        if state.y~=0 then
            sendState("Correcting foreman to staging height")
        end
        return moveVertical(0)
    end

    local function ensureInstallerLevel()
        if state.y~=1 then
            sendState("Correcting foreman to installer height")
        end
        return moveVertical(1)
    end

    local function verifyGroundFrontNoDrive()
        if state.y~=0 then
            return false
        end
        return peripheral.getType("front")~="drive"
    end

    local function moveStep(targetDir)
        if flags.recallMode then
            return false
        end

        if not ensureGroundLevel() then
            state.phase="VERTICAL_ERROR"
            saveState()
            sendState("Horizontal movement blocked because foreman is not at staging height")
            return false
        end

        if not faceTracked(targetDir) then
            return false
        end
        local tx = state.x
        local tz = state.z
        if targetDir == DIR_N then
            tz = tz + 1
        elseif targetDir == DIR_E then
            tx = tx + 1
        elseif targetDir == DIR_S then
            tz = tz - 1
        else
            tx = tx - 1
        end

        if tx<-3 or tx>17 or tz<-6 or tz>2 then
            state.recoveryLocked=true
            state.recoveryReason="Foreman movement would leave operating area"
            state.phase="RECOVERY_LOCK"
            saveState()
            sendState(state.recoveryReason)
            return false
        end

        local attempts = 0
        while attempts < MOVE_RETRY_LIMIT do
            attempts = attempts + 1
            if not occupied(tx,tz) then
                broadcast({
                    type="move_intent",
                    foremanId=id,
                    number=number,
                    x=tx,
                    z=tz
                })
                intents[id] = {number=number,x=tx,z=tz,lastSeen=now()}
                sleep(MOVE_RESERVE_TIME)
                if not occupied(tx,tz) and not lowerIntentWins(tx,tz) then
                    local intent={
                        seq=state.seq+1,
                        fuelBefore=turtle.getFuelLevel(),
                        from={x=state.x,z=state.z,y=state.y,dir=state.dir},
                        to={x=tx,z=tz,y=state.y,dir=state.dir}
                    }
                    state.motionIntent=intent
                    saveState()

                    if turtle.forward() then
                        state.x=tx
                        state.z=tz
                        state.seq=intent.seq
                        intents[id]=nil
                        checkpointForeman()
                        state.motionIntent=nil
                        saveState()
                        broadcast({
                            type="foreman_position",
                            foremanId=id,
                            number=number,
                            x=state.x,
                            z=state.z,
                            y=state.y,
                            phase=state.phase
                        })
                        return true
                    else
                        state.motionIntent=nil
                        saveState()
                    end
                end
            end
            sleep(0.2)
        end

        state.phase = "BLOCKED"
        saveState()
        sendState("Movement blocked at " .. tostring(tx) .. "," .. tostring(tz))
        return false
    end

    local function goTo(tx,tz)
        if state.recoveryLocked then
            return false
        end
        if not ensureGroundLevel() then
            return false
        end

        while state.x < tx do
            if not moveStep(DIR_E) then return false end
        end
        while state.x > tx do
            if not moveStep(DIR_W) then return false end
        end
        while state.z < tz do
            if not moveStep(DIR_N) then return false end
        end
        while state.z > tz do
            if not moveStep(DIR_S) then return false end
        end
        return true
    end

    local function useOwnFuel()
        if turtle.getFuelLevel() == "unlimited" then
            return true
        end

        local fuel = turtle.getFuelLevel()
        if fuel > FOREMAN_FUEL_LOW then
            return true
        end

        local piecesNeeded = math.ceil((FOREMAN_FUEL_TARGET - fuel) / COAL_FUEL_VALUE)

        if selfCount("coal") < piecesNeeded then
            return false
        end

        local remaining = piecesNeeded

        while remaining > 0 do
            local slot = selfFindSlot("coal")
            if not slot then
                return false
            end

            turtle.select(slot)
            local available = turtle.getItemCount(slot)
            local consume = math.min(remaining, available)

            if consume <= 0 then
                return false
            end

            if not turtle.refuel(consume) then
                return false
            end

            remaining = remaining - consume
        end

        return turtle.getFuelLevel() >= FOREMAN_FUEL_TARGET
    end

    local function refuelAtFrontTo(target)
        if turtle.getFuelLevel() == "unlimited" then
            return true
        end

        local fuel = turtle.getFuelLevel()
        if fuel >= target then
            return true
        end

        local piecesNeeded = math.ceil((target - fuel) / COAL_FUEL_VALUE)
        local onboard = selfCount("coal")
        local toPull = piecesNeeded - onboard

        if toPull > 0 then
            if takeNamedIntoSelf("coal",toPull) < toPull then
                return false
            end
        end

        local remaining = piecesNeeded

        while remaining > 0 do
            local slot = selfFindSlot("coal")
            if not slot then
                return false
            end

            turtle.select(slot)
            local available = turtle.getItemCount(slot)
            local consume = math.min(remaining, available)

            if consume <= 0 then
                return false
            end

            if not turtle.refuel(consume) then
                return false
            end

            remaining = remaining - consume
        end

        return turtle.getFuelLevel() >= target
    end

    local function goDockBypass(targetX)
        if state.x ~= -1 then
            if not goTo(-1,state.z) then
                return false
            end
        end
        if state.z ~= 0 then
            if not goTo(-1,0) then
                return false
            end
        end
        if state.x ~= targetX then
            if not goTo(targetX,0) then
                return false
            end
        end
        return true
    end

    local function verifyDockInventory(kind)
        local inv=wrapInventory("front")

        if inv then
            return true
        end

        state.phase="NAVIGATION_ERROR"
        saveState()
        sendState("Expected " .. tostring(kind) .. " chest directly north at dock coordinate")
        return false
    end

    local function goPrivateHome()
        if state.x <= 0 then
            if state.x ~= -1 then
                if not goTo(-1,state.z) then
                    return false
                end
            end
            if not goTo(-1,cfg.homeZ) then
                return false
            end
            if not goTo(cfg.homeX,cfg.homeZ) then
                return false
            end
        else
            if not goTo(state.x,cfg.homeZ) then
                return false
            end
            if not goTo(cfg.homeX,cfg.homeZ) then
                return false
            end
        end
        return true
    end

    local function returnHome()
        if not goPrivateHome() then
            return false
        end

        if state.x~=cfg.homeX or state.z~=cfg.homeZ or state.y~=0 then
            state.phase="NAVIGATION_ERROR"
            saveState()
            sendState("Foreman home coordinate mismatch")
            return false
        end

        faceTracked(DIR_N)

        if state.dir~=DIR_N then
            state.phase="NAVIGATION_ERROR"
            saveState()
            sendState("Foreman could not establish north at home")
            return false
        end

        state.phase = "IDLE"
        saveState()
        checkpointForeman()
        sendState("Waiting")
        return true
    end

    local function prepareDockTrip()
        if state.x ~= cfg.homeX or state.z ~= cfg.homeZ then
            if not goPrivateHome() then
                state.phase="BLOCKED"
                saveState()
                sendState("Cannot return to private lane before dock trip")
                return false
            end
        end
        return true
    end

    local function atSupply()
        if not prepareDockTrip() then
            return false
        end

        requestDock()

        if not goDockBypass(0) then
            state.phase="DOCK_BLOCKED"
            saveState()
            sendState("Supply dock path blocked; token retained")
            return false
        end

        faceTracked(DIR_N)
        saveState()

        if state.x~=0 or state.z~=0 or state.y~=0 then
            state.phase="NAVIGATION_ERROR"
            saveState()
            sendState("Supply dock coordinate mismatch")
            return false
        end

        if not verifyDockInventory("supply") then
            return false
        end

        return true
    end

    local function atFuel()
        if not prepareDockTrip() then
            return false
        end

        requestDock()

        if not goDockBypass(-2) then
            state.phase="DOCK_BLOCKED"
            saveState()
            sendState("Fuel dock path blocked; token retained")
            return false
        end

        faceTracked(DIR_N)
        saveState()

        if state.x~=-2 or state.z~=0 or state.y~=0 then
            state.phase="NAVIGATION_ERROR"
            saveState()
            sendState("Fuel dock coordinate mismatch")
            return false
        end

        if not verifyDockInventory("fuel") then
            return false
        end

        return true
    end

    local function exitDockToLane()
        if state.x ~= -1 then
            if not goTo(-1,state.z) then
                return false
            end
        end

        if state.z ~= cfg.homeZ then
            if not goTo(-1,cfg.homeZ) then
                return false
            end
        end

        if not goTo(cfg.homeX,cfg.homeZ) then
            return false
        end

        releaseDock()
        return true
    end

    local function exitDockHome()
        if not exitDockToLane() then
            return false
        end
        faceTracked(DIR_N)
        state.phase="IDLE"
        saveState()
        sendState("Waiting")
        return true
    end

    local function loadOwnFuel()
        if turtle.getFuelLevel() == "unlimited" then
            return true
        end

        if turtle.getFuelLevel() > FOREMAN_FUEL_LOW then
            return true
        end

        if useOwnFuel() then
            return true
        end

        if not atFuel() then
            return false
        end

        local ok = refuelAtFrontTo(FOREMAN_FUEL_TARGET)

        if not ok then
            state.phase="WAITING_FUEL"
            saveState()
            sendState("Unable to reach foreman fuel target")
            return false
        end

        return exitDockHome()
    end

    local function dumpCargo()
        if not atSupply() then
            return false
        end

        for slot=1,16 do
            local item=selfItem(slot)
            local reserved=number==1 and state.bootstrapDrivePending and state.bootstrapDriveSlot==slot

            if item and not reserved and not isForemanCoreItem(item) then
                turtle.select(slot)
                while turtle.getItemCount(slot)>0 do
                    if not turtle.drop() then
                        state.phase="DOCK_BLOCKED"
                        saveState()
                        sendState("Supply chest full; dock token retained")
                        return false
                    end
                end
            end
        end

        if number==1 and state.bootstrapDrivePending and state.bootstrapDriveSlot then
            local slot=state.bootstrapDriveSlot
            local item=selfItem(slot)

            if item and matchesItem(item,"disk_drive") then
                turtle.select(slot)
                if not turtle.drop(1) then
                    state.phase="DOCK_BLOCKED"
                    saveState()
                    sendState("Cannot return bootstrap Disk Drive")
                    return false
                end
            end

            state.bootstrapDrivePending=false
            state.bootstrapDriveSlot=nil
            saveState()
        end

        return exitDockHome()
    end




    local function prepareRuntimeService(service)
        state.phase="PREPARING_SERVICE"
        saveState()

        if service=="REFUEL" or service=="BOTH" then
            if selfCount("coal")<MINER_REFUEL_COAL then
                if not atFuel() then
                    return false
                end

                local needed=MINER_REFUEL_COAL-selfCount("coal")
                local got=takeNamedIntoSelf("coal",needed)

                if got<needed then
                    state.phase="WAITING_FUEL"
                    saveState()
                    sendState("Fuel chest cannot provide miner refuel packet")
                    return false
                end

                if not exitDockToLane() then
                    return false
                end
            end
        end

        return true
    end

    local function dropMinerFuel(amount)
        amount=amount or MINER_REFUEL_COAL
        local remaining=amount
        local movedTotal=0

        for slot=1,16 do
            local item=selfItem(slot)

            if item and matchesItem(item,"coal") and remaining>0 then
                turtle.select(slot)

                local before=turtle.getItemCount(slot)
                local requested=math.min(remaining,before)

                if requested>0 and turtle.drop(requested) then
                    sleep(0.05)

                    local after=turtle.getItemCount(slot)
                    local moved=before-after

                    if moved>0 then
                        movedTotal=movedTotal+moved
                        remaining=remaining-moved
                    end
                end
            end
        end

        return movedTotal>0,movedTotal
    end

    local function countRuntimeFreeSlots()
        local free=0

        for slot=1,16 do
            if turtle.getItemCount(slot)==0 then
                free=free+1
            end
        end

        return free
    end

    local function networkLoop()
        local timer = os.startTimer(1)
        while true do
            local event = {os.pullEvent()}
            if event[1] == "rednet_message" then
                local sender = event[2]
                local message = event[3]
                local protocol = event[4]
                if protocol == PROTOCOL and type(message) == "table" then
                    if sender==cfg.managerId and message.type=="manager_job" and
                        message.foremanNumber==number then
                        upsertRequest({
                            type="service_arrived",
                            requestId=message.requestId,
                            row=message.row,
                            service=message.service,
                            minerId=message.minerId,
                            arrived=true,
                            lastSeen=now(),
                            managerAssigned=true
                        })
                        send(cfg.managerId,{
                            type="job_accepted",
                            requestId=message.requestId,
                            foremanId=id,
                            foremanNumber=number,
                            session=cfg.session
                        })
                    elseif message.type == "foreman_position" then
                        peers[message.foremanId] = {
                            number=message.number,
                            x=message.x,
                            z=message.z,
                            phase=message.phase,
                            lastSeen=now()
                        }
                    elseif message.type == "move_intent" then
                        intents[message.foremanId] = {
                            number=message.number,
                            x=message.x,
                            z=message.z,
                            lastSeen=now()
                        }
                    elseif message.type == "dock_request" and number == 1 then
                        if dock.holder == message.foremanId then
                            send(message.foremanId,{type="dock_grant"})
                        else
                            if not dockContains(message.foremanId) then
                                dock.queue[#dock.queue+1] = message.foremanId
                                saveDock()
                            end
                            grantDock()
                        end
                    elseif message.type == "dock_release" and number == 1 then
                        if dock.holder == message.foremanId then
                            dock.holder = nil
                            saveDock()
                            grantDock()
                        end
                    elseif message.type == "dock_grant" then
                        flags.dockGranted = true
                    elseif message.type == "navigator_setup_start" and number==4 and sender==cfg.controller then
                        if state.navigatorSetupDone then
                            send(cfg.controller,{
                                type="navigator_setup_done",
                                number=4,
                                id=id
                            })
                        else
                            flags.navigatorSetupStart=true
                        end
                    elseif message.type == "commission_start" and message.number == number and sender == cfg.controller then
                        if state.setupDone then
                            send(cfg.controller,{
                                type="commission_done",
                                number=number,
                                id=id
                            })
                        else
                            flags.commissionStart = true
                        end
                    elseif message.type == "start_assigned" and sender == cfg.controller then
                        flags.startMining = true
                    elseif message.type == "miner_runtime_ready" and message.row and assignedRow(message.row) then
                        state.minerIds=state.minerIds or {}
                        if not state.minerIds[message.row] or state.minerIds[message.row]==sender then
                            state.minerIds[message.row]=sender
                            saveState()
                            if state.miningStarted then
                                send(sender,{type="start_mining"})
                            end
                        end
                    elseif message.type == "commission_done" and cfg.master and message.number then
                        state.groupsCommissioned = state.groupsCommissioned or {}
                        state.groupsCommissioned[message.number] = true
                        commissionWave[message.number] = nil
                        saveState()
                        pushInbox(sender,message)
                    elseif sender==cfg.managerId and message.type == "start_mining" then
                        flags.startMining = true
                    elseif sender==cfg.managerId and message.type == "recall_command" then
                        flags.recallMode = message.mode or "NORMAL"
                    elseif sender==cfg.managerId and message.type == "resume_swarm" then
                        flags.resume=true
                    elseif sender==cfg.managerId and message.type == "status_query" then
                        sendState("")
                    else
                        pushInbox(sender,message)
                    end
                end
            elseif event[1] == "timer" and event[2] == timer then
                if now() - lastStatus >= STATUS_INTERVAL then
                    sendState("")
                end
                if cfg.master then
                    for n=2,4 do
                        if commissionWave[n] and cfg.foremen and cfg.foremen[n] then
                            if not commissionWave[n].lastSend or now() - commissionWave[n].lastSend >= 2 then
                                send(cfg.foremen[n],{type="commission_start",number=n})
                                commissionWave[n].lastSend = now()
                            end
                        end
                    end
                end
                if number == 1 and dock and dock.holder and dock.holder ~= id then
                    local holder = peers[dock.holder]
                    if not holder or now() - (holder.lastSeen or 0) > 15 then
                        dock.holder = nil
                        saveDock()
                        grantDock()
                    end
                end
                for requestId,stamp in pairs(resolved) do
                    if now() - stamp > 300 then
                        resolved[requestId] = nil
                    end
                end
                if now() - lastPeer >= PEER_INTERVAL then
                    broadcast({
                        type="foreman_position",
                        foremanId=id,
                        number=number,
                        x=state.x,
                        z=state.z,
                        y=state.y,
                        phase=state.phase
                    })
                    lastPeer = now()
                end
                timer = os.startTimer(1)
            end
        end
    end

    local function frontComputerId()
        local ok,id = pcall(peripheral.call,"front","getID")
        if ok then
            return tonumber(id)
        end
        return nil
    end

    local function verifyServiceMiner(req)
        if state.x~=req.row or state.z~=0 or state.y~=0 then
            state.phase="SERVICE_ALIGNMENT_ERROR"
            saveState()
            sendState("Foreman is not at Miner-" .. tostring(req.row) .. " service coordinate")
            return false
        end

        if not faceTracked(DIR_N) then
            return false
        end

        for attempt=1,3 do
            send(req.minerId,{
                type="service_probe",
                requestId=req.requestId,
                row=req.row
            })

            local _,reply=waitInbox(function(sender,m)
                return sender==req.minerId and type(m)=="table" and
                    m.type=="service_probe_ack" and m.requestId==req.requestId
            end,1)

            if reply and tonumber(reply.row)==tonumber(req.row) and
                tonumber(reply.x)==tonumber(req.row) and tonumber(reply.y)==0 and
                tonumber(reply.z)==0 and tonumber(reply.dir)==DIR_S then
                return true
            end
        end

        state.phase="SERVICE_ALIGNMENT_ERROR"
        saveState()
        sendState("Miner-" .. tostring(req.row) .. " did not confirm service position")
        return false
    end


    local function placeDriveAndDiskAt(tx,tz)
        local stagingZ=tz-1

        if state.x~=tx or state.z~=stagingZ then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Wrong staging square before installer placement")
            return false
        end

        if not ensureGroundLevel() then
            return false
        end

        faceTracked(DIR_N)
        saveState()

        if peripheral.getType("front")=="drive" then
            local reserved=state.bootstrapDrivePending and state.bootstrapDriveSlot or nil
            local slot=selfTargetSlotExcluding("disk_drive",reserved)

            if not slot then
                state.phase="PLACEMENT_ERROR"
                saveState()
                sendState("No room to recover misplaced ground Disk Drive")
                return false
            end

            turtle.select(slot)
            if not turtle.dig() then
                state.phase="PLACEMENT_ERROR"
                saveState()
                sendState("Cannot recover misplaced ground Disk Drive")
                return false
            end
            sleep(0.2)
        end

        if frontComputerId() then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Miner square already occupied")
            return false
        end

        if not ensureInstallerLevel() then
            return false
        end

        faceTracked(DIR_N)
        state.phase="PLACING_INSTALLER"
        saveState()

        if peripheral.getType("front")~="drive" then
            if turtle.detect() then
                state.phase="PLACEMENT_ERROR"
                saveState()
                sendState("Installer square blocked at relative Y 1")
                ensureGroundLevel()
                return false
            end

            local reserved=state.bootstrapDrivePending and state.bootstrapDriveSlot or nil
            local driveSlot=selfFindSlotExcluding("disk_drive",reserved)

            if not driveSlot then
                state.phase="WAITING_INSTALLER"
                saveState()
                sendState("Operational Disk Drive not found")
                ensureGroundLevel()
                return false
            end

            turtle.select(driveSlot)
            if not turtle.place() then
                state.phase="PLACEMENT_ERROR"
                saveState()
                sendState("Cannot place Disk Drive directly in front at relative Y 1")
                ensureGroundLevel()
                return false
            end
            sleep(0.2)
        end

        if state.y~=1 or peripheral.getType("front")~="drive" then
            state.phase="VERTICAL_ERROR"
            saveState()
            sendState("Disk Drive is not directly in front at installer height")
            ensureGroundLevel()
            return false
        end

        if not disk.isPresent("front") then
            if not selfSelectKind("floppy") then
                state.phase="WAITING_INSTALLER"
                saveState()
                sendState("Miner floppy not found")
                ensureGroundLevel()
                return false
            end

            if not turtle.drop(1) then
                state.phase="WAITING_INSTALLER"
                saveState()
                sendState("Cannot insert floppy into Disk Drive directly in front")
                ensureGroundLevel()
                return false
            end
            sleep(0.3)
        end

        if not disk.isPresent("front") then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Floppy verification failed at installer height")
            ensureGroundLevel()
            return false
        end

        if not ensureGroundLevel() then
            return false
        end

        faceTracked(DIR_N)
        saveState()

        if not verifyGroundFrontNoDrive() then
            state.phase="VERTICAL_ERROR"
            saveState()
            sendState("Disk Drive is at ground level; correcting placement")

            local reserved=state.bootstrapDrivePending and state.bootstrapDriveSlot or nil
            local slot=selfTargetSlotExcluding("disk_drive",reserved)
            if not slot then
                return false
            end

            turtle.select(slot)
            if not turtle.dig() then
                sendState("Cannot recover ground-level Disk Drive for correction")
                return false
            end

            if not ensureInstallerLevel() then
                return false
            end

            local driveSlot=selfFindSlotExcluding("disk_drive",reserved)
            if not driveSlot then
                ensureGroundLevel()
                return false
            end

            turtle.select(driveSlot)
            if not turtle.place() then
                ensureGroundLevel()
                return false
            end

            if peripheral.getType("front")~="drive" then
                ensureGroundLevel()
                return false
            end

            if not disk.isPresent("front") then
                if not selfSelectKind("floppy") or not turtle.drop(1) then
                    ensureGroundLevel()
                    return false
                end
            end

            if not ensureGroundLevel() then
                return false
            end

            faceTracked(DIR_N)
            if not verifyGroundFrontNoDrive() then
                state.phase="VERTICAL_ERROR"
                saveState()
                sendState("Disk Drive remained at ground level after correction")
                return false
            end
        end

        state.phase="PLACING_MINER"
        saveState()
        return state.y==0 and state.x==tx and state.z==stagingZ and state.dir==DIR_N
    end

    local function recoverInstaller(workerId,tx,tz,useBootstrapDrive)
        local stagingZ=tz-1

        if state.x~=tx or state.z~=stagingZ then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Foreman moved away before installer recovery")
            return false
        end

        if not ensureGroundLevel() then
            return false
        end

        faceTracked(DIR_N)

        if frontComputerId()~=workerId then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Assigned miner not directly in front")
            return false
        end

        if not ensureInstallerLevel() then
            return false
        end

        faceTracked(DIR_N)
        state.phase="RETRIEVING_FLOPPY"
        saveState()

        if peripheral.getType("front")~="drive" then
            state.phase="VERTICAL_ERROR"
            saveState()
            sendState("Disk Drive is not directly in front at installer height")
            ensureGroundLevel()
            return false
        end

        local floppySlot=selfTargetSlot("floppy")
        if not floppySlot then
            state.phase="WAITING_INSTALLER"
            saveState()
            sendState("No inventory room for floppy")
            ensureGroundLevel()
            return false
        end

        turtle.select(floppySlot)
        local floppyDeadline=now()+10

        while not matchesItem(selfItem(floppySlot),"floppy") and now()<floppyDeadline do
            turtle.suck(1)
            if not matchesItem(selfItem(floppySlot),"floppy") then
                sleep(0.25)
            end
        end

        if not matchesItem(selfItem(floppySlot),"floppy") then
            state.phase="WAITING_INSTALLER"
            saveState()
            sendState("Could not retrieve miner floppy")
            ensureGroundLevel()
            return false
        end

        if not ensureGroundLevel() then
            return false
        end

        faceTracked(DIR_N)

        if peripheral.getType("front")=="drive" then
            state.phase="VERTICAL_ERROR"
            saveState()
            sendState("Disk Drive detected at ground level after floppy retrieval")
            return false
        end

        if frontComputerId()~=workerId then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Assigned miner moved before Disk Drive handoff")
            return false
        end

        state.phase="WAITING_FOR_DRIVE"
        saveState()
        sendState("Waiting for miner to break Disk Drive")

        local ready=nil
        local lastRequest=0
        local lastWarning=now()

        while not ready do
            if now()-lastRequest>=1 then
                send(workerId,{type="return_installer"})
                lastRequest=now()
            end

            local _,reply=waitInbox(function(sender,m)
                return sender==workerId and type(m)=="table" and
                    (m.type=="installer_ready" or m.type=="installer_break_failed")
            end,0.5)

            if reply then
                if reply.type=="installer_ready" then
                    ready=reply
                else
                    sendState("Miner installer break retry: " .. tostring(reply.reason))
                end
            elseif now()-lastWarning>=10 then
                sendState("Still waiting for miner to break Disk Drive")
                lastWarning=now()
            end
        end

        local targetSlot=nil
        local slotCountBefore=nil
        local driveCountBefore=nil

        if useBootstrapDrive then
            targetSlot=selfEmptySlot()
            if targetSlot then
                slotCountBefore=turtle.getItemCount(targetSlot)
            end
        else
            local reserved=state.bootstrapDrivePending and state.bootstrapDriveSlot or nil
            targetSlot=selfTargetSlotExcluding("disk_drive",reserved)
            if targetSlot then
                slotCountBefore=turtle.getItemCount(targetSlot)
                driveCountBefore=selfCount("disk_drive")
            end
        end

        if not targetSlot then
            state.phase="WAITING_INSTALLER"
            saveState()
            sendState("No room for returned Disk Drive")
            return false
        end

        turtle.select(targetSlot)
        lastWarning=now()
        local driveReceived=false

        while not driveReceived do
            turtle.suck(1)
            sleep(0.1)

            local slotCountNow=turtle.getItemCount(targetSlot)

            if slotCountNow>slotCountBefore then
                driveReceived=true
            elseif not useBootstrapDrive and driveCountBefore and selfCount("disk_drive")>driveCountBefore then
                driveReceived=true
            else
                send(workerId,{type="return_installer"})

                if now()-lastWarning>=10 then
                    state.phase="WAITING_FOR_DRIVE_TRANSFER"
                    saveState()
                    sendState("Disk Drive broken but transfer to Foreman not yet confirmed")
                    lastWarning=now()
                end

                sleep(0.25)
            end
        end

        if useBootstrapDrive then
            state.bootstrapDrivePending=true
            state.bootstrapDriveSlot=targetSlot
            saveState()
        end

        state.phase="CONFIRMING_INSTALLER_HANDOFF"
        saveState()

        local returned=nil
        local lastTaken=0
        lastWarning=now()

        while not returned do
            if now()-lastTaken>=1 then
                send(workerId,{type="installer_taken"})
                lastTaken=now()
            end

            local _,reply=waitInbox(function(sender,m)
                return sender==workerId and type(m)=="table" and m.type=="installer_returned"
            end,0.5)

            if reply then
                returned=reply
            elseif now()-lastWarning>=10 then
                sendState("Disk Drive received; waiting for miner handoff acknowledgement")
                lastWarning=now()
            end
        end

        state.phase="INSTALLER_RECOVERED"
        saveState()
        return true
    end

    local function validateCommissionPackage()
        local remaining = 0
        state.commissionedRows = state.commissionedRows or {}

        for row=cfg.rowStart,cfg.rowEnd do
            if not state.commissionedRows[row] then
                remaining = remaining + 1
            end
        end

        if remaining == 0 then
            return true
        end

        if selfCount("floppy") < 1 then
            state.phase="WAITING_SUPPLIES"
            saveState()
            sendState("Missing miner floppy")
            return false
        end

        if selfCount("wireless_mining_turtle") < remaining then
            state.phase="WAITING_SUPPLIES"
            saveState()
            sendState("Missing assigned miners")
            return false
        end

        if state.commissionFuelLoaded and selfCount("coal") < WORKER_SETUP_COAL * remaining then
            state.phase="WAITING_SUPPLIES"
            saveState()
            sendState("Not enough miner commissioning fuel")
            return false
        end

        local reserved=state.bootstrapDrivePending and state.bootstrapDriveSlot or nil
        if selfCountExcluding("disk_drive",reserved) < 1 then
            state.phase="WAITING_SUPPLIES"
            saveState()
            sendState("Missing operational Disk Drive")
            return false
        end

        return true
    end

    local function commissionMiner(row,useBootstrapDrive)
        if not validateCommissionPackage() then
            return false
        end

        local targetX=row
        local targetZ=1
        local stagingZ=0
        local temporary=false

        if useBootstrapDrive then
            targetX=1
            targetZ=-1
            stagingZ=-2
            temporary=true

            if state.x~=targetX or state.z~=stagingZ then
                if not goTo(targetX,stagingZ) then
                    return false
                end
            end

            faceTracked(DIR_N)
            saveState()

            if not ensureInstallerLevel() then
                return false
            end

            faceTracked(DIR_N)

            if peripheral.getType("front")~="drive" then
                ensureGroundLevel()
                state.phase="PLACEMENT_ERROR"
                saveState()
                sendState("Bootstrap Disk Drive missing above Miner-01 pad")
                return false
            end

            if not disk.isPresent("front") then
                if not selfSelectKind("floppy") then
                    ensureGroundLevel()
                    state.phase="WAITING_INSTALLER"
                    saveState()
                    sendState("Foreman-1 bootstrap floppy missing")
                    return false
                end

                if not turtle.drop(1) then
                    ensureGroundLevel()
                    state.phase="WAITING_INSTALLER"
                    saveState()
                    sendState("Cannot insert Foreman-1 bootstrap floppy")
                    return false
                end
            end

            if not disk.isPresent("front") then
                ensureGroundLevel()
                state.phase="PLACEMENT_ERROR"
                saveState()
                sendState("Bootstrap floppy verification failed")
                return false
            end

            if not ensureGroundLevel() then
                return false
            end

            faceTracked(DIR_N)
        else
            if state.x~=targetX or state.z~=stagingZ then
                state.phase="PLACEMENT_ERROR"
                saveState()
                sendState("Foreman is not at the expected miner staging position")
                return false
            end

            if not placeDriveAndDiskAt(targetX,targetZ) then
                return false
            end
        end

        if not ensureGroundLevel() then
            return false
        end

        faceTracked(DIR_N)

        if state.x~=targetX or state.z~=stagingZ or state.y~=0 or state.dir~=DIR_N then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Wrong position or facing before miner placement")
            return false
        end

        if frontComputerId() then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Miner target already occupied")
            return false
        end

        if turtle.detect() then
            turtle.dig()
            sleep(0.2)
        end

        if turtle.detect() then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Miner target remains blocked")
            return false
        end

        if not selfSelectKind("wireless_mining_turtle") then
            state.phase="WAITING_SUPPLIES"
            saveState()
            sendState("Wireless Mining Turtle missing")
            return false
        end

        if not turtle.place() then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Cannot place Miner-" .. tostring(row))
            return false
        end

        sleep(0.2)

        local workerId=frontComputerId()
        if not workerId then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Cannot identify Miner-" .. tostring(row))
            return false
        end

        pcall(peripheral.call,"front","turnOn")

        local configurePacket={
            type="configure",
            target=workerId,
            role="miner",
            row=row,
            foremanId=id,
            foremanNumber=number,
            tempDeployment=temporary,
            managerId=cfg.managerId,
            masterForemanId=cfg.masterForemanId,
            session=cfg.session
        }

        local installed=nil
        local lastConfigure=0
        local warning=now()

        while not installed do
            if now()-lastConfigure>=1 then
                send(workerId,configurePacket)
                pcall(peripheral.call,"front","turnOn")
                lastConfigure=now()
            end

            local _,reply=waitInbox(function(sender,m)
                return sender==workerId and type(m)=="table" and m.type=="install_ok" and m.row==row
            end,0.5)

            if reply then
                installed=reply
            elseif now()-warning>=10 then
                state.phase="WAITING_MINER_BOOT"
                saveState()
                sendState("Waiting for Miner-" .. tostring(row) .. " installation")
                warning=now()
            end
        end

        if frontComputerId()~=workerId then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Miner moved before commissioning completed")
            return false
        end

        if not selfDropKind("coal",WORKER_SETUP_COAL) then
            state.phase="WAITING_FUEL"
            saveState()
            sendState("Cannot give Miner-" .. tostring(row) .. " startup coal")
            return false
        end

        local fueled=nil
        local lastFuel=0
        warning=now()

        while not fueled do
            if now()-lastFuel>=1 then
                send(workerId,{type="commission_refuel"})
                lastFuel=now()
            end

            local _,reply=waitInbox(function(sender,m)
                return sender==workerId and type(m)=="table" and m.type=="commission_refueled" and m.row==row
            end,0.5)

            if reply then
                fueled=reply
            elseif now()-warning>=10 then
                state.phase="WAITING_MINER_FUEL"
                saveState()
                sendState("Waiting for Miner-" .. tostring(row) .. " fuel confirmation")
                warning=now()
            end
        end

        if not recoverInstaller(workerId,targetX,targetZ,useBootstrapDrive) then
            return false
        end

        local deployed=nil
        local lastDeploy=0
        warning=now()

        while not deployed do
            if now()-lastDeploy>=1 then
                send(workerId,{type="deploy_miner"})
                lastDeploy=now()
            end

            local _,reply=waitInbox(function(sender,m)
                return sender==workerId and type(m)=="table" and m.row==row and
                    (m.type=="miner_deployed" or m.type=="miner_deploy_blocked")
            end,0.5)

            if reply then
                if reply.type=="miner_deployed" then
                    deployed=reply
                else
                    state.phase="MINER_DEPLOY_BLOCKED"
                    saveState()
                    sendState("Miner-" .. tostring(row) .. " deployment blocked: " .. tostring(reply.reason))
                    return false
                end
            elseif now()-warning>=10 then
                state.phase="WAITING_MINER_DEPLOY"
                saveState()
                sendState("Waiting for Miner-" .. tostring(row) .. " standby confirmation")
                warning=now()
            end
        end

        state.minerIds=state.minerIds or {}
        state.minerIds[row]=workerId

        if useBootstrapDrive then
            state.firstInstallerRecovered=true
        end

        faceTracked(DIR_N)
        state.phase="MINER_COMMISSIONED"
        saveState()
        return true
    end

    local function returnInstaller()
        local reserved=state.bootstrapDrivePending and state.bootstrapDriveSlot or nil

        if selfCountExcluding("disk_drive",reserved)==0 and selfCount("floppy")==0 then
            return true
        end

        if not atSupply() then
            return false
        end

        while selfCountExcluding("disk_drive",reserved)>0 do
            local slot=selfFindSlotExcluding("disk_drive",reserved)
            if not slot then
                break
            end
            turtle.select(slot)
            if not turtle.drop() then
                state.phase="DOCK_BLOCKED"
                saveState()
                sendState("Cannot return operational Disk Drive")
                return false
            end
        end

        while selfCount("floppy")>0 do
            local slot=selfFindSlot("floppy")
            if not slot then
                break
            end
            turtle.select(slot)
            if not turtle.drop() then
                state.phase="DOCK_BLOCKED"
                saveState()
                sendState("Cannot return floppy")
                return false
            end
        end

        return exitDockHome()
    end

    local function returnUnusedFuel()
        useOwnFuel()
        if not atFuel() then
            return false
        end

        while selfCount("coal") > 0 do
            local slot = selfFindSlot("coal")
            if not slot then
                break
            end
            turtle.select(slot)
            if not turtle.drop() then
                state.phase="DOCK_BLOCKED"
                saveState()
                sendState("Cannot return unused fuel; dock token retained")
                return false
            end
        end

        return exitDockHome()
    end

    local function loadCommissionFuel()
        state.commissionedRows = state.commissionedRows or {}

        local remaining = 0
        for row=cfg.rowStart,cfg.rowEnd do
            if not state.commissionedRows[row] then
                remaining = remaining + 1
            end
        end

        if remaining == 0 then
            return true
        end

        if state.commissionFuelLoaded then
            return true
        end

        if not atFuel() then
            return false
        end

        if not refuelAtFrontTo(FOREMAN_FUEL_TARGET) then
            state.phase="WAITING_FUEL"
            saveState()
            sendState("Fuel chest cannot satisfy foreman fuel target; dock token retained")
            return false
        end

        local needed = WORKER_SETUP_COAL * 4
        local pulled = takeNamedIntoSelf("coal",needed)

        if pulled < needed then
            state.phase="WAITING_FUEL"
            saveState()
            sendState("Need 60 coal for assigned miners")
            return false
        end

        state.commissionFuelLoaded = true
        saveState()

        return exitDockHome()
    end

    local function navigatorVertical(targetY)
        if number~=4 or targetY<0 or targetY>15 then
            return false
        end

        while state.y<targetY do
            local intent={
                seq=state.seq+1,
                from=state.y,
                to=state.y+1,
                fuelBefore=turtle.getFuelLevel()
            }
            state.verticalIntent=intent
            saveState()

            if not turtle.up() then
                state.verticalIntent=nil
                saveState()
                return false
            end

            state.y=intent.to
            state.seq=intent.seq
            checkpointForeman()
            state.verticalIntent=nil
            saveState()
        end

        while state.y>targetY do
            local intent={
                seq=state.seq+1,
                from=state.y,
                to=state.y-1,
                fuelBefore=turtle.getFuelLevel()
            }
            state.verticalIntent=intent
            saveState()

            if not turtle.down() then
                state.verticalIntent=nil
                saveState()
                return false
            end

            state.y=intent.to
            state.seq=intent.seq
            checkpointForeman()
            state.verticalIntent=nil
            saveState()
        end

        return state.y==targetY
    end

    local function navigatorForward(targetDir)
        if number~=4 or not faceTracked(targetDir) then
            return false
        end

        local tx=state.x
        local tz=state.z

        if targetDir==DIR_N then
            tz=tz+1
        elseif targetDir==DIR_E then
            tx=tx+1
        elseif targetDir==DIR_S then
            tz=tz-1
        else
            tx=tx-1
        end

        if tx<-1 or tx>16 or tz<-5 or tz>14 or state.y<10 or state.y>15 then
            return false
        end

        local intent={
            seq=state.seq+1,
            fuelBefore=turtle.getFuelLevel(),
            from={x=state.x,z=state.z,y=state.y,dir=state.dir},
            to={x=tx,z=tz,y=state.y,dir=state.dir}
        }

        state.motionIntent=intent
        saveState()

        if not turtle.forward() then
            state.motionIntent=nil
            saveState()
            return false
        end

        state.x=tx
        state.z=tz
        state.seq=intent.seq
        checkpointForeman()
        state.motionIntent=nil
        saveState()
        return true
    end

    local function navigatorGoTo(tx,ty,tz)
        if number~=4 then
            return false
        end

        if state.y<10 then
            if not navigatorVertical(10) then return false end
        end

        while state.x<tx do
            if not navigatorForward(DIR_E) then return false end
        end
        while state.x>tx do
            if not navigatorForward(DIR_W) then return false end
        end
        while state.z<tz do
            if not navigatorForward(DIR_N) then return false end
        end
        while state.z>tz do
            if not navigatorForward(DIR_S) then return false end
        end

        return navigatorVertical(ty)
    end

    local function loadNavigatorSupplies()
        if number~=4 then
            return false
        end

        if selfCount("computer")>=4 and selfCount("wireless_modem")>=4 and
            selfCount("disk_drive")>=4 then
            return true
        end

        if not atSupply() then
            return false
        end

        local needComputers=4-selfCount("computer")
        if needComputers>0 and takeNamedIntoSelf("computer",needComputers)<needComputers then
            state.phase="WAITING_NAVIGATOR_SUPPLIES"
            saveState()
            sendState("Need 4 regular Computers in the supply chest")
            return false
        end

        local needModems=4-selfCount("wireless_modem")
        if needModems>0 and takeNamedIntoSelf("wireless_modem",needModems)<needModems then
            state.phase="WAITING_NAVIGATOR_SUPPLIES"
            saveState()
            sendState("Need 4 Wireless Modems in the supply chest")
            return false
        end

        local needDrives=4-selfCount("disk_drive")
        if needDrives>0 and takeNamedIntoSelf("disk_drive",needDrives)<needDrives then
            state.phase="WAITING_NAVIGATOR_SUPPLIES"
            saveState()
            sendState("Need 4 additional Disk Drives in the supply chest")
            return false
        end


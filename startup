    local function masterSetup()
        state.phase="MASTER_SETUP"
        state.foremenReady = state.foremenReady or {[1]=true}
        cfg.foremen = cfg.foremen or {[1]=id}
        saveState()
        saveTable("node.cfg",cfg)
        sendState("Setting up Navigators and foremen")

        if not ensureMasterSeedFuel() then
            return false
        end

        if not state.initialFuelLoaded then
            if not masterFuelAndLoadCoal() then
                state.phase="WAITING_SUPPLIES"
                saveState()
                sendState("Need seed fuel plus three Foreman coal stacks")
                return false
            end
            state.initialFuelLoaded=true
            saveState()
        end

        if not state.initialSuppliesLoaded then
            if not masterLoadSupplies() then
                state.phase="WAITING_SUPPLIES"
                saveState()
                sendState("Need 5 drives, 4 floppies, 16 miners, 3 Narcissistic Wireless Turtles, and 4 Advanced Wireless Turtles")
                return false
            end
            state.initialSuppliesLoaded=true
            saveState()
        end

        if not state.bootstrapReady then
            if not masterPlaceBootstrapInstaller() then
                state.phase="WAITING_SUPPLIES"
                saveState()
                sendState("Cannot establish bootstrap station")
                return false
            end
            state.bootstrapReady=true
            saveState()
        end

        state.navigatorLaunchReady=state.navigatorLaunchReady or {}
        cfg.navigators=cfg.navigators or {}

        local navigatorOrder={4,3,2,1}

        for _,n in ipairs(navigatorOrder) do
            if not state.navigatorLaunchReady[n] then
                state.phase="DEPLOYING_NAVIGATOR"
                saveState()
                sendState("Placing Navigator-" .. tostring(n))

                local nid=masterCommissionNavigator(n)
                if not nid then
                    state.phase="WAITING_NAVIGATOR_SETUP"
                    saveState()
                    sendState("Navigator-" .. tostring(n) .. " setup paused")
                    return false
                end

                state.navigatorLaunchReady[n]=true
                cfg.navigators[n]=nid
                saveTable("node.cfg",cfg)
                saveState()
            end
        end

        state.navigatorSetupDone=true
        saveState()

        for n=2,4 do
            if not state.foremenReady[n] then
                local fid=masterCommissionForeman(n)
                if not fid then
                    state.phase="WAITING_SETUP"
                    saveState()
                    sendState("Foreman-" .. tostring(n) .. " setup paused")
                    return false
                end
                state.foremenReady[n]=true
                cfg.foremen[n]=fid
                saveTable("node.cfg",cfg)
                saveState()
            end
        end

        if not state.bootstrapDiskPulled then
            if not goTo(1,-2) then
                state.phase="WAITING_SETUP"
                saveState()
                sendState("Cannot reach bootstrap drive")
                return false
            end
            if not ensureGroundLevel() then
                return false
            end
            faceTracked(DIR_N)
            if not ensureInstallerLevel() then
                state.phase="WAITING_SETUP"
                saveState()
                sendState("Cannot reach bootstrap drive height")
                return false
            end
            local floppySlot = selfTargetSlot("floppy")
            if not floppySlot then
                ensureGroundLevel()
                state.phase="WAITING_SETUP"
                saveState()
                sendState("No room for bootstrap floppy")
                return false
            end
            turtle.select(floppySlot)
            if not turtle.suck(1) then
                ensureGroundLevel()
                state.phase="WAITING_SETUP"
                saveState()
                sendState("Cannot pull bootstrap floppy")
                return false
            end
            ensureGroundLevel()
            state.bootstrapDiskPulled=true
            saveState()
        end

        if not state.ownInstallerLoaded then
            if selfCount("disk_drive") < 1 then
                state.phase="WAITING_SUPPLIES"
                saveState()
                sendState("Foreman-1 Disk Drive missing")
                return false
            end
            if selfCount("wireless_mining_turtle") < 4 then
                state.phase="WAITING_SUPPLIES"
                saveState()
                sendState("Foreman-1 miners missing")
                return false
            end
            if selfCount("floppy") < 1 then
                state.phase="WAITING_SUPPLIES"
                saveState()
                sendState("Foreman-1 floppy missing")
                return false
            end
            state.ownInstallerLoaded=true
            saveState()
        end

        state.phase="CLEARING_SETUP_AREA"
        saveState()
        sendState("Clearing shared setup area")

        if not returnHome() then
            state.phase="WAITING_SETUP"
            saveState()
            sendState("Cannot clear shared setup area")
            return false
        end

        state.phase="WAITING_SETUP"
        saveState()
        sendState("Four foremen online")
        return true
    end


    local function applyManagerForemanPose()
        local snapshot,seq=requestPoseBackup("foreman",5,cfg.session)

        if snapshot and type(snapshot.x)=="number" and type(snapshot.y)=="number" and
            type(snapshot.z)=="number" and type(snapshot.dir)=="number" then
            local incoming=tonumber(seq or snapshot.seq or 0) or 0

            state.x=snapshot.x
            state.y=snapshot.y
            state.z=snapshot.z
            state.dir=snapshot.dir
            state.seq=incoming
            state.motionIntent=nil
            state.verticalIntent=nil
            state.turnIntent=nil
            state.recoveryLocked=false
            state.recoveryReason=nil
            saveState()
        end
    end

    local function recallForeman(mode)
        mode=mode or "NORMAL"
        applyManagerForemanPose()

        if state.recoveryLocked then
            sendState("Recall refused: " .. tostring(state.recoveryReason or "pose uncertain"))
            return false
        end

        active=nil
        queue={}
        saveQueue()

        state.phase="RECALLING"
        saveState()

        if not returnHome() then
            state.phase="RECOVERY_LOCK"
            state.recoveryLocked=true
            state.recoveryReason="Foreman recall could not reach home"
            saveState()
            return false
        end

        if not faceTracked(DIR_N) then
            return false
        end

        if state.x~=cfg.homeX or state.y~=0 or state.z~=cfg.homeZ or state.dir~=DIR_N then
            state.phase="RECOVERY_LOCK"
            state.recoveryLocked=true
            state.recoveryReason="Foreman recall home verification failed"
            saveState()
            return false
        end

        state.phase="RECALLED_PAUSED"
        state.recallMode=mode
        saveState()
        checkpointForeman()

        send(cfg.managerId,{
            type="recall_home",
            role="foreman",
            number=number,
            id=id,
            mode=mode,
            x=state.x,
            y=state.y,
            z=state.z,
            dir=state.dir,
            session=cfg.session
        })

        if mode=="SHUTDOWN" then
            os.setComputerLabel(nil)
            send(cfg.managerId,{
                type="recall_shutdown_ready",
                role="foreman",
                number=number,
                id=id,
                x=state.x,
                y=state.y,
                z=state.z,
                dir=state.dir,
                session=cfg.session
            })
            os.shutdown()
        end

        return true
    end

    local function serviceRequest(req)
        active = req
        saveQueue()
        state.phase="SERVICING"
        saveState()
        sendState("Servicing Miner-" .. tostring(req.row))

        while not active.arrived do
            sleep(0.1)
            if now() - (active.lastSeen or 0) > 30 then
                state.phase="WAITING_MINER"
                saveState()
            end
        end

        if not loadOwnFuel() then
            return false
        end

        if not prepareRuntimeService(req.service) then
            return false
        end

        if not goTo(req.row,0) then
            return false
        end

        if state.x~=req.row or state.z~=0 or state.y~=0 then
            state.phase="NAVIGATION_ERROR"
            saveState()
            sendState("Service route ended at wrong coordinate for Miner-" .. tostring(req.row))
            return false
        end

        if not verifyServiceMiner(req) then
            return false
        end

        saveState()

        if req.service == "REFUEL" or req.service == "BOTH" then
            local transferred,moved=dropMinerFuel(MINER_REFUEL_COAL)

            if not transferred then
                state.phase="SERVICE_TRANSFER_ERROR"
                saveState()
                sendState("Miner-" .. tostring(req.row) .. " would not accept refuel coal")
                return false
            end

            send(req.minerId,{
                type="refuel_now",
                requestId=req.requestId,
                coalTransferred=moved
            })

            local _,reply = waitInbox(function(sender,m)
                return sender==req.minerId and type(m)=="table" and m.type=="refuel_complete" and m.requestId==req.requestId
            end,20)

            if not reply then
                state.phase="SERVICE_TIMEOUT"
                saveState()
                sendState("Miner-" .. tostring(req.row) .. " did not confirm refuel")
                return false
            end
        end

        if req.service == "DUMP" or req.service == "BOTH" then
            local dumpFinished=false

            while not dumpFinished do
                if countRuntimeFreeSlots()<=0 then
                    state.phase="SERVICE_UNLOAD_TRIP"
                    saveState()
                    sendState("Foreman full; unloading before continuing Miner-" .. tostring(req.row))
                    send(cfg.managerId,{
                        type="job_progress",
                        requestId=req.requestId,
                        foremanId=id,
                        row=req.row,
                        phase="UNLOAD_TRIP",
                        session=cfg.session
                    })

                    if not dumpCargo() then
                        send(cfg.managerId,{
                            type="job_blocked",
                            requestId=req.requestId,
                            foremanId=id,
                            row=req.row,
                            reason=state.phase=="DOCK_BLOCKED" and "STORAGE_FULL" or "UNLOAD_FAILED",
                            session=cfg.session
                        })
                        return false
                    end

                    if not goTo(req.row,0) then
                        return false
                    end

                    if not verifyServiceMiner(req) then
                        return false
                    end
                end

                send(req.minerId,{
                    type="dump_prepare",
                    requestId=req.requestId
                })

                local _,reply=waitInbox(function(sender,m)
                    return sender==req.minerId and type(m)=="table" and
                        (m.type=="dump_slot_ready" or m.type=="service_not_adjacent") and
                        m.requestId==req.requestId
                end,10)

                if not reply then
                    state.phase="SERVICE_TIMEOUT"
                    saveState()
                    sendState("Miner-" .. tostring(req.row) .. " did not expose cargo")
                    return false
                end

                if reply.type=="service_not_adjacent" then
                    state.phase="SERVICE_ALIGNMENT_ERROR"
                    saveState()
                    sendState("Miner-" .. tostring(req.row) .. " cannot establish service position")
                    return false
                end

                if reply.empty then
                    dumpFinished=true
                else
                    local requested=math.min(64,tonumber(reply.count) or 64)
                    local pulled=false

                    for attempt=1,3 do
                        if turtle.suck(requested) then
                            pulled=true
                            break
                        end
                        sleep(0.1)
                    end

                    if not pulled then
                        if countRuntimeFreeSlots()<=0 then
                            state.phase="SERVICE_UNLOAD_TRIP"
                            saveState()
                            sendState("Foreman inventory filled while pulling Miner-" .. tostring(req.row))

                            if not dumpCargo() then
                                send(cfg.managerId,{
                                    type="job_blocked",
                                    requestId=req.requestId,
                                    foremanId=id,
                                    row=req.row,
                                    reason=state.phase=="DOCK_BLOCKED" and "STORAGE_FULL" or "UNLOAD_FAILED",
                                    session=cfg.session
                                })
                                return false
                            end

                            if not goTo(req.row,0) or not verifyServiceMiner(req) then
                                return false
                            end
                        else
                            state.phase="SERVICE_TRANSFER_ERROR"
                            saveState()
                            sendState("Could not pull exposed cargo from Miner-" .. tostring(req.row))
                            return false
                        end
                    end
                end
            end
        end

        if req.service == "DUMP" or req.service == "BOTH" then
            if selfCount("coal")>0 then
                state.phase="RETURNING_AFTER_SERVICE"
                saveState()
            end

            if not dumpCargo() then
                return false
            end
        end

        resolved[req.requestId] = now()
        send(cfg.managerId,{
            type="job_complete",
            requestId=req.requestId,
            foremanId=id,
            foremanNumber=number,
            minerId=req.minerId,
            row=req.row,
            service=req.service,
            session=cfg.session
        })
        active=nil
        saveQueue()
        returnHome()
        sendState("Service complete")
        return true
    end

    local function workLoop()
        if state.recoveryLocked then
            state.phase="RECOVERY_LOCK"
            saveState()
            checkpointForeman()
            while true do
                sendState("Movement locked: " .. tostring(state.recoveryReason or "pose uncertain"))
                sleep(5)
            end
        end

        checkpointForeman()

        if flags.recallMode then
            pauseForSetupRecall()
        end

        if state.phase=="DEPLOYING" then
            local laneX=cfg.number
            local deploymentValid=
                state.y==0 and
                state.x>=cfg.homeX and state.x<=laneX and
                state.z>=cfg.homeZ and state.z<=cfg.startZ

            if not deploymentValid then
                state.phase="RECOVERY_LOCK"
                state.recoveryLocked=true
                state.recoveryReason="Interrupted Foreman deployment pose is outside its deployment corridor"
                saveState()
                checkpointForeman()
                while true do
                    sendState(state.recoveryReason)
                    sleep(5)
                end
            end

            if state.z>cfg.homeZ then
                while state.x<laneX do
                    if not moveStep(DIR_E) then
                        state.recoveryLocked=true
                        state.recoveryReason="Could not regain Foreman deployment lane"
                        break
                    end
                end

                if not state.recoveryLocked then
                    while state.z>cfg.homeZ do
                        if not moveStep(DIR_S) then
                            state.recoveryLocked=true
                            state.recoveryReason="Could not resume Foreman southbound deployment"
                            break
                        end
                    end
                end
            end

            if not state.recoveryLocked and state.z==cfg.homeZ then
                while state.x>cfg.homeX do
                    if not moveStep(DIR_W) then
                        state.recoveryLocked=true
                        state.recoveryReason="Could not finish Foreman westbound deployment"
                        break
                    end
                end
            end

            if state.recoveryLocked or
                state.x~=cfg.homeX or state.z~=cfg.homeZ or state.y~=0 then
                state.phase="RECOVERY_LOCK"
                state.recoveryLocked=true
                state.recoveryReason=state.recoveryReason or "Could not resume interrupted Foreman deployment"
                saveState()
                checkpointForeman()
                while true do
                    sendState(state.recoveryReason)
                    sleep(5)
                end
            end

            faceTracked(DIR_N)
            state.phase="WAITING_SETUP"
            state.setupDone=false
            saveState()
            checkpointForeman()

            for i=1,3 do
                send(cfg.controller,{
                    type="foreman_deployed",
                    id=id,
                    number=number
                })
                sleep(0.1)
            end
        end

        if cfg.master and not state.setupDone then
            while not state.masterSetupDone do
                if flags.recallMode then
                    pauseForSetupRecall()
                elseif masterSetup() then
                    state.masterSetupDone=true
                    saveState()
                else
                    if flags.recallMode then
                        pauseForSetupRecall()
                    else
                        state.phase="WAITING_SETUP"
                        saveState()
                        sendState("Master setup paused, retrying")
                        sleep(2)
                    end
                end
            end

            if not state.minerSetupApproved then
                state.phase="WAITING_MINER_APPROVAL"
                saveState()
                sendState("GPS ready check pending; approve miner setup at Regional Manager")

                while not state.minerSetupApproved do
                    if flags.recallMode then
                        pauseForSetupRecall()
                    end

                    send(cfg.managerId,{
                        type="miner_setup_gate_request",
                        session=cfg.session
                    })

                    local _,reply=waitInbox(function(sender,m)
                        return sender==cfg.managerId and type(m)=="table" and
                            m.type=="miner_setup_approved" and m.session==cfg.session
                    end,1)

                    if reply then
                        state.minerSetupApproved=true
                        saveState()
                    end
                end
            end

            state.groupsCommissioned = state.groupsCommissioned or {}

            for n=2,4 do
                if not state.groupsCommissioned[n] then
                    commissionWave[n] = commissionWave[n] or {}
                    send(cfg.foremen[n],{type="commission_start",number=n})
                    commissionWave[n].lastSend = now()
                end
            end

            if not state.groupsCommissioned[1] then
                state.phase="COMMISSIONING"
                saveState()
                sendState("All foremen released for simultaneous commissioning")

                while not commissionAssigned() do
                    state.phase="WAITING_SETUP"
                    saveState()
                    sendState("Foreman-1 commissioning paused, retrying")
                    sleep(2)
                end

                state.groupsCommissioned[1]=true
                saveState()
            end

            while not (state.groupsCommissioned[2] and state.groupsCommissioned[3] and state.groupsCommissioned[4]) do
                state.phase="WAITING_SETUP"
                saveState()
                sendState("Waiting for all foremen to finish commissioning")
                sleep(1)
            end

            state.setupDone=true
            state.phase="IDLE"
            saveState()
            sendState("Commissioning complete; waiting for Regional Manager release")

            send(cfg.managerId,{
                type="commissioning_complete",
                version=VERSION,
                masterForemanId=id,
                session=cfg.session
            })

            returnHome()
        elseif not cfg.master and not state.setupDone then
            while not flags.commissionStart do
                if flags.recallMode then
                    pauseForSetupRecall()
                else
                    sleep(0.1)
                end
            end
            flags.commissionStart=false

            while not state.setupDone do
                if flags.recallMode then
                    pauseForSetupRecall()
                elseif commissionAssigned() then
                    break
                else
                    if flags.recallMode then
                        pauseForSetupRecall()
                    else
                        state.phase="WAITING_SETUP"
                        saveState()
                        sendState("Commissioning paused, retrying")
                        sleep(2)
                    end
                end
            end
        end

        while true do
            if flags.startMining then
                flags.startMining=false
                state.miningStarted=true
                if state.phase~="RECALLED_PAUSED" then
                    state.phase="IDLE"
                end
                saveState()
                sendState("Regional Manager released mining")
            end

            if flags.recallMode then
                local mode=flags.recallMode
                flags.recallMode=nil

                if mode=="NORMAL" or mode=="SHUTDOWN" then
                    recallForeman(mode)
                end
            end

            if state.phase=="RECALLED_PAUSED" then
                if flags.resume then
                    flags.resume=false
                    state.recallMode=nil
                    state.phase="IDLE"
                    saveState()
                    sendState("Regional Manager resumed operations")
                else
                    sleep(0.2)
                end
            else
                loadOwnFuel()
            end

            if state.phase~="RECALLED_PAUSED" and not active and #queue>0 then
                active=table.remove(queue,1)
                saveQueue()
            end

            if state.phase=="RECALLED_PAUSED" then
                sleep(0.2)
            elseif active then
                if not serviceRequest(active) then
                    local failed=active
                    local failurePhase=state.phase
                    local blockedReason=nil

                    if failurePhase=="DOCK_BLOCKED" then
                        blockedReason="STORAGE_FULL"
                    elseif failurePhase=="WAITING_FUEL" then
                        blockedReason="FUEL_UNAVAILABLE"
                    end

                    state.phase=blockedReason and failurePhase or "ERROR"
                    saveState()
                    sendState(blockedReason and ("Service blocked: " .. blockedReason) or "Service error; Regional Manager retains authority")

                    if failed then
                        send(cfg.managerId,{
                            type=blockedReason and "job_blocked" or "job_failed",
                            requestId=failed.requestId,
                            foremanId=id,
                            foremanNumber=number,
                            row=failed.row,
                            reason=blockedReason or failurePhase,
                            session=cfg.session
                        })
                    end

                    active=nil
                    queue={}
                    saveQueue()

                    if not blockedReason then
                        returnHome()
                    end

                    sleep(2)
                end
            else
                if state.x ~= cfg.homeX or state.z ~= cfg.homeZ then
                    returnHome()
                end
                sleep(0.2)
            end
        end
    end

    parallel.waitForAny(networkLoop, workLoop)
end

local function runNavigator(cfg)
    setRegionalManager(cfg.managerId)

    if not openNetwork() then
        error("Navigator wireless modem not found")
    end

    local statePath="navigator" .. tostring(cfg.number) .. ".tmp"
    local state=loadTable(statePath) or {
        x=tonumber(cfg.startX) or 1,
        y=tonumber(cfg.startY) or 0,
        z=tonumber(cfg.startZ) or -1,
        dir=tonumber(cfg.startDir) or DIR_S,
        orientationCalibrated=false,
        deployed=cfg.deployed and true or false
    }

    local function save()
        saveTable(statePath,state)
    end

    local function turnRight()
        if not turtle.turnRight() then return false end
        state.dir=(state.dir+1)%4
        save()
        return true
    end

    local function face(target)
        target=target%4
        while state.dir~=target do
            if not turnRight() then return false end
        end
        return true
    end

    local function step(dir)
        if not face(dir) then return false end
        if not turtle.forward() then return false end

        if dir==DIR_N then
            state.z=state.z+1
        elseif dir==DIR_E then
            state.x=state.x+1
        elseif dir==DIR_S then
            state.z=state.z-1
        else
            state.x=state.x-1
        end

        save()
        return true
    end

    local function vertical(targetY)
        while state.y<targetY do
            if not turtle.up() then return false end
            state.y=state.y+1
            save()
        end

        while state.y>targetY do
            if not turtle.down() then return false end
            state.y=state.y-1
            save()
        end

        return true
    end

    local function refuelStartupCoal()
        if turtle.getFuelLevel()=="unlimited" then
            return true
        end

        for slot=1,16 do
            if turtle.getItemCount(slot)>0 then
                turtle.select(slot)
                if turtle.refuel(0) then
                    turtle.refuel()
                end
            end
        end

        turtle.select(1)
        return turtle.getFuelLevel()=="unlimited" or turtle.getFuelLevel()>0
    end

    local function calibrateOrientation()
        if state.orientationCalibrated then
            return true
        end

        state.dir=tonumber(cfg.startDir) or state.dir or DIR_S

        if cfg.placementSupported then
            state.dir=DIR_N
        else
            state.dir=DIR_S
            if not turnRight() then return false end
            if not turnRight() then return false end
        end

        state.orientationCalibrated=true
        save()
        return state.dir==DIR_N
    end

    local function announceTraveling()
        for i=1,3 do
            send(cfg.controller,{
                type="navigator_traveling",
                id=os.getComputerID(),
                number=cfg.number,
                x=state.x,
                y=state.y,
                z=state.z
            })
            sleep(0.1)
        end
    end

    local function travelToSite()
        local site=NAVIGATOR_SITES[cfg.number]
        if not site then return false end

        if not calibrateOrientation() then
            return false
        end

        if not step(DIR_N) then
            return false
        end

        if not vertical(1) then
            return false
        end

        if cfg.number==4 then
            if not step(DIR_E) then return false end
        elseif cfg.number==3 then
            if not step(DIR_N) then return false end
        elseif cfg.number==2 then
            if not step(DIR_W) then return false end
        end

        announceTraveling()

        if not vertical(site.y) then
            return false
        end

        while state.x<site.x do
            if not step(DIR_E) then return false end
        end
        while state.x>site.x do
            if not step(DIR_W) then return false end
        end
        while state.z<site.z do
            if not step(DIR_N) then return false end
        end
        while state.z>site.z do
            if not step(DIR_S) then return false end
        end

        state.deployed=true
        cfg.deployed=true
        save()
        saveTable("node.cfg",cfg)
        return true
    end

    if not state.deployed then
        local deployRequested=false

        while not deployRequested do
            local sender,message=rednet.receive(PROTOCOL,2)
            if sender==cfg.controller and type(message)=="table" and
                message.type=="deploy_navigator" and
                tonumber(message.number)==tonumber(cfg.number) then
                deployRequested=true
            end
        end

        if not refuelStartupCoal() then
            error("Navigator startup fuel missing")
        end

        if not travelToSite() then
            error("Navigator travel blocked")
        end
    end

    cfg.x=state.x
    cfg.y=state.y
    cfg.z=state.z
    saveTable("node.cfg",cfg)

    if not ensureManagerRegistration(cfg) then
        error("Navigator Regional Manager registration failed")
    end

    local modemSide=nil
    for _,side in ipairs(SIDES) do
        if peripheral.getType(side)=="modem" then
            local ok,wireless=pcall(peripheral.call,side,"isWireless")
            if ok and wireless then
                modemSide=side
                break
            end
        end
    end

    if not modemSide then
        error("Navigator requires a Wireless Modem")
    end

    local modem=peripheral.wrap(modemSide)
    modem.open(gps.CHANNEL_GPS)

    local function sendNavigatorStatus()
        status("navigator","GPS_HOST",{
            number=cfg.number,
            x=state.x,
            y=state.y,
            z=state.z,
            gpsHost=true,
            modemSide=modemSide,
            message="GPS host active"
        })
    end

    sendNavigatorStatus()

    local timer=os.startTimer(5)

    while true do
        local event={os.pullEvent()}

        if event[1]=="modem_message" then
            local side=event[2]
            local channel=event[3]
            local replyChannel=event[4]
            local message=event[5]

            if side==modemSide and channel==gps.CHANNEL_GPS and message=="PING" then
                modem.transmit(replyChannel,gps.CHANNEL_GPS,{state.x,state.y,state.z})
            end
        elseif event[1]=="rednet_message" then
            local sender=event[2]
            local message=event[3]
            local protocol=event[4]

            if sender==cfg.managerId and protocol==PROTOCOL and type(message)=="table" and
                message.type=="status_query" then
                sendNavigatorStatus()
            end
        elseif event[1]=="timer" and event[2]==timer then
            sendNavigatorStatus()
            timer=os.startTimer(5)
        end
    end
end

local function runRegionalManager()
    while not openNetwork() do
        term.setBackgroundColor(colors.black)
        term.setTextColor(colors.white)
        term.clear()
        term.setCursorPos(1,1)
        print("Regional Manager waiting for wireless modem...")
        sleep(1)
    end

    while peripheral.getType("right")~="monitor" do
        term.setBackgroundColor(colors.black)
        term.setTextColor(colors.white)
        term.clear()
        term.setCursorPos(1,1)
        print("Regional Manager waiting for monitor on RIGHT...")
        sleep(1)
    end

    local managerId=os.getComputerID()

local RAW = "https://raw.githubusercontent.com/salesmanhappymask/Miner/main/"
local MIN_VERSION = 95
local CONFIG = "updater.cfg"
local args = {...}

local function readFile(path)
    local file = fs.open(path, "r")
    if not file then return nil end
    local data = file.readAll()
    file.close()
    return data
end

local function writeFile(path, data)
    local file = fs.open(path, "w")
    if not file then error("Cannot write " .. path) end
    file.write(data)
    file.close()
    local actual = readFile(path)
    if actual ~= data then
        local expectedLength = #data
        local actualLength = actual and #actual or 0
        local firstDifference = nil
        if actual then
            local limit = math.min(expectedLength, actualLength)
            for i = 1, limit do
                if data:byte(i) ~= actual:byte(i) then
                    firstDifference = i
                    break
                end
            end
            if not firstDifference and expectedLength ~= actualLength then
                firstDifference = limit + 1
            end
        end
        error("Verification failed: " .. path .. "; expected " .. expectedLength ..
            " bytes, read " .. actualLength ..
            (firstDifference and "; first difference " .. firstDifference or ""))
    end
end

local function fetch(name)
    local response = http.get(RAW .. name)
    if not response then error("Could not download " .. name .. "; nothing was changed") end
    local data = response.readAll()
    response.close()
    if not data or data == "" then error("Empty " .. name .. "; nothing was changed") end
    return data
end

local function normalize(value)
    value = tostring(value or ""):lower()
    if value == "1" or value == "rm" or value == "manager" or value == "regional" then return "manager" end
    if value == "2" or value == "mf" or value == "master" or value == "foreman1" or value == "foreman-1" then return "master" end
    return nil
end

local function roleName(role)
    if role == "manager" then return "Regional Manager" end
    return "Master Foreman"
end

local function loadConfig()
    local raw = readFile(CONFIG)
    if not raw then return nil end
    local ok, value = pcall(textutils.unserialize, raw)
    if not ok or type(value) ~= "table" then return nil end
    value.role = normalize(value.role)
    if not value.role then return nil end
    return value
end

local function saveConfig(role)
    writeFile(CONFIG, textutils.serialize({role = role}))
end

local running = shell.getRunningProgram() or ""
local fromDisk = running:match("^/?disk/") ~= nil

if fromDisk then
    print("Install permanent updater for:")
    print("1. Regional Manager")
    print("2. Master Foreman")
    local role = normalize(read())
    if not role then error("Select Regional Manager or Master Foreman") end
    local source = readFile(running)
    if not source then error("Cannot read updater from disk") end
    writeFile("update.new", source)
    if fs.exists("update") then fs.delete("update") end
    fs.move("update.new", "update")
    saveConfig(role)
    print("")
    print("Permanent updater installed for " .. roleName(role) .. ".")
    print("Remove this disk. You will not need it for normal updates again.")
    print("From now on, run: update")
    return
end

local config = loadConfig()
if not config then
    error("Updater role is not configured. Install it once with disk/update")
end

local requestedRole = normalize(args[1])
if args[1] and not requestedRole then error("Role must be manager or master") end
if requestedRole and requestedRole ~= config.role then
    error("This updater is permanently configured for " .. roleName(config.role))
end

if not turtle or not turtle.forward then error("Update requires a turtle") end

local role = config.role

local function validAnchor(value)
    return type(value) == "table" and type(value.x) == "number" and
        type(value.y) == "number" and type(value.z) == "number"
end

local function loadSerialized(path)
    local raw = readFile(path)
    if not raw then return nil end
    local ok, value = pcall(textutils.unserialize, raw)
    if not ok then return nil end
    return value
end

local anchor
if role == "master" then
    local existing = loadSerialized("world_anchor")
    if validAnchor(existing) then
        anchor = existing
    else
        local node = loadSerialized("node.cfg")
        if type(node) == "table" and validAnchor(node.worldOrigin) then
            anchor = {
                x = node.worldOrigin.x,
                y = node.worldOrigin.y,
                z = node.worldOrigin.z + 1
            }
            print("Recovered Master Foreman world anchor from node.cfg.")
        end
    end

    if not anchor and gps and gps.locate then
        local ok, x, y, z = pcall(gps.locate, 2, false)
        if ok and type(x) == "number" and type(y) == "number" and type(z) == "number" then
            anchor = {x = x, y = y, z = z}
            print("Recovered Master Foreman world anchor from GPS.")
        end
    end

    if not anchor then
        anchor = {}
        print("Master Foreman world anchor is missing.")
        print("Enter this turtle's current Minecraft coordinates once.")
        for _, axis in ipairs({"x", "y", "z"}) do
            while true do
                term.write(axis:upper() .. ": ")
                local value = tonumber(read())
                if value and value == math.floor(value) then
                    anchor[axis] = value
                    break
                end
                print("Enter a whole-number coordinate.")
            end
        end
    end
end

local files = {"startup", "common", "prep", "push", "pushlogs", role == "manager" and "manager" or "foreman"}
local staged = {}
local updaterSource = fetch("update")
local version = fetch("version"):match("^%s*(%d+)%s*$")
if not version or tonumber(version) < MIN_VERSION then
    error("Remote version must be " .. MIN_VERSION .. " or later; nothing was changed")
end

for _, name in ipairs(files) do
    staged[name] = fetch(name)
end

if staged.common:match("^%s*VERSION%s*=%s*(%d+)") ~= version then
    error("Common/version mismatch; nothing was changed")
end

local regional = role == "manager" and "1" or "0"
local master = role == "master" and "1" or "0"
local regionalCount, masterCount
staged.startup, regionalCount = staged.startup:gsub(
    "local%s+REGIONAL_MANAGER%s*=%s*%d+", "local REGIONAL_MANAGER = " .. regional, 1)
staged.startup, masterCount = staged.startup:gsub(
    "local%s+MASTER_FOREMAN%s*=%s*%d+", "local MASTER_FOREMAN = " .. master, 1)
if regionalCount ~= 1 or masterCount ~= 1 then
    error("Startup role flags missing; nothing was changed")
end

local compile = loadstring or load
if compile then
    for _, name in ipairs(files) do
        local fn, err = compile(staged[name], name)
        if not fn then error("Invalid " .. name .. ": " .. tostring(err) .. "; nothing was changed") end
    end
    local updaterFn, updaterErr = compile(updaterSource, "update")
    if not updaterFn then error("Invalid remote updater: " .. tostring(updaterErr) .. "; nothing was changed") end
end

if fetch("version"):match("^%s*(%d+)%s*$") ~= version then
    error("Remote version changed during download; nothing was changed")
end

local stageDir = ".update_stage"
if fs.exists(stageDir) then fs.delete(stageDir) end
fs.makeDir(stageDir)
for _, name in ipairs(files) do
    writeFile(fs.combine(stageDir, name), staged[name])
end
writeFile(fs.combine(stageDir, "version"), version)

local rootDrive=fs.getDrive("")
for _, path in ipairs(fs.list("")) do
    if path ~= "update" and path ~= stageDir and fs.getDrive(path)==rootDrive then
        fs.delete(path)
    end
end

saveConfig(role)

for _, name in ipairs(files) do
    fs.move(fs.combine(stageDir, name), name)
end
fs.move(fs.combine(stageDir, "version"), "version")
if fs.exists(stageDir) then fs.delete(stageDir) end

for _, name in ipairs(files) do
    if readFile(name) ~= staged[name] then error("Final verification failed: " .. name) end
end
if readFile("version") ~= version then error("Final verification failed: version") end

if anchor then
    writeFile("world_anchor", textutils.serialize(anchor))
end

writeFile("update.new", updaterSource)
if fs.exists("update.old") then fs.delete("update.old") end
if fs.exists("update") then fs.move("update", "update.old") end
fs.move("update.new", "update")
if readFile("update") ~= updaterSource then
    if fs.exists("update") then fs.delete("update") end
    if fs.exists("update.old") then fs.move("update.old", "update") end
    error("Updater self-refresh failed; previous updater restored")
end
if fs.exists("update.old") then fs.delete("update.old") end

if role == "manager" then
    os.setComputerLabel("Regional Manager")
else
    os.setComputerLabel("Foreman-1")
end

print("")
print("Update complete.")
print("Installed version " .. version .. " for " .. roleName(role) .. ".")
print("The permanent updater was refreshed and the saved role was preserved.")
print("No program was launched and the turtle was not rebooted.")
print("Run startup or reboot when you are ready to start the quarry software.")

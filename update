local ROLE = "ask"
local MIN_VERSION = 93
local RAW = "https://raw.githubusercontent.com/salesmanhappymask/Miner/main/"
local args={...}

local function readFile(path)
    local file=fs.open(path,"r")
    if not file then return nil end
    local data=file.readAll()
    file.close()
    return data
end

local function writeFile(path,data)
    local file=fs.open(path,"w")
    if not file then error("Cannot write "..path) end
    file.write(data)
    file.close()
    if readFile(path)~=data then error("Verification failed: "..path) end
end

local function fetch(name)
    local response=http.get(RAW..name)
    if not response then error("Could not download "..name.."; files were not erased") end
    local data=response.readAll()
    response.close()
    if not data or data=="" then error("Empty "..name.."; files were not erased") end
    return data
end

local function normalize(value)
    value=tostring(value or ""):lower()
    if value=="1" or value=="rm" or value=="manager" then return "manager" end
    if value=="2" or value=="mf" or value=="master" or
        value=="foreman1" then return "master" end
    return nil
end

local running=shell.getRunningProgram() or ""
local fromDisk=running:match("^/?disk/")~=nil
local role=normalize(ROLE)
local argument=normalize(args[1])
if args[1] and not argument then error("Role must be manager or master") end
if role and argument and argument~=role then error("Role argument conflicts with updater setting") end
role=role or argument

if fromDisk then
    if not role then
        print("Install updater for:")
        print("1. Regional Manager")
        print("2. Master Foreman")
        role=normalize(read())
    end
    if not role then error("Select Regional Manager or Master Foreman") end
    local source=readFile(running)
    if not source then error("Cannot read disk updater") end
    local configured,count=source:gsub('^local ROLE%s*=%s*"[^"]+"',
        'local ROLE = "'..role..'"',1)
    if count~=1 or not (loadstring or load)(configured,"update") then
        error("Could not configure local updater")
    end
    writeFile("update.new",configured)
    if fs.exists("update") then fs.delete("update") end
    fs.move("update.new","update")
    print("Installed local update for "..(role=="manager" and "Regional Manager" or "Master Foreman"))
    print("Remove the disk, then run update")
    return
end

if not role then error("Local update has no role; run disk/update first") end
if not turtle or not turtle.forward then error("Update requires a wireless turtle") end

local files={"startup","common","prep",role=="manager" and "manager" or "foreman","update"}
local staged={}
local version=fetch("version"):match("^%s*(%d+)%s*$")
if not version or tonumber(version)<MIN_VERSION then
    error("Remote version must be "..MIN_VERSION.." or later; files were not erased")
end
for _,name in ipairs(files) do staged[name]=fetch(name) end
if staged.common:match("^%s*VERSION%s*=%s*(%d+)")~=version then
    error("Common/version mismatch; files were not erased")
end

local regional=role=="manager" and "1" or "0"
local master=role=="master" and "1" or "0"
local regionalCount,masterCount
staged.startup,regionalCount=staged.startup:gsub(
    "local%s+REGIONAL_MANAGER%s*=%s*%d+","local REGIONAL_MANAGER = "..regional,1)
staged.startup,masterCount=staged.startup:gsub(
    "local%s+MASTER_FOREMAN%s*=%s*%d+","local MASTER_FOREMAN = "..master,1)
if regionalCount~=1 or masterCount~=1 then
    error("Startup role flags missing; files were not erased")
end

local configured,count=staged.update:gsub('^local ROLE%s*=%s*"[^"]+"',
    'local ROLE = "'..role..'"',1)
if count~=1 then error("Remote update role setting missing; files were not erased") end
staged.update=configured

local compile=loadstring or load
if compile then
    for _,name in ipairs(files) do
        if not compile(staged[name],name) then
            error("Invalid "..name.."; files were not erased")
        end
    end
end
if fetch("version"):match("^%s*(%d+)%s*$")~=version then
    error("Remote version changed; files were not erased")
end

local anchor
if role=="master" then
    local raw=readFile("world_anchor")
    if raw then
        local ok,value=pcall(textutils.unserialize,raw)
        if ok and type(value)=="table" and type(value.x)=="number" and
            type(value.y)=="number" and type(value.z)=="number" then
            anchor=value
            print("Keeping world origin "..anchor.x..", "..anchor.y..", "..anchor.z)
        end
    end
    if not anchor then
        anchor={}
        print("Enter the Master Foreman's Minecraft coordinates")
        for _,axis in ipairs({"x","y","z"}) do
            while true do
                term.write(axis:upper()..": ")
                local value=tonumber(read())
                if value and value==math.floor(value) then
                    anchor[axis]=value
                    break
                end
                print("Enter a whole-number coordinate")
            end
        end
    end
end

for _,name in ipairs(fs.list("")) do
    local drive=fs.getDrive and fs.getDrive(name) or "hdd"
    if drive=="hdd" and not fs.isReadOnly(name) then fs.delete(name) end
end

for _,name in ipairs(files) do writeFile(name,staged[name]) end
writeFile("version",version.."\n")
if anchor then writeFile("world_anchor",textutils.serialize(anchor)) end
os.setComputerLabel(role=="manager" and "Regional Manager" or "Foreman-1")
print("Installed version "..version.." for "..(role=="manager" and "Regional Manager" or "Master Foreman"))
os.reboot()

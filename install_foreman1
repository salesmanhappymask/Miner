local url="https://raw.githubusercontent.com/salesmanhappymask/Miner/main/setup"
if not fs.exists("setup") then
    local response=http.get(url)
    if not response then error("Could not download setup") end
    local body=response.readAll()
    response.close()
    if not body or not (loadstring or load)(body,"setup") then
        error("Invalid setup download")
    end
    local file=assert(fs.open("setup","w"))
    file.write(body)
    file.close()
end
print("Select 2 in setup for Master Foreman")
shell.run("setup")

local RAW="https://raw.githubusercontent.com/salesmanhappymask/Miner/main/"

if not turtle or not turtle.forward then
    error("Run install_foreman1 on the Master Foreman turtle")
end

local function fetch(name)
    local response=http.get(RAW..name)
    if not response then error("Could not download "..name) end
    local body=response.readAll()
    response.close()
    if not body or body=="" then error("Empty "..name) end
    return body
end

local names={"startup","common","bootstrap","foreman","updater","version"}
local staged={}
for _,name in ipairs(names) do staged[name]=fetch(name) end
local remoteVersion=staged.version:gsub("%s+$","")
if not tonumber(remoteVersion) or tonumber(remoteVersion)<64 then
    error("Remote version is older than 64; no files changed")
end
staged.startup=staged.startup:gsub("local%s+REGIONAL_MANAGER%s*=%s*%d+",
    "local REGIONAL_MANAGER = 0",1)
staged.startup=staged.startup:gsub("local%s+MASTER_FOREMAN%s*=%s*%d+",
    "local MASTER_FOREMAN = 1",1)
local compile=loadstring or load
for _,name in ipairs({"startup","common","bootstrap","foreman","updater"}) do
    if compile and not compile(staged[name],name) then error("Downloaded "..name.." has invalid Lua") end
end
if not staged.startup:find("local REGIONAL_MANAGER = 0",1,true) or
    not staged.startup:find("local MASTER_FOREMAN = 1",1,true) then
    error("Startup role flags unavailable")
end
for _,name in ipairs(names) do
    local f=fs.open(name..".new","w")
    if not f then error("Could not stage "..name) end
    f.write(staged[name])
    f.close()
end
for _,name in ipairs(names) do
    if fs.exists(name) then fs.delete(name) end
    fs.move(name..".new",name)
end
os.setComputerLabel("Foreman-1")
local ok=shell.run("updater")
if not ok then error("Updater failed; downloaded files are present") end
local bootstrapFile=fs.open("bootstrap","w")
if not bootstrapFile then error("Could not restore local bootstrap") end
bootstrapFile.write(staged.bootstrap)
bootstrapFile.close()
os.reboot()

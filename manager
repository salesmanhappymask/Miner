    local function drawActions(surface,w,h,buttons,terminal)
        local labels=actions
        if data.minerSetupConfirm then
            labels={{key="y",label="YES, SET UP MINERS"},{key="n",label="NO, WAIT"}}
        end
        local cols=3
        local rows=math.ceil(#labels/cols)
        if #labels==2 then cols=2;rows=1 end
        local width=math.floor(w/cols)
        for i,item in ipairs(labels) do
            local col=(i-1)%cols
            local row=math.floor((i-1)/cols)
            local x=col*width+1
            local ww=col==cols-1 and w-x+1 or width
            local y=h-rows+row+1
            local bg=IS_COLOR and (item.key=="6" and colors.orange or
                item.key=="3" and colors.red or colors.blue) or colors.black
            if terminal then
                surface.setBackgroundColor(bg)
                surface.setTextColor(colors.white)
                surface.setCursorPos(x,y)
                surface.write(string.rep(" ",ww))
                surface.setCursorPos(x+1,y)
                surface.write(("["..item.key.."] "..item.label):sub(1,ww-2))
            else
                ui.rect(x,y,ww,1,bg)
                ui.field("btn"..i,x+1,y,ww-2,"["..item.key.."] "..item.label,C_TEXT,bg)
            end
            buttons[#buttons+1]={x=x,y=y,w=ww,key=item.key}
        end
    end

    local function recallLine()
        if data.advance then return "NEXT CHUNK "..tostring(data.advance.target)..
            "  |  "..tostring(data.advance.phase).."  |  "..tostring(data.advance.error or "Working") end
        if not data.recall.mode then
            if not data.swarmStarted then
                if not data.gpsReady then return "START WAIT: GPS hosts not ready" end
                if not chunkLoadersReady() then return "START WAIT: Navigator Chunk Loaders not ready" end
                if not data.minerSetupApproved then return "START WAIT: miner setup approval" end
                for n=1,4 do
                    local f=data.foremen[n]
                    if not f or not f.setupDone then
                        return "START WAIT: Foreman-"..tostring(n)..
                            " setup "..tostring(f and f.state or "offline")
                    end
                end
                for row=1,16 do
                    if not data.miners[row] or not data.miners[row].id then
                        return "START WAIT: Miner-"..tostring(row).." registration"
                    end
                end
                return "START WAIT: master commissioning confirmation"
            end
            local completed=0
            for row=1,16 do
                if data.miners[row] and (data.miners[row].state=="COMPLETE" or data.miners[row].complete==true) then
                    completed=completed+1
                end
            end
            if completed==16 and not turtle then
                return "All miners complete | Mobile RM turtle required for next chunk"
            end
            return "Chunk "..tostring(data.chunkIndex+1).."  |  "..
                tostring(completed).."/16 miners complete"..
                (chunkBlockReason and ("  |  Waiting: "..chunkBlockReason) or "")
        end
        local r=data.recall
        local mh,fh,nh,empty,tm,tf,tn=0,0,0,0,0,0,0
        for row in pairs(r.targets.miners or {}) do
            tm=tm+1
            if r.homeMiners[row] then mh=mh+1 end
            if r.emptied[row] then empty=empty+1 end
        end
        for n in pairs(r.targets.foremen or {}) do
            tf=tf+1
            if r.homeForemen[n] then fh=fh+1 end
        end
        for n in pairs(r.targets.navigators or {}) do
            tn=tn+1
            if r.homeNavigators[n] then nh=nh+1 end
        end
        local line=string.format("%s  M %d/%d  F %d/%d  GPS %d/%d  Empty %d/%d",
            tostring(r.state),mh,tm,fh,tf,nh,tn,empty,tm)
        if r.loaderRequired and r.loaderPhase and r.loaderPhase~="DONE" then
            line=line.."  Loader:"..tostring(r.loaderPhase)
            if r.loaderError then line=line.." STOP:"..tostring(r.loaderError) end
        end
        if r.mode=="PACK" then
            local m=data.miners[16]
            local collected=tonumber(r.packCollected) or (m and m.state=="PACK_COLLECT" and WORKER_COUNT-(tonumber(m.x) or WORKER_COUNT)) or 0
            line=line..string.format("  Packed %d/"..tostring(WORKER_COUNT-1).."  M16 x=%s",collected,tostring(m and m.x or "?"))
            if r.packMissing and #r.packMissing>0 then
                line=line.."  Missing items: "..table.concat(r.packMissing,",")
            end
            if r.packError then
                line=line.."  STOP: "..tostring(r.packError)
            end
        end
        return line
    end

    local function clusterInfo(n)
        local f=data.foremen[n]
        local nav=data.navigators[n]
        local job=data.foremanJobs[n]
        local fs=f and tostring(f.state or "?") or "NO SIGNAL"
        local gps=nav and (online(nav,20) and
            (nav.gpsHost==true and "HOSTING" or tostring(nav.state or "ONLINE")) or
            "OFFLINE") or "NO SIGNAL"
        if nav and (n==1 or n==3) then
            gps=gps..(nav.loaderPlaced==true and " LDR:ON" or " LDR:OFF")
        end
        local foremanPos=f and string.format("%s,%s,%s",tostring(f.x or "?"),
            tostring(f.y or "?"),tostring(f.z or "?")) or "?"
        local gpsPos=nav and string.format("%s,%s,%s",tostring(nav.x or "?"),
            tostring(nav.y or "?"),tostring(nav.z or "?")) or "?"
        local task=job and ("M"..tostring(job.row or "?").." "..tostring(job.service or "")) or "Idle"
        return fs,gps,foremanPos,gpsPos,task
    end

    local function minerLine(row)
        local m=data.miners[row]
        if not m then return string.format("M%02d   NO SIGNAL",row),C_FAULT end
        local c=online(m,20) and C_TEXT or C_FAULT
        if m.state=="RECOVERY_LOCK" then c=C_FAULT end
        local task=""
        for _,r in pairs(data.requests) do
            if r.row==row and r.status~="COMPLETE" then
                task=tostring(r.service or "").." "..tostring(r.status or "")
                if r.status=="BLOCKED" then c=C_FAULT else c=C_WARN end
                break
            end
        end
        return string.format("M%02d   %-18s %s",row,tostring(m.state or "?"):sub(1,18),task),c
    end

    local function observerSnapshot()
        local pending,activeJobs,blocked=countRequests()
        local gpsCount=refreshGpsReady()
        local clusters={}
        for n=1,4 do
            local fs,gps,foremanPos,gpsPos,task=clusterInfo(n)
            local miners={}
            for k=1,4 do
                local row=(n-1)*4+k
                local m=data.miners[row]
                miners[k]={
                    row=row,
                    state=m and tostring(m.state or "?") or "NO SIGNAL",
                    online=m and online(m,20) or false,
                    message=m and tostring(m.message or "") or "",
                    recovery=m and tostring(m.recovery or "") or "",
                    fuel=m and m.fuel or nil
                }
            end
            local f=data.foremen[n]
            clusters[n]={
                foremanState=fs,
                foremanOnline=f and online(f,20) or false,
                foremanPos=foremanPos,
                gpsState=gps,
                gpsPos=gpsPos,
                loaderPlaced=nav and nav.loaderPlaced==true or false,
                loaderOwned=nav and nav.loaderOwned==true or false,
                task=task,
                detail=f and tostring(f.recovery or f.message or f.setupMissing or "") or "",
                miners=miners
            }
        end
        return {
            type="monitor_snapshot",
            version=VERSION,
            managerId=managerId,
            masterForemanId=data.masterForemanId,
            paired=data.paired,
            gpsCount=gpsCount,
            nodeCount=countTable(data.nodes),
            pending=pending,
            active=activeJobs,
            blocked=blocked,
            radioRx=radioRxRate,
            radioTx=radioTxRate,
            statusLine=recallLine(),
            chunkBlockReason=chunkBlockReason,
            recallState=data.recall and data.recall.state or "NORMAL",
            chunkIndex=data.chunkIndex,
            clusters=clusters,
            session=data.session
        }
    end

    local function sendObserverSnapshot(force)
        if not force and now()-lastObserverSend<1 then return end
        rednet.broadcast(observerSnapshot(),OBSERVER_PROTOCOL)
        lastObserverSend=now()
    end


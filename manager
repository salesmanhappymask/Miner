            (chunkBlockReason and not data.recall.mode and
                ("NEXT CHUNK WAIT: "..chunkBlockReason) or recallLine())),
            warning and C_WARN or C_SUBTXT,C_INSET)
        local gridTop=8
        local gridBottom=h-4
        local total=gridBottom-gridTop+1
        local cardH=math.floor(total/2)
        local widths={math.floor(w/2),w-math.floor(w/2)}
        for n=1,4 do
            local col=(n-1)%2
            local row=math.floor((n-1)/2)
            local x=col==0 and 1 or widths[1]+1
            local y=gridTop+row*cardH
            local ww=widths[col+1]
            local hh=row==0 and cardH or gridBottom-y+1
            if hh>=4 and ww>=14 then
                cardSurface(x,y,ww,hh,C_ACCENT)
                local fs,gps,foremanPos,gpsPos,task=clusterInfo(n)
                ui.field("cluster"..n,x+3,y+1,ww-5,
                    string.format("FOREMAN %d  %s  @ %s",n,fs,foremanPos),
                    online(data.foremen[n],20) and C_ACCENT or C_FAULT,C_INSET)
                ui.field("gps"..n,x+3,y+2,ww-5,"GPS "..n.." "..gps.."  @ "..gpsPos,C_MUTED,C_INSET)
                if hh>=7 then ui.field("job"..n,x+3,y+3,ww-5,"JOB  "..task,C_SUBTXT,C_INSET) end
                local start=y+(hh>=7 and 5 or 4)
                for k=1,4 do
                    local yy=start+k-1
                    if yy<y+hh-1 then
                        local line,color=minerLine((n-1)*4+k)
                        ui.field("clusterMiner"..n.."_"..k,x+3,yy,ww-5,line,color,C_INSET)
                    end
                end
                if hh>=12 then
                    local f=data.foremen[n]
                    local message=nil
                    local detailColor=C_WARN
                    for k=1,4 do
                        local minerRow=(n-1)*4+k
                        local m=data.miners[minerRow]
                        if m and (m.recovery or m.state=="RECOVERY_LOCK") then
                            message="M"..string.format("%02d",minerRow)..": "..
                                tostring(m.recovery or m.message or "Recovery lock")
                            detailColor=C_FAULT
                            break
                        end
                    end
                    if not message then
                        message=f and (f.recovery or f.message or f.setupMissing)
                    end
                    if message and message~="" then
                        ui.field("detail"..n,x+3,y+hh-3,ww-5,tostring(message),detailColor,C_INSET)
                    end
                end
            end
        end
        local m16=data.miners[WORKER_COUNT]
        local errorText=data.recall.packError or
            (m16 and (m16.packError or m16.recovery or (m16.state=="RECOVERY_LOCK" and m16.message)))
        local missing=data.recall.packMissing
        local footer=errorText and ("PACK STOP: "..tostring(errorText)) or
            (missing and #missing>0 and ("MISSING MINER ITEMS: "..table.concat(missing,",")) or recallLine())
        ui.field("footer",2,h-3,w-2,footer,
            errorText and C_FAULT or missing and #missing>0 and C_WARN or C_SUBTXT,C_BG)
        monitorButtons={}
        drawActions(mon,w,h,monitorButtons,false)
    end


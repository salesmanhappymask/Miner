        line(1,"ZelOS  MANAGER  v"..VERSION.."    "..tostring(data.recall.state),C_ACCENT)
        line(2,string.format("GPS %d/4  Nodes %d/24  RX %.1f TX %.1f/s",
            refreshGpsReady(),countTable(data.nodes),radioRxRate,radioTxRate),C_MUTED)
        line(3,recallLine(),C_WARN)
        local row=4
        for n=1,4 do
            local fs,gps,foremanPos,gpsPos,task=clusterInfo(n)
            line(row,string.format("F%d %-15s GPS %-12s %s",n,fs:sub(1,15),gps:sub(1,12),task),
                online(data.foremen[n],20) and C_ACCENT or C_FAULT)
            row=row+1
            if h>=17 then
                local parts={}
                for k=1,4 do
                    local id=(n-1)*4+k
                    local m=data.miners[id]
                    parts[#parts+1]=string.format("%02d:%-8s",id,tostring(m and m.state or "OFFLINE"):sub(1,8))
                end
                line(row,table.concat(parts," "),C_MUTED)
                row=row+1
            end
        end
        for n=1,4 do
            local f=data.foremen[n]
            if f and (f.setupMissing or (f.setupDone==false and f.message and f.message~="")) then
                line(row,"F"..n..": "..tostring(f.setupMissing or f.message),C_WARN)
                row=row+1
            end
        end
        local m16=data.miners[WORKER_COUNT]
        local packError=data.recall.packError or (m16 and (m16.packError or m16.recovery))
        if packError then line(row,"PACK STOP: "..tostring(packError),C_FAULT);row=row+1 end
        if data.recall.packMissing and #data.recall.packMissing>0 then
            line(row,"MISSING MINER ITEMS: "..table.concat(data.recall.packMissing,","),C_WARN)
        end
        if data.minerSetupConfirm then
            line(h-4,"Confirm miner setup: Y / N",C_WARN)
        elseif chunkBlockReason and not data.recall.mode then
            line(h-4,"NEXT CHUNK WAIT: "..chunkBlockReason,C_WARN)
        end
        line(h-3,"Command: "..input,C_TEXT)
        terminalButtons={}
        drawActions(term,w,h,terminalButtons,true)
    end


        term.setBackgroundColor(colors.black)
        term.setTextColor(colors.white)
        term.clear()
        term.setCursorPos(1,1)
        print("ZelOS Regional Manager")
        print("")
        print("1 = Recall")
        print("2 = Dump & Recall")
        print("3 = Shutdown Recall")
        print("4 = Resume")
        if foremenReadyForMinerSetup() then
            print("5 = Begin Miner Setup")
        end
        print("")
        if data.minerSetupConfirm and foremenReadyForMinerSetup() then
            print("Begin miner setup? Y/N")
        end
        print("State: " .. tostring(data.recall.state or "NORMAL"))

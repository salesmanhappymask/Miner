local function runRegionalManager()
    while not openNetwork() do
        term.setBackgroundColor(colors.black)
        term.setTextColor(colors.white)
        term.clear()
        term.setCursorPos(1,1)
        print("Regional Manager waiting for wireless modem...")
        sleep(1)
    end

    while peripheral.getType("right")~="monitor" do
        term.setBackgroundColor(colors.black)
        term.setTextColor(colors.white)
        term.clear()
        term.setCursorPos(1,1)
        print("Regional Manager waiting for monitor on RIGHT...")
        sleep(1)
    end

    local managerId=os.getComputerID()
    setRegionalManager(managerId)
    pcall(rednet.unhost,PROTOCOL)
    pcall(rednet.host,PROTOCOL,"regional_manager")

    local mon=peripheral.wrap("right")
    mon.setTextScale(0.5)

    local data=loadTableLight("regional_manager.tmp")

    if not data or data.version~=VERSION then
        data={
            version=VERSION,
            managerId=managerId,
            session=nil,
            masterForemanId=nil,
            paired=false,
            nodes={},
            foremen={},
            miners={},
            navigators={},
            authority={},
            requests={},
            foremanJobs={},
            commissioningComplete=false,
            swarmStarted=false,
            gpsReady=false,
            minerSetupApproved=false,
            minerSetupDeclined=false,
            minerSetupGateRequested=false,
            minerSetupConfirm=false,
            recall={
                state="NORMAL",
                mode=nil,
                active=false,
                homeMiners={},
                homeForemen={},
                homeNavigators={},
                emptied={},
                shutdown={},
                targets={miners={},foremen={},navigators={}}
            }
        }
        saveTableLight("regional_manager.tmp",data)
    end

    data.managerId=managerId
    data.nodes=data.nodes or {}
    data.foremen=data.foremen or {}
    data.miners=data.miners or {}
    data.navigators=data.navigators or {}
    data.gpsReady=data.gpsReady and true or false
    data.minerSetupApproved=data.minerSetupApproved and true or false
    data.minerSetupDeclined=data.minerSetupDeclined and true or false
    data.minerSetupGateRequested=data.minerSetupGateRequested and true or false
    data.minerSetupConfirm=data.minerSetupConfirm and true or false
    data.authority=data.authority or {}
    data.requests=data.requests or {}
    data.foremanJobs=data.foremanJobs or {}
    data.commissioningComplete=data.commissioningComplete and true or false
    data.swarmStarted=data.swarmStarted and true or false
    data.recall=data.recall or {
        state="NORMAL",
        mode=nil,
        active=false,
        homeMiners={},
        homeForemen={},
        homeNavigators={},
        emptied={},
        shutdown={},
        targets={miners={},foremen={},navigators={}}
    }
    data.recall.homeMiners=data.recall.homeMiners or {}
    data.recall.homeForemen=data.recall.homeForemen or {}
    data.recall.homeNavigators=data.recall.homeNavigators or {}
    data.recall.emptied=data.recall.emptied or {}
    data.recall.shutdown=data.recall.shutdown or {}
    data.recall.targets=data.recall.targets or {miners={},foremen={},navigators={}}
    data.recall.targets.miners=data.recall.targets.miners or {}
    data.recall.targets.foremen=data.recall.targets.foremen or {}
    data.recall.targets.navigators=data.recall.targets.navigators or {}

    for _,registry in ipairs({data.nodes,data.foremen,data.miners,data.navigators}) do
        for _,entry in pairs(registry) do
            if type(entry)=="table" then
                entry.lastSeen=-1000000
            end
        end
    end

    local bootNow=now()
    for _,request in pairs(data.requests) do
        if type(request)=="table" then
            request.created=bootNow
            request.updated=bootNow
            request.retryAfter=0
            if request.status=="COMPLETE" then
                request.completed=bootNow
                request.lastCompletionSend=0
            end
        end
    end
    for _,job in pairs(data.foremanJobs) do
        if type(job)=="table" then
            job.assigned=bootNow
            job.lastSend=nil
        end
    end

    local pairNonce=tostring(managerId) .. ":" .. tostring(os.time()) .. ":" .. tostring(math.random(100000,999999))
    local managerBootTime=now()
    local masterLastSeen=nil
    local pairStatus="Waiting for Master Foreman"
    local input=""
    local lastQuery=0
    local lastPair=0
    local lastRecall=0
    local lastDispatch=0
    local resumeUntil=0
    local lastResumeSend=0
    local managerDirty=false
    local lastManagerFlush=0

    local function save()
        managerDirty=true
    end

    local function flushManager(force)
        if managerDirty and (force or now()-lastManagerFlush>=2) then
            saveTableLight("regional_manager.tmp",data)
            managerDirty=false
            lastManagerFlush=now()
        end
    end

    local IS_COLOR=mon.isColor and mon.isColor() or false
    local C_BG=colors.black
    local C_HEADER=IS_COLOR and colors.lightGray or colors.black
    local C_DIV=IS_COLOR and colors.gray or colors.black
    local C_INSET=colors.black
    local C_ACCENT=IS_COLOR and colors.cyan or colors.white
    local C_TEXT=colors.white
    local C_MUTED=IS_COLOR and colors.lightGray or colors.white
    local C_BRAND=IS_COLOR and colors.blue or colors.white
    local C_SUBTXT=IS_COLOR and colors.blue or colors.white
    local C_FAULT=IS_COLOR and colors.red or colors.white
    local C_WARN=IS_COLOR and colors.orange or colors.white
    local C_OK=IS_COLOR and colors.lime or colors.white

    local function clamp(n,a,b)
        if n<a then return a elseif n>b then return b else return n end
    end

    local function makeUI(m)
        local w,h=m.getSize()
        local cache={}

        local function setBg(bg)
            if IS_COLOR then m.setBackgroundColor(bg) else m.setBackgroundColor(colors.black) end
        end

        local function setFg(fg)
            if IS_COLOR then m.setTextColor(fg) else m.setTextColor(colors.white) end
        end

        local function rect(x,y,ww,hh,bg)
            if ww<=0 or hh<=0 then return end
            local x1=clamp(x,1,w)
            local y1=clamp(y,1,h)
            local x2=clamp(x+ww-1,1,w)
            local y2=clamp(y+hh-1,1,h)
            if x2<x1 or y2<y1 then return end
            setBg(bg)
            local line=string.rep(" ",x2-x1+1)
            for yy=y1,y2 do
                m.setCursorPos(x1,yy)
                m.write(line)
            end
        end

        local function field(key,x,y,ww,s,fg,bg)
            if ww<=0 or y<1 or y>h then return end
            s=tostring(s or "")
            if #s>ww then s=s:sub(1,ww) end
            local out=s .. string.rep(" ",ww-#s)
            local k1,k2,k3=key.."_out",key.."_fg",key.."_bg"
            if cache[k1]==out and cache[k2]==fg and cache[k3]==bg then return end
            setBg(bg or colors.black)
            setFg(fg or colors.white)
            m.setCursorPos(x,y)
            m.write(out)
            cache[k1],cache[k2],cache[k3]=out,fg,bg
        end

        local function clearAll()
            setBg(C_BG)
            setFg(C_TEXT)
            m.clear()
            cache={}
        end

        return {w=w,h=h,rect=rect,field=field,clearAll=clearAll}
    end

    local ui=makeUI(mon)

    local function cardSurface(x,y,ww,hh,accentColor)
        ui.rect(x,y,ww,hh,C_BG)
        ui.rect(x,y,ww,1,C_DIV)
        ui.rect(x,y+hh-1,ww,1,C_DIV)
        ui.rect(x,y,1,hh,C_DIV)
        ui.rect(x+ww-1,y,1,hh,C_DIV)
        ui.rect(x+1,y+1,ww-2,hh-2,C_INSET)
        ui.rect(x+1,y+1,1,hh-2,accentColor or C_ACCENT)
    end

    local function drawHeader(title)
        local w=ui.w
        ui.rect(1,1,w,1,C_HEADER)
        ui.rect(1,2,w,1,C_DIV)
        local brand="ZelOS"
        ui.field("hdr_brand",w-#brand+1,1,#brand,brand,C_BRAND,C_HEADER)
        local tx=1+math.floor((w-#title)/2)
        ui.field("hdr_title",tx,1,#title,title,C_TEXT,C_HEADER)
    end

    local function online(entry,limit)
        return entry and now()-(entry.lastSeen or 0)<(limit or 15)
    end

    local function countTable(t)
        local n=0
        for _ in pairs(t or {}) do n=n+1 end
        return n
    end

    local function countRequests()
        local pending,active,blocked=0,0,0
        for _,r in pairs(data.requests) do
            if r.status=="ASSIGNED" or r.status=="IN_PROGRESS" then
                active=active+1
            elseif r.status=="BLOCKED" then
                blocked=blocked+1
            elseif r.status~="COMPLETE" then
                pending=pending+1
            end
        end
        return pending,active,blocked
    end

    local monitorInitialized=false

    local function refreshGpsReady()
        local ready=0

        for n=1,NAVIGATOR_COUNT do
            local nav=data.navigators[n]
            local site=NAVIGATOR_SITES[n]

            if nav and site and nav.gpsHost==true and online(nav,15) and
                tonumber(nav.x)==site.x and tonumber(nav.y)==site.y and tonumber(nav.z)==site.z then
                ready=ready+1
            end
        end

        data.gpsReady=ready==NAVIGATOR_COUNT
        return ready
    end

    local function foremenReadyForMinerSetup()
        if not data.gpsReady or not data.minerSetupGateRequested or data.minerSetupApproved then
            return false
        end

        for n=1,4 do
            local f=data.foremen[n]
            if not f or not online(f,20) then
                return false
            end
        end

        local f1=data.foremen[1]
        if not f1 or f1.state~="WAITING_MINER_APPROVAL" then
            return false
        end

        for n=2,4 do
            local f=data.foremen[n]
            if not f or (f.state~="WAITING_SETUP" and f.state~="IDLE") then
                return false
            end
        end

        return true
    end

    local function drawMonitor()
        local w,h=ui.w,ui.h

        local overviewY=3
        local overviewH=6

        if not monitorInitialized then
            ui.clearAll()
            drawHeader("Regional Manager")
            cardSurface(1,overviewY,w,overviewH,C_ACCENT)
        end

        local pending,activeJobs,blocked=countRequests()
        local pairText=data.paired and ("Manager " .. tostring(managerId) .. " / Master " .. tostring(data.masterForemanId or "?")) or "Waiting for Master Foreman pairing"
        local stateText=data.recall.state or "NORMAL"

        ui.field("ov_pair",3,overviewY+1,w-4,pairText,data.paired and C_TEXT or C_WARN,C_INSET)
        ui.field("ov_state",3,overviewY+2,w-4,"State: " .. stateText,C_SUBTXT,C_INSET)
        ui.field("ov_jobs",3,overviewY+3,w-4,string.format("Jobs P:%d A:%d B:%d  Nodes:%d/24",pending,activeJobs,blocked,countTable(data.nodes)),blocked>0 and C_WARN or C_MUTED,C_INSET)

        local gpsCount=refreshGpsReady()
        local gpsText
        local gpsColor=C_WARN

        if data.gpsReady then
            if data.minerSetupApproved then
                gpsText="GPS 4/4 READY | Miner setup APPROVED"
                gpsColor=C_OK
            elseif foremenReadyForMinerSetup() then
                gpsText="GPS 4/4 READY | Miner setup available: option 5"
                gpsColor=C_OK
            else
                gpsText="GPS 4/4 READY | Waiting for Foremen"
            end
        else
            gpsText="GPS " .. tostring(gpsCount) .. "/4 | Waiting for Navigators"
        end

        ui.field("ov_gps",3,overviewY+4,w-4,gpsText,gpsColor,C_INSET)

        local foreY=overviewY+overviewH
        local foreH=7

        if not monitorInitialized then
            cardSurface(1,foreY,w,foreH,C_ACCENT)
            ui.field("fore_title",3,foreY+1,w-4,"FOREMEN",C_SUBTXT,C_INSET)
        end

        for n=1,4 do
            local f=data.foremen[n]
            local line
            local c=C_TEXT

            if f then
                local job=data.foremanJobs[n]
                line=string.format("F%d %-11s @%s,%s,%s %s",n,tostring(f.state or "?"),tostring(f.x or "?"),tostring(f.y or "?"),tostring(f.z or "?"),job and ("M"..tostring(job.row or "?").." "..tostring(job.service or "")) or "IDLE")
                if not online(f,15) or f.state=="RECOVERY_LOCK" or f.state=="ERROR" then
                    c=C_FAULT
                elseif job then
                    c=C_WARN
                end
            else
                line="F" .. tostring(n) .. " NO SIGNAL"
                c=C_FAULT
            end

            ui.field("fore_"..n,3,foreY+1+n,w-4,line,c,C_INSET)
        end

        local minersY=foreY+foreH
        local minersH=h-minersY+1
        if minersH<8 then minersH=8 end

        if not monitorInitialized then
            cardSurface(1,minersY,w,minersH,C_ACCENT)
            ui.field("miners_title",3,minersY+1,w-4,"MINERS",C_SUBTXT,C_INSET)
        end

        local cols=4
        local colW=math.floor((w-5)/cols)
        if colW<10 then
            cols=2
            colW=math.floor((w-4)/2)
        end

        for row=1,16 do
            local col=(row-1)%cols
            local rr=math.floor((row-1)/cols)
            local x=3+col*colW
            local y=minersY+2+rr
            local m=data.miners[row]
            local line
            local c=C_TEXT

            if m then
                local rq=nil
                for _,r in pairs(data.requests) do
                    if r.row==row and r.status~="COMPLETE" then
                        rq=r
                        break
                    end
                end
                line=string.format("%02d %-7s %s",row,tostring(m.state or "?"):sub(1,7),rq and tostring(rq.service or "") or "")
                if not online(m,20) or m.state=="RECOVERY_LOCK" then
                    c=C_FAULT
                elseif rq then
                    c=rq.status=="BLOCKED" and C_FAULT or C_WARN
                elseif m.state=="RECALLED_PAUSED" or m.state=="HOME" then
                    c=C_OK
                end
            else
                line=string.format("%02d OFFLINE",row)
                c=C_FAULT
            end

            ui.field("miner_"..row,x,y,colW-1,line,c,C_INSET)
        end

        local bottom=h-1
        if data.recall.mode then
            local mh,fh,nh,empty,tm,tf,tn=0,0,0,0,0,0,0
            local targets=data.recall.targets or {miners={},foremen={},navigators={}}
            for row in pairs(targets.miners or {}) do
                tm=tm+1
                if data.recall.homeMiners[row] then mh=mh+1 end
                if data.recall.emptied[row] then empty=empty+1 end
            end
            for n in pairs(targets.foremen or {}) do
                tf=tf+1
                if data.recall.homeForemen[n] then fh=fh+1 end
            end
            for n in pairs(targets.navigators or {}) do
                tn=tn+1
                if data.recall.homeNavigators and data.recall.homeNavigators[n] then nh=nh+1 end
            end
            ui.field("recall_status",3,bottom,w-4,string.format("%s M:%d/%d F:%d/%d N:%d/%d E:%d/%d",tostring(data.recall.mode),mh,tm,fh,tf,nh,tn,empty,tm),C_WARN,C_INSET)
        else
            ui.field("recall_status",3,bottom,w-4,"",C_MUTED,C_INSET)
        end

        monitorInitialized=true
    end


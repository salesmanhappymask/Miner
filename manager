local SEED_PROTOCOL="miner_swarm_seed_v121"

local function runManagerSeedBootstrap()
    local seed=loadTable("manager_seed.cfg")
    if type(seed)=="table" and seed.complete==true then
        return seed
    end

    seed=type(seed)=="table" and seed or {
        version=VERSION,
        phase="START",
        x=0,
        y=0,
        z=-1,
        dir=DIR_N,
        worldOrigin={x=0,y=0,z=0}
    }
    seed.version=VERSION
    seed.worldOrigin=seed.worldOrigin or {x=0,y=0,z=0}
    seed.x=tonumber(seed.x) or 0
    seed.y=tonumber(seed.y) or 0
    seed.z=tonumber(seed.z) or -1
    seed.dir=tonumber(seed.dir) or DIR_N

    local function saveSeed()
        if not saveTable("manager_seed.cfg",seed) then
            error("Could not save Regional Manager seed state")
        end
    end

    local function show(message)
        term.setBackgroundColor(colors.black)
        term.setTextColor(colors.white)
        term.clear()
        term.setCursorPos(1,1)
        print("Regional Manager Seed")
        print("v"..tostring(VERSION))
        print("")
        print(message)
        print("")
        print("Phase: "..tostring(seed.phase))
    end

    local function firstEmptySlot()
        for slot=1,16 do
            if turtle.getItemCount(slot)==0 then return slot end
        end
        return nil
    end

    local function frontCount(kind)
        local items=scanInventory("front")
        if type(items)~="table" then return 0 end
        local total=0
        for _,item in pairs(items) do
            if matchesItem(item,kind) then
                total=total+tonumber(item.qty or item.size or 1)
            end
        end
        return total
    end

    local function pullOne(kind)
        local slot=firstEmptySlot()
        if not slot then return nil end
        if takeNamedFromFront(kind,1,slot)<1 then return nil end
        return slot
    end

    local function runLocalProgram(path,...)
        local chunk,loadErr=loadfile(path)
        if not chunk then return false,tostring(loadErr or "load failed") end
        local ok,result=pcall(chunk,...)
        if not ok then return false,tostring(result or "runtime failed") end
        if result==false then return false,"program returned false" end
        return true,result
    end

    local function openSeedNetwork()
        for _,side in ipairs(SIDES) do
            if peripheral.getType(side)=="modem" then
                if not rednet.isOpen(side) then rednet.open(side) end
                return true
            end
        end
        return false
    end

    local function turnRightSeed()
        if not turtle.turnRight() then return false end
        seed.dir=(seed.dir+1)%4
        saveSeed()
        return true
    end

    local function faceSeed(target)
        target=target%4
        while seed.dir~=target do
            if not turnRightSeed() then return false end
        end
        return true
    end

    local function clearSeedFront()
        for attempt=1,20 do
            if not turtle.detect() then
                local attacked=turtle.attack()
                if not attacked then return true end
            else
                local kind=peripheral.getType("front")
                if kind then
                    return false,"Path occupied by peripheral "..tostring(kind)
                end
                local ok,reason=turtle.dig()
                if not ok then return false,tostring(reason or "dig failed") end
            end
            sleep(0.1)
            if not turtle.detect() then return true end
        end
        return false,"Path remained blocked"
    end

    local function forwardSeed()
        for attempt=1,20 do
            local ok=turtle.forward()
            if ok then
                if seed.dir==DIR_N then seed.z=seed.z+1
                elseif seed.dir==DIR_E then seed.x=seed.x+1
                elseif seed.dir==DIR_S then seed.z=seed.z-1
                else seed.x=seed.x-1 end
                saveSeed()
                return true
            end
            local cleared,reason=clearSeedFront()
            if not cleared then return false,reason end
            sleep(0.1)
        end
        return false,"Regional Manager movement remained blocked"
    end

    local function moveSeedTo(tx,tz)
        while seed.x<tx do if not faceSeed(DIR_E) or not forwardSeed() then return false end end
        while seed.x>tx do if not faceSeed(DIR_W) or not forwardSeed() then return false end end
        while seed.z<tz do if not faceSeed(DIR_N) or not forwardSeed() then return false end end
        while seed.z>tz do if not faceSeed(DIR_S) or not forwardSeed() then return false end end
        return true
    end

    local function frontInventorySize()
        local inv=wrapInventory("front")
        if not inv then return nil end
        local ok,size=pcall(inv.getInventorySize)
        if not ok then return nil end
        return tonumber(size)
    end

    local function supplyChestPresent()
        local size=frontInventorySize()
        return size and size>16
    end

    local function waitSupplyChest(seconds)
        local deadline=now()+(tonumber(seconds) or 5)
        repeat
            if supplyChestPresent() then return true end
            sleep(0.2)
        until now()>=deadline
        return false
    end

    local function placeSupplyChest()
        if waitSupplyChest(1) then return true end
        if turtle.detect() then
            local size=frontInventorySize()
            if not size then
                if waitSupplyChest(5) then return true end
                return false
            end
            if size<=16 and not seed.masterSlot and not seed.driveSlot and not seed.rmLavaSlot and not seed.masterLavaSlot then
                local empty=firstEmptySlot()
                if not empty then return false end
                turtle.select(empty)
                if not turtle.dig() then return false end
                sleep(0.2)
            else
                return false
            end
        end
        for slot=1,16 do
            if turtle.getItemCount(slot)>0 then
                turtle.select(slot)
                local okProbe,canFuel=pcall(turtle.refuel,0)
                if not (okProbe and canFuel) then
                    local before=turtle.getItemCount(slot)
                    local placed=turtle.place()
                    if placed then
                        if waitSupplyChest(5) then
                            seed.supplySourceSlot=slot
                            saveSeed()
                            return true
                        end
                        local empty=firstEmptySlot()
                        if empty then turtle.select(empty) end
                        turtle.dig()
                        sleep(0.15)
                    end
                end
            end
        end
        return false
    end

    local function ensurePulled(field,kind,label)
        local existing=tonumber(seed[field])
        if existing and existing>=1 and existing<=16 and turtle.getItemCount(existing)>0 then
            return existing
        end
        local slot=pullOne(kind)
        if not slot then
            error("Black Blue Blue supply chest is missing "..label)
        end
        seed[field]=slot
        saveSeed()
        return slot
    end

    os.setComputerLabel("Regional Manager")
    show("Preparing autonomous deployment")

    if seed.phase=="START" then
        if seed.x~=0 or seed.z~=-1 then
            error("Regional Manager seed pose is not at the Foreman-1 starting square")
        end
        if not faceSeed(DIR_N) then error("Regional Manager could not face north") end
        if not placeSupplyChest() then
            error("Place the Black Blue Blue supply Ender Chest in the Regional Manager inventory or directly north of it")
        end
        seed.phase="SUPPLY_PLACED"
        saveSeed()
    end

    if seed.phase=="SUPPLY_PLACED" then
        if not waitSupplyChest(5) then
            if not faceSeed(DIR_N) or not placeSupplyChest() then
                error("Black Blue Blue supply chest is not directly north of the Regional Manager and could not be restored")
            end
        end
        seed.masterSlot=ensurePulled("masterSlot","foreman_turtle","an Advanced Wireless Foreman turtle")
        seed.workerDiskSlots=seed.workerDiskSlots or {}
        for i=1,4 do
            local field="workerDiskSlot"..tostring(i)
            local remembered=tonumber(seed.workerDiskSlots[i]) or tonumber(seed[field])
            if remembered and turtle.getItemCount(remembered)>0 then
                seed.workerDiskSlots[i]=remembered
            else
                local slot=pullOne("floppy")
                if not slot then error("Black Blue Blue supply chest is missing worker disk "..tostring(i).." of 4") end
                seed.workerDiskSlots[i]=slot
                seed[field]=slot
                saveSeed()
            end
        end
        seed.setupDiskSlot=ensurePulled("setupDiskSlot","floppy","the Master Foreman setup disk")
        seed.driveSlot=ensurePulled("driveSlot","disk_drive","a Disk Drive")
        seed.rmLavaSlot=ensurePulled("rmLavaSlot","lava_bucket","the Regional Manager lava bucket")
        seed.masterLavaSlot=ensurePulled("masterLavaSlot","lava_bucket","the Master Foreman lava bucket")
        seed.phase="SUPPLIES_PULLED"
        saveSeed()
    end

    if seed.phase=="SUPPLIES_PULLED" then
        if turtle.getFuelLevel()~="unlimited" then
            turtle.select(seed.rmLavaSlot)
            if not turtle.refuel(0) or not turtle.refuel(1) then
                error("Regional Manager could not refuel from its reserved lava bucket")
            end
            seed.rmBucketSlot=seed.rmLavaSlot
        end
        seed.phase="RM_REFUELED"
        saveSeed()
    end

    if seed.phase=="RM_REFUELED" then
        if peripheral.getType("top")~="drive" then
            turtle.select(seed.driveSlot)
            if not turtle.placeUp() then error("Regional Manager could not place the bootstrap Disk Drive above itself") end
            sleep(0.2)
        end
        if peripheral.getType("top")~="drive" then error("Bootstrap Disk Drive is not above the Regional Manager") end
        seed.phase="DRIVE_PLACED"
        saveSeed()
    end

    if seed.phase=="DRIVE_PLACED" then
        show("Preparing four worker disks")
        local workerSlots={}
        for i=1,4 do workerSlots[i]=tostring(seed.workerDiskSlots[i]) end
        local ok,reason=runLocalProgram("prep","2","4","quarry worker",table.concat(workerSlots,","))
        if not ok then error("Worker disk preparation failed: "..tostring(reason)) end
        seed.phase="WORKER_DISKS_PREPPED"
        saveSeed()
    end

    if seed.phase=="WORKER_DISKS_PREPPED" then
        if not faceSeed(DIR_N) or not wrapInventory("front") then error("Regional Manager cannot access the Black Blue Blue supply chest") end
        for i=1,4 do
            local slot=seed.workerDiskSlots[i]
            if turtle.getItemCount(slot)>0 then
                turtle.select(slot)
                if not turtle.drop(1) then error("Could not return worker disk "..tostring(i).." to the supply chest") end
            end
        end
        seed.phase="WORKER_DISKS_RETURNED"
        saveSeed()
    end

    if seed.phase=="WORKER_DISKS_RETURNED" then
        show("Preparing Master Foreman setup disk")
        local ok,reason=runLocalProgram("prep","1","1","setup",tostring(seed.setupDiskSlot))
        if not ok then error("Master Foreman setup disk preparation failed: "..tostring(reason)) end
        seed.phase="SETUP_DISK_PREPPED"
        saveSeed()
    end

    if seed.phase=="SETUP_DISK_PREPPED" then
        if disk.isPresent("top") then error("Bootstrap Disk Drive already contains an unexpected disk") end
        turtle.select(seed.setupDiskSlot)
        if not turtle.dropUp(1) then error("Could not insert Master Foreman setup disk") end
        sleep(0.2)
        if not disk.isPresent("top") then error("Master Foreman setup disk was not detected") end
        seed.phase="SETUP_DISK_INSERTED"
        saveSeed()
    end

    if seed.phase=="SETUP_DISK_INSERTED" then
        if not faceSeed(DIR_S) then error("Regional Manager could not turn south") end
        if not forwardSeed() then error("Regional Manager could not move back from the bootstrap station") end
        if not faceSeed(DIR_N) then error("Regional Manager could not face north after backing away") end
        seed.phase="BACKED"
        saveSeed()
    end

    if seed.phase=="BACKED" then
        local masterId=nil
        local okExisting,idExisting=pcall(peripheral.call,"front","getID")
        if okExisting and tonumber(idExisting) then masterId=tonumber(idExisting) end
        if not masterId then
            if turtle.detect() then error("Master Foreman placement square is occupied") end
            turtle.select(seed.masterSlot)
            if not turtle.place() then error("Regional Manager could not place the Master Foreman") end
            sleep(0.3)
            for attempt=1,20 do
                local ok,id=pcall(peripheral.call,"front","getID")
                if ok and tonumber(id) then masterId=tonumber(id) break end
                sleep(0.1)
            end
        end
        if not masterId then error("Regional Manager could not identify the placed Master Foreman") end
        seed.masterId=masterId
        pcall(peripheral.call,"front","turnOn")
        seed.phase="MASTER_PLACED"
        saveSeed()
    end

    if seed.phase=="MASTER_PLACED" then
        if not openSeedNetwork() then error("Regional Manager wireless modem is unavailable") end
        show("Waiting for Master Foreman software installation")
        local ready=false
        local deadline=now()+120
        while now()<deadline and not ready do
            local sender,message=rednet.receive(SEED_PROTOCOL,1)
            if tonumber(sender)==tonumber(seed.masterId) and type(message)=="table" and
                message.type=="seed_master_ready" and tonumber(message.version)==VERSION then
                ready=true
            end
        end
        if not ready then error("Master Foreman setup disk did not report installation complete") end
        rednet.send(seed.masterId,{type="seed_master_ack",target=seed.masterId},SEED_PROTOCOL)
        seed.phase="MASTER_ACKED"
        saveSeed()
    end

    if seed.phase=="MASTER_ACKED" then
        if not openSeedNetwork() then error("Regional Manager wireless modem is unavailable") end
        show("Waiting for Master Foreman installer cleanup handoff")
        local ready=false
        local deadline=now()+30
        while now()<deadline and not ready do
            local sender,message=rednet.receive(SEED_PROTOCOL,1)
            if tonumber(sender)==tonumber(seed.masterId) and type(message)=="table" then
                if message.type=="seed_master_cleanup_ready" and tonumber(message.version)==VERSION then
                    ready=true
                elseif message.type=="seed_master_ready" and tonumber(message.version)==VERSION then
                    rednet.send(seed.masterId,{type="seed_master_ack",target=seed.masterId},SEED_PROTOCOL)
                end
            end
        end
        if not ready then error("Master Foreman did not release the setup drive for Regional Manager cleanup") end
        seed.phase="INSTALLER_ASCEND"
        saveSeed()
    end

    if seed.phase=="INSTALLER_ASCEND" then
        local frontType=peripheral.getType("front")
        local okId,idFront=pcall(peripheral.call,"front","getID")
        if frontType=="drive" then
            seed.y=1
        elseif okId and tonumber(idFront)==tonumber(seed.masterId) then
            if not turtle.up() then error("Regional Manager could not rise to the bootstrap Disk Drive") end
            seed.y=1
            sleep(0.2)
        else
            error("Regional Manager cannot reconcile the Master Foreman installer cleanup position")
        end
        if peripheral.getType("front")~="drive" then
            error("Bootstrap Disk Drive is not in front of the Regional Manager at cleanup height")
        end
        seed.phase="INSTALLER_LEVEL"
        saveSeed()
    end

    if seed.phase=="INSTALLER_LEVEL" then
        if not seed.setupDiskRecovered then
            if disk.isPresent("front") then
                if turtle.getItemCount(seed.setupDiskSlot)>0 then
                    error("Reserved setup disk slot is occupied before recovery")
                end
                turtle.select(seed.setupDiskSlot)
                if not turtle.suck(1) then error("Regional Manager could not recover the Master Foreman setup disk") end
                sleep(0.2)
            end
            if disk.isPresent("front") or turtle.getItemCount(seed.setupDiskSlot)<=0 then
                error("Master Foreman setup disk recovery could not be verified")
            end
            seed.setupDiskRecovered=true
            saveSeed()
        end
        if not seed.driveRecovered then
            if peripheral.getType("front")=="drive" then
                if turtle.getItemCount(seed.driveSlot)>0 then
                    error("Reserved Disk Drive slot is occupied before recovery")
                end
                turtle.select(seed.driveSlot)
                if not turtle.dig() then error("Regional Manager could not recover the bootstrap Disk Drive") end
                sleep(0.2)
            end
            if peripheral.getType("front")=="drive" or turtle.getItemCount(seed.driveSlot)<=0 then
                error("Bootstrap Disk Drive recovery could not be verified")
            end
            seed.driveRecovered=true
            saveSeed()
        end
        seed.phase="INSTALLER_DESCEND"
        saveSeed()
    end

    if seed.phase=="INSTALLER_DESCEND" then
        local okId,idFront=pcall(peripheral.call,"front","getID")
        if okId and tonumber(idFront)==tonumber(seed.masterId) then
            seed.y=0
        else
            if not turtle.down() then error("Regional Manager could not descend after recovering the bootstrap installer") end
            seed.y=0
            sleep(0.2)
        end
        local okMaster,masterFront=pcall(peripheral.call,"front","getID")
        if not okMaster or tonumber(masterFront)~=tonumber(seed.masterId) then
            error("Master Foreman is not in front of the Regional Manager after installer cleanup")
        end
        seed.phase="MASTER_HANDOFF"
        saveSeed()
    end

    if seed.phase=="MASTER_HANDOFF" then
        if not seed.driveTransferred then
            if turtle.getItemCount(seed.driveSlot)<=0 then error("Recovered bootstrap Disk Drive is missing") end
            turtle.select(seed.driveSlot)
            if not turtle.drop(1) then error("Regional Manager could not hand the Disk Drive to Foreman-1") end
            seed.driveTransferred=true
            saveSeed()
        end
        if not seed.masterLavaTransferred then
            if turtle.getItemCount(seed.masterLavaSlot)<=0 then error("Master Foreman lava bucket is missing") end
            turtle.select(seed.masterLavaSlot)
            if not turtle.drop(1) then error("Regional Manager could not transfer the Master Foreman lava bucket") end
            seed.masterLavaTransferred=true
            saveSeed()
        end
        if openSeedNetwork() then
            rednet.send(seed.masterId,{type="seed_master_cleanup_done",target=seed.masterId,version=VERSION},SEED_PROTOCOL)
        end
        local ok=pcall(peripheral.call,"front","reboot")
        if not ok then
            pcall(peripheral.call,"front","shutdown")
            sleep(0.5)
            pcall(peripheral.call,"front","turnOn")
        end
        seed.phase="MASTER_REBOOTED"
        saveSeed()
    end

    if seed.phase=="MASTER_REBOOTED" then
        if not seed.rmBucketTransferred then
            if seed.rmBucketSlot and turtle.getItemCount(seed.rmBucketSlot)>0 then
                turtle.select(seed.rmBucketSlot)
                if not turtle.drop(1) then error("Regional Manager could not hand its empty bucket to the Master Foreman") end
            end
            seed.rmBucketTransferred=true
            saveSeed()
        end
        while seed.z>MANAGER_IDLE.z do
            if not faceSeed(DIR_S) or not forwardSeed() then
                error("Regional Manager could not clear the Master Foreman setup lane")
            end
        end
        if not moveSeedTo(MANAGER_IDLE.x,MANAGER_IDLE.z) or not faceSeed(DIR_N) then
            error("Regional Manager could not reach its idle position")
        end
        seed.phase="AT_IDLE"
        saveSeed()
    end

    if seed.phase=="AT_IDLE" then
        seed.complete=true
        seed.phase="COMPLETE"
        seed.x=MANAGER_IDLE.x
        seed.y=0
        seed.z=MANAGER_IDLE.z
        seed.dir=DIR_N
        saveSeed()
    end

    return seed
end

local function runRegionalManager()
    while not openNetwork() do
        term.setBackgroundColor(colors.black)
        term.setTextColor(colors.white)
        term.clear()
        term.setCursorPos(1,1)
        print("Regional Manager waiting for wireless modem...")
        sleep(1)
    end

    local managerId=os.getComputerID()
    local OBSERVER_PROTOCOL="miner_swarm_monitor_v121"
    local lastObserverSend=0
    setRegionalManager(managerId)
    local rawSend=send
    local rawBroadcast=broadcast
    local radioWindowStart=now()
    local radioRxWindow=0
    local radioTxWindow=0
    local radioRxRate=0
    local radioTxRate=0
    local function send(id,packet)
        if id and id~=managerId then radioTxWindow=radioTxWindow+1 end
        rawSend(id,packet)
    end
    local function broadcast(packet)
        radioTxWindow=radioTxWindow+1
        rawBroadcast(packet)
    end
    pcall(rednet.unhost,PROTOCOL)
    pcall(rednet.host,PROTOCOL,"regional_manager")

    local function findMonitor()
        for _,side in ipairs({"left","right","top","bottom","front","back"}) do
            if peripheral.getType(side)=="monitor" then
                return side,peripheral.wrap(side)
            end
        end
        return nil,nil
    end
    local monitorSide,mon=findMonitor()
    if mon then mon.setTextScale(0.5) end

    local seedConfig=loadTable("manager_seed.cfg")
    local data=loadTableLight("regional_manager.tmp")
    if not data and
        (fs.exists("regional_manager.tmp") or fs.exists("regional_manager.tmp.new") or
         fs.exists("regional_manager.tmp.bak")) then
        error("Regional Manager state unreadable; refusing to create a new session")
    end

    local savedManagerVersion=tonumber(data and data.version)
    if data and savedManagerVersion and savedManagerVersion>=56 and savedManagerVersion<VERSION then
        data.version=VERSION
        for _,entry in pairs(data.authority or {}) do
            if type(entry)=="table" then entry.version=VERSION end
        end
        if not saveTableLight("regional_manager.tmp",data) then
            error("Regional Manager migration write failed")
        end
    elseif data and data.version==55 and
        not next(data.miners or {}) and not next(data.navigators or {}) and
        not (data.foremen and (data.foremen[2] or data.foremen[3] or data.foremen[4])) then
        data.version=VERSION
        if not saveTableLight("regional_manager.tmp",data) then
            error("Regional Manager migration write failed")
        end
    end

    if data and data.version~=VERSION then
        error("Unsupported Regional Manager state version; refusing to reset the swarm")
    end
    if not data then
        data={
            version=VERSION,
            managerId=managerId,
            session=nil,
            masterForemanId=nil,
            paired=false,
            nodes={},
            foremen={},
            miners={},
            navigators={},
            authority={},
            requests={},
            foremanJobs={},
            commissioningComplete=false,
            swarmStarted=false,
            installerConsolidationComplete=false,
            gpsReady=false,
            worldOrigin=(seedConfig and seedConfig.worldOrigin) or {x=0,y=0,z=0},
            minerSetupApproved=false,
            minerSetupDeclined=false,
            minerSetupGateRequested=false,
            minerSetupConfirm=false,
            recall={
                state="NORMAL",
                mode=nil,
                active=false,
                homeMiners={},
                homeForemen={},
                homeNavigators={},
                emptied={},
                shutdown={},
                targets={miners={},foremen={},navigators={}}
            }
        }
        if not saveTableLight("regional_manager.tmp",data) then
            error("Regional Manager initial state write failed")
        end
    end

    data.managerId=managerId
    data.chunkIndex=tonumber(data.chunkIndex) or 0
    data.managerPose=data.managerPose or {x=MANAGER_IDLE.x,y=0,z=MANAGER_IDLE.z,dir=DIR_N,
        chunkIndex=data.chunkIndex,seq=0}
    if data.recall and data.recall.packMoveIntent then
        local intent=data.recall.packMoveIntent
        local moved=movementFromFuel(intent.fuelBefore,turtle.getFuelLevel())
        if moved==nil then
            data.managerPose.recoveryLocked=true
            data.managerPose.recoveryReason="Cannot resolve interrupted Regional Manager pack move"
        elseif moved then
            data.managerPose.x=intent.toX
            data.managerPose.z=intent.toZ
            data.managerPose.dir=intent.dir
            data.managerPose.seq=(tonumber(data.managerPose.seq) or 0)+1
            data.recall.packMoveIntent=nil
        else
            data.managerPose.x=intent.fromX
            data.managerPose.z=intent.fromZ
            data.managerPose.dir=intent.dir
            data.recall.packMoveIntent=nil
        end
        saveTableLight("regional_manager.tmp",data)
    end
    resolveChunkMove(data.managerPose,function()
        if not saveTableLight("regional_manager.tmp",data) then
            error("Manager chunk move recovery write failed")
        end
    end,data.worldOrigin)
    if not data.managerPose.recoveryLocked then
        local verified,reason=verifyBootWitness(data.managerPose,data.worldOrigin,true)
        if not verified then
            data.managerPose.recoveryLocked=true
            data.managerPose.recoveryReason=reason
            saveTableLight("regional_manager.tmp",data)
        end
    end
    if data.advance and data.advance.phase=="MOVE_RM" and
        data.managerPose.chunkIndex==data.advance.target then
        data.chunkIndex=data.advance.target
        saveTableLight("regional_manager.tmp",data)
    end
    data.nodes=data.nodes or {}
    data.foremen=data.foremen or {}
    data.miners=data.miners or {}
    data.navigators=data.navigators or {}
    data.gpsReady=data.gpsReady and true or false
    data.minerSetupApproved=data.minerSetupApproved and true or false
    data.minerSetupDeclined=data.minerSetupDeclined and true or false
    data.minerSetupGateRequested=data.minerSetupGateRequested and true or false
    data.minerSetupConfirm=data.minerSetupConfirm and true or false
    data.authority=data.authority or {}
    data.requests=data.requests or {}
    data.foremanJobs=data.foremanJobs or {}
    data.blockedHistory=data.blockedHistory or {}

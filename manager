    local function canReplaceMaster(sender)
        if not data.masterForemanId or tonumber(data.masterForemanId)==tonumber(sender) then
            return true
        end
        if now()-managerBootTime<5 then
            return false
        end
        return not masterLastSeen or now()-masterLastSeen>=5
    end

    local function resetForMaster(sender)
        data.masterForemanId=sender
        data.session=tostring(managerId) .. ":" .. tostring(os.time()) .. ":" .. tostring(math.random(100000,999999))
        data.paired=true
        data.nodes={}
        data.foremen={}
        data.miners={}
        data.navigators={}
        data.authority={}
        data.requests={}
        data.foremanJobs={}
        data.commissioningComplete=false
        data.swarmStarted=false
        data.gpsReady=false
        data.worldOrigin=nil
        data.minerSetupApproved=false
        data.minerSetupDeclined=false
        data.minerSetupGateRequested=false
        data.minerSetupConfirm=false
        data.recall={
            state="NORMAL",
            mode=nil,
            active=false,
            homeMiners={},
            homeForemen={},
            homeNavigators={},
            emptied={},
            shutdown={},
            targets={miners={},foremen={},navigators={}}
        }
        masterLastSeen=now()
        save()
        flushManager(true)
    end

    local function validateRegistration(sender,message)
        if message.version~=VERSION or tonumber(message.managerId)~=managerId then
            return false
        end

        if data.session and message.session~=data.session then
            return false
        end

        if tonumber(message.masterForemanId)~=tonumber(data.masterForemanId) then
            return false
        end

        local origin=message.worldOrigin
        if type(origin)~="table" or type(origin.x)~="number" or
            type(origin.y)~="number" or type(origin.z)~="number" then
            return false
        end
        if data.worldOrigin then
            if data.worldOrigin.x~=origin.x or data.worldOrigin.y~=origin.y or
                data.worldOrigin.z~=origin.z then return false end
        elseif sender~=data.masterForemanId or message.role~="foreman" or
            tonumber(message.number)~=1 then
            return false
        end

        if message.role=="foreman" then
            local n=tonumber(message.number)
            if not n or n<1 or n>4 then return false end
            if n==1 and sender~=data.masterForemanId then return false end
            if tonumber(message.rowStart)~=((n-1)*4+1) or tonumber(message.rowEnd)~=(n*4) then
                return false
            end
            return true
        elseif message.role=="miner" then
            local row=tonumber(message.row)
            if not row or row<1 or row>16 then return false end
            local n=expectedForemanForRow(row)
            if tonumber(message.foremanNumber)~=n then return false end
            local f=data.foremen[n]
            if f and f.id and tonumber(message.foremanId)~=tonumber(f.id) then
                return false
            end
            return true
        elseif message.role=="navigator" then
            local n=tonumber(message.number)
            local site=NAVIGATOR_SITES[n]
            if not site then return false end
            return tonumber(message.x)==site.x and
                tonumber(message.y)==site.y and
                tonumber(message.z)==site.z
        end

        return false
    end

    local function registerNode(sender,message)
        if not validateRegistration(sender,message) then
            send(sender,{
                type="registration_error",
                version=VERSION,
                id=sender,
                reason="Manifest mismatch"
            })
            return
        end

        local node={
            id=sender,
            role=message.role,
            number=message.number,
            row=message.row,
            rowStart=message.rowStart,
            rowEnd=message.rowEnd,
            foremanId=message.foremanId,
            foremanNumber=message.foremanNumber,
            lastSeen=now()
        }

        data.nodes[sender]=node

        if sender==data.masterForemanId and message.role=="foreman" and tonumber(message.number)==1 then
            masterLastSeen=now()
            data.worldOrigin=message.worldOrigin
        end

        if message.role=="foreman" then
            local n=tonumber(message.number)
            data.foremen[n]=data.foremen[n] or {}
            for k,v in pairs(node) do data.foremen[n][k]=v end
            if data.recall.active then data.recall.targets.foremen[n]=sender end
        elseif message.role=="miner" then
            local row=tonumber(message.row)
            data.miners[row]=data.miners[row] or {}
            for k,v in pairs(node) do data.miners[row][k]=v end
            if data.recall.active then
                data.recall.targets.miners[row]=sender
                if data.recall.mode=="DUMP" and data.recall.foremenFinalizing then
                    data.recall.foremenFinalizing=nil
                end
            end
        elseif message.role=="navigator" then
            local n=tonumber(message.number)
            data.navigators[n]=data.navigators[n] or {}
            for k,v in pairs(node) do data.navigators[n][k]=v end
            data.navigators[n].x=message.x
            data.navigators[n].y=message.y
            data.navigators[n].z=message.z
            if data.recall.active then data.recall.targets.navigators[n]=sender end
        end

        save()

        send(sender,{
            type="node_registered",
            version=VERSION,
            session=data.session,
            id=sender,
            managerId=managerId,
            masterForemanId=data.masterForemanId,
            number=message.number,
            row=message.row,
            rowStart=message.rowStart,
            rowEnd=message.rowEnd,
            foremanId=message.foremanId,
            foremanNumber=message.foremanNumber,
            x=message.x,
            y=message.y,
            z=message.z
        })

        if data.recall.state=="RECALLED_PAUSED" then
            send(sender,{type="recall_command",mode="NORMAL",session=data.session})
        elseif data.recall.state=="DUMP_RECALLED_PAUSED" then
            send(sender,{type="recall_command",mode=message.role=="miner" and "DUMP" or "NORMAL",session=data.session})
        elseif data.recall.state=="SHUTDOWN_COMPLETE" then
            send(sender,{type="recall_command",mode="SHUTDOWN",session=data.session})
        elseif data.recall.mode=="PACK" then
            if data.recall.state=="PACK_RECALL" then
                send(sender,{type="recall_command",mode="PACK",session=data.session})
            elseif data.recall.state=="PACK_CLEAR" and sender~=data.recall.targets.miners[16] then
                send(sender,{type="pack_clear",session=data.session})
            elseif data.recall.state=="PACK_COLLECT" and sender==data.recall.targets.miners[16] and
                now()>=(data.recall.collectAfter or 0) then
                send(sender,{type="pack_collect",session=data.session})
            end
        elseif data.recall.active then
            if data.recall.mode~="DUMP" or message.role=="miner" then
                send(sender,{type="recall_command",mode=data.recall.mode,session=data.session})
            end
        elseif data.swarmStarted then
            send(sender,{type="start_mining",session=data.session})
            send(sender,{type="resume_swarm",session=data.session})
        end
    end

    local function mergeServiceKind(a,b)
        if a==b then return a end
        if not a then return b end
        if not b then return a end
        return "BOTH"
    end

    local function registeredNodeSender(role,number,sender)
        local index=tonumber(number)
        if not index then return false end
        local registry=role=="miner" and data.miners or
            role=="foreman" and data.foremen or
            role=="navigator" and data.navigators
        local node=registry and registry[index]
        return node and node.id==sender or false
    end

    local function upsertServiceRequest(sender,message)
        local row=tonumber(message.row)
        if not row or row<1 or row>16 then return end
        if not registeredNodeSender("miner",row,sender) then return end

        local requestId=tostring(message.requestId or "")
        if requestId=="" then return end

        local existing=data.requests[requestId]

        if existing and existing.minerId~=sender then return end

        if not existing then
            existing={
                requestId=requestId,
                row=row,
                minerId=sender,
                foremanNumber=expectedForemanForRow(row),
                foremanId=message.foremanId,
                service=message.service,
                fuel=message.fuel,
                status=data.recall.mode and data.recall.mode~="DUMP" and
                    "SUSPENDED" or (message.type=="service_arrived" and "PENDING" or "WAITING_ARRIVAL"),
                arrived=message.type=="service_arrived",
                created=now(),
                updated=now(),
                trips=0
            }
            data.requests[requestId]=existing
        else
            existing.service=mergeServiceKind(existing.service,message.service)
            existing.fuel=message.fuel or existing.fuel
            local job=data.foremanJobs[existing.foremanNumber]
            if job and job.requestId==requestId then
                job.service=existing.service
            end
            existing.arrived=existing.arrived or message.type=="service_arrived"
            existing.status=existing.arrived and ((existing.status=="WAITING_ARRIVAL") and "PENDING" or existing.status) or existing.status
            existing.updated=now()
            existing.minerId=sender
        end

        send(sender,{
            type="service_ack",
            requestId=requestId,
            row=row,
            managerId=managerId
        })

        if existing.status=="COMPLETE" then
            send(sender,{
                type="service_complete",
                requestId=requestId,
                session=data.session
            })
        end

        save()
    end

    local function clearForemanJob(number,requestId)
        local job=data.foremanJobs[number]
        if job and (not requestId or job.requestId==requestId) then
            data.foremanJobs[number]=nil
        end
    end

    local function dispatchJobs()
        if data.advance then return end
        if type(data.foremanJobs)~="table" then
            data.foremanJobs={}
        end

        if type(data.requests)~="table" then
            data.requests={}
        end

        if type(data.foremen)~="table" then
            data.foremen={}
        end

        local removedJobs={}
        for n,job in pairs(data.foremanJobs) do
            if type(job)~="table" or not job.requestId then
                removedJobs[#removedJobs+1]=n
            else
                local request=data.requests[job.requestId]
                local foreman=data.foremen[n]

                if type(request)~="table" or request.status=="COMPLETE" then
                    removedJobs[#removedJobs+1]=n
                elseif tonumber(request.foremanNumber)~=tonumber(n) then
                    removedJobs[#removedJobs+1]=n
                    request.status=request.arrived and "PENDING" or "WAITING_ARRIVAL"
                    request.updated=now()
                elseif type(foreman)~="table" or not foreman.id then
                    removedJobs[#removedJobs+1]=n
                    request.status=request.arrived and "PENDING" or "WAITING_ARRIVAL"
                    request.updated=now()
                end
            end
        end
        for _,n in ipairs(removedJobs) do data.foremanJobs[n]=nil end

        local pending={}
        local invalidRequests={}
        for requestId,request in pairs(data.requests) do
            if type(request)~="table" then
                invalidRequests[#invalidRequests+1]=requestId
            else
                if request.arrived and (request.status=="PENDING" or request.status=="ASSIGNING") then
                    pending[#pending+1]={id=requestId,request=request}
                end
            end
        end
        for _,requestId in ipairs(invalidRequests) do data.requests[requestId]=nil end

        table.sort(pending,function(a,b)
            if a.request.created~=b.request.created then
                return a.request.created<b.request.created
            end
            if a.request.row~=b.request.row then
                return a.request.row<b.request.row
            end
            return a.id<b.id
        end)

        local assignedAny=false
        for i=1,#pending do
                local requestId=pending[i].id
                local request=pending[i].request
                local n=request.foremanNumber
                local f=data.foremen[n]

                if f and f.id and online(f,20) and not data.foremanJobs[n] then
                    data.foremanJobs[n]={
                        requestId=requestId,
                        row=request.row,
                        service=request.service,
                        fuel=request.fuel,
                        minerId=request.minerId,
                        assigned=now()
                    }
                    request.status="ASSIGNING"
                    request.foremanId=f.id
                    request.updated=now()
                    assignedAny=true
                end
        end

        if assignedAny then
            save()
            flushManager(true)
        end

        for n,job in pairs(data.foremanJobs) do
            local request=data.requests[job.requestId]
            local f=data.foremen[n]

            if request and f and f.id and request.status~="COMPLETE" then
                if not job.lastSend or now()-job.lastSend>=1 then
                    send(f.id,{
                        type="manager_job",
                        requestId=job.requestId,
                        row=job.row,
                        service=job.service,
                        fuel=request.fuel or job.fuel,
                        minerId=job.minerId,
                        foremanNumber=n,
                        session=data.session
                    })
                    job.lastSend=now()
                end
            end
        end
    end

    local function forEachKnownNode(role,callback)
        local seen={}

        local function visit(entry,entryRole)
            if type(entry)~="table" then return end
            local id=tonumber(entry.id)
            local resolvedRole=entry.role or entryRole
            if id and id~=managerId and not seen[id] and (not role or resolvedRole==role) then
                seen[id]=true
                callback(id,resolvedRole,entry)
            end
        end

        for _,node in pairs(data.nodes) do visit(node,node.role) end
        for _,foreman in pairs(data.foremen) do visit(foreman,"foreman") end
        for _,miner in pairs(data.miners) do visit(miner,"miner") end
        for _,navigator in pairs(data.navigators) do visit(navigator,"navigator") end
    end

    local function sendControl(packet,role,doBroadcast)
        local count=0
        forEachKnownNode(role,function(id)
            send(id,packet)
            count=count+1
        end)
        if doBroadcast and count==0 then broadcast(packet) end
    end

    local function sendRecallToNodes(mode,minersOnly)
        local packet={
            type="recall_command",
            mode=mode,
            session=data.session
        }
        local count=0
        forEachKnownNode(minersOnly and "miner" or nil,function(id,role,entry)
            if (role=="foreman" or role=="navigator") and
                data.recall.waitCollectors then return end
            local index=tonumber(role=="miner" and entry.row or entry.number)
            local home=role=="miner" and data.recall.homeMiners or
                (role=="foreman" and data.recall.homeForemen or data.recall.homeNavigators)
            local acknowledged
            if mode=="SHUTDOWN" then
                acknowledged=data.recall.shutdown[id]
            elseif mode=="DUMP" and role=="miner" then
                acknowledged=index and data.recall.emptied[index]
            else
                acknowledged=index and home[index]
            end
            if not acknowledged then
                send(id,packet)
                count=count+1
            end
        end)
        if count==0 and not next(data.recall.targets.miners or {}) and
            not next(data.recall.targets.foremen or {}) and
            not next(data.recall.targets.navigators or {}) then
            broadcast(packet)
        end
    end

    local function wakeForemenForDump()
        sendControl({
            type="resume_swarm",
            session=data.session,
            reason="DUMP_SERVICE"
        },"foreman",false)
    end

    local function sendDumpFinalRecall()
        local packet={
            type="recall_command",
            mode="NORMAL",
            session=data.session
        }
        forEachKnownNode("foreman",function(id,role,entry)
            local n=tonumber(entry.number)
            if not n or not data.recall.homeForemen[n] then send(id,packet) end
        end)
        forEachKnownNode("navigator",function(id,role,entry)
            local n=tonumber(entry.number)
            if not n or not data.recall.homeNavigators[n] then send(id,packet) end
        end)
    end

    local function beginRecall(mode)
        local abortingAdvance=data.advance~=nil
        local cancelledPhase=data.advance and data.advance.phase or nil
        if abortingAdvance and mode~="NORMAL" and mode~="SHUTDOWN" then
            chunkBlockReason="Only NORMAL recall or SHUTDOWN can interrupt a chunk transition"
            save()
            return false
        end
        if abortingAdvance then
            local cancelledTarget=data.advance.target
            sendControl({
                type="cancel_advance",
                mode=mode,
                phase=cancelledPhase,
                chunkIndex=cancelledTarget,
                session=data.session
            },nil,true)
            data.advance=nil
            chunkBlockReason=nil
            debugLog("RECALL","Aborted chunk transition phase="..tostring(cancelledPhase)..
                " target="..tostring(cancelledTarget).." for "..tostring(mode),"WARN")
        end
        if data.recall.mode=="PACK" and
            (data.recall.state=="PACK_CLEAR" or data.recall.state=="PACK_COLLECT") then
            return false
        end
        local targets={miners={},foremen={},navigators={}}
        for row=1,WORKER_COUNT do
            local miner=data.miners[row]
            if type(miner)=="table" and miner.id then targets.miners[row]=tonumber(miner.id) end
        end
        for n=1,FOREMAN_COUNT do
            local foreman=data.foremen[n]
            if type(foreman)=="table" and foreman.id then targets.foremen[n]=tonumber(foreman.id) end
            local navigator=data.navigators[n]
            if type(navigator)=="table" and navigator.id then targets.navigators[n]=tonumber(navigator.id) end
        end
        for _,node in pairs(data.nodes) do
            if type(node)=="table" and node.id then
                if node.role=="miner" and tonumber(node.row) then
                    targets.miners[tonumber(node.row)]=tonumber(node.id)
                elseif node.role=="foreman" and tonumber(node.number) then
                    targets.foremen[tonumber(node.number)]=tonumber(node.id)
                elseif node.role=="navigator" and tonumber(node.number) then
                    targets.navigators[tonumber(node.number)]=tonumber(node.id)
                end
            end
        end

        if mode=="PACK" then
            if not data.commissioningComplete then
                print("Pack blocked: commissioning is incomplete")
                return false
            end
            for row=1,WORKER_COUNT do
                if not targets.miners[row] then
                    print("Pack blocked: Miner-" .. tostring(row) .. " is not registered")
                    return false
                end
            end
            for n=1,FOREMAN_COUNT do
                if not targets.foremen[n] or not targets.navigators[n] then
                    print("Pack blocked: Foreman/GPS-" .. tostring(n) .. " is not registered")
                    return false
                end
            end
        end

        resumeUntil=0
        if abortingAdvance then data.advance=nil end
        data.recall={
            state=mode=="DUMP" and "DUMP_RECALLING" or (mode=="SHUTDOWN" and "SHUTDOWN_RECALL" or (mode=="PACK" and "PACK_RECALL" or "RECALLING")),
            mode=mode,
            active=true,
            homeMiners={},
            homeForemen={},
            homeNavigators={},
            emptied={},
            shutdown={},
            packReady={},
            waitCollectors=cancelledPhase=="COLLECT_M" and true or nil,
            targets=targets
        }

        if mode=="NORMAL" or mode=="SHUTDOWN" or mode=="PACK" then
            for requestId,request in pairs(data.requests) do
                if request.status~="COMPLETE" then
                    request.status="SUSPENDED"
                end
            end
            data.foremanJobs={}
        end

        lastRecall=now()
        save()
        flushManager(true)
        if mode=="DUMP" then
            wakeForemenForDump()
            sendRecallToNodes("DUMP",true)
        else
            sendRecallToNodes(mode,false)
        end
        drawTerminal()
        drawMonitor()
    end

    local function resumeSwarm()
        if data.advance then return end
        if data.recall.mode=="SHUTDOWN" or data.recall.mode=="PACK" or data.recall.state=="SHUTDOWN_RECALL" or data.recall.state=="SHUTDOWN_COMPLETE" then
            return
        end

        local resumable=
            data.recall.active or
            data.recall.state=="RECALLED_PAUSED" or
            data.recall.state=="DUMP_RECALLED_PAUSED"

        if not resumable then
            return
        end

        data.recall.state="NORMAL"
        data.recall.mode=nil
        data.recall.active=false
        data.recall.foremenFinalizing=nil

        for _,request in pairs(data.requests) do
            if request.status=="SUSPENDED" then
                request.status=request.arrived and "PENDING" or "WAITING_ARRIVAL"
            end
        end

        resumeUntil=now()+15
        lastResumeSend=now()

        save()
        flushManager(true)
        sendControl({
            type="resume_swarm",
            session=data.session
        },nil,true)
        drawTerminal()
        drawMonitor()
    end

    local function recallCounts()
        local mh,fh,nh,empty,shut=0,0,0,0,0
        local tm,tf,tn=0,0,0
        local targets=data.recall.targets or {miners={},foremen={},navigators={}}

        for row in pairs(targets.miners or {}) do
            tm=tm+1
            if data.recall.homeMiners[row] then mh=mh+1 end
            if data.recall.emptied[row] then empty=empty+1 end
        end

        for n in pairs(targets.foremen or {}) do
            tf=tf+1
            if data.recall.homeForemen[n] then fh=fh+1 end
        end

        for n in pairs(targets.navigators or {}) do
            tn=tn+1
            if data.recall.homeNavigators[n] then nh=nh+1 end
        end

        for _,id in pairs(targets.miners or {}) do if data.recall.shutdown[id] then shut=shut+1 end end
        for _,id in pairs(targets.foremen or {}) do if data.recall.shutdown[id] then shut=shut+1 end end
        for _,id in pairs(targets.navigators or {}) do if data.recall.shutdown[id] then shut=shut+1 end end

        return mh,fh,nh,empty,shut,tm,tf,tn
    end

    local function updateRecallState()
        if not data.recall.active then return end
        if data.recall.waitCollectors then
            local ready=true
            for n=1,4 do
                local row=(n-1)*4+2
                if data.recall.targets.miners[row] and not data.recall.homeMiners[row] then
                    ready=false
                end
            end
            if ready then
                data.recall.waitCollectors=nil
                save()
                sendRecallToNodes(data.recall.mode,false)
            end
        end

        local mh,fh,nh,empty,shut,tm,tf,tn=recallCounts()

        if data.recall.mode=="NORMAL" then
            if mh>=tm and fh>=tf and nh>=tn then
                data.recall.state="RECALLED_PAUSED"
                data.recall.active=false
                save()
            end
        elseif data.recall.mode=="DUMP" then
            if mh>=tm and empty>=tm then
                if not data.recall.foremenFinalizing then
                    data.recall.foremenFinalizing=true
                    sendDumpFinalRecall()
                    lastRecall=now()
                    save()
                elseif fh>=tf and nh>=tn then
                    local continuePacking=data.recall.packAfterDump
                    data.recall.state="DUMP_RECALLED_PAUSED"
                    data.recall.active=false
                    save()
                    if continuePacking then beginRecall("PACK") end
                end
            end
        elseif data.recall.mode=="SHUTDOWN" then
            if shut>=(tm+tf+tn) then
                data.recall.state="SHUTDOWN_COMPLETE"
                data.recall.active=false
                save()
            end
        elseif data.recall.mode=="PACK" then
            if data.recall.state=="PACK_RECALL" and mh==tm and fh==tf and nh==tn then
                data.recall.state="PACK_CLEAR"
                save()
            elseif data.recall.state=="PACK_CLEAR" then
                local ready=0
                local expectedReady=0
                local collectorId=data.recall.targets.miners[WORKER_COUNT]
                for _,id in pairs(data.recall.targets.miners) do
                    if id~=collectorId then
                        expectedReady=expectedReady+1
                        if data.recall.packReady[id] then ready=ready+1 end
                    end
                end
                for _,id in pairs(data.recall.targets.foremen) do
                    expectedReady=expectedReady+1
                    if data.recall.packReady[id] then ready=ready+1 end
                end
                for _,id in pairs(data.recall.targets.navigators) do
                    expectedReady=expectedReady+1
                    if data.recall.packReady[id] then ready=ready+1 end
                end
                if ready==expectedReady then
                    data.recall.state="PACK_COLLECT"
                    data.recall.collectAfter=now()+2
                    save()
                end
            end
        end
    end

    local function registeredCounts()
        local foremen=0
        local miners=0

        for n=1,4 do
            local f=data.foremen[n]
            if f and f.id then
                foremen=foremen+1
            end
        end

        for row=1,16 do
            local m=data.miners[row]
            if m and m.id then
                miners=miners+1
            end
        end

        return foremen,miners
    end

    local function allForemenCommissioned()
        for n=1,4 do
            local f=data.foremen[n]
            if not f or not f.setupDone then
                return false
            end
        end
        return true
    end

    local function releaseSwarm()
        if data.advance then return false end
        if data.recall.state~="NORMAL" or not data.gpsReady or not data.minerSetupApproved then
            return false
        end

        if data.swarmStarted then
            return true
        end

        local foremen,miners=registeredCounts()

        if foremen<FOREMAN_COUNT or miners<WORKER_COUNT then
            return false
        end

        if not data.commissioningComplete and not allForemenCommissioned() then
            return false
        end

        data.commissioningComplete=true
        data.swarmStarted=true
        save()
        flushManager(true)

        sendControl({
            type="start_mining",
            session=data.session
        },nil,true)
        sendControl({
            type="resume_swarm",
            session=data.session
        },nil,true)

        return true
    end

    local function mergeStatusEntry(registry,key,sender,message)
        local entry=registry[key] or {}
        entry.recovery=nil
        entry.message=nil
        entry.request=nil
        entry.advanceStage=nil
        entry.setupMissing=nil
        entry.packMissing=nil
        for k,v in pairs(message) do entry[k]=v end
        entry.id=sender
        entry.lastSeen=now()
        registry[key]=entry
        return entry
    end

    local function announceManagerOnline()
        broadcast({
            type="manager_online",
            version=VERSION,
            managerId=managerId,
            session=data.session,
            swarmStarted=data.swarmStarted and true or false,
            recallState=data.recall.state
        })

        if data.recall.state=="NORMAL" and data.swarmStarted and not data.advance then
            forEachKnownNode(nil,function(id,role,entry)
                local node
                if role=="foreman" then
                    node=data.foremen[tonumber(entry.number)]
                    if node and not node.miningStarted and online(node,30) then
                        send(id,{type="start_mining",session=data.session})
                    end
                elseif role=="miner" then
                    node=data.miners[tonumber(entry.row)]
                    if node and node.state=="WAITING" and online(node,30) then
                        send(id,{type="start_mining",session=data.session})
                    end
                end
            end)
        end
    end

    local function refuelManagerTo(target)
        if turtle.getFuelLevel()=="unlimited" or turtle.getFuelLevel()>=target then
            return true
        end
        local previous=turtle.getSelectedSlot()
        local function detail(slot)
            if turtle.getItemDetail then
                local ok,item=pcall(turtle.getItemDetail,slot)
                if ok and item then return item end
            end
            return selfItem(slot)
        end
        while turtle.getFuelLevel()<target do
            local slot=nil
            for _,kind in ipairs(FUEL_PRIORITY) do
                for index=1,16 do
                    if turtle.getItemCount(index)>0 and matchesItem(detail(index),kind) then
                        slot=index
                        break
                    end
                end
                if slot then break end
            end
            if not slot then
                for index=1,16 do
                    if turtle.getItemCount(index)>0 then
                        turtle.select(index)
                        if turtle.refuel(0) then
                            slot=index
                            break
                        end
                    end
                end
            end
            if not slot then break end
            turtle.select(slot)
            local before=turtle.getFuelLevel()
            data.managerBucketSlot=slot
            save()
            if not turtle.refuel(1) or turtle.getFuelLevel()<=before then break end
        end
        turtle.select(previous)
        return turtle.getFuelLevel()=="unlimited" or turtle.getFuelLevel()>=target
    end

    local function managerAtFuelChest()
        if data.advance then return false end
        local pose=data.managerPose
        local function matchesIdle(x,y,z)
            local ex,ey,ez=worldPose(MANAGER_IDLE.x,0,MANAGER_IDLE.z,
                data.chunkIndex,data.worldOrigin)
            return ex and math.abs(x-ex)<0.25 and math.abs(y-ey)<0.25 and
                math.abs(z-ez)<0.25
        end
        if pose.x==5 and pose.y==0 and pose.z==-4 and pose.dir==DIR_N then
            local ok,x,y,z=pcall(gps.locate,2,false)
            if not ok or not x or not y or not z or
                not matchesIdle(x,y,z) then
                return false
            end
            pose.x=MANAGER_IDLE.x
            pose.z=MANAGER_IDLE.z
            save()
            flushManager(true)
        end
        if pose.x~=MANAGER_IDLE.x or pose.y~=0 or
            pose.z~=MANAGER_IDLE.z or pose.dir~=DIR_N then return false end
        if data.commissioningComplete and data.gpsReady then
            local ok,x,y,z=pcall(gps.locate,2,false)
            if not ok or not x or not y or not z or
                not matchesIdle(x,y,z) then
                return false
            end
        end
        return true
    end

    local function refuelManagerAtChest(target)
        if not managerAtFuelChest() or not wrapInventory("front") then return false end
        local previous=turtle.getSelectedSlot()
        local function returnBucket()
            local slot=tonumber(data.managerBucketSlot)
            if not slot then return true end
            turtle.select(slot)
            if turtle.getItemCount(slot)>0 then
                if not turtle.drop(1) then turtle.select(previous);return false end
            end
            data.managerBucketSlot=nil
            save()
            return true
        end
        if not returnBucket() then return false end
        if turtle.getFuelLevel()=="unlimited" then
            turtle.select(previous)
            return true
        end
        while turtle.getFuelLevel()<target do
            local slot=nil
            for i=1,16 do
                if turtle.getItemCount(i)==0 then slot=i;break end
            end
            if not slot then turtle.select(previous);return false end
            local kind=nil
            for _,candidate in ipairs(FUEL_PRIORITY) do
                if findInventorySlot("front",candidate) then kind=candidate;break end
            end
            if not kind then
                refuelManagerTo(target)
                if not returnBucket() then return false end
                turtle.select(previous)
                return turtle.getFuelLevel()>=target
            end
            if takeNamedFromFront(kind,1,slot)<1 then
                turtle.select(previous)
                return false
            end
            turtle.select(slot)
            if not turtle.refuel(0) then turtle.select(previous);return false end
            if kind=="lava_bucket" then
                data.managerBucketSlot=slot
                save()
            end
            if not turtle.refuel(1) then turtle.select(previous);return false end
            if not returnBucket() then return false end
        end
        turtle.select(previous)
        return true
    end

    local function chunkKey(role,index)
        return role..":"..tostring(index)
    end

    local function beginChunkAdvance()
        local function enough(fuel,needed)
            return fuel=="unlimited" or (tonumber(fuel) or -1)>=needed
        end
        local function blocked(reason)
            chunkBlockReason=reason
            return false
        end
        if data.advance then chunkBlockReason=nil;return false end
        if data.recall.mode then return blocked("Recall active") end
        if data.managerPose.recoveryLocked then
            return blocked(data.managerPose.recoveryReason or "RM position uncertain")
        end
        if not turtle or not turtle.forward then return blocked("RM must be a turtle") end
        if not data.paired then return blocked("RM pairing incomplete") end
        if not data.commissioningComplete then return blocked("Commissioning incomplete") end
        if not data.swarmStarted then return blocked("Mining not released") end
        local pending,active,blockedCount=countRequests()
        if pending>0 or active>0 or blockedCount>0 then
            return blocked(string.format("Service requests P%d A%d B%d",pending,active,blockedCount))
        end
        if next(data.foremanJobs) then return blocked("Foreman job outstanding") end
        if not managerAtFuelChest() then
            return blocked("Move RM behind Foreman-2 fuel chest, face north, then restart")
        end
        if (not enough(turtle.getFuelLevel(),16) or data.managerBucketSlot) and
            not refuelManagerAtChest(1000) then
            return blocked("RM needs fuel or bucket return at fuel chest")
        end
        for row=1,16 do
            local m=data.miners[row]
            if not m or not m.id then
                return blocked("Miner-"..row.." missing")
            end
            if not checkOnline("miner",row,m,20) then
                return blocked("Miner-"..row.." awaiting check-in")
            end
            if m.state~="COMPLETE" then
                return blocked("Miner-"..row.." "..tostring(m.state))
            end
            if m.fuel~="unlimited" and (tonumber(m.fuel) or 0)<MINER_FUEL_TARGET then
                return blocked("Miner-"..row.." awaiting refuel")
            end
            if tonumber(m.chunkIndex or 0)~=data.chunkIndex or
                tonumber(m.x)~=row or tonumber(m.y)~=0 or tonumber(m.z)~=0 then
                return blocked("Miner-"..row.." pose/chunk mismatch")
            end
            local needed=isChestCollector(row) and 24 or 16
            if not enough(m.fuel,needed) then
                return blocked("Miner-"..row.." needs "..needed.." fuel")
            end
        end
        for n=1,4 do
            local f=data.foremen[n]
            local nav=data.navigators[n]
            local site=NAVIGATOR_SITES[n]
            if not f or not f.id then
                return blocked("Foreman-"..n.." missing")
            end
            if not checkOnline("foreman",n,f,20) then
                return blocked("Foreman-"..n.." awaiting check-in")
            end
            if f.state~="IDLE" then
                return blocked("Foreman-"..n.." "..tostring(f.state))
            end
            if tonumber(f.chunkIndex or 0)~=data.chunkIndex or
                tonumber(f.x)~=FOREMAN_IDLE[n].x or tonumber(f.z)~=-1 then
                return blocked("Foreman-"..n.." pose/chunk mismatch")
            end
            if not enough(f.fuel,24) then
                return blocked("Foreman-"..n.." needs 24 fuel")
            end
            if not nav or not nav.id then
                return blocked("GPS-"..n.." missing")
            end
            if not checkOnline("navigator",n,nav,20) then
                return blocked("GPS-"..n.." awaiting check-in")
            end
            if not nav.gpsHost then return blocked("GPS-"..n.." not hosting") end
            if tonumber(nav.chunkIndex or 0)~=data.chunkIndex or
                tonumber(nav.x)~=site.x or tonumber(nav.z)~=site.z then
                return blocked("GPS-"..n.." pose/chunk mismatch")
            end
            if not enough(nav.fuel,16) then
                return blocked("GPS-"..n.." needs 16 fuel")
            end
        end
        if data.managerPose.chunkIndex~=data.chunkIndex or
            data.managerPose.x~=MANAGER_IDLE.x or data.managerPose.y~=0 or
            data.managerPose.z~=MANAGER_IDLE.z or data.managerPose.dir~=DIR_N then
            return blocked("RM pose/chunk mismatch")
        end
        chunkBlockReason=nil
        data.advance={target=data.chunkIndex+1,phase="STAGE_F",acks={},lastSend=0}
        resumeUntil=0
        save()
        flushManager(true)
        return true
    end

    local function advanceTargets(stage,fn)
        if stage=="STAGE_F" or stage=="MOVE_F" or stage=="VERIFY_F" then
            for n=1,4 do fn("foreman",n,data.foremen[n]) end
        elseif stage=="COLLECT_M" then
            for n=1,4 do
                local row=chestCollectorRow(n)
                fn("miner",row,data.miners[row])
            end
        elseif stage=="MOVE_G" then
            for n=1,4 do fn("navigator",n,data.navigators[n]) end
        elseif stage=="MOVE_M" or stage=="RELEASE" then
            for row=1,16 do fn("miner",row,data.miners[row]) end
        end
    end

    local function advanceStageDone(stage)
        local advance=data.advance
        if stage=="COLLECT_M" then
            local all=true
            advanceTargets(stage,function(role,index)
                if not advance.acks[chunkKey(role,index)] then all=false end
            end)
            advanceTargets("VERIFY_F",function(role,index)
                if not advance.acks[chunkKey(role,index)] then all=false end
            end)
            return all
        end
        local all=true
        advanceTargets(stage,function(role,index,node)
            if stage=="RELEASE" then
                if not node or not online(node,30) or
                    tonumber(node.chunkIndex)~=advance.target or
                    (node.state~="WAITING" and node.state~="MINING") then all=false end
            elseif not advance.acks[chunkKey(role,index)] then all=false end
        end)
        return all
    end

    local function runChunkAdvance()
        if not data.advance then
            beginChunkAdvance()
            return
        end
        local advance=data.advance
        local stage=advance.phase
        if stage=="COLLECT_M" then
            for n=1,4 do
                local foreman=data.foremen[n]
                if not foreman or not online(foreman,20) then
                    advance.error="Waiting for Foreman-"..n.." position before chest collection"
                    return
                end
                if tonumber(foreman.x)~=FOREMAN_IDLE[n].x or
                    tonumber(foreman.z)~=-1 or tonumber(foreman.y)~=0 then
                    advance.error="Legacy foreman staging; use NORMAL recall before retry"
                    return
                end
            end
        end
        if stage=="MOVE_RM" then
            if data.managerPose.chunkIndex<advance.target then
                local function savePose() save();flushManager(true) end
                local function faceNorth(target) return target==DIR_N and
                    data.managerPose.dir==DIR_N end
                local ok,reason=travelChunkNorth(data.managerPose,savePose,
                    faceNorth,MANAGER_IDLE.z,advance.target,data.worldOrigin,function()
                        return data.recall and data.recall.active and
                            (data.recall.mode=="NORMAL" or data.recall.mode=="SHUTDOWN")
                    end)
                if not ok then advance.error=reason;save();return end
                data.chunkIndex=advance.target
                save();flushManager(true)
            end
            local okGps,x,y,z=pcall(gps.locate,2,false)
            if not okGps or not x or not y or not z then
                advance.error="Manager waiting for GPS at new idle position"
                save()
                return
            end
            local expectedX,expectedY,expectedZ=worldPose(MANAGER_IDLE.x,0,
                MANAGER_IDLE.z,advance.target,data.worldOrigin)
            if not expectedX or math.abs(x-expectedX)>0.25 or
                math.abs(y-expectedY)>0.25 or math.abs(z-expectedZ)>0.25 then
                advance.error="Manager GPS differs from new idle position"
                save();flushManager(true)
                return
            end
            data.chunkIndex=advance.target
            save();flushManager(true)
            advance.phase="RELEASE"
            advance.acks={}
            advance.lastSend=0
            advance.error=nil
            save();flushManager(true)
            return
        end
        if stage=="RELEASE" then
            if advanceStageDone(stage) then
                data.advance=nil
                save();flushManager(true)
                announceManagerOnline()
                return
            end
        elseif advanceStageDone(stage) then
            local nextStage=stage=="STAGE_F" and "COLLECT_M" or
                stage=="COLLECT_M" and "MOVE_G" or
                stage=="MOVE_G" and "MOVE_M" or
                stage=="MOVE_M" and "MOVE_F" or "MOVE_RM"
            advance.phase=nextStage
            advance.acks={}
            advance.lastSend=0
            advance.error=nil
            save();flushManager(true)
            return
        end
        local waiting=nil
        advanceTargets(stage,function(role,index,node)
            local key=chunkKey(role,index)
            local ready=stage=="RELEASE" and node and online(node,30) and
                tonumber(node.chunkIndex)==advance.target and
                (node.state=="WAITING" or node.state=="MINING") or
                stage~="RELEASE" and advance.acks[key]
            if not ready and not waiting then
                waiting=role.."-"..index
                if node and node.message and node.message~="" then
                    waiting=waiting.." "..tostring(node.message)
                end
            end
        end)
        if stage=="COLLECT_M" and not waiting then
            advanceTargets("VERIFY_F",function(role,index,node)
                if not advance.acks[chunkKey(role,index)] and not waiting then
                    waiting=role.."-"..index.." chest handoff"
                end
            end)
        end
        local reason="Waiting for "..tostring(waiting or stage)
        if advance.error~=reason then advance.error=reason;save() end
        if now()-(advance.lastSend or -10)<3 then return end
        if stage=="MOVE_G" then
            local sent=false
            advanceTargets(stage,function(role,index,node)
                if not sent and node and node.id and
                    not advance.acks[chunkKey(role,index)] then
                    send(node.id,{type="chunk_move",stage=stage,
                        chunkIndex=advance.target,session=data.session})
                    sent=true
                end
            end)
        else
            advanceTargets(stage,function(role,index,node)
                if node and node.id and
                    (stage=="RELEASE" or not advance.acks[chunkKey(role,index)]) then
                    send(node.id,{type=stage=="RELEASE" and "chunk_release" or
                        "chunk_command",stage=stage,chunkIndex=advance.target,
                        session=data.session})
                end
            end)
        end
        if stage=="COLLECT_M" then
            advanceTargets("VERIFY_F",function(role,index,node)
                if node and node.id and not advance.acks[chunkKey(role,index)] then
                    send(node.id,{type="chunk_command",stage="VERIFY_F",
                        chunkIndex=advance.target,session=data.session})
                end
            end)
        end
        advance.lastSend=now()
    end

    broadcast({
        type="manager_presence",
        version=VERSION,
        managerId=managerId
    })

    drawTerminal()
    drawMonitor()
    announceManagerOnline()
    lastQuery=now()
    releaseSwarm()

    local timer=os.startTimer(1)

    local function activateCommand(command)
        local lowerCommand=lower(tostring(command or ""))
        if data.minerSetupConfirm then
            if lowerCommand=="y" and foremenReadyForMinerSetup() then
                data.minerSetupApproved=true
                data.minerSetupDeclined=false
                data.minerSetupConfirm=false
                save()
                flushManager(true)
                if data.masterForemanId then
                    send(data.masterForemanId,{type="miner_setup_approved",session=data.session})
                end
            elseif lowerCommand=="n" then
                data.minerSetupConfirm=false
                data.minerSetupDeclined=true
                save()
                flushManager(true)
            end
        elseif command=="1" then
            beginRecall("NORMAL")
        elseif command=="2" then
            beginRecall("DUMP")
        elseif command=="3" then
            beginRecall("SHUTDOWN")
        elseif command=="6" then
            if data.commissioningComplete then
                if data.recall.mode=="DUMP" and not data.recall.active then
                    beginRecall("PACK")
                elseif data.recall.mode~="DUMP" and data.recall.mode~="PACK" then
                    beginRecall("DUMP")
                end
                if data.recall.mode=="DUMP" then
                    data.recall.packAfterDump=true
                    save()
                end
            end
        elseif command=="4" then
            resumeSwarm()
        elseif command=="5" and foremenReadyForMinerSetup() then
            data.minerSetupConfirm=true
            data.minerSetupDeclined=false
            save()
        end
    end

    while true do
        local event={os.pullEvent()}

        if event[1]=="rednet_message" then
            local sender=event[2]
            local message=event[3]
            local protocol=event[4]

            if protocol==DEBUG_PROTOCOL and type(message)=="table" then
                debugIngest(sender,message)
            elseif protocol==PROTOCOL and type(message)=="table" then
                if debugLog then debugLog("RADIO","EVENT RX from="..tostring(sender).." payload="..tostring(message.type or "table"),"INFO") end
                radioRxWindow=radioRxWindow+1
                if message.type=="master_pair_seek" and message.version==VERSION then
                    pairStatus="Pair request from Master " .. tostring(sender)
                    if canReplaceMaster(sender) then
                        sendPairOffer(sender)
                        pairStatus="Offer sent to Master " .. tostring(sender)
                    else
                        pairStatus="Master " .. tostring(sender) .. " blocked by active pairing"
                    end
                    drawTerminal()
                    drawMonitor()

                elseif message.type=="master_pair_accept" and message.version==VERSION and
                    tonumber(message.managerId)==managerId and message.nonce==pairNonce then
                    if canReplaceMaster(sender) then
                        if not data.masterForemanId or tonumber(data.masterForemanId)~=tonumber(sender) then
                            resetForMaster(sender)
                        else
                            data.masterForemanId=sender
                            data.session=data.session or (tostring(managerId) .. ":" .. tostring(os.time()) .. ":" .. tostring(math.random(100000,999999)))
                            data.paired=true
                            masterLastSeen=now()
                            save()
                        end

                        send(sender,{
                            type="manager_pair_confirm",
                            version=VERSION,
                            managerId=managerId,
                            masterForemanId=sender,
                            session=data.session,
                            nonce=message.nonce
                        })
                        pairStatus="Pair confirmed with Master " .. tostring(sender)
                        drawTerminal()
                        drawMonitor()
                    end

                elseif message.type=="master_pair_complete" and message.version==VERSION and
                    sender==data.masterForemanId and message.session==data.session then
                    data.paired=true
                    save()

                elseif message.type=="node_register" then
                    registerNode(sender,message)

                elseif message.type=="node_online" and message.session==data.session then
                    if sender==data.masterForemanId and message.role=="foreman" and tonumber(message.number)==1 and message.session==data.session then
                        masterLastSeen=now()
                    end

                    data.nodes[sender]={
                        id=sender,
                        role=message.role,
                        number=message.number,
                        row=message.row,
                        lastSeen=now()
                    }

                    if message.role=="miner" and message.row then
                        data.miners[message.row]=data.miners[message.row] or {}
                        for k,v in pairs(message) do data.miners[message.row][k]=v end
                        data.miners[message.row].id=sender
                        data.miners[message.row].lastSeen=now()
                    elseif message.role=="foreman" and message.number then
                        data.foremen[message.number]=data.foremen[message.number] or {}
                        for k,v in pairs(message) do data.foremen[message.number][k]=v end
                        data.foremen[message.number].id=sender
                        data.foremen[message.number].lastSeen=now()
                    elseif message.role=="navigator" and message.number then
                        data.navigators[message.number]=data.navigators[message.number] or {}
                        for k,v in pairs(message) do data.navigators[message.number][k]=v end
                        data.navigators[message.number].id=sender
                        data.navigators[message.number].lastSeen=now()
                    end

                    save()

                elseif message.type=="miner_setup_gate_request" and sender==data.masterForemanId and
                    message.session==data.session then
                    data.minerSetupGateRequested=true
                    refreshGpsReady()
                    save()

                    if data.gpsReady and data.minerSetupApproved then
                        send(sender,{
                            type="miner_setup_approved",
                            session=data.session
                        })
                    else
                        send(sender,{
                            type="miner_setup_pending",
                            session=data.session,
                            gpsReady=data.gpsReady and true or false
                        })
                    end

                elseif message.type=="commissioning_complete" and sender==data.masterForemanId and
                    message.session==data.session then
                    data.commissioningComplete=true
                    save()
                    releaseSwarm()

                elseif message.type=="status" and message.session==data.session then
                    if sender==data.masterForemanId and message.role=="foreman" and tonumber(message.number)==1 and message.session==data.session then
                        masterLastSeen=now()
                    end

                    message.lastSeen=now()
                    local node=data.nodes[sender] or {}
                    node.id=sender
                    node.role=message.role
                    node.number=message.number or node.number
                    node.row=message.row or node.row
                    node.lastSeen=now()
                    data.nodes[sender]=node

                    if message.role=="foreman" and message.number then
                        mergeStatusEntry(data.foremen,tonumber(message.number),sender,message)
                    elseif message.role=="miner" and message.row then
                        mergeStatusEntry(data.miners,tonumber(message.row),sender,message)
                    elseif message.role=="navigator" and message.number then
                        mergeStatusEntry(data.navigators,tonumber(message.number),sender,message)
                    end

                    save()

                    if message.role=="foreman" and message.setupDone then
                        releaseSwarm()
                    end

                elseif message.type=="pose_checkpoint" and sender==message.id and
                    message.version==VERSION and message.role and message.snapshot and
                    message.session==data.session then
                    local snapshot=message.snapshot
                    local exactPose=
                        type(snapshot.x)=="number" and type(snapshot.y)=="number" and
                        type(snapshot.z)=="number" and type(snapshot.dir)=="number"

                    if message.role=="miner" then
                        exactPose=exactPose and type(snapshot.row)=="number" and
                            snapshot.originEstablished==true
                    end

                    if exactPose then
                        local key=tostring(message.role) .. ":" .. tostring(message.id)
                        local existing=data.authority[key]
                        local incoming=tonumber(message.seq) or 0
                        local current=existing and (tonumber(existing.seq) or 0) or -1

                        if incoming>=current then
                            data.authority[key]={
                                version=VERSION,
                                session=message.session,
                                seq=incoming,
                                snapshot=snapshot,
                                lastSeen=now()
                            }
                            save()
                        end
                    end

                elseif message.type=="recovery_request" and sender==message.id and
                    message.version==VERSION and message.role and message.session==data.session then
                    local key=tostring(message.role) .. ":" .. tostring(message.id)
                    local entry=data.authority[key]

                    if entry and entry.version==VERSION then
                        send(sender,{
                            type="recovery_state",
                            role=message.role,
                            id=message.id,
                            version=VERSION,
                            session=data.session,
                            seq=entry.seq,
                            snapshot=entry.snapshot
                        })
                    end

                elseif (message.type=="service_request" or message.type=="service_arrived") and message.session==data.session then
                    upsertServiceRequest(sender,message)

                elseif message.type=="job_accepted" and message.session==data.session then
                    local request=data.requests[message.requestId]
                    local job=data.foremanJobs[message.foremanNumber]
                    if request and request.status~="COMPLETE" and job and job.requestId==message.requestId and
                        data.foremen[message.foremanNumber] and data.foremen[message.foremanNumber].id==sender then
                        if request.status~="BLOCKED" then request.status="IN_PROGRESS" end
                        request.updated=now()
                        job.accepted=true
                        save()
                    end

                elseif message.type=="job_progress" and message.session==data.session then
                    local request=data.requests[message.requestId]
                    local job=request and data.foremanJobs[request.foremanNumber]
                    if request and request.status~="COMPLETE" and job and job.requestId==message.requestId and
                        data.foremen[request.foremanNumber] and data.foremen[request.foremanNumber].id==sender then
                        request.status="IN_PROGRESS"
                        request.phase=message.phase
                        request.trips=(request.trips or 0)+1
                        request.updated=now()
                        save()
                    end

                elseif message.type=="job_blocked" and message.session==data.session then
                    local request=data.requests[message.requestId]
                    local job=request and data.foremanJobs[request.foremanNumber]
                    if request and request.status~="COMPLETE" and job and job.requestId==message.requestId and
                        data.foremen[request.foremanNumber] and data.foremen[request.foremanNumber].id==sender then
                        request.status="BLOCKED"
                        request.blockReason=message.reason
                        request.updated=now()
                        save()
                    end

                elseif message.type=="job_failed" and message.session==data.session then
                    local request=data.requests[message.requestId]
                    local job=request and data.foremanJobs[request.foremanNumber]
                    if request and request.status~="COMPLETE" and job and job.requestId==message.requestId and
                        data.foremen[request.foremanNumber] and data.foremen[request.foremanNumber].id==sender then
                        request.status="PENDING"
                        request.lastError=message.reason
                        request.updated=now()
                        clearForemanJob(request.foremanNumber,message.requestId)
                        save()
                    end

                elseif message.type=="job_complete" and message.session==data.session then
                    local request=data.requests[message.requestId]
                    if request and request.minerId==message.minerId and request.row==tonumber(message.row) and
                        request.foremanNumber==tonumber(message.foremanNumber) and
                        data.foremen[request.foremanNumber] and data.foremen[request.foremanNumber].id==sender then
                        request.status="COMPLETE"
                        request.updated=now()
                        request.completed=now()
                        clearForemanJob(request.foremanNumber,message.requestId)
                        save()
                        flushManager(true)
                        send(request.minerId,{
                            type="service_complete",
                            requestId=request.requestId,
                            session=data.session
                        })
                        request.lastCompletionSend=now()
                        send(sender,{type="job_complete_ack",requestId=message.requestId,session=data.session})
                    end

                elseif message.type=="service_complete_ack" and message.session==data.session then
                    local request=data.requests[message.requestId]
                    if request and request.status=="COMPLETE" and request.minerId==sender then
                        request.minerAcknowledged=true
                        save()
                    end

                elseif message.type=="recall_home" and message.session==data.session and
                    data.recall.active and (message.mode==data.recall.mode or
                        (data.recall.mode=="DUMP" and message.mode=="NORMAL")) then
                    if message.role=="miner" and message.row then
                        local row=tonumber(message.row)
                        local homeFacing=message.dir==DIR_N or (message.mode=="DUMP" and message.dir==DIR_S)
                        if registeredNodeSender("miner",row,sender) and
                            message.x==row and message.y==0 and message.z==0 and homeFacing then
                            data.recall.homeMiners[row]=true
                            if data.recall.mode=="PACK" and row==16 then
                                data.recall.packFreeSlots=tonumber(message.freeSlots) or 0
                            end
                        end
                    elseif message.role=="foreman" and message.number then
                        local n=tonumber(message.number)
                        local idle=n and FOREMAN_IDLE[n]
                        if n and registeredNodeSender("foreman",n,sender) and
                            idle and message.x==idle.x and message.y==idle.y and
                            message.z==idle.z and message.dir==DIR_N then
                            data.recall.homeForemen[n]=true
                        end
                    elseif message.role=="navigator" and message.number then
                        local n=tonumber(message.number)
                        local idle=n and NAVIGATOR_RECALL[n]
                        if n and registeredNodeSender("navigator",n,sender) and
                            idle and message.x==idle.x and message.y==idle.y and
                            message.z==idle.z and message.dir==DIR_N then
                            data.recall.homeNavigators[n]=true
                        end
                    end
                    save()

                elseif message.type=="recall_dump_empty" and message.session==data.session and message.row then
                    local row=tonumber(message.row)
                    local miner=data.miners[row]
                    if data.recall.mode=="DUMP" and miner and miner.id==sender and
                        message.x==row and message.y==0 and message.z==0 and message.dir==DIR_N then
                        data.recall.emptied[row]=true
                        save()
                    end

                elseif message.type=="recall_shutdown_ready" and message.session==data.session then
                    local index=message.role=="miner" and message.row or message.number
                    if registeredNodeSender(message.role,index,sender) then
                        data.recall.shutdown[sender]=true
                        if message.role=="miner" then
                            data.recall.homeMiners[tonumber(index)]=true
                        elseif message.role=="foreman" then
                            data.recall.homeForemen[tonumber(index)]=true
                        elseif message.role=="navigator" then
                            data.recall.homeNavigators[tonumber(index)]=true
                        end
                        save()
                    end

                elseif message.type=="pack_ready" and message.session==data.session and
                    data.recall.mode=="PACK" and
                    (data.recall.state=="PACK_CLEAR" or data.recall.state=="PACK_COLLECT") then
                    local index=message.role=="miner" and message.row or message.number
                    if registeredNodeSender(message.role,index,sender) and
                        sender~=data.recall.targets.miners[16] then
                        data.recall.packReady[sender]=true
                        save()
                        send(sender,{type="pack_ready_ack",session=data.session})
                    end

                elseif message.type=="pack_missing" and message.session==data.session and
                    data.recall.mode=="PACK" and sender==data.recall.targets.miners[16] and
                    tonumber(message.missing) and tonumber(message.missing)>=1 and
                    tonumber(message.missing)<=15 then
                    data.recall.packMissing=data.recall.packMissing or {}
                    local found=false
                    for _,row in ipairs(data.recall.packMissing) do
                        if row==tonumber(message.missing) then found=true end
                    end
                    if not found then data.recall.packMissing[#data.recall.packMissing+1]=tonumber(message.missing) end
                    save()

                elseif message.type=="pack_progress" and message.session==data.session and
                    data.recall.mode=="PACK" and sender==data.recall.targets.miners[16] and
                    data.recall.state=="PACK_COLLECT" and tonumber(message.row)==16 and
                    tonumber(message.x) and tonumber(message.collected)==16-tonumber(message.x) and
                    tonumber(message.x)>=1 and tonumber(message.x)<=16 then
                    data.recall.packCollected=math.max(tonumber(data.recall.packCollected) or 0,
                        tonumber(message.collected))
                    save()

                elseif message.type=="pack_done" and message.session==data.session and
                    data.recall.mode=="PACK" and sender==data.recall.targets.miners[16] and
                    tonumber(message.row)==16 and tonumber(message.x)==1 and
                    tonumber(message.collected)==15 and
                    (data.recall.state=="PACK_COLLECT" or data.recall.state=="PACK_COMPLETE") then
                    data.recall.packCollected=15
                    if type(message.missing)=="table" then
                        data.recall.packMissing=message.missing
                    end
                    data.recall.state="PACK_COMPLETE"
                    data.recall.active=false
                    save()

                elseif message.type=="chunk_ack" and message.session==data.session and
                    data.advance and tonumber(message.chunkIndex)==data.advance.target and
                    message.stage and message.role then
                    local index=message.role=="miner" and message.row or message.number
                    local stage=data.advance.phase
                    if registeredNodeSender(message.role,index,sender) and
                        (message.stage==stage or
                            (stage=="COLLECT_M" and message.stage=="VERIFY_F")) then
                        local valid=true
                        if message.role=="foreman" and message.stage=="STAGE_F" then
                            local n=tonumber(index)
                            valid=n and FOREMAN_IDLE[n] and
                                tonumber(message.x)==FOREMAN_IDLE[n].x and
                                tonumber(message.y)==0 and tonumber(message.z)==-1 and
                                tonumber(message.dir)==DIR_N
                        end
                        if valid then
                            if message.role=="foreman" and message.stage=="STAGE_F" then
                                local foreman=data.foremen[tonumber(index)]
                                foreman.x=tonumber(message.x)
                                foreman.y=tonumber(message.y)
                                foreman.z=tonumber(message.z)
                                foreman.dir=tonumber(message.dir)
                                foreman.lastSeen=now()
                            end
                            data.advance.acks[chunkKey(message.role,index)]=true
                            save()
                        end
                    end

                elseif message.type=="miner_complete" and message.session==data.session and message.row then
                    local m=registeredNodeSender("miner",message.row,sender) and data.miners[tonumber(message.row)]
                    if m then
                        m.state="COMPLETE"
                        m.lastSeen=now()
                    end
                    save()
                end

                updateRecallState()
            end

        elseif event[1]=="char" then
            input=input .. event[2]
            drawTerminal()

        elseif event[1]=="key" and event[2]==keys.backspace then
            input=string.sub(input,1,math.max(0,#input-1))
            drawTerminal()

        elseif event[1]=="key" and event[2]==keys.enter then
            local command=input
            input=""
            activateCommand(command)
            drawTerminal()
            drawMonitor()

        elseif event[1]=="monitor_touch" and event[2]==monitorSide then
            local command=clicked(monitorButtons,event[3],event[4])
            if command then activateCommand(command);drawTerminal();drawMonitor() end

        elseif event[1]=="mouse_click" and event[2]==1 then
            local command=clicked(terminalButtons,event[3],event[4])
            if command then activateCommand(command);drawTerminal();drawMonitor() end

        elseif event[1]=="timer" and event[2]==timer then
            local elapsed=now()-radioWindowStart
            if elapsed>=10 then
                radioRxRate=radioRxWindow/elapsed
                radioTxRate=radioTxWindow/elapsed
                radioRxWindow=0
                radioTxWindow=0
                radioWindowStart=now()
            end
            if not data.paired and now()-lastPair>=2 then
                sendPairOffer(nil)
                lastPair=now()
            end

            if now()-lastQuery>=60 then
                announceManagerOnline()
                releaseSwarm()
                lastQuery=now()
            end

            if now()-lastDispatch>=0.5 and
                (data.recall.state=="NORMAL" or data.recall.state=="DUMP_RECALLING") then
                dispatchJobs()
                lastDispatch=now()
            end

            if data.recall.active and now()-lastRecall>=3 then
                if data.recall.mode=="DUMP" then
                    if data.recall.foremenFinalizing then
                        sendDumpFinalRecall()
                    else
                        wakeForemenForDump()
                        sendRecallToNodes("DUMP",true)
                    end
                elseif data.recall.mode=="PACK" then
                    if data.recall.state=="PACK_RECALL" then
                        sendRecallToNodes("PACK",false)
                    elseif data.recall.state=="PACK_CLEAR" then
                        for _,id in pairs(data.recall.targets.miners) do
                            if id~=data.recall.targets.miners[16] and not data.recall.packReady[id] then
                                send(id,{type="pack_clear",session=data.session})
                            end
                        end
                        for _,group in ipairs({data.recall.targets.foremen,data.recall.targets.navigators}) do
                            for _,id in pairs(group) do
                                if not data.recall.packReady[id] then send(id,{type="pack_clear",session=data.session}) end
                            end
                        end
                    elseif data.recall.state=="PACK_COLLECT" and now()>=(data.recall.collectAfter or 0) then
                        send(data.recall.targets.miners[16],{
                            type="pack_collect",session=data.session
                        })
                    end
                elseif data.recall.mode=="NORMAL" or data.recall.mode=="SHUTDOWN" then
                    sendRecallToNodes(data.recall.mode,false)
                end
                lastRecall=now()
            end

            if data.recall.state=="NORMAL" and now()<resumeUntil and now()-lastResumeSend>=5 then
                sendControl({
                    type="resume_swarm",
                    session=data.session
                },nil,true)
                lastResumeSend=now()
            end

            refreshGpsReady()
            updateRecallState()
            if not data.advance and
                (data.managerBucketSlot or
                 (turtle.getFuelLevel()~="unlimited" and
                  turtle.getFuelLevel()<=FOREMAN_FUEL_LOW)) and
                now()-(data.lastManagerFuelAttempt or 0)>=10 then
                data.lastManagerFuelAttempt=now()
                refuelManagerAtChest(1000)
            end
            runChunkAdvance()

            local expiredRequests={}
            for requestId,request in pairs(data.requests) do
                if request.status=="COMPLETE" and not request.minerAcknowledged and
                    now()-(request.lastCompletionSend or 0)>=2 then
                    send(request.minerId,{
                        type="service_complete",
                        requestId=requestId,
                        session=data.session
                    })
                    request.lastCompletionSend=now()
                end
                if request.status=="COMPLETE" and request.minerAcknowledged and
                    now()-(request.completed or now())>300 then
                    expiredRequests[#expiredRequests+1]=requestId
                end
            end
            for _,requestId in ipairs(expiredRequests) do
                data.requests[requestId]=nil
            end

            flushManager(false)
            drawTerminal()
            drawMonitor()
            sendObserverSnapshot(false)
            timer=os.startTimer(1)
        end
    end
end


runRegionalManager()

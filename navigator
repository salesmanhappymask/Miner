local function runNavigator(cfg)
    setRegionalManager(cfg.managerId)

    if not openNetwork() then
        error("Navigator wireless modem not found")
    end

    local statePath="navigator" .. tostring(cfg.number) .. ".tmp"
    local state=loadTableLight(statePath)
    local deploymentRecall=nil
    if not state then
        state={
            x=tonumber(cfg.startX) or 1,
            y=tonumber(cfg.startY) or 0,
            z=tonumber(cfg.startZ) or -1,
            dir=tonumber(cfg.startDir) or DIR_S,
            orientationCalibrated=false,
            deployed=false
        }
        if cfg.deployed or cfg.deploymentStarted then
            state.recoveryLocked=true
            state.recoveryReason="Navigator position file missing after deployment"
        end
        if not saveTableLight(statePath,state) then error("Navigator state write failed") end
    end

    if not state.orientationCalibrated and (state.orientationScanIntent or (state.turnIntent and not state.deployed)) then
        state.orientationScanIntent=nil
        state.turnIntent=nil
        if not saveTableLight(statePath,state) then error("Navigator orientation recovery write failed") end
    end

    local bootHadIntent=state.motionIntent or state.turnIntent or state.chunkMoveIntent or
        state.loaderIntent or state.recoveryProbeIntent

    local function save()
        state.fuelWitness=turtle.getFuelLevel()
        if not saveTableLight(statePath,state) then
            error("Navigator state write failed; movement halted")
        end
    end

    state.chunkIndex=tonumber(state.chunkIndex) or 0
    state.seq=tonumber(state.seq) or 0
    cfg.loaderExpected=tonumber(cfg.number)==1 or tonumber(cfg.number)==3
    state.loaderExpected=cfg.loaderExpected and true or false
    state.loaderPlaced=state.loaderPlaced and true or false
    state.loaderSlot=tonumber(state.loaderSlot)
    if state.loaderPlaced and not state.loaderSite then
        local site=NAVIGATOR_SITES[tonumber(cfg.number)]
        local home=NAVIGATOR_RECALL[tonumber(cfg.number)]
        if site and state.x==site.x and state.y==site.y and state.z==site.z then
            state.loaderSite="WORK"
        elseif home and state.x==home.x and state.y==home.y and state.z==home.z then
            state.loaderSite="RECALL"
        end
    end
    if state.awaitingLoader and state.loaderExpected and not state.loaderPlaced and not state.loaderSlot then
        local found=nil
        local multiple=false
        for slot=1,16 do
            if turtle.getItemCount(slot)>0 then
                if found then multiple=true else found=slot end
            end
        end
        if found and not multiple then
            state.loaderSlot=found
            state.awaitingLoader=nil
            saveTableLight(statePath,state)
        elseif multiple then
            state.recoveryLocked=true
            state.recoveryReason="Chunk Loader handoff recovery found multiple untracked inventory items"
            saveTableLight(statePath,state)
        end
    end
    if type(state.loaderIntent)=="table" then
        local intent=state.loaderIntent
        if intent.action=="PLACE" and tonumber(intent.slot) then
            local slot=tonumber(intent.slot)
            local before=tonumber(intent.countBefore) or 0
            if turtle.getItemCount(slot)<before then
                local placedHere=turtle.detect()
                if turtle.inspect then
                    local inspectOk,inspectPresent=pcall(turtle.inspect)
                    if inspectOk then placedHere=inspectPresent==true end
                end
                if placedHere then
                    state.loaderPlaced=true
                    state.loaderSlot=nil
                    state.loaderChunk=state.chunkIndex
                    state.loaderSite=intent.loaderSite or state.loaderSite or "WORK"
                else
                    state.loaderPlaced=false
                    state.loaderSlot=nil
                    state.recoveryLocked=true
                    state.recoveryReason="Interrupted Chunk Loader placement consumed the item without a block at the expected position"
                end
            end
            state.loaderIntent=nil
            saveTableLight(statePath,state)
        elseif intent.action=="PICKUP" then
            local before=tonumber(intent.totalBefore) or 0
            local total=0
            local found=nil
            local multiple=false
            for slot=1,16 do
                local count=turtle.getItemCount(slot)
                total=total+count
                if count>0 then
                    if found then multiple=true else found=slot end
                end
            end
            if total>before and found and not multiple then
                state.loaderPlaced=false
                state.loaderSlot=found
                state.loaderChunk=nil
                state.loaderSite=nil
            elseif total>before then
                state.recoveryLocked=true
                state.recoveryReason="Interrupted Chunk Loader recovery left an ambiguous inventory"
            end
            state.loaderIntent=nil
            saveTableLight(statePath,state)
        else
            state.loaderIntent=nil
            saveTableLight(statePath,state)
        end
    end
    resolveChunkMove(state,function()
        if not saveTableLight(statePath,state) then error("Navigator move recovery write failed") end
    end,cfg.worldOrigin)

    local function navigatorPoseValid()
        return type(state.x)=="number" and type(state.y)=="number" and
            type(state.z)=="number" and type(state.dir)=="number" and
            state.x>=-2 and state.x<=19 and state.z>=-2 and
            state.z<=(state.chunkTravel and 31 or 16) and state.y>=0 and
            state.y<=18 and state.dir>=0 and state.dir<=3
    end

    local function navigatorSnapshot()
        local raw=textutils.serialize(state)
        local snapshot=textutils.unserialize(raw)
        snapshot.motionIntent=nil
        snapshot.turnIntent=nil
        snapshot.orientationScanIntent=nil
        snapshot.recoveryProbeIntent=nil
        snapshot.chunkMoveIntent=nil
        snapshot.loaderIntent=nil
        return snapshot
    end

    local function checkpointNavigator()
        checkpointPose("navigator",state.seq,navigatorSnapshot(),cfg.session)
    end

    local function attemptNavigatorRecovery()
        local priorLock=state.recoveryLocked and state.recoveryReason or nil
        local hadPending=state.motionIntent or state.turnIntent or state.chunkMoveIntent or
            state.recoveryProbeIntent
        if state.chunkMoveIntent then
            resolveChunkMove(state,function() save() end,cfg.worldOrigin)
            if state.chunkMoveIntent then return false end
        end
        if state.motionIntent then
            local intent=state.motionIntent
            local moved=movementFromFuel(intent.fuelBefore,turtle.getFuelLevel())
            if moved==nil then
                moved=movementFromGPS(intent,state.chunkIndex,cfg.worldOrigin,2)
            end
            if moved==nil or type(intent.from)~="table" or type(intent.to)~="table" then
                state.recoveryLocked=true
                state.recoveryReason="Navigator interrupted move is waiting for recovery GPS"
                save()
                return false
            end
            local pose=moved and intent.to or intent.from
            state.x=pose.x
            state.y=pose.y
            state.z=pose.z
            if moved and tonumber(intent.seq) then state.seq=math.max(state.seq,tonumber(intent.seq)) end
            state.motionIntent=nil
        end

        if state.recoveryProbeIntent and not state.turnIntent then
            local recoveredDir,reason=recoverFacingByGPS(state,cfg.worldOrigin,function() save(); return true end)
            if not recoveredDir then
                state.recoveryLocked=true
                state.recoveryReason=reason or "Navigator interrupted facing probe could not recover"
                save()
                return false
            end
            state.dir=recoveredDir
        end

        if state.turnIntent then
            local recoveredDir,reason=recoverFacingByGPS(state,cfg.worldOrigin,function() save(); return true end)
            if not recoveredDir then
                state.recoveryLocked=true
                state.recoveryReason=reason or "Navigator interrupted turn has an uncertain direction"
                save()
                return false
            end
            state.dir=recoveredDir
            if tonumber(state.turnIntent.seq) then state.seq=math.max(state.seq,tonumber(state.turnIntent.seq)) end
            state.turnIntent=nil
        end

        if not navigatorPoseValid() then
            state.recoveryLocked=true
            state.recoveryReason="Navigator saved pose is outside its operating area"
            save()
            return false
        end

        if priorLock and not hadPending then
            if priorLock:find("Chunk Loader",1,true) then return false end
            if not priorLock:find("Fuel differs",1,true) and
                not priorLock:find("GPS is unavailable",1,true) then
                local x,y,z=locateWorldPose(2)
                if not x or not poseMatchesWorld(state,cfg.worldOrigin,x,y,z) then
                    state.recoveryLocked=true
                    state.recoveryReason=priorLock
                    save()
                    return false
                end
            end
        end

        local verified,reason,witnessUpdated=verifyBootWitness(state,cfg.worldOrigin,hadPending and true or false)
        if not verified then
            state.recoveryLocked=true
            state.recoveryReason=reason
            save()
            return false
        end

        state.recoveryLocked=nil
        state.recoveryReason=nil
        state.navigationError=nil
        state.fuelWitness=turtle.getFuelLevel()
        save()
        checkpointNavigator()
        return true
    end

    if state.recoveryProbeIntent and not state.recoveryLocked then
        state.recoveryLocked=true
        state.recoveryReason="Interrupted transactional facing probe"
        save()
    end

    if state.motionIntent or state.turnIntent or state.recoveryProbeIntent or state.recoveryLocked then
        attemptNavigatorRecovery()
    else
        local verified,reason,witnessUpdated=verifyBootWitness(state,cfg.worldOrigin,bootHadIntent)
        if not verified then
            state.recoveryLocked=true
            state.recoveryReason=reason
            save()
        elseif witnessUpdated then
            save()
        end
    end

    local function turnRight()
        if state.recoveryLocked or deploymentRecall then return false end
        local intent={seq=state.seq+1,from=state.dir,to=(state.dir+1)%4}
        state.turnIntent=intent
        save()
        if not turtle.turnRight() then
            state.turnIntent=nil
            save()
            return false
        end
        state.dir=intent.to
        state.seq=intent.seq
        checkpointNavigator()
        state.turnIntent=nil
        save()
        return true
    end

    local function face(target)
        target=target%4
        while state.dir~=target do
            if not turnRight() then return false end
        end
        return true
    end

    local function inventoryTotal()
        local total=0
        for slot=1,16 do total=total+turtle.getItemCount(slot) end
        return total
    end

    local function inventoryFreeSlots()
        local free=0
        for slot=1,16 do if turtle.getItemCount(slot)==0 then free=free+1 end end
        return free
    end

    local function dumpOrdinaryItems()
        local selected=turtle.getSelectedSlot()
        for slot=1,16 do
            if slot~=state.loaderSlot and turtle.getItemCount(slot)>0 then
                turtle.select(slot)
                if not turtle.dropUp() then
                    if not turtle.dropDown() then turtle.drop() end
                end
            end
        end
        turtle.select(selected)
        return inventoryFreeSlots()>0 or
            (state.loaderSlot and turtle.getItemCount(state.loaderSlot)==0)
    end

    local function clearObstacle(kind)
        if inventoryFreeSlots()==0 then dumpOrdinaryItems() end
        local side=kind=="forward" and "front" or (kind=="up" and "top" or "bottom")
        local peripheralType=peripheral.getType(side)
        if peripheralType then
            state.navigationError="Navigator path occupied by peripheral "..tostring(peripheralType).." on "..side
            save()
            return false,state.navigationError
        end
        local detected=false
        local dug=false
        local attacked=false
        local digReason=nil
        local attackReason=nil
        if kind=="forward" then
            detected=turtle.detect()
            if detected then dug,digReason=turtle.dig() else attacked,attackReason=turtle.attack() end
        elseif kind=="up" then
            detected=turtle.detectUp()
            if detected then dug,digReason=turtle.digUp() else attacked,attackReason=turtle.attackUp() end
        else
            detected=turtle.detectDown()
            if detected then dug,digReason=turtle.digDown() else attacked,attackReason=turtle.attackDown() end
        end
        if inventoryFreeSlots()==0 then dumpOrdinaryItems() end
        if detected and not dug then
            state.navigationError="Cannot clear "..kind.." obstruction: "..tostring(digReason or "dig failed")
            save()
            return false,state.navigationError
        end
        if not detected and not attacked and attackReason then
            state.navigationError="Cannot clear "..kind.." movement: "..tostring(attackReason)
            save()
        end
        return true,state.navigationError
    end

    local function moveTracked(kind,tx,ty,tz)
        if state.recoveryLocked or deploymentRecall or tx< -2 or tx>19 or tz< -2 or tz>31 or
            ty<0 or ty>18 then return false end
        local attempts=0
        while attempts<20 do
            local intent={
                seq=state.seq+1,
                kind=kind,
                fuelBefore=turtle.getFuelLevel(),
                from={x=state.x,y=state.y,z=state.z},
                to={x=tx,y=ty,z=tz}
            }
            state.motionIntent=intent
            save()
            local moved,reason
            if kind=="forward" then moved,reason=turtle.forward()
            elseif kind=="up" then moved,reason=turtle.up()
            else moved,reason=turtle.down() end
            if moved then
                state.x=tx
                state.y=ty
                state.z=tz
                state.seq=intent.seq
                state.navigationError=nil
                checkpointNavigator()
                state.motionIntent=nil
                save()
                return true
            end
            state.motionIntent=nil
            save()
            attempts=attempts+1
            local cleared,clearReason=clearObstacle(kind)
            if not cleared then
                state.navigationError=clearReason or reason or ("Navigator "..kind.." blocked")
                save()
                return false
            end
            sleep(0.1)
        end
        state.navigationError="Navigator "..kind.." remained blocked after 20 clear attempts"
        save()
        return false
    end

    local function step(dir)
        if not face(dir) then return false end
        local x,z=state.x,state.z
        if dir==DIR_N then z=z+1
        elseif dir==DIR_E then x=x+1
        elseif dir==DIR_S then z=z-1
        else x=x-1 end
        return moveTracked("forward",x,state.y,z)
    end

    local function vertical(targetY)
        while state.y<targetY do
            if not moveTracked("up",state.x,state.y+1,state.z) then return false end
        end
        while state.y>targetY do
            if not moveTracked("down",state.x,state.y-1,state.z) then return false end
        end
        return true
    end

    local function refuelStartupFuel(fuelKind)
        if turtle.getFuelLevel()=="unlimited" then return true end
        local selected=turtle.getSelectedSlot()
        for slot=1,16 do
            turtle.select(slot)
            while turtle.getItemCount(slot)>0 and turtle.getFuelLevel()<800 and
                turtle.refuel(0) do
                if not turtle.refuel(1) then return false end
            end
        end
        for slot=1,16 do
            turtle.select(slot)
            local detail=turtle.getItemDetail and turtle.getItemDetail(slot)
            if turtle.getItemCount(slot)>0 and
                (matchesItem(detail,"empty_bucket") or
                 matchesItem(detail,"lava_bucket") or
                 (fuelKind=="lava_bucket" and not detail and not turtle.refuel(0))) then
                if not face(DIR_S) then return false end
                if not turtle.drop(1) then return false end
                if not face(DIR_N) then return false end
            end
        end
        turtle.select(selected)
        return turtle.getFuelLevel()>=800
    end

    local function loaderInInventory()
        return state.loaderExpected and state.loaderSlot and
            turtle.getItemCount(state.loaderSlot)>0
    end

    local function findLoaderReceiptSlot()
        local found=nil
        for slot=1,16 do
            if turtle.getItemCount(slot)>0 then
                if found then return nil end
                found=slot
            end
        end
        return found
    end

    local function placeChunkLoader(loaderSite)
        if not state.loaderExpected then return true end
        loaderSite=loaderSite or "WORK"
        if state.loaderPlaced then
            if state.loaderSite==loaderSite then return true end
            return false,"Chunk Loader is already deployed at "..tostring(state.loaderSite or "an unknown site")
        end
        if not loaderInInventory() then
            return false,"Chunk Loader item 781 is not in Navigator inventory"
        end
        if not face(DIR_S) then return false,"Cannot face south to place Chunk Loader" end
        local protectedType=peripheral.getType("front")
        if protectedType then
            face(DIR_N)
            return false,"Chunk Loader target is occupied by peripheral "..tostring(protectedType)
        end
        pcall(turtle.dig)
        sleep(0.1)
        protectedType=peripheral.getType("front")
        local targetOccupied=turtle.detect()
        if turtle.inspect then
            local inspectOk,inspectPresent=pcall(turtle.inspect)
            if inspectOk then targetOccupied=inspectPresent==true end
        end
        if protectedType or targetOccupied then
            face(DIR_N)
            return false,"Chunk Loader target could not be cleared to the Navigator equipment level"
        end
        local slot=state.loaderSlot
        local before=turtle.getItemCount(slot)
        state.loaderIntent={action="PLACE",slot=slot,countBefore=before,
            chunkIndex=state.chunkIndex,x=state.x,y=state.y,z=state.z,loaderSite=loaderSite}
        save()
        turtle.select(slot)
        local ok,reason=turtle.place()
        local placedHere=turtle.detect() or peripheral.getType("front")~=nil
        if turtle.inspect then
            local inspectOk,inspectPresent=pcall(turtle.inspect)
            if inspectOk then placedHere=inspectPresent==true end
        end
        if not ok or turtle.getItemCount(slot)>=before or not placedHere then
            state.loaderIntent=nil
            save()
            face(DIR_N)
            return false,"Chunk Loader placement failed exact-position verification: "..tostring(reason or "target blocked")
        end
        state.loaderPlaced=true
        state.loaderSlot=nil
        state.loaderChunk=state.chunkIndex
        state.loaderSite=loaderSite
        state.loaderIntent=nil
        save()
        face(DIR_N)
        return true
    end

    local function retrieveChunkLoader()
        if not state.loaderExpected then return true end
        if loaderInInventory() and not state.loaderPlaced then return true end
        if not state.loaderPlaced then
            return false,"Chunk Loader ownership state is uncertain"
        end
        dumpOrdinaryItems()
        if inventoryFreeSlots()==0 then return false,"No free slot to recover Chunk Loader" end
        if not face(DIR_S) then return false,"Cannot face south to recover Chunk Loader" end
        local before=inventoryTotal()
        state.loaderIntent={action="PICKUP",totalBefore=before,
            chunkIndex=state.chunkIndex,x=state.x,y=state.y,z=state.z}
        save()
        local ok,reason=turtle.dig()
        if not ok then
            state.loaderIntent=nil
            save()
            face(DIR_N)
            return false,"Chunk Loader recovery failed: "..tostring(reason or "dig failed")
        end
        sleep(0.1)
        local slot=findLoaderReceiptSlot()
        if inventoryTotal()<=before or not slot then
            state.loaderIntent=nil
            save()
            face(DIR_N)
            return false,"Chunk Loader recovery did not produce a single protected item"
        end
        state.loaderPlaced=false
        state.loaderSlot=slot
        state.loaderChunk=nil
        state.loaderSite=nil
        state.loaderIntent=nil
        save()
        face(DIR_N)
        return true
    end

    local function clearForwardForChunk(moveReason)
        local ok,reason=clearObstacle("forward")
        if not ok then return false,reason or moveReason end
        return true,reason
    end

    local function calibrateOrientation()
        if state.orientationCalibrated then
            return true
        end

        state.dir=tonumber(cfg.startDir) or state.dir or DIR_N
        state.orientationScanIntent=nil
        local anchored=false
        for attempt=1,4 do
            local ok,behind=pcall(peripheral.call,"back","getID")
            if ok and tonumber(behind)==tonumber(cfg.masterForemanId) then
                anchored=true
                break
            end
            if attempt<4 then
                state.orientationScanIntent={attempt=attempt}
                save()
                if not turtle.turnRight() then
                    state.orientationScanIntent=nil
                    save()
                    return false
                end
                state.orientationScanIntent=nil
                save()
            end
        end
        if not anchored then
            state.recoveryLocked=true
            state.recoveryReason="Master Foreman not detected behind Navigator during orientation scan"
            save()
            return false
        end

        state.dir=DIR_N
        state.orientationAnchor="MASTER_BACK"
        state.orientationCalibrated=true
        cfg.orientationAnchor="MASTER_BACK"
        saveTable("node.cfg",cfg)
        save()
        return true
    end

    local function announceTraveling()
        for i=1,3 do
            send(cfg.controller,{
                type="navigator_traveling",
                id=os.getComputerID(),
                number=cfg.number,
                x=state.x,
                y=state.y,
                z=state.z
            })
            sleep(0.1)
        end
    end

    local function travelToSite()
        local site=NAVIGATOR_SITES[cfg.number]
        local launch=NAVIGATOR_LAUNCH[cfg.number]
        local cruise=NAVIGATOR_CRUISE[cfg.number]
        if not site or not launch then return false end

        if not calibrateOrientation() then
            return false
        end

        while state.x<launch.x do
            if not step(DIR_E) then return false end
        end
        while state.x>launch.x do
            if not step(DIR_W) then return false end
        end
        while state.z<launch.z do
            if not step(DIR_N) then return false end
        end
        while state.z>launch.z do
            if not step(DIR_S) then return false end
        end

        if not vertical(cruise) then
            return false
        end

        announceTraveling()

        while state.x<site.x do
            if not step(DIR_E) then return false end
        end
        while state.x>site.x do
            if not step(DIR_W) then return false end
        end
        while state.z<site.z do
            if not step(DIR_N) then return false end
        end
        while state.z>site.z do
            if not step(DIR_S) then return false end
        end

        if not vertical(site.y) then return false end

        if state.loaderExpected then
            local placed,reason=placeChunkLoader("WORK")
            if not placed then
                state.navigationError=reason
                save()
                return false
            end
        end

        state.deployed=true
        state.deploying=false
        cfg.deployed=true
        save()
        saveTable("node.cfg",cfg)
        return true
    end

    local function clearNavigatorLabel()
        for i=1,5 do
            os.setComputerLabel(nil)

            if os.getComputerLabel()==nil then
                return true
            end

            sleep(0.1)
        end

        return os.getComputerLabel()==nil
    end

    local function moveToRecallHome()
        local target=NAVIGATOR_RECALL[tonumber(cfg.number)]
        if not target then return false end
        local targetX=target.x
        local targetY=target.y
        local targetZ=target.z
        local extended=state.chunkTravel or state.z>16
        if extended and not state.chunkTravel then
            state.chunkTravel=true
            save()
        end
        local alreadyHome=
            state.x==targetX and
            state.y==targetY and
            state.z==targetZ
        if not alreadyHome then
            if not vertical(NAVIGATOR_CRUISE[cfg.number]) then return false end
            while state.x<targetX do
                if not step(DIR_E) then return false end
            end
            while state.x>targetX do
                if not step(DIR_W) then return false end
            end
            while state.z<targetZ do
                if not step(DIR_N) then return false end
            end
            while state.z>targetZ do
                if not step(DIR_S) then return false end
            end
            if not vertical(targetY) then return false end
        end
        if not face(DIR_N) then return false end
        state.chunkTravel=nil
        save()
        return true
    end

    local function finishRecallHome(mode,allowShutdown)
        state.recalled=true
        state.recallMode=mode
        if mode=="PACK" then
            state.packReady=nil
            state.packAcknowledged=nil
        end
        save()
        send(cfg.managerId,{
            type="recall_home",
            role="navigator",
            number=cfg.number,
            id=os.getComputerID(),
            mode=mode,
            packToken=mode=="PACK" and state.packToken or nil,
            x=state.x,
            y=state.y,
            z=state.z,
            dir=state.dir,
            loaderPlaced=state.loaderPlaced and true or false,
            loaderSite=state.loaderSite,
            session=cfg.session
        })
        if mode=="SHUTDOWN" and allowShutdown then
            if not clearNavigatorLabel() then
                status("navigator","RECOVERY_LOCK",{
                    number=cfg.number,
                    x=state.x,
                    y=state.y,
                    z=state.z,
                    message="Recall home reached but Navigator label could not be cleared",
                    session=cfg.session
                })
                return false
            end
            for shutdownAttempt=1,8 do
                send(cfg.managerId,{
                    type="recall_shutdown_ready",
                    role="navigator",
                    number=cfg.number,
                    id=os.getComputerID(),
                    x=state.x,
                    y=state.y,
                    z=state.z,
                    dir=state.dir,
                    loaderPlaced=state.loaderPlaced and true or false,
                    session=cfg.session
                })
                sleep(0.1)
            end
            os.shutdown()
        end
        return true
    end

    local function recallNavigator(mode)
        mode=mode or "NORMAL"
        if state.recoveryLocked and not attemptNavigatorRecovery() then
            state.navigationError=state.recoveryReason or "Navigator recovery is not complete"
            save()
            return false
        end
        if mode=="PACK" then state.packPending=nil end
        if state.loaderExpected and state.loaderPlaced then
            local recovered,reason=retrieveChunkLoader()
            if not recovered then
                state.navigationError=reason
                save()
                return false
            end
        end
        if state.loaderExpected and not loaderInInventory() then
            state.navigationError="Chunk Loader is not secured for recall"
            save()
            return false
        end
        if not moveToRecallHome() then return false end
        return finishRecallHome(mode,true)
    end

    local function recallLoaderAck(action,mode)
        send(cfg.managerId,{
            type="recall_loader_ack",
            role="navigator",
            number=cfg.number,
            id=os.getComputerID(),
            action=action,
            mode=mode,
            x=state.x,
            y=state.y,
            z=state.z,
            dir=state.dir,
            loaderPlaced=state.loaderPlaced and true or false,
            loaderSite=state.loaderSite,
            loaderCarried=loaderInInventory() and true or false,
            session=cfg.session
        })
    end

    local function recallLoaderBlocked(action,reason)
        state.navigationError=reason
        save()
        send(cfg.managerId,{
            type="recall_loader_blocked",
            role="navigator",
            number=cfg.number,
            id=os.getComputerID(),
            action=action,
            reason=reason,
            x=state.x,
            y=state.y,
            z=state.z,
            loaderPlaced=state.loaderPlaced and true or false,
            loaderSite=state.loaderSite,
            session=cfg.session
        })
    end

    local function handleRecallLoaderCommand(message)
        local action=tostring(message.action or "")
        local mode=message.mode or "NORMAL"
        local home=NAVIGATOR_RECALL[tonumber(cfg.number)]
        if not home then
            recallLoaderBlocked(action,"Navigator recall position is undefined")
            return false
        end
        if action=="N1_HOME_ANCHOR" and tonumber(cfg.number)==1 then
            if state.recalled and state.x==home.x and state.y==home.y and state.z==home.z and
                state.loaderPlaced and state.loaderSite=="RECALL" then
                recallLoaderAck(action,mode)
                return true
            end
            if state.loaderPlaced then
                local ok,reason=retrieveChunkLoader()
                if not ok then recallLoaderBlocked(action,reason) return false end
            end
            if not loaderInInventory() then
                recallLoaderBlocked(action,"Navigator-1 does not have its Chunk Loader for recall handoff")
                return false
            end
            if not moveToRecallHome() then
                recallLoaderBlocked(action,state.navigationError or "Navigator-1 could not reach recall home")
                return false
            end
            local placed,reason=placeChunkLoader("RECALL")
            if not placed then recallLoaderBlocked(action,reason) return false end
            state.navigationError=nil
            finishRecallHome(mode,false)
            recallLoaderAck(action,mode)
            return true
        elseif action=="N3_HOME" and tonumber(cfg.number)==3 then
            if state.recalled and state.x==home.x and state.y==home.y and state.z==home.z and
                not state.loaderPlaced and loaderInInventory() then
                recallLoaderAck(action,mode)
                return true
            end
            if state.loaderPlaced then
                local ok,reason=retrieveChunkLoader()
                if not ok then recallLoaderBlocked(action,reason) return false end
            end
            if not loaderInInventory() then
                recallLoaderBlocked(action,"Navigator-3 does not have its Chunk Loader for recall")
                return false
            end
            if not moveToRecallHome() then
                recallLoaderBlocked(action,state.navigationError or "Navigator-3 could not reach recall home")
                return false
            end
            state.navigationError=nil
            recallLoaderAck(action,mode)
            return finishRecallHome(mode,true)
        elseif action=="N1_COLLECT_HOME" and tonumber(cfg.number)==1 then
            if state.x~=home.x or state.y~=home.y or state.z~=home.z then
                recallLoaderBlocked(action,"Navigator-1 is not at recall home for final Chunk Loader collection")
                return false
            end
            if state.loaderPlaced then
                local ok,reason=retrieveChunkLoader()
                if not ok then recallLoaderBlocked(action,reason) return false end
            end
            if not loaderInInventory() then
                recallLoaderBlocked(action,"Navigator-1 final recall Chunk Loader is not secured")
                return false
            end
            state.navigationError=nil
            recallLoaderAck(action,mode)
            return finishRecallHome(mode,true)
        end
        recallLoaderBlocked(action,"Unexpected recall Chunk Loader command for Navigator-"..tostring(cfg.number))
        return false
    end

    if state.recoveryLocked then
        status("navigator","RECOVERY_LOCK",{
            number=cfg.number,
            x=state.x,y=state.y,z=state.z,
            message=state.recoveryReason,session=cfg.session
        })
    end

    if not ensureManagerRegistration(cfg) then
        error("Navigator Regional Manager registration failed")
    end

    if not state.deployed then
        local function setupMessage(sender,message)
            if type(message)~="table" then return end
            if sender==cfg.managerId and message.session==cfg.session and
                message.type=="recall_command" then
                deploymentRecall=message.mode or "NORMAL"
                if deploymentRecall=="PACK" then
                    state.packPending=nil
                    state.packToken=tonumber(message.packToken)
                elseif deploymentRecall=="NORMAL" and message.packPending==true then
                    state.packPending=true
                else
                    state.packPending=nil
                    state.packToken=nil
                end
                save()
            elseif sender==cfg.controller and message.type=="configure" and
                message.target==os.getComputerID() then
                send(cfg.controller,{type="install_ok",role="navigator",number=cfg.number})
            end
        end

        local function pauseDeployment()
            local mode=deploymentRecall or state.recallMode or "NORMAL"
            deploymentRecall=nil
            if not state.recalled or state.recallMode~=mode then
                if not recallNavigator(mode) then
                    status("navigator","RECALL_BLOCKED",{
                        number=cfg.number,x=state.x,y=state.y,z=state.z,
                        message="Initial deployment recall route blocked",
                        session=cfg.session
                    })
                    return false
                end
            end
            local lastHome=0
            while state.recalled do
                local sender,message=rednet.receive(PROTOCOL,1)
                if sender==cfg.managerId and type(message)=="table" and
                    message.session==cfg.session then
                    if message.type=="resume_swarm" and state.recallMode~="PACK" and not state.packPending then
                        state.recalled=false
                        state.recallMode=nil
                        save()
                    elseif message.type=="recall_command" and
                        message.mode~=state.recallMode then
                        if message.mode=="PACK" then state.packToken=tonumber(message.packToken) end
                        if not recallNavigator(message.mode or "NORMAL") then
                            status("navigator","RECALL_BLOCKED",{
                                number=cfg.number,x=state.x,y=state.y,z=state.z,
                                message="Initial deployment recall route blocked",
                                session=cfg.session
                            })
                        end
                    elseif message.type=="pack_clear" and state.recallMode=="PACK" and
                        tonumber(message.packToken)==tonumber(state.packToken) then
                        if clearNavigatorLabel() then
                            state.packReady=true
                            state.packAcknowledged=nil
                            save()
                            send(cfg.managerId,{type="pack_ready",role="navigator",
                                number=cfg.number,packToken=state.packToken,labelCleared=true,
                                x=state.x,y=state.y,z=state.z,dir=state.dir,session=cfg.session})
                        end
                    end
                end
                if state.recalled and now()-lastHome>=3 then
                    send(cfg.managerId,{type="recall_home",role="navigator",
                        number=cfg.number,id=os.getComputerID(),mode=state.recallMode,
                        packToken=state.recallMode=="PACK" and state.packToken or nil,
                        x=state.x,y=state.y,z=state.z,dir=state.dir,
                        session=cfg.session})
                    lastHome=now()
                end
            end
            return true
        end

        while not state.deployed do
            if deploymentRecall or state.recalled then
                if not pauseDeployment() then sleep(1) end
            else
                local deployRequested=state.deploying and true or false
                local startupFuelKind=state.startupFuelKind
                local alreadyTraveling=state.deploying and
                    (state.x~=cfg.startX or state.y~=cfg.startY or state.z~=cfg.startZ)

                local lastWaitingStatus=-10
                while not deployRequested and not deploymentRecall do
                    if now()-lastWaitingStatus>=5 then
                        status("navigator","WAITING_DEPLOY",{
                            number=cfg.number,x=state.x,y=state.y,z=state.z,
                            gpsHost=false,session=cfg.session
                        })
                        lastWaitingStatus=now()
                    end
                    local sender,message=rednet.receive(PROTOCOL,1)
                    setupMessage(sender,message)
                    if sender==cfg.controller and type(message)=="table" and
                        message.type=="deploy_navigator" and
                        tonumber(message.number)==tonumber(cfg.number) then
                        deployRequested=true
                        startupFuelKind=message.fuelKind or startupFuelKind
                        state.startupFuelKind=startupFuelKind
                        save()
                    end
                end

                if deployRequested and not deploymentRecall and not alreadyTraveling then
                    if not calibrateOrientation() then
                        status("navigator","DEPLOY_BLOCKED",{
                            number=cfg.number,message="Orientation calibration blocked",
                            session=cfg.session
                        })
                        sleep(1)
                    else
                        while not deploymentRecall and not refuelStartupFuel(startupFuelKind) do
                            status("navigator","WAITING_FUEL",{
                                number=cfg.number,fuel=turtle.getFuelLevel(),
                                message="Waiting for startup fuel or bucket return",
                                session=cfg.session
                            })
                            local sender,message=rednet.receive(PROTOCOL,1)
                            setupMessage(sender,message)
                        end
                        local receipt=false
                        local lastReady=0
                        local lastReceiptStatus=-10
                        while not receipt and not deploymentRecall do
                            if now()-lastReady>=1 then
                                send(cfg.controller,{type="navigator_fuel_ready",number=cfg.number,
                                    fuel=turtle.getFuelLevel()})
                                lastReady=now()
                            end
                            if now()-lastReceiptStatus>=5 then
                                status("navigator","WAITING_FUEL_RECEIPT",{
                                    number=cfg.number,x=state.x,y=state.y,z=state.z,
                                    gpsHost=false,session=cfg.session
                                })
                                lastReceiptStatus=now()
                            end
                            local sender,message=rednet.receive(PROTOCOL,0.5)
                            setupMessage(sender,message)
                            if sender==cfg.controller and type(message)=="table" and
                                message.type=="navigator_fuel_receipt" and
                                tonumber(message.number)==tonumber(cfg.number) then
                                receipt=true
                            end
                        end
                        if receipt and state.loaderExpected and not state.loaderPlaced and
                            not loaderInInventory() and not deploymentRecall then
                            dumpOrdinaryItems()
                            state.awaitingLoader=true
                            save()
                            local lastLoaderReady=-10
                            while not loaderInInventory() and not deploymentRecall do
                                if now()-lastLoaderReady>=1 then
                                    send(cfg.controller,{type="navigator_loader_ready",
                                        number=cfg.number,id=os.getComputerID()})
                                    status("navigator","WAITING_CHUNK_LOADER",{
                                        number=cfg.number,x=state.x,y=state.y,z=state.z,
                                        gpsHost=false,message="Waiting for Chunk Loader item 781",
                                        session=cfg.session
                                    })
                                    lastLoaderReady=now()
                                end
                                local slot=findLoaderReceiptSlot()
                                if slot then
                                    state.loaderSlot=slot
                                    state.awaitingLoader=nil
                                    save()
                                    send(cfg.controller,{type="navigator_loader_received",
                                        number=cfg.number,id=os.getComputerID(),slot=slot})
                                    break
                                end
                                local sender,message=rednet.receive(PROTOCOL,0.5)
                                setupMessage(sender,message)
                            end
                        end
                    end
                end

                if deployRequested and not deploymentRecall and
                    (alreadyTraveling or turtle.getFuelLevel()=="unlimited" or
                     turtle.getFuelLevel()>=800) then
                    state.deploying=true
                    cfg.deploymentStarted=true
                    save()
                    if not saveTable("node.cfg",cfg) then
                        error("Navigator deployment marker write failed")
                    end
                    local travelDone=false
                    parallel.waitForAny(function()
                        travelDone=travelToSite()
                    end,function()
                        local lastTravelStatus=-10
                        while not travelDone do
                            if now()-lastTravelStatus>=5 then
                                status("navigator","DEPLOYING",{
                                    number=cfg.number,x=state.x,y=state.y,z=state.z,
                                    gpsHost=false,session=cfg.session
                                })
                                lastTravelStatus=now()
                            end
                            local sender,message=rednet.receive(PROTOCOL,0.5)
                            setupMessage(sender,message)
                        end
                    end)
                    if not travelDone and not deploymentRecall then
                        status("navigator","DEPLOY_BLOCKED",{
                            number=cfg.number,x=state.x,y=state.y,z=state.z,
                            message=state.navigationError or "Navigator travel blocked; retrying and listening for recall",
                            session=cfg.session
                        })
                        sleep(1)
                    end
                end
            end
        end
    end

    cfg.x=state.x
    cfg.y=state.y
    cfg.z=state.z
    cfg.deployed=state.deployed and true or false
    saveTable("node.cfg",cfg)

    local modemSide,modem=findWirelessModemSide()

    if not modemSide or not modem then
        error("Navigator requires a Wireless Modem")
    end

    modem.open(gps.CHANNEL_GPS)

    local function sendNavigatorStatus()
        local message=state.recalled and "Navigator recalled" or "GPS host active"
        if state.recoveryLocked then message=state.recoveryReason or "Navigator recovery waiting" end
        if state.navigationError then message=state.navigationError end
        status("navigator",state.recoveryLocked and "RECOVERY_LOCK" or
            (state.chunkTravel and "CHUNK_MOVING" or
            (state.recalled and "RECALLED_PAUSED" or "GPS_HOST")),{
            number=cfg.number,
            x=state.x,
            y=state.y,
            z=state.z,
            chunkIndex=state.chunkIndex,
            fuel=turtle.getFuelLevel(),
            gpsHost=not state.recoveryLocked and not state.recalled and not state.chunkTravel,
            modemSide=modemSide,
            loaderExpected=state.loaderExpected and true or false,
            loaderPlaced=state.loaderPlaced and true or false,
            loaderOwned=state.loaderExpected and (state.loaderPlaced or loaderInInventory()) or false,
            loaderSite=state.loaderSite,
            message=message,
            session=cfg.session
        })
    end

    local deploymentReadyAt=now()+5

    local function sendDeploymentAck()
        if not state.deployed or now()<deploymentReadyAt then return false end
        local site=NAVIGATOR_SITES[tonumber(cfg.number)]
        if not site or state.x~=site.x or state.y~=site.y or state.z~=site.z then return false end
        if state.loaderExpected and (not state.loaderPlaced or state.loaderSite~="WORK") then return false end
        send(cfg.controller,{
            type="navigator_deployed",
            id=os.getComputerID(),
            number=cfg.number,
            x=state.x,
            y=state.y,
            z=state.z,
            chunkIndex=state.chunkIndex,
            loaderPlaced=state.loaderPlaced and true or false,
            loaderSite=state.loaderSite,
            session=cfg.session
        })
        return true
    end

    local function resumeNavigator()
        if not state.recalled then
            return true
        end

        local site=NAVIGATOR_SITES[cfg.number]
        if not site then
            return false
        end
        if state.loaderExpected and state.loaderPlaced and state.loaderSite=="RECALL" then
            local recovered,reason=retrieveChunkLoader()
            if not recovered then
                state.navigationError=reason
                save()
                return false
            end
        end

        if not vertical(NAVIGATOR_CRUISE[cfg.number]) then return false end

        if cfg.number==2 or cfg.number==3 then
            while state.z<site.z do
                if not step(DIR_N) then return false end
            end
            while state.z>site.z do
                if not step(DIR_S) then return false end
            end
        end
        while state.x<site.x do
            if not step(DIR_E) then return false end
        end
        while state.x>site.x do
            if not step(DIR_W) then return false end
        end
        if cfg.number~=2 and cfg.number~=3 then
            while state.z<site.z do
                if not step(DIR_N) then return false end
            end
            while state.z>site.z do
                if not step(DIR_S) then return false end
            end
        end

        if not vertical(site.y) then
            return false
        end

        if not face(DIR_N) then
            return false
        end

        if state.loaderExpected and not state.loaderPlaced then
            local placed,reason=placeChunkLoader("WORK")
            if not placed then
                state.navigationError=reason
                save()
                return false
            end
        end

        state.recalled=false
        state.recallMode=nil
        save()
        cfg.x=state.x
        cfg.y=state.y
        cfg.z=state.z
        saveTable("node.cfg",cfg)
        sendNavigatorStatus()
        return true
    end

    sendNavigatorStatus()

    local timer=os.startTimer(5)
    local pendingRecallMode=nil
    local advanceCancelled=false

    local function eventLoop()
        while true do
        local event={os.pullEvent()}

        if event[1]=="modem_message" then
            local side=event[2]
            local channel=event[3]
            local replyChannel=event[4]
            local message=event[5]

            if side==modemSide and channel==gps.CHANNEL_GPS and message=="PING" and
                not state.recoveryLocked and not state.recalled then
                local x,y,z=worldPose(state.x,state.y,state.z,state.chunkIndex,
                    cfg.worldOrigin)
                if x then modem.transmit(replyChannel,gps.CHANNEL_GPS,{x,y,z}) end
            end
        elseif event[1]=="rednet_message" then
            local sender=event[2]
            local message=event[3]
            local protocol=event[4]

            if sender==cfg.controller and protocol==PROTOCOL and type(message)=="table" and
                message.type=="deploy_navigator" and tonumber(message.number)==tonumber(cfg.number) then
                sendDeploymentAck()
            elseif sender==cfg.managerId and protocol==PROTOCOL and type(message)=="table" and message.session==cfg.session then
                if message.type=="status_query" then
                    sendNavigatorStatus()
                elseif message.type=="cancel_advance" then
                    advanceCancelled=true
                    if message.mode=="NORMAL" or message.mode=="SHUTDOWN" then
                        pendingRecallMode=message.mode
                    end
                elseif message.type=="chunk_loader_command" and not state.recalled and
                    not advanceCancelled and not pendingRecallMode then
                    local target=tonumber(message.chunkIndex)
                    local stage=tostring(message.stage or "")
                    local action=tostring(message.action or "")
                    local expected=(cfg.number==3 and (stage=="N3_PICKUP" or stage=="N3_PLACE")) or
                        (cfg.number==1 and (stage=="N1_PICKUP" or stage=="N1_PLACE"))
                    local ok=false
                    local reason="Unexpected Chunk Loader command for Navigator-"..tostring(cfg.number)
                    if expected and target then
                        if action=="PICKUP" and state.chunkIndex==target-1 then
                            ok,reason=retrieveChunkLoader()
                        elseif action=="PLACE" and state.chunkIndex==target then
                            ok,reason=placeChunkLoader()
                        else
                            reason="Chunk Loader command does not match Navigator chunk position"
                        end
                    end
                    if ok then
                        state.navigationError=nil
                        save()
                        send(cfg.managerId,{type="chunk_ack",role="navigator",
                            number=cfg.number,stage=stage,chunkIndex=target,
                            nodeChunkIndex=state.chunkIndex,x=state.x,y=state.y,z=state.z,
                            loaderPlaced=state.loaderPlaced and true or false,
                            session=cfg.session})
                        sendNavigatorStatus()
                    else
                        state.navigationError=reason
                        save()
                        status("navigator","CHUNK_LOADER_BLOCKED",{
                            number=cfg.number,x=state.x,y=state.y,z=state.z,
                            chunkIndex=state.chunkIndex,loaderPlaced=state.loaderPlaced and true or false,
                            message=reason,session=cfg.session
                        })
                    end
                elseif message.type=="chunk_move" and not state.recalled and
                    not advanceCancelled and not pendingRecallMode then
                    local target=tonumber(message.chunkIndex)
                    local requestedStage=tostring(message.stage or "MOVE_G")
                    local allowed=(requestedStage=="N3_MOVE" and cfg.number==3) or
                        (requestedStage=="N1_MOVE" and cfg.number==1) or
                        (requestedStage=="MOVE_G" and (cfg.number==2 or cfg.number==4))
                    if allowed and target and target==state.chunkIndex+1 then
                        state.chunkTravel=true
                        state.navigationError=nil
                        save()
                        local site=NAVIGATOR_SITES[cfg.number]
                        local travelDone=false
                        local ok=false
                        local reason=nil
                        advanceCancelled=false
                        pendingRecallMode=nil
                        parallel.waitForAny(function()
                            ok,reason=travelChunkNorth(state,save,face,site.z,target,
                                nil,function()
                                    return advanceCancelled or pendingRecallMode~=nil
                                end,clearForwardForChunk)
                            travelDone=true
                        end,function()
                            while not travelDone do
                                local ev={os.pullEvent()}
                                if ev[1]=="modem_message" then
                                    local side=ev[2]
                                    local channel=ev[3]
                                    local replyChannel=ev[4]
                                    local payload=ev[5]
                                    if side==modemSide and channel==gps.CHANNEL_GPS and
                                        payload=="PING" and not state.recoveryLocked and not state.recalled then
                                        local x,y,z=worldPose(state.x,state.y,state.z,
                                            state.chunkIndex,cfg.worldOrigin)
                                        if x then
                                            modem.transmit(replyChannel,gps.CHANNEL_GPS,{x,y,z})
                                        end
                                    end
                                elseif ev[1]=="rednet_message" then
                                    local rsender=ev[2]
                                    local rmessage=ev[3]
                                    local rprotocol=ev[4]
                                    if rsender==cfg.managerId and rprotocol==PROTOCOL and
                                        type(rmessage)=="table" and rmessage.session==cfg.session then
                                        if rmessage.type=="recall_command" then
                                            pendingRecallMode=rmessage.mode or "NORMAL"
                                            advanceCancelled=true
                                        elseif rmessage.type=="cancel_advance" then
                                            advanceCancelled=true
                                            if rmessage.mode=="NORMAL" or rmessage.mode=="SHUTDOWN" then
                                                pendingRecallMode=rmessage.mode
                                            end
                                        elseif rmessage.type=="status_query" then
                                            sendNavigatorStatus()
                                        end
                                    end
                                end
                            end
                        end)
                        if pendingRecallMode then
                            state.chunkTravel=nil
                            save()
                            if not recallNavigator(pendingRecallMode) then
                                status("navigator","RECALL_BLOCKED",{
                                    number=cfg.number,x=state.x,y=state.y,z=state.z,
                                    message="Navigator recall route blocked after chunk cancellation",
                                    session=cfg.session
                                })
                            end
                            pendingRecallMode=nil
                            advanceCancelled=false
                        elseif ok then
                            state.chunkTravel=nil
                            state.navigationError=nil
                            advanceCancelled=false
                            save()
                            sendNavigatorStatus()
                        else
                            state.chunkTravel=nil
                            state.navigationError=reason
                            advanceCancelled=false
                            save()
                            status("navigator","CHUNK_BLOCKED",{
                                number=cfg.number,x=state.x,y=state.y,z=state.z,
                                chunkIndex=state.chunkIndex,gpsHost=true,message=reason,session=cfg.session
                            })
                            sendNavigatorStatus()
                        end
                    elseif not allowed then
                        status("navigator","CHUNK_BLOCKED",{
                            number=cfg.number,x=state.x,y=state.y,z=state.z,
                            chunkIndex=state.chunkIndex,gpsHost=true,
                            message="Unexpected Navigator move stage "..requestedStage,
                            session=cfg.session
                        })
                    end
                    if allowed and target==state.chunkIndex and not state.chunkTravel then
                        send(cfg.managerId,{type="chunk_ack",role="navigator",
                            number=cfg.number,stage=requestedStage,chunkIndex=target,
                            nodeChunkIndex=state.chunkIndex,x=state.x,y=state.y,z=state.z,
                            loaderPlaced=state.loaderPlaced and true or false,
                            session=cfg.session})
                    end
                elseif message.type=="recall_loader_command" then
                    advanceCancelled=true
                    pendingRecallMode=nil
                    handleRecallLoaderCommand(message)
                elseif message.type=="recall_command" then
                    advanceCancelled=true
                    pendingRecallMode=message.mode or "NORMAL"
                    if pendingRecallMode=="PACK" then
                        state.packPending=nil
                        state.packToken=tonumber(message.packToken)
                    elseif pendingRecallMode=="NORMAL" and message.packPending==true then
                        state.packPending=true
                    else
                        state.packPending=nil
                        state.packToken=nil
                    end
                    save()
                    if not recallNavigator(pendingRecallMode) then
                        status("navigator","RECALL_BLOCKED",{
                            number=cfg.number,
                            x=state.x,
                            y=state.y,
                            z=state.z,
                            message="Navigator recall route blocked",
                            session=cfg.session
                        })
                    end
                elseif message.type=="pack_clear" and state.recalled and state.recallMode=="PACK" and
                    tonumber(message.packToken)==tonumber(state.packToken) then
                    if clearNavigatorLabel() then
                        state.packReady=true
                        state.packAcknowledged=nil
                        save()
                        send(cfg.managerId,{
                            type="pack_ready",role="navigator",number=cfg.number,
                            packToken=state.packToken,labelCleared=true,
                            x=state.x,y=state.y,z=state.z,dir=state.dir,session=cfg.session
                        })
                    end
                elseif message.type=="pack_ready_ack" and state.packReady and
                    tonumber(message.packToken)==tonumber(state.packToken) then
                    state.packAcknowledged=true
                    save()
                elseif message.type=="resume_swarm" then
                    if state.recallMode~="PACK" and not state.packPending and not resumeNavigator() then
                        status("navigator","NAVIGATION_ERROR",{
                            number=cfg.number,
                            x=state.x,
                            y=state.y,
                            z=state.z,
                            message="Navigator could not return to GPS site",
                            session=cfg.session
                        })
                    end
                end
            end
        elseif event[1]=="timer" and event[2]==timer then
            if state.recoveryLocked then attemptNavigatorRecovery() end
            sendNavigatorStatus()
            sendDeploymentAck()
            if state.packReady and not state.packAcknowledged then
                send(cfg.managerId,{
                    type="pack_ready",role="navigator",number=cfg.number,
                    packToken=state.packToken,labelCleared=true,
                    x=state.x,y=state.y,z=state.z,dir=state.dir,session=cfg.session
                })
            end
            timer=os.startTimer(5)
        end
    end
    end

    local function heartbeatLoop()
        while true do
            sleep(5)
            pcall(openNetwork)
            pcall(sendNavigatorStatus)
        end
    end

    parallel.waitForAny(eventLoop,heartbeatLoop)
end


local cfg=loadTable("node.cfg")

if not cfg or cfg.role~="navigator" then
    error("Navigator role file requires navigator node.cfg")
end

local cfgVersion=tonumber(cfg.version)
if cfgVersion and cfgVersion>=56 and cfgVersion<VERSION then
    cfg.version=VERSION
    saveTable("node.cfg",cfg)
elseif cfgVersion~=VERSION then
    error("Unsupported navigator node state version")
end

setRegionalManager(cfg.managerId)
runNavigator(cfg)
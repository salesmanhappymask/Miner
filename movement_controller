local M={}

local directions={
    north={x=0,z=-1},
    east={x=1,z=0},
    south={x=0,z=1},
    west={x=-1,z=0}
}
local order={"north","east","south","west"}

local function same(a,b)
    return a and b and a.x==b.x and a.y==b.y and a.z==b.z
end

local function copy(a)
    return {x=a.x,y=a.y,z=a.z}
end

local function reading(gps)
    local ok,x,y,z=pcall(gps.locate,2,false)
    if not ok or type(x)~="number" or type(y)~="number" or type(z)~="number" then
        return nil
    end
    return {x=math.floor(x+0.5),y=math.floor(y+0.5),z=math.floor(z+0.5)}
end

local function atomic(fs,path,value)
    local tmp=path..".new"
    local backup=path..".old"
    local file=fs.open(tmp,"w")
    if not file then return false end
    file.write(textutils.serialize(value))
    file.close()
    if fs.exists(backup) then fs.delete(backup) end
    if fs.exists(path) then fs.move(path,backup) end
    fs.move(tmp,path)
    if fs.exists(backup) then fs.delete(backup) end
    return true
end

function M.new(o)
    assert(o and o.fs and o.path and o.turtle and o.gps)
    local fs,turtle,gps=o.fs,o.turtle,o.gps
    local state
    local journal=o.path
    if not fs.exists(journal) and fs.exists(journal..".old") then
        journal=journal..".old"
    end
    if fs.exists(journal) then
        local file=assert(fs.open(journal,"r"))
        state=textutils.unserialize(file.readAll())
        file.close()
        assert(type(state)=="table" and type(state.pos)=="table")
    else
        state={pos=nil,heading=nil,sequence=0,intent=nil,history={}}
    end
    local api={}

    local function save()
        assert(atomic(fs,o.path,state),"pose journal unavailable")
    end

    local function append(kind,from,to,heading)
        local h=state.history
        h[#h+1]={sequence=state.sequence,kind=kind,from=from,to=to,heading=heading}
        if #h>12 then table.remove(h,1) end
    end

    function api.status()
        return state
    end

    function api.commission(expected,heading,witness)
        if not expected or not directions[heading] or type(witness)~="function" then
            return false,"Expected GPS, heading and physical witness required"
        end
        local actual=reading(gps)
        if not actual or not same(actual,expected) then return false,"Placement GPS mismatch" end
        if not witness(heading,actual) then return false,"Orientation witness failed" end
        state.pos=copy(actual)
        state.heading=heading
        state.intent=nil
        state.sequence=state.sequence+1
        append("commission",nil,copy(actual),heading)
        save()
        return true
    end

    function api.recover()
        local actual=reading(gps)
        if not actual then state.heading=nil; save(); return false,"GPS unavailable" end
        local intent=state.intent
        if intent and intent.kind=="turn" then
            state.pos=copy(actual)
            state.heading=nil
            state.intent=nil
            save()
            return false,"Interrupted turn: heading unknown"
        end
        if intent and intent.kind=="probe" then
            if same(actual,intent.from) then
                state.pos=copy(actual)
            else
                local dx=actual.x-intent.from.x
                local dz=actual.z-intent.from.z
                for name,delta in pairs(directions) do
                    if dx==delta.x and dz==delta.z and actual.y==intent.from.y then
                        state.heading=name
                        break
                    end
                end
                state.pos=copy(actual)
            end
            state.intent=nil
            save()
            if not state.heading then return false,"Probe yielded no verified heading" end
            return true
        end
        if intent and intent.kind=="move" then
            if same(actual,intent.to) then
                state.pos=copy(actual)
                state.sequence=state.sequence+1
                append("move_recovered",intent.from,copy(actual),state.heading)
            elseif not same(actual,intent.from) then
                state.pos=copy(actual)
                state.heading=nil
            end
            state.intent=nil
            save()
            if not state.heading then return false,"Position mismatch: heading unknown" end
            return true
        end
        if not same(actual,state.pos) then
            state.pos=copy(actual)
            state.heading=nil
            save()
            return false,"Position changed without a movement record"
        end
        return state.heading~=nil,state.heading and nil or "Heading unknown"
    end

    function api.probe(safe)
        if state.heading then return true end
        if type(safe)~="function" then return false,"Safe probe area required" end
        local before=reading(gps)
        if not before or not same(before,state.pos) then return false,"GPS position mismatch" end
        for _,delta in pairs(directions) do
            if not safe(before.x+delta.x,before.y,before.z+delta.z) then
                return false,"Probe needs four safe neighboring squares"
            end
        end
        state.intent={kind="probe",from=copy(before)}
        save()
        local moved=turtle.forward()
        local after=reading(gps)
        if not after then return false,"Probe GPS unavailable; recover after GPS returns" end
        if not moved and same(after,before) then
            state.intent=nil
            save()
            return false,"Probe blocked"
        end
        local found
        for name,delta in pairs(directions) do
            if after.x-before.x==delta.x and after.z-before.z==delta.z and after.y==before.y then
                found=name
                break
            end
        end
        state.pos=copy(after)
        state.heading=found
        state.intent=nil
        if not found then save(); return false,"Unexpected probe displacement" end
        state.sequence=state.sequence+1
        append("probe",before,copy(after),found)
        save()
        return true
    end

    function api.turnTo(target)
        if not directions[target] or not state.heading or state.intent then
            return false,"Heading unknown or movement pending"
        end
        local before=reading(gps)
        if not before or not same(before,state.pos) then return false,"GPS position mismatch" end
        local current,targetIndex
        for i,name in ipairs(order) do
            if name==state.heading then current=i end
            if name==target then targetIndex=i end
        end
        while current~=targetIndex do
            local right=(targetIndex-current)%4
            local action=right==3 and "left" or "right"
            state.intent={kind="turn",from=state.heading,action=action}
            save()
            local ok=action=="left" and turtle.turnLeft() or turtle.turnRight()
            if not ok then state.heading=nil; state.intent=nil; save(); return false,"Turn failed" end
            current=action=="left" and (current+2)%4+1 or current%4+1
            state.heading=order[current]
            state.intent=nil
            state.sequence=state.sequence+1
            append("turn",copy(before),copy(before),state.heading)
            save()
        end
        return true
    end

    function api.forward(reserve,release)
        if not state.heading or state.intent then return false,"Heading unknown or movement pending" end
        if type(reserve)~="function" then return false,"Destination reservation required" end
        local before=reading(gps)
        if not before or not same(before,state.pos) then return false,"GPS position mismatch" end
        local delta=directions[state.heading]
        local nextPos={x=before.x+delta.x,y=before.y,z=before.z+delta.z}
        local token=reserve(nextPos,copy(before))
        if not token then return false,"Destination not reserved" end
        state.intent={kind="move",from=copy(before),to=copy(nextPos)}
        save()
        local moved=turtle.forward()
        local after=reading(gps)
        if not after then return false,"Movement GPS unavailable; recover after GPS returns" end
        if release then release(token) end
        if same(after,nextPos) then
            state.pos=copy(after)
            state.sequence=state.sequence+1
            append("move",before,copy(after),state.heading)
            state.intent=nil
            save()
            return true
        end
        state.intent=nil
        if not same(after,before) then state.pos=copy(after); state.heading=nil end
        save()
        return false,moved and "GPS disagrees with movement" or "Forward blocked"
    end

    return api
end

return M

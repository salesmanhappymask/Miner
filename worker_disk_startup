local EXPECTED_VERSION = 152
local RAW = "https://raw.githubusercontent.com/salesmanhappymask/Miner/main/"

if fs.exists("node.cfg") then
    if not fs.exists("/startup") then
        error("Configured worker is missing local startup")
    end
    if not shell.run("/startup") then error("Local worker startup failed") end
    return
end

local function fetch(name)
    local response=http.get(RAW..name)
    if not response then error("Worker installer cannot download "..name) end
    local data=response.readAll()
    response.close()
    if not data or data=="" then error("Empty worker download: "..name) end
    return data
end

local version=fetch("version"):match("^%s*(%d+)%s*$")
if tonumber(version)~=EXPECTED_VERSION then
    error("Worker disk expects version "..EXPECTED_VERSION..", repository has "..tostring(version))
end

local common=fetch("common")
local startup=fetch("startup")
local bootstrap=fetch("bootstrap")
if common:match("^%s*VERSION%s*=%s*(%d+)")~=version then
    error("Worker common/version mismatch")
end
if fetch("version"):match("^%s*(%d+)%s*$")~=version then
    error("Repository version changed during worker installation")
end

local compile=loadstring or load
local commonProgram=assert(compile(common,"common"))
assert(compile(startup,"startup"))
local bootstrapProgram=assert(compile(bootstrap,"bootstrap"))
_G.WORKER_INSTALL_COMMON=common
_G.WORKER_INSTALL_STARTUP=startup
commonProgram()
bootstrapProgram()
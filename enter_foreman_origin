local values={}
for _,axis in ipairs({"X","Y","Z"}) do
    while true do
        write(axis..": ")
        local input=read()
        local value=tonumber(input)
        if value and value==math.floor(value) then
            values[#values+1]=value
            break
        end
        print("Enter a whole-number world coordinate")
    end
end
local x,y,z=gps.locate(2,false)
if not x or not y or not z then error("GPS unavailable; origin was not saved") end
if x~=values[1] or y~=values[2] or z~=values[3] then
    error("GPS reports "..x..","..y..","..z.."; origin was not saved")
end
local file=assert(fs.open("foreman_origin.new","w"))
file.write(textutils.serialize({x=x,y=y,z=z}))
file.close()
if fs.exists("foreman_origin") then fs.delete("foreman_origin") end
fs.move("foreman_origin.new","foreman_origin")
print("Origin saved: "..x..","..y..","..z)

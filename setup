local RAW="https://raw.githubusercontent.com/salesmanhappymask/Miner/main/"
local choices={
    ["1"]={role="manager",regional="1",master="0",label="Regional Manager"},
    ["2"]={role="foreman",regional="0",master="1",label="Foreman-1"},
    ["4"]={role="bootstrap",regional="0",master="0",label="Unconfigured Worker"}
}

if not turtle or not turtle.forward then
    error("Run setup on an Advanced Wireless Turtle")
end

local function fetch(name)
    local response=http.get(RAW..name)
    if not response then error("Could not download "..name.."; nothing removed") end
    local body=response.readAll()
    response.close()
    if not body or body=="" then error("Empty "..name.."; nothing removed") end
    return body
end

local function compile(name,source)
    local loader=loadstring or load
    if loader then
        local program,err=loader(source,name)
        if not program then error("Invalid "..name..": "..tostring(err).."; nothing removed") end
    end
end

local function erase()
    for _,name in ipairs(fs.list("")) do
        local drive=fs.getDrive and fs.getDrive(name) or "hdd"
        if drive=="hdd" and not fs.isReadOnly(name) then fs.delete(name) end
    end
end

local function write(name,source)
    local file=fs.open(name,"w")
    if not file then error("Could not write "..name) end
    file.write(source)
    file.close()
    local verify=fs.open(name,"r")
    if not verify then error("Could not verify "..name) end
    local actual=verify.readAll()
    verify.close()
    if actual~=source then error("Verification failed for "..name) end
end

print("1. Reinstall Regional Manager")
print("2. Reinstall Master Foreman")
print("3. Erase without reinstalling")
print("4. Reinstall unconfigured worker")
local choice=read()

if choice=="3" then
    erase()
    os.setComputerLabel(nil)
    print("Machine erased")
    return
end

local role=choices[choice]
if not role then error("Select 1, 2, 3, or 4; nothing removed") end

local releaseFiles={"common",role.role,"prep","diagnose_reboot","space"}
local rootFiles={"startup","updater","setup","version","space","diagnose_reboot"}
if choice=="1" or choice=="2" then
    rootFiles[#rootFiles+1]="movement_controller"
    rootFiles[#rootFiles+1]="enter_foreman_origin"
end
if choice=="2" then releaseFiles[#releaseFiles+1]="bootstrap" end
local staged={}
for _,name in ipairs(rootFiles) do staged[name]=fetch(name) end
for _,name in ipairs(releaseFiles) do
    if not staged[name] then staged[name]=fetch(name) end
end
local version=staged.version:match("^%s*(%d+)%s*$")
if not version or tonumber(version)<88 then
    error("Remote release must be version 88 or later; nothing removed")
end
if staged.common:match("^%s*VERSION%s*=%s*(%d+)")~=version then
    error("Common/version mismatch; nothing removed")
end
local regionalCount,masterCount
staged.startup,regionalCount=staged.startup:gsub(
    "local%s+REGIONAL_MANAGER%s*=%s*%d+","local REGIONAL_MANAGER = "..role.regional,1)
staged.startup,masterCount=staged.startup:gsub(
    "local%s+MASTER_FOREMAN%s*=%s*%d+","local MASTER_FOREMAN = "..role.master,1)
if regionalCount~=1 or masterCount~=1 then
    error("Startup role flags missing; nothing removed")
end
for name,source in pairs(staged) do
    if name~="version" then compile(name,source) end
end
if fetch("version"):match("^%s*(%d+)%s*$")~=version then
    error("Remote release changed during download; nothing removed")
end

local anchor
if choice=="2" then
    anchor={}
    print("Enter the Master Foreman's current Minecraft coordinates")
    for _,axis in ipairs({"x","y","z"}) do
        while true do
            term.write(axis:upper()..": ")
            local value=tonumber(read())
            if value and value==math.floor(value) then
                anchor[axis]=value
                break
            end
            print("Enter a whole-number coordinate")
        end
    end
end

print("Erasing all writable files and installing version "..version)
erase()
if choice=="4" then
    for _,name in ipairs(releaseFiles) do write(name,staged[name]) end
    for _,name in ipairs(rootFiles) do write(name,staged[name]) end
else
    fs.makeDir("releases")
    local base="releases/"..version
    fs.makeDir(base)
    for _,name in ipairs(releaseFiles) do write(base.."/"..name,staged[name]) end
    for _,name in ipairs(rootFiles) do write(name,staged[name]) end
    if anchor then write("world_anchor",textutils.serialize(anchor)) end
    write(base.."/ready",version)
    write("active_release",version)
end
os.setComputerLabel(role.label)
print("Installed "..role.label.." with clean state")
if choice=="4" then print("Worker must be commissioned by the Master Foreman") end
os.reboot()

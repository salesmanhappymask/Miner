local args={...}
local RAW="https://raw.githubusercontent.com/salesmanhappymask/Miner/main/"

local function read(path)
    local f=fs.open(path,"r")
    if not f then return nil end
    local data=f.readAll()
    f.close()
    return data
end

local function write(path,data)
    local f=fs.open(path,"w")
    if not f then error("Cannot write " .. path) end
    f.write(data)
    f.close()
    if read(path)~=data then error("Verification failed: " .. path) end
end

local function fetch(name)
    local response=http.get(RAW .. name)
    if not response then error("Update download failed: " .. name) end
    local data=response.readAll()
    response.close()
    if not data or data=="" then error("Empty update: " .. name) end
    return data
end

local function loadCfg()
    for _,path in ipairs({"node.cfg","node.cfg.new","node.cfg.bak"}) do
        local raw=read(path)
        if raw then
            local ok,value=pcall(textutils.unserialize,raw)
            if ok and type(value)=="table" then return value end
        end
    end
    if fs.exists("node.cfg") or fs.exists("node.cfg.new") or fs.exists("node.cfg.bak") then
        error("node.cfg unreadable; updater cannot determine role")
    end
end

local function activeVersion()
    for _,name in ipairs({"active_release.new","active_release","active_release.bak"}) do
        local version=(read(name) or ""):match("^%s*(%d+)%s*$")
        if version and read("releases/"..version.."/ready")==version then
            return version
        end
    end
    return (read("version") or ""):match("^%s*(%d+)%s*$")
end

local currentStartup=read("startup") or ""
local regional=currentStartup:match("local%s+REGIONAL_MANAGER%s*=%s*(%d+)") or "0"
local master=currentStartup:match("local%s+MASTER_FOREMAN%s*=%s*(%d+)") or "0"
local cfg=loadCfg()
local role
if regional=="1" then
    role="manager"
elseif master=="1" then
    role="foreman"
elseif cfg and cfg.role then
    role=cfg.role
else
    role="bootstrap"
end
local admin=regional=="1" or master=="1"

local version=fetch("version"):match("^%s*(%d+)%s*$")
if not version then error("Invalid remote version") end
if activeVersion()==version and
    read("releases/"..version.."/common") and
    read("releases/"..version.."/"..role) and
    (not admin or (read("setup") and read("movement_controller") and
    read("enter_foreman_origin"))) then
    print("Already current: "..version)
    return
end

local files={"common",role,"prep"}
if admin then
    files[#files+1]="setup"
    files[#files+1]="movement_controller"
    files[#files+1]="enter_foreman_origin"
end
local contents={}
for _,name in ipairs(files) do contents[name]=fetch(name) end
local startup=fetch("startup")
local updater=fetch("updater")
startup=startup:gsub("local%s+REGIONAL_MANAGER%s*=%s*%d+","local REGIONAL_MANAGER = "..regional,1)
startup=startup:gsub("local%s+MASTER_FOREMAN%s*=%s*%d+","local MASTER_FOREMAN = "..master,1)
if not startup:find("local REGIONAL_MANAGER = "..regional,1,true) or
    not startup:find("local MASTER_FOREMAN = "..master,1,true) then
    error("Downloaded startup lacks role flags")
end
if contents.common:match("^%s*VERSION%s*=%s*(%d+)")~=version then
    error("Downloaded common and version disagree")
end
local compile=loadstring or load
if compile then
    for _,name in ipairs(files) do
        if not compile(contents[name],name) then error("Invalid Lua: "..name) end
    end
    if not compile(startup,"startup") or not compile(updater,"updater") then
        error("Invalid startup or updater Lua")
    end
end

local base="releases/"..version
if not fs.exists("releases") then fs.makeDir("releases") end
if not fs.exists(base) then fs.makeDir(base) end
if fs.exists(base.."/ready") then fs.delete(base.."/ready") end
for _,name in ipairs(files) do write(base.."/"..name,contents[name]) end
write(base.."/ready",version)

write("startup.next",startup)
write("updater.next",updater)
if admin then
    for _,name in ipairs({"setup","movement_controller","enter_foreman_origin"}) do
        write(name..".next",contents[name])
    end
end
if fs.exists("startup") then
    if fs.exists("startup.previous") then fs.delete("startup.previous") end
    fs.copy("startup","startup.previous")
end
if fs.exists("updater") then
    if fs.exists("updater.previous") then fs.delete("updater.previous") end
    fs.copy("updater","updater.previous")
end
if fs.exists("startup") then fs.delete("startup") end
fs.move("startup.next","startup")
if fs.exists("updater") then fs.delete("updater") end
fs.move("updater.next","updater")
if admin then
    for _,name in ipairs({"setup","movement_controller","enter_foreman_origin"}) do
        if fs.exists(name) then fs.delete(name) end
        fs.move(name..".next",name)
    end
end

write("active_release.new",version)
if fs.exists("active_release.bak") then fs.delete("active_release.bak") end
if fs.exists("active_release") then
    fs.move("active_release","active_release.bak")
end
fs.move("active_release.new","active_release")
write("version",version)
print("Updated to version "..version)
print("Installed role: "..role)
print("Reboot to run the new release")

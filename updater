local args={...}
local RAW="https://raw.githubusercontent.com/salesmanhappymask/Miner/main/"

local function readFile(path)
    local f=fs.open(path,"r")
    if not f then return nil end
    local data=f.readAll()
    f.close()
    return data
end

local function writeFile(path,data)
    local f=fs.open(path,"w")
    if not f then return false end
    f.write(data)
    f.close()
    return true
end

local function fetch(name)
    local response=http.get(RAW .. name)
    if not response then return nil end
    local data=response.readAll()
    response.close()
    return data
end

local currentStartup=readFile("startup") or ""
local regional=currentStartup:match("local%s+REGIONAL_MANAGER%s*=%s*(%d+)") or "0"
local master=currentStartup:match("local%s+MASTER_FOREMAN%s*=%s*(%d+)") or "0"

local remoteVersion=fetch("version")
if not remoteVersion then
    if fs.exists("startup") then
        print("Update server unavailable. Using installed startup.")
        return
    end
    error("No installed startup and update server unavailable")
end

remoteVersion=remoteVersion:gsub("%s+$","")
local localVersion=(readFile("version") or ""):gsub("%s+$","")
local force=(args[1]~="check")

if not force and localVersion==remoteVersion and fs.exists("startup") then
    print("Already current: " .. remoteVersion)
    return
end

local startup=fetch("startup")
local prep=fetch("prep")

if not startup or not prep then
    error("Update download incomplete")
end

startup=startup:gsub("local%s+REGIONAL_MANAGER%s*=%s*%d+","local REGIONAL_MANAGER = " .. regional,1)
startup=startup:gsub("local%s+MASTER_FOREMAN%s*=%s*%d+","local MASTER_FOREMAN = " .. master,1)

if not writeFile("startup.new",startup) then
    error("Cannot write startup.new")
end

if not writeFile("prep.new",prep) then
    fs.delete("startup.new")
    error("Cannot write prep.new")
end

if fs.exists("startup") then fs.delete("startup") end
if fs.exists("prep") then fs.delete("prep") end

fs.move("startup.new","startup")
fs.move("prep.new","prep")

if not writeFile("version",remoteVersion) then
    error("Cannot write version")
end

print("Updated to version " .. remoteVersion)

local function wrapThis(name)
  local w, i = nil, 0
  while w == nil and i <= 100 do
    w = peripheral.wrap(name .. "_" .. i)
    i = i + 1
  end
  return w
end

local r = wrapThis("BigReactors-Reactor")
if r == nil then error("No reactor found") end

local mon = peripheral.wrap("right")
if mon == nil then error("No monitor found") end

mon.setTextScale(0.5)

local W, H = mon.getSize()

local maxEnergy = 10000000
local autoEnabled = true
local targetPercent = 75
local kp = 0.25
local kd = 1.2
local previousPercent = nil
local normalCap = 5
local dangerCap = 15
local dangerThreshold = 35
local sensitiveZoneStart = 70
local checkInterval = 2
local lastControlStep = 0
local lastControlRate = 0
local lastEnergySample = nil
local storageDelta = 0

local function supportsColor(m)
  return m.isColor and m.isColor() or false
end

local IS_COLOR = supportsColor(mon)
local C_BG = colors.black
local C_HEADER = IS_COLOR and colors.lightGray or colors.black
local C_DIV = IS_COLOR and colors.gray or colors.black
local C_INSET = colors.black
local C_ACCENT = IS_COLOR and colors.cyan or colors.white
local C_TEXT = colors.white
local C_MUTED = IS_COLOR and colors.lightGray or colors.white
local C_BRAND = IS_COLOR and colors.blue or colors.white
local C_OK = IS_COLOR and colors.lime or colors.white
local C_WARN = IS_COLOR and colors.yellow or colors.white
local C_BAD = IS_COLOR and colors.red or colors.white
local C_FUEL = IS_COLOR and colors.orange or colors.white
local C_ENERGY = IS_COLOR and colors.blue or colors.white
local C_RODS = IS_COLOR and colors.purple or colors.white
local C_ACTION = IS_COLOR and colors.green or colors.white

local function clamp(n, a, b)
  if n < a then return a end
  if n > b then return b end
  return n
end

local function makeUI(m)
  local w, h = m.getSize()
  local cache = {}

  local function setBg(bg)
    if IS_COLOR then m.setBackgroundColor(bg) else m.setBackgroundColor(colors.black) end
  end

  local function setFg(fg)
    if IS_COLOR then m.setTextColor(fg) else m.setTextColor(colors.white) end
  end

  local function rect(x, y, ww, hh, bg)
    if ww <= 0 or hh <= 0 then return end
    local x1 = clamp(x, 1, w)
    local y1 = clamp(y, 1, h)
    local x2 = clamp(x + ww - 1, 1, w)
    local y2 = clamp(y + hh - 1, 1, h)
    if x2 < x1 or y2 < y1 then return end
    setBg(bg)
    local line = string.rep(" ", x2 - x1 + 1)
    for yy = y1, y2 do
      m.setCursorPos(x1, yy)
      m.write(line)
    end
  end

  local function field(key, x, y, ww, s, fg, bg)
    if ww <= 0 or y < 1 or y > h or x > w or x + ww - 1 < 1 then return end
    local x1 = clamp(x, 1, w)
    local x2 = clamp(x + ww - 1, 1, w)
    local visibleW = x2 - x1 + 1
    if visibleW <= 0 then return end
    s = tostring(s or "")
    if x < 1 then s = s:sub(2 - x) end
    if #s > visibleW then s = s:sub(1, visibleW) end
    local out = s .. string.rep(" ", visibleW - #s)
    local k1 = key .. "_out"
    local k2 = key .. "_fg"
    local k3 = key .. "_bg"
    if cache[k1] == out and cache[k2] == fg and cache[k3] == bg then return end
    setBg(bg or C_BG)
    setFg(fg or C_TEXT)
    m.setCursorPos(x1, y)
    m.write(out)
    cache[k1] = out
    cache[k2] = fg
    cache[k3] = bg
  end

  local function clearAll()
    setBg(C_BG)
    setFg(C_TEXT)
    m.clear()
    cache = {}
  end

  return { w = w, h = h, rect = rect, field = field, clearAll = clearAll }
end

local ui = makeUI(mon)

local function cardSurface(x, y, ww, hh, accentColor)
  if ww < 4 or hh < 3 then return end
  ui.rect(x, y, ww, hh, C_BG)
  ui.rect(x, y, ww, 1, C_DIV)
  ui.rect(x, y + hh - 1, ww, 1, C_DIV)
  ui.rect(x, y, 1, hh, C_DIV)
  ui.rect(x + ww - 1, y, 1, hh, C_DIV)
  ui.rect(x + 1, y + 1, ww - 2, hh - 2, C_INSET)
  ui.rect(x + 1, y + 1, 1, hh - 2, accentColor or C_ACCENT)
end

local function sectionTitle(key, x, y, ww, title, color)
  local tx = x + 3
  local tw = math.max(0, ww - 5)
  ui.field(key, tx, y, tw, title, color or C_TEXT, C_DIV)
end

local function drawHeader(title)
  ui.rect(1, 1, W, 1, C_HEADER)
  ui.rect(1, 2, W, 1, C_DIV)
  local brand = "ZelOS"
  local tx = 1 + math.floor((W - #title) / 2)
  ui.field("hdr_title", tx, 1, #title, title, C_TEXT, C_HEADER)
  ui.field("hdr_brand", W - #brand + 1, 1, #brand, brand, C_BRAND, C_HEADER)
end

local function callOptional(name)
  local fn = r[name]
  if type(fn) ~= "function" then return nil end
  local ok, value = pcall(fn)
  if not ok then return nil end
  return value
end

local function percentColor(p)
  if p < 30 then return C_BAD end
  if p < 70 then return C_WARN end
  return C_OK
end

local function formatRF(n)
  n = tonumber(n) or 0
  local a = math.abs(n)
  if a >= 1000000 then return string.format("%.2f MRF", n / 1000000) end
  if a >= 1000 then return string.format("%.1f kRF", n / 1000) end
  return string.format("%d RF", math.floor(n + 0.5))
end

local function formatAmount(n, suffix)
  n = tonumber(n) or 0
  local a = math.abs(n)
  local out
  if a >= 1000000 then
    out = string.format("%.2fM", n / 1000000)
  elseif a >= 1000 then
    out = string.format("%.1fk", n / 1000)
  else
    out = string.format("%d", math.floor(n + 0.5))
  end
  if suffix and suffix ~= "" then out = out .. " " .. suffix end
  return out
end

local function signedRF(n)
  n = tonumber(n) or 0
  if n > 0 then return "+" .. formatRF(n) end
  if n < 0 then return "-" .. formatRF(math.abs(n)) end
  return "0 RF"
end

local function signedPercent(n)
  n = tonumber(n) or 0
  if math.abs(n) < 0.005 then return "0.00%" end
  return string.format("%+.2f%%", n)
end

local function drawBar(x, y, width, percent, fillColor)
  if width <= 0 then return end
  percent = clamp(percent or 0, 0, 100)
  local filled = math.floor(width * percent / 100 + 0.5)
  filled = clamp(filled, 0, width)
  mon.setCursorPos(x, y)
  mon.setBackgroundColor(fillColor)
  if filled > 0 then mon.write(string.rep(" ", filled)) end
  mon.setBackgroundColor(C_DIV)
  if width - filled > 0 then mon.write(string.rep(" ", width - filled)) end
  mon.setBackgroundColor(C_BG)
end

local function centeredButtonText(width, text)
  if #text > width then return text:sub(1, width) end
  local left = math.floor((width - #text) / 2)
  local right = width - #text - left
  return string.rep(" ", left) .. text .. string.rep(" ", right)
end

local layout = {}
layout.outerX = 2
layout.outerW = W - 2
layout.topY = 4
layout.topH = 6
layout.barsY = 11
layout.barsH = 8
layout.buttonY = H - 1
layout.hintY = H - 2
layout.controlDividerY = H - 3
layout.contentBottom = H - 5
layout.teleY = 20
layout.teleH = layout.contentBottom - layout.teleY + 1
layout.showTelemetry = layout.teleH >= 5
layout.twoCards = W >= 64

if layout.outerW < 30 or H < 24 then
  error("Monitor is too small for the reactor interface at text scale 0.5")
end

if layout.twoCards then
  layout.cardGap = 2
  layout.leftW = math.floor((layout.outerW - layout.cardGap) / 2)
  layout.rightW = layout.outerW - layout.cardGap - layout.leftW
  layout.leftX = layout.outerX
  layout.rightX = layout.leftX + layout.leftW + layout.cardGap
else
  layout.leftX = layout.outerX
  layout.leftW = layout.outerW
end

local totalButtonGap = 4
local baseButtonW = math.floor((layout.outerW - totalButtonGap) / 3)
layout.btn1X = layout.outerX
layout.btn1W = baseButtonW
layout.btn2X = layout.btn1X + layout.btn1W + 2
layout.btn2W = baseButtonW
layout.btn3X = layout.btn2X + layout.btn2W + 2
layout.btn3W = layout.outerX + layout.outerW - layout.btn3X

local function drawShell()
  ui.clearAll()
  drawHeader("Reactor Control")

  if layout.twoCards then
    cardSurface(layout.leftX, layout.topY, layout.leftW, layout.topH, C_ACCENT)
    sectionTitle("core_title", layout.leftX, layout.topY, layout.leftW, "CORE STATUS", C_TEXT)
    cardSurface(layout.rightX, layout.topY, layout.rightW, layout.topH, C_BRAND)
    sectionTitle("loop_title", layout.rightX, layout.topY, layout.rightW, "CONTROL LOOP", C_TEXT)
  else
    cardSurface(layout.leftX, layout.topY, layout.leftW, layout.topH, C_ACCENT)
    sectionTitle("status_title", layout.leftX, layout.topY, layout.leftW, "SYSTEM STATUS", C_TEXT)
  end

  cardSurface(layout.outerX, layout.barsY, layout.outerW, layout.barsH, C_ACCENT)
  sectionTitle("bars_title", layout.outerX, layout.barsY, layout.outerW, "RESERVES & INSERTION", C_TEXT)

  if layout.showTelemetry then
    cardSurface(layout.outerX, layout.teleY, layout.outerW, layout.teleH, C_BRAND)
    sectionTitle("tele_title", layout.outerX, layout.teleY, layout.outerW, "LIVE TELEMETRY", C_TEXT)
  end

  ui.rect(1, layout.controlDividerY, W, 1, C_DIV)
  ui.field("hint", 2, layout.hintY, W - 2, "Touch a control below. Automatic mode targets stored energy, not reactor output.", C_MUTED, C_BG)
end

local function kv(key, x, y, width, label, value, valueColor)
  if width <= 0 then return end
  local labelText = label .. ":"
  local valueText = tostring(value or "")
  local labelW = math.min(#labelText, width)
  ui.field(key .. "_l", x, y, labelW, labelText, C_MUTED, C_INSET)
  local available = width - labelW - 1
  if available > 0 then
    ui.field(key .. "_v", x + labelW + 1, y, available, valueText, valueColor or C_TEXT, C_INSET)
  end
end

local function meter(key, y, label, detail, pct, fillColor)
  local x = layout.outerX + 3
  local width = layout.outerW - 5
  ui.field(key .. "_label", x, y, math.floor(width / 2), label, C_MUTED, C_INSET)
  local detailW = math.floor(width / 2)
  local detailX = x + width - detailW
  ui.field(key .. "_detail", detailX, y, detailW, detail, C_TEXT, C_INSET)
  drawBar(x, y + 1, width, pct, fillColor)
end

local function autoControl()
  if not autoEnabled then
    previousPercent = nil
    lastControlStep = 0
    lastControlRate = 0
    return
  end

  local energy = r.getEnergyStored()
  local percent = clamp(energy / maxEnergy * 100, 0, 100)

  if previousPercent == nil then
    previousPercent = percent
    lastControlStep = 0
    lastControlRate = 0
    return
  end

  local errorAmt = percent - targetPercent
  local rate = percent - previousPercent
  previousPercent = percent
  lastControlRate = rate

  local adjustment = kp * errorAmt + kd * rate
  local step = math.floor(adjustment + 0.5)
  local cap = normalCap

  if percent < dangerThreshold and rate < 0 then cap = dangerCap end

  local current = r.getControlRodLevel(0)

  if step > 0 and current >= sensitiveZoneStart then
    local roomLeft = 100 - current
    local scaledCap = math.max(1, math.floor(roomLeft / 4))
    if scaledCap < cap then cap = scaledCap end
  end

  if step > cap then step = cap end
  if step < -cap then step = -cap end

  lastControlStep = step

  if step ~= 0 then
    local newLevel = clamp(current + step, 0, 100)
    r.setAllControlRodLevels(newLevel)
  end
end

local function updateStorageDelta()
  local energy = r.getEnergyStored()
  if lastEnergySample == nil then
    storageDelta = 0
  else
    storageDelta = energy - lastEnergySample
  end
  lastEnergySample = energy
end

local function drawDynamic()
  local temp = r.getFuelTemperature()
  local fuel = r.getFuelAmount()
  local fuelMax = r.getFuelAmountMax()
  local energy = r.getEnergyStored()
  local gen = r.getEnergyProducedLastTick()
  local active = r.getActive()
  local rod = r.getControlRodLevel(0)

  local fuelPct = 0
  if fuelMax and fuelMax > 0 then fuelPct = clamp(fuel / fuelMax * 100, 0, 100) end
  local energyPct = clamp(energy / maxEnergy * 100, 0, 100)
  local deviation = energyPct - targetPercent

  local stateText = active and "ACTIVE" or "SHUTDOWN"
  local stateColor = active and C_OK or C_BAD

  if W >= 50 then
    ui.field("hdr_state", 2, 1, 10, stateText, stateColor, C_HEADER)
  end

  if layout.twoCards then
    local x1 = layout.leftX + 3
    local w1 = layout.leftW - 5
    kv("core_state", x1, layout.topY + 1, w1, "State", stateText, stateColor)
    kv("core_temp", x1, layout.topY + 2, w1, "Fuel temp", string.format("%.0f C", temp), C_TEXT)
    kv("core_output", x1, layout.topY + 3, w1, "Generation", formatRF(gen) .. "/t", C_TEXT)
    kv("core_store", x1, layout.topY + 4, w1, "Stored", string.format("%.1f%%", energyPct), percentColor(energyPct))

    local x2 = layout.rightX + 3
    local w2 = layout.rightW - 5
    kv("loop_mode", x2, layout.topY + 1, w2, "Mode", autoEnabled and "AUTOMATIC" or "MANUAL", autoEnabled and C_ACCENT or C_MUTED)
    kv("loop_target", x2, layout.topY + 2, w2, "Target", string.format("%d%%", targetPercent), C_TEXT)
    kv("loop_error", x2, layout.topY + 3, w2, "Deviation", signedPercent(deviation), math.abs(deviation) < 5 and C_OK or C_WARN)
    local moveText = lastControlStep == 0 and "HOLD" or string.format("%+d%% rods", lastControlStep)
    kv("loop_move", x2, layout.topY + 4, w2, "Last move", moveText, lastControlStep == 0 and C_MUTED or C_ACCENT)
  else
    local innerX = layout.leftX + 3
    local innerW = layout.leftW - 5
    local gap = 2
    local colW = math.floor((innerW - gap) / 2)
    local rightX = innerX + colW + gap
    kv("n_state", innerX, layout.topY + 1, colW, "State", stateText, stateColor)
    kv("n_mode", rightX, layout.topY + 1, colW, "Mode", autoEnabled and "AUTO" or "MANUAL", autoEnabled and C_ACCENT or C_MUTED)
    kv("n_temp", innerX, layout.topY + 2, colW, "Fuel temp", string.format("%.0f C", temp), C_TEXT)
    kv("n_target", rightX, layout.topY + 2, colW, "Target", string.format("%d%%", targetPercent), C_TEXT)
    kv("n_output", innerX, layout.topY + 3, colW, "Generation", formatRF(gen) .. "/t", C_TEXT)
    kv("n_error", rightX, layout.topY + 3, colW, "Deviation", signedPercent(deviation), math.abs(deviation) < 5 and C_OK or C_WARN)
    kv("n_store", innerX, layout.topY + 4, colW, "Stored", string.format("%.1f%%", energyPct), percentColor(energyPct))
    local moveText = lastControlStep == 0 and "HOLD" or string.format("%+d%% rods", lastControlStep)
    kv("n_move", rightX, layout.topY + 4, colW, "Last move", moveText, lastControlStep == 0 and C_MUTED or C_ACCENT)
  end

  meter("energy", layout.barsY + 1, "Stored Energy", formatRF(energy) .. "  " .. string.format("%.1f%%", energyPct), energyPct, C_ENERGY)
  meter("fuel", layout.barsY + 3, "Fuel Reserve", formatAmount(fuel, "mB") .. " / " .. formatAmount(fuelMax, "mB") .. "  " .. string.format("%.1f%%", fuelPct), fuelPct, C_FUEL)
  meter("rods", layout.barsY + 5, "Control Rods", string.format("%d%% inserted", math.floor(rod + 0.5)), rod, C_RODS)

  if layout.showTelemetry then
    local casingTemp = callOptional("getCasingTemperature")
    local reactivity = callOptional("getFuelReactivity")
    local fuelUse = callOptional("getFuelConsumedLastTick")
    local waste = callOptional("getWasteAmount")

    local items = {
      { "Stored raw", string.format("%d RF", math.floor(energy + 0.5)) },
      { "Output raw", string.format("%d RF/t", math.floor(gen + 0.5)) },
      { "Storage step", signedRF(storageDelta) },
      { "Loop rate", signedPercent(lastControlRate) .. "/cycle" },
      { "Fuel raw", string.format("%d / %d mB", math.floor(fuel + 0.5), math.floor(fuelMax + 0.5)) },
      { "Rod bank", string.format("%d%%", math.floor(rod + 0.5)) },
      { "Cycle", string.format("%ds", checkInterval) },
      { "Energy target", string.format("%d%%", targetPercent) }
    }

    if casingTemp ~= nil then items[#items + 1] = { "Casing temp", string.format("%.0f C", casingTemp) } end
    if reactivity ~= nil then items[#items + 1] = { "Reactivity", string.format("%.1f%%", reactivity) } end
    if fuelUse ~= nil then items[#items + 1] = { "Fuel use", string.format("%.4f mB/t", fuelUse) } end
    if waste ~= nil then items[#items + 1] = { "Waste", formatAmount(waste, "mB") } end

    local innerX = layout.outerX + 3
    local innerW = layout.outerW - 5
    local rows = layout.teleH - 2
    local useTwoCols = innerW >= 58
    local colW = innerW
    local colGap = 2
    local rightX = nil

    if useTwoCols then
      colW = math.floor((innerW - colGap) / 2)
      rightX = innerX + colW + colGap
    end

    local capacity = rows * (useTwoCols and 2 or 1)
    local maxItems = math.min(#items, capacity)

    for i = 1, maxItems do
      local x = innerX
      local row = i
      if useTwoCols and i > rows then
        x = rightX
        row = i - rows
      end
      kv("tele_" .. i, x, layout.teleY + row, colW, items[i][1], items[i][2], C_TEXT)
    end
  end

  ui.field("btn_start", layout.btn1X, layout.buttonY, layout.btn1W, centeredButtonText(layout.btn1W, "START"), C_TEXT, C_ACTION)
  ui.field("btn_stop", layout.btn2X, layout.buttonY, layout.btn2W, centeredButtonText(layout.btn2W, "STOP"), C_TEXT, C_BAD)
  local autoLabel = autoEnabled and "AUTO: ON" or "AUTO: OFF"
  ui.field("btn_auto", layout.btn3X, layout.buttonY, layout.btn3W, centeredButtonText(layout.btn3W, autoLabel), C_TEXT, autoEnabled and C_BRAND or C_DIV)

  sleep(0)
end

local function inButton(x, y, bx, bw)
  return y == layout.buttonY and x >= bx and x <= bx + bw - 1
end

drawShell()
updateStorageDelta()
drawDynamic()
local timerId = os.startTimer(checkInterval)

local ok, err = pcall(function()
  while true do
    local event, a, b, c = os.pullEvent()

    if event == "monitor_touch" then
      local x, y = b, c
      if inButton(x, y, layout.btn1X, layout.btn1W) then
        r.setActive(true)
        drawDynamic()
      elseif inButton(x, y, layout.btn2X, layout.btn2W) then
        r.setActive(false)
        drawDynamic()
      elseif inButton(x, y, layout.btn3X, layout.btn3W) then
        autoEnabled = not autoEnabled
        previousPercent = nil
        lastControlStep = 0
        lastControlRate = 0
        drawDynamic()
      end
    elseif event == "timer" and a == timerId then
      autoControl()
      updateStorageDelta()
      drawDynamic()
      timerId = os.startTimer(checkInterval)
    end
  end
end)

if not ok then
  term.setBackgroundColor(colors.black)
  term.setTextColor(colors.white)
  term.clear()
  term.setCursorPos(1, 1)
  print("Program stopped: " .. tostring(err))
end

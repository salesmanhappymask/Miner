local PROTOCOL = "direct_inventory_transfer_test_v1"
local LOG = "foreman_direct_inventory.log"
local DISTANCE_TO_MINER = 3

local function log(message)
    local line=string.format("[%.3f] %s",os.clock(),tostring(message))
    print(line)
    local h=fs.open(LOG,"a")
    if h then
        h.writeLine(line)
        h.close()
    end
end

local function resetLog()
    if fs.exists(LOG) then fs.delete(LOG) end
    log("Foreman direct-inventory test starting")
    log("Computer ID: "..tostring(os.getComputerID()))
    log("Fuel level: "..tostring(turtle.getFuelLevel()))
end

local function openWireless()
    for _,side in ipairs({"left","right","top","bottom","front","back"}) do
        if peripheral.getType(side)=="modem" then
            local ok,wireless=pcall(peripheral.call,side,"isWireless")
            if ok and wireless then
                rednet.open(side)
                log("Opened wireless modem on "..side)
                return true
            end
        end
    end
    error("No wireless modem found")
end

local function ensureFuel(required)
    local level=turtle.getFuelLevel()
    log("Fuel check: "..tostring(level).." required="..required)

    if level=="unlimited" or level>=required then
        return true
    end

    for slot=1,16 do
        if turtle.getItemCount(slot)>0 then
            turtle.select(slot)
            local ok=turtle.refuel(0)
            log("Slot "..slot.." fuel test: "..tostring(ok))
            if ok then
                while turtle.getItemCount(slot)>0 and turtle.getFuelLevel()<required do
                    local before=turtle.getFuelLevel()
                    local used=turtle.refuel(1)
                    local after=turtle.getFuelLevel()
                    log("Refuel slot "..slot..": "..tostring(used).." "..tostring(before).." -> "..tostring(after))
                    if not used or after<=before then break end
                end
            end
        end
        if turtle.getFuelLevel()=="unlimited" or turtle.getFuelLevel()>=required then
            break
        end
    end

    turtle.select(1)
    level=turtle.getFuelLevel()
    return level=="unlimited" or level>=required
end

local function inventoryCount()
    local total=0
    for slot=1,16 do
        local count=turtle.getItemCount(slot)
        if count>0 then
            log("Foreman slot "..slot.." contains "..count.." item(s)")
            total=total+count
        end
    end
    log("Foreman inventory total: "..total)
    return total
end

local function listMethods(side)
    local methods=peripheral.getMethods(side) or {}
    table.sort(methods)
    log("Peripheral "..side.." type="..tostring(peripheral.getType(side)))
    log("Methods on "..side..": "..table.concat(methods,", "))
end

local function hasMethod(side,name)
    local methods=peripheral.getMethods(side) or {}
    for _,method in ipairs(methods) do
        if method==name then return true end
    end
    return false
end

local function findSelfInventorySide()
    for _,side in ipairs({"left","right","top","bottom","back"}) do
        if peripheral.isPresent(side) and
            hasMethod(side,"getAllStacks") and
            hasMethod(side,"pullItem") then
            log("Candidate self-inventory peripheral found on "..side)
            listMethods(side)
            return side
        end
    end
    return nil
end

local function serializeSafe(value)
    local ok,result=pcall(textutils.serialize,value)
    if ok then return result end
    return tostring(value)
end

local function inspectFrontInventory()
    if not peripheral.isPresent("front") then
        log("ERROR: No peripheral is visible on front")
        return nil
    end

    listMethods("front")
    local inv=peripheral.wrap("front")

    if hasMethod("front","getInventorySize") then
        local ok,size=pcall(inv.getInventorySize)
        log("front.getInventorySize(): ok="..tostring(ok).." result="..tostring(size))
    end

    if hasMethod("front","getAllStacks") then
        local ok,stacks=pcall(inv.getAllStacks)
        log("front.getAllStacks(): ok="..tostring(ok))
        if ok then
            log("front stacks: "..serializeSafe(stacks))
        else
            log("front.getAllStacks error: "..tostring(stacks))
        end
    end

    if hasMethod("front","getStackInSlot") then
        for slot=1,16 do
            local ok,stack=pcall(inv.getStackInSlot,slot)
            if ok and stack then
                log("front slot "..slot..": "..serializeSafe(stack))
            elseif not ok then
                log("front slot "..slot.." read error: "..tostring(stack))
            end
        end
    end

    return inv
end

local function directPullFromFront(selfSide)
    local selfInv=peripheral.wrap(selfSide)
    local totalMoved=0

    for slot=1,16 do
        local before=inventoryCount()
        log("Attempting selfInv.pullItem(\"front\","..slot..",64)")

        local ok,result=pcall(selfInv.pullItem,"front",slot,64)
        log("pullItem slot "..slot..": ok="..tostring(ok).." result="..serializeSafe(result))

        local after=inventoryCount()
        local moved=after-before
        if moved>0 then
            totalMoved=totalMoved+moved
            log("Observed "..moved.." item(s) added from source slot "..slot)
        end
    end

    return totalMoved
end

local function fallbackSuckEverything()
    local totalMoved=0

    while true do
        local before=inventoryCount()
        log("Fallback: calling turtle.suck()")
        local ok,reason=turtle.suck()
        log("turtle.suck(): "..tostring(ok)..", "..tostring(reason))
        local after=inventoryCount()

        if after>before then
            totalMoved=totalMoved+(after-before)
        end

        if not ok then
            break
        end
    end

    return totalMoved
end

local function sendError(minerId,message)
    log("ERROR: "..tostring(message))
    if minerId then
        rednet.send(minerId,{
            type="TEST_ERROR",
            error=tostring(message)
        },PROTOCOL)
    end
end

resetLog()
openWireless()

if not ensureFuel(10) then
    error("Not enough fuel")
end

log("Initial Foreman inventory")
inventoryCount()

rednet.broadcast({
    type="HELLO_FOREMAN",
    foremanId=os.getComputerID()
},PROTOCOL)

local minerId=nil
local deadline=os.clock()+15

while not minerId and os.clock()<deadline do
    local sender,message=rednet.receive(PROTOCOL,1)
    if sender then
        log("Message from "..tostring(sender)..": "..serializeSafe(message))
    end
    if type(message)=="table" and message.type=="HELLO_MINER" then
        minerId=sender
    end
end

if not minerId then
    sendError(nil,"No Miner responded")
    error("No Miner responded")
end

log("Paired with Miner "..minerId)

for step=1,DISTANCE_TO_MINER do
    log("Moving toward Miner, step "..step)
    local ok,reason=turtle.forward()
    log("turtle.forward(): "..tostring(ok)..", "..tostring(reason))
    if not ok then
        sendError(minerId,"Movement toward Miner failed at step "..step)
        error("Movement failed")
    end
end

log("Arrived directly in front of Miner")
rednet.send(minerId,{type="SCAN_REQUEST"},PROTOCOL)

local sender,message=rednet.receive(PROTOCOL,5)
if sender==minerId and type(message)=="table" and message.type=="SCAN_RESULT" then
    log("Miner reports total inventory before transfer: "..tostring(message.total))
else
    log("WARNING: Did not receive Miner pre-transfer scan")
end

inspectFrontInventory()

local moved=0
local selfSide=findSelfInventorySide()

if selfSide then
    log("Beginning direct OpenPeripheral pull test")
    moved=directPullFromFront(selfSide)
    log("Direct OpenPeripheral pull observed total moved: "..moved)
else
    log("No suitable Narcissistic self-inventory peripheral found")
end

rednet.send(minerId,{type="SCAN_REQUEST"},PROTOCOL)
sender,message=rednet.receive(PROTOCOL,5)

local remaining=nil
if sender==minerId and type(message)=="table" and message.type=="SCAN_RESULT" then
    remaining=tonumber(message.total)
    log("Miner reports remaining after direct pull: "..tostring(remaining))
else
    log("WARNING: Did not receive Miner post-direct-pull scan")
end

if remaining and remaining>0 then
    log("Items remain. Beginning turtle.suck() fallback to establish complete behavior.")
    local fallbackMoved=fallbackSuckEverything()
    moved=moved+fallbackMoved
    log("Fallback moved total: "..fallbackMoved)
end

rednet.send(minerId,{type="SCAN_REQUEST"},PROTOCOL)
sender,message=rednet.receive(PROTOCOL,5)
if sender==minerId and type(message)=="table" and message.type=="SCAN_RESULT" then
    log("Miner final reported inventory: "..tostring(message.total))
end

log("Turning around")
turtle.turnRight()
turtle.turnRight()

for step=1,DISTANCE_TO_MINER do
    log("Returning to chest, step "..step)
    local ok,reason=turtle.forward()
    log("turtle.forward(): "..tostring(ok)..", "..tostring(reason))
    if not ok then
        sendError(minerId,"Return movement failed at step "..step)
        error("Return movement failed")
    end
end

log("Returned to start point. Chest should be directly ahead.")
log("Depositing every item currently in Foreman inventory.")

for slot=1,16 do
    local count=turtle.getItemCount(slot)
    if count>0 then
        turtle.select(slot)
        log("Dropping slot "..slot.." count="..count)
        local ok,reason=turtle.drop()
        log("turtle.drop(): "..tostring(ok)..", "..tostring(reason))
        log("Slot "..slot.." remaining="..turtle.getItemCount(slot))
    end
end

turtle.select(1)
log("Final Foreman inventory")
local finalCount=inventoryCount()

rednet.send(minerId,{
    type="TEST_COMPLETE",
    moved=moved,
    remainingOnForeman=finalCount
},PROTOCOL)

log("Sent TEST_COMPLETE")
log("Foreman direct-inventory test finished")

local function runMinerCommissioning(cfg)
    if not openNetwork() then
        error("Wireless modem not found")
    end

    local state=loadTable("miner.tmp") or {
        row=cfg.row,
        depth=0,
        pos=0,
        dir=DIR_N,
        phase="COMMISSIONING",
        request=nil,
        requestSeq=0,
        resumeDepth=0,
        resumePos=0,
        resumeDir=DIR_N,
        complete=false,
        installerHeld=false,
        installerFuelSlot=nil,
        orientationTurns=0,
        orientationTurnIntent=nil,
        orientationCalibrated=false
    }

    state.row=cfg.row
    state.phase="COMMISSIONING"
    state.seq=tonumber(state.seq) or 0
    state.tempSteps=tonumber(state.tempSteps) or 0

    if state.motionIntent and state.motionIntent.kind=="temp_forward" then
        local monitorState,monitorSeq=requestPoseBackup("miner",5,cfg.session)
        local intentSeq=tonumber(state.motionIntent.seq) or (state.seq+1)

        if monitorState and tonumber(monitorSeq or monitorState.seq or 0)>=intentSeq and monitorState.tempSteps then
            state.tempSteps=monitorState.tempSteps
            state.seq=tonumber(monitorState.seq) or intentSeq
            state.motionIntent=nil
        else
            local fuelNow=turtle.getFuelLevel()
            local fuelBefore=state.motionIntent.fuelBefore
            if type(fuelNow)=="number" and type(fuelBefore)=="number" then
                if fuelNow<fuelBefore then
                    state.tempSteps=state.motionIntent.toStep
                    state.seq=intentSeq
                else
                    state.tempSteps=state.motionIntent.fromStep
                end
                state.motionIntent=nil
            else
                state.recoveryLocked=true
                state.recoveryReason="Temporary Miner-01 position ambiguous after restart"
            end
        end
    end

    saveTable("miner.tmp",state)

    local function save()
        saveTable("miner.tmp",state)
    end

    local function ack(packet)
        for i=1,3 do
            send(cfg.foremanId,packet)
            sleep(0.1)
        end
    end

    local function temporarySlot()
        if state.installerFuelSlot and state.installerFuelSlot>=2 and state.installerFuelSlot<=16 then
            return state.installerFuelSlot
        end

        for slot=16,2,-1 do
            if turtle.getItemCount(slot)==0 then
                return slot
            end
        end

        return nil
    end

    local function confirmPlacedMinerNorth()
        if state.orientationCalibrated then
            return state.dir==DIR_N
        end

        if cfg.placedFacing~=DIR_N then
            state.recoveryLocked=true
            state.recoveryReason="Miner placement did not declare north-facing orientation"
            state.phase="RECOVERY_LOCK"
            save()
            return false
        end

        state.dir=DIR_N
        state.orientationTurns=0
        state.orientationTurnIntent=nil
        state.orientationCalibrated=true
        save()
        return true
    end

    status("miner","COMMISSIONING",{
        row=cfg.row,
        foreman=cfg.foremanNumber,
        message=state.installerHeld and "Holding Disk Drive" or "Waiting for assigned foreman"
    })

    while true do
        local sender,message=rednet.receive(PROTOCOL,1)

        if sender==MONITOR_ID and type(message)=="table" then
            if message.type=="recall_all" then
                os.setComputerLabel(nil)
                os.shutdown()
            elseif message.type=="status_query" then
                status("miner","COMMISSIONING",{
                    row=cfg.row,
                    foreman=cfg.foremanNumber,
                    message=state.installerHeld and "Holding Disk Drive" or "Commissioning"
                })
            end

        elseif sender==cfg.foremanId and type(message)=="table" then
            if message.type=="commission_refuel" then
                turtle.select(1)
                local count=turtle.getItemCount(1)

                if count>0 and turtle.getFuelLevel()~="unlimited" then
                    turtle.refuel(count)
                end

                ack({
                    type="commission_refueled",
                    id=os.getComputerID(),
                    row=cfg.row,
                    fuel=turtle.getFuelLevel()
                })

            elseif message.type=="return_installer" then
                if not state.installerHeld then
                    turtle.select(1)

                    if turtle.getItemCount(1)>0 then
                        local slot=temporarySlot()

                        if not slot then
                            send(cfg.foremanId,{
                                type="installer_break_failed",
                                id=os.getComputerID(),
                                row=cfg.row,
                                reason="no_empty_slot"
                            })
                        else
                            state.installerFuelSlot=slot
                            turtle.transferTo(slot)
                            save()
                        end
                    end

                    if turtle.getItemCount(1)==0 then
                        turtle.select(1)

                        if turtle.digUp() then
                            state.installerHeld=true
                            save()
                        else
                            send(cfg.foremanId,{
                                type="installer_break_failed",
                                id=os.getComputerID(),
                                row=cfg.row,
                                reason="dig_failed"
                            })
                        end
                    end
                end

                if state.installerHeld then
                    ack({
                        type="installer_ready",
                        id=os.getComputerID(),
                        row=cfg.row
                    })
                end

            elseif message.type=="installer_taken" then
                if state.installerHeld then
                    state.installerHeld=false

                    if state.installerFuelSlot and turtle.getItemCount(state.installerFuelSlot)>0 then
                        turtle.select(state.installerFuelSlot)
                        turtle.transferTo(1)
                    end

                    state.installerFuelSlot=nil
                    turtle.select(1)
                    save()
                end

                ack({
                    type="installer_returned",
                    id=os.getComputerID(),
                    row=cfg.row
                })

            elseif message.type=="deploy_miner" then
                if not state.orientationCalibrated then
                    if not confirmPlacedMinerNorth() then
                        ack({
                            type="miner_deploy_blocked",
                            id=os.getComputerID(),
                            row=cfg.row,
                            reason=state.recoveryReason
                        })
                    end
                end

                if state.recoveryLocked then
                    status("miner","RECOVERY_LOCK",{
                        row=cfg.row,
                        foreman=cfg.foremanNumber,
                        recovery=state.recoveryReason,
                        message="Deployment halted rather than guessing position"
                    })
                elseif cfg.tempDeployment then
                    while state.tempSteps<2 do
                        local intent={
                            kind="temp_forward",
                            seq=state.seq+1,
                            fuelBefore=turtle.getFuelLevel(),
                            fromStep=state.tempSteps,
                            toStep=state.tempSteps+1
                        }
                        state.motionIntent=intent
                        save()

                        if turtle.forward() then
                            state.tempSteps=intent.toStep
                            state.seq=intent.seq
                            state.motionIntent=nil
                            save()
                        else
                            state.motionIntent=nil
                            state.recoveryLocked=true
                            state.recoveryReason="Miner-01 temporary north corridor is blocked"
                            state.phase="RECOVERY_LOCK"
                            save()
                            break
                        end
                    end
                    cfg.tempDeployment=false
                end

                if state.recoveryLocked then
                    ack({
                        type="miner_deploy_blocked",
                        id=os.getComputerID(),
                        row=cfg.row,
                        reason=state.recoveryReason
                    })
                else
                    state.seq=state.seq+1
                    state.x=cfg.row
                    state.y=0
                    state.z=0
                    state.depth=0
                    state.pos=0
                    state.dir=DIR_N
                    state.resumeX=cfg.row
                    state.resumeY=0
                    state.resumeZ=0
                    state.resumeDepth=0
                    state.resumePos=0
                    state.resumeDir=DIR_N
                    state.phase="WAITING"
                    state.installerHeld=false
                    state.installerFuelSlot=nil
                    state.motionIntent=nil
                    state.turnIntent=nil
                    state.orientationTurnIntent=nil
                    state.orientationTurns=0
                    state.originEstablished=true
                    state.orientationCalibrated=true

                    cfg.orientationCalibrated=true
                    cfg.commissioned=true

                    saveTable("node.cfg",cfg)
                    save()

                    checkpointPose("miner",state.seq,{
                        row=cfg.row,
                        session=cfg.session,
                        x=state.x,
                        y=state.y,
                        z=state.z,
                        depth=state.depth,
                        pos=state.pos,
                        dir=state.dir,
                        phase=state.phase,
                        resumeX=state.resumeX,
                        resumeY=state.resumeY,
                        resumeZ=state.resumeZ,
                        resumeDepth=state.resumeDepth,
                        resumePos=state.resumePos,
                        resumeDir=state.resumeDir,
                        complete=false,
                        originEstablished=true,
                        orientationCalibrated=true,
                        seq=state.seq
                    },cfg.session)

                    ack({
                        type="miner_deployed",
                        id=os.getComputerID(),
                        row=cfg.row
                    })

                    status("miner","WAITING",{
                        row=cfg.row,
                        foreman=cfg.foremanNumber,
                        x=state.x,
                        y=state.y,
                        z=state.z,
                        dir=state.dir,
                        message="Ready, north calibrated"
                    })

                    sleep(0.5)
                    os.reboot()
                end
            end
        end
    end
end

local function bootstrap()
    if not openNetwork() then
        error("Wireless modem not found")
    end

    local myID=os.getComputerID()
    local configured=nil

    status("bootstrap","WAITING",{message="Waiting for direct configuration"})

    while not configured do
        local sender,message=rednet.receive(PROTOCOL,2)

        if sender and type(message)=="table" and message.type=="configure" and message.target==myID then
            configured=message
            configured.controller=sender
        elseif sender==MONITOR_ID and type(message)=="table" and message.type=="recall_all" then
            os.setComputerLabel(nil)
            os.shutdown()
        end
    end

    local source = readFile("/disk/startup") or readFile("disk/startup")
    if not source then
        error("Cannot read /disk/startup")
    end

    if not writeFile("mine", source) then
        error("Cannot write mine")
    end
    if readFile("mine") ~= source then
        error("Installed mine failed verification")
    end
    if not writeFile("startup", 'shell.run("mine")') then
        error("Cannot write startup")
    end

    if configured.role == "foreman" then
        local cfg = {
            version = VERSION,
            role = "foreman",
            number = configured.number,
            controller = configured.controller,
            rowStart = configured.rowStart,
            rowEnd = configured.rowEnd,
            homeX = 0,
            homeZ = -(configured.number + 1),
            startX = 1,
            startZ = -1,
            startDir = configured.startDir or DIR_N,
            master = false,
            session = configured.session
        }
        saveTable("node.cfg", cfg)
        os.setComputerLabel("Foreman-" .. tostring(cfg.number))
        for i=1,3 do
            send(configured.controller, {
                type = "install_ok",
                id = myID,
                role = "foreman",
                number = cfg.number
            })
            sleep(0.1)
        end

        local deployed = false
        while not deployed do
            local sender, message = rednet.receive(PROTOCOL, 5)
            if sender == configured.controller and type(message) == "table" then
                if message.type == "deploy_foreman" and message.target == myID then
                    local statePath="foreman" .. tostring(cfg.number) .. ".tmp"
                    local state={
                        x=cfg.startX,
                        z=cfg.startZ,
                        y=0,
                        dir=cfg.startDir,
                        phase="DEPLOYING",
                        number=cfg.number,
                        setupDone=false,
                        session=cfg.session,
                        seq=0
                    }

                    saveTable(statePath,state)
                    checkpointPose("foreman",state.seq,state,cfg.session)
                    selfRefuelTo(FOREMAN_FUEL_TARGET)

                    local function saveDeploy()
                        saveTable(statePath,state)
                    end

                    local function checkpointDeploy()
                        local snapshot=textutils.unserialize(textutils.serialize(state))
                        snapshot.motionIntent=nil
                        snapshot.turnIntent=nil
                        checkpointPose("foreman",state.seq,snapshot,cfg.session)
                    end

                    local function deployTurn(right)
                        local from=state.dir
                        local to=right and ((from+1)%4) or ((from+3)%4)
                        local intent={seq=state.seq+1,from=from,to=to}
                        state.turnIntent=intent
                        saveDeploy()

                        local ok
                        if right then ok=turtle.turnRight() else ok=turtle.turnLeft() end
                        if not ok then
                            state.turnIntent=nil
                            saveDeploy()
                            return false
                        end

                        state.dir=to
                        state.seq=intent.seq
                        checkpointDeploy()
                        state.turnIntent=nil
                        saveDeploy()
                        return true
                    end

                    local function deployFace(target)
                        while state.dir~=target do
                            local diff=(target-state.dir)%4
                            if diff==3 then
                                if not deployTurn(false) then return false end
                            else
                                if not deployTurn(true) then return false end
                            end
                        end
                        return true
                    end

                    local function deployForward(directionName)
                        local attempts=0
                        while true do
                            local tx=state.x
                            local tz=state.z
                            if state.dir==DIR_N then tz=tz+1
                            elseif state.dir==DIR_E then tx=tx+1
                            elseif state.dir==DIR_S then tz=tz-1
                            else tx=tx-1 end

                            local intent={
                                seq=state.seq+1,
                                fuelBefore=turtle.getFuelLevel(),
                                from={x=state.x,z=state.z,y=0,dir=state.dir},
                                to={x=tx,z=tz,y=0,dir=state.dir}
                            }
                            state.motionIntent=intent
                            saveDeploy()

                            if turtle.forward() then
                                state.x=tx
                                state.z=tz
                                state.seq=intent.seq
                                checkpointDeploy()
                                state.motionIntent=nil
                                saveDeploy()
                                return true
                            end

                            state.motionIntent=nil
                            saveDeploy()
                            attempts=attempts+1
                            if attempts==1 or attempts%10==0 then
                                send(configured.controller,{
                                    type="foreman_deploy_blocked",
                                    id=myID,
                                    number=cfg.number,
                                    direction=directionName,
                                    attempts=attempts
                                })
                            end
                            sleep(0.5)
                        end
                    end

                    local laneX=cfg.number
                    deployFace(DIR_E)
                    while state.x<laneX do deployForward("east") end
                    deployFace(DIR_S)
                    while state.z>cfg.homeZ do deployForward("south") end
                    deployFace(DIR_W)
                    while state.x>cfg.homeX do deployForward("west") end
                    deployFace(DIR_N)

                    state.phase="WAITING_SETUP"
                    state.setupDone=false
                    checkpointDeploy()
                    saveDeploy()

                    for i=1,3 do
                        send(configured.controller,{
                            type="foreman_deployed",
                            id=myID,
                            number=cfg.number
                        })
                        sleep(0.1)
                    end
                    deployed=true
                end
            end
        end
        os.reboot()
    elseif configured.role == "miner" then
        local cfg={
            version=VERSION,
            role="miner",
            row=configured.row,
            foremanId=configured.foremanId,
            foremanNumber=configured.foremanNumber,
            tempDeployment=configured.tempDeployment and true or false,
            placedFacing=configured.placedFacing,
            session=configured.session,
            commissioned=false
        }

        saveTable("node.cfg",cfg)
        os.setComputerLabel(string.format("Miner-%02d",cfg.row))

        saveTable("miner.tmp",{
            row=cfg.row,
            depth=0,
            pos=0,
            dir=DIR_N,
            phase="COMMISSIONING",
            request=nil,
            requestSeq=0,
            resumeDepth=0,
            resumePos=0,
            resumeDir=DIR_N,
            complete=false,
            installerHeld=false,
            installerFuelSlot=nil,
            orientationTurns=0,
            orientationTurnIntent=nil,
            orientationCalibrated=false,
            originEstablished=false,
            seq=0
        })

        for i=1,3 do
            send(configured.controller,{
                type="install_ok",
                id=myID,
                role="miner",
                row=cfg.row
            })
            sleep(0.1)
        end

        runMinerCommissioning(cfg)
    else
        error("Unknown configured role")
    end
end

local function runMiner(cfg)
    if not openNetwork() then
        error("Wireless modem not found")
    end

    local path="miner.tmp"
    local state=loadTable(path)

    if not state then
        local monitorState=requestPoseBackup("miner",5,cfg.session)
        local exactMonitorPose=monitorState and
            monitorState.row==cfg.row and
            type(monitorState.x)=="number" and type(monitorState.y)=="number" and
            type(monitorState.z)=="number" and type(monitorState.dir)=="number" and
            monitorState.originEstablished==true

        state=exactMonitorPose and monitorState or {
            row=cfg.row,
            x=cfg.row,
            y=0,
            z=0,
            depth=0,
            pos=0,
            dir=DIR_N,
            phase="RECOVERY_LOCK",
            request=nil,
            requestSeq=0,
            resumeX=cfg.row,
            resumeY=0,
            resumeZ=0,
            resumeDepth=0,
            resumePos=0,
            resumeDir=DIR_N,
            complete=false,
            originEstablished=false,
            seq=0
        }

        state.recoveryLocked=true
        state.recoveryReason=exactMonitorPose and
            "Local miner state missing; exact monitor pose retained for manual recovery" or
            "Local miner state missing and monitor has no exact pose"
        state.phase="RECOVERY_LOCK"
        saveTable(path,state)
    end

    state.row=cfg.row
    state.session=cfg.session
    state.seq=tonumber(state.seq) or 0
    state.x=tonumber(state.x) or cfg.row
    state.y=tonumber(state.y) or -(tonumber(state.depth) or 0)
    state.z=tonumber(state.z) or (tonumber(state.pos) or 0)
    state.dir=tonumber(state.dir) or DIR_N
    state.depth=-state.y
    state.pos=state.z
    state.resumeX=tonumber(state.resumeX) or cfg.row
    state.resumeY=tonumber(state.resumeY) or -(tonumber(state.resumeDepth) or 0)
    state.resumeZ=tonumber(state.resumeZ) or (tonumber(state.resumePos) or 0)
    state.resumeDir=tonumber(state.resumeDir) or DIR_N

    local function poseValid()
        return state.originEstablished==true and cfg.orientationCalibrated==true and
            state.x==cfg.row and state.y<=0 and state.z>=0 and state.z<=15 and
            state.dir>=DIR_N and state.dir<=DIR_W
    end

    local function snapshotHasExactPose(snapshot)
        return snapshot and snapshot.row==cfg.row and
            type(snapshot.x)=="number" and type(snapshot.y)=="number" and
            type(snapshot.z)=="number" and type(snapshot.dir)=="number" and
            snapshot.originEstablished==true
    end

    local function applySnapshot(snapshot)
        if not snapshotHasExactPose(snapshot) then
            return false
        end

        state=snapshot
        state.row=cfg.row
        state.seq=tonumber(state.seq) or 0
        state.x=tonumber(state.x)
        state.y=tonumber(state.y)
        state.z=tonumber(state.z)
        state.dir=tonumber(state.dir)
        state.depth=-state.y
        state.pos=state.z
        state.resumeX=tonumber(state.resumeX) or cfg.row
        state.resumeY=tonumber(state.resumeY) or -(tonumber(state.resumeDepth) or 0)
        state.resumeZ=tonumber(state.resumeZ) or (tonumber(state.resumePos) or 0)
        state.resumeDir=tonumber(state.resumeDir) or DIR_N
        return true
    end

    if state.motionIntent or state.turnIntent then
        local monitorState,monitorSeq=requestPoseBackup("miner",5,cfg.session)
        local intent=state.motionIntent or state.turnIntent
        local intentSeq=tonumber(intent.seq) or (state.seq+1)

        if monitorState and snapshotHasExactPose(monitorState) and
            tonumber(monitorSeq or monitorState.seq or 0)>=intentSeq then
            applySnapshot(monitorState)
            state.motionIntent=nil
            state.turnIntent=nil
            saveTable(path,state)
        elseif state.motionIntent then
            local fuelNow=turtle.getFuelLevel()
            local fuelBefore=state.motionIntent.fuelBefore
            local moved=nil

            if type(fuelNow)=="number" and type(fuelBefore)=="number" then
                moved=fuelNow<fuelBefore
            elseif type(fuelBefore)=="number" and fuelBefore<=0 then
                moved=false
            end

            if moved==nil then
                state.recoveryLocked=true
                state.recoveryReason="Position ambiguous after interrupted movement"
                state.phase="RECOVERY_LOCK"
            else
                local pose=moved and state.motionIntent.to or state.motionIntent.from
                state.x=pose.x
                state.y=pose.y
                state.z=pose.z
                state.dir=pose.dir
                state.depth=-state.y
                state.pos=state.z
                if moved then
                    state.seq=intentSeq
                end
                state.motionIntent=nil
            end
            saveTable(path,state)
        else
            state.recoveryLocked=true
            state.recoveryReason="Facing ambiguous after interrupted turn"
            state.phase="RECOVERY_LOCK"
            saveTable(path,state)
        end
    end

    if not poseValid() then
        state.recoveryLocked=true
        state.recoveryReason="Saved miner pose is outside its legal shaft"
        state.phase="RECOVERY_LOCK"
        saveTable(path,state)
    end

    local flags = {
        start=false,
        recall=false,
        dumpNow=false,
        refuelNow=false,
        serviceComplete=false,
        newForeman=nil
    }
    local lastStatus = 0
    local lastRequest = 0

    local function save()
        state.depth=-state.y
        state.pos=state.z
        saveTable(path,state)
    end

    local function minerSnapshot()
        return {
            row=state.row,
            session=cfg.session,
            x=state.x,
            y=state.y,
            z=state.z,
            depth=state.depth,
            pos=state.pos,
            dir=state.dir,
            phase=state.phase,
            request=state.request,
            requestSeq=state.requestSeq,
            resumeX=state.resumeX,
            resumeY=state.resumeY,
            resumeZ=state.resumeZ,
            resumeDepth=state.resumeDepth,
            resumePos=state.resumePos,
            resumeDir=state.resumeDir,
            complete=state.complete,
            originEstablished=state.originEstablished==true,
            orientationCalibrated=cfg.orientationCalibrated==true,
            seq=state.seq
        }
    end

    local function checkpoint()
        checkpointPose("miner",state.seq,minerSnapshot(),cfg.session)
    end

    local function sendState(message)
        status("miner",state.phase,{
            row=state.row,
            foreman=cfg.foremanNumber,
            x=state.x,
            y=state.y,
            z=state.z,
            dir=state.dir,
            seq=state.seq,
            depth=state.depth,
            pos=state.pos,
            fuel=turtle.getFuelLevel(),
            request=state.request and state.request.kind or nil,
            recovery=state.recoveryReason,
            message=message or ""
        })
        lastStatus = now()
    end

    local function requestPacket(arrived)
        if not state.request then
            return
        end
        send(cfg.foremanId,{
            type = arrived and "service_arrived" or "service_request",
            row = state.row,
            requestId = state.request.id,
            service = state.request.kind,
            minerId = os.getComputerID(),
            foremanNumber = cfg.foremanNumber,
            fuel = turtle.getFuelLevel()
        })
        lastRequest = now()
    end

    local function networkLoop()
        local timer = os.startTimer(1)
        while true do
            local event = {os.pullEvent()}
            if event[1] == "rednet_message" then
                local sender = event[2]
                local message = event[3]
                local protocol = event[4]
                if protocol == PROTOCOL and type(message) == "table" then
                    if sender == cfg.foremanId then
                        if message.type=="deploy_miner" and cfg.commissioned then
                            for i=1,3 do
                                send(cfg.foremanId,{
                                    type="miner_deployed",
                                    id=os.getComputerID(),
                                    row=cfg.row
                                })
                                sleep(0.1)
                            end
                        elseif message.type == "start_mining" then
                            flags.start = true
                        elseif message.type == "dump_now" and state.request and message.requestId == state.request.id then
                            flags.dumpNow = true
                        elseif message.type == "refuel_now" and state.request and message.requestId == state.request.id then
                            flags.refuelNow = true
                        elseif message.type == "service_complete" and state.request and message.requestId == state.request.id then
                            flags.serviceComplete = true
                        end
                    elseif sender == MONITOR_ID then
                        if message.type == "recall_all" then
                            flags.recall = true
                        elseif message.type == "status_query" then
                            sendState("")
                        end
                    end
                end
            elseif event[1] == "timer" and event[2] == timer then
                if state.request and now() - lastRequest >= REQUEST_REPEAT then
                    requestPacket(state.phase == "WAITING_SERVICE")
                end
                if now() - lastStatus >= STATUS_INTERVAL then
                    sendState("")
                end
                timer = os.startTimer(1)
            end
        end
    end

    local function beginTranslation(kind,toX,toY,toZ)
        if toX~=cfg.row or toY>0 or toZ<0 or toZ>15 then
            state.recoveryLocked=true
            state.recoveryReason="Movement would leave assigned miner shaft"
            state.phase="RECOVERY_LOCK"
            save()
            sendState(state.recoveryReason)
            return nil
        end

        local intent={
            kind=kind,
            seq=state.seq+1,
            fuelBefore=turtle.getFuelLevel(),
            from={x=state.x,y=state.y,z=state.z,dir=state.dir},
            to={x=toX,y=toY,z=toZ,dir=state.dir}
        }
        state.motionIntent=intent
        save()
        return intent
    end

    local function finishTranslation(intent,critical)
        state.x=intent.to.x
        state.y=intent.to.y
        state.z=intent.to.z
        state.dir=intent.to.dir
        state.seq=intent.seq
        state.depth=-state.y
        state.pos=state.z

        if critical or state.seq%5==0 then
            checkpoint()
        end

        state.motionIntent=nil
        save()
    end

    local function cancelTranslation()
        state.motionIntent=nil
        save()
    end

    local function attemptForward()
        local nx=state.x
        local nz=state.z

        if state.dir==DIR_N then
            nz=nz+1
        elseif state.dir==DIR_E then
            nx=nx+1
        elseif state.dir==DIR_S then
            nz=nz-1
        else
            nx=nx-1
        end

        local intent=beginTranslation("forward",nx,state.y,nz)
        if not intent then return false end
        if not turtle.forward() then
            cancelTranslation()
            return false
        end

        finishTranslation(intent,false)
        return true
    end

    local function attemptUp()
        local intent=beginTranslation("up",state.x,state.y+1,state.z)
        if not intent then return false end
        if not turtle.up() then
            cancelTranslation()
            return false
        end
        finishTranslation(intent,true)
        return true
    end

    local function attemptDown()
        local intent=beginTranslation("down",state.x,state.y-1,state.z)
        if not intent then return false end
        if not turtle.down() then
            cancelTranslation()
            return false
        end
        finishTranslation(intent,true)
        return true
    end

    local function turnStep(right)
        local from=state.dir
        local to=right and ((from+1)%4) or ((from+3)%4)
        local intent={
            seq=state.seq+1,
            from=from,
            to=to
        }
        state.turnIntent=intent
        save()

        local ok
        if right then
            ok=turtle.turnRight()
        else
            ok=turtle.turnLeft()
        end

        if not ok then
            state.turnIntent=nil
            save()
            return false
        end

        state.dir=to
        state.seq=intent.seq
        checkpoint()
        state.turnIntent=nil
        save()
        return true
    end

    local function face(target)
        while state.dir~=target do
            local diff=(target-state.dir)%4
            if diff==3 then
                if not turnStep(false) then return false end
            else
                if not turnStep(true) then return false end
            end
        end
        return true
    end

    local function digForward()
        while not attemptForward() do
            if state.recoveryLocked or flags.recall then
                return false
            end
            turtle.dig()
            turtle.attack()
            sleep(0.15)
        end
        return true
    end

    local function moveUp()
        if state.y>=0 then
            return false
        end
        while not attemptUp() do
            if state.recoveryLocked or flags.recall then
                return false
            end
            turtle.digUp()
            turtle.attackUp()
            sleep(0.15)
        end
        return true
    end

    local function moveDownExisting()
        while not attemptDown() do
            if state.recoveryLocked or flags.recall then
                return false
            end
            turtle.digDown()
            turtle.attackDown()
            sleep(0.15)
        end
        return true
    end

    local function descendMine()
        for i=1,5 do
            if state.recoveryLocked or flags.recall then
                return false
            end
            turtle.digDown()
            if attemptDown() then
                return true
            end
            turtle.attackDown()
            sleep(0.15)
        end
        return false
    end

    local function inventoryFull()
        for slot = 2,16 do
            if turtle.getItemCount(slot) == 0 then
                return false
            end
        end
        return true
    end

    local function distanceHome()
        return (-state.y) + state.z
    end

    local function neededService()
        local dump = inventoryFull()
        local fuel = turtle.getFuelLevel()
        local refuel = false
        if fuel ~= "unlimited" then
            refuel = fuel <= distanceHome() + MINER_SERVICE_RESERVE
        end
        if dump and refuel then
            return "BOTH"
        elseif dump then
            return "DUMP"
        elseif refuel then
            return "REFUEL"
        end
        return nil
    end

    local function goHome(recordResume)
        if state.recoveryLocked or not poseValid() then
            state.phase="RECOVERY_LOCK"
            state.recoveryReason=state.recoveryReason or "Unsafe miner pose; refusing automatic return"
            save()
            sendState(state.recoveryReason)
            return false
        end

        if recordResume then
            state.resumeX=state.x
            state.resumeY=state.y
            state.resumeZ=state.z
            state.resumeDepth=-state.y
            state.resumePos=state.z
            state.resumeDir=state.dir
            save()
        end

        while state.y<0 do
            if not moveUp() then
                return false
            end
        end

        if state.y~=0 then
            state.recoveryLocked=true
            state.recoveryReason="Miner attempted to return above surface origin"
            state.phase="RECOVERY_LOCK"
            save()
            sendState(state.recoveryReason)
            return false
        end

        if not face(DIR_S) then
            return false
        end

        while state.z>0 do
            if not digForward() then
                return false
            end
        end

        if state.z~=0 or state.x~=cfg.row then
            state.recoveryLocked=true
            state.recoveryReason="Miner return ended outside its home coordinate"
            state.phase="RECOVERY_LOCK"
            save()
            sendState(state.recoveryReason)
            return false
        end

        if not face(DIR_N) then
            return false
        end

        checkpoint()
        return true
    end

    local function returnToMine()
        if state.recoveryLocked then
            return false
        end

        if not face(DIR_N) then
            return false
        end

        while state.z<state.resumeZ do
            if not digForward() then
                return false
            end
        end

        while state.y>state.resumeY do
            if not moveDownExisting() then
                return false
            end
        end

        if state.x~=state.resumeX or state.y~=state.resumeY or state.z~=state.resumeZ then
            state.recoveryLocked=true
            state.recoveryReason="Miner could not reconstruct saved work position"
            state.phase="RECOVERY_LOCK"
            save()
            sendState(state.recoveryReason)
            return false
        end

        if not face(state.resumeDir) then
            return false
        end

        state.phase="MINING"
        state.request=nil
        save()
        checkpoint()
        sendState("Resumed")
        return true
    end

    local function faceForeman()
        for i=1,4 do
            local ok,frontId=pcall(peripheral.call,"front","getID")
            if ok and frontId==cfg.foremanId then
                return true
            end
            if not turnStep(true) then
                return false
            end
        end
        return false
    end

    local function dumpItems()
        if not faceForeman() then
            return false
        end
        for slot=2,16 do
            turtle.select(slot)
            while turtle.getItemCount(slot) > 0 do
                if not turtle.drop() then
                    sleep(0.2)
                end
            end
        end
        turtle.select(1)
        return true
    end

    local function refuelSelf()
        turtle.select(1)
        while turtle.getItemCount(1) > 1 and turtle.getFuelLevel() ~= "unlimited" and turtle.getFuelLevel() < MINER_FUEL_TARGET do
            if not turtle.refuel(1) then
                break
            end
        end
    end

    local function service(kind,finalService,resumeExisting)
        if not resumeExisting then
            state.requestSeq=(state.requestSeq or 0)+1
            state.request={
                id=tostring(os.getComputerID()) .. ":" .. tostring(state.requestSeq),
                kind=kind,
                finalService=finalService and true or false
            }
            state.phase="RETURNING_SERVICE"
            save()
            requestPacket(false)
            sendState("Service requested")

            if not goHome(true) then
                return false
            end
        else
            if not state.request then
                state.recoveryLocked=true
                state.recoveryReason="Service phase exists without a persisted request"
                state.phase="RECOVERY_LOCK"
                save()
                return false
            end

            kind=state.request.kind or kind
            finalService=state.request.finalService and true or false

            if state.phase=="RETURNING_SERVICE" then
                if not goHome(false) then
                    return false
                end
            elseif state.phase~="WAITING_SERVICE" then
                state.recoveryLocked=true
                state.recoveryReason="Unexpected persisted service phase"
                state.phase="RECOVERY_LOCK"
                save()
                return false
            end
        end

        state.phase="WAITING_SERVICE"
        save()
        checkpoint()
        requestPacket(true)
        sendState("Waiting for Foreman-" .. tostring(cfg.foremanNumber))

        flags.dumpNow=false
        flags.refuelNow=false
        flags.serviceComplete=false

        while not flags.serviceComplete do
            if flags.recall then
                return false
            end
            if flags.refuelNow then
                flags.refuelNow=false
                refuelSelf()
                send(cfg.foremanId,{
                    type="refuel_complete",
                    row=state.row,
                    requestId=state.request.id,
                    fuel=turtle.getFuelLevel()
                })
            end
            if flags.dumpNow then
                flags.dumpNow=false
                if dumpItems() then
                    send(cfg.foremanId,{
                        type="dump_complete",
                        row=state.row,
                        requestId=state.request.id
                    })
                else
                    send(cfg.foremanId,{
                        type="service_not_adjacent",
                        row=state.row,
                        requestId=state.request.id
                    })
                end
            end
            sleep(0.1)
        end

        flags.serviceComplete=false
        local wasFinal=state.request.finalService and true or false
        state.request=nil

        if wasFinal then
            state.phase="COMPLETE"
            face(DIR_N)
            save()
            checkpoint()
            sendState("Final dump complete")
            return true
        end

        state.phase="RETURNING_MINE"
        save()
        return returnToMine()
    end

    local function recall()
        flags.recall=false

        if state.recoveryLocked then
            state.phase="RECOVERY_LOCK"
            save()
            while true do
                sendState("Recall refused: " .. tostring(state.recoveryReason or "position uncertain"))
                sleep(5)
            end
        end

        state.phase="RECALLING"
        save()
        sendState("Returning for cleanup")

        if not goHome(false) then
            state.phase="RECOVERY_LOCK"
            state.recoveryLocked=true
            state.recoveryReason=state.recoveryReason or "Recall could not prove home position"
            save()
            while true do
                sendState(state.recoveryReason)
                sleep(5)
            end
        end

        if not face(DIR_N) then
            return false
        end

        if state.x~=cfg.row or state.y~=0 or state.z~=0 or state.dir~=DIR_N then
            state.phase="RECOVERY_LOCK"
            state.recoveryLocked=true
            state.recoveryReason="Recall home verification failed"
            save()
            while true do
                sendState(state.recoveryReason)
                sleep(5)
            end
        end

        state.phase="HOME"
        save()
        checkpoint()

        for i=1,5 do
            os.setComputerLabel(nil)
            if os.getComputerLabel()==nil then
                break
            end
            sleep(0.1)
        end

        if os.getComputerLabel()~=nil then
            state.phase="RECOVERY_LOCK"
            state.recoveryLocked=true
            state.recoveryReason="Reached home but could not clear computer label"
            save()
            while true do
                sendState(state.recoveryReason)
                sleep(5)
            end
        end

        for i=1,3 do
            send(MONITOR_ID,{
                type="recall_home",
                row=state.row,
                id=os.getComputerID(),
                labelCleared=true,
                x=state.x,
                y=state.y,
                z=state.z,
                dir=state.dir
            })
            sleep(0.1)
        end

        status("miner","HOME",{row=state.row,x=state.x,y=state.y,z=state.z,dir=state.dir,message="Home verified, label cleared, shutting down"})
        sleep(0.5)
        os.shutdown()
        return true
    end

    send(cfg.foremanId,{
        type="miner_runtime_ready",
        row=state.row,
        minerId=os.getComputerID()
    })

    local function workLoop()
        if state.recoveryLocked then
            state.phase="RECOVERY_LOCK"
            save()
            checkpoint()
            while true do
                sendState("Movement locked: " .. tostring(state.recoveryReason or "pose uncertain"))
                sleep(5)
            end
        end

        checkpoint()

        if state.complete then
            state.phase = "COMPLETE"
            save()
        end

        while state.phase == "WAITING" and not flags.start do
            if flags.recall then
                recall()
            end
            sleep(0.1)
        end

        if state.phase == "COMPLETE" then
            while true do
                if flags.recall then
                    recall()
                end
                sleep(0.2)
            end
        end

        if state.phase == "WAITING_SERVICE" or state.phase == "RETURNING_SERVICE" then
            local kind=state.request and state.request.kind or "DUMP"
            service(kind,state.request and state.request.finalService,true)
        elseif state.phase == "RETURNING_MINE" then
            returnToMine()
        elseif state.phase == "MINING" then
        else
            state.phase="WAITING"
            save()

            while not flags.start do
                if flags.recall then
                    recall()
                end
                sleep(0.1)
            end

            state.phase="MINING"
            save()
        end

        while true do
            if flags.recall then
                recall()
            end

            local kind = neededService()
            if kind then
                if not service(kind) then
                    recall()
                end
            end

            if state.dir == DIR_N then
                while state.pos < 15 do
                    if flags.recall then
                        recall()
                    end
                    local s = neededService()
                    if s then
                        service(s)
                    end
                    if not digForward() then
                        recall()
                    end
                end
                if not descendMine() then
                    sendState("Bedrock reached")
                    if not service("DUMP", true) then
                        recall()
                    end
                    state.complete = true
                    state.phase = "COMPLETE"
                    save()
                    send(cfg.foremanId,{
                        type="miner_complete",
                        row=state.row,
                        minerId=os.getComputerID(),
                        foremanNumber=cfg.foremanNumber
                    })
                    while true do
                        if flags.recall then
                            recall()
                        end
                        sleep(0.2)
                    end
                end
                face(DIR_S)
            else
                while state.pos > 0 do
                    if flags.recall then
                        recall()
                    end
                    local s = neededService()
                    if s then
                        service(s)
                    end
                    if not digForward() then
                        recall()
                    end
                end
                if not descendMine() then
                    sendState("Bedrock reached")
                    if not service("DUMP", true) then
                        recall()
                    end
                    state.complete = true
                    state.phase = "COMPLETE"
                    save()
                    send(cfg.foremanId,{
                        type="miner_complete",
                        row=state.row,
                        minerId=os.getComputerID(),
                        foremanNumber=cfg.foremanNumber
                    })
                    while true do
                        if flags.recall then
                            recall()
                        end
                        sleep(0.2)
                    end
                end
                face(DIR_N)
            end
        end
    end

    parallel.waitForAny(networkLoop, workLoop)
end

local function runForeman(cfg)
    if not openNetwork() then
        error("Wireless modem not found")
    end

    if not getSelfInventory() then
        error("Narcissistic inventory peripheral not found")
    end

    local number = cfg.number
    local id = os.getComputerID()
    local statePath = "foreman" .. tostring(number) .. ".tmp"
    local queuePath = "foreman" .. tostring(number) .. "_queue.tmp"
    local state=loadTable(statePath)

    if not state then
        local monitorState=requestPoseBackup("foreman",5,cfg.session)
        state=monitorState or {
            number=number,
            x=cfg.homeX,
            z=cfg.homeZ,
            y=0,
            dir=DIR_N,
            phase="RECOVERY_LOCK",
            setupDone=false,
            seq=0
        }
        state.recoveryLocked=true
        state.recoveryReason=monitorState and
            "Local foreman state missing; monitor backup retained for manual recovery" or
            "Local foreman state missing and monitor has no backup"
        state.phase="RECOVERY_LOCK"
        saveTable(statePath,state)
    end

    state.session=cfg.session
    state.y=tonumber(state.y) or 0
    state.seq=tonumber(state.seq) or 0
    state.dir=tonumber(state.dir) or DIR_N

    local function foremanPoseValid()
        return state.x>=-3 and state.x<=17 and state.z>=-6 and state.z<=2 and
            state.y>=0 and state.y<=1 and state.dir>=DIR_N and state.dir<=DIR_W
    end

    if state.motionIntent or state.verticalIntent or state.turnIntent then
        local monitorState,monitorSeq=requestPoseBackup("foreman",5,cfg.session)
        local intent=state.motionIntent or state.verticalIntent or state.turnIntent
        local intentSeq=tonumber(intent.seq) or (state.seq+1)

        if monitorState and tonumber(monitorSeq or monitorState.seq or 0)>=intentSeq then
            state=monitorState
            state.motionIntent=nil
            state.verticalIntent=nil
            state.turnIntent=nil
            saveTable(statePath,state)
        elseif state.turnIntent then
            state.recoveryLocked=true
            state.recoveryReason="Facing ambiguous after interrupted turn"
            state.phase="RECOVERY_LOCK"
            saveTable(statePath,state)
        else
            local moveIntent=state.motionIntent or state.verticalIntent
            local fuelNow=turtle.getFuelLevel()
            local fuelBefore=moveIntent.fuelBefore
            local moved=nil

            if type(fuelNow)=="number" and type(fuelBefore)=="number" then
                moved=fuelNow<fuelBefore
            elseif type(fuelBefore)=="number" and fuelBefore<=0 then
                moved=false
            end

            if moved==nil then
                state.recoveryLocked=true
                state.recoveryReason="Position ambiguous after interrupted foreman movement"
                state.phase="RECOVERY_LOCK"
            elseif state.motionIntent then
                local pose=moved and state.motionIntent.to or state.motionIntent.from
                state.x=pose.x
                state.z=pose.z
                state.y=pose.y
                state.dir=pose.dir
                if moved then state.seq=intentSeq end
                state.motionIntent=nil
            else
                state.y=moved and state.verticalIntent.to or state.verticalIntent.from
                if moved then state.seq=intentSeq end
                state.verticalIntent=nil
            end
            saveTable(statePath,state)
        end
    end

    if not foremanPoseValid() then
        state.recoveryLocked=true
        state.recoveryReason="Saved foreman pose is outside the operating area"
        state.phase="RECOVERY_LOCK"
        saveTable(statePath,state)
    end

    local qdata = loadTable(queuePath) or {queue={},active=nil,resolved={}}
    local queue = qdata.queue or {}
    local active = qdata.active
    local resolved = qdata.resolved or {}
    local peers = {}
    local intents = {}
    local inbox = {}
    local commissionWave = {}
    local flags = {
        commissionStart=false,
        startMining=false,
        dockGranted=false,
        recall=false
    }
    local dock = nil
    if number == 1 then
        dock = loadTable("dock.tmp") or {holder=nil,queue={}}
    end
    local lastStatus = 0
    local lastPeer = 0

    local function saveState()
        saveTable(statePath,state)
    end

    local function foremanSnapshot()
        local raw=textutils.serialize(state)
        local snapshot=textutils.unserialize(raw)
        snapshot.motionIntent=nil
        snapshot.verticalIntent=nil
        snapshot.turnIntent=nil
        return snapshot
    end

    local function checkpointForeman()
        checkpointPose("foreman",state.seq,foremanSnapshot(),cfg.session)
    end

    local function turnQuarter(right)
        local from=state.dir
        local to=right and ((from+1)%4) or ((from+3)%4)
        local intent={seq=state.seq+1,from=from,to=to}
        state.turnIntent=intent
        saveState()

        local ok
        if right then
            ok=turtle.turnRight()
        else
            ok=turtle.turnLeft()
        end

        if not ok then
            state.turnIntent=nil
            saveState()
            return false
        end

        state.dir=to
        state.seq=intent.seq
        checkpointForeman()
        state.turnIntent=nil
        saveState()
        return true
    end

    local function faceTracked(target)
        if state.recoveryLocked then
            return false
        end

        while state.dir~=target do
            local diff=(target-state.dir)%4
            if diff==3 then
                if not turnQuarter(false) then return false end
            else
                if not turnQuarter(true) then return false end
            end
        end

        return true
    end

    local function saveQueue()
        saveTable(queuePath,{queue=queue,active=active,resolved=resolved})
    end

    local function saveDock()
        if number == 1 and dock then
            saveTable("dock.tmp",dock)
        end
    end

    local function sendState(message)
        status("foreman",state.phase,{
            number=number,
            rowStart=cfg.rowStart,
            rowEnd=cfg.rowEnd,
            x=state.x,
            z=state.z,
            y=state.y,
            dir=state.dir,
            seq=state.seq,
            queue=#queue + (active and 1 or 0),
            recovery=state.recoveryReason,
            message=message or ""
        })
        lastStatus = now()
    end

    local function pushInbox(sender,message)
        inbox[#inbox+1] = {sender=sender,message=message}
        if #inbox > 100 then
            table.remove(inbox,1)
        end
    end

    local function popInbox(predicate)
        for i=1,#inbox do
            local entry = inbox[i]
            if predicate(entry.sender,entry.message) then
                table.remove(inbox,i)
                return entry.sender,entry.message
            end
        end
        return nil,nil
    end

    local function waitInbox(predicate, timeout)
        local deadline = now() + timeout
        while now() < deadline do
            local sender,message = popInbox(predicate)
            if sender then
                return sender,message
            end
            sleep(0.05)
        end
        return nil,nil
    end

    local function assignedRow(row)
        return row >= cfg.rowStart and row <= cfg.rowEnd
    end

    local function upsertRequest(message)
        if not assignedRow(message.row or -1) then
            return
        end
        local requestId = message.requestId
        if resolved[requestId] then
            if message.minerId then
                send(message.minerId,{
                    type="service_complete",
                    requestId=requestId
                })
            end
            return
        end
        if active and active.requestId == requestId then
            active.arrived = active.arrived or message.type == "service_arrived"
            active.lastSeen = now()
            saveQueue()
            return
        end
        for i=1,#queue do
            if queue[i].requestId == requestId then
                queue[i].arrived = queue[i].arrived or message.type == "service_arrived"
                queue[i].lastSeen = now()
                saveQueue()
                return
            end
        end
        queue[#queue+1] = {
            requestId=requestId,
            row=message.row,
            service=message.service,
            minerId=message.minerId,
            arrived=message.type == "service_arrived",
            lastSeen=now()
        }
        saveQueue()
        send(message.minerId,{
            type="service_ack",
            requestId=requestId,
            row=message.row
        })
        sendState("Queued Miner-" .. tostring(message.row))
    end

    local function dockContains(fid)
        if dock.holder == fid then
            return true
        end
        for i=1,#dock.queue do
            if dock.queue[i] == fid then
                return true
            end
        end
        return false
    end

    local function grantDock()
        if number ~= 1 then
            return
        end
        if not dock.holder and #dock.queue > 0 then
            dock.holder = table.remove(dock.queue,1)
            saveDock()
            if dock.holder == id then
                flags.dockGranted = true
            else
                send(dock.holder,{type="dock_grant"})
            end
        end
    end

    local function requestDock()
        flags.dockGranted = false
        if number == 1 then
            if dock.holder == id then
                flags.dockGranted = true
            else
                if not dockContains(id) then
                    dock.queue[#dock.queue+1] = id
                    saveDock()
                end
                grantDock()
            end
        else
            broadcast({
                type="dock_request",
                foremanId=id,
                number=number
            })
        end
        local lastRequest = now()
        while not flags.dockGranted do
            if number ~= 1 and now() - lastRequest >= 2 then
                broadcast({
                    type="dock_request",
                    foremanId=id,
                    number=number
                })
                lastRequest = now()
            end
            sleep(0.05)
        end
    end

    local function releaseDock()
        flags.dockGranted = false
        if number == 1 then
            if dock.holder == id then
                dock.holder = nil
                saveDock()
                grantDock()
            end
        else
            send(cfg.controller,{type="dock_release",foremanId=id})
        end
    end

    local function occupied(tx,tz)
        for pid,p in pairs(peers) do
            if pid ~= id and p.x == tx and p.z == tz and now() - (p.lastSeen or 0) < 8 then
                return true
            end
        end
        return false
    end

    local function lowerIntentWins(tx,tz)
        for pid,p in pairs(intents) do
            if pid ~= id and p.x == tx and p.z == tz and now() - (p.lastSeen or 0) < 1 then
                if (p.number or 99) < number then
                    return true
                end
            end
        end
        return false
    end

    local function moveVertical(targetY)
        if state.recoveryLocked then
            return false
        end

        if targetY~=0 and targetY~=1 then
            state.phase="VERTICAL_ERROR"
            saveState()
            sendState("Invalid relative Y target " .. tostring(targetY))
            return false
        end

        while state.y<targetY do
            state.phase="MOVING_UP"
            local intent={
                seq=state.seq+1,
                from=state.y,
                to=state.y+1,
                fuelBefore=turtle.getFuelLevel()
            }
            state.verticalIntent=intent
            saveState()

            if not turtle.up() then
                state.verticalIntent=nil
                state.phase="VERTICAL_ERROR"
                saveState()
                sendState("Unable to move up to relative Y " .. tostring(targetY))
                return false
            end

            state.y=intent.to
            state.seq=intent.seq
            checkpointForeman()
            state.verticalIntent=nil
            saveState()
        end

        while state.y>targetY do
            state.phase="MOVING_DOWN"
            local intent={
                seq=state.seq+1,
                from=state.y,
                to=state.y-1,
                fuelBefore=turtle.getFuelLevel()
            }
            state.verticalIntent=intent
            saveState()

            if not turtle.down() then
                state.verticalIntent=nil
                state.phase="VERTICAL_ERROR"
                saveState()
                sendState("Unable to move down to relative Y " .. tostring(targetY))
                return false
            end

            state.y=intent.to
            state.seq=intent.seq
            checkpointForeman()
            state.verticalIntent=nil
            saveState()
        end

        return state.y==targetY
    end

    local function ensureGroundLevel()
        if state.y~=0 then
            sendState("Correcting foreman to staging height")
        end
        return moveVertical(0)
    end

    local function ensureInstallerLevel()
        if state.y~=1 then
            sendState("Correcting foreman to installer height")
        end
        return moveVertical(1)
    end

    local function verifyGroundFrontNoDrive()
        if state.y~=0 then
            return false
        end
        return peripheral.getType("front")~="drive"
    end

    local function moveStep(targetDir)
        if not ensureGroundLevel() then
            state.phase="VERTICAL_ERROR"
            saveState()
            sendState("Horizontal movement blocked because foreman is not at staging height")
            return false
        end

        if not faceTracked(targetDir) then
            return false
        end
        local tx = state.x
        local tz = state.z
        if targetDir == DIR_N then
            tz = tz + 1
        elseif targetDir == DIR_E then
            tx = tx + 1
        elseif targetDir == DIR_S then
            tz = tz - 1
        else
            tx = tx - 1
        end

        if tx<-3 or tx>17 or tz<-6 or tz>2 then
            state.recoveryLocked=true
            state.recoveryReason="Foreman movement would leave operating area"
            state.phase="RECOVERY_LOCK"
            saveState()
            sendState(state.recoveryReason)
            return false
        end

        local attempts = 0
        while attempts < MOVE_RETRY_LIMIT do
            attempts = attempts + 1
            if not occupied(tx,tz) then
                broadcast({
                    type="move_intent",
                    foremanId=id,
                    number=number,
                    x=tx,
                    z=tz
                })
                intents[id] = {number=number,x=tx,z=tz,lastSeen=now()}
                sleep(MOVE_RESERVE_TIME)
                if not occupied(tx,tz) and not lowerIntentWins(tx,tz) then
                    local intent={
                        seq=state.seq+1,
                        fuelBefore=turtle.getFuelLevel(),
                        from={x=state.x,z=state.z,y=state.y,dir=state.dir},
                        to={x=tx,z=tz,y=state.y,dir=state.dir}
                    }
                    state.motionIntent=intent
                    saveState()

                    if turtle.forward() then
                        state.x=tx
                        state.z=tz
                        state.seq=intent.seq
                        intents[id]=nil
                        checkpointForeman()
                        state.motionIntent=nil
                        saveState()
                        broadcast({
                            type="foreman_position",
                            foremanId=id,
                            number=number,
                            x=state.x,
                            z=state.z,
                            y=state.y,
                            phase=state.phase
                        })
                        return true
                    else
                        state.motionIntent=nil
                        saveState()
                    end
                end
            end
            sleep(0.2)
        end

        state.phase = "BLOCKED"
        saveState()
        sendState("Movement blocked at " .. tostring(tx) .. "," .. tostring(tz))
        return false
    end

    local function goTo(tx,tz)
        if state.recoveryLocked then
            return false
        end
        if not ensureGroundLevel() then
            return false
        end

        while state.x < tx do
            if not moveStep(DIR_E) then return false end
        end
        while state.x > tx do
            if not moveStep(DIR_W) then return false end
        end
        while state.z < tz do
            if not moveStep(DIR_N) then return false end
        end
        while state.z > tz do
            if not moveStep(DIR_S) then return false end
        end
        return true
    end

    local function useOwnFuel()
        if turtle.getFuelLevel() == "unlimited" then
            return true
        end

        local fuel = turtle.getFuelLevel()
        if fuel > FOREMAN_FUEL_LOW then
            return true
        end

        local piecesNeeded = math.ceil((FOREMAN_FUEL_TARGET - fuel) / COAL_FUEL_VALUE)

        if selfCount("coal") < piecesNeeded then
            return false
        end

        local remaining = piecesNeeded

        while remaining > 0 do
            local slot = selfFindSlot("coal")
            if not slot then
                return false
            end

            turtle.select(slot)
            local available = turtle.getItemCount(slot)
            local consume = math.min(remaining, available)

            if consume <= 0 then
                return false
            end

            if not turtle.refuel(consume) then
                return false
            end

            remaining = remaining - consume
        end

        return turtle.getFuelLevel() >= FOREMAN_FUEL_TARGET
    end

    local function refuelAtFrontTo(target)
        if turtle.getFuelLevel() == "unlimited" then
            return true
        end

        local fuel = turtle.getFuelLevel()
        if fuel >= target then
            return true
        end

        local piecesNeeded = math.ceil((target - fuel) / COAL_FUEL_VALUE)
        local onboard = selfCount("coal")
        local toPull = piecesNeeded - onboard

        if toPull > 0 then
            if takeNamedIntoSelf("coal",toPull) < toPull then
                return false
            end
        end

        local remaining = piecesNeeded

        while remaining > 0 do
            local slot = selfFindSlot("coal")
            if not slot then
                return false
            end

            turtle.select(slot)
            local available = turtle.getItemCount(slot)
            local consume = math.min(remaining, available)

            if consume <= 0 then
                return false
            end

            if not turtle.refuel(consume) then
                return false
            end

            remaining = remaining - consume
        end

        return turtle.getFuelLevel() >= target
    end

    local function goDockBypass(targetX)
        if state.x ~= -1 then
            if not goTo(-1,state.z) then
                return false
            end
        end
        if state.z ~= 0 then
            if not goTo(-1,0) then
                return false
            end
        end
        if state.x ~= targetX then
            if not goTo(targetX,0) then
                return false
            end
        end
        return true
    end

    local function goPrivateHome()
        if state.x <= 0 then
            if state.x ~= -1 then
                if not goTo(-1,state.z) then
                    return false
                end
            end
            if not goTo(-1,cfg.homeZ) then
                return false
            end
            if not goTo(cfg.homeX,cfg.homeZ) then
                return false
            end
        else
            if not goTo(state.x,cfg.homeZ) then
                return false
            end
            if not goTo(cfg.homeX,cfg.homeZ) then
                return false
            end
        end
        return true
    end

    local function returnHome()
        if not goPrivateHome() then
            return false
        end
        faceTracked(DIR_N)
        state.phase = "IDLE"
        saveState()
        sendState("Waiting")
        return true
    end

    local function prepareDockTrip()
        if state.x ~= cfg.homeX or state.z ~= cfg.homeZ then
            if not goPrivateHome() then
                state.phase="BLOCKED"
                saveState()
                sendState("Cannot return to private lane before dock trip")
                return false
            end
        end
        return true
    end

    local function atSupply()
        if not prepareDockTrip() then
            return false
        end

        requestDock()

        if not goDockBypass(0) then
            state.phase="DOCK_BLOCKED"
            saveState()
            sendState("Supply dock path blocked; token retained")
            return false
        end

        faceTracked(DIR_N)
        saveState()
        return true
    end

    local function atFuel()
        if not prepareDockTrip() then
            return false
        end

        requestDock()

        if not goDockBypass(-2) then
            state.phase="DOCK_BLOCKED"
            saveState()
            sendState("Fuel dock path blocked; token retained")
            return false
        end

        faceTracked(DIR_N)
        saveState()
        return true
    end

    local function exitDockToLane()
        if state.x ~= -1 then
            if not goTo(-1,state.z) then
                return false
            end
        end

        if state.z ~= cfg.homeZ then
            if not goTo(-1,cfg.homeZ) then
                return false
            end
        end

        if not goTo(cfg.homeX,cfg.homeZ) then
            return false
        end

        releaseDock()
        return true
    end

    local function exitDockHome()
        if not exitDockToLane() then
            return false
        end
        faceTracked(DIR_N)
        state.phase="IDLE"
        saveState()
        sendState("Waiting")
        return true
    end

    local function loadOwnFuel()
        if turtle.getFuelLevel() == "unlimited" then
            return true
        end

        if turtle.getFuelLevel() > FOREMAN_FUEL_LOW then
            return true
        end

        if useOwnFuel() then
            return true
        end

        if not atFuel() then
            return false
        end

        local ok = refuelAtFrontTo(FOREMAN_FUEL_TARGET)

        if not ok then
            state.phase="WAITING_FUEL"
            saveState()
            sendState("Unable to reach foreman fuel target")
            return false
        end

        return exitDockHome()
    end

    local function dumpCargo()
        if not atSupply() then
            return false
        end

        for slot=1,16 do
            local item=selfItem(slot)
            local reserved=number==1 and state.bootstrapDrivePending and state.bootstrapDriveSlot==slot

            if item and not reserved and not isForemanCoreItem(item) then
                turtle.select(slot)
                while turtle.getItemCount(slot)>0 do
                    if not turtle.drop() then
                        state.phase="DOCK_BLOCKED"
                        saveState()
                        sendState("Supply chest full; dock token retained")
                        return false
                    end
                end
            end
        end

        if number==1 and state.bootstrapDrivePending and state.bootstrapDriveSlot then
            local slot=state.bootstrapDriveSlot
            local item=selfItem(slot)

            if item and matchesItem(item,"disk_drive") then
                turtle.select(slot)
                if not turtle.drop(1) then
                    state.phase="DOCK_BLOCKED"
                    saveState()
                    sendState("Cannot return bootstrap Disk Drive")
                    return false
                end
            end

            state.bootstrapDrivePending=false
            state.bootstrapDriveSlot=nil
            saveState()
        end

        return exitDockHome()
    end

    local function fetchMinerFuel()
        if not atFuel() then
            return false
        end

        local got = takeNamedIntoSelf("coal",64)
        if got <= 0 then
            return false
        end

        return exitDockToLane()
    end

    local function networkLoop()
        local timer = os.startTimer(1)
        while true do
            local event = {os.pullEvent()}
            if event[1] == "rednet_message" then
                local sender = event[2]
                local message = event[3]
                local protocol = event[4]
                if protocol == PROTOCOL and type(message) == "table" then
                    if message.type == "service_request" or message.type == "service_arrived" then
                        upsertRequest(message)
                    elseif message.type == "foreman_position" then
                        peers[message.foremanId] = {
                            number=message.number,
                            x=message.x,
                            z=message.z,
                            phase=message.phase,
                            lastSeen=now()
                        }
                    elseif message.type == "move_intent" then
                        intents[message.foremanId] = {
                            number=message.number,
                            x=message.x,
                            z=message.z,
                            lastSeen=now()
                        }
                    elseif message.type == "dock_request" and number == 1 then
                        if dock.holder == message.foremanId then
                            send(message.foremanId,{type="dock_grant"})
                        else
                            if not dockContains(message.foremanId) then
                                dock.queue[#dock.queue+1] = message.foremanId
                                saveDock()
                            end
                            grantDock()
                        end
                    elseif message.type == "dock_release" and number == 1 then
                        if dock.holder == message.foremanId then
                            dock.holder = nil
                            saveDock()
                            grantDock()
                        end
                    elseif message.type == "dock_grant" then
                        flags.dockGranted = true
                    elseif message.type == "commission_start" and message.number == number and sender == cfg.controller then
                        if state.setupDone then
                            send(cfg.controller,{
                                type="commission_done",
                                number=number,
                                id=id
                            })
                        else
                            flags.commissionStart = true
                        end
                    elseif message.type == "start_assigned" and sender == cfg.controller then
                        flags.startMining = true
                    elseif message.type == "miner_runtime_ready" and message.row and assignedRow(message.row) then
                        state.minerIds=state.minerIds or {}
                        if not state.minerIds[message.row] or state.minerIds[message.row]==sender then
                            state.minerIds[message.row]=sender
                            saveState()
                            if state.miningStarted then
                                send(sender,{type="start_mining"})
                            end
                        end
                    elseif message.type == "commission_done" and cfg.master and message.number then
                        state.groupsCommissioned = state.groupsCommissioned or {}
                        state.groupsCommissioned[message.number] = true
                        commissionWave[message.number] = nil
                        saveState()
                        pushInbox(sender,message)
                    elseif message.type == "start_mining" then
                        flags.startMining = true
                    elseif message.type == "recall_all" then
                        flags.recall = true
                    elseif message.type == "status_query" then
                        sendState("")
                    else
                        pushInbox(sender,message)
                    end
                end
            elseif event[1] == "timer" and event[2] == timer then
                if now() - lastStatus >= STATUS_INTERVAL then
                    sendState("")
                end
                if cfg.master then
                    for n=2,4 do
                        if commissionWave[n] and cfg.foremen and cfg.foremen[n] then
                            if not commissionWave[n].lastSend or now() - commissionWave[n].lastSend >= 2 then
                                send(cfg.foremen[n],{type="commission_start",number=n})
                                commissionWave[n].lastSend = now()
                            end
                        end
                    end
                end
                if number == 1 and dock and dock.holder and dock.holder ~= id then
                    local holder = peers[dock.holder]
                    if not holder or now() - (holder.lastSeen or 0) > 15 then
                        dock.holder = nil
                        saveDock()
                        grantDock()
                    end
                end
                for requestId,stamp in pairs(resolved) do
                    if now() - stamp > 300 then
                        resolved[requestId] = nil
                    end
                end
                if now() - lastPeer >= PEER_INTERVAL then
                    broadcast({
                        type="foreman_position",
                        foremanId=id,
                        number=number,
                        x=state.x,
                        z=state.z,
                        y=state.y,
                        phase=state.phase
                    })
                    lastPeer = now()
                end
                timer = os.startTimer(1)
            end
        end
    end

    local function frontComputerId()
        local ok,id = pcall(peripheral.call,"front","getID")
        if ok and type(id)=="number" then
            return id
        end
        return nil
    end

    local function verifyMinerStaging(tx,tz)
        if state.x ~= tx or state.z ~= tz-1 then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Wrong miner staging square: expected " .. tostring(tx) .. "," .. tostring(tz-1) ..
                " got " .. tostring(state.x) .. "," .. tostring(state.z))
            return false
        end

        faceTracked(DIR_N)
        saveState()
        return true
    end

    local function placeDriveAndDiskAt(tx,tz)
        local stagingZ=tz-1

        if state.x~=tx or state.z~=stagingZ then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Wrong staging square before installer placement")
            return false
        end

        if not ensureGroundLevel() then
            return false
        end

        faceTracked(DIR_N)
        saveState()

        if peripheral.getType("front")=="drive" then
            local reserved=state.bootstrapDrivePending and state.bootstrapDriveSlot or nil
            local slot=selfTargetSlotExcluding("disk_drive",reserved)

            if not slot then
                state.phase="PLACEMENT_ERROR"
                saveState()
                sendState("No room to recover misplaced ground Disk Drive")
                return false
            end

            turtle.select(slot)
            if not turtle.dig() then
                state.phase="PLACEMENT_ERROR"
                saveState()
                sendState("Cannot recover misplaced ground Disk Drive")
                return false
            end
            sleep(0.2)
        end

        if frontComputerId() then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Miner square already occupied")
            return false
        end

        if not ensureInstallerLevel() then
            return false
        end

        faceTracked(DIR_N)
        state.phase="PLACING_INSTALLER"
        saveState()

        if peripheral.getType("front")~="drive" then
            if turtle.detect() then
                state.phase="PLACEMENT_ERROR"
                saveState()
                sendState("Installer square blocked at relative Y 1")
                ensureGroundLevel()
                return false
            end

            local reserved=state.bootstrapDrivePending and state.bootstrapDriveSlot or nil
            local driveSlot=selfFindSlotExcluding("disk_drive",reserved)

            if not driveSlot then
                state.phase="WAITING_INSTALLER"
                saveState()
                sendState("Operational Disk Drive not found")
                ensureGroundLevel()
                return false
            end

            turtle.select(driveSlot)
            if not turtle.place() then
                state.phase="PLACEMENT_ERROR"
                saveState()
                sendState("Cannot place Disk Drive directly in front at relative Y 1")
                ensureGroundLevel()
                return false
            end
            sleep(0.2)
        end

        if state.y~=1 or peripheral.getType("front")~="drive" then
            state.phase="VERTICAL_ERROR"
            saveState()
            sendState("Disk Drive is not directly in front at installer height")
            ensureGroundLevel()
            return false
        end

        if not disk.isPresent("front") then
            if not selfSelectKind("floppy") then
                state.phase="WAITING_INSTALLER"
                saveState()
                sendState("Miner floppy not found")
                ensureGroundLevel()
                return false
            end

            if not turtle.drop(1) then
                state.phase="WAITING_INSTALLER"
                saveState()
                sendState("Cannot insert floppy into Disk Drive directly in front")
                ensureGroundLevel()
                return false
            end
            sleep(0.3)
        end

        if not disk.isPresent("front") then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Floppy verification failed at installer height")
            ensureGroundLevel()
            return false
        end

        if not ensureGroundLevel() then
            return false
        end

        faceTracked(DIR_N)
        saveState()

        if not verifyGroundFrontNoDrive() then
            state.phase="VERTICAL_ERROR"
            saveState()
            sendState("Disk Drive is at ground level; correcting placement")

            local reserved=state.bootstrapDrivePending and state.bootstrapDriveSlot or nil
            local slot=selfTargetSlotExcluding("disk_drive",reserved)
            if not slot then
                return false
            end

            turtle.select(slot)
            if not turtle.dig() then
                sendState("Cannot recover ground-level Disk Drive for correction")
                return false
            end

            if not ensureInstallerLevel() then
                return false
            end

            local driveSlot=selfFindSlotExcluding("disk_drive",reserved)
            if not driveSlot then
                ensureGroundLevel()
                return false
            end

            turtle.select(driveSlot)
            if not turtle.place() then
                ensureGroundLevel()
                return false
            end

            if peripheral.getType("front")~="drive" then
                ensureGroundLevel()
                return false
            end

            if not disk.isPresent("front") then
                if not selfSelectKind("floppy") or not turtle.drop(1) then
                    ensureGroundLevel()
                    return false
                end
            end

            if not ensureGroundLevel() then
                return false
            end

            faceTracked(DIR_N)
            if not verifyGroundFrontNoDrive() then
                state.phase="VERTICAL_ERROR"
                saveState()
                sendState("Disk Drive remained at ground level after correction")
                return false
            end
        end

        state.phase="PLACING_MINER"
        saveState()
        return state.y==0 and state.x==tx and state.z==stagingZ and state.dir==DIR_N
    end

    local function recoverInstaller(workerId,tx,tz,useBootstrapDrive)
        local stagingZ=tz-1

        if state.x~=tx or state.z~=stagingZ then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Foreman moved away before installer recovery")
            return false
        end

        if not ensureGroundLevel() then
            return false
        end

        faceTracked(DIR_N)

        if frontComputerId()~=workerId then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Assigned miner not directly in front")
            return false
        end

        if not ensureInstallerLevel() then
            return false
        end

        faceTracked(DIR_N)
        state.phase="RETRIEVING_FLOPPY"
        saveState()

        if peripheral.getType("front")~="drive" then
            state.phase="VERTICAL_ERROR"
            saveState()
            sendState("Disk Drive is not directly in front at installer height")
            ensureGroundLevel()
            return false
        end

        local floppySlot=selfTargetSlot("floppy")
        if not floppySlot then
            state.phase="WAITING_INSTALLER"
            saveState()
            sendState("No inventory room for floppy")
            ensureGroundLevel()
            return false
        end

        turtle.select(floppySlot)
        local floppyDeadline=now()+10

        while not matchesItem(selfItem(floppySlot),"floppy") and now()<floppyDeadline do
            turtle.suck(1)
            if not matchesItem(selfItem(floppySlot),"floppy") then
                sleep(0.25)
            end
        end

        if not matchesItem(selfItem(floppySlot),"floppy") then
            state.phase="WAITING_INSTALLER"
            saveState()
            sendState("Could not retrieve miner floppy")
            ensureGroundLevel()
            return false
        end

        if not ensureGroundLevel() then
            return false
        end

        faceTracked(DIR_N)

        if peripheral.getType("front")=="drive" then
            state.phase="VERTICAL_ERROR"
            saveState()
            sendState("Disk Drive detected at ground level after floppy retrieval")
            return false
        end

        if frontComputerId()~=workerId then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Assigned miner moved before Disk Drive handoff")
            return false
        end

        state.phase="WAITING_FOR_DRIVE"
        saveState()
        sendState("Waiting for miner to break Disk Drive")

        local ready=nil
        local lastRequest=0
        local lastWarning=now()

        while not ready do
            if now()-lastRequest>=1 then
                send(workerId,{type="return_installer"})
                lastRequest=now()
            end

            local _,reply=waitInbox(function(sender,m)
                return sender==workerId and type(m)=="table" and
                    (m.type=="installer_ready" or m.type=="installer_break_failed")
            end,0.5)

            if reply then
                if reply.type=="installer_ready" then
                    ready=reply
                else
                    sendState("Miner installer break retry: " .. tostring(reply.reason))
                end
            elseif now()-lastWarning>=10 then
                sendState("Still waiting for miner to break Disk Drive")
                lastWarning=now()
            end
        end

        local beforeCount=selfCount("disk_drive")
        local targetSlot=nil

        if useBootstrapDrive then
            targetSlot=selfEmptySlot()
        else
            local reserved=state.bootstrapDrivePending and state.bootstrapDriveSlot or nil
            targetSlot=selfTargetSlotExcluding("disk_drive",reserved)
        end

        if not targetSlot then
            state.phase="WAITING_INSTALLER"
            saveState()
            sendState("No room for returned Disk Drive")
            return false
        end

        turtle.select(targetSlot)
        lastWarning=now()

        while selfCount("disk_drive")<=beforeCount do
            turtle.suck(1)

            if selfCount("disk_drive")<=beforeCount then
                send(workerId,{type="return_installer"})
                if now()-lastWarning>=10 then
                    sendState("Still waiting to receive Disk Drive")
                    lastWarning=now()
                end
                sleep(0.25)
            end
        end

        if useBootstrapDrive then
            state.bootstrapDrivePending=true
            state.bootstrapDriveSlot=targetSlot
            saveState()
        end

        local returned=nil
        local lastTaken=0
        lastWarning=now()

        while not returned do
            if now()-lastTaken>=1 then
                send(workerId,{type="installer_taken"})
                lastTaken=now()
            end

            local _,reply=waitInbox(function(sender,m)
                return sender==workerId and type(m)=="table" and m.type=="installer_returned"
            end,0.5)

            if reply then
                returned=reply
            elseif now()-lastWarning>=10 then
                sendState("Still waiting for installer handoff acknowledgement")
                lastWarning=now()
            end
        end

        state.phase="MINER_STANDBY"
        saveState()
        return true
    end

    local function validateCommissionPackage()
        local remaining = 0
        state.commissionedRows = state.commissionedRows or {}

        for row=cfg.rowStart,cfg.rowEnd do
            if not state.commissionedRows[row] then
                remaining = remaining + 1
            end
        end

        if remaining == 0 then
            return true
        end

        if selfCount("floppy") < 1 then
            state.phase="WAITING_SUPPLIES"
            saveState()
            sendState("Missing miner floppy")
            return false
        end

        if selfCount("wireless_mining_turtle") < remaining then
            state.phase="WAITING_SUPPLIES"
            saveState()
            sendState("Missing assigned miners")
            return false
        end

        if state.commissionFuelLoaded and selfCount("coal") < WORKER_SETUP_COAL * remaining then
            state.phase="WAITING_SUPPLIES"
            saveState()
            sendState("Not enough miner commissioning fuel")
            return false
        end

        local reserved=state.bootstrapDrivePending and state.bootstrapDriveSlot or nil
        if selfCountExcluding("disk_drive",reserved) < 1 then
            state.phase="WAITING_SUPPLIES"
            saveState()
            sendState("Missing operational Disk Drive")
            return false
        end

        return true
    end

    local function commissionMiner(row,useBootstrapDrive)
        if not validateCommissionPackage() then
            return false
        end

        local targetX=row
        local targetZ=1
        local stagingZ=0
        local temporary=false

        if useBootstrapDrive then
            targetX=1
            targetZ=-1
            stagingZ=-2
            temporary=true

            if state.x~=targetX or state.z~=stagingZ then
                if not goTo(targetX,stagingZ) then
                    return false
                end
            end

            faceTracked(DIR_N)
            saveState()

            if not ensureInstallerLevel() then
                return false
            end

            faceTracked(DIR_N)

            if peripheral.getType("front")~="drive" then
                ensureGroundLevel()
                state.phase="PLACEMENT_ERROR"
                saveState()
                sendState("Bootstrap Disk Drive missing above Miner-01 pad")
                return false
            end

            if not disk.isPresent("front") then
                if not selfSelectKind("floppy") then
                    ensureGroundLevel()
                    state.phase="WAITING_INSTALLER"
                    saveState()
                    sendState("Foreman-1 bootstrap floppy missing")
                    return false
                end

                if not turtle.drop(1) then
                    ensureGroundLevel()
                    state.phase="WAITING_INSTALLER"
                    saveState()
                    sendState("Cannot insert Foreman-1 bootstrap floppy")
                    return false
                end
            end

            if not disk.isPresent("front") then
                ensureGroundLevel()
                state.phase="PLACEMENT_ERROR"
                saveState()
                sendState("Bootstrap floppy verification failed")
                return false
            end

            if not ensureGroundLevel() then
                return false
            end

            faceTracked(DIR_N)
        else
            if state.x~=targetX or state.z~=stagingZ then
                state.phase="PLACEMENT_ERROR"
                saveState()
                sendState("Foreman is not at the expected miner staging position")
                return false
            end

            if not placeDriveAndDiskAt(targetX,targetZ) then
                return false
            end
        end

        if not ensureGroundLevel() then
            return false
        end

        faceTracked(DIR_N)

        if state.x~=targetX or state.z~=stagingZ or state.y~=0 or state.dir~=DIR_N then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Wrong position or facing before miner placement")
            return false
        end

        if frontComputerId() then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Miner target already occupied")
            return false
        end

        if turtle.detect() then
            turtle.dig()
            sleep(0.2)
        end

        if turtle.detect() then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Miner target remains blocked")
            return false
        end

        if not selfSelectKind("wireless_mining_turtle") then
            state.phase="WAITING_SUPPLIES"
            saveState()
            sendState("Wireless Mining Turtle missing")
            return false
        end

        if not turtle.place() then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Cannot place Miner-" .. tostring(row))
            return false
        end

        sleep(0.2)

        local workerId=frontComputerId()
        if not workerId then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Cannot identify Miner-" .. tostring(row))
            return false
        end

        pcall(peripheral.call,"front","turnOn")

        local configurePacket={
            type="configure",
            target=workerId,
            role="miner",
            row=row,
            foremanId=id,
            foremanNumber=number,
            tempDeployment=temporary,
            placedFacing=DIR_N,
            session=cfg.session
        }

        local installed=nil
        local lastConfigure=0
        local warning=now()

        while not installed do
            if now()-lastConfigure>=1 then
                send(workerId,configurePacket)
                pcall(peripheral.call,"front","turnOn")
                lastConfigure=now()
            end

            local _,reply=waitInbox(function(sender,m)
                return sender==workerId and type(m)=="table" and m.type=="install_ok" and m.row==row
            end,0.5)

            if reply then
                installed=reply
            elseif now()-warning>=10 then
                state.phase="WAITING_MINER_BOOT"
                saveState()
                sendState("Waiting for Miner-" .. tostring(row) .. " installation")
                warning=now()
            end
        end

        if frontComputerId()~=workerId then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Miner moved before commissioning completed")
            return false
        end

        if not selfDropKind("coal",WORKER_SETUP_COAL) then
            state.phase="WAITING_FUEL"
            saveState()
            sendState("Cannot give Miner-" .. tostring(row) .. " startup coal")
            return false
        end

        local fueled=nil
        local lastFuel=0
        warning=now()

        while not fueled do
            if now()-lastFuel>=1 then
                send(workerId,{type="commission_refuel"})
                lastFuel=now()
            end

            local _,reply=waitInbox(function(sender,m)
                return sender==workerId and type(m)=="table" and m.type=="commission_refueled" and m.row==row
            end,0.5)

            if reply then
                fueled=reply
            elseif now()-warning>=10 then
                state.phase="WAITING_MINER_FUEL"
                saveState()
                sendState("Waiting for Miner-" .. tostring(row) .. " fuel confirmation")
                warning=now()
            end
        end

        if not recoverInstaller(workerId,targetX,targetZ,useBootstrapDrive) then
            return false
        end

        local deployed=nil
        local lastDeploy=0
        warning=now()

        while not deployed do
            if now()-lastDeploy>=1 then
                send(workerId,{type="deploy_miner"})
                lastDeploy=now()
            end

            local _,reply=waitInbox(function(sender,m)
                return sender==workerId and type(m)=="table" and m.row==row and
                    (m.type=="miner_deployed" or m.type=="miner_deploy_blocked")
            end,0.5)

            if reply then
                if reply.type=="miner_deployed" then
                    deployed=reply
                else
                    state.phase="MINER_DEPLOY_BLOCKED"
                    saveState()
                    sendState("Miner-" .. tostring(row) .. " deployment blocked: " .. tostring(reply.reason))
                    return false
                end
            elseif now()-warning>=10 then
                state.phase="WAITING_MINER_DEPLOY"
                saveState()
                sendState("Waiting for Miner-" .. tostring(row) .. " standby confirmation")
                warning=now()
            end
        end

        state.minerIds=state.minerIds or {}
        state.minerIds[row]=workerId

        if useBootstrapDrive then
            state.firstInstallerRecovered=true
        end

        faceTracked(DIR_N)
        state.phase="MINER_COMMISSIONED"
        saveState()
        return true
    end

    local function returnInstaller()
        local reserved=state.bootstrapDrivePending and state.bootstrapDriveSlot or nil

        if selfCountExcluding("disk_drive",reserved)==0 and selfCount("floppy")==0 then
            return true
        end

        if not atSupply() then
            return false
        end

        while selfCountExcluding("disk_drive",reserved)>0 do
            local slot=selfFindSlotExcluding("disk_drive",reserved)
            if not slot then
                break
            end
            turtle.select(slot)
            if not turtle.drop() then
                state.phase="DOCK_BLOCKED"
                saveState()
                sendState("Cannot return operational Disk Drive")
                return false
            end
        end

        while selfCount("floppy")>0 do
            local slot=selfFindSlot("floppy")
            if not slot then
                break
            end
            turtle.select(slot)
            if not turtle.drop() then
                state.phase="DOCK_BLOCKED"
                saveState()
                sendState("Cannot return floppy")
                return false
            end
        end

        return exitDockHome()
    end

    local function returnUnusedFuel()
        useOwnFuel()
        if not atFuel() then
            return false
        end

        while selfCount("coal") > 0 do
            local slot = selfFindSlot("coal")
            if not slot then
                break
            end
            turtle.select(slot)
            if not turtle.drop() then
                state.phase="DOCK_BLOCKED"
                saveState()
                sendState("Cannot return unused fuel; dock token retained")
                return false
            end
        end

        return exitDockHome()
    end

    local function loadCommissionFuel()
        state.commissionedRows = state.commissionedRows or {}

        local remaining = 0
        for row=cfg.rowStart,cfg.rowEnd do
            if not state.commissionedRows[row] then
                remaining = remaining + 1
            end
        end

        if remaining == 0 then
            return true
        end

        if state.commissionFuelLoaded then
            return true
        end

        if not atFuel() then
            return false
        end

        if not refuelAtFrontTo(FOREMAN_FUEL_TARGET) then
            state.phase="WAITING_FUEL"
            saveState()
            sendState("Fuel chest cannot satisfy foreman fuel target; dock token retained")
            return false
        end

        local needed = WORKER_SETUP_COAL * 4
        local pulled = takeNamedIntoSelf("coal",needed)

        if pulled < needed then
            state.phase="WAITING_FUEL"
            saveState()
            sendState("Need 60 coal for assigned miners")
            return false
        end

        state.commissionFuelLoaded = true
        saveState()

        return exitDockHome()
    end

    local function commissionAssigned()
        state.phase="COMMISSIONING"
        state.commissionedRows = state.commissionedRows or {}
        saveState()
        sendState("Collecting miner startup fuel")

        if not loadCommissionFuel() then
            return false
        end

        sendState("Commissioning assigned miners")

        if not validateCommissionPackage() then
            return false
        end

        local first=cfg.rowStart
        local last=cfg.rowEnd
        local firstPending=nil

        for row=first,last do
            if not state.commissionedRows[row] then
                firstPending=row
                break
            end
        end

        if firstPending then
            local firstIsBootstrap=number==1 and firstPending==1 and not state.firstInstallerRecovered

            if not firstIsBootstrap then
                if not goTo(firstPending,0) then
                    return false
                end
                faceTracked(DIR_N)
                saveState()
            end
        end

        for row=first,last do
            if not state.commissionedRows[row] then
                local useBootstrapDrive=number==1 and row==1 and not state.firstInstallerRecovered

                if useBootstrapDrive then
                    if not commissionMiner(row,true) then
                        return false
                    end
                else
                    if state.x~=row or state.z~=0 then
                        if not goTo(row,0) then
                            return false
                        end
                        faceTracked(DIR_N)
                        saveState()
                    end

                    if not commissionMiner(row,false) then
                        return false
                    end
                end

                state.commissionedRows[row]=true
                saveState()

                if row<last then
                    local nextRow=row+1

                    if useBootstrapDrive then
                        if not goTo(nextRow,0) then
                            return false
                        end
                    else
                        if state.x~=row or state.z~=0 then
                            state.phase="PLACEMENT_ERROR"
                            saveState()
                            sendState("Foreman left staging line after commissioning")
                            return false
                        end

                        if not moveStep(DIR_E) then
                            return false
                        end
                    end

                    faceTracked(DIR_N)
                    saveState()

                    if state.x~=nextRow or state.z~=0 or state.dir~=DIR_N then
                        state.phase="PLACEMENT_ERROR"
                        saveState()
                        sendState("Could not stage for next miner")
                        return false
                    end
                end
            end
        end

        returnUnusedFuel()
        returnInstaller()
        state.commissionFuelLoaded=false
        state.setupDone=true
        state.phase="IDLE"
        saveState()
        returnHome()
        for i=1,3 do
            send(cfg.controller,{
                type="commission_done",
                number=number,
                id=id
            })
            sleep(0.1)
        end
        sendState("Miner setup complete")
        return true
    end

    local function ensureMasterSeedFuel()
        if turtle.getFuelLevel() == "unlimited" or turtle.getFuelLevel() > 0 then
            return true
        end

        while turtle.getFuelLevel() ~= "unlimited" and turtle.getFuelLevel() <= 0 do
            local slot = selfFindSlot("coal")
            if slot then
                turtle.select(slot)
                if not turtle.refuel(1) then
                    slot = nil
                end
            end

            if not slot then
                state.phase="WAITING_SEED_FUEL"
                saveState()
                sendState("Place one coal or charcoal anywhere in Foreman-1 inventory")
                clearAndPrint({
                    "Mine v24 Foreman-1",
                    "",
                    "Seed fuel required.",
                    "Place coal or charcoal",
                    "anywhere in inventory.",
                    "Setup resumes automatically."
                })
                sleep(1)
            end
        end

        state.phase="MASTER_SETUP"
        saveState()
        return true
    end

    local function masterFuelAndLoadCoal()
        if not goTo(-2,0) then
            return false
        end

        faceTracked(DIR_N)

        if not refuelAtFrontTo(FOREMAN_FUEL_TARGET) then
            return false
        end

        local needed = 192 - selfCount("coal")
        if needed > 0 then
            if takeNamedIntoSelf("coal",needed) < needed then
                return false
            end
        end

        return true
    end

    local function masterLoadSupplies()
        if not goTo(0,0) then
            return false
        end

        faceTracked(DIR_N)

        local needDrives = 5 - selfCount("disk_drive")
        if needDrives > 0 and takeNamedIntoSelf("disk_drive",needDrives) < needDrives then
            return false
        end

        local needMiners = 16 - selfCount("wireless_mining_turtle")
        if needMiners > 0 and takeNamedIntoSelf("wireless_mining_turtle",needMiners) < needMiners then
            return false
        end

        local needForemen = 3 - selfCount("narcissistic_wireless_turtle")
        if needForemen > 0 and takeNamedIntoSelf("narcissistic_wireless_turtle",needForemen) < needForemen then
            return false
        end

        local needFloppies = 4 - selfCount("floppy")
        if needFloppies > 0 and takeNamedIntoSelf("floppy",needFloppies) < needFloppies then
            return false
        end

        return true
    end

    local function masterPlaceBootstrapInstaller()
        if selfCount("disk_drive")<1 or selfCount("floppy")<1 then
            return false
        end

        if not goTo(1,-2) then
            return false
        end

        if not ensureGroundLevel() then
            return false
        end

        faceTracked(DIR_N)
        saveState()

        if peripheral.getType("front")=="drive" then
            local slot=selfTargetSlot("disk_drive")
            if not slot then
                return false
            end
            turtle.select(slot)
            if not turtle.dig() then
                state.phase="PLACEMENT_ERROR"
                saveState()
                sendState("Cannot remove misplaced ground bootstrap Disk Drive")
                return false
            end
        elseif frontComputerId() then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Bootstrap pad occupied by a turtle")
            return false
        elseif turtle.detect() then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Bootstrap pad blocked at ground level")
            return false
        end

        if not ensureInstallerLevel() then
            return false
        end

        faceTracked(DIR_N)

        if peripheral.getType("front")~="drive" then
            if turtle.detect() then
                state.phase="PLACEMENT_ERROR"
                saveState()
                sendState("Bootstrap installer square blocked at relative Y 1")
                ensureGroundLevel()
                return false
            end

            if not selfSelectKind("disk_drive") then
                ensureGroundLevel()
                return false
            end

            if not turtle.place() then
                ensureGroundLevel()
                return false
            end
            sleep(0.2)
        end

        if peripheral.getType("front")~="drive" then
            state.phase="VERTICAL_ERROR"
            saveState()
            sendState("Bootstrap Disk Drive is not directly in front at installer height")
            ensureGroundLevel()
            return false
        end

        if not disk.isPresent("front") then
            if not selfSelectKind("floppy") then
                ensureGroundLevel()
                return false
            end

            if not turtle.drop(1) then
                ensureGroundLevel()
                return false
            end
            sleep(0.3)
        end

        if not disk.isPresent("front") then
            ensureGroundLevel()
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Bootstrap floppy verification failed")
            return false
        end

        if not ensureGroundLevel() then
            return false
        end

        faceTracked(DIR_N)

        if peripheral.getType("front")=="drive" then
            state.phase="VERTICAL_ERROR"
            saveState()
            sendState("Bootstrap Disk Drive detected at ground level")
            return false
        end

        saveState()
        return true
    end

    local function masterCommissionForeman(n)
        if selfCount("narcissistic_wireless_turtle")<1
            or selfCount("disk_drive")<1
            or selfCount("floppy")<1
            or selfCount("wireless_mining_turtle")<4
            or selfCount("coal")<64 then
            return nil
        end

        if not goTo(1,-2) then
            return nil
        end

        faceTracked(DIR_N)
        saveState()

        if state.dir~=DIR_N then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Master Foreman is not north-facing before subordinate placement")
            return nil
        end

        if frontComputerId() then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Foreman bootstrap position occupied")
            return nil
        end

        if not selfSelectKind("narcissistic_wireless_turtle") then
            return nil
        end

        if not turtle.place() then
            return nil
        end

        sleep(0.2)

        local newId=frontComputerId()
        if not newId then
            state.phase="PLACEMENT_ERROR"
            saveState()
            sendState("Cannot identify Foreman-" .. tostring(n))
            return nil
        end

        pcall(peripheral.call,"front","turnOn")

        local packet={
            type="configure",
            target=newId,
            role="foreman",
            number=n,
            rowStart=(n-1)*4+1,
            rowEnd=n*4,
            startDir=DIR_N,
            session=cfg.session
        }

        local installed=nil
        local lastConfigure=0

        while not installed do
            if now()-lastConfigure>=1 then
                send(newId,packet)
                pcall(peripheral.call,"front","turnOn")
                lastConfigure=now()
            end

            local _,reply=waitInbox(function(sender,m)
                return sender==newId and type(m)=="table" and m.type=="install_ok" and m.number==n
            end,0.5)

            if reply then
                installed=reply
            end
        end

        if not selfDropKind("coal",64) then
            return nil
        end
        if not selfDropKind("disk_drive",1) then
            return nil
        end
        if not selfDropKind("floppy",1) then
            return nil
        end
        if not selfDropKind("wireless_mining_turtle",4) then
            return nil
        end

        local deployed=nil
        local lastDeploy=0

        while not deployed do
            if now()-lastDeploy>=1 then
                send(newId,{type="deploy_foreman",target=newId})
                lastDeploy=now()
            end

            local _,reply=waitInbox(function(sender,m)
                return sender==newId and type(m)=="table" and m.type=="foreman_deployed" and m.number==n
            end,0.5)

            if reply then
                deployed=reply
            end
        end

        return newId
    end

    local function masterSetup()
        state.phase="MASTER_SETUP"
        state.foremenReady = state.foremenReady or {[1]=true}
        cfg.foremen = cfg.foremen or {[1]=id}
        saveState()
        saveTable("node.cfg",cfg)
        sendState("Setting up foremen")

        if not ensureMasterSeedFuel() then
            return false
        end

        if not state.initialFuelLoaded then
            if not masterFuelAndLoadCoal() then
                state.phase="WAITING_SUPPLIES"
                saveState()
                sendState("Need seed fuel plus three Foreman coal stacks")
                return false
            end
            state.initialFuelLoaded=true
            saveState()
        end

        if not state.initialSuppliesLoaded then
            if not masterLoadSupplies() then
                state.phase="WAITING_SUPPLIES"
                saveState()
                sendState("Need 5 drives, 4 floppies, 16 miners, and 3 Narcissistic Wireless Turtles")
                return false
            end
            state.initialSuppliesLoaded=true
            saveState()
        end

        if not state.bootstrapReady then
            if not masterPlaceBootstrapInstaller() then
                state.phase="WAITING_SUPPLIES"
                saveState()
                sendState("Cannot establish bootstrap station")
                return false
            end
            state.bootstrapReady=true
            saveState()
        end

        for n=2,4 do
            if not state.foremenReady[n] then
                local fid=masterCommissionForeman(n)
                if not fid then
                    state.phase="WAITING_SETUP"
                    saveState()
                    sendState("Foreman-" .. tostring(n) .. " setup paused")
                    return false
                end
                state.foremenReady[n]=true
                cfg.foremen[n]=fid
                saveTable("node.cfg",cfg)
                saveState()
            end
        end

        if not state.bootstrapDiskPulled then
            if not goTo(1,-2) then
                state.phase="WAITING_SETUP"
                saveState()
                sendState("Cannot reach bootstrap drive")
                return false
            end
            if not ensureGroundLevel() then
                return false
            end
            faceTracked(DIR_N)
            if not ensureInstallerLevel() then
                state.phase="WAITING_SETUP"
                saveState()
                sendState("Cannot reach bootstrap drive height")
                return false
            end
            local floppySlot = selfTargetSlot("floppy")
            if not floppySlot then
                ensureGroundLevel()
                state.phase="WAITING_SETUP"
                saveState()
                sendState("No room for bootstrap floppy")
                return false
            end
            turtle.select(floppySlot)
            if not turtle.suck(1) then
                ensureGroundLevel()
                state.phase="WAITING_SETUP"
                saveState()
                sendState("Cannot pull bootstrap floppy")
                return false
            end
            ensureGroundLevel()
            state.bootstrapDiskPulled=true
            saveState()
        end

        if not state.ownInstallerLoaded then
            if selfCount("disk_drive") < 1 then
                state.phase="WAITING_SUPPLIES"
                saveState()
                sendState("Foreman-1 Disk Drive missing")
                return false
            end
            if selfCount("wireless_mining_turtle") < 4 then
                state.phase="WAITING_SUPPLIES"
                saveState()
                sendState("Foreman-1 miners missing")
                return false
            end
            if selfCount("floppy") < 1 then
                state.phase="WAITING_SUPPLIES"
                saveState()
                sendState("Foreman-1 floppy missing")
                return false
            end
            state.ownInstallerLoaded=true
            saveState()
        end

        state.phase="CLEARING_SETUP_AREA"
        saveState()
        sendState("Clearing shared setup area")

        if not returnHome() then
            state.phase="WAITING_SETUP"
            saveState()
            sendState("Cannot clear shared setup area")
            return false
        end

        state.phase="WAITING_SETUP"
        saveState()
        sendState("Four foremen online")
        return true
    end

    local function startAssignedMiners()
        state.minerIds=state.minerIds or {}
        state.miningStarted=true
        saveState()

        for row=cfg.rowStart,cfg.rowEnd do
            local minerId=state.minerIds[row]
            if minerId then
                for i=1,3 do
                    send(minerId,{type="start_mining"})
                    sleep(0.1)
                end
            end
        end

        sendState("Assigned miners released")
    end

    local function serviceRequest(req)
        active = req
        saveQueue()
        state.phase="SERVICING"
        saveState()
        sendState("Servicing Miner-" .. tostring(req.row))

        while not active.arrived do
            sleep(0.1)
            if now() - (active.lastSeen or 0) > 30 then
                state.phase="WAITING_MINER"
                saveState()
            end
        end

        if not loadOwnFuel() then
            return false
        end

        if req.service == "REFUEL" or req.service == "BOTH" then
            if not fetchMinerFuel() then
                return false
            end
        end

        if not goTo(req.row,0) then
            return false
        end
        faceTracked(DIR_N)
        saveState()

        if req.service == "REFUEL" or req.service == "BOTH" then
            if not selfDropKind("coal",64) then
                return false
            end
            send(req.minerId,{
                type="refuel_now",
                requestId=req.requestId
            })
            local _,reply = waitInbox(function(sender,m)
                return sender==req.minerId and type(m)=="table" and m.type=="refuel_complete" and m.requestId==req.requestId
            end,20)
            if not reply then
                return false
            end
        end

        if req.service == "DUMP" or req.service == "BOTH" then
            for slot=2,16 do
                if turtle.getItemCount(slot)>0 then
                    return false
                end
            end
            send(req.minerId,{
                type="dump_now",
                requestId=req.requestId
            })
            local _,reply = waitInbox(function(sender,m)
                return sender==req.minerId and type(m)=="table" and m.type=="dump_complete" and m.requestId==req.requestId
            end,25)
            if not reply then
                return false
            end
        end

        send(req.minerId,{
            type="service_complete",
            requestId=req.requestId
        })

        if req.service == "DUMP" or req.service == "BOTH" then
            if not dumpCargo() then
                return false
            end
        end

        resolved[req.requestId] = now()
        active=nil
        saveQueue()
        returnHome()
        sendState("Service complete")
        return true
    end

    local function workLoop()
        if state.recoveryLocked then
            state.phase="RECOVERY_LOCK"
            saveState()
            checkpointForeman()
            while true do
                sendState("Movement locked: " .. tostring(state.recoveryReason or "pose uncertain"))
                sleep(5)
            end
        end

        checkpointForeman()

        if state.phase=="DEPLOYING" then
            if not goTo(cfg.homeX,cfg.homeZ) then
                state.phase="RECOVERY_LOCK"
                state.recoveryLocked=true
                state.recoveryReason="Could not resume interrupted foreman deployment"
                saveState()
                checkpointForeman()
                while true do
                    sendState(state.recoveryReason)
                    sleep(5)
                end
            end

            faceTracked(DIR_N)
            state.phase="WAITING_SETUP"
            state.setupDone=false
            saveState()
            checkpointForeman()

            for i=1,3 do
                send(cfg.controller,{
                    type="foreman_deployed",
                    id=id,
                    number=number
                })
                sleep(0.1)
            end
        end

        if cfg.master and not state.masterSetupDone then
            while not state.masterSetupDone do
                if masterSetup() then
                    state.masterSetupDone=true
                    saveState()
                else
                    state.phase="WAITING_SETUP"
                    saveState()
                    sendState("Master setup paused, retrying")
                    sleep(2)
                end
            end

            state.groupsCommissioned = state.groupsCommissioned or {}

            for n=2,4 do
                if not state.groupsCommissioned[n] then
                    commissionWave[n] = commissionWave[n] or {}
                    send(cfg.foremen[n],{type="commission_start",number=n})
                    commissionWave[n].lastSend = now()
                end
            end

            if not state.groupsCommissioned[1] then
                state.phase="COMMISSIONING"
                saveState()
                sendState("All foremen released for simultaneous commissioning")

                while not commissionAssigned() do
                    state.phase="WAITING_SETUP"
                    saveState()
                    sendState("Foreman-1 commissioning paused, retrying")
                    sleep(2)
                end

                state.groupsCommissioned[1]=true
                saveState()
            end

            while not (state.groupsCommissioned[2] and state.groupsCommissioned[3] and state.groupsCommissioned[4]) do
                state.phase="WAITING_SETUP"
                saveState()
                sendState("Waiting for all foremen to finish commissioning")
                sleep(1)
            end

            for n=2,4 do
                local fid=cfg.foremen and cfg.foremen[n]
                if fid then
                    for i=1,3 do
                        send(fid,{type="start_assigned"})
                        sleep(0.1)
                    end
                end
            end

            startAssignedMiners()

            state.setupDone=true
            state.phase="IDLE"
            saveState()
            returnHome()
        elseif not cfg.master and not state.setupDone then
            while not flags.commissionStart do
                if flags.recall then
                    state.phase="RECALL_MODE"
                    saveState()
                    sendState("Recall received during setup")
                end
                sleep(0.1)
            end
            flags.commissionStart=false

            while not state.setupDone do
                if commissionAssigned() then
                    break
                end

                state.phase="WAITING_SETUP"
                saveState()
                sendState("Commissioning paused, retrying")
                sleep(2)
            end
        end

        while true do
            if flags.startMining then
                flags.startMining=false
                startAssignedMiners()
            end

            if flags.recall then
                state.phase="RECALL_MODE"
                saveState()
                sendState("Recall broadcast active")
                flags.recall=false
            end

            loadOwnFuel()

            if not active and #queue>0 then
                active=table.remove(queue,1)
                saveQueue()
            end

            if active then
                if not serviceRequest(active) then
                    state.phase="ERROR"
                    saveState()
                    sendState("Service error, request retained")
                    if active then
                        queue[#queue+1]=active
                        active=nil
                        saveQueue()
                    end
                    returnHome()
                    sleep(2)
                end
            else
                if state.x ~= cfg.homeX or state.z ~= cfg.homeZ then
                    returnHome()
                end
                sleep(0.2)
            end
        end
    end

    parallel.waitForAny(networkLoop, workLoop)
end

local function runMonitor()
    if not openNetwork() then
        error("Wireless modem not found")
    end
    if peripheral.getType("right") ~= "monitor" then
        error("4x4 monitor must be on RIGHT")
    end

    local mon = peripheral.wrap("right")
    mon.setTextScale(0.5)

    local data=loadTable("monitor.tmp")
    if not data or data.version~=VERSION then
        data={
            version=VERSION,
            foremen={},
            miners={},
            recall={active=false,home={}},
            authority={}
        }
        saveTable("monitor.tmp",data)
    end
    data.authority=data.authority or {}
    local input = ""
    local lastQuery = 0
    local lastRecall = 0

    local function save()
        saveTable("monitor.tmp",data)
    end

    local function color(c)
        if mon.isColor and mon.isColor() then
            mon.setTextColor(c)
        else
            mon.setTextColor(colors.white)
        end
    end

    local function writeAt(x,y,text,width,c)
        local w,h = mon.getSize()
        if y<1 or y>h or x>w then return end
        width=math.min(width or #text,w-x+1)
        if width<1 then return end
        color(c or colors.white)
        mon.setCursorPos(x,y)
        mon.write(string.sub(tostring(text),1,width))
    end

    local function drawMonitor()
        mon.setBackgroundColor(colors.black)
        mon.clear()
        local w,h=mon.getSize()
        writeAt(2,1,"ZelOS Mining Control",w-2,colors.blue)

        local y=3
        for n=1,4 do
            local f=data.foremen[n]
            local text
            local c=colors.white
            if f then
                text=string.format("F%d %-8s @%s,%s,%s Q:%s",n,tostring(f.state or "?"),tostring(f.x or "?"),tostring(f.y or "?"),tostring(f.z or "?"),tostring(f.queue or 0))
                if now()-(f.lastSeen or 0)>15 or f.state=="RECOVERY_LOCK" then
                    c=colors.red
                end
            else
                text=string.format("F%d NO SIGNAL",n)
                c=colors.red
            end
            writeAt(2,y,text,w-3,c)
            y=y+1
        end

        y=y+1
        local colWidth=math.floor((w-5)/2)
        for row=1,16 do
            local col=row<=8 and 0 or 1
            local idx=row<=8 and row or row-8
            local x=2+col*(colWidth+1)
            local yy=y+(idx-1)*2
            local m=data.miners[row]
            local line1
            local line2=""
            local c=colors.white
            if m then
                line1=string.format("%02d %-12s",row,tostring(m.state or "?"))
                line2=string.format("X:%s Y:%s Z:%s",tostring(m.x or m.row or "?"),tostring(m.y or "?"),tostring(m.z or m.pos or "?"))
                if now()-(m.lastSeen or 0)>20 or m.state=="RECOVERY_LOCK" then
                    c=colors.red
                elseif m.state=="WAITING_SERVICE" then
                    c=colors.orange
                elseif m.state=="COMPLETE" or m.state=="HOME" then
                    c=colors.lightBlue
                end
            else
                line1=string.format("%02d NO SIGNAL",row)
                c=colors.red
            end
            writeAt(x,yy,line1,colWidth,c)
            writeAt(x,yy+1,line2,colWidth,colors.white)
        end

        if data.recall.active then
            local count=0
            for row=1,16 do
                if data.recall.home[row] then count=count+1 end
            end
            writeAt(2,h-1,string.format("RECALL: %d/16 HOME",count),w-3,colors.red)
        end
    end

    local function drawTerminal()
        term.clear()
        term.setCursorPos(1,1)
        print("ZelOS Mining Control")
        print("")
        print("1 = Recall all miners, clear labels, shutdown")
        print("")
        if data.recall.active then
            local count=0
            for row=1,16 do
                if data.recall.home[row] then count=count+1 end
            end
            print("Recall active: " .. tostring(count) .. "/16 home")
            print("")
        end
        write("Command: " .. input)
    end

    local function triggerRecall()
        data.recall={active=true,home={}}
        save()
        broadcast({type="recall_all",source=MONITOR_ID})
        lastRecall=now()
        drawTerminal()
        drawMonitor()
    end

    broadcast({type="status_query"})
    lastQuery=now()
    drawTerminal()
    drawMonitor()

    local timer=os.startTimer(1)

    while true do
        local event={os.pullEvent()}
        if event[1]=="rednet_message" then
            local sender=event[2]
            local message=event[3]
            local protocol=event[4]
            if protocol==PROTOCOL and type(message)=="table" then
                if message.type=="status" then
                    message.lastSeen=now()
                    if message.role=="foreman" and message.number then
                        data.foremen[message.number]=message
                    elseif message.role=="miner" and message.row then
                        data.miners[message.row]=message
                    end
                    save()
                    drawMonitor()
                elseif message.type=="pose_checkpoint" and sender==message.id and
                    message.version==VERSION and message.role and message.snapshot then
                    local snapshot=message.snapshot
                    local exactPose=
                        type(snapshot.x)=="number" and type(snapshot.y)=="number" and
                        type(snapshot.z)=="number" and type(snapshot.dir)=="number"

                    if message.role=="miner" then
                        exactPose=exactPose and type(snapshot.row)=="number" and
                            snapshot.originEstablished==true
                    end

                    if exactPose then
                        local key=tostring(message.role) .. ":" .. tostring(message.id) .. ":" .. tostring(message.session or "")
                        local existing=data.authority[key]
                        local incoming=tonumber(message.seq) or 0
                        local current=existing and (tonumber(existing.seq) or 0) or -1
                        if incoming>=current then
                            data.authority[key]={
                                version=VERSION,
                                session=message.session,
                                seq=incoming,
                                snapshot=snapshot,
                                lastSeen=now()
                            }
                            save()
                        end
                    end
                elseif message.type=="recovery_request" and sender==message.id and
                    message.version==VERSION and message.role then
                    local key=tostring(message.role) .. ":" .. tostring(message.id) .. ":" .. tostring(message.session or "")
                    local entry=data.authority[key]
                    if entry and entry.version==VERSION then
                        send(sender,{
                            type="recovery_state",
                            role=message.role,
                            id=message.id,
                            version=VERSION,
                            session=message.session,
                            seq=entry.seq,
                            snapshot=entry.snapshot
                        })
                    end
                elseif message.type=="recall_home" and message.row and message.labelCleared==true and
                    message.x==message.row and message.y==0 and message.z==0 and message.dir==DIR_N then
                    data.recall.home[message.row]=true
                    if data.miners[message.row] then
                        data.miners[message.row].state="HOME"
                        data.miners[message.row].x=message.x
                        data.miners[message.row].y=message.y
                        data.miners[message.row].z=message.z
                        data.miners[message.row].dir=message.dir
                        data.miners[message.row].lastSeen=now()
                    end
                    local homeCount=0
                    for row=1,16 do
                        if data.recall.home[row] then
                            homeCount=homeCount+1
                        end
                    end
                    if homeCount>=16 then
                        data.recall.active=false
                    end
                    save()
                    drawMonitor()
                    drawTerminal()
                end
            end
        elseif event[1]=="char" then
            input=input .. event[2]
            drawTerminal()
        elseif event[1]=="key" then
            if event[2]==keys.backspace then
                input=string.sub(input,1,math.max(0,#input-1))
                drawTerminal()
            elseif event[2]==keys.enter then
                local command=input
                input=""
                if command=="1" then
                    triggerRecall()
                else
                    drawTerminal()
                end
            end
        elseif event[1]=="timer" and event[2]==timer then
            if now()-lastQuery>=10 then
                broadcast({type="status_query"})
                lastQuery=now()
            end
            if data.recall.active and now()-lastRecall>=3 then
                broadcast({type="recall_all",source=MONITOR_ID})
                lastRecall=now()
            end
            drawMonitor()
            timer=os.startTimer(1)
        end
    end
end

local function runMaster()
    local cfg=loadTable("node.cfg")
    local newMaster=false
    if cfg and cfg.version~=VERSION then
        error("Old master state detected. Clear node.cfg and foreman state before using v24.")
    end
    if not cfg then
        newMaster=true
        cfg={
            version=VERSION,
            role="foreman",
            number=1,
            controller=os.getComputerID(),
            rowStart=1,
            rowEnd=4,
            homeX=0,
            homeZ=-2,
            startX=0,
            startZ=0,
            startDir=DIR_N,
            master=true,
            session=tostring(os.getComputerID()) .. ":" .. tostring(os.time()) .. ":" .. tostring(os.clock()),
            foremen={[1]=os.getComputerID()}
        }
        saveTable("node.cfg",cfg)
    end
    os.setComputerLabel("Foreman-1")
    local state=loadTable("foreman1.tmp")
    if not state and newMaster then
        saveTable("foreman1.tmp",{
            x=0,
            z=0,
            y=0,
            dir=DIR_N,
            phase="MASTER_SETUP",
            setupDone=false,
            masterSetupDone=false,
            session=cfg.session,
            seq=0
        })
    end
    runForeman(cfg)
end

if os.getComputerID() == MONITOR_ID then
    runMonitor()
elseif MASTER_FOREMAN == 1 then
    runMaster()
else
    local cfg = loadTable("node.cfg")
    if not cfg then
        bootstrap()
    elseif cfg.version ~= VERSION then
        error("Old mine state detected. Clear node.cfg and old mine state before using v24.")
    elseif cfg.role == "miner" then
        if cfg.commissioned then
            runMiner(cfg)
        else
            runMinerCommissioning(cfg)
        end
    elseif cfg.role == "foreman" then
        runForeman(cfg)
    else
        error("Unknown node role")
    end
end

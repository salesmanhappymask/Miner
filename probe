local args={...}
local duration=tonumber(args[1]) or 120
local controller=tonumber(args[2]) or 901
if args[3] or (args[1] and not tonumber(args[1])) or
  (args[2] and not tonumber(args[2])) or
  duration%1~=0 or duration<1 or duration>600 or
  controller%1~=0 or controller<0 or controller>=65500 then
  print("Usage: pvp_stop [seconds 1-600] [controller ID]")
  return
end

local modem=peripheral.wrap("back")
if peripheral.getType("back")~="modem" or not modem or not modem.isWireless() then
  print("A wireless modem is required on the back side.")
  return
end

math.randomseed(math.floor(os.clock()*1000000)+os.getComputerID())
local deadline=os.clock()+duration
local sent=0
while os.clock()<deadline do
  local packet={
    nMessageID=math.random(1,2147483647),
    nRecipient=65535,
    message={cmd="stop"},
    sProtocol="chunkquarry"
  }
  modem.transmit(65535,controller,packet)
  sent=sent+1
  sleep(1.1)
end
print("Sent " .. sent .. " broadcasts as " .. controller .. ". Delivery is unconfirmed.")

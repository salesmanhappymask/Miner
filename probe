local workerIds = {
  [0] = 671,
  [1] = 674,
  [2] = 695,
  [3] = 696,
  [4] = 697,
  [5] = 698,
  [6] = 699,
  [7] = 700,
  [8] = 701,
  [9] = 702,
  [10] = 703,
  [11] = 704,
  [12] = 705,
  [13] = 706,
  [14] = 707,
  [15] = 708
}

local args = {...}
local worker = tonumber(args[1])
local chunk = tonumber(args[2])

if not worker or worker % 1 ~= 0 or not workerIds[worker]
    or not chunk or chunk % 1 ~= 0 or chunk < 1 or chunk > 7
    or (args[3] and args[3] ~= "send") or args[4] then
  print("Usage: quarry_probe <worker 0-15> <chunk 1-7> [send]")
  return
end

local recipient = workerIds[worker]
print("Controller: 673")
print("Worker: " .. worker .. " (computer " .. recipient .. ")")
print("Command: next_chunk " .. chunk)

if args[3] ~= "send" then
  print("Preview only. Add send to transmit one message.")
  return
end

local modem = peripheral.wrap("back")
if not modem or peripheral.getType("back") ~= "modem" or not modem.isWireless() then
  print("A wireless modem is required on the back side.")
  return
end

math.randomseed(math.floor(os.clock() * 1000000) + math.floor(os.time() * 1000) + os.getComputerID())
local packet = {
  nMessageID = math.random(1, 2147483647),
  nRecipient = recipient,
  message = {cmd = "next_chunk", chunk = chunk, id = worker},
  sProtocol = "chunkquarry"
}

modem.transmit(recipient, 673, packet)
modem.transmit(65533, 673, packet)
print("Sent once on the direct and repeat channels.")

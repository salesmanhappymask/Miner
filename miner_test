local PROTOCOL = "direct_inventory_transfer_test_v1"
local LOG = "miner_direct_inventory.log"

local function log(message)
    local line=string.format("[%.3f] %s",os.clock(),tostring(message))
    print(line)
    local h=fs.open(LOG,"a")
    if h then
        h.writeLine(line)
        h.close()
    end
end

local function resetLog()
    if fs.exists(LOG) then fs.delete(LOG) end
    log("Miner direct-inventory test starting")
    log("Computer ID: "..tostring(os.getComputerID()))
end

local function openWireless()
    for _,side in ipairs({"left","right","top","bottom","front","back"}) do
        if peripheral.getType(side)=="modem" then
            local ok,wireless=pcall(peripheral.call,side,"isWireless")
            if ok and wireless then
                rednet.open(side)
                log("Opened wireless modem on "..side)
                return true
            end
        end
    end
    error("No wireless modem found")
end

local function scan()
    local total=0
    for slot=1,16 do
        local count=turtle.getItemCount(slot)
        if count>0 then
            log("Slot "..slot.." contains "..count.." item(s)")
            total=total+count
        end
    end
    log("Inventory total: "..total)
    return total
end

resetLog()
openWireless()
log("Initial inventory")
scan()
log("Miner will remain stationary. Any item in any slot may be removed.")

while true do
    local sender,message,protocol=rednet.receive(PROTOCOL)
    log("Message from "..tostring(sender)..": "..textutils.serialize(message))

    if type(message)=="table" and message.type=="HELLO_FOREMAN" then
        rednet.send(sender,{
            type="HELLO_MINER",
            minerId=os.getComputerID()
        },PROTOCOL)
        log("Sent HELLO_MINER")
    elseif type(message)=="table" and message.type=="SCAN_REQUEST" then
        local total=scan()
        rednet.send(sender,{
            type="SCAN_RESULT",
            total=total
        },PROTOCOL)
        log("Sent SCAN_RESULT total="..total)
    elseif type(message)=="table" and message.type=="TEST_COMPLETE" then
        log("Foreman reported test complete")
        log("Final inventory")
        scan()
        break
    elseif type(message)=="table" and message.type=="TEST_ERROR" then
        log("FOREMAN ERROR: "..tostring(message.error))
        scan()
        break
    end
end

log("Miner direct-inventory test finished")

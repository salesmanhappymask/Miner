local PROTOCOL="miner_swarm_monitor_v121"

local function openNetwork()
    local opened=false
    for _,side in ipairs({"left","right","top","bottom","front","back"}) do
        local okOpen,isOpen=pcall(rednet.isOpen,side)
        if okOpen and isOpen then
            opened=true
        else
            local ok=pcall(rednet.open,side)
            if ok then
                local okCheck,nowOpen=pcall(rednet.isOpen,side)
                if okCheck and nowOpen then opened=true end
            end
        end
    end
    return opened
end

while not openNetwork() do
    term.clear()
    term.setCursorPos(1,1)
    print("Wireless Monitor waiting for modem...")
    sleep(1)
end

local function findMonitor()
    for _,side in ipairs({"left","right","top","bottom","front","back"}) do
        if peripheral.getType(side)=="monitor" then
            return peripheral.wrap(side)
        end
    end
end

local snapshot=nil
local lastSeen=0

local function fit(value,width)
    local s=tostring(value or "")
    if #s>width then return s:sub(1,width) end
    return s..string.rep(" ",width-#s)
end

local function makeSurface()
    local mon=findMonitor()
    if mon then
        mon.setTextScale(0.5)
        return mon
    end
    return term
end

local function writeAt(surface,x,y,text,fg,bg,width)
    if bg then surface.setBackgroundColor(bg) end
    if fg then surface.setTextColor(fg) end
    surface.setCursorPos(x,y)
    surface.write(fit(text,width or #tostring(text or "")))
end

local function draw()
    local surface=makeSurface()
    local w,h=surface.getSize()
    surface.setBackgroundColor(colors.black)
    surface.setTextColor(colors.white)
    surface.clear()
    local stale=not snapshot or os.clock()-lastSeen>5
    writeAt(surface,1,1,"WIRELESS REGIONAL MANAGER  v"..tostring(snapshot and snapshot.version or "?").."  ID "..tostring(os.getComputerID()),colors.lightBlue,colors.gray,w)
    if not snapshot then
        writeAt(surface,2,3,"Waiting for Regional Manager feed...",colors.orange,colors.black,w-2)
        return
    end
    local pair="Manager "..tostring(snapshot.managerId or "?").."  |  Master "..tostring(snapshot.masterForemanId or "?")
    writeAt(surface,2,3,pair,stale and colors.red or colors.white,colors.black,w-2)
    writeAt(surface,2,4,string.format("GPS %s/4 | Nodes %s/24 | Jobs %s queued / %s active / %s blocked",
        tostring(snapshot.gpsCount or 0),tostring(snapshot.nodeCount or 0),
        tostring(snapshot.pending or 0),tostring(snapshot.active or 0),tostring(snapshot.blocked or 0)),colors.lightGray,colors.black,w-2)
    writeAt(surface,2,5,tostring(snapshot.statusLine or ""),colors.yellow,colors.black,w-2)
    local top=7
    local available=h-top+1
    local cardH=math.max(5,math.floor(available/2))
    local half=math.floor(w/2)
    for n=1,4 do
        local c=snapshot.clusters and snapshot.clusters[n] or nil
        local col=(n-1)%2
        local row=math.floor((n-1)/2)
        local x=col==0 and 1 or half+1
        local y=top+row*cardH
        local ww=col==0 and half or w-half
        if y<=h then
            writeAt(surface,x,y," F"..n.." "..tostring(c and c.foremanState or "NO SIGNAL").."  GPS "..tostring(c and c.gpsState or "NO SIGNAL"),colors.lightBlue,colors.black,ww)
            if y+1<=h then writeAt(surface,x,y+1," JOB "..tostring(c and c.task or ""),colors.cyan,colors.black,ww) end
            if c and c.miners then
                for k=1,4 do
                    local yy=y+1+k
                    if yy<=math.min(h,y+cardH-1) then
                        local m=c.miners[k]
                        local state=m and tostring(m.state or "?") or "NO SIGNAL"
                        local fg=m and m.online and colors.white or colors.red
                        if m and m.recovery and m.recovery~="" then fg=colors.red end
                        writeAt(surface,x+2,yy,string.format("M%02d  %s",m and m.row or ((n-1)*4+k),state),fg,colors.black,ww-2)
                    end
                end
            end
        end
    end
    if stale then
        writeAt(surface,2,h,"FEED STALE",colors.red,colors.black,math.max(1,w-2))
    end
end

draw()
local timer=os.startTimer(1)
while true do
    local event={os.pullEvent()}
    if event[1]=="rednet_message" then
        local message=event[3]
        local protocol=event[4]
        if protocol==PROTOCOL and type(message)=="table" and message.type=="monitor_snapshot" then
            snapshot=message
            lastSeen=os.clock()
            draw()
        end
    elseif event[1]=="timer" and event[2]==timer then
        draw()
        timer=os.startTimer(1)
    elseif event[1]=="peripheral" or event[1]=="peripheral_detach" or event[1]=="monitor_resize" then
        draw()
    end
end
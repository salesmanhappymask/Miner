local args = {...}
local token = args[1]
local path = args[2] or "sniff.log"
if not token or token == "" then
    print("Enter webhook.site ID or full URL:")
    token = read()
end
token = tostring(token or ""):match("webhook%.site/([%w%-]+)") or tostring(token or ""):match("([%w%-]+)")
if not token or #token < 8 then error("Invalid webhook.site ID") end
print("Using ID: " .. token)
if not http or not http.request then error("HTTP unavailable") end
if not fs.exists(path) or fs.isDir(path) then error("File not found: " .. path) end
local file = fs.open(path, "r")
if not file then error("Cannot read: " .. path) end
local content = file.readAll()
file.close()
if not content or content == "" then error("File is empty") end

local omitted = math.max(0, #content - 32000)
if omitted > 0 then content = content:sub(omitted + 1) end
local size = 600
local total = math.ceil(#content / size)
local base = "https://webhook.site/" .. token
print("Sending " .. #content .. " bytes in " .. total .. " GET requests")
if omitted > 0 then print("Earlier " .. omitted .. " bytes omitted") end

for part = 1, total do
    local chunk = content:sub((part - 1) * size + 1, part * size)
    local url = base .. "?part=" .. part .. "&total=" .. total ..
        "&omitted=" .. omitted .. "&data=" .. textutils.urlEncode(chunk)
    local timer = os.startTimer(15)
    local ok, started, reason = pcall(http.request, url)
    if not ok then error("Part " .. part .. ": " .. tostring(started)) end
    if started == false then error("Part " .. part .. ": " .. tostring(reason)) end
    while true do
        local event, address, value = os.pullEvent()
        if event == "http_success" and address == url then
            local status = value.getResponseCode and value.getResponseCode() or nil
            value.close()
            if status and (status < 200 or status >= 300) then
                error("Part " .. part .. ": HTTP " .. status)
            end
            print(part .. "/" .. total)
            break
        elseif event == "http_failure" and address == url then
            error("Part " .. part .. ": " .. tostring(value))
        elseif event == "timer" and address == timer then
            error("Part " .. part .. ": no GET response after 15 seconds")
        end
    end
end
print("Transfer complete. Send the webhook.site URL.")

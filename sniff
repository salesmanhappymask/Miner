local path = ({...})[1] or "sniff.log"
if not http or not http.post then error("HTTP unavailable") end
if not fs.exists(path) or fs.isDir(path) then error("File not found: " .. path) end
local file = fs.open(path, "r")
if not file then error("Cannot read: " .. path) end
local content = file.readAll()
file.close()
if not content or content == "" then error("Log is empty") end
print("Uploading " .. tostring(#content) .. " bytes...")
local ok, response, reason = pcall(http.post, "https://paste.rs/", content, {
    ["Content-Type"] = "text/plain"
})
if not ok then error(tostring(response)) end
if not response then error("Upload failed: " .. tostring(reason or "no response")) end
local status = response.getResponseCode and response.getResponseCode() or nil
local link = response.readAll()
response.close()
if status and status ~= 201 then error("Upload status " .. tostring(status) .. ": " .. tostring(link)) end
if not link or not link:match("^https://paste%.rs/[%w%-_]+%s*$") then
    error("Unexpected response: " .. tostring(link):sub(1, 300))
end
print("Log URL:")
print(link)

local args = {...}
local path = args[1] or "sniff.log"
local endpoint = "https://pastebin.com/api/api_post.php"
local key = "0ec2eb25b6166c0c27a394ae118ad829"

if not http or not http.request then error("HTTP API unavailable") end
if not fs.exists(path) or fs.isDir(path) then error("File not found: " .. path) end
local file = fs.open(path, "r")
if not file then error("Cannot read: " .. path) end
local content = file.readAll()
file.close()
if not content or content == "" then error("File is empty") end

local body = "api_option=paste&api_dev_key=" .. key ..
    "&api_paste_private=1&api_paste_name=" .. textutils.urlEncode(fs.getName(path)) ..
    "&api_paste_code=" .. textutils.urlEncode(content)

print("Sending " .. tostring(#content) .. " bytes to Pastebin...")
local timer = os.startTimer(35)
local ok, started, reason = pcall(http.request, endpoint, body, {
    ["Content-Type"] = "application/x-www-form-urlencoded",
    ["User-Agent"] = "ComputerCraft/1.63"
})
if not ok then error("Request error: " .. tostring(started)) end
if started == false then error("Request refused: " .. tostring(reason)) end

while true do
    local event, address, value = os.pullEvent()
    if event == "http_success" and address == endpoint then
        local code = value.getResponseCode and value.getResponseCode() or nil
        local response = value.readAll()
        value.close()
        local link = response and response:match("(https?://pastebin%.com/[%w]+)")
        if link then
            print("Paste URL:")
            print(link)
            break
        end
        error("Pastebin response " .. tostring(code or "?") .. ": " .. tostring(response):sub(1, 300))
    elseif event == "http_failure" and address == endpoint then
        error("Connection failed: " .. tostring(value))
    elseif event == "timer" and address == timer then
        error("No response after 35 seconds. Pastebin uploads may be blocked by the server or connection.")
    end
end

local args = {...}
local token = args[1]
local path = args[2] or "sniff.log"
if not token or token == "" then
    print("Enter webhook.site ID or full URL:")
    token = read()
end
token = tostring(token or ""):match("webhook%.site/([%w%-]+)") or tostring(token or ""):match("([%w%-]+)")
if not token or #token < 8 then error("Invalid webhook.site ID") end
if not http or not http.request then error("HTTP unavailable") end
if not fs.exists(path) or fs.isDir(path) then error("File not found: " .. path) end
local file = fs.open(path, "r")
if not file then error("Cannot read: " .. path) end
local content = file.readAll()
file.close()
if not content or content == "" then error("File is empty") end

local a, b = 1, 0
for i = 1, #content do
    a = (a + content:byte(i)) % 65521
    b = (b + a) % 65521
end
local checksum = string.format("%08x", b * 65536 + a)
local dictionary = {}
local nextCode = 256
local codes = {}
local word = ""
for i = 1, #content do
    local char = content:sub(i, i)
    local candidate = word .. char
    if word == "" or dictionary[candidate] then
        word = candidate
    else
        codes[#codes + 1] = #word == 1 and word:byte() or dictionary[word]
        if nextCode < 65536 then
            dictionary[candidate] = nextCode
            nextCode = nextCode + 1
        end
        word = char
    end
end
if word ~= "" then codes[#codes + 1] = #word == 1 and word:byte() or dictionary[word] end
local packed = {}
for i = 1, #codes do
    local code = codes[i]
    packed[i] = string.char(math.floor(code / 256), code % 256)
end
local bytes = table.concat(packed)
local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
local encoded = {}
local n = 0
for i = 1, #bytes, 3 do
    local x, y, z = bytes:byte(i, i + 2)
    y = y or 0
    z = z or 0
    local k = x * 65536 + y * 256 + z
    n = n + 1
    encoded[n] = alphabet:sub(math.floor(k / 262144) % 64 + 1, math.floor(k / 262144) % 64 + 1)
    n = n + 1
    encoded[n] = alphabet:sub(math.floor(k / 4096) % 64 + 1, math.floor(k / 4096) % 64 + 1)
    if i + 1 <= #bytes then
        n = n + 1
        encoded[n] = alphabet:sub(math.floor(k / 64) % 64 + 1, math.floor(k / 64) % 64 + 1)
    end
    if i + 2 <= #bytes then
        n = n + 1
        encoded[n] = alphabet:sub(k % 64 + 1, k % 64 + 1)
    end
end
local payload = table.concat(encoded)
local chunkSize = 2400
local total = math.ceil(#payload / chunkSize)
print("Log " .. #content .. " bytes, packed " .. #payload .. " characters")
print("Sending " .. total .. " GET requests")
if total > 45 then error("Too many parts for one free webhook URL") end
local base = "https://webhook.site/" .. token
for part = 1, total do
    local chunk = payload:sub((part - 1) * chunkSize + 1, part * chunkSize)
    local url = base .. "?v=2&seq=" .. part .. "&total=" .. total ..
        "&bytes=" .. #content .. "&hash=" .. checksum .. "&data=" .. chunk
    local timer = os.startTimer(20)
    local ok, started, reason = pcall(http.request, url)
    if not ok then error("Part " .. part .. ": " .. tostring(started)) end
    if started == false then error("Part " .. part .. ": " .. tostring(reason)) end
    while true do
        local event, address, value = os.pullEvent()
        if event == "http_success" and address == url then
            local status = value.getResponseCode and value.getResponseCode() or nil
            value.close()
            if status and (status < 200 or status >= 300) then
                error("Part " .. part .. ": HTTP " .. status)
            end
            print(part .. "/" .. total)
            break
        elseif event == "http_failure" and address == url then
            error("Part " .. part .. ": " .. tostring(value))
        elseif event == "timer" and address == timer then
            error("Part " .. part .. ": no response after 20 seconds")
        end
    end
    if part < total then sleep(2) end
end
print("Transfer complete. Save the webhook URL.")
